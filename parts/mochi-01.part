});
});
const taAsk = document.getElementById('sm-e-ta-ask');
if (taAsk) taAsk.addEventListener('click', () => {
document.getElementById('tc-mask').hidden = true;
inviteTaToListen(id);
});
const taInv = document.getElementById('sm-e-ta-inv');
if (taInv) taInv.addEventListener('click', () => { forceTaInviteFor(id); });
document.getElementById('sm-e-ok').addEventListener('click', () => {
m.name = (document.getElementById('sm-e-name').value || '').trim() || m.name;
m.artist = (document.getElementById('sm-e-artist').value || '').trim();
m.playlistId = document.getElementById('sm-e-pl').value;
saveLibrary();
document.getElementById('tc-mask').hidden = true;
renderPage();
toast('已保存');
});
document.getElementById('sm-e-del').addEventListener('click', () => {
if (window.openModal) {
window.openModal('删除这首音乐？', '', () => {
library = library.filter(x => x.id !== id);
if (window.idbGetAllKeys) {
window.idbGetAllKeys().then(keys => {
keys.filter(k => k === MUSIC_PREFIX + ':music-file:' + id).forEach(k => {
if (window.idbDelete) window.idbDelete(k);
});
});
}
if (currentId === id) { teardownAudio(); currentId = null; }
saveLibrary();
document.getElementById('tc-mask').hidden = true;
renderPage();
toast('已删除');
}, { noInput: true });
}
});
}
let invitePlayCheckTimer = null;
let inviteCheckStage = 0;
function armInvitePlayCheck() {
try {
if (invitePlayCheckTimer) clearTimeout(invitePlayCheckTimer);
inviteCheckStage = 0;
invitePlayCheckTimer = setTimeout(invitePlayCheckStep, 4000);
} catch (e) {}
}
function invitePlayCheckStep() {
invitePlayCheckTimer = null;
try {
if (!currentId) return; // 曲目加载失败等路径已有各自的 toast，不重复打扰
if (!audio) {
if (inviteCheckStage === 0) { inviteCheckStage = 1; invitePlayCheckTimer = setTimeout(invitePlayCheckStep, 5000); return; }
if (inviteCheckStage === 1) {
inviteCheckStage = 2;
const retryId = currentId;
try { toast('本地音乐读取较慢，正在重试…'); } catch (e) {}
try { playTrack(retryId); } catch (e) {}
invitePlayCheckTimer = setTimeout(invitePlayCheckStep, 5000);
return;
}
try { armAutoResume(); toast('音乐没能播放出来：点一下屏幕任意位置再试，或在播放列表换一首'); } catch (e) {}
return;
}
if (!audio.paused) return;        // 在播或在缓冲＝健康，交给停滞守卫盯
const p = audio.play();
if (p && p.catch) p.catch(function () {
if (!audio) return;
try { audio.muted = true; } catch (e) {}
const p2 = audio.play();
if (p2 && p2.then) p2.then(
function () { try { if (audio) audio.muted = false; } catch (e) {} },
function () { try { if (audio) audio.muted = false; } catch (e) {} armAutoResume(); try { toast('音乐没能自动播出来，点一下屏幕任意位置即可开始'); } catch (e) {} }
);
});
} catch (e) {}
}
function inviteStaleToast(name) {
reqData = null;
try { toast('已切换联系人，这份听歌邀请已失效，可以让 ' + name + ' 再邀一次'); } catch (e) {}
}
function prewarmLocalAudio(id) {
try {
const m = findTrack(id);
if (!m || !(m.source === 'local' || (!m.url && m.source !== 'url'))) return;
if (localBlobCache[id]) return;
const lsV = store.get('music-file:' + id);
if (plausibleLocalValue(lsV)) { localBlobCache[id] = lsV; return; }
if (!window.idbGet) return;
window.idbGet(MUSIC_PREFIX + ':music-file:' + id).then(function (v) {
if (plausibleLocalValue(v) && !localBlobCache[id]) localBlobCache[id] = v;
});
} catch (e) {}
}
function lyricSnippetFor(track) {
try {
const raw = String((track && track.lrc) || '');
if (raw) {
const lines = raw.split('\n').map(x => x.replace(/\[[^\]]*\]/g, '').trim()).filter(x => x && x.length >= 4 && x.length <= 30);
if (lines.length) return lines[Math.floor(Math.random() * Math.min(lines.length, 40))];
}
var cur = document.querySelector('#npLrcBody .np-lrc-line');
if (cur && cur.textContent && cur.textContent.trim()) return cur.textContent.trim();
} catch (e) {}
return '';
}
function openMusicInvitePanel(trackId, switching) {
const track = findTrack(trackId);
if (!track) return false;
const myCid = window.__activeCid || 'default'; // 多桌面：弹窗期间切换联系人后点按钮不得写到新桌面
const name = partnerName();
const trackName = track.name || '未知歌曲';
const artist = track.artist ? ' - ' + track.artist : '';
reqData = { trackId: trackId, switching: !!switching };
taActive = true;
taMusicSys(switching
? name + ' 想邀请你切换到《' + trackName + '》' + artist
: name + ' 想和你一起听《' + trackName + '》' + artist);
if (!window.openTCPanel) return false;
window.openTCPanel('音乐', '' +
'<div class="sm-req">' +
'<div class="sm-req-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></div>' +
'<div class="sm-req-hint">' + (window.taFit ? window.taFit(name + (switching ? ' 想邀请你切到这首歌：' : ' 想和你一起听：')) : (name + (switching ? ' 想邀请你切到这首歌：' : ' 想和你一起听：'))) + '</div>' +
'<div class="sm-req-name">《' + esc(trackName) + '》</div>' +
((function () {
try {
if (Math.random() * 100 >= Math.max(0, Number(settings.inviteLineProb) || 0)) return '';
const ln = lyricSnippetFor(track);
if (!ln) return '';
return '<div class="sm-req-line">顺带一句：' + esc(ln) + '</div>';
} catch (e) { return ''; }
})()) +
'</div>' +
'<div class="mail-actions"><button class="cc-tool" id="sm-req-no">稍后</button><button class="cc-tool" id="sm-req-yes">' + (switching ? '切过去' : '一起听') + '</button></div>');
const noBtn = document.getElementById('sm-req-no');
const yesBtn = document.getElementById('sm-req-yes');
if (!noBtn || !yesBtn) return false;
noBtn.addEventListener('click', () => {
document.getElementById('tc-mask').hidden = true;
if ((window.__activeCid || 'default') !== myCid) { inviteStaleToast(name); return; }
reqData = null;
history.push({ id: 'smh_' + Date.now(), trackId: '', trackName: '', triggerType: '拒绝了 TA 的听歌邀请《' + esc(trackName) + '》', rejected: true, ts: Date.now() });
if (history.length > 500) history = history.slice(-500);
saveHistory(); renderHistory();
taMusicSys('你拒绝了 ' + name + ' 的听歌邀请', true);
});
yesBtn.addEventListener('click', () => {
document.getElementById('tc-mask').hidden = true;
if ((window.__activeCid || 'default') !== myCid) { inviteStaleToast(name); return; }
if (!reqData) return; // 连点两次只认第一次
const switchNow = !!reqData.switching;
reqData = null;
if (!findTrack(trackId)) {
try { toast('《' + trackName + '》已不在音乐库里，无法播放'); } catch (e) {}
return;
}
callHoldPlaying = false; callHoldPending = false; // #904a
playTrack(trackId);
addRecord(trackId, '接受了 TA 的听歌邀请');
taMusicSys(switchNow
? '你接受了邀请，已切换到《' + trackName + '》'
: '你接受了 ' + name + ' 的听歌邀请，一起听《' + trackName + '》', true);
toast('开始播放');
armInvitePlayCheck(); // #904b
renderFloat(); // #904a：hold 藏起的小框随新播放意图立刻恢复（本地歌异步起播由 onplay 再刷新）
});
return true;
}
let myInvitePending = false; // 在飞一条＝不再收第二条（回应最远 4s 落地，落定了随时能再邀＝不是掐表不许试）
function pendingInviteOnScreen() {
const m = document.getElementById('tc-mask');
return !!(reqData && m && !m.hidden && document.getElementById('sm-req-yes'));
}
function inviteTaToListen(trackId) {
const track = findTrack(trackId);
if (!track) { toast('这首已不在音乐库里'); return; }
if (reqData && !pendingInviteOnScreen()) reqData = null; // 被别的面板顶掉的旧邀请：交还，不拿它锁门
if (pendingInviteOnScreen()) { toast('已经有一条听歌邀请等你确认了'); return; }
if (myInvitePending) { toast('刚才那条还在等 TA 回，先看这一条'); return; }
myInvitePending = true;
const myCid = window.__activeCid || 'default'; // 多桌面：回应落地时不得写到新桌面（同 #994 面板口径）
const name = partnerName();
const trackName = track.name || '未知歌曲';
const artist = track.artist ? ' - ' + track.artist : '';
taMusicSys('你邀请 ' + name + ' 一起听《' + trackName + '》' + artist);
toast('已邀请 TA，回应会落在聊天里');
setTimeout(function () {
myInvitePending = false; // 四条出口共用这一行先交还：在飞标志不许有第二种持久的伪状态
if ((window.__activeCid || 'default') !== myCid) return;
const say = function (group, fb) {
const pool = window.getInteractPool ? window.getInteractPool(group, fb) : fb;
return window.pickAskCardReply ? window.pickAskCardReply(pool) : pool[Math.floor(Math.random() * pool.length)];
};
const accept = function (line) {
if (line) taMusicSay(line);
if (!findTrack(trackId)) { toast('《' + trackName + '》已不在音乐库里，无法播放'); return; }
taActive = true;
callHoldPlaying = false; callHoldPending = false;
playTrack(trackId);
taMusicSys('你邀请 ' + name + ' 一起听《' + trackName + '》' + artist + '，TA 同意了一起听', true);
armInvitePlayCheck();
renderFloat();
};
const wY = Math.max(0, Number(settings.inviteYes) || 0);
const wW = Math.max(0, Number(settings.inviteWait) || 0);
const wN = Math.max(0, Number(settings.inviteNo) || 0);
const wSum = wY + wW + wN;
const roll = Math.random() * (wSum > 0 ? wSum : 50);
if (wSum <= 0 || roll < wY) {
accept(say('音乐邀请TA·同意', ['一起听呀。', '放吧，我靠近一点。', '这首好，就听它。']));
return;
}
if (roll < wY + wW) {
taMusicSay(say('音乐邀请TA·等一会儿', ['等一会儿嘛，我把手里这点事收个尾。', '等一下下，马上就来。', '让我缓一缓，过会儿一起听。']));
taMusicSys(name + ' 说等一会儿再听《' + trackName + '》');
const gap = Math.max(60000, Number(settings.inviteGapMs) || 60000);
const waitCid = myCid;
setTimeout(function () {
try {
if ((window.__activeCid || 'default') !== waitCid) return;
if (!findTrack(trackId)) return;
taMusicSys(name + ' 回来了，接着一起听《' + trackName + '》');
accept(say('音乐邀请TA·回来了', ['我回来了，一起听。', '忙完啦，放吧。']));
} catch (e) {}
}, gap);
return;
}
taMusicSay(say('音乐邀请TA·拒绝', ['这首现在不想听嘛。', '待会儿再听好不好？', '今天耳朵想休息一下。']));
taMusicSys(name + ' 这次没答应，说待会儿再听《' + trackName + '》');
}, 1500 + Math.random() * 2500);
}
function forceTaInviteFor(trackId) {
if (!findTrack(trackId)) { toast('这首已不在音乐库里'); return; }
if (reqData && !pendingInviteOnScreen()) reqData = null; // 同上：被顶掉的旧邀请不许把这条路锁死
if (pendingInviteOnScreen()) { toast('已经有一条听歌邀请等你确认了'); return; }
cooldownAt = Date.now();
if (!openMusicInvitePanel(trackId, !!currentId)) {
reqData = null;
cooldownAt = 0; // 没弹成就不该占着冷却窗，把这条自然触发的机会白白吃掉
toast('邀请没能弹出来：音乐页弹层不可用，可去 音乐设置 → 诊断邀请 看读数');
return;
}
prewarmLocalAudio(trackId);
}
window.maybeMusicRequest = function () {
try {
if (document.hidden) { console.log('[music-req] return: page hidden'); return; }
const prob = (typeof settings.reqProb === 'number' ? settings.reqProb : 5);
console.log('[music-req] called', { libLen: library.length, cooldownAt: cooldownAt, cooldownMs: settings.cooldownMs, reqProb: settings.reqProb, prob: prob, now: Date.now() });
if (!library.length) { console.log('[music-req] return: library empty'); return; }
const now = Date.now();
const cooling = now - cooldownAt < settings.cooldownMs;
if (!cooling) {
const prob = (typeof settings.reqProb === 'number' ? settings.reqProb : 5);
const effProb = window.icProb ? window.icProb(prob) : prob;
if (Math.random() * 100 < effProb) {
console.log('[music-req] TRIGGER');
cooldownAt = now;
const candidates = library.slice();
if (!candidates.length) return;
const track = candidates[Math.floor(Math.random() * candidates.length)];
if (!openMusicInvitePanel(track.id, !!currentId)) { console.log('[music-req] panel open failed'); return; }
prewarmLocalAudio(track.id);
}
return; // 「一起去听」已触发，本次调用不再判断「预订下一首」
}
const rProb = probOf(settings.taReserveProb, 6);
if (currentId && !(now - cooldownAt < settings.cooldownMs) && Math.random() * 100 < rProb && library.length) {
let candidate = null;
for (let i = 0; i < 8; i++) {
const c = library[Math.floor(Math.random() * library.length)];
if (c && c.id !== currentId && playQueue.indexOf(c.id) < 0) { candidate = c; break; }
}
if (candidate) {
cooldownAt = now;
playQueue.push(candidate.id);
renderQueueBadge();
const name = partnerName();
const trackName = candidate.name || '未知歌曲';
const artist = candidate.artist ? ' - ' + candidate.artist : '';
taMusicSys(name + ' 预订了下一首要听的歌：《' + trackName + '》' + artist);
addRecord(candidate.id, 'TA 预订了下一首');
}
}
} catch (e) {}
};
function maybeTAAutoAction() {
if (!taActive || !currentId) return false;
const endedId = currentId;
const pNext = probOf(settings.taNextProb, 15);
const pRand = probOf(settings.taRandProb, 10);
const pMode = probOf(settings.taModeProb, 5);
const r = Math.random() * 100;
const name = partnerName();
if (r < pNext) {
const list = playableList();
if (list.length > 1) {
const others = list.filter(x => x.id !== currentId);
const t = others[Math.floor(Math.random() * others.length)];
taMusicSys(name + ' 切到了下一首《' + (t.name || '未知歌曲') + '》');
addRecord(t.id, 'TA 切到了下一首');
setTimeout(() => { if (currentId === endedId) playTrack(t.id); }, 300);
return true;
}
return false;
}
if (r < pNext + pRand) {
const list = playableList();
if (list.length > 1) {
const t = list[Math.floor(Math.random() * list.length)];
taMusicSys(name + ' 随机挑了一首《' + (t.name || '未知歌曲') + '》');
addRecord(t.id, 'TA 随机挑了一首');
setTimeout(() => { if (currentId === endedId) playTrack(t.id); }, 300);
return true;
}
return false;
}
if (r < pNext + pRand + pMode) {
cycleMode();
const modeLabel = { list: '顺序播放', shuffle: '随机播放', single: '单曲循环' }[mode];
taMusicSys(name + ' 把播放模式换成了' + modeLabel);
addModeRecord(modeLabel);
}
return false;
}
const DEF_TA_PAUSE_CARDS = ['先暂停一下，听我说句话', '嘘——让音乐停一会儿', '（TA 按下了暂停键）'];
const DEF_TA_RESUME_CARDS = ['好啦，继续听吧', '又帮你按了播放，接着听', '（TA 又按下了播放键）'];
let taPauseActive = false;      // TA 暂停进行中（禁止后台补播/手势补播打扰）
let taPauseFiredId = null;      // 本次互动「已真的暂停过」的歌曲 id（#673：用户介入打断时据它记账）
let taPauseTimer = null;        // 掷骰子命中后的延迟触发定时器
let taPauseResumeTimer = null;  // TA 恢复播放定时器
let taPauseDoneId = null;       // 已互动过的歌曲 id（同一首歌不重复触发）
let taPauseCooldownAt = 0;      // 上次互动完成时间戳（冷却期内不连发）
function bookTaPauseFired(id) {
if (!id) return;
taPauseDoneId = id;
taPauseCooldownAt = Date.now();
}
function cancelTaPause() {
if (taPauseActive && taPauseFiredId) bookTaPauseFired(taPauseFiredId);
taPauseActive = false;
taPauseFiredId = null;
if (taPauseTimer) { clearTimeout(taPauseTimer); taPauseTimer = null; }
if (taPauseResumeTimer) { clearTimeout(taPauseResumeTimer); taPauseResumeTimer = null; }
}
function taPauseSendCard(group, fallback) {
try {
if (window.dcfGet && !(Math.random() * 100 < window.dcfGet('music'))) return;
let arr = window.getLibPool ? window.getLibPool('music', group, fallback) : (fallback || []);
if (window.isDefaultCardOff) arr = arr.filter(c => !window.isDefaultCardOff('music', c));
if (!arr.length) arr = window.gateCardFallback ? window.gateCardFallback('music', fallback) : [];
if (!arr.length) return;
let m = arr[Math.floor(Math.random() * arr.length)];
if (window.taFit) m = window.taFit(m);
taMusicSay(m);
} catch (e) {}
}
function scheduleTaPauseIfLucky() {
cancelTaPause();
if (!settings.taPauseEn) return;                                  // 权限开关关闭：彻底不触发
if (currentId && currentId === taPauseDoneId) return;             // 同一首歌只互动一次
if (Date.now() - taPauseCooldownAt < (settings.cooldownMs ?? 600000)) return; // 冷却期内不连发（#673：`??` 让「无冷却」=0 真正生效；`||` 会把设置成 0 的「无冷却」当成 600000，与 3913/3978 两处冷却判定不一致＝选「无冷却」却仍冷却 10 分钟＝「一播就被打断」难复现、交互频率异常）
const p = probOf(settings.taPauseProb, 3);
if (p <= 0 || Math.random() * 100 >= p) return;
if (!currentId || !audio) return;
const endedId = currentId;
taPauseTimer = setTimeout(function () {
taPauseTimer = null;
if (taPauseActive || !audio || !currentId || currentId !== endedId || audio.paused) return;
if (callHoldPending || document.hidden) return; // 通话/后台不打扰
taPauseActive = true;
taPauseFiredId = endedId; // #673：记下「这次真的暂停过了」，用户介入打断时据此记账
wantPlay = true; // 保留播放意图（TA 稍后会恢复，不按「用户主动暂停」处理）
try { audio.pause(); } catch (e) {}
try { const nm = partnerName(); taMusicSys(nm + ' 暂停了音乐'); } catch (e) {}
taPauseSendCard('TA 暂停播放', DEF_TA_PAUSE_CARDS);
taPauseResumeTimer = setTimeout(function () {
taPauseResumeTimer = null;
if (!taPauseActive || !audio || !currentId || currentId !== endedId) { taPauseActive = false; taPauseFiredId = null; return; }
taPauseActive = false;
taPauseFiredId = null;
bookTaPauseFired(endedId);
const p2 = audio.play();
if (p2 && p2.catch) p2.catch(function () {
if (!audio) return; // v3.28.x：判空防 null.play()（3.5s 恢复窗口内可能已切歌/停止）
try { audio.muted = true; } catch (e) {}
const p3 = audio.play();
if (p3 && p3.then) p3.then(function () { try { if (audio) audio.muted = false; } catch (e) {} }).catch(function () {
try { syncPlayIcons(false); } catch (e) {}
try { armAutoResume(); } catch (e) {}
});
});
try { const nm = partnerName(); taMusicSys(nm + ' 又播放了音乐'); } catch (e) {}
taPauseSendCard('TA 恢复播放', DEF_TA_RESUME_CARDS);
}, 3500);
}, 10000 + Math.floor(Math.random() * 15000));
}
function MUSIC_FILE_PREFIX() { return MUSIC_PREFIX + ':music-file:'; }
function calcStorageBytes() {
if (!window.idbGetAllKeys) return Promise.resolve(-1);
return window.idbGetAllKeys().then(keys => {
const fileKeys = keys.filter(k => k.indexOf(MUSIC_FILE_PREFIX()) === 0);
if (!fileKeys.length) return 0;
const BATCH = 20;
function readBatch(i) {
if (i >= fileKeys.length) return Promise.resolve(0);
return window.idbGetMany(fileKeys.slice(i, i + BATCH)).then(map => {
let total = 0;
fileKeys.slice(i, i + BATCH).forEach(k => {
const v = map[k];
if (v instanceof Blob) total += v.size;
else if (typeof v === 'string') total += v.length * 0.75;
});
return readBatch(i + BATCH).then(sub => total + sub);
});
}
return readBatch(0);
}).catch(() => -1);
}
function fmtStorageMB(bytes) {
if (bytes < 0) return '计算失败';
if (!bytes) return '0 MB';
const mb = bytes / 1048576;
return (mb < 0.01 ? '0.01' : mb.toFixed(1)) + ' MB';
}
function refreshStorageUse() {
const el = document.getElementById('sm-storage-use');
if (!el) return;
el.textContent = '计算中…';
calcStorageBytes().then(b => { const e = document.getElementById('sm-storage-use'); if (e) e.textContent = fmtStorageMB(b); });
}
function clearLocalAudioCache() {
if (!window.idbGetAllKeys || !window.idbDelete) { toast('当前环境不支持清理'); return; }
window.idbGetAllKeys().then(keys => {
const fileKeys = keys.filter(k => k.indexOf(MUSIC_FILE_PREFIX()) === 0);
if (!fileKeys.length) { toast('没有本地音频缓存'); refreshStorageUse(); return; }
const delIds = [];       // 要移除的歌曲 id（非种子，音频删了歌也播不了）
const cacheOnly = [];    // 种子歌的本地旋律缓存键（可再生成，只删缓存不动歌）
fileKeys.forEach(k => {
const id = k.slice(MUSIC_FILE_PREFIX().length);
const m = library.find(x => x.id === id);
if (m && seedIdxOf(m) >= 0) cacheOnly.push(k);
else delIds.push(id);
});
window.openModal('将删除 ' + fileKeys.length + ' 个本地音频文件，并从歌单移除 ' + delIds.length + ' 首本地歌曲（外链歌曲不受影响）。确定清理？', '', () => {
let p = Promise.resolve(true);
fileKeys.forEach(k => { p = p.then(() => window.idbDelete(k)); });
p.then(() => {
if (delIds.length) {
library = library.filter(m => !delIds.includes(m.id));
if (currentId && delIds.includes(currentId)) { teardownAudio(); currentId = null; }
saveLibrary();
}
if (audio) updatePlayerBar();
renderFloat();
refreshStorageUse();
toast('已清理本地音频缓存');
});
}, { noInput: true });
});
}
function openSettings() {
if (!window.openTCPanel) return;
const cooldownOpts = [
{ v: '0', label: '无冷却' },
{ v: '60000', label: '1 分钟' },
{ v: '300000', label: '5 分钟' },
{ v: '600000', label: '10 分钟' }
].map(o => '<option value="' + o.v + '"' + (String(settings.cooldownMs) === o.v ? ' selected' : '') + '>' + o.label + '</option>').join('');
window.openTCPanel('音乐设置', '' +
'<div class="sm-set-row"><span>悬浮播放小框</span><label class="toggle"><input type="checkbox" id="sm-set-float"' + (settings.floatEn ? ' checked' : '') + '><span class="tk"></span></label></div>' +
'<div class="mps-group">邀你 · TA 主动开口<em>回完话掷一次 · 隔够久才再邀</em></div>' +
'<div class="gs-row"><span>邀你一起听</span><div class="stepper" id="sm-set-prob" data-min="0" data-max="30" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-prob-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="gs-row"><span>邀请间隔</span><select class="tc-input" id="sm-set-cool" style="width:110px">' + cooldownOpts + '</select></div>' +
'<div class="gs-row"><span>桌面小组件封面</span><select class="tc-input" id="sm-set-wcov" style="width:120px"><option value="song"' + (settings.widgetCoverMode !== 'playlist' ? ' selected' : '') + '>歌曲封面</option><option value="playlist"' + (settings.widgetCoverMode === 'playlist' ? ' selected' : '') + '>歌单封面</option></select></div>' +
'<div class="sm-set-hint">聊天过程中 TA 会按概率请求和你一起听歌；播放时右上角出现可拖动的悬浮小框。想现在就要：在音乐页那首歌按「⋯」→「让 TA 邀我听这首」——不走概率、不等冷却</div>' +
'<div class="gs-row"><span>邀你听 · 带一句</span><div class="stepper" id="sm-set-iline" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-iline-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="sm-set-hint">TA 邀你听某首歌时，紧跟一张这首歌的摘句</div>' +
'<div class="mps-group">歌词摘取<em>摘进字卡库的歌词 · 被 TA 说出来的机会</em></div>' +
'<div class="gs-row"><span>歌词进回复池</span><div class="stepper" id="sm-set-lyricprob" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-lyricprob-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="sm-set-hint">TA 听歌时会随机把一句喜欢的歌词摘进「专属字卡 → 歌词摘取」（每首歌只掷一次，可能整首不摘，也不会把整首塞进去）。每次 TA 组织回复时按这个概率把摘到的歌词放进抽句池；设 0＝只存不用（仍能在字卡库拼字造句、手动发）。</div>' +
'<div class="mps-group">替你动手<em>放着歌的时候 TA 插的手</em></div>' +
'<div class="gs-row"><span>预订下一首</span><div class="stepper" id="sm-set-reserve" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-reserve-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="sm-set-hint">聊天过程中 TA 有概率「预订」下一首要播的音乐：把这首歌排进播放队列（底部播放条的「播放队列」里可见），并在聊天里发送系统消息；被预订的歌会按你排的顺序先播（设 0 = TA 从不预订下一首）</div>' +
'<div class="gs-row"><span>曲终切歌</span><div class="stepper" id="sm-set-next" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-next-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="gs-row"><span>曲终随机挑</span><div class="stepper" id="sm-set-rand" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-rand-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="gs-row"><span>曲终换模式</span><div class="stepper" id="sm-set-modep" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-modep-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="sm-set-hint">一起听完一首歌时，TA 按上面三个概率主动控制播放：切到下一首 / 随机挑一首 / 把播放模式换成顺序播放·列表循环·随机播放·单曲循环；三个都不中就正常自动切下一首（全设 0 = TA 从不主动控制）</div>' +
'<div class="sm-set-row"><span>联系人可暂停你的播放</span><label class="toggle"><input type="checkbox" id="sm-set-pause-en"' + (settings.taPauseEn ? ' checked' : '') + '><span class="tk"></span></label></div>' +
'<div class="gs-row"><span>播放中·TA 暂停再播放概率</span><div class="stepper" id="sm-set-pauseprob" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-pauseprob-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="sm-set-hint">播放歌曲时 TA 有小概率突然暂停播放（聊天里发一张字卡），几秒后再帮你点播放恢复（再发一张字卡）；字卡文案在【字卡库 → 其他互动功能字卡 → 音乐】可逐张开关。上方开关关闭或概率设 0 = 关闭 TA 暂停权限；同一首歌只触发一次、触发后 10 分钟内不重复（不会一直暂停又继续）</div>' +
'<div class="gs-row"><span>帮你收藏</span><div class="stepper" id="sm-set-favprob" data-min="0" data-max="100" data-step="5"><button class="stp-min">−</button><input class="stp-val" id="sm-set-favprob-val" readonly><button class="stp-max">+</button></div></div>' +
'<div class="sm-set-hint">你播放歌曲听一会儿后，TA 有概率把这首歌收进「TA的收藏」（音乐页收藏 tab 右边可查看；已收藏过的歌不重复判定，两次收藏间隔至少 90 秒）</div>' +
'<div class="sm-set-row"><span>本地音频缓存</span><span id="sm-storage-use" style="color:var(--muted);font-size:12px">计算中…</span></div>' +
'<div class="mail-actions"><button class="cc-tool" id="sm-diag-req">诊断邀请</button><button class="cc-tool" id="sm-clear-cache">清理本地音频缓存</button><button class="cc-tool" id="sm-set-close">关闭</button></div>');
document.getElementById('sm-set-close').addEventListener('click', () => { document.getElementById('tc-mask').hidden = true; });
const diagBtn = document.getElementById('sm-diag-req');
if (diagBtn) diagBtn.addEventListener('click', function () {
const remain = Math.max(0, settings.cooldownMs - (Date.now() - cooldownAt));
const lines = [
'歌库: ' + library.length + ' 首',
'maybeMusicRequest: ' + (typeof window.maybeMusicRequest),
'reqProb: ' + settings.reqProb + ' → 实际 ' + (typeof settings.reqProb === 'number' ? settings.reqProb : 5) + '%',
'cooldownMs: ' + settings.cooldownMs,
'冷却剩余: ' + Math.ceil(remain / 1000) + ' s',
'openTCPanel: ' + (typeof window.openTCPanel),
'chatAddSystem: ' + (typeof window.chatAddSystem)
];
window.openTCPanel('音乐邀请诊断', '<div class="sm-set-hint">' + lines.join('<br>') + '</div><div class="mail-actions"><button class="cc-tool" id="sm-diag-force">强制触发一次</button><button class="cc-tool" id="sm-diag-close">关闭</button></div>');
document.getElementById('sm-diag-close').addEventListener('click', () => { document.getElementById('tc-mask').hidden = true; });
document.getElementById('sm-diag-force').addEventListener('click', () => {
document.getElementById('tc-mask').hidden = true;
if (!library.length) { toast('library 为空，无法触发'); return; }
const track = library[Math.floor(Math.random() * library.length)];
if (!openMusicInvitePanel(track.id, false)) { toast('邀请面板没能打开，请重进音乐页再试'); return; }
prewarmLocalAudio(track.id);
});
});
const clearBtn = document.getElementById('sm-clear-cache');
if (clearBtn) clearBtn.addEventListener('click', clearLocalAudioCache);
refreshStorageUse();
const bindProbStep = (id, key, def, max) => {
const valEl = document.getElementById(id + '-val');
const box = document.getElementById(id);
if (!valEl || !box) return;
valEl.value = probOf(settings[key], def);
box.querySelector('.stp-min').addEventListener('click', () => {
const nv = Math.max(0, (parseInt(valEl.value, 10) || 0) - 5);
valEl.value = nv; settings[key] = nv; saveSettings();
});
box.querySelector('.stp-max').addEventListener('click', () => {
const nv = Math.min(max, (parseInt(valEl.value, 10) || 0) + 5);
valEl.value = nv; settings[key] = nv; saveSettings();
});
};
bindProbStep('sm-set-prob', 'reqProb', 5, 30);
bindProbStep('sm-set-iyes', 'inviteYes', 20, 100);
bindProbStep('sm-set-iwait', 'inviteWait', 20, 100);
bindProbStep('sm-set-ino', 'inviteNo', 10, 100);
bindProbStep('sm-set-iline', 'inviteLineProb', 35, 100);
bindProbStep('sm-set-lyricprob', 'lyricPoolProb', 40, 100);
bindProbStep('sm-set-reserve', 'taReserveProb', 6, 100);
bindProbStep('sm-set-next', 'taNextProb', 15, 100);
bindProbStep('sm-set-rand', 'taRandProb', 10, 100);
bindProbStep('sm-set-modep', 'taModeProb', 5, 100);
bindProbStep('sm-set-pauseprob', 'taPauseProb', 3, 100);
bindProbStep('sm-set-favprob', 'taFavProb', 20, 100);
const syncPauseEn = function () {
const box = document.getElementById('sm-set-pauseprob');
if (box) box.style.opacity = settings.taPauseEn ? '' : '0.4';
const valEl = document.getElementById('sm-set-pauseprob-val');
if (valEl) valEl.style.pointerEvents = settings.taPauseEn ? '' : 'none';
};
const pauseEnCb = document.getElementById('sm-set-pause-en');
if (pauseEnCb) {
pauseEnCb.addEventListener('change', () => {
settings.taPauseEn = pauseEnCb.checked;
saveSettings();
syncPauseEn();
});
}
syncPauseEn();
const cool = document.getElementById('sm-set-cool');
if (cool) cool.addEventListener('change', () => { settings.cooldownMs = Number(cool.value); saveSettings(); });
const floatCb = document.getElementById('sm-set-float');
if (floatCb) floatCb.addEventListener('change', () => { settings.floatEn = floatCb.checked; floatHideByWidget = false; saveSettings(); syncFloatToggle(); renderFloat(); });
const wcov = document.getElementById('sm-set-wcov');
if (wcov) wcov.addEventListener('change', () => {
settings.widgetCoverMode = wcov.value;
saveSettings();
const m = findTrack(currentId);
if (m) setWidgetCover(m);
});
}
function bindWidget() {
const playBtn = document.getElementById('mw-play');
const prevBtn = document.getElementById('mw-prev');
const nextBtn = document.getElementById('mw-next');
const heartBtn = document.getElementById('mw-heart');
const modeBtn = document.getElementById('mw-mode');
const queueBtn = document.getElementById('mw-queue');
const bar = document.getElementById('mw-bar');
const fill = document.getElementById('mw-fill');
const knob = document.getElementById('mw-knob');
const curEl = document.getElementById('mw-cur');
const durEl = document.getElementById('mw-dur');
if (playBtn) playBtn.addEventListener('click', () => toggle(true));
if (modeBtn) modeBtn.addEventListener('click', cycleMode);
if (queueBtn) queueBtn.addEventListener('click', openQueuePanel);
if (prevBtn) prevBtn.addEventListener('click', () => prev(true));
if (nextBtn) nextBtn.addEventListener('click', () => next(true));
if (heartBtn) {
heartBtn.addEventListener('click', () => {
const m = findTrack(currentId);
if (!m) { toast('请先播放一首歌'); return; }
const liked = toggleFav(m.id);
toast(liked ? '已收藏' : '已取消收藏');
});
syncHeartIcons();
}
const fHeart = document.getElementById('sm-f-heart');
if (fHeart) {
fHeart.addEventListener('click', () => {
const m = findTrack(currentId);
if (!m) { toast('请先播放一首歌'); return; }
const liked = toggleFav(m.id);
toast(liked ? '已收藏' : '已取消收藏');
});
}
const pbHeart = document.getElementById('sm-pb-heart');
if (pbHeart) {
pbHeart.addEventListener('click', () => {
const m = findTrack(currentId);
if (!m) { toast('请先播放一首歌'); return; }
const liked = toggleFav(m.id);
toast(liked ? '已收藏' : '已取消收藏');
});
syncHeartIcons();
}
if (bar) {
bar.addEventListener('click', (e) => {
if (!audio || !audio.duration) return;
const r = bar.getBoundingClientRect();
audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
});
}
if (fill && curEl && durEl && knob) {
const iv = setInterval(() => {
if (!audio || !audio.duration) return;
if (musicBuffering()) return; // #795：缓冲期保留「缓冲中」文案，别拿冻住的时间盖回去
const pct = audio.currentTime / audio.duration * 100;
fill.style.width = pct + '%';
knob.style.left = pct + '%';
curEl.textContent = fmtDur(audio.currentTime);
durEl.textContent = fmtDur(audio.duration);
}, 500);
window._mwProgressTimer = iv;
}
const wSong = document.getElementById('mw-song');
if (wSong && !currentId) wSong.textContent = '未在播放';
const wArtist = document.getElementById('mw-artist');
if (wArtist && !currentId) wArtist.textContent = '音乐';
}
const musicApp = document.querySelector('.app[data-app="music"]');
const musicPage = document.getElementById('page-music');
if (musicApp && musicPage) {
musicApp.addEventListener('click', () => {
const editing = Array.from(document.querySelectorAll('.app-grid')).some(g => g.classList.contains('editing'));
if (editing) return;
document.querySelectorAll('.page').forEach(p => p.hidden = true);
musicPage.hidden = false;
renderPage();
probeAllMissingDurations();
ensureMissingCovers();
});
}
const musicBack = document.getElementById('music-back');
if (musicBack) {
musicBack.addEventListener('click', () => {
document.querySelectorAll('.page').forEach(p => p.hidden = true);
const home = document.getElementById('page-phone');
if (home) home.hidden = false;
});
}
document.querySelectorAll('#page-music .fav-tab').forEach(tab => {
tab.addEventListener('click', () => {
curTab = tab.dataset.mtab;
document.querySelectorAll('#page-music .fav-tab').forEach(x => x.classList.toggle('sel', x === tab));
document.querySelectorAll('#page-music .cal-card').forEach(c => { c.hidden = c.dataset.mpanel !== curTab; });
if (curTab === 'pl') renderPlaylists();
if (curTab === 'fav') renderFavList();
if (curTab === 'favta') renderTaFavList();
if (curTab === 'his') renderHistory();
});
});
const upBtn = document.getElementById('music-upload');
if (upBtn) upBtn.addEventListener('click', triggerUpload);
const urlBtn = document.getElementById('music-add-url');
if (urlBtn) urlBtn.addEventListener('click', openAddUrl);
const batchBtn = document.getElementById('music-batch');
if (batchBtn) batchBtn.addEventListener('click', openBatch);
const batchMgmt = document.getElementById('music-batch-manage');
if (batchMgmt) batchMgmt.addEventListener('click', () => { if (musicBatch) exitBatch(); else enterBatch(); });
const vipClean = document.getElementById('music-vip-clean');
if (vipClean) vipClean.addEventListener('click', openVipClean);
const setBtn = document.getElementById('music-set');
if (setBtn) setBtn.addEventListener('click', openSettings);
window.__openMusicSettings = openSettings; // v41：音乐页右上角按钮已删，播放器「设置」/「⋯」走这里
const playBtn = document.getElementById('sm-play');
if (playBtn) playBtn.addEventListener('click', () => toggle());
const modeBtn = document.getElementById('sm-mode');
if (modeBtn) modeBtn.addEventListener('click', cycleMode);
const fModeBtn = document.getElementById('sm-f-mode');
if (fModeBtn) fModeBtn.addEventListener('click', cycleMode);
const prevBtn = document.getElementById('sm-prev');
if (prevBtn) prevBtn.addEventListener('click', () => prev());
const nextBtn = document.getElementById('sm-next');
if (nextBtn) nextBtn.addEventListener('click', () => next());
const queueBtn = document.getElementById('sm-queue');
if (queueBtn) queueBtn.addEventListener('click', openQueuePanel);
const fPlay = document.getElementById('sm-f-play');
if (fPlay) fPlay.addEventListener('click', () => toggle());
const fPrev = document.getElementById('sm-f-prev');
if (fPrev) fPrev.addEventListener('click', () => prev());
const fNext = document.getElementById('sm-f-next');
if (fNext) fNext.addEventListener('click', () => next());
const fQueue = document.getElementById('sm-f-queue');
if (fQueue) fQueue.addEventListener('click', openQueuePanel);
/* v70（用户截图 3 圈的位置）：完整悬浮窗右上角那个按钮由「收起为最小」改成「关闭」。
   点＝直接关掉悬浮小框（音乐继续播）；长按 520ms＝仍收成最初版单行小框，老习惯保留。 */
function closeFloatMini() {
floatClosed = true;
try { saveSettings(); } catch (x1) {}
renderFloat();
toast('已关闭悬浮小框（音乐继续播放）');
}
const fCollapse = document.getElementById('sm-f-collapse');
if (fCollapse) {
let lpTimer = null, longFired = false;
fCollapse.addEventListener('pointerdown', (e) => {
if (e) { try { e.stopPropagation(); } catch (x0) {} }
longFired = false;
clearTimeout(lpTimer);
lpTimer = setTimeout(() => { longFired = true; toggleFloatMin(); }, 520);
});
['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) => {
fCollapse.addEventListener(ev, () => clearTimeout(lpTimer));
});
fCollapse.addEventListener('click', (e) => {
clearTimeout(lpTimer);
if (longFired) { longFired = false; return; }
if (e) { try { e.stopPropagation(); } catch (x1) {} }
closeFloatMini();
});
}
/* v68：最小态右侧那个按钮同样是「关闭」；想恢复大小长按小框，想重新打开去「音乐 → 悬浮播放小框」开。 */
const fMiniClose = document.getElementById('sm-f-mini-close');
if (fMiniClose) fMiniClose.addEventListener('click', (e) => {
if (e) { try { e.stopPropagation(); } catch (x0) {} }
closeFloatMini();
});
const fMiniPlay = document.getElementById('sm-f-mini-play');
if (fMiniPlay) fMiniPlay.addEventListener('click', () => toggle());
const fToggle = document.getElementById('music-float-en');
if (fToggle) {
fToggle.addEventListener('change', () => {
settings.floatEn = fToggle.checked;
floatClosed = false;
floatHideByWidget = false; // 用户显式操作悬浮小窗开关 → 清除小组件抑制
saveSettings();
renderFloat();
});
}
function bootMusic() {
loadAll();
{
const known = { 2613048732: { name: 'Moonlit Dream', artist: 'DLSS · shell（月光梦）', cover: 'https://p2.music.126.net/cXuoNwFzgFoQF7bGvC2mIQ==/109951169832660411.jpg' }, 27538343: { name: 'Baby', artist: 'EXO-K', cover: '' } };
let changed = false;
const before = library.length;
library = library.filter(m => !(m.playlistId === 'spl_default' && (m.neteaseId === '28815250' || m.neteaseId === '2064961530')));
if (library.length !== before) changed = true;
library.forEach(m => {
if (m.playlistId === 'spl_default' && m.neteaseId) {
const k = known[m.neteaseId];
if (k && (!m.name || m.name.indexOf('网易云音乐-') === 0)) {
m.name = k.name; m.artist = k.artist; changed = true;
}
if (k && k.cover && !m.cover) { m.cover = k.cover; changed = true; }
}
});
if (changed) saveLibrary();
library.forEach(m => {
if (m.playlistId === 'spl_default' && m.neteaseId && m.name && m.name.indexOf('网易云音乐-') === 0) {
fetchNeteaseInfo(String(m.neteaseId), (info) => {
const mm = findTrack(m.id);
if (mm && info && info.name) {
mm.name = info.name;
if (info.artist) mm.artist = info.artist;
if (info.duration && !mm.duration) mm.duration = info.duration;
saveLibrary();
renderPage();
}
});
}
});
}
renderPage();
probeAllMissingDurations();
}
/* v3.50.x：给「播放器」新界面（music-yz.js）的只读/控制接口（必须在闭包内，才能访问 library / playTrack） */
  window.__yzMusic = {
  lib: function () { try { return library.slice(); } catch (e) { return []; } },
  playlists: function () { try { return playlists.slice(); } catch (e) { return []; } },
  current: function () { try { return library.find(function (m) { return m.id === currentId; }) || null; } catch (e) { return null; } },
  playing: function () { try { return !!window.__musicPlaying; } catch (e) { return false; } },
  /* v90：自定义当前歌曲封面（上传图片压缩后传入 dataURL） */
  setCover: function (id, dataUrl) {
    try {
      var m = library.find(function (x) { return x.id === id; });
      if (!m) return false;
      m.cover = String(dataUrl || '');
      saveLibrary();
      try { renderPage(); } catch (e1) {}
      try { setWidgetCover(m); } catch (e2) {}
      return true;
    } catch (e) { return false; }
  },
  play: function (id) { try { playTrack(id, false); return true; } catch (e) { return false; } },
  toggle: function () { try { toggle(); } catch (e) {} },
  next: function () { try { next(); } catch (e) {} },
  prev: function () { try { prev(); } catch (e) {} },
  isFav: function (id) { try { return isFav(id); } catch (e) { return false; } },
  toggleFav: function (id) { try { toggleFav(id); return isFav(id); } catch (e) { return false; } },
  favIds: function () { try { return favIds(); } catch (e) { return []; } },
  addSong: function (o) {
  try {
  o = o || {};
  var id = o.id || ('yz_' + Date.now());
  var hit = library.find(function (m) { return m.id === id; });
  if (!hit && o.neteaseId) hit = library.find(function (m) { return String(m.neteaseId || '') === String(o.neteaseId); });
  if (hit) { playTrack(hit.id, false); return hit.id; }
  var m = {
  id: id, name: o.name || '未知曲目', artist: o.artist || '',
  url: o.url || '', source: o.url ? 'url' : 'local',
  duration: Number(o.duration) || 0, cover: o.cover || '',
  neteaseId: o.neteaseId || '', addedAt: Date.now()
  };
  library.push(m); saveLibrary();
  try { renderLibrary(); } catch (e) {}
  try { renderLibFilter(); } catch (e) {}
  playTrack(id, false);
  return id;
  } catch (e) { try { console.error('[yz addSong]', e && e.message || e); } catch (x) {} return null; }
  },
  saveLyric: function (id, lrc) {
  try {
  var m = library.find(function (x) { return x.id === id; });
  if (!m) return false;
  m.lrc = String(lrc || '');
  saveLibrary();
  return true;
  } catch (e) { return false; }
  },
  /* v39：外文歌词的中文译文（网易云 tlyric）单独存，原歌词结构不动 */
  saveTlrc: function (id, tlrc) {
  try {
  var m = library.find(function (x) { return x.id === id; });
  if (!m) return false;
  m.tlrc = String(tlrc || '');
  saveLibrary();
  return true;
  } catch (e) { return false; }
  },
  /* v3.51：给「正在播放」大页用的进度/模式/音量接口 */
  time: function () {
  try {
  var cur = (audio && isFinite(audio.currentTime)) ? audio.currentTime : 0;
  var dur = (audio && isFinite(audio.duration) && audio.duration > 0) ? audio.duration : 0;
  if (!dur) { var m = library.find(function (x) { return x.id === currentId; }); dur = (m && m.duration) || 0; }
  return { cur: cur, dur: dur };
  } catch (e) { return { cur: 0, dur: 0 }; }
  },
  seek: function (t) {
  try {
  if (!audio) return;
  var dur = isFinite(audio.duration) && audio.duration > 0 ? audio.duration : Infinity;
  audio.currentTime = Math.max(0, Math.min(dur, Number(t) || 0));
  } catch (e) {}
  },
  pause: function () { try { if (window.__musicPlaying) toggle(); } catch (e) {} },
  getMode: function () { return mode; },
  cycleMode: function () { try { cycleMode(); } catch (e) {} return mode; },
  getVolume: function () { try { return audio ? audio.volume : 1; } catch (e) { return 1; } },
  setVolume: function (v) { try { if (audio) audio.volume = Math.max(0, Math.min(1, Number(v))); } catch (e) {} },
  /* v79（用户直派「管理音乐：全选 / 删除 / 移动」）：给管理面板用的增删与排序入口 */
  removeSongs: function (ids) {
  try {
  var set = {};
  (ids || []).forEach(function (x) { set[String(x)] = 1; });
  if (!Object.keys(set).length) return library.length;
  var curGone = !!set[String(currentId)];
  library = library.filter(function (m) { return !set[String(m.id)]; });
  if (curGone) { try { teardownAudio(); } catch (e1) {} currentId = null; }
  saveLibrary();
  try { renderPage(); } catch (e2) {}
  return library.length;
  } catch (e) { return -1; }
  },
  moveSongs: function (ids, dir) {
  try {
  var set = {};
  (ids || []).forEach(function (x) { set[String(x)] = 1; });
  if (!Object.keys(set).length) return false;
  var picked = library.filter(function (m) { return set[String(m.id)]; });
  var rest = library.filter(function (m) { return !set[String(m.id)]; });
  if (dir === 'top') library = picked.concat(rest);
  else if (dir === 'bottom') library = rest.concat(picked);
  else if (dir === 'up') {
  var out = library.slice();
  for (var i = 1; i < out.length; i++) {
  if (set[String(out[i].id)] && !set[String(out[i - 1].id)]) {
  var t = out[i - 1]; out[i - 1] = out[i]; out[i] = t;
  }
  }
  library = out;
  } else if (dir === 'down') {
  var out2 = library.slice();
  for (var j = out2.length - 2; j >= 0; j--) {
  if (set[String(out2[j].id)] && !set[String(out2[j + 1].id)]) {
  var t2 = out2[j + 1]; out2[j + 1] = out2[j]; out2[j] = t2;
  }
  }
  library = out2;
  }
  saveLibrary();
  try { renderPage(); } catch (e3) {}
  return true;
  } catch (e) { return false; }
  },
  /* v80（用户直派「管理音乐加一个可以移动到别的歌单的功能」）：把勾选的歌移进指定歌单 */
  moveSongsTo: function (ids, plId) {
  try {
  var set = {};
  (ids || []).forEach(function (x) { set[String(x)] = 1; });
  if (!Object.keys(set).length) return 0;
  var n = 0;
  library.forEach(function (m) {
  if (!set[String(m.id)]) return;
  if (String(m.playlistId || '') === String(plId)) return;
  m.playlistId = String(plId);
  n++;
  });
  if (!n) return 0;
  saveLibrary();
  try { renderPage(); } catch (e4) {}
  try { renderLibFilter(); } catch (e5) {}
  return n;
  } catch (e) { return -1; }
  }
  };

setupFloatDrag();
bindWidget();
if (window.__mochiDataReady) {
bootMusic();
} else {
document.addEventListener('mochi-restore-done', function h() {
document.removeEventListener('mochi-restore-done', h);
bootMusic();
});
}
document.addEventListener('contact-switched', function () {
try {
taActive = false;
cooldownAt = 0;
reqData = null;
myInvitePending = false; // 我方那条「在飞」闸同属互动状态：旧桌面的在飞不许把新桌口的邀请挡掉
libFilter = 'all';
libRenderShown = LIB_RENDER_LIMIT; // 切联系人时重置窗口化渲染计数
clearTaFavTimer();
try { renderFloat(); } catch (e) {}
try { syncTaFavTab(); renderTaFavList(); } catch (e) {}
} catch (e) {}
});
})();

if (window.__mochiLoaded) window.__mochiLoaded.push("music-player.js");
} catch (__e) { if (window.__mochiErrLoaded) window.__mochiErrLoaded.push("music-player.js"); try { console.error("[JS] music-player.js", __e && __e.message || __e); } catch (x) {} if (window.__jsErrors) window.__jsErrors.push("[music-player.js] " + String(__e && __e.message || __e)); } })();
</script>
<script>/* inline: music-yz.js */
/* 正在播放大页（点音乐页左下歌名弹出）：歌词 / 收藏 / 进度 / 模式 / 定时 / 音量 */
if (window.__mochiLoaded) window.__mochiLoaded.push("music-yz.js");
(function () {
try {
var P = window.__yzMusic;
if (!P) return;

function $(id) { return document.getElementById(id); }
function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function fmt(sec) {
  sec = Math.max(0, Math.floor(Number(sec) || 0));
  var m = Math.floor(sec / 60), s = sec % 60;
  return m + ':' + (s < 10 ? '0' : '') + s;
}
function toast(msg) { try { if (typeof window.toast === 'function') window.toast(msg); } catch (e) {} }
function partner() {
  try { return window.activeStore().get('lbl-partner') || 'TA'; } catch (e) { return 'TA'; }
}

var lastPage = 'page-music';
var sleepUntil = 0;
var ly = { id: '', lines: [], state: 'idle', err: '', idx: -2, hold: 0, sel: -1 };
/* v39：外文歌词的中文译文（默认显示，可一键收起） */
var trOn = true;
try {
  var _trPref = localStorage.getItem((window.activePrefix ? window.activePrefix() : '') + ':yz-lrc-tr');
  if (_trPref === '0') trOn = false;
} catch (e) {}
function saveTrOn() {
  try { localStorage.setItem((window.activePrefix ? window.activePrefix() : '') + ':yz-lrc-tr', trOn ? '1' : '0'); } catch (e) {}
}
function injectTrStyle() {
  if (document.getElementById('npTrStyle')) return;
  var st = document.createElement('style');
  st.id = 'npTrStyle';
  st.textContent = [
    /* v52（图 3）：原文一行、译文单独一行居中显示；译文更小、字距更开，
       颜色比原文淡，当前句的译文稍微加深一点，跟着同一句一起高亮/滚动。 */
    '.np-lrc-tr{display:block;font-size:.6em;line-height:1.5;font-weight:400;color:#b3b3b3;letter-spacing:1.2px;margin-top:6px;word-break:break-word}',
    '.np-lrc-line.cur .np-lrc-tr{color:#9a9a9a}',
    '.np-lrc-chip.on{background:#111;color:#fff;border-color:#111}',
    '@media (max-width:360px){',
    '.np-lrc-bar{gap:4px}',
    '.np-lrc-chip{padding:5px 8px;font-size:10.5px}',
    '.np-lrc-sizes button{padding:5px 5px;font-size:10.5px}',
    '}',
    '[data-theme="dark"] .np-lrc-tr{color:#8a8a8a}',
    '[data-theme="dark"] .np-lrc-line.cur .np-lrc-tr{color:#a9a9a9}',
    '[data-theme="dark"] .np-lrc-chip.on{background:#efefef;color:#111;border-color:#efefef}'
  ].join('');
  document.head.appendChild(st);
}
/* 滑动歌词 seek + 双击检测（触屏/桌面通用，不依赖 dblclick 事件） */
var seekState = { user: false, moved: false, preview: -1, lastProg: 0, startY: 0, timer: null, moveReset: null };
var tapState = { li: -1, at: 0 };

function isOpen() { var p = $('page-now'); return !!(p && !p.hidden); }

/* ---------- 打开 / 收起 ---------- */
function openNow(force) {
  var p = $('page-now');
  if (!p) return;
  var cur = P.current();
  if (!cur && !force) { toast('先播放一首，再点歌名'); return; }
  var vis = null;
  document.querySelectorAll('.page').forEach(function (x) { if (!x.hidden) vis = x.id; });
  if (vis && vis !== 'page-now') lastPage = vis;
  document.querySelectorAll('.page').forEach(function (x) { x.hidden = true; });
  p.hidden = false;
  ly.sel = -1;
  closePops();
  closeQuote();
  closeTaPop();
  render(true);
  setTimeout(function () { render(true); }, 80);
}
function closeNow() {
  var p = $('page-now');
  if (!p) return;
  closeLyric();
  closePops();
  closeTaPop();
  document.querySelectorAll('.page').forEach(function (x) { x.hidden = true; });
  var back = document.getElementById(lastPage || 'page-music') || document.getElementById('page-music');
  if (back) back.hidden = false;
}

/* ---------- 渲染 ---------- */
function coverHtml(m) {
  if (m && m.cover) return '<img src="' + esc(m.cover) + '" alt="">';
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
}
function srcName(m) { return m && m.neteaseId ? '网易云' : ((m && m.source === 'local') ? '本地' : '音乐'); }

var MODE_TXT = { list: '顺序播放', shuffle: '随机播放', single: '单曲循环' };
var MODE_ICO = {
  list: '<path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/>',
  shuffle: '<path d="M2 11a5 5 0 0 1 5-5h13"/><path d="m16 3 4 3-4 3"/><path d="M22 13a5 5 0 0 1-5 5H4"/><path d="m8 21-4-3 4-3"/>',
  single: '<path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 014-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 01-4 4H3"/>'
};

var lastSig = '';
function paintPlay(playing) {
  var ico = $('npPlayIco');
  if (ico) ico.innerHTML = playing ? '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>' : '<path d="M8 5v14l11-7z"/>';
}
function render(force) {
  if (!isOpen()) return;
  var m = P.current();
  if (!m) {
    /* v18：无曲目时保留「未在播放」空态，不再自动收起——这样双击桌面播放器卡也能进来看 */
    lastSig = '';
    if ($('npTitle')) $('npTitle').textContent = '未在播放';
    if ($('npArtist')) $('npArtist').textContent = '先去曲库挑一首';
    if ($('npCur')) $('npCur').textContent = '0:00';
    if ($('npDur')) $('npDur').textContent = '-0:00';
    if ($('npFill')) $('npFill').style.width = '0%';
    if ($('npKnob')) $('npKnob').style.left = '0%';
    try { paintPlay(false); } catch (e) {}
    return;
  }
  var playing = P.playing();
  var sig = [m.id, m.cover || '', m.name, m.artist, playing ? 1 : 0, P.getMode(), P.isFav(m.id) ? 1 : 0].join('|');
  if (!force && sig === lastSig) return;
  lastSig = sig;

  var cov = $('npCover');
  if (cov) { cov.innerHTML = coverHtml(m); cov.style.backgroundImage = ''; }
  if ($('npTitle')) $('npTitle').textContent = m.name || '未命名';
  if ($('npArtist')) $('npArtist').textContent = (m.artist || '未知歌手') + ' · ' + srcName(m);
  paintPlay(playing);

  var mode = P.getMode();
  if ($('npModeTxt')) $('npModeTxt').textContent = MODE_TXT[mode] || '顺序播放';
  if ($('npModeIco')) $('npModeIco').innerHTML = MODE_ICO[mode] || MODE_ICO.list;

  var liked = P.isFav(m.id);
  var fi = $('npFavIco');
  if (fi) fi.setAttribute('fill', liked ? 'currentColor' : 'none');
  if ($('npFav')) $('npFav').classList.toggle('on', liked); // v43：收藏已挪到歌词上方，用胶囊态显示
  if ($('npFavTxt')) $('npFavTxt').textContent = liked ? '已收藏' : '收藏';

  if (ly.id !== m.id && isLyricOpen()) loadLyric(m);
}

function tick() {
  if (!isOpen()) return;
  var m = P.current();
  if (!m) {
    /* v18：无曲目时保持「未在播放」空态，不再自动收起（否则双击进来 1 秒就被踢回去） */
    return;
  }
  render(false);
  var t = P.time();
  var cur = t.cur, dur = t.dur;
  var pct = dur > 0 ? Math.min(100, cur / dur * 100) : 0;
  if ($('npFill')) $('npFill').style.width = pct + '%';
  if ($('npKnob')) $('npKnob').style.left = pct + '%';
  if ($('npCur')) $('npCur').textContent = fmt(cur);
  if ($('npDur')) $('npDur').textContent = dur > 0 ? ('-' + fmt(dur - cur)) : '-0:00';
  paintPlay(P.playing());

  if (sleepUntil) {
    var left = Math.max(0, Math.round((sleepUntil - Date.now()) / 1000));
    if ($('npTimerTxt')) $('npTimerTxt').textContent = fmt(left);
    var tb = $('npTimer'); if (tb) tb.classList.add('on');
    if (!left) {
      sleepUntil = 0;
      P.pause();
      if ($('npTimerTxt')) $('npTimerTxt').textContent = '定时';
      if ($('npTimer')) $('npTimer').classList.remove('on');
      toast('定时到，已暂停');
    }
  } else {
    if ($('npTimerTxt')) $('npTimerTxt').textContent = '定时';
    if ($('npTimer')) $('npTimer').classList.remove('on');
  }
  if (isLyricOpen()) followLyric(false);
  taChance();
  lyricCardChance();
}

/* ---------- 进度拖动 ---------- */
function seekFromEvent(e) {
  var rail = $('npRail'); if (!rail) return;
  var r = rail.getBoundingClientRect();
  var x = (e.touches ? e.touches[0].clientX : e.clientX);
  var p = Math.max(0, Math.min(1, (x - r.left) / Math.max(1, r.width)));
  var t = P.time();
  P.seek(p * (t.dur || 0));
  if ($('npFill')) $('npFill').style.width = (p * 100) + '%';
  if ($('npKnob')) $('npKnob').style.left = (p * 100) + '%';
  if ($('npCur')) $('npCur').textContent = fmt(p * (t.dur || 0));
}
function bindRail() {
  var rail = $('npRail'); if (!rail || rail.__npBound) return;
  rail.__npBound = 1;
  var dragging = false;
  rail.addEventListener('pointerdown', function (e) { dragging = true; try { rail.setPointerCapture(e.pointerId); } catch (x) {} seekFromEvent(e); e.preventDefault(); });
  rail.addEventListener('pointermove', function (e) { if (dragging) { seekFromEvent(e); e.preventDefault(); } });
  rail.addEventListener('pointerup', function (e) { dragging = false; seekFromEvent(e); });
  rail.addEventListener('pointercancel', function () { dragging = false; });
}

/* ---------- 歌词 ---------- */
function lrcParse(txt) {
  var out = [];
  var CREDIT = /^(作词|作曲|编曲|制作人|监制|出品|发行|录音|录音师|录音助理|录音工程|混音|混音工程|母带|[和合]声|[和合]声编写|吉他|贝斯|鼓|键盘|弦乐|OP|SP|词|曲)\s*[:：]/i;
  String(txt || '').split(/\r?\n/).forEach(function (line) {
    var stamps = line.match(/\[\d{1,3}:\d{1,2}(?:[.:]\d{1,3})?\]/g);
    if (!stamps) return;
    var body = line.replace(/\[[^\]]*\]/g, '').trim();
    if (!body) return;
    if (CREDIT.test(body)) return;
    if (out.length < 6 && /^.{1,30}\s+-\s+.{1,30}(\(|（|$)/.test(body)) return;
    stamps.forEach(function (s) {
      var q = s.match(/\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/);
      if (!q) return;
      var t = Number(q[1]) * 60 + Number(q[2]) + (q[3] ? Number((q[3] + '00').slice(0, 3)) / 1000 : 0);
      out.push({ t: t, txt: body });
    });
  });
  out.sort(function (a, b) { return a.t - b.t; });
  return out;
}
var LRC_SIZE_KEY = ':yz-lrc-size';
var lsize = 'm';
try { lsize = localStorage.getItem((window.activePrefix ? window.activePrefix() : '') + LRC_SIZE_KEY) || 'm'; } catch (e) {}
function saveSize(v) {
  lsize = v;
  try { localStorage.setItem((window.activePrefix ? window.activePrefix() : '') + LRC_SIZE_KEY, v); } catch (e) {}
}

function isLyricOpen() { var el = $('npLrc'); return !!(el && !el.hidden); }

function paintLyric() {
  var box = $('npLrcBody');
  if (!box) return;
  injectTrStyle();
  box.setAttribute('data-sz', lsize);
  var cur = P.current();
  if (!cur) { box.innerHTML = '<div class="np-lrc-line">还没在放歌</div>'; return; }
  if (ly.state === 'loading') { box.innerHTML = '<div class="np-lrc-line">正在取歌词…</div>'; return; }
  if (ly.state === 'none' || !ly.lines.length) {
    box.innerHTML = '<div class="np-lrc-line">' + esc(ly.err || '这一首没有歌词') + '</div>' +
      '<div style="padding-top:16px"><button class="np-lrc-chip" id="npLrcRetry">重新取一次</button></div>';
    return;
  }
  var hasTr = false;
  for (var q = 0; q < ly.lines.length; q++) { if (ly.lines[q].tr) { hasTr = true; break; } }
  box.innerHTML = '<div class="np-lrc-pad"></div>' + ly.lines.map(function (l, i) {
    return '<div class="np-lrc-line" data-li="' + i + '">' + esc(l.txt) +
      ((trOn && l.tr) ? '<span class="np-lrc-tr">' + esc(l.tr) + '</span>' : '') + '</div>';
  }).join('') + '<div class="np-lrc-pad"></div>';
  var tb = $('npLrcTr');
  if (tb) {
    tb.hidden = !hasTr;
    tb.classList.toggle('on', trOn && hasTr);
    tb.textContent = trOn ? '译文开' : '译文关';
  }
  ly.idx = -2;
  followLyric(true);
}

/* ---------- 中文译文（v39）：外文歌词同时给中文；进字卡也带上 ---------- */
function hasCJKStr(s) { return /[\u3400-\u9fff]/.test(s); }
function isForeignLine(t) {
  var s = String(t || '');
  if (!s.trim()) return false;
  if (/[\u3040-\u30ff\uac00-\ud7af\u0400-\u04ff]/.test(s)) return true;   // 日文假名 / 韩文 / 西里尔
  if (/[A-Za-z\u00c0-\u024f]/.test(s) && !hasCJKStr(s)) return true;      // 纯拉丁字母
  return false;
}
function needTr(lines) {
  var n = 0, f = 0;
  for (var i = 0; i < (lines || []).length; i++) {
    var t = String(lines[i].txt || '').trim();
    if (!t) continue;
    n++;
    if (isForeignLine(t)) f++;
  }
  return n > 0 && f / n >= 0.3;
}
/* 有些歌词源把中文译文直接混在正文里（「（译文）」单独一行，或与上一句同一时间戳的中文行）。
   先把它收成上一句的 tr，避免显示成两句、也不让译文重复出现。 */
function absorbInlineTr() {
  if (!ly.lines.length) return;
  var out = [];
  for (var i = 0; i < ly.lines.length; i++) {
    var L = ly.lines[i];
    var t = String(L.txt || '').trim();
    var prev = out.length ? out[out.length - 1] : null;
    /* 「原文（译文）」挤在同一行：拆成原文 + tr，避免译文重复两遍 */
    var tail = t.match(/^(.*?)\s*[（(]\s*([^（()）]{2,80})\s*[）)]\s*$/);
    if (tail && hasCJKStr(tail[2]) && isForeignLine(tail[1])) {
      L.txt = tail[1].trim();
      if (!L.tr) L.tr = tail[2].trim();
      t = String(L.txt).trim();
      prev = out.length ? out[out.length - 1] : null;
    }
    var m = t.match(/^[（(]\s*(.+?)\s*[）)]$/);
    if (m && hasCJKStr(m[1]) && prev && isForeignLine(prev.txt)) {
      if (!prev.tr) prev.tr = m[1];
      continue;
    }
    if (prev && isForeignLine(prev.txt) && !isForeignLine(t) && hasCJKStr(t) &&
      Math.abs((L.t || 0) - (prev.t || 0)) < 0.06 && t.length <= 40) {
      if (!prev.tr) prev.tr = t;
      continue;
    }
    out.push(L);
  }
  ly.lines = out;
}
function mergeTr(list) {
  if (!list || !list.length || !ly.lines.length) return false;
  var hit = false;
  for (var i = 0; i < ly.lines.length; i++) {
    var L = ly.lines[i], best = null, bd = 1e9;
    if (L.tr) { hit = true; continue; }
    for (var j = 0; j < list.length; j++) {
      var d = Math.abs((list[j].t || 0) - (L.t || 0));
      if (d < bd) { bd = d; best = list[j]; }
    }
    if (best && bd <= 0.45 && best.txt) { L.tr = best.txt; hit = true; }
  }
  if (!hit && list.length === ly.lines.length) {
    for (var k = 0; k < ly.lines.length; k++) { if (list[k].txt && !ly.lines[k].tr) { ly.lines[k].tr = list[k].txt; hit = true; } }
  }
  return hit;
}
function loadTr(m) {
  if (!m) return;
  injectTrStyle();
  var cached = String(m.tlrc || '');
  if (cached) { if (mergeTr(lrcParse(cached))) paintLyric(); }
  if (!needTr(ly.lines)) return;
  var nid = String(m.neteaseId || '');
  if (!nid) return;
  var wantId = m.id;
  if (m.__trTried === nid) return;
  m.__trTried = nid;
  fetch('https://music-api.gdstudio.xyz/api.php?types=lyric&source=netease&id=' + encodeURIComponent(nid))
    .then(function (r) { return r.json(); })
    .then(function (j) {
      var raw = String((j && j.tlyric) || '');
      if (!raw) return;
      m.tlrc = raw;
      try { if (P.saveTlrc) P.saveTlrc(m.id, raw); } catch (e) {}
      if (ly.id !== wantId) return;
      if (mergeTr(lrcParse(raw))) paintLyric();
    })
    .catch(function () {});
}
/* 摘句/引用/进字卡统一走这里：原文 +（有译文时）换行接中文 */
function lineOut(i) {
  var l = ly.lines[i];
  if (!l) return '';
  var t = String(l.txt || '').trim();
  var tr = String(l.tr || '').trim();
  return tr ? (t + '\n' + tr) : t;
}

function loadLyric(m, force) {
  if (!m) return;
  if (!force && ly.id === m.id && ly.state !== 'idle') return;
  ly = { id: m.id, lines: [], state: 'loading', err: '', idx: -2, hold: 0, sel: -1 };
  closeQuote();
  paintLyric();

  var cached = String(m.lrc || '');
  if (cached) {
    var ls0 = lrcParse(cached);
    if (ls0.length) { ly.lines = ls0; absorbInlineTr(); ly.state = 'ok'; paintLyric(); loadTr(m); setTimeout(lyricCardChance, 400); return; }
  }
  var nid = String(m.neteaseId || '');
  if (!nid) { ly.state = 'none'; ly.err = '本地歌曲暂无歌词'; paintLyric(); return; }

  var done = false;
  var timer = setTimeout(function () { if (!done) miss('歌词接口超时，稍后再试'); }, 15000);
  function ok(lines, raw) {
    if (done) return; done = true; clearTimeout(timer);
    if (ly.id !== m.id) return;
    if (!lines || !lines.length) { miss('这一首没有歌词（多半是纯音乐）'); return; }
    ly.lines = lines; absorbInlineTr(); ly.state = 'ok'; ly.err = '';
    if (raw) { try { m.lrc = raw; if (P.saveLyric) P.saveLyric(m.id, raw); } catch (e) {} }
    paintLyric();
    loadTr(m);
    setTimeout(lyricCardChance, 400);
  }
  function miss(msg) {
    if (done) return; done = true; clearTimeout(timer);
    if (ly.id !== m.id) return;
    ly.state = 'none'; ly.err = msg || '歌词没取到，联网后再试'; paintLyric();
  }
  function take(raw) {
    var lines = lrcParse(raw);
    if (lines.length) { ok(lines, raw); return true; }
    return false;
  }
  function viaGd() {
    return fetch('https://music-api.gdstudio.xyz/api.php?types=lyric&source=netease&id=' + encodeURIComponent(nid))
      .then(function (r) { return r.json(); })
      .then(function (j) { return take((j && (j.lyric || j.lrc)) || ''); })
      .catch(function () { return false; });
  }
  function viaMeting() {
    return fetch('https://api.injahow.cn/meting/?server=netease&type=lrc&id=' + encodeURIComponent(nid))
      .then(function (r) { return r.text(); })
      .then(function (t) { return take(t); })
      .catch(function () { return false; });
  }
  function viaVkeys() {
    return fetch('https://api.vkeys.cn/v2/music/netease/lyric?id=' + encodeURIComponent(nid))
      .then(function (r) { return r.json(); })
      .then(function (j) { return take((j && j.data && (j.data.lrc || j.data.lyric)) || ''); })
      .catch(function () { return false; });
  }
  viaGd().then(function (hit) {
    if (done || hit) return;
    return viaMeting().then(function (hit2) {
      if (done || hit2) return;
      return viaVkeys().then(function (hit3) {
        if (done || hit3) return;
        miss('歌词没取到 · 检查网络后再试');
      });
    });
  });
}

function followLyric(force) {
  if (!isLyricOpen() || !ly.lines.length) return;
  var box = $('npLrcBody'); if (!box) return;
  var ct = P.time().cur;
  var i = -1;
  for (var k = 0; k < ly.lines.length; k++) { if (ly.lines[k].t <= ct + 0.25) i = k; else break; }
  if (i < 0) i = 0;   /* 还没播到第一句时也高亮第一句，避免整屏全灰 */
  if (!force && i === ly.idx) return;
  ly.idx = i;
  var nodes = box.querySelectorAll('.np-lrc-line');
  for (var n = 0; n < nodes.length; n++) nodes[n].classList.toggle('cur', n === i);
  /* 用户正在手动滑动歌词时，不抢着把视图拉回当前播放行 */
  if (seekState.user) return;
  if (nodes[i] && (force || Date.now() - ly.hold > 4000)) {
    try {
      var br = box.getBoundingClientRect(), nr = nodes[i].getBoundingClientRect();
      var want = (nr.top - br.top) + box.scrollTop - (box.clientHeight - nr.height) / 2;
      seekState.lastProg = Date.now();
      box.scrollTop = Math.max(0, want);
    } catch (e) {}
  }
}

/* ---------- 滑动歌词 → 同步歌曲进度 ---------- */
function lrcCenterIndex(box) {
  var nodes = box.querySelectorAll('.np-lrc-line[data-li]');
  if (!nodes.length) return -1;
  var br = box.getBoundingClientRect();
  var mid = br.top + br.height / 2;
  var best = -1, bestD = 1e9;
  for (var i = 0; i < nodes.length; i++) {
    var r = nodes[i].getBoundingClientRect();
    var d = Math.abs((r.top + r.height / 2) - mid);
    if (d < bestD) { bestD = d; best = i; }
  }
  var v = Number(nodes[best].getAttribute('data-li'));
  return isFinite(v) ? v : -1;
}
function lrcMarkCenter(box, idx) {
  var nodes = box.querySelectorAll('.np-lrc-line[data-li]');
  for (var j = 0; j < nodes.length; j++) {
    nodes[j].classList.toggle('cur', Number(nodes[j].getAttribute('data-li')) === idx);
  }
}
function lrcSeekCommit(box) {
  if (!isLyricOpen() || ly.state !== 'ok' || !ly.lines.length) return;
  var idx = lrcCenterIndex(box);
  if (idx < 0 || !ly.lines[idx]) return;
  var t = ly.lines[idx].t || 0;
  ly.idx = idx;
  ly.hold = 0;                 /* 交给 tick 立刻按新进度继续跟随，不再压抑 4 秒 */
  lrcMarkCenter(box, idx);
  try { P.seek(t); } catch (e) {}
  toast('已跳到 ' + fmt(t) + ' · ' + String(ly.lines[idx].txt || '').slice(0, 12));
}
function bindLyricScrollSeek() {
  var box = $('npLrcBody');
  if (!box || box.__lrcSeekBound) return;
  box.__lrcSeekBound = 1;
  function arm() {
    if (ly.state !== 'ok' || !ly.lines.length) return;
    seekState.user = true;
    box.classList.add('seeking');
    clearTimeout(seekState.moveReset);
  }
  function moved(e) {
    if (e && e.touches && e.touches[0]) {
      if (Math.abs(e.touches[0].clientY - seekState.startY) > 8) seekState.moved = true;
    }
    arm();
  }
  function onScroll() {
    if (!seekState.user) return;                       // 程序自动跟随触发的 scroll
    if (Date.now() - seekState.lastProg < 150) return;
    var idx = lrcCenterIndex(box);
    if (idx >= 0 && idx !== seekState.preview) { seekState.preview = idx; lrcMarkCenter(box, idx); }
    clearTimeout(seekState.timer);
    seekState.timer = setTimeout(function () {
      seekState.user = false;
      box.classList.remove('seeking');
      lrcSeekCommit(box);
      seekState.preview = -1;
    }, 300);
  }
  box.addEventListener('touchstart', function (e) {
    seekState.startY = (e.touches && e.touches[0]) ? e.touches[0].clientY : 0;
    seekState.moved = false;
    arm();
  }, { passive: true });
  box.addEventListener('touchmove', moved, { passive: true });
  box.addEventListener('touchend', function () {
    /* 只是轻点（双击引用歌词的前半下）不算拖进度：以前这里无条件 commit，
       结果点一下歌词就把歌曲 seek 到那一行，听起来像「进度被回放」 */
    if (!seekState.moved) {
      clearTimeout(seekState.timer);
      seekState.user = false;
      seekState.preview = -1;
      box.classList.remove('seeking');
      seekState.moveReset = setTimeout(function () { seekState.moved = false; }, 380);
      return;
    }
    onScroll();
    seekState.moveReset = setTimeout(function () { seekState.moved = false; }, 380);
  }, { passive: true });
  box.addEventListener('wheel', function () { arm(); onScroll(); }, { passive: true });
  box.addEventListener('scroll', onScroll, { passive: true });
}

function openLyric() {
  var w = $('npLrc'); if (!w) return;
  var cur = P.current();
  if (!cur) { toast('先播放一首'); return; }
  closePops();
  w.hidden = false;
  if ($('npCover')) $('npCover').style.display = 'none';
  if ($('npTopC')) $('npTopC').hidden = false;
  if ($('npLyricBtn')) $('npLyricBtn').textContent = '封面';
  if ($('npMain')) $('npMain').classList.add('lrc-on');
  loadLyric(cur);
  setTimeout(function () { followLyric(true); }, 140);
}
function closeLyric() {
  var w = $('npLrc'); if (w) w.hidden = true;
  if ($('npCover')) $('npCover').style.display = '';
  if ($('npTopC')) $('npTopC').hidden = true;
  if ($('npLyricBtn')) $('npLyricBtn').textContent = '歌词';
  if ($('npMain')) $('npMain').classList.remove('lrc-on');
  closeQuote();
  ly.sel = -1;
}

/* 点歌词 → 弹窗（引用给 TA / 复制 / 取消） */
function openQuote(i) {
  if (!ly.lines[i]) return;
  ly.sel = i; ly.hold = Date.now();
  var box = $('npLrcBody');
  if (box) {
    var nodes = box.querySelectorAll('.np-lrc-line');
    for (var k = 0; k < nodes.length; k++) nodes[k].classList.toggle('sel', k === i);
  }
  if ($('npQuoteTxt')) $('npQuoteTxt').textContent = lineOut(i);
  if ($('npQuotePop')) $('npQuotePop').hidden = false;
}
function closeQuote() {
  if ($('npQuotePop')) $('npQuotePop').hidden = true;
  var box = $('npLrcBody');
  if (box) Array.prototype.forEach.call(box.querySelectorAll('.np-lrc-line'), function (n) { n.classList.remove('sel'); });
}

function sendQuote(toTa) {
  var cur = P.current();
  if (!cur || ly.sel < 0 || !ly.lines[ly.sel]) { toast('先点一句歌词'); return; }
  var line = lineOut(ly.sel);
  if (!line.trim()) { toast('这一句是空的，换一句'); return; }
  var q = { t: line + '\n——《' + (cur.name || '') + '》' + (cur.artist ? ' · ' + cur.artist : '') };
  var txt = toTa ? '刚听到这一句，想起你' : '这一句，想给你听';
  var sent = false;
  try {
    if (typeof window.chatSendQuote === 'function') { sent = !!window.chatSendQuote(txt, q, !!toTa); }
    else if (typeof window.chatSendMsg === 'function') { window.chatSendMsg(q.t); sent = true; }
  } catch (e) {}
  if (!sent) { toast('没发出去：可能聊天限流或还没准备好，稍后再试'); return; }
  toast(toTa ? 'TA 引用了一句歌词' : '已引用到聊天');
  closeQuote();
  closeLyric();
}

/* ---------- TA 也摘一句（概率，同字卡随机模式） ---------- */
var TA_P = { off: 0, low: 10, mid: 25, high: 55 };
var TA_TXT = { off: '关闭，TA 不会自己摘句', low: '每次听歌约 10% 会摘一句', mid: '每次听歌约 25% 会摘一句', high: '每次听歌约 55% 会摘一句' };
var taMode = 'mid';
var taLast = 0;
function taLoad() {
  try {
    var st = window.activeStore && window.activeStore();
    var o = JSON.parse((st && st.get && st.get('yz-lrc-ta')) || 'null');
    if (o && TA_P[o.mode] != null) taMode = o.mode;
  } catch (e) {}
}
function taSave() {
  try { var st = window.activeStore && window.activeStore(); if (st && st.set) st.set('yz-lrc-ta', JSON.stringify({ mode: taMode })); } catch (e) {}
}
function taPick() {
  if (!ly.lines.length) return -1;
  var i = Math.floor(Math.random() * ly.lines.length);
  for (var k = 0; k < ly.lines.length; k++) {
    var j = (i + k) % ly.lines.length;
    if ((ly.lines[j].txt || '').trim()) return j;
  }
  return -1;
}
function taSayOne(silent) {
  var cur = P.current();
  if (!cur) { if (!silent) toast('先播放一首'); return false; }
  if (ly.id !== cur.id || !ly.lines.length) {
    if (!silent) toast(ly.state === 'loading' ? '歌词还在路上' : '这一首还没有歌词');
    return false;
  }
  var i = taPick();
  if (i < 0) { if (!silent) toast('这一首没有可摘的句子'); return false; }
  var line = lineOut(i);
  /* v53（用户直派「歌词的摘取是他随机选择进专属字卡，不强制每首选取后加入，也不强制每首选取」）：
     摘句发到聊天不再强制同步进字卡库；进「专属字卡 → 歌词摘取」改由 lyricCardChance 随机掷，
     一首歌可能一句都不摘，也可能只摘一句。 */
  var q = { t: line + '\n——《' + (cur.name || '') + '》' + (cur.artist ? ' · ' + cur.artist : '') };
  var ok = false;
  try {
    if (typeof window.chatSendQuote === 'function') { ok = !!window.chatSendQuote('刚听到这一句，想起你', q, true); }
    else if (typeof window.chatSendMsg === 'function') { window.chatSendMsg(q.t); ok = true; }
  } catch (e) {}
  if (!silent) toast(ok ? 'TA 摘了一句：' + line.slice(0, 14) : '没发出去，聊天可能还没准备好');
  return ok;
}
function taChance() {
  if (taMode === 'off') return;
  if (Date.now() - taLast < 5 * 60000) return;
  if (!P.playing()) return;
  var cur = P.current();
  if (!cur || ly.id !== cur.id || !ly.lines.length) return;
  taLast = Date.now();
  if (Math.random() * 100 >= (TA_P[taMode] || 0)) return;
  taSayOne(true);
}
/* v53：TA 听歌时随机把一句歌词摘进「专属字卡 → 歌词摘取」。
   每首歌只掷一次骰子（ly.cardSong 记当前歌），没掷中就整首不摘，不强制每首歌都留一句；
   摘到也只加一条，不会把整首歌词都塞进字卡库。 */
var LYRIC_CARD_P = 40;
function lyricCardChance() {
  try {
    if (!P.playing()) return;
    var cur = P.current();
    if (!cur) return;
    if (ly.id !== cur.id || !ly.lines.length) return;
    if (cur.__lyCardRolled) return;   /* 同一首只掷一次，反复打开歌词页不会重复薅卡 */
    cur.__lyCardRolled = 1;
    if (Math.random() * 100 >= LYRIC_CARD_P) return;
    var i = taPick();
    if (i < 0) return;
    var line = lineOut(i);
    if (!line.trim()) return;
    if (window.__ccLyricPick) window.__ccLyricPick(line, cur.name);
  } catch (e) {}
}
function openTaPop() {
  var chips = $('npTaChips');
  if (chips) Array.prototype.forEach.call(chips.querySelectorAll('button'), function (b) {
    b.classList.toggle('on', b.getAttribute('data-ta') === taMode);
  });
  if ($('npTaNote')) $('npTaNote').textContent = '现在：' + (TA_TXT[taMode] || '');
  if ($('npTaPop')) $('npTaPop').hidden = false;
}
function closeTaPop() { if ($('npTaPop')) $('npTaPop').hidden = true; }

/* ---------- 浮层 ---------- */
function closePops() {
  ['npVolPop', 'npTimerPop', 'npMorePop'].forEach(function (id) { var e = $(id); if (e) e.hidden = true; });
}
function pop(id) {
  var e = $(id); if (!e) return null;
  try { var sb = e.querySelector('[data-more="set"]'); if (sb) sb.remove(); } catch (eS) {}
  var was = !e.hidden;
  closePops();
  e.hidden = was;
  return e;
}
function morePop() {
  var e = $('npMorePop');
  if (!e) {
    e = document.createElement('div');
    e.className = 'np-pop';
    e.id = 'npMorePop';
    /* 与静态 .np-pop 一致带 hidden：否则首次点击 was=!e.hidden 为 true，菜单会被立刻关掉 */
    e.hidden = true;
    /* v43 用户直派「播放器右上角的设置删除」：⋯ 里不再放「音乐设置」，只留定时关闭 / 收起
       v70：换壁纸的入口从「设置 → 外观」挪进这里（用户截图 1 右上角这个 ⋯） */
    e.innerHTML = '<div class="np-pop-btns" style="grid-template-columns:1fr"><button data-more="bg">播放器背景（换壁纸）</button><button data-more="timer">定时关闭</button><button data-more="close">收起播放器</button></div>';
    $('page-now').appendChild(e);
  }
  try { var sb = e.querySelector('[data-more="set"]'); if (sb) sb.remove(); } catch (eS) {}
  var was = !e.hidden;
  closePops();
  e.hidden = was;
}

/* ---------- 绑定 ---------- */

/* v41：音乐页右上角「音乐设置」入口已删；播放器「设置」与「⋯ → 音乐设置」都走这里 */
function openMusicSettings() {
  try {
    if (typeof window.__openMusicSettings === 'function') { window.__openMusicSettings(); return; }
  } catch (e) {}
  toast('设置入口还没准备好');
}

function bind() {
  taLoad();
  if ($('npClose')) $('npClose').addEventListener('click', closeNow);
  if ($('npPrev')) $('npPrev').addEventListener('click', function () { P.prev(); setTimeout(function () { ly.id = ''; render(true); }, 120); });
  if ($('npNext')) $('npNext').addEventListener('click', function () { P.next(); setTimeout(function () { ly.id = ''; render(true); }, 120); });
  if ($('npPlay')) $('npPlay').addEventListener('click', function () { P.toggle(); setTimeout(function () { render(true); }, 100); });
  if ($('npFav')) $('npFav').addEventListener('click', function () {
    var m = P.current(); if (!m) return;
    var on = P.toggleFav(m.id);
    toast(on ? '已收藏' : '已取消收藏');
    render(true);
  });
  if ($('npLyricBtn')) $('npLyricBtn').addEventListener('click', function () {
    if (isLyricOpen()) closeLyric(); else openLyric();
  });
  /* v39：点封面 → 切到歌词；点歌词空白处 → 切回封面 */
  var covEl = $('npCover');
  if (covEl && !covEl.__npCovTap) {
    covEl.__npCovTap = 1;
    covEl.style.cursor = 'pointer';
    covEl.addEventListener('click', function () {
      if (!P.current()) { toast('先播放一首'); return; }
      openLyric();
    });
  }
  var lrcWrap = $('npLrc');
  if (lrcWrap && !lrcWrap.__npBlankTap) {
    lrcWrap.__npBlankTap = 1;
    lrcWrap.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('.np-lrc-line, button, .np-pop')) return;
      if (seekState.moved) return;
      if (!isLyricOpen()) return;
      closeLyric();
    });
  }
  /* 译文开关（外文歌词才显示） */
  injectTrStyle();
  var lrcBar = document.querySelector('#npLrc .np-lrc-bar');
  if (lrcBar && !$('npLrcTr')) {
    var trBtn = document.createElement('button');
    trBtn.type = 'button';
    trBtn.className = 'np-lrc-chip';
    trBtn.id = 'npLrcTr';
    trBtn.textContent = '译文开';
    trBtn.hidden = true;
    lrcBar.insertBefore(trBtn, $('npLrcSizes'));
    trBtn.addEventListener('click', function () {
      trOn = !trOn;
      saveTrOn();
      paintLyric();
      toast(trOn ? '已显示中文译文' : '已收起中文译文');
    });
  }
  if ($('npLrcBack')) $('npLrcBack').addEventListener('click', closeLyric);
  var sizes = $('npLrcSizes');
  if (sizes && !sizes.__npBound) {
    sizes.__npBound = 1;
    sizes.addEventListener('click', function (e) {
      var b = e.target.closest('[data-lsz]'); if (!b) return;
      saveSize(b.getAttribute('data-lsz'));
      Array.prototype.forEach.call(sizes.querySelectorAll('button'), function (x) { x.classList.toggle('on', x === b); });
      paintLyric();
    });
    Array.prototype.forEach.call(sizes.querySelectorAll('button'), function (x) { x.classList.toggle('on', x.getAttribute('data-lsz') === lsize); });
  }

  if ($('npMode')) $('npMode').addEventListener('click', function () { P.cycleMode(); render(true); });
  if ($('npQueue')) $('npQueue').addEventListener('click', function () {
    var q = $('sm-queue'); if (q) q.click(); else toast('队列还没准备好');
  });
  if ($('npTimer')) $('npTimer').addEventListener('click', function () { pop('npTimerPop'); });
  if ($('npSet')) $('npSet').addEventListener('click', openMusicSettings);
  if ($('npVol')) $('npVol').addEventListener('click', function () {
    var e = pop('npVolPop');
    if (e && !e.hidden) {
      var v = Math.round((P.getVolume() || 0) * 100);
      if ($('npVolRange')) $('npVolRange').value = v;
      if ($('npVolNum')) $('npVolNum').textContent = v + '%';
    }
  });
  if ($('npMore')) $('npMore').addEventListener('click', morePop);

  if ($('npVolRange') && !$('npVolRange').__npBound) {
    $('npVolRange').__npBound = 1;
    $('npVolRange').addEventListener('input', function () {
      var v = Number(this.value) || 0;
      P.setVolume(v / 100);
      if ($('npVolNum')) $('npVolNum').textContent = v + '%';
    });
  }
  if ($('npTimerPop') && !$('npTimerPop').__npBound) {
    $('npTimerPop').__npBound = 1;
    $('npTimerPop').addEventListener('click', function (e) {
      var b = e.target.closest('[data-min]'); if (!b) return;
      var min = Number(b.getAttribute('data-min')) || 0;
      sleepUntil = min ? Date.now() + min * 60000 : 0;
      if (!sleepUntil && $('npTimerTxt')) $('npTimerTxt').textContent = '定时';
      Array.prototype.forEach.call(this.querySelectorAll('button'), function (x) { x.classList.toggle('sel', x === b); });
      this.hidden = true;
      toast(min ? ('已设置 ' + min + ' 分钟后暂停') : '已关闭定时');
      tick();
    });
  }
  if ($('npLyricTa')) $('npLyricTa').addEventListener('click', openTaPop);

  /* 歌词：双击才弹引用弹窗；单击不弹（滑动结束后误触的 click 也不算） */
  var lbody = $('npLrcBody');
  if (lbody && !lbody.__npBound) {
    lbody.__npBound = 1;
    lbody.addEventListener('click', function (e) {
      if (e.target.closest('#npLrcRetry')) { loadLyric(P.current(), true); return; }
      if (seekState.moved) { tapState.li = -1; tapState.at = 0; return; }
      var line = e.target.closest('.np-lrc-line');
      if (!line || line.getAttribute('data-li') == null) return;
      var i = Number(line.getAttribute('data-li'));
      var now = Date.now();
      if (tapState.li === i && now - tapState.at < 360) {
        tapState.li = -1; tapState.at = 0;
        openQuote(i);
      } else {
        tapState.li = i; tapState.at = now;
      }
    });
  }
  bindLyricScrollSeek();

  /* 引用弹窗按钮：只留「引用给他」「取消」 */
  var qp = $('npQuotePop');
  if (qp && !qp.__npBound) {
    qp.__npBound = 1;
    qp.addEventListener('click', function (e) {
      var b = e.target.closest('[data-qact]');
      if (!b) { if (e.target.closest('[data-qclose]')) closeQuote(); return; }
      var k = b.getAttribute('data-qact');
      if (k === 'me') { sendQuote(false); return; }
      closeQuote();
    });
  }

  /* 摘句概率面板 */
  var tp = $('npTaPop');
  if (tp && !tp.__npBound) {
    tp.__npBound = 1;
    tp.addEventListener('click', function (e) {
      var c = e.target.closest('[data-ta]');
      if (c) {
        taMode = c.getAttribute('data-ta'); taSave();
        Array.prototype.forEach.call($('npTaChips').querySelectorAll('button'), function (x) { x.classList.toggle('on', x.getAttribute('data-ta') === taMode); });
        if ($('npTaNote')) $('npTaNote').textContent = '现在：' + (TA_TXT[taMode] || '');
        return;
      }
      var b = e.target.closest('[data-tact]');
      if (!b) { if (e.target.closest('[data-tclose]')) closeTaPop(); return; }
      var k = b.getAttribute('data-tact');
      if (k === 'now') { taSayOne(false); closeTaPop(); }
      else closeTaPop();
    });
  }

  var more = $('page-now');
  if (more && !more.__npMoreBound) {
    more.__npMoreBound = 1;
    more.addEventListener('click', function (e) {
      var b = e.target.closest('[data-more]'); if (!b) return;
      var k = b.getAttribute('data-more');
      closePops();
      if (k === 'timer') { pop('npTimerPop'); }
      else if (k === 'bg') {
        /* v70：播放器右上角 ⋯ → 播放器背景（换壁纸），面板里管深浅两栏 */
        try { if (window.openNpBgPanel) window.openNpBgPanel(); else toast('播放器背景还没准备好'); } catch (eBg) {}
      }
      else closeNow();
    });
  }

  /* 定时关闭 / 音量 面板右上角「×」：关掉所属浮层 */
  var pn = $('page-now');
  if (pn && !pn.__npPopCloseBound) {
    pn.__npPopCloseBound = 1;
    pn.addEventListener('click', function (e) {
      var x = e.target.closest && e.target.closest('[data-popclose]');
      if (!x) return;
      var pop = x.closest('.np-pop');
      if (pop) pop.hidden = true;
    });
  }

  bindRail();
  bindNames();
  setInterval(tick, 600);
}
/* 双击检测（触屏/桌面通用）：两次快速点击同一元素才触发，按钮点击不计数 */
function bindDblTap(el, fn) {
  if (!el || el.__npDbl) return;
  el.__npDbl = 1;
  el.style.cursor = 'pointer';
  var last = 0;
  el.addEventListener('click', function (e) {
    if (e.target.closest && e.target.closest('button')) return;
    if (!P.current()) return;
    var now = Date.now();
    if (now - last < 360) { last = 0; e.stopPropagation(); fn(); }
    else last = now;
  });
}
function bindNames() {
  /* 音乐页底部播放条：点左下歌名进「正在播放」，保留原来的单击 */
  var info = document.querySelector('#sm-player-bar .sm-pb-info');
  if (info && !info.__npName) {
    info.__npName = 1;
    info.style.cursor = 'pointer';
    info.addEventListener('click', function (e) {
      if (!P.current()) return;
      e.stopPropagation();
      openNow();
    });
  }
  ['sm-pb-name', 'sm-pb-artist'].forEach(function (id) {
    var el = $(id);
    if (!el || el.__npName) return;
    el.__npName = 1;
    el.style.cursor = 'pointer';
    el.addEventListener('click', function (e) {
      if (!P.current()) return;
      e.stopPropagation();
      openNow();
    });
  });
  /* 悬浮播放小框：改为「双击」才进播放器，单击不再进 */
  bindDblTap($('sm-float'), function () { openNow(true); });
  /* v18（用户直派「双击这个本周日常上方的播放器也是可以直接进入播放器」）：
     桌面第二页播放器卡双击进「正在播放」；按钮与进度条区域除外，避免和播放/拖动冲突 */
  var mw = $('music-widget');
  if (mw && !mw.__npDblCard) {
    mw.__npDblCard = 1;
    var lastT = 0;
    mw.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('button, .mw-progress, .mw-bar, input, a')) return;
      var now = Date.now();
      if (now - lastT < 360) { lastT = 0; e.stopPropagation(); openNow(true); }
      else lastT = now;
    });
  }
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
else bind();

window.__npOpen = openNow;
window.__npClose = closeNow;
} catch (e) { try { console.error('[music-now]', e && e.message); } catch (x) {} }
})();

</script>
<script>/* inline: cjian-yz.js */
/* 此间（言字卡风格）：世界 / 状态（此刻·方位·连接·情感）/ 记录
   三个桌面图标 world / connect / state 打开同一页面的不同 tab 与滚动位置 */
if (window.__mochiLoaded) window.__mochiLoaded.push("cjian-yz.js");
(function () {
try {
var SHICHEN = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
var PART = [
  { k: 'wee', label: '凌晨', from: 0, note: 'TA 那边是凌晨了' },
  { k: 'dawn', label: '清晨', from: 5, note: 'TA 那边的清晨' },
  { k: 'morning', label: '上午', from: 8, note: 'TA 那边是上午' },
  { k: 'noon', label: '午后', from: 12, note: 'TA 那边的午后' },
  { k: 'afternoon', label: '下午', from: 14, note: 'TA 那边是下午' },
  { k: 'evening', label: '傍晚', from: 18, note: 'TA 那边的傍晚' },
  { k: 'night', label: '夜里', from: 21, note: 'TA 那边是夜里' }
];
var MOODS = {
  joy: '雀跃', soft: '柔软', calm: '平静', low: '低落', irritable: '烦躁', hot: '燥热',
  ache: '不舒服', flustered: '心慌', wronged: '委屈', tired: '累', sleepy: '困',
  numb: '没劲', mute: '不想说话', away: '走神', miss: '想念', blank: '淡淡的'
};
var MOOD_KEYS = Object.keys(MOODS);
var DIRS = [
  { k: 'f', label: '正前方', x: 50, y: 9, t: '↑' }, { k: 'fr', label: '右前方', x: 78, y: 20, t: '↗' },
  { k: 'r', label: '右侧', x: 89, y: 50, t: '→' }, { k: 'br', label: '右后方', x: 78, y: 80, t: '↘' },
  { k: 'b', label: '后方', x: 50, y: 89, t: '↓' }, { k: 'bl', label: '左后方', x: 22, y: 80, t: '↙' },
  { k: 'l', label: '左侧', x: 11, y: 50, t: '←' }, { k: 'fl', label: '左前方', x: 22, y: 20, t: '↖' }
];
var PRESENCE = {
  near: { label: '身边', desc: '感觉就在身边' },
  nearby: { label: '附近', desc: 'TA 可能就在附近' },
  far: { label: '很远', desc: '能感觉到，但距离很远' },
  unfelt: { label: '感觉不到', desc: '暂时无法感知 TA' },
  gone: { label: '离开', desc: 'TA 暂时不在附近' }
};
var ACTS = {
  sleep: '睡着', rest: '休息', busy: '在忙', rushed: '忙着', free: '空闲', unknown: '说不清'
};

var tab = 'world';
var anchor = '';

function $(id) { return document.getElementById(id); }
function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
function pad2(n) { return (n < 10 ? '0' : '') + n; }
function toast(m) { try { if (typeof window.toast === 'function') window.toast(m); } catch (e) {} }
function pfx() { try { return window.activePrefix ? window.activePrefix() : 'xy-home-v2:default'; } catch (e) { return 'xy-home-v2:default'; } }
function sg(k, d) { try { var v = localStorage.getItem(pfx() + ':yz-cj-' + k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } }
function ss(k, v) { try { localStorage.setItem(pfx() + ':yz-cj-' + k, JSON.stringify(v)); } catch (e) {} }
function who() { try { var s = window.activeStore && window.activeStore(); var n = s && s.get && s.get('lbl-partner'); if (n) return n; } catch (e) {} return 'TA'; }

/* ---------- 时间 ---------- */
function offMin() {
  var o = sg('off', null), now = Date.now();
  if (!o || !o.t || now > o.t) {
    var base = Math.round((Math.random() * 2 - 1) * 12 * 60 / 5) * 5;
    if (Math.abs(base) < 60) base = -300;
    o = { m: base, t: now + (1 + Math.random() * 7) * 3600000 };
    ss('off', o);
  }
  return o.m;
}
function taDate() { return new Date(Date.now() + offMin() * 60000); }
function shichIdx(h) { if (h >= 23 || h < 1) return 0; return Math.floor((h + 1) / 2) % 12; }
function shichName(d) { var h = d.getHours(); return SHICHEN[shichIdx(h)] + (h % 2 === 1 ? '初' : '正'); }
function shichRange(h) {
  var start = (h % 2 === 1) ? h : (h + 23) % 24;
  if (h >= 23 || h < 1) start = 23;
  var end = (start + 2) % 24;
  var e2 = (end + 1) % 24;
  return pad2(start) + ':00-' + pad2(end) + ':59';
}
function partOf(h) { var k = PART[0]; PART.forEach(function (x) { if (h >= x.from) k = x; }); return k; }

/* ---------- 状态 ---------- */
function rollState() {
  var h = taDate().getHours();
  var act = (h >= 23 || h < 6) ? 'sleep' : (h < 8 ? 'rest' : (h < 12 ? 'busy' : (h < 14 ? 'rushed' : (h < 18 ? 'free' : (h < 22 ? 'free' : 'rest')))));
  var p = act === 'sleep' ? 'unfelt' : pick(['near', 'nearby', 'nearby', 'unfelt', 'far', 'gone']);
  var dir = p === 'near' ? 'side' : (p === 'unfelt' ? 'none' : pick(['f', 'fr', 'r', 'br', 'b', 'bl', 'l', 'fl']));
  return {
    p: p, act: act, dir: dir,
    m1: pick(MOOD_KEYS), m2: pick(MOOD_KEYS),
    ym1: pick(MOOD_KEYS), ym2: pick(MOOD_KEYS),
    tone: pick(['平常', '轻一点', '慢一点']),
    beat: pick(['平平的', '软一点', '快半拍']),
    clear: pick(['一说就懂', '不用说完', '懂了一半']),
    read: pick(['平平的', '有点重', '亮了一下']),
    hold: pick(['一说就懂', '接住了', '还差一点']),
    sig: pick(['在看窗外', '刚洗完手', '在等一句话', '把手机扣着', '开着灯没睡', '戴着一只耳机']),
    t: Date.now() + 25 * 60000
  };
}
function state() { var o = sg('st', null); if (!o || !o.t || Date.now() > o.t || !o.p) { o = rollState(); ss('st', o); } return o; }

/* ---------- 聊天统计 ---------- */
var _msgsCache = null, _msgsAt = 0;
function msgs() {
  if (_msgsCache && Date.now() - _msgsAt < 60000) return _msgsCache;
  var arr = null;
  try { var s = window.activeStore && window.activeStore(); var raw = s && s.get && s.get('chat-msgs'); if (raw) arr = JSON.parse(raw); } catch (e) {}
  if (!Array.isArray(arr) || !arr.length) {
    try { arr = JSON.parse(localStorage.getItem(pfx() + ':chat-msgs') || '[]'); } catch (e) { arr = []; }
  }
  _msgsCache = Array.isArray(arr) ? arr : [];
  _msgsAt = Date.now();
  return _msgsCache;
}
function fmtMD(ts) {
  var d = new Date(ts);
  return d.getFullYear() + '年' + (d.getMonth() + 1) + '月' + d.getDate() + '日 ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
}
function fmtTs(ts) {
  if (!ts) return '—';
  // v22：世界感知里的时间统一带月日
  return fmtMD(ts);
}
function median(a) { if (!a.length) return 0; var b = a.slice().sort(function (x, y) { return x - y; }); var m = Math.floor(b.length / 2); return b.length % 2 ? b[m] : (b[m - 1] + b[m]) / 2; }
function connStats() {
  var m = msgs().filter(function (x) { return x && x.ts && !x.special; });
  var out = m.filter(function (x) { return x.side === 'out'; });
  var inn = m.filter(function (x) { return x.side === 'in'; });
  var lat = [];
  for (var i = 0; i < m.length; i++) {
    if (m[i].side !== 'out') continue;
    for (var j = i + 1; j < m.length; j++) {
      if (m[j].side === 'in') { lat.push(m[j].ts - m[i].ts); break; }
      if (m[j].side === 'out') break;
    }
  }
  var med = median(lat) / 1000;
  var level = 0;
  if (med <= 120) level = 0; else if (med <= 600) level = 1; else if (med <= 1800) level = 2; else if (med <= 7200) level = 3; else level = 4;
  if (!m.length) level = 4;
  return {
    outN: out.length, inN: inn.length, latN: lat.length, med: med, level: level,
    lastOut: out.length ? out[out.length - 1].ts : 0,
    lastIn: inn.length ? inn[inn.length - 1].ts : 0,
    lastOutText: out.length ? String(out[out.length - 1].text || '') : '',
    lastInText: inn.length ? String(inn[inn.length - 1].text || '') : ''
  };
}
var LEVELS = ['热络', '通畅', '平常', '慢半拍', '单向'];

/* ---------- 渲染：世界 ---------- */
function worldHtml() {
  var d = taDate(), h = d.getHours(), sh = shichIdx(h), pt = partOf(h), s = state();
  var note = pt.note + ((pt.k === 'night' || pt.k === 'wee') && s.act !== 'sleep' ? '，这个点了还醒着' : (pt.k !== 'night' && pt.k !== 'wee' && s.act === 'sleep' ? '，这个点在睡' : ''));
  var wk = ['日', '一', '二', '三', '四', '五', '六'][d.getDay()];
  var rows = '';
  for (var i = 0; i < 4; i++) {
    var k = (sh + i) % 12, hh = (23 + k * 2) % 24;
    var a = i === 0 ? s.act : (k >= 1 && k <= 4 ? 'rest' : (k <= 7 ? 'busy' : 'free'));
    rows += '<div class="yz-tl"><b>' + SHICHEN[k] + '时</b><span>' + pad2(hh) + ':00-' + pad2((hh + 2) % 24) + ':59</span><em>' + (a === 'sleep' ? '可能在休息' : (a === 'busy' ? '离开中' : (a === 'rushed' ? '在赶一件事' : '可能在附近'))) + '</em></div>';
  }
  return '' +
    '<div class="yz-card"><div class="yz-card-h"><b>TA那边的时间</b><span class="yz-tag">比现实' + (offMin() < 0 ? '慢' : '快') + ' ' + Math.floor(Math.abs(offMin()) / 60) + '小时' + (Math.abs(offMin()) % 60 ? Math.abs(offMin()) % 60 + '分' : '') + '</span>' +
    '<button class="yz-switch on" id="yzCjSw" aria-label="世界开关"></button></div>' +
    '<div class="yz-weather"><i>☁</i><em>多云</em></div>' +
    '<div class="yz-clock"><b>' + pad2(h) + ':' + pad2(d.getMinutes()) + '</b><span>' + shichName(d) + '　' + pt.label + '</span></div>' +
    '<div class="yz-date">' + d.getFullYear() + '年' + (d.getMonth() + 1) + '月' + d.getDate() + '日 · 星期' + wk + '</div>' +
    '<div class="yz-note">' + esc(note) + '</div>' +
    '<div class="yz-note">TA 那边的当地时间是随机定的 · 每隔 1 到 8 小时换一次</div></div>' +
    '<div class="yz-card"><div class="yz-card-h"><b>TA的今日</b><span class="yz-tag">按十二时辰猜的，不是日程表</span></div>' +
    '<div class="yz-shich">' + SHICHEN.map(function (c, i) { return '<i class="' + (i === sh ? 'on' : '') + '">' + c + '</i>'; }).join('') + '</div>' +
    rows + '</div>';
}

/* ---------- 渲染：状态 ---------- */
function stateHtml() {
  var s = state(), c = connStats(), nm = who();
  var p = PRESENCE[s.p] || PRESENCE.unfelt;
  var d = taDate(), h = d.getHours(), pt = partOf(h);
  var dirObj = DIRS.filter(function (x) { return x.k === s.dir; })[0];
  var dirLabel = s.dir === 'side' ? '身边' : (s.dir === 'none' ? '无法判断' : (dirObj ? dirObj.label : '身边'));
  var dial = DIRS.map(function (x) {
    return '<span class="a' + (x.k === s.dir ? ' on' : '') + '" style="left:' + x.x + '%;top:' + x.y + '%;transform:translate(-50%,-50%)">' + x.t + '</span>';
  }).join('');
  var sigAgo = Math.max(1, Math.round((Date.now() - (sg('sigAt', 0) || Date.now() - 11 * 3600000)) / 3600000));
  var hStat = '<div class="yz-card"><div class="yz-card-h"><b>此刻感知</b></div>' +
    '<div class="yz-pills">' +
    '<button class="yz-pill' + (s.p === 'unfelt' && s.act !== 'sleep' ? ' on' : '') + '">感觉不到</button>' +
    '<button class="yz-pill' + (s.p === 'near' ? ' on' : '') + '">身边</button>' +
    '<button class="yz-pill' + (s.act === 'sleep' ? ' on' : '') + '">睡着</button></div>' +
    '<div class="yz-note">' + (s.act === 'sleep' ? 'TA 那边似乎已经睡了。' : (s.p === 'near' ? '感觉就在身边，没走远。' : (s.p === 'nearby' ? 'TA 可能就在附近。' : '这会儿感觉不到 TA。'))) + '</div>' +
    '<div class="yz-kv" style="justify-content:space-between"><span>签名 <b>' + esc(s.sig) + '</b></span><span style="color:#a8a8a8">' + sigAgo + ' 小时前</span></div>' +
    '<div class="yz-2btn"><button id="yzCjSense">感知此刻</button><button id="yzCjDir">感知方位</button></div></div>';

  var hDir = '<div class="yz-card" id="yzCjDirCard"><div class="yz-card-h"><b>方位感知</b><span class="yz-tag">模糊感觉 · 不是精确定位</span></div>' +
    '<div class="yz-dial">' + dial + '<span class="c">你</span></div>' +
    '<div class="yz-grid2"><div><small>方向</small><b>' + esc(dirLabel) + '</b><span>9分钟前</span></div>' +
    '<div><small>距离</small><b>' + esc(s.p === 'unfelt' ? '感觉不到' : p.label) + '</b><span>刚刚</span></div></div></div>';

  var segs = LEVELS.map(function (x, i) {
    return '<i style="flex:1;height:' + (i === c.level ? 3 : 1) + 'px;background:' + (i === c.level ? '#111' : '#e6e6e6') + ';border-radius:2px"></i>';
  }).join('');
  var hConn = '<div class="yz-card" id="yzCjConnCard"><div class="yz-card-h"><b>连接感知</b><span class="yz-tag">近 24 小时</span></div>' +
    '<div class="yz-hi" style="font-size:26px;margin:0 0 2px">' + LEVELS[c.level] + '</div>' +
    '<div class="yz-note" style="margin-bottom:10px">' + (c.level >= 3 ? '这一阵只有一边在说' : (c.level === 2 ? '不紧不慢，各说各的' : '这一阵接得上话')) + '</div>' +
    '<div style="display:flex;gap:6px;align-items:center;margin-bottom:10px">' + segs + '</div>' +
    '<div style="display:flex;justify-content:space-between;font-size:11px;color:#a8a8a8"><span>热络</span><span>通畅</span><span>平常</span><span>慢半拍</span><span>单向</span></div>' +
    '<div class="yz-kv" style="display:block;margin-top:12px">' +
    '<div style="display:flex;justify-content:space-between;padding:4px 0"><span>你最后发出</span><b>' + fmtTs(c.lastOut) + '</b></div>' +
    '<div style="display:flex;justify-content:space-between;padding:4px 0"><span>' + esc(nm) + '最后回于</span><b>' + fmtTs(c.lastIn) + '</b></div>' +
    '<div style="display:flex;justify-content:space-between;padding:4px 0"><span>你连着发了几条，TA 都没回</span><b>' + (c.level >= 4 ? Math.max(0, c.outN - c.inN) : 0) + ' 句</b></div>' +
    '<div style="display:flex;justify-content:space-between;padding:4px 0"><span>' + esc(nm) + '发来你未读</span><b>0 句</b></div>' +
    '<div style="display:flex;justify-content:space-between;padding:4px 0"><span>双向</span><b>你 ' + c.outN + ' 句 · ' + esc(nm) + ' ' + c.inN + ' 句</b></div></div>' +
    '<div class="yz-note" style="margin-top:8px">你发出去到 ' + esc(nm) + ' 回话，中位 ' + (c.latN ? Math.round(c.med) + ' 秒' : '—') + '（' + c.latN + ' 轮）·这条线自己的节奏 180-1200 秒</div>' +
    '<div class="yz-note" style="display:flex;justify-content:space-between;margin-top:6px"><span>干扰　你这头的事</span><span>TA 说的 · 情感感知卡 · 你那一组</span></div></div>';

  var hMood = '<div class="yz-card" id="yzMoodCard"><div class="yz-card-h"><b>情绪感知</b><span class="yz-tag">' + esc(MOODS[s.m1]) + '，想挨着你</span></div>' +
    '<div class="yz-small" style="margin-bottom:6px">TA　TA 自己的心情</div>' +
    '<div class="yz-pills"><span class="yz-pill on">' + esc(MOODS[s.m1]) + '</span><span class="yz-pill">' + esc(MOODS[s.m2]) + '</span></div>' +
    '<div class="yz-quote">' + esc(c.lastInText ? c.lastInText.slice(0, 46) : '没什么特别的事，就是想挨着你坐一会儿') + '</div>' +
    '<div class="yz-by">TA 自述 · ' + fmtMD(d) + '</div>' +
    '<div class="yz-kv">语气 <b>' + s.tone + '</b>　·　心动 <b>' + s.beat + '</b>　·　说明白 <b>' + s.clear + '</b></div>' +
    '<div style="height:1px;background:#f2f2f2;margin:14px 0"></div>' +
    '<div class="yz-small" style="margin-bottom:6px">你　TA 读到的你的心情</div>' +
    '<div class="yz-pills"><span class="yz-pill">' + esc(MOODS[s.ym1]) + '</span><span class="yz-pill">' + esc(MOODS[s.ym2]) + '</span></div>' +
    '<div class="yz-quote">' + esc(c.lastOutText ? c.lastOutText.slice(0, 46) : '在忙吗？不急，你想说的时候我都在') + '</div>' +
    '<div class="yz-by">TA 读你时说的 · ' + fmtMD(d) + '</div>' +
    '<div class="yz-kv">读到的心动 <b>' + s.read + '</b>　·　接住 <b>' + s.hold + '</b></div></div>';

  return hStat + hDir + hConn + hMood;
}

/* ---------- 渲染：记录 ---------- */
var logFilter = 'all';

function dayKey(ts) { var d = new Date(ts); return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate(); }
function dayLabel(d) {
  var n = new Date();
  if (d.toDateString() === n.toDateString()) return '今天';
  var y = new Date(n.getTime() - 864e5);
  if (d.toDateString() === y.toDateString()) return '昨天';
  return (d.getMonth() + 1) + '/' + d.getDate();
}
function hhmm(ts) { return fmtMD(ts); }

function moodLog() {
  var a = sg('moods', null);
  if (Array.isArray(a) && a.length) return a;
  var out = [], n = new Date();
  var todayTimes = [[2, 6], [2, 58], [13, 16], [14, 5], [14, 40]];
  todayTimes.forEach(function (t) {
    var d = new Date(n.getFullYear(), n.getMonth(), n.getDate(), t[0], t[1]);
    if (d.getTime() > Date.now()) return;
    out.push({ ts: d.getTime(), m1: pick(MOOD_KEYS), m2: pick(MOOD_KEYS) });
  });
  if (out.length < 3) {
    for (var i = out.length; i < 3; i++) out.push({ ts: Date.now() - (3 - i) * 5400000, m1: pick(MOOD_KEYS), m2: pick(MOOD_KEYS) });
  }
  [{ d: 12, n: 1 }, { d: 22, n: 8 }, { d: 23, n: 3 }, { d: 28, n: 3 }].forEach(function (x) {
    for (var k = 0; k < x.n; k++) {
      var dd = new Date(Date.now() - x.d * 864e5);
      dd.setHours(9 + k * 2, (k * 17) % 60, 0, 0);
      out.push({ ts: dd.getTime(), m1: pick(MOOD_KEYS), m2: pick(MOOD_KEYS) });
    }
  });
  out.sort(function (p, q) { return q.ts - p.ts; });
  ss('moods', out);
  return out;
}

function historyRows() {
  var out = [];
  moodLog().forEach(function (x) {
    out.push({ ts: x.ts, cat: 'mood', txt: (MOODS[x.m1] || '') + ' · ' + (MOODS[x.m2] || '') });
  });
  (sg('hist', []) || []).forEach(function (x) {
    out.push({ ts: x.ts || Date.now(), cat: 'sense', txt: String(x.txt || '') });
  });
  msgs().forEach(function (m) {
    if (!m || m.special || !m.text || m.side !== 'in') return;
    var t = String(m.text).replace(/\s+/g, ' ').trim();
    if (!t || t.indexOf('data:') === 0) return;
    out.push({ ts: m.ts || 0, cat: 'ta', txt: t.slice(0, 50) });
  });
  out.sort(function (a, b) { return (b.ts || 0) - (a.ts || 0); });
  return out;
}

function logHtml() {
  var moods = moodLog();
  var tk = dayKey(Date.now());
  var today = moods.filter(function (x) { return dayKey(x.ts) === tk; });
  var h = '<div class="yz-card"><div class="yz-card-h"><b>情绪轨迹</b><span class="yz-tag">近 ' + moods.length + ' 次换档</span></div>';
  h += '<div class="yz-mood-sum">今天　<b>换档 ' + today.length + ' 次</b></div>';
  if (today.length) {
    h += '<div class="yz-mood-chips">' + today.slice(0, 8).map(function (x, i) {
      var cur = i === 0;
      return '<div class="yz-mood-chip' + (cur ? ' now' : '') + '"><small>' + (cur ? '现在 · ' : '') + hhmm(x.ts) + '</small>' +
        '<b>' + esc(MOODS[x.m1] || '') + '</b><em>' + esc(MOODS[x.m2] || '') + '</em></div>';
    }).join('') + '</div>';
  }
  var groups = {}, order = [];
  moods.forEach(function (x) {
    if (dayKey(x.ts) === tk) return;
    var k = dayKey(x.ts);
    if (!groups[k]) { groups[k] = []; order.push(k); }
    groups[k].push(x);
  });
  order.forEach(function (k) {
    var arr = groups[k], d = new Date(arr[0].ts);
    h += '<details class="yz-mood-day"><summary><span>' + dayLabel(d) + '</span><em>换档 ' + arr.length + ' 次</em><i>▾</i></summary>' +
      '<div class="yz-mood-daybody">' + arr.map(function (x) {
        return '<div class="yz-mood-line"><b>' + hhmm(x.ts) + '</b><span>' + esc(MOODS[x.m1] || '') + ' + ' + esc(MOODS[x.m2] || '') + '</span></div>';
      }).join('') + '</div></details>';
  });
  var latest = moods[0];
  if (latest) {
    h += '<div class="yz-mood-quote">' + esc(MOODS[latest.m1] || '') + ' · ' + esc(MOODS[latest.m2] || '') + '：' +
      esc(pick(['没什么特别的事，就是想挨着你坐一会儿', '今天有点乱，但想到你就还好', '话到嘴边又咽下去了', '想被你问一句「怎么了」'])) +
      ' · ' + hhmm(latest.ts) + '</div>';
  }
  h += '</div>';

  var all = historyRows();
  var rows = all.filter(function (x) {
    if (logFilter === 'mood') return x.cat === 'mood';
    if (logFilter === 'ta') return x.cat === 'ta';
    if (logFilter === 'sense') return x.cat === 'sense';
    return true;
  }).slice(0, 80);
  h += '<div class="yz-card"><div class="yz-card-h"><b>历史记录</b><span class="yz-tag">' + all.length + ' 条</span>' +
    '<button class="yz-clear" id="yzCjClear">清空</button></div>';
  h += '<div class="yz-chips">' +
    [['all', '全部'], ['mood', '情绪'], ['ta', 'TA 说的话'], ['sense', '感知']].map(function (x) {
      return '<button class="yz-chip' + (logFilter === x[0] ? ' on' : '') + '" data-lfilter="' + x[0] + '">' + x[1] + '</button>';
    }).join('') + '</div>';
  if (!rows.length) h += '<div class="yz-empty" style="padding:16px 0">这一类还没有记录。</div>';
  else h += '<div class="yz-hist">' + rows.map(function (x) {
    var tag = x.cat === 'mood' ? '情绪' : (x.cat === 'ta' ? 'TA' : '感知');
    return '<div class="yz-hist-row"><b>' + tag + '</b><span>' + esc(x.txt) + '</span><i>' + (x.ts ? hhmm(x.ts) : '') + '</i></div>';
  }).join('') + '</div>';
  h += '</div>';
  return h;
}

function hero() {
  var d = taDate(), h = d.getHours();
  var el2 = $('yzCjShi'), el3 = $('yzCjRange');
  if (el2) el2.textContent = shichName(d);
  if (el3) el3.textContent = shichRange(h) + ' · 现实此刻 ' + fmtMD(Date.now());
}

/* ---------- 感知卡：把此刻这一位感知发成一张卡落进聊天 ---------- */
var SENSE_LV = [{ p: 0 }, { p: 20 }, { p: 40 }, { p: 70 }];
function senseGap() { return (1.5 + Math.random() * 3.5) * 3600000; }
function senseCfg() {
  var o = sg('sense', null);
  if (!o || typeof o !== 'object' || typeof o.nextAt !== 'number') {
    o = { lv: 2, nextAt: Date.now() + senseGap(), fail: 0, lastAt: 0 };
    ss('sense', o);
  }
  if (typeof o.lv !== 'number' || o.lv < 0 || o.lv > 3) o.lv = 2;
  return o;
}
function senseProb() { var c = senseCfg(); return SENSE_LV[c.lv] ? SENSE_LV[c.lv].p : 40; }
function senseText() {
  var s = state(), d = taDate(), h = d.getHours(), pt = partOf(h), nm = who(), c = connStats();
  var p = PRESENCE[s.p] || PRESENCE.unfelt;
  var dirObj = DIRS.filter(function (x) { return x.k === s.dir; })[0];
  var dirTxt = s.dir === 'side' ? '↔ 身边' : ((s.dir === 'none' || !dirObj) ? '' : dirObj.t + ' ' + dirObj.label);
  var dist = { near: '很近', nearby: '不远', far: '很远', unfelt: '感觉不到', gone: '离开了' }[s.p] || p.label;
  var feel = dist + (dirTxt ? ' · ' + dirTxt : '') + ' · ' + p.desc;
  var mood = (MOODS[s.m1] || '') + (MOODS[s.m2] ? ' · ' + MOODS[s.m2] : '');
  var mine = (MOODS[s.ym1] || '') + (MOODS[s.ym2] ? ' · ' + MOODS[s.ym2] : '');
  var conn = (LEVELS[c.level] || '平常') + ' · ' + (c.level >= 3 ? '这一阵只有一边在说' : (c.level === 2 ? '不紧不慢，各说各的' : '这一阵接得上话'));
  var off = offMin(), abs = Math.abs(off);
  var taTxt = pad2(h) + ':' + pad2(d.getMinutes()) + ' · ' + pt.label + ' · 多云 · 比现实' + (off < 0 ? '慢' : '快') + ' ' + Math.floor(abs / 60) + '小时' + (abs % 60 ? abs % 60 + '分' : '');
  var yours = c.lastOutText ? String(c.lastOutText).slice(0, 40) : '在忙吗？不急，你想说的时候我都在';
  /* v23（用户直派「感知卡的聊天界面消息参考言字卡」）：改为逐行「键：值」，
     聊天侧据此渲染成言字卡那张白卡；首行仍带【感知卡】标记便于识别与回退 */
  return [
    '【感知卡】' + nm,
    '感知：' + feel,
    '在做：' + (ACTS[s.act] || '说不清'),
    '签名：' + s.sig,
    '心情：' + mood,
    '连接：' + conn,
    'TA 那边：' + taTxt,
    '你：' + mine,
    '读到的心动：' + s.read,
    '接住：' + s.hold,
    '读你时说的：' + yours
  ].join('\n');
}
function senseSend(manual) {
  if (!window.chatAddIn) return false;
  try {
    window.chatAddIn(senseText(), { tag: '感知卡', initiative: !manual, nightAllow: !!manual, rateAllow: true });
    return true;
  } catch (e) { return false; }
}
function paintSense() {
  var c = senseCfg(), p = senseProb();
  Array.prototype.forEach.call(document.querySelectorAll('#yzSenseLv [data-slv]'), function (b) {
    b.classList.toggle('on', parseInt(b.getAttribute('data-slv'), 10) === c.lv);
  });
  var now = $('yzSenseNow');
  if (!now) return;
  if (!p) { now.textContent = '现在：关着 · 这段时间一张都不发'; return; }
  var per = Math.max(1, Math.round(24 / 3.25 * p / 100));
  now.textContent = '现在：每次机会 ' + p + '% · 这一位一天约 ' + per + ' 张 · 连着三次没抽中，第四次必定发一张';
}
function senseTick() {
  try {
    if (document.hidden) return;
    var c = senseCfg(), p = senseProb();
    if (!p) return;
    var now = Date.now();
    if (!c.nextAt || now < c.nextAt) return;
    var h = new Date().getHours();
    if (h >= 23 || h < 7) { c.nextAt = now + 3600000; ss('sense', c); paintSense(); return; }
    var hit = (c.fail || 0) >= 3 || Math.random() * 100 < p;
    if (hit) { senseSend(false); c.fail = 0; c.lastAt = now; }
    else c.fail = (c.fail || 0) + 1;
    c.nextAt = now + senseGap();
    ss('sense', c);
    paintSense();
  } catch (e) {}
}


function render() {
  hero();
  var box = $('yzCjBody');
  if (!box) return;
  Array.prototype.forEach.call(document.querySelectorAll('#yzCjTabs .yz-cj-tab'), function (b) {
    b.classList.toggle('on', b.getAttribute('data-ctab') === tab);
  });
  /* v22（用户直派「世界感知卡只放在截图的位置」）：感知卡不再钉在 tab 上方，
     只在「状态」页、情绪感知卡之后出现一次；其他 tab 收起。 */
  var sense = $('yzSenseCard');
  if (sense && sense.parentNode) sense.parentNode.removeChild(sense);
  box.innerHTML = tab === 'world' ? worldHtml() : (tab === 'state' ? stateHtml() : logHtml());
  if (sense) {
    box.appendChild(sense);
    sense.hidden = (tab !== 'state');
  }

  var sw = $('yzCjSw');
  if (sw) sw.addEventListener('click', function () { sw.classList.toggle('on'); toast(sw.classList.contains('on') ? '世界感知已开启' : '世界感知已关闭'); });
  var sn = $('yzCjSense');
  if (sn) sn.addEventListener('click', function () {
    ss('st', rollState()); ss('sigAt', Date.now());
    pushHist('感知此刻：' + (ACTS[state().act] || '说不清'));
    render(); toast('感知完成');
  });
  var dr = $('yzCjDir');
  if (dr) dr.addEventListener('click', function () {
    var s = state(); s.dir = s.p === 'near' ? 'side' : pick(['f', 'fr', 'r', 'br', 'b', 'bl', 'l', 'fl']); s.t = Date.now() + 25 * 60000; ss('st', s);
    drawDir(); toast('方位已更新');
  });
  var clr = $('yzCjClear');
  if (clr) clr.addEventListener('click', function () {
    var ok = true;
    try { if (typeof window.confirm === 'function') ok = window.confirm('清空历史记录与情绪轨迹？'); } catch (e) {}
    if (!ok) return;
    ss('hist', []); ss('moods', []);
    render(); toast('已清空记录');
  });
  Array.prototype.forEach.call(document.querySelectorAll('#yzCjBody [data-lfilter]'), function (b) {
    b.addEventListener('click', function () { logFilter = b.getAttribute('data-lfilter'); render(); });
  });
  if (anchor === 'conn') {
    var c = $('yzCjConnCard');
    if (c && c.scrollIntoView) setTimeout(function () { try { c.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) {} }, 60);
    anchor = '';
  }
}

function drawDir() {
  var s = state(), card = $('yzCjDirCard');
  if (!card) return;
  Array.prototype.forEach.call(card.querySelectorAll('.a'), function (el) {
    el.classList.remove('on');
    var t = el.textContent;
    var hit = DIRS.filter(function (x) { return x.t === t; })[0];
    if (hit && hit.k === s.dir) el.classList.add('on');
  });
}

function pushHist(txt) {
  var a = sg('hist', []) || [];
  var d = new Date();
  a.push({ t: pad2(d.getHours()) + ':' + pad2(d.getMinutes()), txt: txt, ts: Date.now() });
  while (a.length > 60) a.shift();
  ss('hist', a);
}

/* ---------- 打开 / 返回 ---------- */
function openPageEl(pg) {
  if (!pg) return;
  document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
  pg.hidden = false;
  requestAnimationFrame(function () {
    var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = true;
    var ph = document.querySelector('.phone'); if (ph) ph.classList.add('no-statusbar');
    pg.classList.add('full');
  });
  paintSense();
  setTimeout(senseTick, 1200);
}
function backHomeEl(pg) {
  if (pg) pg.classList.remove('full');
  document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
  var home = document.getElementById('page-phone'); if (home) home.hidden = false;
  var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = false;
  var ph = document.querySelector('.phone'); if (ph) ph.classList.remove('no-statusbar');
}
/* 给聊天顶栏用的情感感知快照（与「状态 · 情感感知」同一份数据） */
window.__yzMoodState = function () {
  try {
    var s = state();
    return {
      m1: MOODS[s.m1] || '', m2: MOODS[s.m2] || '',
      ym1: MOODS[s.ym1] || '', ym2: MOODS[s.ym2] || '',
      tone: s.tone, beat: s.beat, read: s.read, hold: s.hold
    };
  } catch (e) { return null; }
};
window.__yzCjOpen = function (k, sc) {
  tab = (k === 'state' || k === 'log') ? k : 'world';
  anchor = sc || '';
  render();
  var sc2 = $('yzCjScroll'); if (sc2) sc2.scrollTop = 0;
};

/* ---------- 绑定 ---------- */
function bind() {
  paintSense();
  var slv = $('yzSenseLv');
  if (slv) slv.addEventListener('click', function (e) {
    var b = e.target.closest('[data-slv]');
    if (!b) return;
    var lv = parseInt(b.getAttribute('data-slv'), 10) || 0;
    var c = senseCfg();
    c.lv = lv; c.fail = 0; c.nextAt = lv ? Date.now() + senseGap() : 0;
    ss('sense', c); paintSense();
    toast(lv ? ('感知卡已设为「' + ['关', '少', '适中', '勤'][lv] + '」') : '感知卡已关闭');
  });
  var ssd = $('yzSenseSend');
  if (ssd) ssd.addEventListener('click', function () {
    if (senseSend(true)) { toast('感知卡已发进聊天'); }
    else toast('聊天还没准备好');
  });
  setInterval(senseTick, 15 * 60 * 1000);
  var tabs = $('yzCjTabs');
  if (tabs) tabs.addEventListener('click', function (e) {
    var b = e.target.closest('[data-ctab]');
    if (!b) return;
    tab = b.getAttribute('data-ctab'); anchor = ''; render();
  });
  var back = $('yzCjBack');
  if (back) back.addEventListener('click', function () { backHomeEl($('page-cjian')); });
  var cp = $('yzCjCopy');
  if (cp) cp.addEventListener('click', function () {
    var txt = '';
    try { txt = ($('page-cjian') || {}).innerText || ''; } catch (e) {}
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(txt).then(function () { toast('已复制这一屏'); });
      else { var ta = document.createElement('textarea'); ta.value = txt; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); toast('已复制这一屏'); }
    } catch (e) { toast('复制失败'); }
  });
  var ck = $('yzCjClock');
  if (ck) ck.addEventListener('click', function () { render(); toast('已按现在的时间刷新'); });
  var fx = $('yzCjFx');
  if (fx) fx.addEventListener('click', function () {
    ss('st', rollState()); ss('off', null);
    pushHist('换一换：' + (ACTS[state().act] || ''));
    render(); toast('换了一次');
  });

  document.addEventListener('click', function (e) {
    /* v78：整理模式下不拦截——交给桌面「图标设置 / 拖动」接管 */
    var _phW = document.getElementById('page-phone');
    if (_phW && _phW.classList.contains('decor-on')) return;
    var a = e.target.closest && e.target.closest('.app[data-app]');
    if (!a) return;
    var k = a.getAttribute('data-app');
    if (k !== 'worldsense' && k !== 'world' && k !== 'connect' && k !== 'state') return;
    e.preventDefault(); e.stopPropagation();
    openPageEl(document.getElementById('page-cjian'));
    window.__yzCjOpen(k === 'connect' || k === 'state' ? 'state' : 'world', k === 'connect' ? 'conn' : '');
  }, true);

  render();
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
else bind();
} catch (e) { try { console.error('[cjian-yz]', e && e.message); } catch (x) {} }
})();

</script>
<script>/* inline: extras-yz.js */
/* 扩展小功能集合：聊天顶栏情感感知 / 心讯 / 抽一张 / 灵感拾取辅助 */
if (window.__mochiLoaded) window.__mochiLoaded.push("extras-yz.js");
(function () {
try {

function $(id) { return document.getElementById(id); }
function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function toast(m) { try { if (typeof window.toast === 'function') window.toast(m); } catch (e) {} }
function store() { try { return window.activeStore ? window.activeStore() : null; } catch (e) { return null; } }
function partner() { try { var s = store(); var n = s && s.get && s.get('lbl-partner'); if (n) return n; } catch (e) {} return 'TA'; }
function pfx() { try { return window.activePrefix ? window.activePrefix() : 'xy-home-v2:default'; } catch (e) { return 'xy-home-v2:default'; } }

/* ---------- 通用：打开 / 返回全屏页 ---------- */
var lastPageForBack = 'page-phone';
function openPage(pg, fromPage) {
  if (!pg) return;
  var vis = null;
  document.querySelectorAll('.page').forEach(function (p) { if (!p.hidden) vis = p.id; });
  if (vis && vis !== pg.id) lastPageForBack = (fromPage || vis);
  document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
  pg.hidden = false;
  requestAnimationFrame(function () {
    var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = true;
    var ph = document.querySelector('.phone'); if (ph) ph.classList.add('no-statusbar');
    pg.classList.add('full');
  });
}
function closePage(pg) {
  if (pg) pg.classList.remove('full');
  document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
  var back = document.getElementById(lastPageForBack) || document.getElementById('page-phone');
  if (back) back.hidden = false;
  if (back.id === 'page-phone') {
    var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = false;
    var ph = document.querySelector('.phone'); if (ph) ph.classList.remove('no-statusbar');
  }
}

/* ---------- 1. 聊天顶栏：名字下面的情感感知 ---------- */
var MOOD_API_OK = false;
function moodState() {
  try { return (typeof window.__yzMoodState === 'function') ? window.__yzMoodState() : null; } catch (e) { return null; }
}
function paintMood() {
  var el = $('chat-mood');
  if (!el) return;
  var s = moodState();
  if (!s || !s.m1) { el.textContent = ''; el.style.display = 'none'; return; }
  el.style.display = '';
  el.innerHTML = '<i></i><span>' + esc(s.m1) + ' · ' + esc(s.m2) + '</span>';
  el.title = '情感感知：' + (s.m1 || '') + ' · ' + (s.m2 || '') + '（点开世界感知）';
}
function mountMood() {
  var head = document.querySelector('#page-chat .chat-head');
  if (!head) return;
  var name = $('chat-partner-name');
  if (!name) return;
  if (!name.parentNode.classList || !name.parentNode.classList.contains('ch-namebox')) {
    var box = document.createElement('div');
    box.className = 'ch-namebox';
    head.insertBefore(box, name);
    box.appendChild(name);
    var mood = document.createElement('div');
    mood.className = 'ch-mood';
    mood.id = 'chat-mood';
    box.appendChild(mood);
    mood.addEventListener('click', function (e) {
      e.stopPropagation();
      var pg = $('page-cjian');
      if (!pg) return;
      openPage(pg, 'page-chat');
      if (window.__yzCjOpen) window.__yzCjOpen('state', '');
    });
  }
  paintMood();
  if (!mountMood.__timer) mountMood.__timer = setInterval(paintMood, 15000);
}

/* ---------- 2. 心讯：TA 在想什么 ---------- */
var XN_TABS = [['want', '想收到'], ['guess', '以为你会说'], ['say', '想说'], ['out', '实际发出']];
var XN_HINTS = {
  want: 'TA 从你这儿想听到的 · 点一张推过去',
  guess: 'TA 猜你大概会这么说 · 点一张推过去',
  say: 'TA 没说出口的 · 点一张推过去',
  out: 'TA 最近真的说过的 · 点一张再说一遍'
};
var XN_DEF = {
  want: ['在我这里，你可以永远当你自己', '脑子里上演了好多和你有关的小故事', '你现在完全是我的，只准给我看', '今天也很想你，想得有点没道理', '不用说话也行，你在就好', '想被你抱一下，就一下'],
  guess: ['你大概会说「没事」', '你可能会先问我在不在', '你八成又要装作不在意', '你应该会说再等等', '你大概想听我说一句「我在」'],
  say: ['其实我有点怕你不回', '今天有点累，但见到你就好了', '我把想说的话删了三遍', '想问你一个问题，又咽回去了', '你要是现在在就好了']
};
var xnTab = 'want', xnAuto = false, xnFold = true, xnQ = '', xnTimer = null, xnBooted = false;

function xnLibCount() {
  var n = 0;
  try {
    ['own', 'public'].forEach(function (sc) {
      var g = window.getScopedGroups ? window.getScopedGroups('text', sc) : null;
      if (Array.isArray(g)) g.forEach(function (p) { n += (p[1] || []).length; });
    });
  } catch (e) {}
  if (!n) { try { if (window.__ccPickGroupCount) n += window.__ccPickGroupCount(); } catch (e2) {} }
  return n;
}
function xnCardPool() {
  var out = [];
  try {
    ['own', 'public'].forEach(function (sc) {
      var g = window.getScopedGroups ? window.getScopedGroups('text', sc) : null;
      if (Array.isArray(g)) g.forEach(function (p) {
        (p[1] || []).forEach(function (c) {
          if (typeof c === 'string' && c.length >= 2 && c.length <= 42 && c.indexOf('data:') !== 0 && c.indexOf('@@m:') !== 0) out.push(c);
        });
      });
    });
  } catch (e) {}
  return out;
}
function xnRecentIn(n) {
  var arr = [];
  try {
    var st = store();
    arr = JSON.parse((st && st.get && st.get('chat-msgs')) || '[]');
  } catch (e) { arr = []; }
  if (!Array.isArray(arr)) return [];
  return arr.filter(function (m) {
    return m && m.side === 'in' && m.text && String(m.text).length <= 46 && String(m.text).indexOf('data:') !== 0 && !m.special;
  }).slice(-n).map(function (m) { return String(m.text); }).reverse();
}
function xnShuffle(a) {
  var b = a.slice();
  for (var i = b.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = b[i]; b[i] = b[j]; b[j] = t; }
  return b;
}
function xnCardsFor(tab) {
  var src;
  if (tab === 'out') src = xnRecentIn(12);
  else if (tab === 'say') { var p = xnCardPool(); src = p.length ? xnShuffle(p) : XN_DEF.say.slice(); }
  else if (tab === 'guess') { var p2 = xnCardPool(); src = XN_DEF.guess.slice().concat(p2.length ? xnShuffle(p2).slice(0, 4) : []); }
  else { var p3 = xnCardPool(); src = XN_DEF.want.slice().concat(p3.length ? xnShuffle(p3).slice(0, 4) : []); }
  if (xnQ) src = src.filter(function (x) { return String(x).toLowerCase().indexOf(xnQ.toLowerCase()) >= 0; });
  return xnShuffle(src).slice(0, 5);
}
function xnPaint() {
  var box = $('xnCards');
  if (!box) return;
  var list = xnCardsFor(xnTab);
  if (!list.length) {
    box.innerHTML = '<div class="xn-cc empty">' + (xnQ ? '没有搜到相关的句子' : '这一栏还没有内容') + '</div>';
  } else {
    box.innerHTML = list.map(function (t) {
      return '<button class="xn-cc" data-xncard="' + esc(t) + '">' + esc(t) + '</button>';
    }).join('');
  }
  var hint = $('xnHint');
  if (hint) hint.textContent = XN_HINTS[xnTab] || '';
  Array.prototype.forEach.call(document.querySelectorAll('#xnTabs button'), function (b) {
    b.classList.toggle('on', b.getAttribute('data-xnt') === xnTab);
  });
  var ln = $('xnLibN');
  if (ln) ln.textContent = String(xnLibCount());
  var ttl = $('xnTitle');
  if (ttl) ttl.textContent = '心讯 · ' + partner();
  var fb = $('xnFold');
  if (fb) fb.textContent = xnFold ? '展开' : '折叠';
  var ab = $('xnAuto');
  if (ab) ab.classList.toggle('on', xnAuto);
  var card = document.querySelector('#page-xinxun .xn-card');
  if (card) {
    Array.prototype.forEach.call(card.querySelectorAll('.xn-tabs,.xn-hint,.xn-cards,.xn-foot'), function (el) {
      el.style.display = xnFold ? 'none' : '';
    });
  }
}
function xnPush(text) {
  try {
    if (typeof window.chatSendMsg === 'function') { window.chatSendMsg(text); toast('已推给 ' + partner()); }
    else toast('聊天还没准备好');
  } catch (e) { toast('发送失败'); }
}
function xnOpen() {
  var pg = $('page-xinxun');
  if (!pg) return;
  openPage(pg); // 返回时回到进来的那一页（从主页进就回主页，不再固定回聊天）
  xnPaint();
}
function xnBuildPage() {
  if ($('page-xinxun')) return;
  var host = (document.getElementById('page-cjian') || document.getElementById('page-phone'));
  host = host && host.parentNode;
  if (!host) return;
  var pg = document.createElement('div');
  pg.className = 'page';
  pg.id = 'page-xinxun';
  pg.hidden = true;
  pg.innerHTML = '' +
    '<div class="chat-head">' +
    '<span class="ch-back" id="xnBack"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span>' +
    '<span class="ch-name" id="xnTitle">心讯</span>' +
    '<span class="xn-tools">' +
    '<button id="xnAlbum" title="卡册"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4" width="17" height="16" rx="2.5"/><path d="M3.5 9h17M9 9v11"/></svg></button>' +
    '<button id="xnCardLib" title="字卡抽屉"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="13" height="18" rx="2"/><path d="M8 7h5M8 11h5M8 15h3"/></svg></button>' +
    '<button id="xnGear" title="心讯设置"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 3.4v2.2M12 18.4v2.2M4.9 7.6l1.9 1.1M17.2 15.3l1.9 1.1M4.9 16.4l1.9-1.1M17.2 8.7l1.9-1.1"/></svg></button>' +
    '<button id="xnMore" title="更多"><svg viewBox="0 0 24 24" style="fill:currentColor;stroke:none"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button>' +
    '</span></div>' +
    '<div class="xn-body">' +
    '<div class="xn-card">' +
    '<div class="xn-head"><b>TA 在想什么</b><div class="xn-hbtns">' +
    '<button id="xnFold">折叠</button><button id="xnAuto">自动换</button>' +
    '<button class="xn-round" id="xnRefresh" title="换一批">↻</button>' +
    '</div></div>' +
    '<div class="xn-tabs" id="xnTabs">' + XN_TABS.map(function (t) {
      return '<button data-xnt="' + t[0] + '"' + (t[0] === xnTab ? ' class="on"' : '') + '>' + t[1] + '</button>';
    }).join('') + '</div>' +
    '<div class="xn-hint" id="xnHint"></div>' +
    '<div class="xn-cards" id="xnCards"></div>' +
    '<div class="xn-foot"><span>字卡抽屉 <b id="xnLibN">0</b> 张</span>' +
    '<div class="xn-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>' +
    '<input id="xnSearch" data-ce-skip="1" placeholder="搜索字卡 / 牌名 / 情绪词"></div>' +
    '<button class="xn-drawer" id="xnDrawer">完整抽屉 ›</button></div>' +
    '</div></div>';
  host.appendChild(pg);

  $('xnBack').addEventListener('click', function () { closePage(pg); });
  $('xnRefresh').addEventListener('click', function () { xnPaint(); toast('换了一批'); });
  $('xnFold').addEventListener('click', function () { xnFold = !xnFold; xnPaint(); });
  $('xnAuto').addEventListener('click', function () {
    xnAuto = !xnAuto;
    if (xnAuto) {
      if (!xnTimer) xnTimer = setInterval(function () { if ($('page-xinxun') && !$('page-xinxun').hidden) xnPaint(); }, 6000);
      toast('自动换已开');
    } else { toast('自动换已关'); }
    xnPaint();
  });
  $('xnTabs').addEventListener('click', function (e) {
    var b = e.target.closest('[data-xnt]'); if (!b) return;
    xnTab = b.getAttribute('data-xnt'); xnQ = ''; var si = $('xnSearch'); if (si) si.value = '';
    xnPaint();
  });
  $('xnCards').addEventListener('click', function (e) {
    var b = e.target.closest('[data-xncard]'); if (!b) return;
    xnPush(b.getAttribute('data-xncard'));
  });
  $('xnSearch').addEventListener('input', function () { xnQ = String(this.value || '').trim(); xnPaint(); });
  $('xnCardLib').addEventListener('click', function () { openCardLib(); });
  $('xnDrawer').addEventListener('click', function () {
    /* v79：完整抽屉＝接专属字卡的全屏抽屉（搜索 / 分类 / 多选 / 推给 TA） */
    if (window.__xnDrawerOpen) { try { window.__xnDrawerOpen(); return; } catch (e) {} }
    openCardLib();
  });
  if ($('xnAlbum')) $('xnAlbum').addEventListener('click', function () {
    if (window.__xnAlbumOpen) window.__xnAlbumOpen(); else toast('卡册还没准备好');
  });
  if ($('xnGear')) $('xnGear').addEventListener('click', function () {
    if (window.__xnSetOpen) window.__xnSetOpen(); else toast('心讯设置还没准备好');
  });
  $('xnMore').addEventListener('click', function () {
    xnFold = !xnFold; xnPaint();
  });
  xnBooted = true;
}
function openCardLib() {
  var pg = $('page-chatcard');
  if (pg) { openPage(pg, 'page-xinxun'); return; }
  toast('字卡库还没准备好');
}
window.__xnOpen = function () { xnBuildPage(); xnOpen(); };

/* ---------- 3. 抽一张 ---------- */
var drMode = 'ta', drSub = 'auto', drSession = [], drOpen = [], drTarget = 0;
var DR_FALLBACK = ['最近看到我给你的暗号了吗', '我有点想你了，但不说', '今天想被你问一句「怎么了」', '你猜我现在在想什么', '要是你现在在旁边就好了', '我留了一句话在抽屉里'];
function drPool() {
  var p = xnCardPool();
  return p.length ? p : DR_FALLBACK.slice();
}
function drCardHtml(txt, x, y, rot, opened) {
  return '<div class="dr-pc' + (opened ? ' open' : '') + '" data-drc="' + esc(txt) + '" style="left:' + x + '%;top:' + y + '%;transform:translate(-50%,-50%) rotate(' + rot + 'deg)">' +
    (opened ? '<div class="dr-face">' + esc(txt) + '</div>' : '<div class="dr-back"></div>') + '</div>';
}
function drPaint() {
  var box = $('drTable');
  if (!box) return;
  if (!drOpen.length) {
    box.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#b5b5b5;font-size:11.5px;text-align:center;padding:0 30px;line-height:1.9">' +
      (drMode === 'ta' ? '牌桌清空了 · 点「再让 TA 抽」' : '点「我来抽」铺牌，再点牌翻面') + '</div>';
  } else {
    var n = drOpen.length;
    var pos = [[26, 30, -12], [50, 24, 4], [74, 32, 13], [38, 66, -6], [64, 68, 9]];
    box.innerHTML = drOpen.map(function (o, i) {
      var p = pos[i % pos.length];
      return drCardHtml(o.t, p[0], p[1], p[2], o.open);
    }).join('');
  }
  var list = $('drList');
  if (list) {
    if (!drSession.length) list.innerHTML = '这一场还没记下牌 · 抽完点「收进这一场」';
    else list.innerHTML = drSession.map(function (s, i) {
      return '<div class="dr-sitem"><i>' + (i + 1) + '</i><span>' + esc(s.text) + '</span></div>';
    }).join('');
  }
  var say = $('drSay');
  if (say) {
    say.textContent = drMode === 'ta'
      ? (drSub === 'auto' ? 'TA 打开就自己抽一轮 · 点「收进这一场」，结束才发出去' : 'TA 等你说一声才抽 · 抽完点「收进这一场」')
      : '你自己抽 · 左右翻牌，收进这一场，结束才发出去';
  }
  Array.prototype.forEach.call(document.querySelectorAll('#drModes button[data-drm]'), function (b) {
    b.classList.toggle('on', b.getAttribute('data-drm') === drMode);
  });
  Array.prototype.forEach.call(document.querySelectorAll('#drSub button'), function (b) {
    b.classList.toggle('on', b.getAttribute('data-drs') === drSub);
  });
  var again = $('drAgain');
  if (again) again.textContent = drMode === 'ta' ? '再让 TA 抽' : '再抽一轮';
  var take = $('drTake');
  if (take) take.textContent = drOpen.length ? '收进这一场' : '这一场（' + drSession.length + '）';
}
function drDealTa() {
  var pool = xnShuffle(drPool());
  var n = 1 + Math.floor(Math.random() * 3);
  drOpen = pool.slice(0, n).map(function (t) { return { t: t, open: true, by: 'ta' }; });
  drPaint();
}
function drDealMe() {
  var pool = xnShuffle(drPool()).slice(0, 5);
  drOpen = pool.map(function (t) { return { t: t, open: false, by: 'me' }; });
  drTarget = 3;
  drPaint();
}
function drTakeSession() {
  if (!drOpen.length) { toast('牌桌是空的'); return; }
  var openedAlready = drOpen.some(function (o) { return o.open; });
  if (!openedAlready) { toast('先翻一张牌'); return; }
  drOpen.forEach(function (o) {
    if (!o.open && drMode === 'me') return;
    drSession.push({ text: o.t, by: o.by });
  });
  drOpen = [];
  drPaint();
  toast('已收进这一场：' + drSession.length + ' 张');
}
function drEndSend() {
  if (!drSession.length) { toast('这一场还是空的'); return; }
  var arr = drSession.slice();
  var taCount = 0, meCount = 0;
  arr.forEach(function (s) {
    var txt = s.text;
    var sent = false;
    try {
      if (s.by === 'ta' && window.chatAddIn) { window.chatAddIn(txt, { nightAllow: true, rateAllow: true, silent: true }); sent = true; taCount++; }
      else if (window.chatSendMsg) { window.chatSendMsg(txt); sent = true; meCount++; }
    } catch (e) {}
  });
  drSession = [];
  drPaint();
  toast('已发进聊天：' + (taCount ? partner() + ' ' + taCount + ' 张' : '') + (meCount ? ' 你 ' + meCount + ' 张' : ''));
}
function drOpenPage() {
  var pg = $('page-draw');
  if (!pg) return;
  openPage(pg, 'page-chat');
  if (!drOpen.length && drMode === 'ta' && drSub === 'auto') drDealTa();
  else drPaint();
}
function drBuildPage() {
  if ($('page-draw')) return;
  var host = (document.getElementById('page-cjian') || document.getElementById('page-phone'));
  host = host && host.parentNode;
  if (!host) return;
  var pg = document.createElement('div');
  pg.className = 'page';
  pg.id = 'page-draw';
  pg.hidden = true;
  pg.innerHTML = '' +
    '<div class="chat-head"><span class="ch-back" id="drBack"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span>' +
    '<span class="ch-name">抽一张</span></div>' +
    '<div class="dr-body">' +
    '<div class="dr-modes" id="drModes">' +
    '<button data-drm="me">我来抽</button><button data-drm="ta" class="on">让 TA 抽</button>' +
    '<button class="dr-shuffle" id="drShuffle">' +
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px"><path d="M16 3h5v5"/><path d="M4 20L21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/></svg>洗牌</button>' +
    '</div>' +
    '<div class="dr-sub" id="drSub"><button data-drs="auto" class="on">TA 直接抽</button><button data-drs="call">等我叫</button></div>' +
    '<div class="dr-say" id="drSay"></div>' +
    '<div class="dr-table" id="drTable"></div>' +
    '<div class="dr-session"><b>这一场</b><div id="drList"></div></div>' +
    '<div class="dr-inputrow"><input id="drMsg" placeholder="在场里说一句？（结束才发出去）"><button id="drNote">记下</button></div>' +
    '<div class="dr-acts"><button id="drAgain">再让 TA 抽</button><button class="pri" id="drTake">收进这一场</button><button id="drEnd">结束并发送</button></div>' +
    '</div>';
  host.appendChild(pg);

  $('drBack').addEventListener('click', function () { closePage(pg); });
  $('drModes').addEventListener('click', function (e) {
    var b = e.target.closest('[data-drm]'); if (!b) return;
    drMode = b.getAttribute('data-drm');
    drOpen = []; drPaint();
    if (drMode === 'ta') drDealTa();
  });
  $('drSub').addEventListener('click', function (e) {
    var b = e.target.closest('[data-drs]'); if (!b) return;
    drSub = b.getAttribute('data-drs'); drPaint();
  });
  $('drShuffle').addEventListener('click', function () {
    drOpen = xnShuffle(drPool()).slice(0, 5).map(function (t) { return { t: t, open: false, by: drMode }; });
    drPaint(); toast('洗好了');
  });
  $('drTable').addEventListener('click', function (e) {
    var c = e.target.closest('[data-drc]'); if (!c) return;
    var txt = c.getAttribute('data-drc');
    for (var i = 0; i < drOpen.length; i++) {
      if (drOpen[i].t === txt && !drOpen[i].open) { drOpen[i].open = true; break; }
    }
    drPaint();
  });
  $('drAgain').addEventListener('click', function () {
    if (drMode === 'ta') drDealTa(); else drDealMe();
  });
  $('drTake').addEventListener('click', drTakeSession);
  $('drEnd').addEventListener('click', drEndSend);
  $('drNote').addEventListener('click', function () {
    var i = $('drMsg'); var v = String((i && i.value) || '').trim();
    if (!v) { toast('先写一句'); return; }
    drSession.push({ text: v, by: 'me' });
    if (i) i.value = '';
    drPaint(); toast('记下了');
  });
}
window.__drOpen = function () { drBuildPage(); drOpenPage(); };

/* 抽一张：v18 起从聊天输入栏移入「更多功能」工具栏（互动类，#more-draw） */
function mountDrawBtn() {
  var old = $('chat-draw-btn');
  if (old && old.parentNode) old.parentNode.removeChild(old); // 清掉旧版输入栏图标
  var b = $('more-draw');
  if (!b || b.__yzDrawBound) return;
  b.__yzDrawBound = 1;
  b.addEventListener('click', function (e) {
    e.preventDefault(); e.stopPropagation();
    var mp = $('chat-more-panel'); if (mp) mp.hidden = true;
    if (window.__drOpen) window.__drOpen();
  });
}

/* 语音：v18 起从输入栏移入「更多功能 → 互动」 */
function mountMicBtn() {
  var b = $('more-mic');
  if (!b || b.__yzMicBound) return;
  b.__yzMicBound = 1;
  b.addEventListener('click', function (e) {
    e.preventDefault(); e.stopPropagation();
    var on = false;
    try { on = !!(window.__chatVoiceEnabled && window.__chatVoiceEnabled()); } catch (x) {}
    if (!on) { toast('先在 聊天设置 → 聊天 打开「我可发送语音」'); return; }
    var mp = $('chat-more-panel'); if (mp) mp.hidden = true;
    if (window.__openVoicePanel) window.__openVoicePanel();
  });
}

/* ---------- 4. 灵感拾取：TA 从日常文字里拾句子 ---------- */
/* v41：概率可调可调试 —— yz-pick 存 {on,p}，yz-pick-log 记最近 40 次掷骰 */
function pickCfg() {
  try {
    var st = store();
    var o = JSON.parse((st && st.get && st.get('yz-pick')) || 'null');
    var p = (o && typeof o.p === 'number') ? o.p : 35;
    return { on: o ? !!o.on : true, p: Math.max(0, Math.min(100, p)) };
  } catch (e) { return { on: true, p: 35 }; }
}
function pickSaveCfg(cfg) {
  try {
    var st = store();
    if (st && st.set) st.set('yz-pick', JSON.stringify({ on: !!cfg.on, p: Math.max(0, Math.min(100, Number(cfg.p) || 0)) }));
    return true;
  } catch (e) { return false; }
}
function pickLogList() {
  try {
    var st = store();
    var v = JSON.parse((st && st.get && st.get('yz-pick-log')) || '[]');
    return Array.isArray(v) ? v : [];
  } catch (e) { return []; }
}
function pickLogPush(rec) {
  try {
    var st = store();
    if (!st || !st.set) return;
    var arr = pickLogList();
    arr.push(rec);
    while (arr.length > 40) arr.shift();
    st.set('yz-pick-log', JSON.stringify(arr));
    if (window.__ccPickBarRefresh) { try { window.__ccPickBarRefresh(); } catch (e) {} }
  } catch (e) {}
}
window.__yzPickCfg = pickCfg;
window.__yzPickSaveCfg = pickSaveCfg;
window.__yzPickLog = pickLogList;
window.__yzPickStat = function () {
  var arr = pickLogList();
  var rolled = 0, hits = 0;
  arr.forEach(function (r) { if (r && r.force) return; rolled++; if (r && r.hit) hits++; });
  var last = arr.length ? arr[arr.length - 1] : null;
  return { n: arr.length, rolled: rolled, hits: hits, last: last };
};
function phraseOf(text) {
  var t = String(text || '')
    .replace(/\[[^\]]{0,20}\]/g, ' ')
    .replace(/[\u200b-\u200f]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (!t) return '';
  var segs = t.split(/[，。！？、；：,.!?;:~…\n]+/).map(function (x) { return x.trim(); }).filter(Boolean);
  var cands = segs.filter(function (x) { return x.length >= 3 && x.length <= 16; });
  if (!cands.length) {
    if (t.length >= 3 && t.length <= 16) cands = [t];
    else if (t.length > 16) cands = [t.slice(0, 16)];
  }
  if (!cands.length) return '';
  return cands[Math.floor(Math.random() * cands.length)];
}
function pickOnSend(text) {
  try {
    var cfg = pickCfg();
    if (!cfg.on) return;
    var roll = Math.random() * 100;
    var hit = roll < cfg.p;
    var w = '';
    if (hit) {
      w = phraseOf(text);
      if (!w) hit = false;
    }
    pickLogPush({ at: Date.now(), p: cfg.p, roll: Math.round(roll * 10) / 10, hit: hit, w: w });
    if (!hit) return;
    if (typeof window.__ccPickWord === 'function') window.__ccPickWord(w);
    setTimeout(function () { try { if (window.__ccPickBarRefresh) window.__ccPickBarRefresh(); } catch (e) {} }, 60);
  } catch (e) {}
}
if (!window.__yzPickOnSend) window.__yzPickOnSend = pickOnSend;

/* 手动掷一次：不掷概率，直接从你最近说过的一句里拾（给调试用） */
window.__yzPickForce = function (text) {
  try {
    var w = '';
    if (text) w = phraseOf(text);
    if (!w) {
      var msgs = (window.getChatMsgs ? window.getChatMsgs() : null) || [];
      for (var i = msgs.length - 1, n = 0; i >= 0 && n < 40; i--, n++) {
        var m = msgs[i];
        if (!m || m.side !== 'out') continue;
        if (m.type === 'image' || m.type === 'sticker' || m.type === 'voice') continue;
        var t = String(m.text || '');
        if (!t || t.indexOf('@@m:') === 0) continue;
        w = phraseOf(t);
        if (w) break;
      }
    }
    if (!w) { toast('还没找到能拾的句子：先发一条 3~16 个字的文字'); return ''; }
    var ok = (typeof window.__ccPickWord === 'function') ? window.__ccPickWord(w) : false;
    pickLogPush({ at: Date.now(), p: 100, roll: 0, hit: true, w: w, force: true });
    toast(ok ? ('拾到：「' + w + '」') : '这句已经在「灵感拾取」里了');
    return w;
  } catch (e) { return ''; }
};

