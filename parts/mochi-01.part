{ id: 'low1', label: '稍安静', probMul: 0.6, coolMul: 1.5, gateMul: 1.5 },
{ id: 'low2', label: '安静',   probMul: 0.4, coolMul: 2,   gateMul: 2   },
{ id: 'low3', label: '很安静', probMul: 0.2, coolMul: 3,   gateMul: 3   }
