    'background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 12px 30px rgba(0,0,0,.35)}',
    '.stk-drag-ghost img{max-width:100%;max-height:100%}',
    '.emoji-item.stk-dragging{opacity:.3}',
