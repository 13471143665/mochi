if (Math.random() * 100 < ccfg.likeProb) {
setTimeout(() => {
const list2 = load();
const p2 = list2.find(x => x.id === id);
if (!p2) return;
p2.likes = p2.likes || [];
const nm = taFeedNameFor(cid);
if (p2.likes.indexOf(nm) < 0) p2.likes.push(nm);
save(list2);
refreshPostCard(id);
addNotice('like', p2.id, nm + ' 赞了你的动态', cid);
