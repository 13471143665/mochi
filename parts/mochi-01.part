h += '<div class="pmp-c-row' + (a[i].w === 'me' ? ' me' : '') + '"><div class="pmp-c-bub">' + pmpEsc(t) + '</div></div>';
}
box.innerHTML = h;
box.scrollTop = box.scrollHeight;
}
