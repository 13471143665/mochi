});
let gcMaClickGuard = 0;
function gcRunAction(btn) {
const act = btn.dataset.act;
if (act === 'quote' && gcActiveMsgEl) {
const _ra = gcResolveActiveMsg();
const idx = _ra.idx;
const rec = _ra.rec;
if (rec) {
gcLastQuote = gcQuoteSnapOf(rec);
