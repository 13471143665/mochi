try { if (window.requestIdleCallback) window.requestIdleCallback(run, { timeout: 4000 }); else setTimeout(run, 800); } catch (e) { setTimeout(run, 800); }
}, delay || 4000);
}
window.addEventListener('load', function () { schedulePanelPrewarm(4000); });
