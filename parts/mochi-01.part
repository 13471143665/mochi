function emojiMvApply(kind, target) {
var grps = emojiMvList();
var picked = [];
emojiMv.sel.forEach(function (k) {
var p = String(k).split('\u0001');
var g = grps.find(function (x) { return x[0] === p[0]; });
if (!g || !Array.isArray(g[1])) return;
var i = Number(p[1]);
if (g[1][i] === undefined) return;
picked.push({ name: p[0], i: i, v: g[1][i] });
});
if (!picked.length) { emojiMvEnd(); return; }
if (kind === 'group') {
var tg = grps.find(function (x) { return x[0] === target; });
if (!tg) { toast('这个分组不在了'); return; }
picked.slice().sort(function (a, b) { return b.i - a.i; }).forEach(function (x) {
var g = grps.find(function (y) { return y[0] === x.name; });
if (g) g[1].splice(x.i, 1);
});
picked.sort(function (a, b) { return a.i - b.i; }).forEach(function (x) { tg[1].push(x.v); });
} else {
var byG = {};
picked.forEach(function (x) { (byG[x.name] = byG[x.name] || []).push(x); });
Object.keys(byG).forEach(function (nm) {
var g = grps.find(function (y) { return y[0] === nm; });
if (!g || !Array.isArray(g[1])) return;
var arr2 = byG[nm].slice().sort(function (a, b) { return a.i - b.i; });
var vals = arr2.map(function (x) { return x.v; });
for (var t = arr2.length - 1; t >= 0; t--) g[1].splice(arr2[t].i, 1);
g[1] = (kind === 'top') ? vals.concat(g[1]) : g[1].concat(vals);
});
}
var n = picked.length;
emojiMvEnd();
try { if (emojiMv.isSticker) myEmojiSave(); else myTextSave(); } catch (eS) {}
try { renderEmojiPanel(); } catch (eR) {}
toast(kind === 'group' ? ('已移动 ' + n + ' 个到「' + target + '」')
: ('已把 ' + n + ' 个移到最' + (kind === 'top' ? '上' : '下') + '面'));
}
/* 移动态下拦掉单击（否则一点就把表情发出去了） */
