let changed = false;
DEFAULT_QUESTIONS.forEach(q => {
if (!mergedSet[q.id] && !ids[q.id]) {
const nq = Object.assign({}, q);
nq.isPreset = true; // v3.6.x：系统预设标记——预设只可启停、不可删除
d.questions.push(nq);
changed = true;
}
});
DEFAULT_QUESTIONS.forEach(q => {
if (!mergedSet[q.id]) { merged.push(q.id); mergedSet[q.id] = true; changed = true; }
