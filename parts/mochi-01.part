const INTERACT_GATE_KEY = 'interact-card-last';
const INTERACT_GATE_MS = 60 * 60000; // 基准值（原频率档）；实际闸门 = 基准 × 频率档 gateMul
const IC_FREQ_KEY = 'reply-ic-freq';
const IC_MODES = [
