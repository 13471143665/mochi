toast(sfGc.checked ? '群聊已开启：桌面新增群聊按钮，占卜按钮已隐藏（可在美化装修模式添加到其他页面）' : '群聊已关闭，占卜按钮已恢复');
});
csAddSync(syncGc);
document.addEventListener('contact-switched', syncGc);
}
const csDtm = document.getElementById('cs-del-ta-msg');
