mapped = _mapBc(mapped, ['mb.other'], IN_B);
mapped = _mapBc(mapped, OUT_NAMES, OUT_B);
mapped = _mapBc(mapped, IN_NAMES, IN_B);
mapped = _mapBc(mapped, SH_NAMES, scope + '.msg-bubble.msg-bubble');
