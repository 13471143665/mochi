const txt = c.split('|||')[0] || c;
if (txt && txt.toLowerCase().indexOf(kw) >= 0) out.push({ t: txt, cat: gname });
});
});
});
} catch (e) {}
return out;
} });
window.__cardSearchFns.push({ name: '默认聊天字卡', fn: function (kw) {
const out = [];
