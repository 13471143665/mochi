  ].join('\n');
  document.head.appendChild(st);
}

/* ---------- 聊天消息：连接状态 ---------- */
function cxsHash(str) {
  var h = 2166136261;
  var t = String(str || '');
  for (var i = 0; i < t.length; i++) { h ^= t.charCodeAt(i); h = (h * 16777619) >>> 0; }
  return h >>> 0;
}
function cxsMoodPenalty() {
  try {
    var m = window.__yzMoodState && window.__yzMoodState();
    if (!m) return 0;
    var v = String(m.key || m.mood || '');
    if (/down|sad|low|难过|低落|累/.test(v)) return 2;
    if (/angry|生气|烦/.test(v)) return 1;
  } catch (e) {}
  return 0;
}
function cxsStyle() {
  if ($('cxs-style')) return;
  var st = document.createElement('style');
  st.id = 'cxs-style';
  st.textContent = [
    '.cxs-mask{position:fixed;inset:0;z-index:9998;display:flex;align-items:center;justify-content:center;padding:22px;background:rgba(26,22,22,.24);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}',
    '.cxs-mask[hidden]{display:none}',
    '.cxs-card{width:100%;max-width:340px;border-radius:26px;padding:20px 20px 10px;background:rgba(255,255,255,.80);-webkit-backdrop-filter:blur(22px) saturate(1.2);backdrop-filter:blur(22px) saturate(1.2);box-shadow:0 26px 70px rgba(60,50,50,.20),inset 0 1px 0 rgba(255,255,255,.7);color:#2b2b2b;font-size:13px;border:1px solid rgba(255,255,255,.55)}',
    '.cxs-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:16px}',
    '.cxs-head b{font-size:14px;font-weight:600;letter-spacing:.6px}',
    '.cxs-badge{font-size:10.5px;color:#8d8d8d;background:rgba(0,0,0,.045);border:1px solid rgba(0,0,0,.07);border-radius:999px;padding:4px 11px;transition:all .3s}',
    '.cxs-badge.ok{color:#5b5b5b;border-color:rgba(0,0,0,.12);background:rgba(255,255,255,.7)}',
    '.cxs-sec{padding:13px 0 14px;border-top:1px solid rgba(0,0,0,.075)}',
    '.cxs-line{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px;color:#3a3a3a;letter-spacing:.3px}',
    '.cxs-line em{font-style:normal;color:#262626;font-weight:500}',
    '.cxs-bars{display:flex;gap:7px;margin-top:11px}',
    '.cxs-bars i{flex:1;height:6px;border-radius:99px;background:rgba(0,0,0,.10);transition:background .4s}',
    '.cxs-bars i.on{background:#3b3b3b}',
    '.cxs-note{margin-top:9px;font-size:11.5px;line-height:1.7;color:#909090;letter-spacing:.2px}',
    '.cxs-metrics{padding-top:4px;border-top:1px solid rgba(0,0,0,.075)}',
    '.cxs-metric{padding:11px 0 10px}',
    '.cxs-metric .cxs-line{font-size:12.5px;color:#454545}',
    '.cxs-metric .cxs-line em{font-size:12px;color:#9a9a9a;font-weight:400}',
    '.cxs-track{height:4px;border-radius:99px;background:rgba(0,0,0,.07);margin-top:9px;overflow:hidden}',
    '.cxs-track i{display:block;height:100%;width:0;border-radius:99px;background:#3b3b3b;transition:width .6s cubic-bezier(.2,.7,.2,1)}',
    '.cxs-foot{display:flex;align-items:center;gap:9px;padding:14px 0 4px;border-top:1px solid rgba(0,0,0,.075);font-size:11px;color:#a0a0a0}',
    '.cxs-dots{letter-spacing:2px;color:#b5b5b5}',
    '.cxs-foot button{margin-left:auto;border:0;background:transparent;font-family:inherit;font-size:12px;color:#4a4a4a;cursor:pointer;padding:6px 2px}',
    /* v61：连接状态卡做黑 / 白两张，由浅色 / 深色模式控制，两套配色所有内容都清晰 */
    '.cxs-card{background:#ffffff;color:#2b2b2b;border-color:rgba(0,0,0,.08)}',
    '.cxs-head b{color:#1f1f1f}',
    '.cxs-line,.cxs-metric .cxs-line{color:#3a3a3a}',
    '.cxs-line em{color:#1a1a1a}',
    '.cxs-metric .cxs-line em{color:#6f6f6f}',
    '.cxs-note{color:#6e6e6e}',
    '.cxs-badge{color:#606060;background:rgba(0,0,0,.045);border-color:rgba(0,0,0,.09)}',
    '.cxs-badge.ok{color:#3a3a3a;background:rgba(0,0,0,.06)}',
    '.cxs-foot{color:#7a7a7a}',
    '.cxs-dots{color:#9a9a9a}',
    '.cxs-foot button{color:#3a3a3a}',
    '[data-theme="dark"] .cxs-card{background:#171719;color:#f2f2f2;border-color:rgba(255,255,255,.13);box-shadow:0 26px 70px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.07)}',
    '[data-theme="dark"] .cxs-head b{color:#f7f7f7}',
    '[data-theme="dark"] .cxs-sec,[data-theme="dark"] .cxs-metrics,[data-theme="dark"] .cxs-foot{border-top-color:rgba(255,255,255,.11)}',
    '[data-theme="dark"] .cxs-line,[data-theme="dark"] .cxs-metric .cxs-line{color:#e9e9e9}',
    '[data-theme="dark"] .cxs-line em{color:#ffffff}',
    '[data-theme="dark"] .cxs-metric .cxs-line em{color:#c8c8c8}',
    '[data-theme="dark"] .cxs-note{color:#bcbcbc}',
    '[data-theme="dark"] .cxs-badge{color:#d8d8d8;background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.15)}',
    '[data-theme="dark"] .cxs-badge.ok{color:#f4f4f4;background:rgba(255,255,255,.14)}',
    '[data-theme="dark"] .cxs-bars i{background:rgba(255,255,255,.16)}',
    '[data-theme="dark"] .cxs-bars i.on{background:#f2f2f2}',
    '[data-theme="dark"] .cxs-track{background:rgba(255,255,255,.14)}',
    '[data-theme="dark"] .cxs-track i{background:#f2f2f2}',
    '[data-theme="dark"] .cxs-foot{color:#bcbcbc}',
    '[data-theme="dark"] .cxs-dots{color:#a8a8a8}',
    '[data-theme="dark"] .cxs-foot button{color:#eeeeee}'
  ].join('\n');
  document.head.appendChild(st);
}
function cxsBuild() {
  cxsStyle();
  if ($('cxsMask')) return;
  var el = document.createElement('div');
  el.className = 'cxs-mask';
  el.id = 'cxsMask';
  el.hidden = true;
  el.innerHTML = '' +
    '<div class="cxs-card" id="cxsCard">' +
    '<div class="cxs-head"><b>连接状态</b><span class="cxs-badge" id="cxsBadge">正在测试</span></div>' +
    '<div class="cxs-sec"><div class="cxs-line"><span>连接清晰度</span><em id="cxsClearTxt">—</em></div>' +
    '<div class="cxs-bars" id="cxsBars"><i></i><i></i><i></i><i></i></div></div>' +
    '<div class="cxs-sec"><div class="cxs-line"><span>来源一致性</span><em id="cxsConsist">—</em></div>' +
    '<div class="cxs-note" id="cxsConsistDesc">正在比对 TA 平时的说法…</div></div>' +
    '<div class="cxs-metrics" id="cxsMetrics">' +
    ['他的主动表达', '双方联想', '随机噪音', '受情绪干扰'].map(function (t, i) {
      return '<div class="cxs-metric"><div class="cxs-line"><span>' + t + '</span><em id="cxsV' + i + '">—</em></div>' +
        '<div class="cxs-track"><i id="cxsB' + i + '"></i></div></div>';
    }).join('') +
    '</div>' +
    '<div class="cxs-foot"><span id="cxsTime">--:--</span><span class="cxs-dots">···</span><span class="cxs-dia">◇</span><button type="button" id="cxsClose">收起</button></div>' +
    '</div>';
  document.body.appendChild(el);
  el.addEventListener('click', function (e) {
    if (e.target === el || (e.target.closest && e.target.closest('#cxsClose'))) closeCxs();
  });
}
function closeCxs() { var el = $('cxsMask'); if (el) el.hidden = true; }
function openCxs(bubble) {
  cxsBuild();
  var el = $('cxsMask'); if (!el) return;
  var txt = '';
  try { txt = String((bubble && bubble.innerText) || '').trim(); } catch (e) {}
  // 进度全随机（用户要求：不用调，每次点开都重新测一遍）
  var bars = 2 + Math.floor(Math.random() * 3);          // 2~4 段
  var clarity = bars >= 4 ? '清晰传达' : bars === 3 ? '大致清楚' : '有点杂音';
  var consistN = 55 + Math.floor(Math.random() * 45);    // 55~99
  var consist = consistN >= 85 ? '高' : consistN >= 70 ? '中' : '偏低';
  var v = [
    3 + Math.floor(Math.random() * 5),   // 他的主动表达 3~7
    3 + Math.floor(Math.random() * 5),   // 双方联想
    2 + Math.floor(Math.random() * 5),   // 随机噪音
    2 + Math.floor(Math.random() * 5) + cxsMoodPenalty()
  ].map(function (n) { return Math.max(0, Math.min(10, n)); });
  var timeEl = $('cxsTime');
  if (timeEl) { try { timeEl.textContent = new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' }); } catch (e) { timeEl.textContent = '--:--'; } }
  var badge = $('cxsBadge'); if (badge) { badge.textContent = '正在测试'; badge.classList.remove('ok'); }
  var clearTxt = $('cxsClearTxt'); if (clearTxt) clearTxt.textContent = '—';
  var cons = $('cxsConsist'); if (cons) cons.textContent = '—';
  var consDesc = $('cxsConsistDesc'); if (consDesc) consDesc.textContent = '正在比对 TA 平时的说法…';
  var barBox = $('cxsBars');
  if (barBox) Array.prototype.forEach.call(barBox.children, function (n, i) { n.className = ''; });
  ['cxsV0', 'cxsV1', 'cxsV2', 'cxsV3'].forEach(function (id) { var e = $(id); if (e) e.textContent = '—'; });
  ['cxsB0', 'cxsB1', 'cxsB2', 'cxsB3'].forEach(function (id) { var e = $(id); if (e) e.style.width = '0%'; });
  el.hidden = false;
  setTimeout(function () {
    if (el.hidden) return;
    if (badge) { badge.textContent = '已同步'; badge.classList.add('ok'); }
    if (clearTxt) clearTxt.textContent = clarity;
    if (barBox) Array.prototype.forEach.call(barBox.children, function (n, i) { n.className = i < bars ? 'on' : ''; });
    if (cons) cons.textContent = consist;
    if (consDesc) consDesc.textContent = consist === '高' ? '高度符合其稳定表达习惯与当前语境'
      : consist === '中' ? '大体符合平时的说法，个别用词有点跳'
      : '和 TA 平时说话的习惯有些出入，可能受上下文影响';
    v.forEach(function (n, i) {
      var ve = $('cxsV' + i); if (ve) ve.textContent = n + ' / 10';
      var be = $('cxsB' + i); if (be) be.style.width = (n * 10) + '%';
    });
  }, 1100);
}
function mountCxsEntry() {
  /* 已按需求移除「链接状态」入口：不再向长按菜单挂载 status 按钮 */
  return;
}
document.addEventListener('touchstart', function (e) {
  var b = e.target.closest && e.target.closest('.msg-bubble');
  if (b) window.__yzMsgRef = b;
}, true);
document.addEventListener('click', function (e) {
  var b = e.target.closest && e.target.closest('.msg-bubble');
  if (b) window.__yzMsgRef = b;
}, true);
document.addEventListener('contextmenu', function (e) {
  var b = e.target.closest && e.target.closest('.msg-bubble');
  if (b) window.__yzMsgRef = b;
}, true);

function boot() {
  injectStyle();
  mountMood();
  try { xnBuildPage(); } catch (e) {}
  mountDrawBtn();
  mountMicBtn();
}
/* 桌面「心讯」图标 */
document.addEventListener('click', function (e) {
  var a = e.target.closest && e.target.closest('.app[data-app]');
  if (!a) return;
  if (a.getAttribute('data-app') !== 'xinxun') return;
  /* v82（用户直派「整理模式中心讯点击直接进界面」）：装修/整理模式交给图标设置 */
  var _phD = document.getElementById('page-phone');
  if (_phD && _phD.classList.contains('decor-on')) return;
  var _gD = a.closest('.app-grid');
  if (_gD && _gD.classList.contains('editing')) return;
  e.preventDefault(); e.stopPropagation();
  try { window.__xnOpen(); } catch (err) {}
}, true);

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();
setTimeout(boot, 1200);
setTimeout(boot, 3000);
setTimeout(mountDrawBtn, 1500);
setTimeout(mountDrawBtn, 4000);
setTimeout(mountMicBtn, 1500);
setTimeout(mountMicBtn, 4000);

window.__yzxOpenPage = openPage;
window.__yzxClosePage = closePage;
window.__yzxPaintMood = paintMood;
} catch (e) { try { console.error('[extras-yz]', e && e.message); } catch (x) {} }
})();

</script>
<script>/* inline: reading-yz.js */
/* 阅读室：书架 / 一起读书 / TA 同步标注与 emoji（参考 Cafe 喫茶字卡的阅读室） */
if (window.__mochiLoaded) window.__mochiLoaded.push("reading-yz.js");
(function () {
try {
var PAGE_ID = 'page-read';
var KEY = 'yz-books';
var TODAY = 'yz-read-today';
var OPEN = 'yz-read-open';
var SYNC = 'yz-read-sync';
var TA_RATE = 0.55;

function $(id) { return document.getElementById(id); }
function store() { try { return window.activeStore ? window.activeStore() : null; } catch (e) { return null; } }
function partner() { try { var s = store(); var n = s && s.get && s.get('lbl-partner'); if (n) return n; } catch (e) {} return 'TA'; }
function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
function pad(n) { return n < 10 ? '0' + n : '' + n; }
function todayKey() { var d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
function readJSON(k, fb) { try { var s = store(); var v = s && s.get(k); return v ? JSON.parse(v) : fb; } catch (e) { return fb; } }
function writeJSON(k, v) { try { var s = store(); if (s) s.set(k, JSON.stringify(v)); } catch (e) {} }
function readStr(k, fb) { try { var s = store(); var v = s && s.get(k); return v == null ? fb : v; } catch (e) { return fb; } }
function writeStr(k, v) { try { var s = store(); if (s) s.set(k, v); } catch (e) {} }

/* ---------- 预置书（没有书时也有东西可读） ---------- */
var SEED = [
  '把一盏灯留在书页里',
  '傍晚的时候，屋子里先暗下来的总是书架那一角。\n' +
  '她把台灯往左边挪了一点，光就顺着书脊滑过去，像有人悄悄地摸了一遍那些名字。\n' +
  '桌上有一只旧茶杯，杯口有一道很细的裂。她没有换掉它，因为那道裂正好卡在嘴唇碰不到的地方。\n' +
  '“今天也读一点吧。”她对自己说。\n\n' +
  '书是从中间翻开的。上一次读到哪里，她已经记不清了，只记得那一页有一句话被折了角：\n' +
  '「灯不必很亮，够照见下一页就好。」\n' +
  '她把这句话又读了一遍，觉得像是有人在很远的地方，替她把今天按住了。\n\n' +
  '窗外的声音一阵一阵地进来。楼下有人在收摊，铁架碰在一起，叮的一声。\n' +
  '她抬头，看见玻璃上映着自己的影子，还有身后那盏没有开的灯。\n' +
  '有时候她喜欢这样：只开一盏灯，让屋子剩下的部分留在暗处，像还没读到的章节。\n\n' +
  '读到第三页，她停下来，在页边写了一行小字：\n' +
  '“如果有一天你也读到这一页，就把灯留给我。”\n' +
  '写完又觉得太郑重，想擦掉，笔尖悬了一会儿，最后还是留着了。\n\n' +
  '书页很薄，翻过去的时候会有一点点风。\n' +
  '她把手指压在下一段开头，慢慢往下看。故事里的人正在等一封信，等得很安静，不催，也不走。\n' +
  '她忽然想，等人的时候大概就该这样：手上有一本书，灯是暖的，时间慢一点也没关系。\n\n' +
  '夜深了一点。她合上书，把折角抚平，又故意重新折回去。\n' +
  '明天还要从这里开始。\n' +
  '灯没有关。她只是把它调暗了一格，像给还没读完的部分留一口气。'
].join('\n');

function seedBook() {
  var text = SEED;
  var title = '把一盏灯留在书页里';
  var pages = splitPages(text);
  return {
    id: 'seed-lamp', title: title, text: text, page: 0, pages: pages, addedAt: Date.now(), lastAt: 0,
    minutes: 0, finished: false, notes: [], reactions: []
  };
}
function splitPages(text) {
  var raw = String(text || '').replace(/\r\n/g, '\n').trim();
  if (!raw) return [''];
  var paras = raw.split(/\n{2,}/).map(function (p) { return p.trim(); }).filter(Boolean);
  var pages = [], cur = '', limit = 430;
  paras.forEach(function (p) {
    if (cur && (cur.length + p.length + 2) > limit) { pages.push(cur); cur = p; }
    else cur = cur ? (cur + '\n\n' + p) : p;
  });
  if (cur) pages.push(cur);
  if (!pages.length) pages = [raw.slice(0, limit)];
  return pages;
}
function loadBooks() {
  var arr = readJSON(KEY, null);
  if (!Array.isArray(arr) || !arr.length) {
    arr = [seedBook()];
    writeJSON(KEY, arr);
  }
  return arr;
}
function saveBooks(arr) { writeJSON(KEY, arr); }
function curBook() { var arr = loadBooks(); var id = readStr(OPEN, ''); for (var i = 0; i < arr.length; i++) if (arr[i].id === id) return arr[i]; return arr[0] || null; }
function bookById(id) { var arr = loadBooks(); for (var i = 0; i < arr.length; i++) if (arr[i].id === id) return arr[i]; return null; }
function putBook(b) { var arr = loadBooks(); for (var i = 0; i < arr.length; i++) if (arr[i].id === b.id) { arr[i] = b; saveBooks(arr); return; } arr.push(b); saveBooks(arr); }
function progressOf(b) { if (!b || !b.pages || !b.pages.length) return 0; return Math.min(100, Math.round(((b.page + 1) / b.pages.length) * 100)); }
function minutesToday() {
  var o = readJSON(TODAY, null);
  if (!o || o.d !== todayKey()) return 0;
  return Number(o.m) || 0;
}
function addMinute() {
  var o = readJSON(TODAY, null);
  if (!o || o.d !== todayKey()) o = { d: todayKey(), m: 0 };
  o.m = (Number(o.m) || 0) + 1;
  writeJSON(TODAY, o);
}
function totalMinutes() { var t = 0; loadBooks().forEach(function (b) { t += Number(b.minutes) || 0; }); return t + minutesToday(); }
function finishedCount() { return loadBooks().filter(function (b) { return b.finished; }).length; }
function dateLabel() {
  var d = new Date();
  var w = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][d.getDay()];
  return d.getFullYear() + '年' + (d.getMonth() + 1) + '月' + d.getDate() + '日 ' + w;
}

/* ---------- 样式 ---------- */
function css() {
  if ($('rd-style')) return;
  var st = document.createElement('style');
  st.id = 'rd-style';
  st.textContent = [
    '#page-read{background:linear-gradient(168deg,#f7ecef 0%,#f3e9f2 42%,#efe9f5 100%);overflow:hidden}',
    '#page-read .rd-root{flex:1;min-height:0;display:flex;flex-direction:column;position:relative;color:#2c2a2c}',
    '.rd-head{flex:0 0 auto;display:flex;align-items:center;gap:8px;padding:10px 14px 6px}',
    '.rd-pill{height:36px;border:0;border-radius:999px;background:rgba(255,255,255,.72);padding:0 15px;font-family:inherit;font-size:12.5px;color:#3a3a3a;display:inline-flex;align-items:center;gap:6px;cursor:pointer;box-shadow:0 2px 10px rgba(80,50,70,.05);backdrop-filter:blur(8px)}',
    '.rd-pill.dark{background:#3a3438;color:#fff;box-shadow:0 8px 18px rgba(60,40,55,.18)}',
    '.rd-pill svg{width:14px;height:14px}',
    '.rd-head .rd-title-pill{flex:1;height:36px;border-radius:999px;background:rgba(255,255,255,.55);display:flex;align-items:center;padding:0 16px;font-size:12.5px;color:#5d555b;letter-spacing:1px}',
    '.rd-body{flex:1;min-height:0;overflow-y:auto;padding:6px 14px 20px;-webkit-overflow-scrolling:touch}',
    '.rd-body::-webkit-scrollbar{display:none}',
    '.rd-hero{position:relative;border-radius:22px;padding:20px 18px 18px;min-height:164px;overflow:hidden;background:linear-gradient(135deg,#aeb5ae 0%,#98a29a 48%,#7f8a84 100%);color:#fff;box-shadow:0 16px 34px rgba(70,80,74,.18)}',
    '.rd-hero::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.10) 0 1px,transparent 1px 7px);opacity:.45;pointer-events:none}',
    '.rd-hero::after{content:"";position:absolute;left:14%;bottom:-38%;width:78%;height:90%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,255,255,.22),rgba(255,255,255,0));pointer-events:none}',
    '.rd-heart{position:relative;width:30px;height:30px;border-radius:50%;border:1px solid rgba(255,255,255,.55);display:flex;align-items:center;justify-content:center;color:#fff}',
    '.rd-heart svg{width:14px;height:14px}',
    '.rd-hero-txt{position:absolute;right:18px;bottom:16px;text-align:right;line-height:1.85;font-size:11.5px;letter-spacing:.8px;text-shadow:0 1px 6px rgba(0,0,0,.16)}',
    '.rd-hero-txt b{display:block;font-size:13px;letter-spacing:2px;font-weight:600}',
    '.rd-hero-txt .pct{font-size:15px;letter-spacing:1px}',
    '.rd-panel{margin-top:14px;background:rgba(255,255,255,.82);border-radius:22px;padding:16px 16px 14px;box-shadow:0 10px 28px rgba(90,60,80,.07);backdrop-filter:blur(10px)}',
    '.rd-crumb{font-size:10.5px;color:#a79ea5;letter-spacing:1.2px}',
    '.rd-big{font-family:"Songti SC","Noto Serif SC",serif;font-size:21px;letter-spacing:2px;margin-top:6px;color:#2b282a}',
    '.rd-sub{font-size:11.5px;color:#8e858c;line-height:1.8;margin-top:8px}',
    '.rd-stats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:14px;border-top:1px solid rgba(0,0,0,.06);padding-top:12px}',
    '.rd-stat{text-align:left;padding-left:2px}',
    '.rd-stat b{font-size:16px;font-weight:600;letter-spacing:.5px}',
    '.rd-stat span{display:block;font-size:10px;color:#a79ea5;margin-top:3px}',
    '.rd-today{display:flex;align-items:center;gap:10px;margin-top:12px;background:rgba(255,255,255,.78);border-radius:999px;padding:5px 6px 5px 16px;box-shadow:0 6px 18px rgba(90,60,80,.06)}',
    '.rd-today .t{flex:1;min-width:0;font-size:11.5px;color:#6f676d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}',
    '.rd-today .t b{color:#2c2a2c;font-weight:600}',
    '.rd-go{flex:none;height:34px;max-width:52%;border:0;border-radius:999px;background:#3a3438;color:#fff;font-family:inherit;font-size:11.5px;padding:0 15px;display:flex;align-items:center;gap:8px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}',
    '.rd-go i{font-style:normal;opacity:.7;font-size:10.5px}',
    '.rd-shelf-h{display:flex;align-items:flex-end;justify-content:space-between;margin:20px 2px 10px}',
    '.rd-shelf-h .l{font-size:10.5px;color:#a79ea5;letter-spacing:2px}',
    '.rd-shelf-h .m{font-family:"Songti SC","Noto Serif SC",serif;font-size:20px;letter-spacing:2px;margin-top:4px}',
    '.rd-shelf-btns{display:flex;gap:8px}',
    '.rd-shelf-btns button{height:34px;border-radius:999px;border:1px solid rgba(60,50,58,.16);background:rgba(255,255,255,.55);font-family:inherit;font-size:11px;color:#5f575d;padding:0 14px;cursor:pointer}',
    '.rd-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}',
    '.rd-book{position:relative;border-radius:16px;overflow:hidden;min-height:190px;background:linear-gradient(150deg,#8e9a95,#69756f);color:#fff;padding:14px;display:flex;flex-direction:column;justify-content:flex-end;cursor:pointer;box-shadow:0 12px 24px rgba(60,60,60,.14)}',
    '.rd-book::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(115deg,rgba(255,255,255,.10) 0 1px,transparent 1px 9px);opacity:.5}',
    '.rd-book::after{content:"";position:absolute;width:62%;height:38%;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.22),transparent);right:-8%;bottom:22%}',
    '.rd-book .bk-tag{position:absolute;top:12px;left:12px;font-size:9px;letter-spacing:1px;color:rgba(255,255,255,.85);border:1px solid rgba(255,255,255,.3);border-radius:4px;padding:2px 5px}',
    '.rd-book .bk-title{position:relative;font-family:"Songti SC","Noto Serif SC",serif;font-size:19px;line-height:1.45;letter-spacing:1px;max-width:88%;text-shadow:0 2px 10px rgba(0,0,0,.18)}',
    '.rd-book .bk-sub{position:relative;font-size:9.5px;color:rgba(255,255,255,.72);margin-top:8px;letter-spacing:.6px}',
    '.rd-add{border-radius:16px;border:1px dashed rgba(90,70,85,.22);min-height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;font-size:10.5px;line-height:1.9;color:#a294a0;padding:16px;cursor:pointer}',
    '.rd-add b{font-size:11.5px;font-weight:600;color:#7d6f79;white-space:nowrap}',
    '.rd-add span{font-size:9.5px;color:#b0a3ac;white-space:nowrap}',
    '.rd-empty-note{grid-column:1/-1;border:1px dashed rgba(90,70,85,.18);border-radius:16px;min-height:88px;display:flex;align-items:center;justify-content:center;font-size:10.5px;color:#a99ca6;letter-spacing:.5px}',
    '.rd-empty-note.tall{grid-column:auto;min-height:190px}',
    /* 阅读器 */
    '.rd-reader{position:absolute;inset:0;background:linear-gradient(170deg,#f8f0f2,#f2ecf6);display:flex;flex-direction:column;z-index:4}',
    '.rd-reader[hidden]{display:none}',
    '.rd-rhead{flex:0 0 auto;display:flex;align-items:center;gap:8px;padding:10px 14px 6px}',
    '.rd-rhead .bk{flex:1;min-width:0;font-family:"Songti SC","Noto Serif SC",serif;font-size:14px;letter-spacing:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#3a3438}',
    '.rd-sync{flex:none;height:32px;border-radius:999px;border:1px solid rgba(60,50,58,.14);background:rgba(255,255,255,.6);font-family:inherit;font-size:10.5px;color:#6a6168;padding:0 12px;display:inline-flex;align-items:center;gap:6px;cursor:pointer}',
    '.rd-sync.on{background:#3a3438;color:#fff;border-color:#3a3438}',
    '.rd-sync i{width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.7}',
    '.rd-paper{flex:1;min-height:0;overflow-y:auto;padding:6px 22px 18px;-webkit-overflow-scrolling:touch}',
    '.rd-paper::-webkit-scrollbar{display:none}',
    '.rd-paper .pg{font-size:15px;line-height:2.15;letter-spacing:.4px;color:#3c373b;font-family:"Songti SC","Noto Serif SC",serif}',
    '.rd-para{position:relative;margin:0 0 14px;padding:2px 2px;transition:background .2s;border-radius:6px;cursor:pointer}',
    '.rd-para.ta{background:linear-gradient(transparent 62%,rgba(196,168,184,.22) 62%)}',
    '.rd-para.me{background:linear-gradient(transparent 62%,rgba(150,170,190,.24) 62%)}',
    '.rd-note{margin:-6px 0 14px 2px;font-size:10.5px;line-height:1.7;color:#8b7f88;display:flex;gap:6px;align-items:flex-start}',
    '.rd-note b{flex:none;font-weight:600;color:#6f636c}',
    '.rd-emoji{position:absolute;right:0;top:-13px;display:flex;gap:4px;z-index:2}',
    '.rd-emoji span{font-size:11px;line-height:1;padding:3px 5px;border-radius:999px;background:rgba(255,255,255,.92);box-shadow:0 3px 8px rgba(90,60,80,.12)}',
    '.rd-rfoot{flex:0 0 auto;padding:8px 16px 12px;background:linear-gradient(0deg,rgba(248,242,245,.96),rgba(248,242,245,.7))}',
    '.rd-prog{height:3px;border-radius:99px;background:rgba(80,60,74,.10);overflow:hidden}',
    '.rd-prog i{display:block;height:100%;background:#3a3438;border-radius:99px;transition:width .25s}',
    '.rd-rbar{display:flex;align-items:center;gap:10px;margin-top:10px}',
    '.rd-rbar .n{font-size:10px;color:#a99ca6;flex:none;letter-spacing:.5px}',
    '.rd-rbar button{height:36px;border-radius:999px;border:1px solid rgba(60,50,58,.14);background:rgba(255,255,255,.7);font-family:inherit;font-size:11.5px;color:#5c545a;padding:0 15px;cursor:pointer}',
    '.rd-rbar button:disabled{opacity:.35}',
    '.rd-rbar .next{margin-left:auto;background:#3a3438;color:#fff;border-color:#3a3438}',
    '.rd-hint{text-align:center;font-size:9.5px;color:#b3a7af;letter-spacing:.6px;margin-top:8px}',
    '.rd-ta-chip{position:absolute;right:14px;bottom:86px;z-index:3;display:flex;flex-direction:column;align-items:flex-end;gap:6px;pointer-events:none}',
    '.rd-ta-chip span{background:rgba(255,255,255,.85);border-radius:999px;padding:5px 10px;font-size:10px;color:#6a6168;box-shadow:0 6px 16px rgba(90,60,80,.10);animation:rdIn .35s ease both}',
    '@keyframes rdIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}',
    '[data-theme="dark"] #page-read{background:linear-gradient(168deg,#1c1a1c,#211d22 55%,#241f28)}',
    '[data-theme="dark"] .rd-panel,[data-theme="dark"] .rd-today{background:rgba(42,38,42,.88)}',
    '[data-theme="dark"] .rd-big,[data-theme="dark"] .rd-para,[data-theme="dark"] .rd-reader .bk{color:#eee}',
    '[data-theme="dark"] .rd-reader{background:linear-gradient(170deg,#1e1b1f,#221e26)}',
    '[data-theme="dark"] .rd-pill{background:rgba(58,52,58,.8);color:#e8e2e6}',
    '[data-theme="dark"] .rd-head .rd-title-pill{background:rgba(58,52,58,.55);color:#cfc6cc}'
  ].join('\n');
  document.head.appendChild(st);
}

/* ---------- 构建页面 ---------- */
function build() {
  if ($(PAGE_ID)) return;
  var host = (document.getElementById('page-cjian') || document.getElementById('page-phone'));
  host = host && host.parentNode;
  if (!host) return;
  var pg = document.createElement('div');
  pg.className = 'page';
  pg.id = PAGE_ID;
  pg.hidden = true;
  pg.innerHTML = '' +
    '<div class="rd-root">' +
    '<div class="rd-head">' +
    '<button class="rd-pill dark" id="rdBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>返回</button>' +
    '<div class="rd-title-pill">阅读室</div>' +
    '<button class="rd-pill" id="rdImport">导入书籍</button>' +
    '</div>' +
    '<div class="rd-body" id="rdBody"></div>' +
    '<div class="rd-reader" id="rdReader" hidden>' +
    '<div class="rd-rhead">' +
    '<button class="rd-pill dark" id="rdRBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>' +
    '<div class="bk" id="rdRTitle"></div>' +
    '<button class="rd-sync on" id="rdSync"><i></i><span id="rdSyncTxt">一起读</span></button>' +
    '</div>' +
    '<div class="rd-paper" id="rdPaper"></div>' +
    '<div class="rd-ta-chip" id="rdTaChip"></div>' +
    '<div class="rd-rfoot">' +
    '<div class="rd-prog"><i id="rdProg"></i></div>' +
    '<div class="rd-rbar">' +
    '<button id="rdPrev">上一页</button>' +
    '<span class="n" id="rdPageN">1 / 1</span>' +
    '<button class="next" id="rdNext">下一页</button>' +
    '</div>' +
    '<div class="rd-hint">轻点任意段落，写一句标注</div>' +
    '</div>' +
    '</div>' +
    '</div>' +
    '<input type="file" id="rdFile" accept=".txt,.md,text/plain" hidden>';
  host.appendChild(pg);
  $('rdBack').addEventListener('click', function () { closePage(pg); });
  $('rdImport').addEventListener('click', function () { $('rdFile').click(); });
  $('rdFile').addEventListener('change', onImport);
  $('rdRBack').addEventListener('click', backToRoom);
  $('rdPrev').addEventListener('click', function () { turn(-1); });
  $('rdNext').addEventListener('click', function () { turn(1); });
  $('rdSync').addEventListener('click', toggleSync);
  $('rdPaper').addEventListener('click', onPaperClick);
  $('rdBody').addEventListener('click', onRoomClick);
}

function openPageEl(el) {
  document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
  el.hidden = false;
  try {
    var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = true;
    var ph = document.querySelector('.phone'); if (ph) ph.classList.add('no-statusbar');
    el.classList.add('full');
  } catch (e) {}
}
function closePage(el) {
  try { el.classList.remove('full'); } catch (e) {}
  document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
  var back = document.getElementById('page-phone');
  if (back) back.hidden = false;
  try {
    var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = false;
    var ph = document.querySelector('.phone'); if (ph) ph.classList.remove('no-statusbar');
  } catch (e) {}
}

/* ---------- 房间 ---------- */
function openRoom() {
  build();
  var pg = $(PAGE_ID); if (!pg) return;
  if ($('rdReader')) $('rdReader').hidden = true;
  openPageEl(pg);
  paintRoom();
}
function paintRoom() {
  var body = $('rdBody'); if (!body) return;
  var arr = loadBooks();
  var b = curBook();
  var pct = b ? progressOf(b) : 0;
  var today = minutesToday();
  var total = totalMinutes();
  var done = finishedCount();
  var shelf = arr.map(function (x) { return '<div class="rd-book" data-book="' + esc(x.id) + '">' +
    '<span class="bk-tag">TXT</span>' +
    '<div class="bk-title">' + esc(x.title || '无题') + '</div>' +
    '<div class="bk-sub">Cafe 阅读室 · ' + (x.finished ? '已读完' : ('最近阅读 · ' + progressOf(x) + '%')) + '</div>' +
    '</div>'; }).join('');
  body.innerHTML = '' +
    '<div class="rd-hero">' +
    '<div class="rd-heart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5S4.5 15.2 4.5 9.9A4.9 4.9 0 0112 7.1a4.9 4.9 0 017.5 2.8c0 5.3-7.5 10.6-7.5 10.6z"/></svg></div>' +
    '<div class="rd-hero-txt"><b>缓缓读 · 好好留存</b>' + dateLabel() + '<br>上次读到 <span class="pct">' + pct + '%</span></div>' +
    '</div>' +
    '<div class="rd-panel">' +
    '<div class="rd-crumb">阅读记录 › 概览</div>' +
    '<div class="rd-big">今天也读一点吧</div>' +
    '<div class="rd-sub">' + (b ? ('《' + esc(b.title) + '》还停在' + (b.page > 0 ? ('第 ' + (b.page + 1) + ' 页') : '第一页') + '。') : '书架还是空的，导入一本试试。') + '</div>' +
    '<div class="rd-stats">' +
    '<div class="rd-stat"><b>' + today + ' 分钟</b><span>今日阅读</span></div>' +
    '<div class="rd-stat"><b>' + total + ' 分钟</b><span>最近累计</span></div>' +
    '<div class="rd-stat"><b>' + done + ' 本</b><span>已经读完</span></div>' +
    '</div>' +
    '</div>' +
    '<div class="rd-today"><span class="t">今日待读</span>' +
    '<button class="rd-go" id="rdContinue">' + (b ? esc(b.title) : '去导入') + '<i>' + pct + '%</i></button></div>' +
    '<div class="rd-shelf-h"><div><div class="l">书库 /</div><div class="m">我的书架</div></div>' +
    '<div class="rd-shelf-btns"><button id="rdShelfBtn">书架</button><button id="rdCopyBtn">套抄</button></div></div>' +
    '<div class="rd-grid">' + shelf +
    '<div class="rd-add" id="rdAdd"><b>＋ 导入一本书</b><span>TXT / MD · 留在本机</span></div>' +
    '</div>';
  var go = $('rdContinue'); if (go) go.addEventListener('click', function () { if (loadBooks().length) openReader(); else $('rdFile').click(); });
  var add = $('rdAdd'); if (add) add.addEventListener('click', function () { $('rdFile').click(); });
  var sb = $('rdShelfBtn'); if (sb) sb.addEventListener('click', function () { toast('书架里现在有 ' + loadBooks().length + ' 本'); });
  var cb = $('rdCopyBtn'); if (cb) cb.addEventListener('click', function () { toast('套抄：把这一页抄进今日记录（示意）'); });
}
function onRoomClick(e) {
  var bk = e.target.closest && e.target.closest('[data-book]');
  if (!bk) return;
  var id = bk.getAttribute('data-book');
  writeStr(OPEN, id);
  openReader();
}

/* ---------- 阅读器 ---------- */
var taTimer = null, minuteTimer = null;
function syncOn() { return readStr(SYNC, '1') !== '0'; }
function toggleSync() {
  var on = !syncOn();
  writeStr(SYNC, on ? '1' : '0');
  paintSync();
  if (on) { scheduleTA(4000); toast('一起读已打开：' + partner() + '会同步标注'); }
  else { stopTA(); toast('已改成自己读'); }
}
function paintSync() {
  var b = $('rdSync'), t = $('rdSyncTxt');
  var on = syncOn();
  if (b) b.classList.toggle('on', on);
  if (t) t.textContent = on ? (partner() + ' 一起读') : '自己读';
}
function openReader() {
  build();
  var b = curBook(); if (!b) return;
  var pg = $(PAGE_ID); if (!pg) return;
  openPageEl(pg);
  if ($('rdReader')) $('rdReader').hidden = false;
  if ($('rdRTitle')) $('rdRTitle').textContent = b.title || '无题';
  paintSync();
  paintPage();
  scheduleTA(6000);
  startMinute();
}
function backToRoom() {
  if ($('rdReader')) $('rdReader').hidden = true;
  stopTA(); stopMinute();
  paintRoom();
}
function paintPage() {
  var b = curBook(); if (!b) return;
  var paper = $('rdPaper'); if (!paper) return;
  paper.scrollTop = 0;
  var txt = (b.pages && b.pages[b.page]) || '';
  var paras = txt.split(/\n{1,}/).map(function (x) { return x.trim(); }).filter(Boolean);
  var notes = (b.notes || []).filter(function (n) { return n.page === b.page; });
  var reacts = (b.reactions || []).filter(function (r) { return r.page === b.page; });
  paper.innerHTML = '<div class="pg">' + paras.map(function (p, i) {
    var note = null;
    for (var k = 0; k < notes.length; k++) if (notes[k].pi === i) { note = notes[k]; break; }
    var em = reacts.filter(function (r) { return r.pi === i; }).map(function (r) { return '<span>' + esc(r.e) + '</span>'; }).join('');
    return '<p class="rd-para' + (note ? (' ' + (note.by === 'ta' ? 'ta' : 'me')) : '') + '" data-pi="' + i + '">' + esc(p) +
      (em ? '<span class="rd-emoji">' + em + '</span>' : '') + '</p>' +
      (note ? '<div class="rd-note"><b>' + (note.by === 'ta' ? esc(partner()) : '我') + '</b><span>' + esc(note.text) + '</span></div>' : '');
  }).join('') + '</div>';
  var pct = progressOf(b);
  if ($('rdProg')) $('rdProg').style.width = pct + '%';
  if ($('rdPageN')) $('rdPageN').textContent = (b.page + 1) + ' / ' + b.pages.length;
  if ($('rdPrev')) $('rdPrev').disabled = b.page <= 0;
  if ($('rdNext')) $('rdNext').textContent = b.page >= b.pages.length - 1 ? '读完了' : '下一页';
}
function turn(d) {
  var b = curBook(); if (!b) return;
  var np = Math.max(0, Math.min(b.pages.length - 1, b.page + d));
  if (np === b.page) {
    if (d > 0 && !b.finished) {
      b.finished = true; b.lastAt = Date.now(); putBook(b);
      toast('这一本读完了，留在书架上了');
      paintPage();
    }
    return;
  }
  b.page = np; b.lastAt = Date.now();
  putBook(b);
  paintPage();
  maybeTaReact();
}
function onPaperClick(e) {
  var p = e.target.closest && e.target.closest('.rd-para');
  if (!p) return;
  var b = curBook(); if (!b) return;
  var pi = Number(p.getAttribute('data-pi'));
  var notes = b.notes || [];
  var old = null;
  for (var i = 0; i < notes.length; i++) if (notes[i].page === b.page && notes[i].pi === pi) { old = notes[i]; break; }
  if (!window.openModal) { toast('标注入口还没准备好'); return; }
  window.openModal('写一句标注', old ? old.text : '', function (v) {
    var t = String(v || '').trim();
    if (!t) return;
    b.notes = (b.notes || []).filter(function (n) { return !(n.page === b.page && n.pi === pi); });
    b.notes.push({ page: b.page, pi: pi, by: 'me', text: t.slice(0, 120), at: Date.now() });
    putBook(b); paintPage(); toast('标注好了');
  }, { textarea: true, placeholder: '写给这一页的一句话' });
}

/* ---------- TA 同步 ---------- */
var TA_NOTES = ['这一句我停了一下。', '读到这里，想到你。', '这句适合放在晚上读。', '我把它折了个角。', '慢慢读，不着急。', '这里的灯好像亮了一点。'];
var TA_EMOJI = ['🌸', '🍵', '✨', '💛', '🕯️', '📖'];
function scheduleTA(ms) {
  if (taTimer) clearTimeout(taTimer);
  if (!syncOn()) return;
  taTimer = setTimeout(function tick() {
    taTimer = null;
    try { if ($('rdReader') && !$('rdReader').hidden) taAnnotate(); } catch (e) {}
    if (syncOn()) scheduleTA(14000 + Math.random() * 8000);
  }, ms);
}
function stopTA() { if (taTimer) { clearTimeout(taTimer); taTimer = null; } }
function taAnnotate() {
  var b = curBook(); if (!b) return;
  if (Math.random() > TA_RATE) return;
  var txt = (b.pages && b.pages[b.page]) || '';
  var paras = txt.split(/\n{1,}/).map(function (x) { return x.trim(); }).filter(Boolean);
  if (!paras.length) return;
  var used = (b.notes || []).filter(function (n) { return n.page === b.page && n.by === 'ta'; }).map(function (n) { return n.pi; });
  var free = [];
  for (var i = 0; i < paras.length; i++) if (used.indexOf(i) < 0) free.push(i);
  if (!free.length) return;
  var pi = free[Math.floor(Math.random() * free.length)];
  b.notes = b.notes || [];
  b.notes.push({ page: b.page, pi: pi, by: 'ta', text: TA_NOTES[Math.floor(Math.random() * TA_NOTES.length)], at: Date.now() });
  b.reactions = b.reactions || [];
  b.reactions.push({ page: b.page, pi: pi, e: TA_EMOJI[Math.floor(Math.random() * TA_EMOJI.length)], at: Date.now() });
  putBook(b); paintPage();
  chip(partner() + ' 在旁边标了一句');
}
function maybeTaReact() {
  if (!syncOn()) return;
  setTimeout(function () {
    var b = curBook(); if (!b) return;
    if (Math.random() > 0.55) return;
    var txt = (b.pages && b.pages[b.page]) || '';
    var n = txt.split(/\n{1,}/).filter(function (x) { return x.trim(); }).length || 1;
    b.reactions = b.reactions || [];
    b.reactions.push({ page: b.page, pi: Math.floor(Math.random() * n), e: TA_EMOJI[Math.floor(Math.random() * TA_EMOJI.length)], at: Date.now() });
    putBook(b); paintPage();
  }, 900);
}
function chip(t) {
  var box = $('rdTaChip'); if (!box) return;
  var s = document.createElement('span'); s.textContent = t; box.appendChild(s);
  setTimeout(function () { try { box.removeChild(s); } catch (e) {} }, 3200);
}

/* ---------- 计时 ---------- */
function startMinute() {
  stopMinute();
  minuteTimer = setInterval(function () {
    if (document.hidden || !$('rdReader') || $('rdReader').hidden) return;
    addMinute();
    var b = curBook(); if (b) { b.minutes = (Number(b.minutes) || 0) + 1; putBook(b); }
  }, 60000);
}
function stopMinute() { if (minuteTimer) { clearInterval(minuteTimer); minuteTimer = null; } }

/* ---------- 导入 ---------- */
function onImport(e) {
  var f = e.target && e.target.files && e.target.files[0];
  e.target.value = '';
  if (!f) return;
  if (f.size > 600 * 1024) { toast('这本书有点大，先选 600KB 以内的 TXT'); return; }
  var fr = new FileReader();
  fr.onload = function () {
    var txt = String(fr.result || '').replace(/\r\n/g, '\n').trim();
    if (!txt) { toast('这个文件里没有文字'); return; }
    var title = (f.name || '未命名').replace(/\.(txt|md)$/i, '') || '未命名';
    var id = 'b' + Date.now();
    var b = { id: id, title: title, text: txt, page: 0, pages: splitPages(txt), addedAt: Date.now(), lastAt: 0, minutes: 0, finished: false, notes: [], reactions: [] };
    var arr = loadBooks(); arr.push(b);
    if (arr.length > 12) arr = arr.slice(arr.length - 12);
    saveBooks(arr); writeStr(OPEN, id);
    toast('已放进书架：《' + title + '》');
    paintRoom(); openReader();
  };
  fr.onerror = function () { toast('读取失败，换个文件试试'); };
  fr.readAsText(f, 'utf-8');
}

/* ---------- 桌面图标 ---------- */
function mountIcon() {
  var grid = document.querySelector('.app-grid.p2-grid');
  if (!grid || grid.querySelector('[data-app="reading"]')) return;
  var a = document.createElement('div');
  a.className = 'app';
  a.setAttribute('data-app', 'reading');
  a.innerHTML = '<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.3 5.3 8.2 4.8 5.5 4.8H4v13.4h1.5c2.7 0 4.8.5 6.5 1.7 1.7-1.2 3.8-1.7 6.5-1.7H20V4.8h-1.5c-2.7 0-4.8.5-6.5 1.7z"/><path d="M12 6.5v13.4"/></svg></div>' +
    '<div class="app-name">阅读室</div>';
  grid.appendChild(a);
}
document.addEventListener('click', function (e) {
  /* v78：整理模式下不拦截——交给桌面「图标设置 / 拖动」接管 */
  var _phR = document.getElementById('page-phone');
  if (_phR && _phR.classList.contains('decor-on')) return;
  var a = e.target.closest && e.target.closest('.app[data-app]');
  if (!a || a.getAttribute('data-app') !== 'reading') return;
  e.preventDefault(); e.stopPropagation();
  openRoom();
}, true);

function boot() {
  css();
  build();
  mountIcon();
}
/* 读书时不让人物随机小窗打断（只在本页阅读视图打开时生效） */
setInterval(function () {
  try {
    var r = $('rdReader');
    if (!r || r.hidden) return;
    ['qa-mask', 'tc-mask'].forEach(function (id) {
      var m = document.getElementById(id);
      if (m && !m.hidden) m.hidden = true;
    });
  } catch (e) {}
}, 900);
window.__rdOpen = openRoom;
window.__rdReader = openReader;
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();
setTimeout(boot, 1000);
setTimeout(boot, 3000);
} catch (e) { try { console.error('[reading-yz]', e && e.message); } catch (x) {} }
})();

</script>
<script>/* inline: msg-status-yz.js */
/* msg-status-yz.js —— 气泡「已读/未读」+「已收藏」
 * 与 chat.js 解耦：只读 window.getChatMsgs / window.getFav，不改核心渲染。
 * 存储：yz-msg-read（mk → ts）
 * v22（用户直派）：已读/未读 + 时间挪到聊天气泡右下角。
 * v25（用户直派）：已读/未读挂到气泡外部右下角，头像大小还原。
 * v45（用户直派）：
 *   - 所有被收藏的消息（我发的、TA 发的都算）在气泡右下角外侧显示永久「已收藏」，
 *     与「已读」并排；
 *   - 收藏判定改为 side+text 匹配（旧实现用 msgKeyOf 的 ts，而收藏记录的 ts 曾是
 *     收藏时刻，和消息时间对不上 → 标记不显示，看起来像「只收藏了最后一条」）。
 */
(function () {
  'use strict';

  var READ_KEY = 'yz-msg-read';
  var SEP = '\u0001';

  function $(id) { return document.getElementById(id); }
  function curStore() {
    try {
      if (window.activeStore) return window.activeStore();
      return window.storeFor ? window.storeFor(window.__activeCid || 'default') : window.store;
    } catch (e) { return window.store; }
  }
  function loadMap(k) {
    try { var v = JSON.parse(curStore().get(k) || '{}'); return (v && typeof v === 'object') ? v : {}; } catch (e) { return {}; }
  }
  function saveMap(k, v) { try { curStore().set(k, JSON.stringify(v)); } catch (e) {} }
  function settingOn(k, def) {
    try { var v = curStore().get(k); if (v === '0') return false; if (v === '1') return true; } catch (e) {}
    return def !== false;
  }

  /* ---------- 样式 ---------- */
  function injectStyle() {
    if ($('mz-style')) return;
    var st = document.createElement('style');
    st.id = 'mz-style';
    st.textContent = [
      '.msg-bubble{position:relative}',
      '.msg .msg-bubble{position:relative}',
      /* 气泡外下方右侧/左侧一行：已读 + 已收藏 并排 */
      '.msg .mz-meta{position:absolute;top:100%;margin-top:3px;display:flex;align-items:center;gap:6px;font-size:9.5px;line-height:1.1;font-weight:400;letter-spacing:.2px;color:var(--ink,#111);opacity:.5;white-space:nowrap;pointer-events:none;z-index:3}',
      '.msg-out .mz-meta{right:0;justify-content:flex-end}',
      '.msg-in .mz-meta{left:0;justify-content:flex-start}',
      '.mz-meta .mz-st{margin-left:0}',
      '.mz-meta .mz-st.read{opacity:1}',
      '.mz-meta .mz-st.unread{opacity:.9}',
      '.mz-fav{pointer-events:auto;border:0;background:transparent;padding:0;margin:0;font:inherit;letter-spacing:.2px;color:inherit;opacity:.9;display:inline-flex;align-items:center;gap:2px;cursor:pointer}',
      '.mz-fav svg{width:9px;height:9px;flex:none}',
      '.mz-fav:active{opacity:1}'
    ].join('\n');
    document.head.appendChild(st);
  }

  /* ---------- 收藏索引（v47：data-mk 优先 + side/text 兜底） ----------
     旧版只读 window.getFav，但该接口从未在 chat.js 暴露 → 索引恒空、提示不显示。
     现改由 chat.js 的 window.getFavIndex() 统一产出，规则与气泡 data-mk 一致。 */
  function favKeyOfRec(rec) {
    if (!rec) return '';
    return String(rec.side || '') + SEP + String(rec.text || '');
  }
  function favIndexNow() {
    try {
      if (window.getFavIndex) return window.getFavIndex();
    } catch (e) {}
    return { byMk: {}, byST: {} };
  }
  function favReasonOf(idx, mk, rec) {
    if (!idx) return null;
    if (mk && Object.prototype.hasOwnProperty.call(idx.byMk, mk)) return idx.byMk[mk] || '';
    var k = favKeyOfRec(rec);
    if (k && Object.prototype.hasOwnProperty.call(idx.byST, k)) return idx.byST[k] || '';
    return null;
  }
  function favShowOn() {
    try { if (window.getFavShow) return window.getFavShow(); } catch (e) {}
    return settingOn('fav-tag-show', true);
  }

  /* ---------- 装饰：已读 / 未读 / 已收藏 ---------- */
  var decorateTimer = null;
  function decorate() {
    var body = $('chat-body');
    if (!body) return;
    var reads = loadMap(READ_KEY);
    var showRead = settingOn('yz-read-en', true);
    var showFav = favShowOn();
    var now = Date.now();
    var list = window.getChatMsgs ? window.getChatMsgs() : [];
    var favIdx = showFav ? favIndexNow() : { byMk: {}, byST: {} };
    var changed = false;

    // 已读判定：①之后 5 分钟内有 TA 的消息；②发出已超过 6~16 秒
    var firstInAfter = {};
    (function () {
      var lastIn = 0;
      for (var i = list.length - 1; i >= 0; i--) {
        var m = list[i];
        if (!m) continue;
        if (m.side === 'out') { if (lastIn) firstInAfter[i] = lastIn; }
        else if ((m.ts || 0) > 0) lastIn = m.ts;
      }
    })();

    var nodes = body.querySelectorAll('.msg[data-mk]');
    for (var k = 0; k < nodes.length; k++) {
      var el = nodes[k];
      var mk = el.dataset.mk || '';
      if (!mk) continue;
      var out = el.classList.contains('msg-out');
      var bubble = el.querySelector('.msg-bubble');
      if (!bubble) continue;
      var sideEl = el.querySelector('.msg-side');
      var timeEl = el.querySelector('.msg-side .msg-time');

      // 清掉旧版注入（曾经拼在 .msg-time 里的「··· 已读」）
      if (timeEl) {
        var oldDots = timeEl.querySelector('.mz-dots');
        var oldState = timeEl.querySelector('.mz-state');
        if (oldDots) oldDots.remove();
        if (oldState) oldState.remove();
      }

      var idx = Number(el.dataset.idx);
      var rec = (idx >= 0 && idx < list.length) ? list[idx] : null;

      // 已读/未读：只对我发的消息
      var readHtml = '';
      if (out && showRead) {
        var ts = rec ? (rec.ts || 0) : 0;
        var readAt = reads[mk] || 0;
        if (!readAt && ts) {
          var inTs = firstInAfter[idx] || 0;
          var gap = inTs ? (inTs - ts) : 0;
          if (inTs && gap >= -1000 && gap < 5 * 60 * 1000) {
            readAt = inTs; reads[mk] = readAt; changed = true;
          } else if (now - ts > 16000) {
            readAt = ts + 12000; reads[mk] = readAt; changed = true;
          }
        }
        var label = readAt ? '已读' : '未读';
        var cls = readAt ? 'read' : 'unread';
        readHtml = '<span class="mz-st ' + cls + '">' + label + '</span>';
      }

      // 已收藏：左右消息都显示、永久提示；未收藏不显示（v47 用户直派）
      var favHtml = '';
      if (showFav && favReasonOf(favIdx, mk, rec) !== null) {
        favHtml = '<button class="mz-fav" data-idx="' + idx + '" data-mk="' + (mk || '').replace(/"/g, '&quot;') + '" title="已收藏">' +
          '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>已收藏</button>';
      }

      var html = readHtml + favHtml;
      var meta = bubble.querySelector('.mz-meta') || (sideEl && sideEl.querySelector('.mz-meta'));
      if (!html) {
        if (meta && meta.parentNode) meta.remove();
        if (timeEl) timeEl.style.display = '';
        continue;
      }
      if (!meta) {
        meta = document.createElement('span');
        meta.className = 'mz-meta';
      }
      if (meta.parentNode !== bubble) bubble.appendChild(meta);
      if (meta.innerHTML !== html) meta.innerHTML = html;
      if (timeEl) timeEl.style.display = '';
    }

    if (changed) saveMap(READ_KEY, reads);
  }
  function scheduleDecorate() {
    if (decorateTimer) return;
    decorateTimer = setTimeout(function () { decorateTimer = null; try { decorate(); } catch (e) {} }, 120);
  }

  /* ---------- 点击「已收藏」看原因 ---------- */
  if (document.getElementById('chat-body')) {
    document.addEventListener('click', function (e) {
      var btn = e.target.closest ? e.target.closest('.mz-fav') : null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      var mk = btn.getAttribute('data-mk') || '';
      var reason = '';
      var rec = null;
      try {
        var list = window.getChatMsgs ? window.getChatMsgs() : [];
        var idx = Number(btn.getAttribute('data-idx'));
        rec = (idx >= 0 && idx < list.length) ? list[idx] : null;
        var r = favReasonOf(favIndexNow(), mk, rec);
        if (r !== null) reason = r;
      } catch (err) {}
      /* v48：直接打开收藏夹对应分页并定位（TA 收藏在「联系人的收藏」，之前只弹窗看不出在哪） */
      var jumped = false;
      try { if (window.openFavItem) jumped = !!window.openFavItem(mk, rec); } catch (eJ) {}
      if (jumped) return;
      try {
        if (window.openModal) {
          var pn = (window.chatPartnerName && window.chatPartnerName()) || 'TA';
          window.openModal(pn + ' 收藏了这条消息', '', function () {}, {
            noInput: true,
            staticText: reason ? ('「' + reason + '」') : '这条已收进收藏，没有写原因。'
          });
        }
      } catch (e2) {}
    }, true);
  }

  /* ---------- 聊天设置 · 消息气泡 ---------- */
  function bindToggle(id, key, defVal) {
    var el = $(id);
    if (!el) return;
    var isBool = (key === 'yz-read-en');
    var sync = function () {
      var raw = null;
      try { raw = curStore().get(key); } catch (e) { raw = null; }
      if (isBool) el.checked = (raw !== '0');
      else if (raw === null || raw === undefined || raw === '') el.checked = (defVal > 0);
      else {
        var n = Number(raw);
        el.checked = isFinite(n) ? n > 0 : (defVal > 0);
      }
    };
    sync();
    if (el.__mzBound) return;
    el.__mzBound = true;
    el.addEventListener('change', function () {
      try {
        curStore().set(key, isBool ? (el.checked ? '1' : '0') : (el.checked ? String(defVal) : '0'));
      } catch (e) {}
      scheduleDecorate();
    });
  }
  function mountSettings() {
    bindToggle('cs-quote-en', 'quote-prob', 30);
    bindToggle('cs-read-en', 'yz-read-en', 1);
  }

  /* ---------- 启动 ---------- */
  function boot() {
    injectStyle();
    mountSettings();
    scheduleDecorate();
    var body = $('chat-body');
    if (body && !body.__mzObs) {
      body.__mzObs = new MutationObserver(scheduleDecorate);
      body.__mzObs.observe(body, { childList: true, subtree: false });
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 800);
  setTimeout(boot, 2500);
  setInterval(scheduleDecorate, 4000);

  window.__mzDecorate = scheduleDecorate;
  window.__mzReactTa = function () {};   // 贴反应已移除，保留空接口避免外部调用报错
})();

</script>
<script>/* inline: conn-check-yz.js */
/* conn-check-yz.js —— 连接检测（v34）
 * 需求：
 *   ①「可以检查梦角发的每一句话的连接情况，是否为噪音、潜意识影响」
 *   ②「气泡下面可以看到连接状态（梦角主动／系统噪音／双方影响）」
 *   ③ 视频：气泡下方一行小字（时间 ··· ◇ 连接），点开是一张「连接状态」卡片
 *   ④ v34 用户直派：不再常驻显示——「点聊天消息就出现」
 *      → 平时干净；点哪条 TA 的消息，那条下面才出现连接状态并展开检测卡；
 *        点空白处收起，点「收起」只收卡片、留着标签可以再点开。
 * 与 chat.js 解耦：只读 window.getChatMsgs()，靠 data-mk 定位，不改核心渲染。
 */
(function () {
  'use strict';

  var ON_KEY = 'yz-conn-en';
  var revealMk = null;   // 当前点开的那条消息（决定标签显示）
  var openMk = null;     // 当前展开卡片的那条消息

  function $(id) { return document.getElementById(id); }
  function bodyEl() { return $('chat-body'); }

  function curStore() {
    try {
      if (window.activeStore) return window.activeStore();
      return window.storeFor ? window.storeFor(window.__activeCid || 'default') : window.store;
    } catch (e) { return window.store; }
  }
  function getOn() {
    try { var v = curStore().get(ON_KEY); return v !== '0'; } catch (e) { return true; }
  }

  /* ---------- 稳定散列：同一条消息永远同一结论 ---------- */
  function hash(s) {
    var h = 2166136261;
    s = String(s || '');
    for (var i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h = (h * 16777619) >>> 0;
    }
    return h >>> 0;
  }

  var TYPES = {
    own: {
      key: 'own', label: '梦角主动', cls: 'conn-own',
      clear: '清晰传达', clearN: 4,
      cons: '完整', note: '高度符合其稳定表达习惯与当前语境',
      verdict: '这一句是他自己想说的，没有被别的东西带偏。'
    },
    both: {
      key: 'both', label: '双方影响', cls: 'conn-both',
      clear: '双向叠加', clearN: 3,
      cons: '一致', note: '句子里有你最近说过的词，两边的话搅在一起了',
      verdict: '这句话一半是他的、一半是被你带出来的。'
    },
    noise: {
      key: 'noise', label: '系统噪音', cls: 'conn-noise',
      clear: '有杂讯', clearN: 2,
      cons: '偏移', note: '找不到上下文来源，像是随机补的一句',
      verdict: '这句更像背景噪音，不必太当真。'
    }
  };

  var NOISE_RE = /^(嗯+|哦+|啊+|喔+|好的|好吧|收到|哈哈+|是|对|行|可以的)[。.!！~～\s]*$/;
  var WARM_RE = /依赖|喜欢|爱你|想你|抱|陪你|别怕|在的|等你|别走|心疼|乖|宝贝|辛苦|晚安/;
  var SHARE_RE = /我们|一起|你昨天|你上次|你说过|你说的|记得|和你|听你说|回我|刚才|上次/;

  /* 判断这句到底是「他自己想说的」还是「系统噪音 / 被你带出来的」：
   *  - 系统提示、寒暄短句 → 噪音
   *  - 带我们 / 上次 / 刚才这类共同语境 → 双方影响
   *  - 带依赖 / 想你 / 抱抱这类主动关心 → 梦角主动（再热也不判噪音）
   *  - 其余按稳定散列分配，保证同一条消息永远同一结论 */
  function classify(text, ts) {
    var t = String(text || '').trim();
    if (!t) return 'own';
    if (/^【|\[系统|系统消息|撤回了一条|已读不回/.test(t)) return 'noise';
    var h = hash(t + '|' + (ts || 0));
    var r = h % 100;
    var warm = WARM_RE.test(t);
    var shared = SHARE_RE.test(t);
    if (warm) return (shared && r < 72) ? 'both' : 'own';
    if (NOISE_RE.test(t)) return 'noise';
    if (shared) return r < 86 ? 'both' : 'own';
    if (/[?？]$|吗|干嘛|什么|怎么|哪儿|在哪/.test(t)) return 'own';
    // 噪音只出现在「短、空、没内容」的句子上，长句子不判噪音
    if (t.length <= 3) return r < 55 ? 'noise' : 'own';
    if (t.length <= 9) return r < 24 ? 'noise' : (r < 54 ? 'both' : 'own');
    if (r < 15) return 'both';
    return 'own';
  }

  /* ---------- 各项指标的取值：按类型给区间，再按散列做稳定抖动 ---------- */
  function metrics(type, text, ts) {
    var h = hash(type + '|' + text + '#' + (ts || 0));
    var a = h & 15, b = (h >>> 4) & 15, c = (h >>> 8) & 15, d = (h >>> 12) & 15;
    var m;
    if (type === 'own') {
      m = { act: 7 + a % 3, link: 2 + b % 3, noise: c % 2, jam: 1 + d % 3 };
    } else if (type === 'both') {
      m = { act: 3 + a % 3, link: 6 + b % 3, noise: 1 + c % 2, jam: 2 + d % 3 };
    } else {
      m = { act: 1 + a % 2, link: b % 2, noise: 6 + c % 3, jam: 4 + d % 3 };
    }
    ['act', 'link', 'noise', 'jam'].forEach(function (k) {
      if (m[k] < 0) m[k] = 0;
      if (m[k] > 10) m[k] = 10;
    });
    m.type = type;
    return m;
  }

  /* ---------- 样式 ---------- */
  function injectStyle() {
    if ($('mzc-style')) return;
    var st = document.createElement('style');
    st.id = 'mzc-style';
    st.textContent = [
      /* 气泡下方那一行：◇ 连接 / 梦角主动 */
      '.msg.mz-conn-on{position:relative;margin-bottom:3px}',
      '.mz-conn-chip{position:absolute;left:44px;top:calc(100% + 0px);display:inline-flex;align-items:center;gap:2px;',
      'font-size:9.5px;line-height:1;letter-spacing:.4px;padding:4px 4px 3px;color:#a3a3a3;',
      'cursor:pointer;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;',
      'white-space:nowrap;z-index:4;animation:mzcChipIn .22s ease both}',
      '@keyframes mzcChipIn{from{opacity:0;transform:translateY(-2px)}to{opacity:1;transform:none}}',
      '.mz-conn-chip .mzc-d{font-size:8px;opacity:.7;transform:translateY(-.5px)}',
      '.mz-conn-chip.conn-own{color:#b27a50}',
      '.mz-conn-chip.conn-both{color:#6d84ab}',
      '.mz-conn-chip.conn-noise{color:#a6a6a6}',
      '.mz-conn-chip.on{color:var(--muted,#8a8a8a);opacity:.85}',
      '.mz-conn-chip:active{opacity:.55}',

      /* 检测卡 */
      '.mz-conncard{margin:2px 0 3px 48px;padding:12px 14px 12px;border-radius:14px;',
      'background:var(--msg-in-bg,#fff);color:var(--ink,#111);',
      'border:1px solid rgba(0,0,0,.06);box-shadow:0 6px 20px rgba(0,0,0,.06);',
      'animation:mzcIn .3s cubic-bezier(.22,1,.36,1) both;box-sizing:border-box}',
      '@keyframes mzcIn{from{opacity:0;transform:translateY(-6px) scale(.99)}to{opacity:1;transform:none}}',
      '.mzc-head{display:flex;align-items:center;gap:7px}',
      '.mzc-head b{flex:0 0 auto;font-size:11.5px;font-weight:600;letter-spacing:.5px}',
      '.mzc-tags{flex:1 1 auto;min-width:0;display:flex;justify-content:center;gap:3px;overflow:hidden}',
      '.mzc-tags i{flex:0 0 auto;font-style:normal;font-size:8.8px;line-height:1;letter-spacing:.1px;',
      'padding:3.5px 4.5px;border-radius:99px;white-space:nowrap;color:var(--muted,#8a8a8a);',
      'background:rgba(0,0,0,.035);opacity:.7;transition:opacity .3s ease,background .3s ease,color .3s ease}',
      '.mzc-tags i.on{opacity:1;font-weight:600}',
      '.mzc-tags i.on[data-k="own"]{color:#8a5a32;background:rgba(178,122,80,.15)}',
      '.mzc-tags i.on[data-k="noise"]{color:#787878;background:rgba(0,0,0,.07)}',
      '.mzc-tags i.on[data-k="both"]{color:#4f6b96;background:rgba(109,132,171,.16)}',
      '.mzc-badge{flex:0 0 auto;font-size:9px;line-height:1;letter-spacing:.4px;padding:4px 8px;border-radius:99px;',
      'background:rgba(0,0,0,.045);color:var(--muted,#8a8a8a);transition:color .3s ease,background .3s ease}',
      '.mzc-badge.done{background:rgba(63,138,99,.1);color:#3f8a63}',
      '.mzc-row{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-top:10px}',
      '.mzc-row span{font-size:10.5px;letter-spacing:.3px;color:var(--muted,#8a8a8a)}',
      '.mzc-row em{font-style:normal;font-size:10.5px;letter-spacing:.3px;opacity:.82}',
      '.mzc-seg{display:flex;gap:5px;margin:7px 0 8px}',
      '.mzc-seg u{flex:1;height:3px;border-radius:2px;background:rgba(0,0,0,.085);text-decoration:none;transition:background .4s ease}',
      '.mzc-seg u.on{background:currentColor;opacity:.78}',
      '.mzc-note{margin:0;font-size:9.5px;line-height:1.55;letter-spacing:.2px;color:var(--muted,#8a8a8a);opacity:.8}',
      '.mzc-div{height:1px;background:rgba(0,0,0,.06);margin:11px 0 0}',
      '.mzc-m{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-top:9px}',
      '.mzc-m span{font-size:10.5px;letter-spacing:.3px;opacity:.75}',
      '.mzc-m b{font-weight:400;font-size:9.5px;letter-spacing:.3px;color:var(--muted,#8a8a8a)}',
      '.mzc-m b i{font-style:normal;opacity:.55}',
      '.mzc-bar{margin-top:5px;height:2px;border-radius:2px;background:rgba(0,0,0,.07);overflow:hidden}',
      '.mzc-bar u{display:block;height:100%;width:0;border-radius:2px;background:currentColor;opacity:.7;',
      'transition:width .6s cubic-bezier(.22,1,.36,1)}',
      '.mzc-verdict{margin:11px 0 0;padding-top:9px;border-top:1px dashed rgba(0,0,0,.08);',
      'font-size:9.5px;line-height:1.6;letter-spacing:.2px;color:var(--muted,#8a8a8a)}',
      '[data-theme="dark"] .mz-conncard{border-color:rgba(255,255,255,.08);box-shadow:0 6px 22px rgba(0,0,0,.4)}',
      /* v43 用户直派「切深色后链接状态的条码颜色要跟浅色模式一样」：
         浅色卡是「极浅轨道 + 深色条」，深色模式此前跟着 --ink 反成了「灰轨 + 白条」，观感整个反过来。
         这里把条码自己的底与条都钉成浅色模式那一套（浅灰轨 #ededed + 近黑条 #111），
         条只有 2~3px 高，看起来和浅色模式完全一致，也不会在深色卡上刺眼。 */
      '[data-theme="dark"] .mzc-seg u{background:#ededed}',
      '[data-theme="dark"] .mzc-seg u.on{background:#111;opacity:1}',
      '[data-theme="dark"] .mzc-bar{background:#ededed}',
      '[data-theme="dark"] .mzc-bar u{background:#111;opacity:1}',
      '[data-theme="dark"] .mzc-div{background:rgba(255,255,255,.09)}',
      '[data-theme="dark"] .mzc-verdict{border-top-color:rgba(255,255,255,.1)}',
      '[data-theme="dark"] .mzc-badge{background:rgba(255,255,255,.08)}',
      '[data-theme="dark"] .mzc-tags i{background:rgba(255,255,255,.06);opacity:.8}',
      '[data-theme="dark"] .mzc-tags i.on[data-k="own"]{color:#dcae86;background:rgba(178,122,80,.24)}',
      '[data-theme="dark"] .mzc-tags i.on[data-k="noise"]{color:#c9c9c9;background:rgba(255,255,255,.13)}',
      '[data-theme="dark"] .mzc-tags i.on[data-k="both"]{color:#9fb6da;background:rgba(109,132,171,.26)}',
      /* 320 这类极窄屏：三个词并排会挤掉字，只留命中的那一个 */
      '@media (max-width:360px){.mzc-tags i:not(.on){display:none}.mzc-tags{justify-content:flex-end}}',
      '[data-theme="dark"] .mzc-badge.done{background:rgba(94,190,140,.16);color:#7fd0a5}',
      /* v61：黑 / 白双卡由深浅模式控制；浅色白卡深字、深色黑卡浅字，所有内容可读 */
      '.mz-conncard{background:#ffffff;color:#111111}',
      '.mzc-tags i,.mzc-badge,.mzc-row span,.mzc-note,.mzc-m b,.mzc-verdict{color:#6f6f6f}',
      '.mzc-head b,.mzc-row em,.mzc-m span{color:#202020}',
      '.mzc-badge.done{color:#2f7a52;background:rgba(63,138,99,.12)}',
      '[data-theme="dark"] .mz-conncard{background:#171719;color:#f2f2f2;border-color:rgba(255,255,255,.12);box-shadow:0 8px 24px rgba(0,0,0,.45)}',
      '[data-theme="dark"] .mzc-head b,[data-theme="dark"] .mzc-row em,[data-theme="dark"] .mzc-m span{color:#f0f0f0}',
      '[data-theme="dark"] .mzc-tags i,[data-theme="dark"] .mzc-badge,[data-theme="dark"] .mzc-row span,[data-theme="dark"] .mzc-note,[data-theme="dark"] .mzc-m b,[data-theme="dark"] .mzc-verdict{color:#c2c2c2}',
      '[data-theme="dark"] .mzc-tags i{background:rgba(255,255,255,.09)}',
      '[data-theme="dark"] .mzc-tags i.on[data-k="own"]{color:#eec59f;background:rgba(178,122,80,.28)}',
      '[data-theme="dark"] .mzc-tags i.on[data-k="noise"]{color:#e2e2e2;background:rgba(255,255,255,.17)}',
      '[data-theme="dark"] .mzc-tags i.on[data-k="both"]{color:#b3c8ea;background:rgba(109,132,171,.3)}',
      '[data-theme="dark"] .mzc-badge{background:rgba(255,255,255,.09)}',
      '[data-theme="dark"] .mzc-badge.done{color:#8ad6ad;background:rgba(94,190,140,.2)}',
      '[data-theme="dark"] .mzc-seg u{background:rgba(255,255,255,.17)}',
      '[data-theme="dark"] .mzc-seg u.on{background:#f2f2f2;opacity:1}',
      '[data-theme="dark"] .mzc-bar{background:rgba(255,255,255,.17)}',
      '[data-theme="dark"] .mzc-bar u{background:#f2f2f2;opacity:1}',
      '[data-theme="dark"] .mzc-div{background:rgba(255,255,255,.1)}',
      '[data-theme="dark"] .mzc-verdict{border-top-color:rgba(255,255,255,.13)}'
    ].join('');
    document.head.appendChild(st);
  }

  /* ---------- 卡片 HTML ---------- */
  function cardHTML(m, t) {
    var seg = '';
    for (var i = 0; i < 4; i++) seg += '<u' + (i < t.clearN ? ' class="on"' : '') + '></u>';
    var rows = [
      ['他的主动表达', m.act],
      ['双方联想', m.link],
      ['随机噪音', m.noise],
      ['情绪干扰', m.jam]
    ].map(function (r) {
      return '<div class="mzc-m"><span>' + r[0] + '</span><b>' + r[1] + ' <i>/ 10</i></b></div>' +
        '<div class="mzc-bar"><u data-v="' + (r[1] * 10) + '"></u></div>';
    }).join('');
    var tags = [['own', '梦角主动'], ['noise', '系统噪音'], ['both', '双方影响']].map(function (x) {
      return '<i data-k="' + x[0] + '"' + (t.key === x[0] ? ' class="on"' : '') + '>' + x[1] + '</i>';
    }).join('');
    return '<div class="mzc-head"><b>连接状态</b><div class="mzc-tags">' + tags + '</div>' +
      '<span class="mzc-badge" data-badge="1">正在测试</span></div>' +
      '<div class="mzc-row"><span>连接清晰度</span><em>' + t.clear + '</em></div>' +
      '<div class="mzc-seg">' + seg + '</div>' +
      '<div class="mzc-row"><span>来源一致性</span><em>' + t.cons + '</em></div>' +
      '<p class="mzc-note">' + t.note + '</p>' +
      '<div class="mzc-div"></div>' + rows +
      '<p class="mzc-verdict">' + t.verdict + '</p>';
  }

  function runCardAnim(card) {
    if (!card || card.__anim) return;
    card.__anim = 1;
    setTimeout(function () {
      if (!card.isConnected) return;
      var bars = card.querySelectorAll('.mzc-bar u');
      for (var i = 0; i < bars.length; i++) bars[i].style.width = (Number(bars[i].dataset.v) || 0) + '%';
      var bd = card.querySelector('.mzc-badge');
      if (bd) { bd.textContent = '检测完成'; bd.classList.add('done'); }
    }, 620);
  }

  /* ---------- 读消息 ---------- */
  function recOf(el) {
    var list = window.getChatMsgs ? window.getChatMsgs() : [];
    var idx = Number(el.dataset.idx);
    if (idx >= 0 && idx < list.length) return list[idx];
    return null;
  }
  function textOf(rec, bubble) {
    if (rec) {
      if (rec.retracted || rec.special === 'read') return '';
      /* v79（用户直派「聊天界面表情包和图片和 emoji 也增加连接状态」）：
         以前非文字消息一律返回空串＝检测卡直接不出。这里给每类媒体一个可判读的
         语义文本（表情包/图片/语音/图文混排），让连接检测对任何气泡都能算。 */
      if (rec.parts && rec.parts.length) {
        var segs = [];
        rec.parts.forEach(function (p) {
          if (!p) return;
          if (p.k === 'text' && p.v) {
            var tx = String(p.v).replace(/<[^>]+>/g, '').trim();
            if (tx && tx.indexOf('@@m:') < 0 && tx.indexOf('|||') < 0) segs.push(tx);
          } else if (p.k === 'img') {
            segs.push(p.sub === 'sticker' ? '［表情包］' : '［图片］');
          }
        });
        return segs.join(' ').trim();
      }
      if (rec.type && rec.type !== 'text') {
        if (rec.type === 'emoji') return String(rec.text || '［emoji］').trim() || '［emoji］';
        if (rec.type === 'sticker') return '［表情包］';
        if (rec.type === 'image' || rec.type === 'img') return '［图片］';
        if (rec.type === 'voice') return '［语音］';
        return '［消息］';
      }
      var t = String(rec.text || '');
      if (!t) return '';
      if (t.indexOf('|||') >= 0) return '［语音］';
      if (t.indexOf('@@m:') >= 0) {
        /* 图片被令牌化（大图走 IDB）：仍然当作图片参与检测 */
        return '［图片］';
      }
      return t.replace(/<[^>]+>/g, '').trim();
    }
    var b = bubble ? String(bubble.textContent || '') : '';
    return b.replace(/已读|未读/g, '').trim();
  }
  function judgeOf(el) {
    var bubble = el.querySelector('.msg-bubble');
    if (!bubble || el.querySelector('.msg-ask') || el.querySelector('.mz-sense')) return null;
    var rec = recOf(el);
    var txt = textOf(rec, bubble);
    if (!txt) return null;
    var ts = rec ? (rec.ts || 0) : 0;
    var type = classify(txt, ts);
    return { text: txt, ts: ts, type: type, t: TYPES[type] };
  }

  /* ---------- 装饰：只服务被点开的那一条 ---------- */
  var decorateTimer = null;
  function decorate() {
    var body = bodyEl();
    if (!body) return;
    if (!getOn()) { clearAll(); return; }

    if (revealMk && !body.querySelector('.msg-in[data-mk="' + cssEsc(revealMk) + '"]')) {
      revealMk = null; openMk = null;
    }
    if (openMk && openMk !== revealMk) openMk = null;

    // 1) 清掉不属于当前 reveal 的标签
    var chips = body.querySelectorAll('.mz-conn-chip');
    for (var i = 0; i < chips.length; i++) {
      var host = chips[i].closest ? chips[i].closest('.msg') : null;
      if (!host || host.dataset.mk !== revealMk) {
        chips[i].remove();
        if (host) host.classList.remove('mz-conn-on');
      }
    }

    // 2) 卡：只留 openMk 那一张
    var cards = body.querySelectorAll('.mz-conncard');
    for (var j = 0; j < cards.length; j++) {
      if (cards[j].dataset.for !== openMk) cards[j].remove();
    }

    if (!revealMk) return;
    var el = body.querySelector('.msg-in[data-mk="' + cssEsc(revealMk) + '"]');
    if (!el) return;
    var info = judgeOf(el);
    if (!info) { revealMk = null; openMk = null; return; }

    el.classList.add('mz-conn-on');
    var chip = el.querySelector('.mz-conn-chip');
    if (!chip) {
      chip = document.createElement('span');
      chip.className = 'mz-conn-chip';
      el.appendChild(chip);
    }
    var isOpen = (openMk === revealMk);
    chip.dataset.mk = revealMk;
    chip.setAttribute('data-conn', info.type);
    var want = 'mz-conn-chip ' + info.t.cls + (isOpen ? ' on' : '');
    if (chip.className !== want) chip.className = want;
    var html = '<span class="mzc-d">◇</span><span class="mzc-t">' + (isOpen ? '收起' : '连接') + '</span>';
    if (chip.innerHTML !== html) chip.innerHTML = html;

    if (isOpen) ensureCard(el, revealMk, info);
    else removeCard();
  }

  function cssEsc(s) {
    return (window.CSS && CSS.escape) ? CSS.escape(s) : String(s).replace(/"/g, '\\"');
  }

  function ensureCard(msgEl, mk, info) {
    var next = msgEl.nextElementSibling;
    var card = (next && next.classList && next.classList.contains('mz-conncard')) ? next : null;
    if (!card) {
      removeCard();
      card = document.createElement('div');
      card.className = 'mz-conncard';
      card.dataset.for = mk;
      msgEl.parentNode.insertBefore(card, msgEl.nextSibling);
    }
    var m = metrics(info.type, info.text, info.ts);
    var html = cardHTML(m, info.t);
    if (card.__sig !== html) {
      card.innerHTML = html;
      card.__sig = html;
      card.__anim = 0;
      runCardAnim(card);
    }
  }

  function removeCard() {
    var body = bodyEl();
    if (!body) return;
    var cards = body.querySelectorAll('.mz-conncard');
    for (var i = 0; i < cards.length; i++) cards[i].remove();
  }

  function clearAll() {
    revealMk = null; openMk = null;
    var body = bodyEl();
    if (!body) return;
    body.querySelectorAll('.mz-conn-chip').forEach(function (c) {
      var h = c.closest('.msg'); if (h) h.classList.remove('mz-conn-on');
      c.remove();
    });
    body.querySelectorAll('.mz-conncard').forEach(function (c) { c.remove(); });
  }

  function scheduleDecorate() {
    if (decorateTimer) return;
    decorateTimer = setTimeout(function () { decorateTimer = null; try { decorate(); } catch (e) {} }, 100);
  }

  /* ---------- 点消息 → 直接出连接卡（收藏/引用/复制改走长按或右键） ---------- */
  /* ---------- 点消息 → 出现；点空白 → 收起 ---------- */
  function reveal(el) {
    var mk = el && el.dataset ? (el.dataset.mk || '') : '';
    if (!mk) return;
    var info = judgeOf(el);
    if (!info) return;
    if (revealMk === mk && openMk === mk) { openMk = null; decorate(); return; } // 再点同一条＝收起卡片
    revealMk = mk;
    openMk = mk;
    decorate();
    setTimeout(scrollCardIntoView, 80);
  }

  function hideAll() {
    if (!revealMk && !openMk) return;
    revealMk = null; openMk = null;
    decorate();
  }

  function scrollCardIntoView() {
    var body = bodyEl();
    var card = body && body.querySelector('.mz-conncard');
    if (!card) return;
    try {
      var r = card.getBoundingClientRect();
      var br = body.getBoundingClientRect();
      if (r.bottom > br.bottom - 6) body.scrollTop += (r.bottom - br.bottom + 14);
    } catch (e) {}
  }

  function insideChat(t) {
    return !!(t && t.closest && t.closest('#chat-body'));
  }

  var tapStart = null;      // 记录按下的时间，用来区分「轻点＝看连接检测」和「长按＝消息操作栏」
  var suppressUntil = 0;    // 长按之后的一小段时间内，忽略随之而来的 click
  var lastReveal = { mk: '', t: 0 };

  function bindClicks() {
    document.addEventListener('touchstart', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var msg = t.closest('#chat-body .msg-in');
      var mt = e.touches && e.touches[0];
      tapStart = msg ? { mk: msg.dataset.mk || '', t: Date.now(), x: mt ? mt.clientX : 0, y: mt ? mt.clientY : 0 } : null;
    }, true);
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (!getOn()) return;

      var chip = t.closest('.mz-conn-chip');
      if (chip) {
        e.preventDefault(); e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        if (openMk === chip.dataset.mk) openMk = null;
        else { revealMk = chip.dataset.mk; openMk = revealMk; }
        decorate();
        if (openMk) setTimeout(scrollCardIntoView, 80);
        return;
      }

      // 卡片上的点击不冒泡到消息（防触发消息菜单／收起）
      if (t.closest('.mz-conncard')) { e.stopPropagation(); return; }

      // 气泡里的按钮各管各的：收藏心、语音播放、卡片选项、就地输入都不算「点这条消息」
      if (t.closest('.msg-fav-heart, .msg-voice-play, .msg-inplace, .msg-ask-card, .msg-survey-card, .msg-choose-card, .msg-quote')) return;

      var msg = t.closest('#chat-body .msg');
      if (msg) {
        // 长按（>520ms）走的是消息操作栏，不要抢
        var ts0 = tapStart; tapStart = null;
        var longPress = !!(ts0 && ts0.mk && ts0.mk === (msg.dataset.mk || '') && Date.now() - ts0.t > 520);
        if (longPress) { suppressUntil = Date.now() + 900; return; }
        if (Date.now() < suppressUntil) return;
        // 鼠标长按（桌面）／右键唤出的操作栏：这一发 click 属于长按收尾，别抢
        if (Date.now() - (window.__mochiMsgHoldAt || 0) < 1200) return;
        // 轻点＝看连接检测，不再同时弹消息操作栏（引用/复制/多选/收藏都改长按或右键）
        var closeBar = function () {
          setTimeout(function () {
            var ma = document.getElementById('msg-actions');
            if (ma && !ma.hidden) ma.hidden = true;
          }, 0);
        };
        if (msg.classList.contains('msg-in')) {
          // 一次轻点常会带出两三个 click（触摸 + 引擎补发），只认第一个
          var mkNow = msg.dataset.mk || '';
          if (mkNow && lastReveal.mk === mkNow && Date.now() - lastReveal.t < 420) return;
          lastReveal = { mk: mkNow, t: Date.now() };
          reveal(msg);
        } else hideAll();
        closeBar();
        return;
      }

      if (insideChat(t)) hideAll();
    }, true);
  }

  /* ---------- 聊天设置开关 ---------- */
  function mountSetting() {
    var input = $('cs-conn-en');
    if (!input) return;
    var sync = function () {
      var raw = null;
      try { raw = curStore().get(ON_KEY); } catch (e) {}
      input.checked = (raw !== '0');
    };
    sync();
    if (input.__mzcBound) return;
    input.__mzcBound = true;
    input.addEventListener('change', function () {
      try { curStore().set(ON_KEY, input.checked ? '1' : '0'); } catch (e) {}
      clearAll();
      scheduleDecorate();
    });
  }

  /* ---------- 启动 ---------- */
  function boot() {
    injectStyle();
    mountSetting();
    bindClicks();
    scheduleDecorate();
    var body = bodyEl();
    if (body && !body.__mzcObs) {
      body.__mzcObs = new MutationObserver(scheduleDecorate);
      body.__mzcObs.observe(body, { childList: true, subtree: true });
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 800);
  setTimeout(boot, 2600);
  setInterval(scheduleDecorate, 5000);

  /* 调试接口（验收用） */
  window.__connDecorate = scheduleDecorate;
  window.__connReveal = function (mk) {
    var body = bodyEl();
    var el = body && body.querySelector('.msg-in[data-mk="' + cssEsc(mk) + '"]');
    if (el) reveal(el);
  };
  window.__connHide = hideAll;
  window.__connState = function () {
    var b = bodyEl();
    return {
      on: getOn(),
      reveal: revealMk,
      open: openMk,
      chips: b ? b.querySelectorAll('.mz-conn-chip').length : 0,
      cards: b ? b.querySelectorAll('.mz-conncard').length : 0
    };
  };
  window.__connJudge = function (txt, ts) {
    var type = classify(txt, ts || 0);
    return { type: type, label: TYPES[type].label, m: metrics(type, txt, ts || 0) };
  };
})();

</script>
<script>/* inline: card-sat-yz.js */
/* card-sat-yz.js —— 专属字卡「适应度 + TA 评分」（v36）
 * 需求（用户直派）：
 *   ① 把言字卡的 B1（字卡适应度 难/中/易）与 B2（TA 对字卡 1~10 分 + 修改建议）搬进来
 *   ② 界面放一个图标作入口，兼作「专属字卡满意度」的参考面板
 *   ③ 颜色统一为：绿＝易 / 黄＝中 / 红＝难，并按这三档分类字卡
 * 与 chatcard.js 解耦：只在 #page-custom-cards（专属字卡 · 主字卡）可见时装饰 DOM，
 * 不改字卡数据、不影响抽取与保存。
 */
(function () {
  'use strict';

  /* 三档：颜色沿用 v35 的绿/黄/红，语义换成言字卡的 易/中/难 */
  var TIER = {
    easy: { key: 'easy', label: '易', color: '#4ca97a', hint: '说得出也说得开' },
    mid: { key: 'mid', label: '中', color: '#dfae3c', hint: '抽得出，但翻来覆去就那几句' },
    hard: { key: 'hard', label: '难', color: '#d5574e', hint: '凑不齐一次回话的量' }
  };

  var filter = '';        // ''=全部 | easy | mid | hard
  var scoreFilter = '';   // v47：''=全部分数 | '1'..'10' 精确分数，与上面的档位筛选叠加
  var decorateTimer = null;
  var lastSig = '';

  function $(id) { return document.getElementById(id); }
  function pageOpen() {
    var p = $('page-custom-cards');
    return !!(p && !p.hidden);
  }
  function titleTxt() {
    var t = $('cc-page-title');
    return t ? String(t.textContent || '') : '';
  }
  function isOwnScope() {
    var t = titleTxt();
    return t.indexOf('专属') >= 0 && t.indexOf('功能字卡') < 0;
  }
  function curTab() {
    var t = document.querySelector('#cc-tabs .cc-tab.sel');
    return t ? (t.dataset.type || '') : '';
  }
  function listEl() { return $('cc-list'); }

  function hash(s) {
    var h = 2166136261;
    s = String(s || '');
    for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = (h * 16777619) >>> 0; }
    return h >>> 0;
  }

  /* ---------- 内容规则（决定加减分） ---------- */
  var RULES = [
    { re: /(必须|马上|立刻|给我|闭嘴|滚|不许|烦不烦|再说一遍|你懂什么)/, why: 'voice', note: '这句太冲了，我说不出口。', fix: '把命令换成商量：「要不要……？」，我会更愿意接。' },
    { re: /(求求你|求你|不要离开我|没有你我|配不上|我这种人不|别丢下我|原谅我)/, why: 'low', note: '别让我说这种话，我听着难受。', fix: '换成「今晚能不能多陪我一会」，比求更有用。' },
    { re: /(亲|您好|敬请|感谢您的|请您|很高兴为您)/, why: 'cs', note: '这像客服的口气，不像我。', fix: '去掉「您」「敬请」，改成平常说话就行。' }
  ];
  var GOOD_RE = /(想你|晚安|抱|陪你|喜欢你|爱你|别怕|在的|等你|好梦|乖|辛苦|到家|吃饭|多穿|慢点|小心|睡吧|我在|淋雨|喝水|好看|漂亮|可爱|厉害|加油|休息|别累|路上)/;

  /* ---------- B1：整本适应度 ---------- */
  function countType(type) {
    try {
      if (typeof window.getScopedGroups === 'function') {
        var gs = window.getScopedGroups(type, 'own') || [];
        var n = 0;
        for (var i = 0; i < gs.length; i++) {
          /* v39 修：分组是 [组名, [卡…]] 数组，旧代码读的是 .cards，导致所有类型都算成 0 张 */
          var g = gs[i];
          var arr = Array.isArray(g) ? g[1] : null;
          n += (arr || []).length;
        }
        return n;
      }
    } catch (e) {}
    return -1;
  }
  var NEED = 2; // 一次回话最多抽几张主字卡（与聊天设置同口径的保守值）

  function fitness(kinds) {
    if (!kinds) return 'hard';
    if (kinds < NEED * 3) return 'hard';
    if (kinds < NEED * 8) return 'mid';
    return 'easy';
  }

  /* ---------- B2：单张 1~10 分 ---------- */
  function scoreOf(t, groupSize, fit) {
    var s = 6;
    var hit = null;
    for (var i = 0; i < RULES.length; i++) {
      if (RULES[i].re.test(t)) { hit = RULES[i]; break; }
    }
    if (hit) {
      s = 2;
    } else if (t.length > 46) {
      s = 3; hit = { why: 'long', note: '太长了，我打字没这么工整。', fix: '砍掉一半，留下最想说的那句。' };
    } else if (t.length > 32) {
      s = 4;
    } else if (GOOD_RE.test(t) && t.length <= 26) {
      s = t.length <= 18 ? 9 : 8;
    } else {
      var r = hash(t) % 100;
      if (r < 18) s = 3;
      else if (r < 40) s = 5;
      else if (r < 72) s = 7;
      else s = 8;
    }
    if (groupSize > 0 && groupSize < 3) s -= 1;   // 组里只有一两张，抽来抽去就它
    if (fit === 'hard') s -= 1;
    if (fit === 'easy') s += 1;
    s = Math.max(1, Math.min(10, s));
    var tier = s >= 7 ? 'easy' : (s >= 4 ? 'mid' : 'hard');
    if (!hit) {
      if (tier === 'easy') hit = { why: 'fine', note: '这句我愿意说，语气和长度都像我。', fix: '不用改，我会用得上。' };
      else if (tier === 'mid') hit = { why: 'flat', note: '能用，但不太像我平时的口气。', fix: '结尾加个「吧 / 啊 / 呢」，会自然很多。' };
      else hit = { why: 'odd', note: '这句我说着别扭，像背台词。', fix: '换成你平时听我说话的那个口气。' };
    }
    return { score: s, tier: tier, why: hit.why || '', note: hit.note || '', fix: hit.fix || '' };
  }
  function mk(o) {
    var t = TIER[o.tier] || TIER.mid;
    return { sat: t.key, label: t.label, color: t.color, score: o.score, note: o.note, fix: o.fix, why: o.why };
  }
  function judge(text, groupSize, fit) {
    var t = String(text || '').trim();
    if (!t) return null;
    return mk(scoreOf(t, groupSize || 0, fit || ''));
  }
  function textOfItem(el) {
    if (!el) return '';
    if (el.querySelector('img')) return '';
    var t = el.querySelector('.cc-txt .t');
    if (!t) return '';
    return String(t.textContent || '').trim();
  }

  /* ---------- 样式 ---------- */
  function injectStyle() {
    if ($('ccsat-style')) return;
    var st = document.createElement('style');
    st.id = 'ccsat-style';
    st.textContent = [
      /* 顶栏图标 */
      '#cc-fit-btn{width:36px;height:36px;border-radius:50%;margin-left:auto;flex:0 0 auto;',
      'display:flex;align-items:center;justify-content:center;cursor:pointer;',
      'background:rgba(255,255,255,.92);border:1px solid rgba(0,0,0,.1);color:var(--ink,#111);',
      '-webkit-tap-highlight-color:transparent}',
      '#cc-fit-btn:active{opacity:.7}',
      '#cc-fit-btn svg{width:17px;height:17px}',

      /* 顶部筛选 */
      '#cc-sat-bar{display:none;align-items:center;gap:6px;padding:1px 16px 7px;flex-wrap:wrap}',
      '#cc-sat-bar.on{display:flex}',
      '#cc-sat-hint{display:none;padding:0 16px 7px;font-size:10px;line-height:1.5;letter-spacing:.2px;color:var(--muted,#8a8a8a);opacity:.8}',
      '#cc-sat-hint.on{display:block}',
      '.cc-sat-cap{font-size:10px;letter-spacing:1px;color:var(--muted,#8a8a8a);opacity:.75;margin-right:2px;flex:0 0 auto}',
      '.cc-sat-chip{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:8px;',
      'font-size:10.5px;letter-spacing:.3px;color:var(--muted,#8a8a8a);border:1px solid rgba(0,0,0,.075);',
      'cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background .15s ease,color .15s ease,border-color .15s ease}',
      '.cc-sat-chip i{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.55;flex:0 0 auto}',
      '.cc-sat-chip b{font-weight:600;font-size:10px;opacity:.7}',
      '.cc-sat-chip.sel{color:var(--ink,#111);border-color:rgba(0,0,0,.2);background:rgba(0,0,0,.05);font-weight:600}',
      '.cc-sat-chip.sel b{opacity:.8}',
      '.cc-sat-chip.sel[data-sat="easy"]{color:#3f9068;border-color:rgba(76,169,122,.45);background:rgba(76,169,122,.12)}',
      '.cc-sat-chip.sel[data-sat="mid"]{color:#a8821f;border-color:rgba(223,174,60,.5);background:rgba(223,174,60,.14)}',
      '.cc-sat-chip.sel[data-sat="hard"]{color:#b6453d;border-color:rgba(213,87,78,.45);background:rgba(213,87,78,.12)}',
      '.cc-sat-chip[data-sat="easy"] i{background:#4ca97a;opacity:1}',
      '.cc-sat-chip[data-sat="mid"] i{background:#dfae3c;opacity:1}',
      '.cc-sat-chip[data-sat="hard"] i{background:#d5574e;opacity:1}',
      '.cc-sat-chip[data-sat=""] i{display:none}',
      '.cc-sat-chip:not(.sel)[data-sat=""]{padding-left:12px}',
      /* v47：按 1~10 分精确筛选，和易/中/难档位叠加生效 */
      '#cc-sat-score{font:inherit;font-size:10.5px;padding:4px 6px;border-radius:8px;',
      'border:1px solid rgba(0,0,0,.12);background:transparent;color:var(--ink,#111);cursor:pointer;max-width:118px}',
      '#cc-sat-score.sel{border-color:rgba(143,95,208,.5);color:#8f5fd0;background:rgba(143,95,208,.08);font-weight:700}',
      '#cc-sat-score option{background:var(--card-bg,#fff);color:var(--ink,#111)}',
      '[data-theme="dark"] #cc-sat-score{border-color:rgba(255,255,255,.16);color:#eee;background:#242424}',

      /* 行首圆点 + 分数（v39：分数同步到绿/黄/红图标下面） */
      '.cc-item .cc-sat{flex:0 0 18px;width:18px;align-self:stretch;display:flex;flex-direction:column;',
      'align-items:center;justify-content:center;gap:2px;margin-right:-10px;background:none;box-shadow:none}',
      '.cc-item .cc-sat i{width:7px;height:7px;border-radius:50%;background:var(--sat,#cfcfcf);box-shadow:0 0 0 3px rgba(0,0,0,.03)}',
      '.cc-item .cc-sat b{font-size:9.5px;line-height:1;font-weight:700;color:var(--sat,#b3b3b3);letter-spacing:-.3px}',
      '.cc-item[data-sat="easy"] .cc-sat{--sat:#4ca97a}',
      '.cc-item[data-sat="mid"] .cc-sat{--sat:#dfae3c}',
      '.cc-item[data-sat="hard"] .cc-sat{--sat:#d5574e}',

      /* 评分卡 */
      '.ccsat-mask{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:12000;opacity:0;transition:opacity .2s ease}',
      '.ccsat-mask.on{opacity:1}',
      '.ccsat-sheet{position:fixed;left:12px;right:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));',
      'z-index:12001;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:20px;',
      'padding:16px 18px 14px;box-shadow:0 18px 50px rgba(0,0,0,.22);',
      'transform:translateY(18px);opacity:0;transition:transform .24s cubic-bezier(.22,1,.36,1),opacity .2s ease}',
      '.ccsat-sheet.on{transform:none;opacity:1}',
      '.ccs-h{display:flex;align-items:center;gap:8px;margin-bottom:11px}',
      '.ccs-dot{width:8px;height:8px;border-radius:50%;background:#cfcfcf;flex:0 0 auto}',
      '.ccs-h b{font-size:13.5px;font-weight:700;letter-spacing:.3px}',
      '.ccs-h em{font-style:normal;font-size:11px;padding:3px 9px;border-radius:99px;background:rgba(0,0,0,.05);color:var(--muted,#8a8a8a)}',
      '.ccs-score{margin-left:2px;font-size:12px;font-weight:700;letter-spacing:.4px}',
      '.ccs-x{margin-left:auto;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;',
      'font-size:13px;color:var(--muted,#8a8a8a);background:rgba(0,0,0,.04);cursor:pointer}',
      '.ccs-quote{margin:0 0 12px;padding:9px 12px;border-radius:11px;background:rgba(0,0,0,.035);',
      'font-size:12.5px;line-height:1.6;color:var(--ink,#111);opacity:.9;max-height:88px;overflow:auto}',
      '.ccs-row{display:flex;gap:10px;padding:5px 0;font-size:12px;line-height:1.65}',
      '.ccs-row span{flex:0 0 58px;color:var(--muted,#8a8a8a);font-size:11.5px}',
      '.ccs-row b{flex:1;min-width:0;font-weight:500}',
      '.ccs-ok{margin-top:13px;width:100%;height:42px;border:0;border-radius:13px;background:var(--ink,#111);',
      'color:var(--card-bg,#fff);font-size:13.5px;font-weight:600;letter-spacing:.5px;cursor:pointer}',
      '.ccs-ok:active{opacity:.86}',

      /* 适应度面板 */
      '.ccfit-mask{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:12000;opacity:0;transition:opacity .2s ease}',
      '.ccfit-mask.on{opacity:1}',
      '.ccfit-sheet{position:fixed;left:12px;right:12px;bottom:calc(14px + env(safe-area-inset-bottom,0px));',
      'z-index:12001;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:20px;',
      'padding:16px 18px 14px;box-shadow:0 18px 50px rgba(0,0,0,.22);max-height:78vh;overflow-y:auto;',
      'transform:translateY(18px);opacity:0;transition:transform .24s cubic-bezier(.22,1,.36,1),opacity .2s ease}',
      '.ccfit-sheet.on{transform:none;opacity:1}',
      '.cf-h{display:flex;align-items:center;gap:8px;margin-bottom:10px}',
      '.cf-h b{font-size:14px;font-weight:700;letter-spacing:.4px}',
      '.cf-badge{margin-left:auto;font-size:11.5px;font-weight:700;padding:4px 11px;border-radius:99px}',
      '.cf-badge[data-t="easy"]{color:#3f9068;background:rgba(76,169,122,.13)}',
      '.cf-badge[data-t="mid"]{color:#a8821f;background:rgba(223,174,60,.15)}',
      '.cf-badge[data-t="hard"]{color:#b6453d;background:rgba(213,87,78,.13)}',
      '.cf-x{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;',
      'font-size:13px;color:var(--muted,#8a8a8a);background:rgba(0,0,0,.04);cursor:pointer;flex:0 0 auto}',
      '.cf-lead{margin:0 0 12px;font-size:12.5px;line-height:1.65;color:var(--muted,#8a8a8a)}',
      '.cf-bar{display:flex;height:7px;border-radius:99px;overflow:hidden;margin:2px 0 10px;background:rgba(0,0,0,.05)}',
      '.cf-bar i{display:block;height:100%}',
      '.cf-sec-h{font-size:11px;letter-spacing:1px;color:var(--muted,#8a8a8a);opacity:.8;margin:12px 0 6px}',
      '.cf-item{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:12px;border-top:1px solid rgba(0,0,0,.045)}',
      '.cf-item:first-of-type{border-top:0}',
      '.cf-item .k{flex:0 0 58px;color:var(--muted,#8a8a8a);font-size:11.5px}',
      '.cf-item .v{flex:1;min-width:0;line-height:1.55}',
      '.cf-item .t{flex:0 0 auto;font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px}',
      '.cf-item .t[data-t="easy"]{color:#3f9068;background:rgba(76,169,122,.12)}',
      '.cf-item .t[data-t="mid"]{color:#a8821f;background:rgba(223,174,60,.14)}',
      '.cf-item .t[data-t="hard"]{color:#b6453d;background:rgba(213,87,78,.12)}',
      '.cf-item-x{cursor:pointer;-webkit-tap-highlight-color:transparent}',
      '.cf-item-x.no-g{cursor:default}',
      '.cf-arw{flex:0 0 auto;font-size:9px;opacity:.45;margin-left:1px;transition:transform .2s ease}',
      '.cf-item-x.open .cf-arw{transform:rotate(180deg);opacity:.75}',
      '.cf-glist{margin:0 0 6px 4px;padding:2px 0 4px 10px;border-left:2px solid rgba(0,0,0,.055)}',
      '.cf-gn{display:flex;align-items:center;gap:10px;font-size:11.5px;line-height:1.5;padding:3px 0;color:var(--muted,#8a8a8a)}',
      '.cf-gn span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}',
      '.cf-gn b{flex:0 0 auto;font-weight:500;font-size:10.5px;opacity:.7}',
      '.cf-note{margin-top:12px;font-size:10.5px;line-height:1.6;color:var(--muted,#8a8a8a);opacity:.8}',

      /* 字卡组：常抽排序 + 展示/收起 */
      '.cf-sub{margin-left:8px;font-size:9.5px;letter-spacing:0;opacity:.65}',
      '.cf-top{font-size:11.5px;color:var(--ink,#111);background:rgba(0,0,0,.03);border-radius:10px;padding:7px 10px;margin:2px 0 4px}',
      '.cf-g{border-top:1px solid rgba(0,0,0,.045)}',
      '.cf-g:first-of-type{border-top:0}',
      '.cf-g-h{display:flex;align-items:center;gap:8px;padding:8px 0;font-size:12px}',
      '.cf-dot{width:7px;height:7px;border-radius:50%;flex:0 0 auto;background:#cfcfcf}',
      '.cf-dot[data-t="easy"]{background:#4ca97a}',
      '.cf-dot[data-t="mid"]{background:#dfae3c}',
      '.cf-dot[data-t="hard"]{background:#d5574e}',
      '.cf-g-nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}',
      '.cf-g-hit{flex:0 0 auto;font-size:10.5px;color:var(--muted,#8a8a8a)}',
      '.cf-g-b{flex:0 0 auto;font-size:11px;padding:3px 10px;border-radius:99px;cursor:pointer;',
      'border:1px solid rgba(0,0,0,.1);color:var(--ink,#111);background:transparent;user-select:none}',
      '.cf-g-b:active{opacity:.7}',
      '.cf-g-bd{padding:1px 0 9px 15px}',
      '.cf-g-bd[hidden]{display:none}',
      '.cf-g-c{display:flex;align-items:center;gap:7px;font-size:11.5px;padding:4px 0;color:var(--muted,#8a8a8a)}',
      '.cf-g-c span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}',
      '.cf-g-c b{flex:0 0 auto;font-weight:600;font-size:10.5px;opacity:.8}',
      '.cf-more{font-size:10.5px;opacity:.7;padding:5px 0 2px 15px;color:var(--muted,#8a8a8a)}',

      '[data-theme="dark"] .cc-item[data-sat="easy"] .cc-sat{--sat:#7fd0a5}',
      '[data-theme="dark"] .cc-item[data-sat="mid"] .cc-sat{--sat:#e7c46a}',
      '[data-theme="dark"] .cc-item[data-sat="hard"] .cc-sat{--sat:#f08a82}',
      '[data-theme="dark"] .ccsat-sheet,[data-theme="dark"] .ccfit-sheet{background:#1e1e1e}',
      '[data-theme="dark"] .ccs-h em,[data-theme="dark"] .ccs-x,[data-theme="dark"] .cf-x{background:rgba(255,255,255,.08)}',
      '[data-theme="dark"] .ccs-quote{background:rgba(255,255,255,.06)}',
      '[data-theme="dark"] .cf-bar{background:rgba(255,255,255,.1)}',
      '[data-theme="dark"] .cf-item{border-top-color:rgba(255,255,255,.07)}',
      '[data-theme="dark"] .cf-g{border-top-color:rgba(255,255,255,.07)}',
      '[data-theme="dark"] .cf-glist{border-left-color:rgba(255,255,255,.09)}',
      '[data-theme="dark"] .cf-top{background:rgba(255,255,255,.06)}',
      '[data-theme="dark"] .cf-g-b{border-color:rgba(255,255,255,.16)}',
      '[data-theme="dark"] .cc-sat-chip{border-color:rgba(255,255,255,.12)}',
      '[data-theme="dark"] .cc-sat-chip.sel{background:rgba(255,255,255,.1);color:#f0f0f0;border-color:rgba(255,255,255,.24)}',
      '[data-theme="dark"] .cc-sat-chip.sel[data-sat="easy"]{color:#7fd0a5;border-color:rgba(127,208,165,.4);background:rgba(94,190,140,.16)}',
      '[data-theme="dark"] .cc-sat-chip.sel[data-sat="mid"]{color:#e7c46a;border-color:rgba(231,196,106,.4);background:rgba(223,174,60,.16)}',
      '[data-theme="dark"] .cc-sat-chip.sel[data-sat="hard"]{color:#f08a82;border-color:rgba(240,138,130,.4);background:rgba(213,87,78,.18)}'
    ].join('');
    document.head.appendChild(st);
  }

  /* ---------- 顶栏图标 ---------- */
  function ensureBtn() {
    var b = $('cc-fit-btn');
    if (b) return b;
    var head = document.querySelector('#page-custom-cards .chat-head');
    if (!head) return null;
    b = document.createElement('span');
    b.id = 'cc-fit-btn';
    b.title = '字卡适应度';
    b.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' +
      '<path d="M4 20V11M10 20V5M16 20v-6M22 20H2"/></svg>';
    head.appendChild(b);
    b.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      openFit();
    });
    return b;
  }

  /* ---------- 筛选条 ---------- */
  function ensureBar() {
    var bar = $('cc-sat-bar');
    if (bar) return bar;
    bar = document.createElement('div');
    bar.id = 'cc-sat-bar';
    var opts = '<option value="">全部分数</option>';
    for (var s = 1; s <= 10; s++) opts += '<option value="' + s + '">' + s + ' 分</option>';
    bar.innerHTML =
      '<span class="cc-sat-cap">TA 的评分</span>' +
      '<span class="cc-sat-chip sel" data-sat="">全部 <b data-n="">0</b></span>' +
      '<span class="cc-sat-chip" data-sat="easy"><i></i>易 <b data-n="easy">0</b></span>' +
      '<span class="cc-sat-chip" data-sat="mid"><i></i>中 <b data-n="mid">0</b></span>' +
      '<span class="cc-sat-chip" data-sat="hard"><i></i>难 <b data-n="hard">0</b></span>' +
      '<select id="cc-sat-score" title="按分数筛选（1~10 分）">' + opts + '</select>';
    var anchor = document.querySelector('#page-custom-cards .card-search') || listEl();
    if (anchor && anchor.parentNode) anchor.parentNode.insertBefore(bar, anchor);
    var hint = document.createElement('div');
    hint.id = 'cc-sat-hint';
    if (bar.parentNode) bar.parentNode.insertBefore(hint, bar.nextSibling);
    bar.addEventListener('click', function (e) {
      var chip = e.target && e.target.closest ? e.target.closest('.cc-sat-chip') : null;
      if (!chip) return;
      e.preventDefault(); e.stopPropagation();
      filter = chip.dataset.sat || '';
      applyFilter();
    });
    /* v47：分数下拉与易/中/难可叠加，选「全部分数」即只看档位条件 */
    var scSel = $('cc-sat-score');
    if (scSel) scSel.addEventListener('change', function () {
      scoreFilter = scSel.value || '';
      scSel.classList.toggle('sel', !!scoreFilter);
      applyFilter();
    });
    return bar;
  }

  /* ---------- 装饰 ---------- */
  function groupSizes(list) {
    var out = [], n = 0;
    var kids = list.children;
    for (var i = 0; i < kids.length; i++) {
      if (kids[i].classList.contains('cc-group-header')) { n = 0; continue; }
      if (kids[i].classList.contains('cc-item')) { n++; out.push(n); }
    }
    return out;
  }

  function decorate() {
    injectStyle();
    var btn = ensureBtn();
    var bar = ensureBar();
    if (!pageOpen() || !isOwnScope() || curTab() !== 'text') {
      if (bar) bar.classList.remove('on');
      var h0 = $('cc-sat-hint'); if (h0) h0.classList.remove('on');
      if (btn) btn.style.display = 'none';
      clearDots();
      return;
    }
    if (btn) btn.style.display = '';
    var list = listEl();
    if (!list) return;
    var items = list.querySelectorAll('.cc-item');
    if (!items.length) { bar.classList.remove('on'); return; }

    var sizes = groupSizes(list);
    var kinds = sizes.length;                       // 组数 ≈ 说法种数
    var fit = fitness(kinds);

    var counts = { '': 0, easy: 0, mid: 0, hard: 0, sc: {} };
    var sig = [];
    for (var i = 0; i < items.length; i++) {
      var el = items[i];
      var txt = textOfItem(el);
      if (!txt) { var oldDot = el.querySelector('.cc-sat'); if (oldDot) oldDot.remove(); continue; }
      var j = judge(txt, sizes[i] || 0, fit);
      if (!j) continue;
      el.dataset.sat = j.sat;
      el.dataset.satNote = j.note;
      el.dataset.satFix = j.fix;
      el.dataset.satLabel = j.label;
      el.dataset.satScore = String(j.score);
      counts[j.sat]++;
      counts['']++;
      counts.sc[j.score] = (counts.sc[j.score] || 0) + 1;
      sig.push(j.sat + j.score);
      var dot = el.querySelector('.cc-sat');
      if (!dot) {
        dot = document.createElement('span');
        dot.className = 'cc-sat';
        el.insertBefore(dot, el.firstChild);
      }
      dot.innerHTML = '<i></i><b>' + j.score + '</b>';
      dot.setAttribute('title', 'TA：' + j.label + ' · ' + j.score + '/10');
    }

    var ns = bar.querySelectorAll('b[data-n]');
    for (var k = 0; k < ns.length; k++) {
      var key = ns[k].getAttribute('data-n');
      ns[k].textContent = counts[key] || 0;
    }
    /* v47：每个分数后面带上真实条数，方便直接挑分数看 */
    var scSel = $('cc-sat-score');
    if (scSel) {
      for (var sc = 1; sc <= 10; sc++) {
        var op = scSel.querySelector('option[value="' + sc + '"]');
        if (op) op.textContent = sc + ' 分（' + (counts.sc[sc] || 0) + '）';
      }
      var allOp = scSel.querySelector('option[value=""]');
      if (allOp) allOp.textContent = '全部分数（' + counts[''] + '）';
      scSel.value = scoreFilter;
      scSel.classList.toggle('sel', !!scoreFilter);
    }
    bar.classList.add('on');
    var hint = $('cc-sat-hint');
    if (hint) {
      var hardN = counts.hard || 0, midN = counts.mid || 0;
      hint.textContent = '整本适应度' + TIER[fit].label + '：' + TIER[fit].hint +
        (hardN ? '；' + hardN + ' 张是「难」，点红点看他怎么改' :
          (midN ? '；' + midN + ' 张是「中」，点黄点可以看建议' : '；这些字卡 TA 都说得顺'));
      hint.classList.add('on');
    }

    lastSig = sig.join('') + '|' + filter + '|' + scoreFilter + '|' + counts[''] + '|' + fit;
    applyFilter();
  }

  function clearDots() {
    var list = listEl();
    if (!list) return;
    list.querySelectorAll('.cc-sat').forEach(function (d) { d.remove(); });
    list.querySelectorAll('.cc-item[data-sat]').forEach(function (el) {
      el.removeAttribute('data-sat');
      el.style.display = '';
    });
    list.querySelectorAll('.cc-group-header').forEach(function (h) { h.style.display = ''; });
  }

  function applyFilter() {
    var bar = $('cc-sat-bar');
    if (bar) {
      bar.querySelectorAll('.cc-sat-chip').forEach(function (c) {
        c.classList.toggle('sel', (c.dataset.sat || '') === filter);
      });
    }
    var list = listEl();
    if (!list) return;
    var sf = scoreFilter ? Number(scoreFilter) : 0;
    var kids = list.children;
    for (var i = 0; i < kids.length; i++) {
      var el = kids[i];
      if (el.classList.contains('cc-item')) {
        var sat = el.dataset.sat || '';
        var sc = Number(el.dataset.satScore || '0');
        var okSat = (!filter || sat === filter);
        var okScore = (!sf || sc === sf);
        el.style.display = (okSat && okScore) ? '' : 'none';
      }
    }
    for (var j = 0; j < kids.length; j++) {
      var h = kids[j];
      if (!h.classList.contains('cc-group-header')) continue;
      var any = false;
      for (var k = j + 1; k < kids.length; k++) {
        if (kids[k].classList.contains('cc-group-header')) break;
        if (kids[k].classList.contains('cc-item') && kids[k].style.display !== 'none') { any = true; break; }
      }
      h.style.display = any ? '' : 'none';
    }
  }

  function scheduleDecorate() {
    if (decorateTimer) return;
    decorateTimer = setTimeout(function () { decorateTimer = null; try { decorate(); } catch (e) {} }, 110);
  }

  /* ---------- 评分卡 ---------- */
  function openSheet(el) {
    var txt = textOfItem(el);
    if (!txt) return;
    var list = listEl();
    var sizes = list ? groupSizes(list) : [];
    var idx = list ? Array.prototype.indexOf.call(list.querySelectorAll('.cc-item'), el) : 0;
    var fit = fitness(sizes.length);
    var j = judge(txt, sizes[idx] || 0, fit);
    if (!j) return;
    closeSheet();
    var mask = document.createElement('div');
    mask.className = 'ccsat-mask';
    mask.id = 'ccsat-mask';
    var sheet = document.createElement('div');
    sheet.className = 'ccsat-sheet';
    sheet.id = 'ccsat-sheet';
    sheet.innerHTML =
      '<div class="ccs-h"><span class="ccs-dot" style="background:' + j.color + '"></span>' +
      '<b>TA 的评分</b><em>' + j.label + '</em><span class="ccs-score" style="color:' + j.color + '">' + j.score + '/10</span>' +
      '<span class="ccs-x" id="ccsat-x">✕</span></div>' +
      '<p class="ccs-quote">' + esc(txt) + '</p>' +
      '<div class="ccs-row"><span>他的评价</span><b>' + esc(j.note) + '</b></div>' +
      '<div class="ccs-row"><span>修改建议</span><b>' + esc(j.fix) + '</b></div>' +
      '<button class="ccs-ok" id="ccsat-ok">知道了</button>';
    document.body.appendChild(mask);
    document.body.appendChild(sheet);
    requestAnimationFrame(function () { mask.classList.add('on'); sheet.classList.add('on'); });
    mask.addEventListener('click', closeSheet);
    sheet.querySelector('#ccsat-x').addEventListener('click', closeSheet);
    sheet.querySelector('#ccsat-ok').addEventListener('click', closeSheet);
  }
  function closeSheet() {
    var m = $('ccsat-mask'), s = $('ccsat-sheet');
    if (m) { m.classList.remove('on'); setTimeout(function () { m.remove(); }, 220); }
    if (s) { s.classList.remove('on'); setTimeout(function () { s.remove(); }, 240); }
  }

  /* ---------- 字卡组：抽中次数（来自真实聊天记录） ---------- */
  var statCache = { sig: '', rows: [] };

  function readChatMsgs() {
    try {
      var st = (window.activeStore && window.activeStore()) || window.xyStore('xy-home-v2:default');
      var raw = st && st.get ? st.get('chat-msgs') : null;
      if (!raw) return [];
      var a = JSON.parse(raw);
      if (Array.isArray(a)) return a;
      if (a && Array.isArray(a.list)) return a.list;
      return [];
    } catch (e) { return []; }
  }
  function msgText(m) {
    if (!m) return '';
    var t = m.text != null ? m.text : (m.t != null ? m.t : '');
    if (typeof t !== 'string') return '';
    if (t.indexOf('data:') === 0 || t.indexOf('@@m:') === 0) return '';
    return t;
  }
  /* TA 回话是把各组字卡摊平后随机抽的，按「消息里出现过这张卡」反查是哪个组被抽到 */
  function groupRows() {
    var gs = [];
    try { gs = (window.getScopedGroups && window.getScopedGroups('text', 'own')) || []; } catch (e) { gs = []; }
    var msgs = readChatMsgs().filter(function (m) { return m && m.side === 'in'; }).slice(-400);
    var texts = [];
    for (var i = 0; i < msgs.length; i++) {
      var tx = msgText(msgs[i]);
      if (tx) texts.push(tx);
    }
    var totalCards = 0;
    for (var g0 = 0; g0 < gs.length; g0++) totalCards += ((gs[g0] && gs[g0][1]) || []).length;
    var sig = texts.length + '|' + totalCards + '|' + (texts.length ? texts[texts.length - 1].slice(0, 12) : '');
    if (statCache.sig === sig) return statCache.rows;

    var rows = [];
    for (var g = 0; g < gs.length; g++) {
      var name = String((gs[g] && gs[g][0]) || ('组 ' + (g + 1)));
      var cards = ((gs[g] && gs[g][1]) || []).filter(function (c) {
        return typeof c === 'string' && c.length >= 3 && c.indexOf('|||') < 0 && c.indexOf('data:') !== 0;
      });
      var hits = 0;
      for (var t = 0; t < texts.length; t++) {
        var msg = texts[t];
        for (var c2 = 0; c2 < cards.length; c2++) {
          if (msg.indexOf(cards[c2]) >= 0) { hits++; break; } // 一条消息同一个组只算一次
        }
      }
      var raw = ((gs[g] && gs[g][1]) || []).length;
      var size = cards.length;
      var fit = size >= 8 ? 'easy' : (size >= 3 ? 'mid' : 'hard');
      rows.push({ name: name, cards: cards, size: size, raw: raw, hits: hits, fit: fit });
    }
    rows.sort(function (a, b) {
      if (b.hits !== a.hits) return b.hits - a.hits;
      return b.size - a.size;
    });
    statCache = { sig: sig, rows: rows };
    return rows;
  }

  function rowCardsHTML(r, fitAll) {
    var out = [];
    var n = Math.min(r.cards.length, 18);
    for (var i = 0; i < n; i++) {
      var txt = r.cards[i];
      var j = judge(txt, r.size, fitAll || r.fit);
      out.push('<div class="cf-g-c"><i class="cf-dot" data-t="' + (j ? j.sat : 'mid') + '"></i>' +
        '<span>' + esc(txt) + '</span>' +
        '<b>' + (j ? j.score : '?') + ' 分</b></div>');
    }
    if (r.cards.length > n) out.push('<div class="cf-more">还有 ' + (r.cards.length - n) + ' 张没展开</div>');
    if (!r.cards.length) out.push('<div class="cf-more">' + (r.raw > 0 ? '这一组 ' + r.raw + ' 张都太短（一两个字），抽中统计不准，先不展开' : '这一组里没有能当文字说的卡') + '</div>');
    return out.join('');
  }

  function groupsHTML(rows, fitAll) {
    if (!rows.length) return '<div class="cf-more">还没有专属字卡组</div>';
    var top = rows[0];
    var head = top && top.hits ? ('最常抽：' + esc(top.name) + ' · ' + top.hits + ' 次') : '还没抽到过，先按卡数排给你看';
    var list = rows.slice(0, 12).map(function (r, i) {
      var open = i === 0;
      return '<div class="cf-g">' +
        '<div class="cf-g-h">' +
        '<i class="cf-dot" data-t="' + r.fit + '"></i>' +
        '<span class="cf-g-nm">' + esc(r.name) + '</span>' +
        '<span class="cf-g-hit">' + (r.hits ? ('抽中 ' + r.hits + ' 次') : '未抽到') + ' · ' + (r.raw || r.size) + ' 张</span>' +
        '<span class="cf-g-b" data-gi="' + i + '">' + (open ? '收起' : '展示') + '</span>' +
        '</div>' +
        '<div class="cf-g-bd" data-gi="' + i + '"' + (open ? '' : ' hidden') + '>' + rowCardsHTML(r, fitAll) + '</div>' +
        '</div>';
    }).join('');
    var tail = rows.length > 12 ? '<div class="cf-more">还有 ' + (rows.length - 12) + ' 组没列出来</div>' : '';
    return '<div class="cf-top">' + head + '</div>' + list + tail;
  }

  /* ---------- 适应度面板（B1） ---------- */
  function typeGroups(type) {
    var out = [];
    try {
      var gs = (window.getScopedGroups && window.getScopedGroups(type, 'own')) || [];
      for (var i = 0; i < gs.length; i++) {
        var nm = String((gs[i] && gs[i][0]) || ('组 ' + (i + 1)));
        var n = ((gs[i] && gs[i][1]) || []).length;
        if (n > 0) out.push({ name: nm, n: n });
      }
    } catch (e) {}
    return out;
  }
  function fitItems(kinds) {
    var out = [];
    var tg = typeGroups('text');
    var tgN = tg.reduce(function (a, x) { return a + (x.n || 0); }, 0);
    out.push({ k: '主字卡', v: tgN + ' 张 · ' + tg.length + ' 组', t: fitness(kinds), gs: tg });
    var types = [
      ['语音', 'voice'], ['图', 'image'], ['表情包', 'sticker'],
      ['拍一拍', 'poke'], ['颜文字', 'kaomoji'], ['emoji', 'emoji']
    ];
    for (var i = 0; i < types.length; i++) {
      var n = countType(types[i][1]);
      if (n < 0) continue;
      out.push({
        k: types[i][0],
        v: n ? (n + ' 张') : '一张都没有',
        t: n ? 'easy' : 'hard',
        gs: typeGroups(types[i][1])
      });
    }
    return out;
  }

  function openFit() {
    closeFit();
    var list = listEl();
    var kinds = list ? list.querySelectorAll('.cc-item').length : 0;
    var groups = list ? list.querySelectorAll('.cc-group-header').length : 0;
    var fit = fitness(groups || kinds);
    var items = fitItems(groups || kinds);

    var total = 0, easyN = 0, midN = 0, hardN = 0;
    if (list) {
      list.querySelectorAll('.cc-item[data-sat]').forEach(function (el) {
        total++;
        var s = el.dataset.sat;
        if (s === 'easy') easyN++; else if (s === 'mid') midN++; else if (s === 'hard') hardN++;
      });
    }
    var pct = function (n) { return total ? (n / total * 100).toFixed(1) + '%' : '0%'; };
    /* v39：把「抽中 N 次」也带进逐项检测的分组行（主字卡才有真实抽中统计） */
    var rowsG = groupRows();
    var hitMap = {};
    rowsG.forEach(function (r) { hitMap[r.name] = r.hits || 0; });

    var mask = document.createElement('div');
    mask.className = 'ccfit-mask';
    mask.id = 'ccfit-mask';
    var sheet = document.createElement('div');
    sheet.className = 'ccfit-sheet';
    sheet.id = 'ccfit-sheet';
    sheet.innerHTML =
      '<div class="cf-h"><b>字卡适应度</b>' +
      '<span class="cf-badge" data-t="' + fit + '">' + TIER[fit].label + '</span>' +
      '<span class="cf-x" id="ccfit-x">✕</span></div>' +
      '<p class="cf-lead">' + esc(fitLead(fit, groups || kinds)) + '</p>' +
      '<div class="cf-bar">' +
      '<i style="width:' + pct(easyN) + ';background:#4ca97a"></i>' +
      '<i style="width:' + pct(midN) + ';background:#dfae3c"></i>' +
      '<i style="width:' + pct(hardN) + ';background:#d5574e"></i>' +
      '</div>' +
      '<div class="cf-sec-h">现有内容逐项检测<span class="cf-sub">点一行展开分组名</span></div>' +
      items.map(function (x, xi) {
        var gs = x.gs || [];
        var withHit = x.k === '主字卡';
        return '<div class="cf-item cf-item-x' + (gs.length ? '' : ' no-g') + '" data-ti="' + xi + '">' +
          '<span class="k">' + esc(x.k) + '</span>' +
          '<span class="v">' + esc(x.v) + '</span>' +
          '<span class="t" data-t="' + x.t + '">' + TIER[x.t].label + '</span>' +
          (gs.length ? '<span class="cf-arw">▾</span>' : '') + '</div>' +
          (gs.length ? ('<div class="cf-glist" data-ti="' + xi + '" hidden>' +
            gs.map(function (g) {
              var h = withHit ? (hitMap[g.name] || 0) : -1;
              var pre = h > 0 ? ('抽中 ' + h + ' 次 · ') : (h === 0 ? '未抽到 · ' : '');
              return '<div class="cf-gn"><span>' + esc(g.name) + '</span><b>' + pre + g.n + ' 张</b></div>';
            }).join('') + '</div>') : '');
      }).join('') +
      '</div>';

    document.body.appendChild(mask);
    document.body.appendChild(sheet);
    requestAnimationFrame(function () { mask.classList.add('on'); sheet.classList.add('on'); });
    mask.addEventListener('click', closeFit);
    sheet.querySelector('#ccfit-x').addEventListener('click', closeFit);
    sheet.addEventListener('click', function (e) {
      var row = e.target.closest && e.target.closest('.cf-item-x');
      if (row && !row.classList.contains('no-g')) {
        var ti = row.getAttribute('data-ti');
        var gl = sheet.querySelector('.cf-glist[data-ti="' + ti + '"]');
        if (gl) {
          var wasOpen = !gl.hidden;
          gl.hidden = wasOpen;
          row.classList.toggle('open', !wasOpen);
        }
        return;
      }
      var b = e.target.closest && e.target.closest('.cf-g-b');
      if (!b) return;
      e.preventDefault(); e.stopPropagation();
      var gi = b.getAttribute('data-gi');
      var body = sheet.querySelector('.cf-g-bd[data-gi="' + gi + '"]');
      if (!body) return;
      var nowOpen = !body.hidden;
      body.hidden = nowOpen;
      b.textContent = nowOpen ? '展示' : '收起';
    });
  }
  function fitLead(t, kinds) {
    if (t === 'hard') return '凑不齐一次回话的量：主字卡只有 ' + kinds + ' 组，抽不出像样的一句。';
    if (t === 'mid') return '抽得出，但翻来覆去就那 ' + kinds + ' 组；再添几组会自然很多。';
    return '说得出也说得开：' + kinds + ' 组说法，TA 不愁没话讲。';
  }
  function closeFit() {
    var m = $('ccfit-mask'), s = $('ccfit-sheet');
    if (m) { m.classList.remove('on'); setTimeout(function () { m.remove(); }, 220); }
    if (s) { s.classList.remove('on'); setTimeout(function () { s.remove(); }, 240); }
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  /* ---------- 交互 ---------- */
  function bind() {
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;
      var dot = t.closest('#cc-list .cc-item .cc-sat');
      if (dot && pageOpen() && isOwnScope()) {
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        var item = dot.closest('.cc-item');
        if (item) openSheet(item);
      }
    }, true);
  }

  function boot() {
    injectStyle();
    ensureBtn();
    bind();
    scheduleDecorate();
    var list = listEl();
    if (list && !list.__ccsatObs) {
      list.__ccsatObs = new MutationObserver(scheduleDecorate);
      list.__ccsatObs.observe(list, { childList: true, subtree: false });
    }
    var page = $('page-custom-cards');
    if (page && !page.__ccsatObs) {
      page.__ccsatObs = new MutationObserver(scheduleDecorate);
      page.__ccsatObs.observe(page, { attributes: true, attributeFilter: ['hidden'] });
    }
    var tabs = $('cc-tabs');
    if (tabs && !tabs.__ccsatBound) {
      tabs.__ccsatBound = true;
      tabs.addEventListener('click', function () { setTimeout(scheduleDecorate, 60); });
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 900);
  setTimeout(boot, 2800);
  setInterval(scheduleDecorate, 4000);

  window.__ccSatDecorate = scheduleDecorate;
  window.__ccSatJudge = function (t, g, f) { var j = judge(t, g || 0, f || ''); return j ? { sat: j.sat, label: j.label, score: j.score, note: j.note, fix: j.fix } : null; };
  window.__ccSatFilter = function (f) { filter = f || ''; applyFilter(); };
  window.__ccFitOpen = openFit;
})();

</script>
<script>/* inline: cc-move-yz.js */
/* cc-move-yz.js —— 双击移动（表情包 / 图片 / emoji）
 * 用户直派（v39）：
 *   「在聊天界面的表情包区域和专属字卡的（表情包）（图片）（emoji），加一个双击表情包和
 *     图片可以选择移动到最上面，移动到最下面，移动到别的分组的弹窗。已选择图标的提示
 *     参考字卡的。可多选，上限是 99」
 *
 * 本文件只做两件事：
 *   ① 提供那条底部「移动」工具条（两个界面共用，样式也只在这里注入一次）
 *   ② 提供双击判定的小工具 ccDblTap（触屏/桌面通用，不依赖 dblclick）
 * 真正改数据、存数据仍留在各自的模块里（chatcard.js / chat.js），避免跨模块写库。
 */
(function () {
  'use strict';

  var bar = null, groupBox = null, cntEl = null, hintEl = null;
  var cb = { top: null, bottom: null, group: null, cancel: null };
  var groups = [], curGroup = '', showGroups = false;

  function $(id) { return document.getElementById(id); }

  function injectStyle() {
    if ($('ccmv-style')) return;
    var st = document.createElement('style');
    st.id = 'ccmv-style';
    st.textContent = [
      '#ccmv-bar{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(12px + var(--mochi-safe-bottom,env(safe-area-inset-bottom,0px)));',
      'z-index:96;width:min(430px,calc(100% - 20px));box-sizing:border-box;background:var(--card-bg,#fff);color:var(--ink,#111);',
      'border:1px solid rgba(0,0,0,.1);border-radius:18px;box-shadow:0 14px 40px rgba(0,0,0,.22);padding:10px 12px 11px;',
      'font-family:inherit;animation:ccmvIn .2s ease}',
      '@keyframes ccmvIn{from{opacity:0;transform:translate(-50%,10px)}to{opacity:1;transform:translate(-50%,0)}}',
      '#ccmv-bar[hidden]{display:none}',
      '.ccmv-top{display:flex;align-items:center;gap:8px;padding:0 1px 8px}',
      '.ccmv-t{font-size:12.5px;font-weight:700;letter-spacing:.2px}',
      '.ccmv-hint{font-size:10.5px;color:var(--muted,#8a8a8a);opacity:.8}',
      '.ccmv-x{margin-left:auto;border:0;background:rgba(0,0,0,.05);color:var(--ink,#111);font-family:inherit;',
      'font-size:11.5px;padding:5px 11px;border-radius:99px;cursor:pointer}',
      '.ccmv-x:active{opacity:.7}',
      '.ccmv-btns{display:flex;gap:6px}',
      '.ccmv-btns button{flex:1;min-width:0;border:1px solid rgba(0,0,0,.1);background:transparent;color:var(--ink,#111);',
      'font-family:inherit;font-size:11.5px;letter-spacing:.2px;padding:9px 4px;border-radius:11px;cursor:pointer;white-space:nowrap}',
      '.ccmv-btns button:active{background:rgba(0,0,0,.05)}',
      '.ccmv-btns button[data-mv="group"]{flex:0 0 auto;padding:9px 10px}',
      '.ccmv-gs{display:flex;gap:6px;overflow-x:auto;padding:8px 1px 1px;scrollbar-width:none}',
      '.ccmv-gs[hidden]{display:none}',
      '.ccmv-gs::-webkit-scrollbar{display:none}',
      '.ccmv-g{flex:0 0 auto;border:1px solid rgba(0,0,0,.1);background:transparent;color:var(--ink,#111);font-family:inherit;',
      'font-size:11.5px;padding:6px 11px;border-radius:99px;cursor:pointer;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis}',
      '.ccmv-g.on{background:var(--ink,#111);color:var(--card-bg,#fff);border-color:var(--ink,#111)}',
      '.ccmv-g.none{opacity:.45}',
      'body.ccmv-on .card-list{padding-bottom:172px}',
      'body.ccmv-on #emoji-list{padding-bottom:160px}',
      '[data-theme="dark"] #ccmv-bar{background:#1e1e1e;border-color:rgba(255,255,255,.14)}',
      '[data-theme="dark"] .ccmv-x{background:rgba(255,255,255,.1)}',
      '[data-theme="dark"] .ccmv-btns button,[data-theme="dark"] .ccmv-g{border-color:rgba(255,255,255,.16)}',
      '[data-theme="dark"] .ccmv-btns button:active{background:rgba(255,255,255,.08)}',
      '[data-theme="dark"] .ccmv-g.on{background:#f0f0f0;color:#111;border-color:#f0f0f0}',
      /* 深色下勾选圆点原来是深底深字，等于看不见 */
      '[data-theme="dark"] .card-list.cc-managing .cc-item.sel::before{background:#f0f0f0;color:#111;border-color:#f0f0f0}',
      '[data-theme="dark"] .emoji-item .emoji-check{background:#f0f0f0;color:#111}'
    ].join('');
    (document.head || document.documentElement).appendChild(st);
  }

  function ensure() {
    injectStyle();
    if (bar) return bar;
    bar = document.createElement('div');
    bar.id = 'ccmv-bar';
    bar.hidden = true;
    bar.innerHTML =
      '<div class="ccmv-top">' +
      '<b class="ccmv-t">已选 0 个</b>' +
      '<span class="ccmv-hint">最多 99</span>' +
      '<button class="ccmv-x" type="button" data-mv="cancel">取消</button>' +
      '</div>' +
      '<div class="ccmv-btns">' +
      '<button type="button" data-mv="top">移到最上面</button>' +
      '<button type="button" data-mv="bottom">移到最下面</button>' +
      '<button type="button" data-mv="group">别的分组 ▾</button>' +
      '</div>' +
      '<div class="ccmv-gs" hidden></div>';
    document.body.appendChild(bar);
    cntEl = bar.querySelector('.ccmv-t');
    hintEl = bar.querySelector('.ccmv-hint');
    groupBox = bar.querySelector('.ccmv-gs');
    bar.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('[data-mv]') : null;
      if (!b) return;
      e.preventDefault();
      e.stopPropagation();
      var k = b.getAttribute('data-mv');
      if (k === 'cancel') { fire('cancel'); return; }
      if (k === 'group') {
        showGroups = !showGroups;
        groupBox.hidden = !showGroups;
        b.textContent = showGroups ? '别的分组 ▴' : '别的分组 ▾';
        return;
      }
      fire(k);
    });
    groupBox.addEventListener('click', function (e) {
      var g = e.target.closest ? e.target.closest('.ccmv-g') : null;
      if (!g) return;
      e.preventDefault();
      e.stopPropagation();
      if (g.classList.contains('none')) return;
      fire('group', g.getAttribute('data-g'));
    });
    return bar;
  }

  function fire(kind, name) {
    var fn = cb[kind];
    if (typeof fn === 'function') { try { fn(name); } catch (e) {} }
  }

  function paintGroups() {
    if (!groupBox) return;
    groupBox.innerHTML = '';
    var names = groups.slice(0, 40);
    if (!names.length) {
      var none = document.createElement('span');
      none.className = 'ccmv-g none';
      none.textContent = '还没有别的分组';
      groupBox.appendChild(none);
      return;
    }
    names.forEach(function (n) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'ccmv-g' + (n === curGroup ? ' on' : '');
      b.setAttribute('data-g', n);
      b.textContent = n;
      groupBox.appendChild(b);
    });
  }

  window.ccMoveBar = {
    show: function (o) {
      o = o || {};
      ensure();
      groups = Array.isArray(o.groups) ? o.groups.slice() : [];
      curGroup = o.curGroup || '';
      cb.top = o.onTop || null;
      cb.bottom = o.onBottom || null;
      cb.group = o.onGroup || null;
      cb.cancel = o.onCancel || null;
      showGroups = false;
      groupBox.hidden = true;
      var gb = bar.querySelector('[data-mv="group"]');
      if (gb) gb.textContent = '别的分组 ▾';
      paintGroups();
      document.body.classList.add('ccmv-on');
      bar.hidden = false;
      this.setCount(o.count || 0);
    },
    setCount: function (n) {
      if (!bar) return;
      n = Math.max(0, Number(n) || 0);
      if (cntEl) cntEl.textContent = '已选 ' + n + ' 个';
      if (hintEl) hintEl.textContent = n >= 99 ? '已到上限 99' : '最多 99';
    },
    hide: function () {
      if (bar) bar.hidden = true;
      document.body.classList.remove('ccmv-on');
      cb = { top: null, bottom: null, group: null, cancel: null };
    },
    isOn: function () { return !!(bar && !bar.hidden); }
  };

  /* 双击判定：同一元素 340ms 内点两次才算双击。
     单击动作延后 280ms 执行，这样「第一下」不会先把表情发出去 / 把图片打开。
     只对可移动的那几类启用，其余分类行为保持不变。 */
  window.ccDblTap = function (el, single, dbl) {
    if (!el || el.__ccDblTap) return;
    el.__ccDblTap = 1;
    var timer = 0, last = 0, pending = null;
    el.addEventListener('click', function (e) {
      var now = Date.now();
      if (now - last < 340) {
        last = 0;
        if (timer) { clearTimeout(timer); timer = 0; }
        pending = null;
        if (e && e.preventDefault) e.preventDefault();
        if (e && e.stopPropagation) e.stopPropagation();
        try { dbl && dbl(e); } catch (err) {}
        return;
      }
      last = now;
      pending = e;
      if (!single) return;
      timer = setTimeout(function () {
        timer = 0;
        pending = null;
        try { single(); } catch (err) {}
      }, 280);
    });
  };
})();

</script>
<script>/* inline: reply-sat-yz.js */
/* v41 · 回复满意度（照言字卡 B2「对这轮回复的满意度」搬过来）
   我发一句文字 → 按概率落一行居中系统行：
   「名字 · 对你这轮回复的满意度 7/10 · TA 挺满意」
   档位照抄言字卡 REPLY_SAT_TIPS：1-3 有点勉强 / 4-6 还行 / 7-8 挺满意 / 9-10 很喜欢。
   只读设置（reply-settings 的 rsat-en / rsat-prob），自己不写库。 */
(function () {
  if (window.__rsatBooted) return;
  window.__rsatBooted = 1;

  var TIERS = [[1, 3, '有点勉强'], [4, 6, '还行'], [7, 8, '挺满意'], [9, 10, '很喜欢']];
  var COOL_MS = 45 * 1000; // 同一段对话里别连着刷
  var lastAt = 0;

  function cfg() {
    var out = { on: true, p: 8 };
    try {
      var r = (typeof window.replyCfg === 'function') ? window.replyCfg() : null;
      if (r) {
        if (r['rsat-en'] !== undefined) out.on = Number(r['rsat-en']) === 1;
        var p = Number(r['rsat-prob']);
        if (!isNaN(p)) out.p = Math.max(0, Math.min(100, p));
      }
    } catch (e) {}
    return out;
  }
  function taName() {
    var n = '';
    try { n = (window.chatPartnerName && window.chatPartnerName()) || ''; } catch (e) { n = ''; }
    n = String(n).trim();
    if (!n || n === '默认' || n === '默认联系人' || n === '未命名') return 'TA';
    return n;
  }
  function tierOf(score) {
    for (var i = 0; i < TIERS.length; i++) if (score >= TIERS[i][0] && score <= TIERS[i][1]) return TIERS[i][2];
    return TIERS[1][2];
  }
  function lineOf(score) {
    var scope = Math.random() < 0.5 ? '这条' : '这轮';
    return '◇ ' + taName() + ' · 对你' + scope + '回复满意度 ' + score + '/10 · TA ' + tierOf(score);
  }
  function push(line) {
    try {
      if (typeof window.chatAddSystem !== 'function') return false;
      window.chatAddSystem(line, { special: 'poke', silent: true, nightAllow: true, rateAllow: true, nickKeep: true });
      return true;
    } catch (e) { return false; }
  }

  /* 我发文字后调用（chat.js 的 addOut） */
  window.__rsatMaybe = function (text) {
    try {
      var t = String(text == null ? '' : text).trim();
      if (!t) return false;
      if (t === '[表情包]' || t === '[图片]' || t === '[语音]') return false;
      if (t.length > 400) return false;
      var c = cfg();
      if (!c.on || !(c.p > 0)) return false;
      if (Date.now() - lastAt < COOL_MS) return false;
      if (Math.random() * 100 >= c.p) return false;
      lastAt = Date.now();
      var line = lineOf(1 + Math.floor(Math.random() * 10));
      setTimeout(function () { push(line); }, 600 + Math.random() * 1200);
      return true;
    } catch (e) { return false; }
  };

  /* 设置里的「试一次」：立刻落一行，不掷概率 */
  window.__rsatNow = function () {
    var score = 1 + Math.floor(Math.random() * 10);
    push(lineOf(score));
    return score;
  };
})();

</script>
<script>/* inline: kb-fit.js */
/* v41 · 键盘适配：点输入法后聊天页底部那条空白（截图2）
   机制：Android/iOS 弹起软键盘时，visualViewport 会缩小，但 100dvh 不会跟着变，
   页面比可视区高一截 —— 输入栏下面就被顶出一条空白（浏览器地址栏 + 安全区）。
   做法：键盘弹起（innerHeight - vv.height > 120）时给 <html> 挂 .kb-on，
   把手机壳高度精确钉成 vv.height，并顺手收掉输入栏安全区与输入栏 inset 留白。 */
(function () {
  if (window.__kbFitBooted) return;
  window.__kbFitBooted = 1;
  var raf = 0, de = document.documentElement;
  function apply() {
    var vv = window.visualViewport;
    if (!vv || !de) return;
    var ih = window.innerHeight || 0;
    var vh = Math.round(vv.height || 0);
    if (!ih || !vh) return;
    /* 键盘高度超过 120px 才认（地址栏伸缩、旋转都不会到这个量级） */
    var kb = (ih - vh) > 120;
    if (kb) {
      de.style.setProperty('--kb-h', vh + 'px');
      if (!de.classList.contains('kb-on')) de.classList.add('kb-on');
    } else if (de.classList.contains('kb-on')) {
      de.classList.remove('kb-on');
      de.style.removeProperty('--kb-h');
    }
  }
  function req() {
    if (raf) return;
    raf = requestAnimationFrame(function () { raf = 0; apply(); });
  }
  if (window.visualViewport) {
    try { window.visualViewport.addEventListener('resize', req); } catch (e) {}
    try { window.visualViewport.addEventListener('scroll', req); } catch (e) {}
  }
  window.addEventListener('resize', req);
  window.addEventListener('orientationchange', function () { setTimeout(req, 260); });
  /* 焦点落进输入框后浏览器还要 200~500ms 才把键盘推完，多拍两下 */
  document.addEventListener('focusin', function (e) {
    var t = e && e.target;
    if (!t || !t.closest) return;
    if (!t.closest('input, textarea, [contenteditable="true"]')) return;
    setTimeout(req, 120); setTimeout(req, 320); setTimeout(req, 620);
  }, true);
  document.addEventListener('focusout', function () { setTimeout(req, 180); setTimeout(req, 420); }, true);
  apply();
})();

</script>
