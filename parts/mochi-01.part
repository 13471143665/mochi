const nextSel = (window.CSS && CSS.escape) ? CSS.escape(String(grpNames[nextIdx] || '')) : '';
const anchor = nextIdx < grpNames.length
? list.querySelector('.cc-group-header[data-g="' + nextSel + '"]')
: null;
