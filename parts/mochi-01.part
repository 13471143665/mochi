segMax = 4;
try {
((window.getDefaultCardGroups && window.getDefaultCardGroups('dict')) || []).forEach(g => {
if (!g || typeof g[0] !== 'string' || g[0].indexOf('词库') !== 0) return;
(g[1] || []).forEach(wd => {
