else if (window.chatIsBracketedKaomojiCard ? window.chatIsBracketedKaomojiCard(card) : (/[\(（｡◕(◕)(づ｡(¬)]/.test(card) && /[\)）】)]/.test(card))) kaomoji.push(card); // FIX #1152 默认字卡兜底同判据
else text.push(card);
});
});
}
