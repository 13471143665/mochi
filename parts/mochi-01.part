function icMode() {
let k = 0;
try {
const raw = store.get(IC_FREQ_KEY);
if (raw !== null && raw !== undefined && raw !== '') {
const v = Number(raw);
if (v >= 0 && v < IC_MODES.length) k = v;
}
} catch (e) {}
