const finishMeta = () => {
if (settled) return;
settled = true;
if (metaTimer) clearTimeout(metaTimer);
cleanupTmp();
next();
};
tmp.onloadedmetadata = function () {
const m = findTrack(id);
if (m && tmp.duration) { m.duration = tmp.duration; }
finishMeta();
};
tmp.onerror = function () {
