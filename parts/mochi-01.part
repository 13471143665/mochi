srcs.forEach(s => { total += s.w; });
if (total <= 0) return srcs[Math.floor(Math.random() * srcs.length)].pool;
let r = Math.random() * total;
for (let i = 0; i < srcs.length; i++) { r -= srcs[i].w; if (r < 0) return srcs[i].pool; }
