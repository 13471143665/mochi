const list = [];
pl.tracks.forEach(s => {
if (!s || !s.id) return;
list.push({
neteaseId: String(s.id),
name: s.name || '',
artist: ((s.ar || []).map(a => a.name).filter(Boolean).join('/')),
cover: String((s.al && s.al.picUrl) || '').replace(/^http:\/\//i, 'https://'),
url: neteaseMetingUrl(s.id),
duration: s.dt ? Math.round(s.dt / 1000) : 0,
fee: s.fee
});
});
