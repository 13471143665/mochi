recentSaveAt(key, ids);
}
function textRecentResolved() {
const ids = recentIdentsAt(textRecentKey());
const srcs = [];
if (ids.length) {
const want = {};
ids.forEach((x, i) => { want[x] = i; });
const found = [];
const scan = (arr) => {
(arr || []).forEach(t => {
if (typeof t !== 'string' || !t) return;
const oi = want[t];
