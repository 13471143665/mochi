toast('已设置：捎话内容＝' + rpThxLabel(n));
}, () => ({ noInput: true, pill: String(rpThxGet().mode), pills: [{ label: '系统预设话术', value: '0' }, { label: '像正常聊天一样回复', value: '1' }, { label: '混合', value: '2' }] }));
