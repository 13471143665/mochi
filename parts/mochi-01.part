const out = toks.slice(0, gi).join('') + fill + rest.filter((_, k) => k !== wi).join('');
return out !== str ? out : null;
}
const sep = mode === 'comma' ? '，' : ' ';
const out = toks.slice(0, gi).join('') + sep + toks.slice(gi).join('');
