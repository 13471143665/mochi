emojiList.addEventListener('click', function (e) {
if (!emojiMv.on) return;
var d = e.target && e.target.closest ? e.target.closest('.emoji-item') : null;
if (!d) return;
e.preventDefault();
e.stopPropagation();
if (e.stopImmediatePropagation) e.stopImmediatePropagation();
var k = emojiMvKey(d.dataset.g, d.dataset.i);
if (emojiMv.sel.has(k)) emojiMv.sel.delete(k);
else {
if (emojiMv.sel.size >= 99) { toast('一次最多移动 99 个'); return; }
emojiMv.sel.add(k);
}
emojiMvPaint();
}, true);
}
