const side = '<div class="msg-side"><div class="msg-av"></div>' + timeHtml + '</div>';
if (kind === 'card') {
const label = FAV_KIND_LABEL[f.special] || '互动卡片';
let html = '<div class="fav-item-card">' +
'<span class="fav-item-tag">互动卡片 · ' + label + '</span>' +
'<div class="fav-item-q">' + (f.special === 'invite' ? (window.taFit ? window.taFit('邀请TA') : '邀请TA') + ' · ' : '') + escTxt(f.q || '') + '</div>';
if (f.special === 'ask-survey' && Array.isArray(f.qarr) && f.qarr.length) {
const aarr = Array.isArray(f.aarr) ? f.aarr : [];
html += '<div style="text-align:left;display:flex;flex-direction:column;gap:8px;margin-top:2px">' + f.qarr.map((x, i) => {
let r = '<div><div style="font-size:12px;font-weight:600;color:var(--ink);line-height:1.5;word-break:break-word">' + (i + 1) + '. ' + escTxt((x && x.t) || '') + '</div>';
if (x && Array.isArray(x.o) && x.o.length) r += '<div style="font-size:11px;color:var(--muted);margin-top:2px;word-break:break-word">选项：' + escTxt(x.o.join(' / ')) + '</div>';
if (aarr[i]) r += '<div class="fav-item-a" style="margin-top:2px;word-break:break-word">TA：' + escTxt(aarr[i]) + '</div>';
return r + '</div>';
}).join('') + '</div>';
} else {
if (f.mine) html += '<div class="fav-item-a">✓ 我：' + escTxt(f.mine) + '</div>';
if (f.ta) html += '<div class="fav-item-r">' + (window.taFit ? window.taFit('TA：') : 'TA：') + escTxt(window.taFit ? window.taFit(askCardReplyClean(f.ta)) : askCardReplyClean(f.ta)) + '</div>';
/* v55：只有问答类卡片才需要「等待回应」；猜拳/拍一拍等通用卡片没有回应位，别误报 */
if (!f.mine && !f.ta && { 'ask-choose': 1, 'ask-curious': 1, 'ask-roast': 1, 'ask-card': 1, 'invite': 1, 'ask': 1 }[f.special]) html += '<div class="fav-item-tip">等待回应…</div>';
}
html += '</div>';
row.innerHTML = html + side;
fillAvatar(row.querySelector('.msg-av'), 'cs-avatar-user');
} else if (kind === 'mail') {
const tag = f.mailType === 'received' ? '信箱来信' : '信箱回信';
let html = '<div class="fav-item-card"><span class="fav-item-tag">' + tag + (f.title ? ' · 《' + escTxt(f.title) + '》' : '') + '</span>' +
'<div class="fav-item-body">' + favTextHtml(f.text) + '</div></div>';
row.innerHTML = html + '<div class="msg-side">' + timeHtml + '</div>';
} else if (kind === 'feed') {
const imgs = (f.imgs && f.imgs.length) ? f.imgs : [];
let html = '<div class="fav-item-card">' +
'<span class="fav-item-tag">朋友圈动态</span>' +
(f.text ? '<div class="fav-item-body">' + favTextHtml(f.text) + '</div>' : '') +
(imgs.length ? '<div class="fav-item-imgs">' + imgs.map(u => favLazyImg(u, '', '图片')).join('') + '</div>' : '') +
'</div>';
row.innerHTML = html + side;
fillAvatar(row.querySelector('.msg-av'), 'cs-avatar-user');
} else {
row.innerHTML = f.side === 'out'
? '<div class="msg-bubble"></div>' + side
: side + '<div class="msg-bubble"></div>';
const b = row.querySelector('.msg-bubble');
if (f.parts && f.parts.length && f.parts.some(p => p && (p.k === 'img' || p.k === 'text'))) {
const imgs = f.parts.filter(p => p && p.k === 'img' && p.v);
const textPart = f.parts.filter(p => p && p.k === 'text').map(p => p.v).join(' ');
let inner = '';
if (imgs.length) {
inner += '<div class="msg-parts-imgs' + (imgs.length > 1 ? ' multi' : '') + '">' +
imgs.map(p => {
const isSticker = p.sub === 'sticker';
return favLazyImg(p.v, 'msg-img' + (isSticker ? ' msg-img-sm' : ' msg-img-big'), isSticker ? '表情' : '图片');
}).join('') + '</div>';
}
if (textPart) inner += '<span style="opacity:.85;word-break:break-word">' + (window.mochiInlineTextHtml ? window.mochiInlineTextHtml(textPart) : escTxtBr(textPart)) + '</span>';
b.innerHTML = inner || '<span style="opacity:.6">（图片）</span>';
b.querySelectorAll('.msg-img-big').forEach(img => {
img.addEventListener('click', (e) => {
e.stopPropagation();
if (window.viewChatImage && img.src && img.src.indexOf('data:') === 0) window.viewChatImage(img.src);
});
});
} else {
const looksVoice = typeof f.text === 'string' &&
(f.text.indexOf('|||') >= 0 && (chatIsDataAudioSrc(f.text.split('|||')[1] || '') || /@@m:[0-9a-f]{32}$/.test(f.text))) || chatIsDataAudioSrc(f.text);
const isVoice = looksVoice || f.type === 'voice';
const isImg = !isVoice && (f.type === 'sticker' || f.type === 'image' || (typeof f.text === 'string' && f.text.indexOf('data:') === 0) || (window.mochiMediaIsToken && window.mochiMediaIsToken(f.text)));
if (isVoice && f.text) {
b.style.padding = '8px 10px';
fillVoiceBubble(b, f.text);
} else if (isImg && f.text) {
b.style.padding = '6px';
b.innerHTML = favLazyImg(f.text, 'msg-img' + (f.type === 'sticker' ? ' msg-img-sm' : ''), f.type === 'sticker' ? '表情' : '图片');
const _im = b.querySelector('img');
if (_im) _im.addEventListener('click', (e) => {
e.stopPropagation();
if (window.viewChatImage && _im.src && _im.src.indexOf('data:') === 0) window.viewChatImage(_im.src);
});
} else if (f.text) {
b.innerHTML = '<span style="opacity:.85">' + (window.mochiInlineTextHtml ? window.mochiInlineTextHtml(f.text) : escTxtBr(f.text)) + '</span>';
} else {
b.innerHTML = '<span style="opacity:.6">（图片）</span>';
}
}
if (f.mood && f.mood.length) {
f.mood.forEach(md => {
const dupFav = md.label != null && String(md.label) !== '' && String(md.label) === String(f.text == null ? '' : f.text);
if (md.tag === '交流意图') {
b.innerHTML += '<div class="msg-mood msg-intent"><span class="msg-mood-tag">' + md.tag + '</span>' + (dupFav ? '' : '<span>' + md.label + '</span>') + '</div>';
} else {
b.innerHTML += '<div class="msg-mood"><span class="msg-mood-tag">' + md.tag + '</span>' + (dupFav ? '' : '<span>' + md.label + '</span>') + '</div>';
}
});
}
fillAvatar(row.querySelector('.msg-av'), f.side === 'out' ? 'cs-avatar-user' : 'cs-avatar-partner');
}
wrap.appendChild(row);
function matchFav(x) {
return (x.kind || 'msg') === kind &&
(x.q || '') === (f.q || '') && (x.text || '') === (f.text || '') && x.ts === f.ts;
}
try { wrap.setAttribute('data-favkey', favItemKey(f)); } catch (eFK) {}
if (!favBatch) {
const noteTxt = String(f.note || '');
const reasonTxt = String(f.reason || '');
if (reasonTxt || noteTxt) {
const box = document.createElement('div');
box.className = 'fav-item-notes';
if (reasonTxt) {
const rEl = document.createElement('div');
rEl.className = 'fav-item-reason';
rEl.textContent = (window.taFit ? window.taFit(chatPartnerName() + '：') : 'TA：') + reasonTxt;
box.appendChild(rEl);
}
if (noteTxt) {
const nEl = document.createElement('div');
nEl.className = 'fav-item-note';
nEl.textContent = '备注：' + noteTxt;
box.appendChild(nEl);
}
const btn = document.createElement('button');
btn.className = 'fav-item-notebtn';
btn.type = 'button';
btn.textContent = noteTxt ? '编辑备注' : '＋ 写备注';
btn.addEventListener('click', (e) => { e.stopPropagation(); favNoteEdit(f); });
box.appendChild(btn);
wrap.appendChild(box);
} else {
const box = document.createElement('div');
box.className = 'fav-item-notes bare';
const btn = document.createElement('button');
btn.className = 'fav-item-notebtn';
btn.type = 'button';
btn.textContent = '＋ 写备注';
btn.addEventListener('click', (e) => { e.stopPropagation(); favNoteEdit(f); });
box.appendChild(btn);
wrap.appendChild(box);
}
}
if (favBatch) {
const fk = favItemKey(f);
const ck = document.createElement('div');
ck.className = 'fav-check' + (favBatchSel.indexOf(fk) >= 0 ? ' on' : '');
ck.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg>';
wrap.appendChild(ck);
wrap.addEventListener('click', (e) => {
e.stopPropagation();
const i = favBatchSel.indexOf(fk);
if (i >= 0) favBatchSel.splice(i, 1); else favBatchSel.push(fk);
ck.classList.toggle('on', favBatchSel.indexOf(fk) >= 0);
syncBatchBar();
}, true);
favPaintLazy(wrap);
return wrap;
}
let pressTimer = null;
wrap.addEventListener('touchstart', (e) => {
pressTimer = setTimeout(() => {
const fav2 = getFav();
const idx2 = fav2.findIndex(matchFav);
if (idx2 >= 0 && window.openModal) {
window.openModal('删除这条收藏？', '', () => {
fav2.splice(idx2, 1);
saveFav(fav2);
renderFav();
}, { noInput: true });
}
}, 600);
}, { passive: true });
wrap.addEventListener('touchend', () => clearTimeout(pressTimer));
wrap.addEventListener('touchmove', () => clearTimeout(pressTimer), { passive: true });
wrap.addEventListener('contextmenu', (e) => {
e.preventDefault();
const fav2 = getFav();
const idx2 = fav2.findIndex(matchFav);
if (idx2 >= 0 && window.openModal) {
window.openModal('删除这条收藏？', '', () => {
fav2.splice(idx2, 1);
saveFav(fav2);
renderFav();
}, { noInput: true });
}
});
favPaintLazy(wrap);
return wrap;
}
const favTabs = document.getElementById('fav-tabs');
if (favTabs) {
favTabs.addEventListener('click', (e) => {
const tb = e.target.closest('.fav-tab');
if (!tb) return;
favTab = tb.dataset.tab;
renderFav();
});
}
/* v63：顶栏最右侧唯一按钮，点一次切换全局排序并即时重画 */
