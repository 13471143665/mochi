closeVoicePanel();
voiceSendTarget(dataUrl, dur);
return;
}
const name = '语音 ' + voiceDur + '″';
lastMineText = '[语音]';
addRec({ side: 'out', text: name + '|||' + voiceDataUrl, type: 'voice' });
closeVoicePanel();
if (window.playSfx) window.playSfx('out');
if (window.logFish) window.logFish();
scheduleReply();
}
