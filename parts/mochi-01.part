let _favImgPassT = null, _favImgPassRetries = 0;
function scheduleFavImgPass(delay) {
clearTimeout(_favImgPassT);
_favImgPassT = setTimeout(favImgPass, delay || 3000);
}
async function favImgPass() {
try {
const rawSnap = store.get('fav-msgs');
if (!rawSnap || rawSnap.length < 1024) return true;
let list;
try { list = JSON.parse(rawSnap); } catch (e) { return true; }
if (!Array.isArray(list)) return true;
const compressed = await compressFavListImages(list);
const tokened = await tokenizeFavList(compressed || list);
if (!compressed && !tokened) return true;
const out = tokened || compressed;
const _favPoolOk = await window.mochiMediaFlush(); // #142：池数据先落盘，收藏里的令牌才有据可查
if (_favPoolOk !== true) { scheduleFavImgPass(8000); return false; }
const rawNow = store.get('fav-msgs');
if (rawNow !== rawSnap) {
if (++_favImgPassRetries < 5) { scheduleFavImgPass(5000); return false; }
return true;
}
_favImgPassRetries = 0;
const _json = JSON.stringify(out);
store.set('fav-msgs', _json);
_favCache = { cid: favCid(), raw: _json, list: out };
return true;
} catch (e) { return true; }
}
/* v55：老数据修补——图片/表情收藏如果没有 text 也没有 parts（历史写法只存了半条），
   从聊天记录里按 mk / ts 找回图片，保证「他收藏的图片」能显示。 */
function favRepairList(list) {
let changed = false;
const recs = (window.getChatMsgs ? window.getChatMsgs() : []) || [];
if (!recs.length) return null;
const byMk = {};
recs.forEach(function (m) { try { const mk = msgKeyOf(m); if (mk && !byMk[mk]) byMk[mk] = m; } catch (e) {} });
list.forEach(function (f) {
if (!f || (f.kind || 'msg') !== 'msg') return;
const hasParts = Array.isArray(f.parts) && f.parts.some(function (p) { return p && p.k === 'img' && p.v; });
const txtOk = typeof f.text === 'string' && (f.text.indexOf('data:') === 0 || (window.mochiMediaIsToken && window.mochiMediaIsToken(f.text)));
if (hasParts || txtOk) return;
if (f.type !== 'image' && f.type !== 'sticker') return;
let hit = f.mk ? byMk[f.mk] : null;
if (!hit && f.ts) hit = recs.find(function (m) { return m && (m.ts || 0) === f.ts && (m.side || '') === (f.side || 'out'); }) || null;
if (!hit) return;
const parts = favPartsOfRec(hit);
if (!parts && !(typeof hit.text === 'string' && hit.text)) return;
f.text = hit.text || f.text || '';
if (parts) f.parts = parts;
if (hit.type) f.type = hit.type;
if (!f.ts && hit.ts) f.ts = hit.ts;
