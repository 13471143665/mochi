if (pageVisible) {
updateGroupName();
renderAll();
try { if (settingsPanel && !settingsPanel.hidden) renderSettingsPanel(); } catch (e) {}
try { if (groupsPanel && !groupsPanel.hidden) renderGroupsPanel(); } catch (e) {}
gcSwitchDirty = false;
} else {
gcSwitchDirty = true; // 隐藏态挂起：enterGroupChat 全量重建兜底（防未来入口绕过）
