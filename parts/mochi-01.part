(d.followup || []).forEach(function (g) { const grp = g.group || g.cat || ''; (g.cards || []).forEach(function (c) { const txt = typeof c === 'string' ? c : (c && c.content) || ''; if (txt && txt.toLowerCase().indexOf(kw) >= 0) out.push({ t: txt, cat: '回应·' + grp }); }); });
} catch (e) {}
