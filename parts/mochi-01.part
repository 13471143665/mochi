'<span class="ccg-count">' + count + '</span>' +
'<label class="toggle ccard-toggle" title="' + (off ? '启用该分组' : '停用该分组') + '"><input type="checkbox"' + (off ? '' : ' checked') + '><span class="tk"></span></label>';
}
function makeNode(it, i) {
