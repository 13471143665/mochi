} else if (fallbackDecls.indexOf(decls) < 0) {
fallbackDecls.push(decls);
}
}
if (!hasMapped && fallbackDecls.length) {
return { out: wrap(fallbackDecls.join(';')), hint: '未认出模板里的气泡类名，已把全部样式整体套用到双方气泡' };
}
return { out: out, hint: null };
};
