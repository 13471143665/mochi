}
if (typeof c === 'string' && (c.indexOf('data:') === 0 || /^https?:\/\//i.test(c))) { viewImage(c); return; }
const cm = ccCardMedia(c);
if (cm && cm.img) {
const v2 = window.mochiMediaExpand ? window.mochiMediaExpand(cm.src) : null;
viewImage(v2 || cm.src);
return;
}
if (cm) return;
openEditCard(gname, i);
