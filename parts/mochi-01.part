d.textContent = '已保存：' + label + '（' + (on ? '开' : '关') + '）';
d.className = 'cc-toast'; void d.offsetWidth; d.className = 'cc-toast show';
clearTimeout(d._timer); d._timer = setTimeout(() => { d.className = 'cc-toast'; }, 1800);
} catch (e) {}
}
