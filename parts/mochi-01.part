function retractGcMsg(idx, gid) {
if (gid !== undefined && gid !== curGid) {
try {
const arr = gcReadGroupKey(gid);
if (arr[idx] && !arr[idx].retracted) {
arr[idx].orig = gcRetractFallbackHtml(arr[idx]);
