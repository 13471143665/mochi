const csBgAdjNum = (raw, def, min, max) => {
if (raw === null || raw === undefined || raw === '') return def;
const n = Number(raw);
return Number.isFinite(n) ? Math.max(min, Math.min(max, Math.round(n))) : def;
};
function csBgAdj() {
const s = store.get('cs-bg-size');
