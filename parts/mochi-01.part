).join('') + '</div>' +
(okAll
? '<div class="qsdiag-okline">链路正常 · 联系人每条回复约 ' + (isFinite(prob) ? prob : 0) + '% 概率变成词典拼字</div>'
: '<div class="qsdiag-blocked">被挡住：' + blocked + '</div>');
