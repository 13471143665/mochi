/* ---------- v92：单张表情长按拖到别的分组（我的表情包） ----------
   长按表情格约 420ms 抓起：浮起缩略图，拖到顶部分组栏的某个分组上松手＝
   把这张表情搬进那个分组（并排到组尾）。只动「我的表情包」；
   「最近使用」虚拟组不能作为来源；拖起期间拦掉 click，不会误把表情发出去。 */
var STK_DRAG = null;
function myStkMoveTo(fromG, idx, toG) {
  var a = (myGroups || []).find(function (g) { return g[0] === fromG; });
  var b = (myGroups || []).find(function (g) { return g[0] === toG; });
  if (!a || !b || !a[1]) return;
  var one = a[1].splice(idx, 1)[0];
  if (one == null) return;
  (b[1] = b[1] || []).push(one);
  try { myEmojiSaveNow(); } catch (e0) { try { myEmojiSave(); } catch (e1) {} }
  try { toast('已把这张表情移到「' + toG + '」（组尾）'); } catch (e2) {}
}
function myStkBindDrag(d, gname, i, src) {
  if (gname === '__recent__') return;
  var timer = null, active = false, sx = 0, sy = 0;
  function stkGhostMove(x, y) {
    if (!STK_DRAG || !STK_DRAG.ghost) return;
    STK_DRAG.ghost.style.left = Math.max(4, x - 31) + 'px';
    STK_DRAG.ghost.style.top = Math.max(4, y - 74) + 'px';
    var el = document.elementFromPoint(x, y);
    var t = el && el.closest ? el.closest('.emoji-g-chip') : null;
    if (t && (t.dataset.g === '__recent__' || t.dataset.g === STK_DRAG.from)) t = null;
    if (STK_DRAG.target && STK_DRAG.target !== t) STK_DRAG.target.classList.remove('eg-drop');
    STK_DRAG.target = t;
    if (t) t.classList.add('eg-drop');
  }
  function start(x, y) {
    sx = x; sy = y; active = false;
    clearTimeout(timer);
    timer = setTimeout(function () {
      active = true;
      var g = document.createElement('div');
      g.className = 'stk-drag-ghost';
      var img = document.createElement('img');
      img.src = src;
      g.appendChild(img);
      document.body.appendChild(g);
      STK_DRAG = { from: gname, i: i, ghost: g, target: null, item: d };
      d.classList.add('stk-dragging');
      try { if (navigator.vibrate) navigator.vibrate(12); } catch (eV) {}
      stkGhostMove(x, y);
    }, 420);
  }
  function move(x, y, ev) {
    if (!active) {
      if (Math.abs(x - sx) > 10 || Math.abs(y - sy) > 10) clearTimeout(timer);
      return;
    }
    if (ev && ev.cancelable) { try { ev.preventDefault(); } catch (e) {} }
    stkGhostMove(x, y);
  }
  function end(x, y, ev) {
    clearTimeout(timer);
    if (!active) return;
    active = false;
    var to = STK_DRAG && STK_DRAG.target ? (STK_DRAG.target.dataset.g || '') : '';
    try { if (STK_DRAG.target) STK_DRAG.target.classList.remove('eg-drop'); } catch (e) {}
    try { d.classList.remove('stk-dragging'); } catch (e1) {}
    try { if (STK_DRAG.ghost && STK_DRAG.ghost.parentNode) STK_DRAG.ghost.parentNode.removeChild(STK_DRAG.ghost); } catch (e2) {}
    STK_DRAG = null;
    /* 拖完这下不是「点表情」，拦掉 click 免得把表情发出去 */
    if (ev && ev.cancelable) { try { ev.preventDefault(); } catch (e3) {} }
    if (to && to !== gname) {
      myStkMoveTo(gname, i, to);
      try { renderEmojiPanel(); } catch (e5) {}
    }
  }
  d.addEventListener('touchstart', function (e) { var t = e.touches[0]; if (t) start(t.clientX, t.clientY); }, { passive: true });
  d.addEventListener('touchmove', function (e) { var t = e.touches[0]; if (t) move(t.clientX, t.clientY, e); }, { passive: false });
  d.addEventListener('touchend', function (e) { var t = e.changedTouches[0]; end(t ? t.clientX : sx, t ? t.clientY : sy, e); }, { passive: false });
  d.addEventListener('touchcancel', function () { end(sx, sy, null); }, { passive: true });
  /* 桌面鼠标同样支持 */
  d.addEventListener('mousedown', function (e) {
    if (e.button !== 0) return;
    start(e.clientX, e.clientY);
    var mm = function (ev) { move(ev.clientX, ev.clientY, ev); };
    var mu = function (ev) { end(ev.clientX, ev.clientY, ev); window.removeEventListener('mousemove', mm); window.removeEventListener('mouseup', mu); };
    window.addEventListener('mousemove', mm); window.addEventListener('mouseup', mu);
  });
}

/* ---------- v39：双击移动（表情包 / emoji / 颜文字） ----------
   用户直派：「加一个双击表情包和图片可以选择移动到最上面，移动到最下面，移动到别的
   分组的弹窗……已选择图标的提示参考字卡的。可多选，上限是 99」。
   只动「我的」这一栏（TA 的 / 公用的不是本机数据）；单击发送照旧，延后 280ms 让位给双击。 */
var emojiMv = { on: false, sel: new Set(), cat: '', isSticker: false };
function emojiMvList() {
return emojiMv.isSticker ? (myGroups || []) : (myTextGroups[emojiMv.cat] || []);
}
function emojiMvKey(g, i) { return g + '\u0001' + i; }
function emojiMvPaint() {
if (!emojiList) return;
emojiList.querySelectorAll('.emoji-item').forEach(function (d) {
var on = emojiMv.sel.has(emojiMvKey(d.dataset.g, d.dataset.i));
d.classList.toggle('sel', on);
var ck = d.querySelector('.emoji-check');
if (on && !ck) { ck = document.createElement('span'); ck.className = 'emoji-check'; ck.textContent = '✓'; d.appendChild(ck); }
else if (!on && ck) ck.remove();
});
if (window.ccMoveBar) window.ccMoveBar.setCount(emojiMv.sel.size);
}
function emojiMvStart(g, i) {
if (emojiMv.on) return;
emojiMv.on = true;
emojiMv.isSticker = emojiCat === 'sticker';
emojiMv.cat = emojiCat;
emojiMv.sel = new Set([emojiMvKey(g, i)]);
/* 面板重渲（切分组/补数据）后把勾选状态补回来，不然条上写着已选 2 个、格子里却没有勾 */
if (emojiList && !emojiList.__mvObs) {
var pend = false;
emojiList.__mvObs = new MutationObserver(function () {
if (!emojiMv.on || pend) return;
pend = true;
setTimeout(function () { pend = false; try { emojiMvPaint(); } catch (e) {} }, 0);
});
emojiList.__mvObs.observe(emojiList, { childList: true });
}
emojiMvPaint();
if (window.ccMoveBar) window.ccMoveBar.show({
groups: emojiMvList().map(function (x) { return x[0]; }),
curGroup: g,
count: 1,
onTop: function () { emojiMvApply('top'); },
onBottom: function () { emojiMvApply('bottom'); },
onGroup: function (n) { emojiMvApply('group', n); },
onCancel: emojiMvEnd
});
toast('已进入移动：再点别的可多选（最多 99 个）');
}
function emojiMvEnd() {
if (!emojiMv.on) return;
emojiMv.on = false;
emojiMv.sel = new Set();
if (emojiList) {
