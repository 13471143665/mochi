window.dictOverall = function (scene) { return gOv(scene === 'mail' ? 'mail' : scene === 'feed' ? 'feed' : 'chat'); };
const lockHint = document.getElementById('dict-lock-hint');
function renderDictLockHint() {
if (!lockHint) return;
