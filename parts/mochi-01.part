function stopTimers() {
if (durationTimer) { clearInterval(durationTimer); durationTimer = null; }
}
function updateDur() {
if (!currentCall) return;
const base = currentCall.connectedTime || currentCall.startTime;
const sec = Math.floor((Date.now() - base) / 1000);
