el.className = 'tag ppy-chip ppy-chip-c' + (it.on === 1 ? ' sel' : '') + (dis ? ' dis' : '');
el.dataset.c = String(i);
el.textContent = it.s;
const x = document.createElement('i');
x.className = 'ppy-x';
x.textContent = '×';
