function scrollToBottom() { try { body.scrollTop = body.scrollHeight; } catch (e) {} }
function gcAtBottom() {
try { return body.scrollHeight - body.scrollTop - body.clientHeight <= 8; } catch (e) { return true; }
}
let gcUserGcScrollTouched = false;
let gcUnpinTsY = 0;
