  const g = (emojiGroupListNow() || []).find(function (x) { return x[0] === name; });
  return g ? (g[1] || []).length : 0;
}
function emojiGroupGhostMove(x, y) {
  if (!EG_DRAG || !EG_DRAG.ghost) return;
  EG_DRAG.ghost.style.left = Math.max(4, x + 16) + 'px';
  EG_DRAG.ghost.style.top = Math.max(4, y - 34) + 'px';
