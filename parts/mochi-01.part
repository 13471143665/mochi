const list = mjfpGet();
let idx = -1;
if (ch.dataset.i != null) idx = Number(ch.dataset.i);
else {
const v = (POOL.find(p => p[0] === ch.dataset.p) || [])[1];
if (v != null) idx = list.findIndex(x => x.s === v);
