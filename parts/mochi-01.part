{ label: '标准', value: '12px' },
{ label: '大圆角', value: '18px' },
{ label: '特圆', value: '28px' }
];
const BUBBLE_RADIUS_DEFAULT = '18px';
const TIME_STYLES = [
{ label: '头像下方', value: 'under-av' },
{ label: '气泡下方', value: 'under-bubble' },
{ label: '时间气泡', value: 'bubble' },
{ label: '气泡外侧悬浮', value: 'float' },
{ label: '消息上方居中', value: 'center' },
