if (moreSearch) {
moreSearch.addEventListener('click', (e) => {
e.stopPropagation();
if (morePanel) morePanel.hidden = true;
const pc = document.getElementById('poke-card');
if (pc) pc.hidden = true;
const askP = document.getElementById('chat-ask-panel');
