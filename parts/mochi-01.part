}
function gcBeautySave() { try { gcBeautyStore().set('gc-beauty', JSON.stringify(gcBeautyStored)); } catch (e) {} }
function gcHexRgb(c) {
const s = String(c === undefined || c === null ? '' : c).trim();
let m = /^#([0-9a-f]{3})$/i.exec(s);
