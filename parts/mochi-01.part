};
const IDLE_BATCH = 40;
const scheduleNext = (fn) => {
try {
if (typeof window.requestIdleCallback === 'function') {
window.requestIdleCallback(function () { fn(); }, { timeout: 300 });
return;
}
} catch (e) {}
setTimeout(fn, 60);
};
const step = (batch) => {
