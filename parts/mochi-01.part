const csBgKeyOf = (mode) => (mode === 'dark' ? CS_BG_GLIST_D : CS_BG_GLIST_L);
function csBgReadList(mode) {
const key = csBgKeyOf(mode);
let raw = null;
try { raw = store.get(key); } catch (e) {}
if (raw === null || raw === undefined || raw === '') {
