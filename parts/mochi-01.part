else if (window.chatIsBracketedKaomojiCard ? window.chatIsBracketedKaomojiCard(c) : (/[\(（｡◕(◕)(づ｡(¬)]/.test(c) && /[\)）】)]/.test(c))) kaomoji.push(c); // FIX #1152 与单聊同一判据
