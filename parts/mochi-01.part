const val = (m ? m[2] : line).trim();
if (!val) { dup++; return; }
const b = resolveBucket(m ? m[1] : (targetGroup || fallbackGroup));
if (b.seen.has(val)) { dup++; return; }
b.seen.add(val);
b.g[1].push(val);
added++;
});
