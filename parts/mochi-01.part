'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg></button>' +
'<button class="tc-hx" data-qjump="bottom" title="去到底部" aria-label="去到底部">' +
'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg></button>';
window.openTCPanel('音乐播放列表', html +
'<div class="mail-actions">' +
(playQueue.length ? '<button class="cc-tool" id="sm-q-clear">清空队列</button>' : '') +
'<button class="cc-tool" id="sm-q-close">关闭</button></div>', headX);
qdBindGlobals();
setupQueueDrag();
{
const tcb = document.getElementById('tc-body');
const hx = document.getElementById('tc-head-x');
if (tcb && hx) {
hx.querySelectorAll('[data-qjump]').forEach(function (b) {
b.addEventListener('click', function (ev) {
ev.preventDefault(); ev.stopPropagation();
const toTop = b.dataset.qjump === 'top';
try { tcb.scrollTo({ top: toTop ? 0 : tcb.scrollHeight, behavior: 'smooth' }); }
