setTimeout(scrollToCurrentSong, 160);
setTimeout(scrollToCurrentSong, 420);
document.getElementById('sm-q-close').addEventListener('click', function () { document.getElementById('tc-mask').hidden = true; });
/* v53：播放列表点空白处关闭 */
{
const tmask = document.getElementById('tc-mask');
