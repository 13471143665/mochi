function cardPool() {
const pool = [];
try {
const d = window.DEFAULT_CARD_DATA;
const off = window.isDefaultCardOff;
if (d && d.main) {
d.main.forEach(function (c) {
if (c && c[1]) c[1].forEach(function (x) { if (x && !(off && off('main', x))) pool.push(x); });
