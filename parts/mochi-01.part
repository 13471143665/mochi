if (!(Array.isArray(myGroups) && myGroups.length)) {
myeLoading = true;
try { if (emojiPanel && !emojiPanel.hidden && emojiMode === 'mine') renderEmojiPanel(); } catch (e) {}
}
window.idbGet(MYE_KEY()).then(v => {
