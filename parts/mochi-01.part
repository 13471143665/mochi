if (legacy.length) { try { store.set(key, JSON.stringify(legacy)); } catch (e) {} }
return legacy;
}
try { const v = JSON.parse(raw); return Array.isArray(v) ? v : []; } catch (e) { return []; }
}
const csBgList = (mode) => csBgReadList(mode || csBgPanelMode || csBgModeNow());
const csBgSaveList = (arr, mode) => store.set(csBgKeyOf(mode || csBgPanelMode || csBgModeNow()), JSON.stringify(arr));
const csBgAllIds = () => {
