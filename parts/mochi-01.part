if (bg) { cover.style.backgroundImage = 'url("' + bg + '")'; cover.classList.add('has-bg'); }
else { cover.style.backgroundImage = ''; cover.classList.remove('has-bg'); }
armCoverLayer(cover, 'dev-feed-all-cover-tap', 'mochi-feed-cover-pick', !!bg);
if (feedAllWho === 'me') {
