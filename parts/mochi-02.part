function isAuthorityKey(k) { return /:chat-msgs$/.test(k) || /:chat-blk-(?:idx|[0-9]+)$/.test(k) || GROUP_CHAT_KEY_RE.test(k) || /:feed-posts$/.test(k); } // #722：块键是 IDB 权威（LS 无副本）
const MEDIA_TOKEN_RE = /@@m:([0-9a-f]{32})/g;
const UTF8_SAMPLE = 512;
