};
const THING_TABS = [['use', '常用'], ['fav', '喜欢'], ['dear', '珍视的纪念'], ['gift', '想送给TA的']];
const THING_PH = {
use: '例如：每天背的帆布包',
fav: '例如：那台旧相机',
dear: '例如：第一次收到的那封信',
gift: '例如：一直想送TA的一条围巾'
