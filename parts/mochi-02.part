      '.aie-empty{font-size:11.5px;color:#a99cb0;line-height:1.7}',
      '.aie-in{width:100%;box-sizing:border-box;height:38px;border:1px solid #e8e0f0;border-radius:10px;padding:0 11px;font-family:inherit;font-size:12px;margin-bottom:7px;outline:none}',
      '.aie-ta{width:100%;box-sizing:border-box;min-height:74px;border:1px solid #e8e0f0;border-radius:10px;padding:9px 11px;font-family:inherit;font-size:12px;line-height:1.65;outline:none;resize:vertical}',
      '.aie-book-ta{min-height:150px;max-height:42vh;overflow:auto;white-space:pre-wrap;word-break:break-word}',
      '.aie-count{font-size:10.5px;color:#a396ab;text-align:right;margin:4px 2px 0;line-height:1.5}',
      '.aie-count.over{color:#c0392b;font-weight:700}',
      /* v48：API Key 很长（xlh- 开头近百字符），单行 input 会溢出显示不全 → 多行自动换行 */
      '.aie-key{min-height:58px;height:auto;padding:8px 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;line-height:1.6;letter-spacing:.1px;word-break:break-all;overflow-wrap:anywhere;resize:vertical;background:#fff}',
      '.aie-btn{height:38px;border:0;border-radius:10px;background:#8f5fd0;color:#fff;font-family:inherit;font-size:12.5px;font-weight:700;padding:0 16px;cursor:pointer}',
      '.aie-btn.lite{background:#eee7f5;color:#6d5b7a}',
      '.aie-row{display:flex;gap:8px;align-items:center;margin-top:8px}'
    ].join('\n');
    document.head.appendChild(st);
  }

  /* ---------- 改写弹窗 ---------- */
  var openMask = null;
  function closeRewrite() {
    if (!openMask) return;
    var m = openMask; openMask = null;
    m.remove();
  }
  function paintScore(box, val, preset) {
    /* v92：preset＝专属字卡外面徽章已存的分数（dataset.satScore）——
       弹窗初始展示直接沿用外面那颗分，保证「外面是几分，点进去就是几分」；
       用户改了文字 / AI 改写后重新实时评估 */
    var s = (preset >= 1 && preset <= 10) ? Math.round(preset) : scoreOf(val);
    /* v92：档位与「专属字卡 · 字卡适应度」同口径——≥7 易(绿) / ≥4 中(黄) / <4 难(红)，
       与 card-sat-yz.js 的 tier 判定完全一致，两边星星互相对得上 */
    var tier = tierOf(s);
    var stars = '';
    for (var i = 1; i <= 10; i++) stars += (i <= s ? '★' : '☆');
    box.className = 'crw-score' + (s >= 7 ? '' : (s >= 4 ? ' mid' : ' low'));
    box.innerHTML = '<span>他会怎么想</span><span class="st">' + stars + '</span><span class="num">' + s + '/10 ' + tier + '</span>';
  }
  function openRewrite(opts) {
    opts = opts || {};
    var src = stripNo(clean(opts.text));
    if (!src) { toast('这张卡没有可改写的文字'); return; }
    injectStyle();
    closeRewrite();
    var mask = document.createElement('div');
    mask.className = 'crw-mask';
    mask.innerHTML = '<div class="crw-card">' +
      '<div class="crw-h"><b>改一下语气</b><button class="crw-x" id="crwX">✕</button></div>' +
      '<div class="crw-src-l">来源：' + esc(opts.label || '角色字卡') + '</div>' +
      '<div class="crw-src">' + esc(src) + '</div>' +
      '<button class="crw-again" id="crwAgain">再让 AI 改一版</button>' +
      '<div class="crw-note"><span>点了才会用算力，不点不调 AI</span><span class="crw-self" id="crwSelf">自己改</span></div>' +
      '<div class="crw-l">改写结果（可以自己再改）</div>' +
      '<textarea class="crw-out" id="crwOut"></textarea>' +
      '<div class="crw-score" id="crwScore"></div>' +
      '<button class="crw-eco-link" id="crwEco">风格预设 · 世界书（' + activePresets().length + ' 个预设 / ' + mountedBooks().length + ' 本已挂载）</button>' +
      '<button class="crw-pri" id="crwReplace">用这句替换原卡</button>' +
      '<button class="crw-sec" id="crwSaveNew">另存为新字卡（原卡保留）</button>' +
      '<button class="crw-cancel" id="crwCancel">取消</button>' +
      '</div>';
    document.body.appendChild(mask);
    openMask = mask;
    var out = mask.querySelector('#crwOut');
    var scoreBox = mask.querySelector('#crwScore');
    var again = mask.querySelector('#crwAgain');
    out.value = src;
    /* v92：专属字卡带外面徽章的分（dataset.satScore），初始星级直接沿用外面的 */
    paintScore(scoreBox, out.value, Number(opts.score) || 0);

    mask.querySelector('#crwX').addEventListener('click', closeRewrite);
    mask.querySelector('#crwCancel').addEventListener('click', closeRewrite);
    mask.addEventListener('click', function (e) { if (e.target === mask) closeRewrite(); });
    out.addEventListener('input', function () { paintScore(scoreBox, out.value); });
    mask.querySelector('#crwSelf').addEventListener('click', function () { try { out.focus(); } catch (e) {} });

    var noteEl = mask.querySelector('.crw-note > span');
    again.addEventListener('click', function () {
      var old = again.textContent;
      again.disabled = true; again.textContent = '正在改…';
      if (noteEl) noteEl.textContent = '正在请求 AI…';
      aiRewrite(src).then(function (r) {
        if (!openMask) return;
        var v = (r && r.text) || localRewrite(src);
        out.value = v;
        paintScore(scoreBox, v);
        /* v47：成功才标「AI 改写」，失败/未填接口标本地改写，用户一眼能分辨 */
        if (noteEl) noteEl.textContent = (r && r.by === 'ai') ? 'AI 改写 ✓ 已用真模型' : '本地改写（未填接口 / 接口没连上）';
        again.disabled = false; again.textContent = old;
      }).catch(function () {
        out.value = localRewrite(src);
        paintScore(scoreBox, out.value);
        if (noteEl) noteEl.textContent = '本地改写（未填接口 / 接口没连上）';
        again.disabled = false; again.textContent = old;
      });
    });

    mask.querySelector('#crwEco').addEventListener('click', function () {
      openEco(function () {
        var link = openMask && openMask.querySelector('#crwEco');
        if (link) link.textContent = '风格预设 · 世界书（' + activePresets().length + ' 个预设 / ' + mountedBooks().length + ' 本已挂载）';
      });
    });

    mask.querySelector('#crwReplace').addEventListener('click', function () {
      var v = stripNo(clean(out.value));
      if (!v) { toast('改写结果不能为空'); return; }
      var ok = false;
      try {
        if (typeof window.__ccReplaceCard === 'function' && opts.g != null && opts.idx != null) {
          ok = window.__ccReplaceCard(opts.g, opts.idx, v);
        }
      } catch (e) {}
      if (ok) { toast('已替换原卡'); closeRewrite(); }
      else toast('没找到这张卡，可先用「另存为新字卡」');
    });
    mask.querySelector('#crwSaveNew').addEventListener('click', function () {
      var v = stripNo(clean(out.value));
      if (!v) { toast('改写结果不能为空'); return; }
      var ok = false;
      try {
        if (typeof window.__ccAddCardTo === 'function') ok = window.__ccAddCardTo(opts.g || 'AI 改写', v);
      } catch (e) {}
      if (ok) { toast('已另存为新字卡'); closeRewrite(); }
      else toast('这张卡已在分组里了');
    });
  }

  /* ---------- AI 生态 ---------- */
  var ecoMask = null;
  window.__aieOpen = function (cb) { try { openEco(cb); } catch (e) {} };
  function openEco(onSaved) {
    injectStyle();
    if (ecoMask) return;
    var e = loadEco();
    var mask = document.createElement('div');
    mask.className = 'aie-mask';
    var psHtml = PRESETS.map(function (p) {
      var on = presetOn(p.id);
      return '<label class="aie-ck"><input type="checkbox" data-pid="' + p.id + '"' + (on ? ' checked' : '') + '>' +
        '<span>' + esc(p.name) + '</span><small>' + esc(p.brief) + '</small></label>';
    }).join('');
    var bkHtml = (e.books || []).length
      ? (e.books || []).map(function (b, i) {
        var on = !!(e.mounted && e.mounted[b.name]);
        return '<label class="aie-ck"><input type="checkbox" data-book="' + i + '"' + (on ? ' checked' : '') + '>' +
          '<span>' + esc(b.name || ('世界书 ' + (i + 1))) + '</span><small>' + String(b.text || '').length + ' 字</small></label>';
      }).join('')
      : '<div class="aie-empty">还没有世界书，点下面「新增世界书」粘贴设定即可。</div>';
    mask.innerHTML = '<div class="aie-card">' +
      '<div class="aie-h"><b>AI 生态 · 活人感与内容</b><button class="aie-x" id="aieX">✕</button></div>' +
      '<div class="aie-sub">风格预设可挂多个，勾选顺序叠加生效；改写时会连同挂载的世界书一起读，尽量贴合角色人设。</div>' +
      '<div class="aie-box"><div class="aie-box-h"><h4>风格预设（怎么演，可挂多个）</h4><button class="aie-fold" id="aiePsFoldBtn" type="button">收起</button></div><p>勾选后参与 AI 改写提示词；不点「再让 AI 改一版」不会消耗算力。</p><div id="aiePsFold">' + psHtml + '</div></div>' +
      '<div class="aie-box"><h4>世界书挂载（她知道什么）</h4><p>勾选要挂载的世界书，可多选、随时换。</p>' + bkHtml + '</div>' +
      '<div class="aie-box"><h4>新增世界书</h4><p>粘贴一段设定文本，保存后在上面勾选挂载。单本最多 ' + BOOK_TEXT_MAX.toLocaleString() + ' 字；调用真模型时会把挂载的世界书全文一起发送，字数越多费用/耗时越高。</p>' +
      '<input class="aie-in" id="aieBookName" data-ce-skip="1" placeholder="世界书名称，如：海边小镇">' +
      '<textarea class="aie-ta aie-book-ta" id="aieBookText" data-ce-skip="1" maxlength="' + BOOK_TEXT_MAX + '" rows="6" style="min-height:130px;max-height:46vh;line-height:1.55" placeholder="粘贴设定：人物关系、称呼、口癖、世界观…（最多 ' + BOOK_TEXT_MAX.toLocaleString() + ' 字）"></textarea>' +
      '<div class="aie-count" id="aieBookCount">0/' + BOOK_TEXT_MAX + '</div>' +
      '<div class="aie-row"><button class="aie-btn lite" id="aieBookClip">📋 读取剪贴板全文</button><button class="aie-btn lite" id="aieBookFile">📄 导入 txt</button></div>' +
      '<div class="aie-row"><button class="aie-btn" id="aieBookAdd">保存世界书</button></div></div>' +
      '<div class="aie-box"><h4>AI 接口（可选）</h4><p>留空＝只用本地改写（不联网，不会有「连不上」的问题）。要和真模型对话，请填一个 OpenAI 兼容接口地址 + Key + 模型名，保存后再点「再让 AI 改一版」。</p>' +
      '<input class="aie-in" id="aieApiUrl" placeholder="接口地址，如 https://api.openai.com/v1/chat/completions" value="' + esc(e.api.url || '') + '">' +
      '<textarea class="aie-ta aie-key" id="aieApiKey" rows="2" placeholder="API Key（只存本机，长 key 会自动换行）">' + esc(e.api.key || '') + '</textarea>' +
      '<input class="aie-in" id="aieApiModel" placeholder="模型，如 gpt-4o-mini" value="' + esc(e.api.model || '') + '">' +
      '<div class="aie-row"><button class="aie-btn" id="aieApiSave">保存接口</button></div></div>' +
      '<div class="aie-row"><button class="aie-btn lite" id="aieClose">完成</button></div>' +
      '</div>';
    document.body.appendChild(mask);
    ecoMask = mask;
    /* v67：风格预设可展开/收起（预设多时不用一直翻），选择记忆在本机 */
    try {
      var _psFold = mask.querySelector('#aiePsFold');
      var _psBtn = mask.querySelector('#aiePsFoldBtn');
      var _psKey = 'mochi-aie-ps-fold';
      /* v68：默认一进来是「收起」状态；用户手动展开过才记住展开 */
      var _psFolded = true;
      try { var _psV = localStorage.getItem(_psKey); if (_psV !== null) _psFolded = (_psV === '1'); } catch (eF0) {}
      var _psPaint = function () {
        if (!_psFold || !_psBtn) return;
        _psFold.hidden = _psFolded;
        _psBtn.textContent = _psFolded ? '展开' : '收起';
      };
      if (_psBtn) _psBtn.addEventListener('click', function (ev) {
        try { ev.preventDefault(); ev.stopPropagation(); } catch (ePv) {}
        _psFolded = !_psFolded;
        try { localStorage.setItem(_psKey, _psFolded ? '1' : '0'); } catch (eF1) {}
        _psPaint();
      });
      _psPaint();
    } catch (ePsFold) {}
    /* v65：恢复 v59 的 maxlength="8000" 原生上限；这里只做实时计数与自动长高 */
    try {
      var _bEl = mask.querySelector('#aieBookText');
      var _cEl = mask.querySelector('#aieBookCount');
      if (_bEl && _cEl) {
        var _fitBook = function () {
          var n = Array.from(_bEl.value || '').length;
          _cEl.textContent = n + '/' + BOOK_TEXT_MAX;
          _cEl.classList.toggle('over', n >= BOOK_TEXT_MAX);
        };
        var _growBook = function () {
          try {
            _bEl.style.height = 'auto';
            _bEl.style.height = Math.min(Math.round(window.innerHeight * 0.46), Math.max(130, _bEl.scrollHeight + 2)) + 'px';
          } catch (eG) {}
        };
        var _clampBook = function (warn) {
          var arr = Array.from(_bEl.value || '');
          if (arr.length > BOOK_TEXT_MAX) {
            _bEl.value = arr.slice(0, BOOK_TEXT_MAX).join('');
            if (warn) toast('已保留前 ' + BOOK_TEXT_MAX.toLocaleString() + ' 字');
          }
          _fitBook();
          _growBook();
        };
        _bEl.addEventListener('input', function () { _clampBook(false); });
        /* v66：粘贴设定上限 10000 字，且必须能真正放满 10000 字。
           你反复遇到「只能放 1000 字」，根因是部分手机浏览器/输入法的剪贴板
           clipboardData.getData('text') 只返回被截断的前 1000 字；v64/v65 的
           paste 接管一旦拿到这段短文本就 preventDefault 并写死，反而把上限锁死在 1000。
           现在三条防线：
           1) maxlength="10000" 原生上限（输入框静态属性，跟随 BOOK_TEXT_MAX）；
           2) paste 同时读 text / text/plain 取更长者；若拿到的文本疑似被截断
              （长度恰好 1000、或拿不到），绝不 preventDefault，放行浏览器原生粘贴，
              由 maxlength + input 兜底，绝不把 1000 字写死；
           3) input / change / blur / 延时复查统一按 Unicode 码点截到 10000。
           这样任何设备/输入法下都能放到 10000，超过 10000 不再追加。 */
        var _pasteFull = function (txt) {
          var t = String(txt || '');
          var cur = _bEl.value || '';
          var ss = (_bEl.selectionStart == null) ? cur.length : _bEl.selectionStart;
          var ee = (_bEl.selectionEnd == null) ? ss : _bEl.selectionEnd;
          _bEl.value = cur.slice(0, ss) + t + cur.slice(ee);
          try { _bEl.setSelectionRange(ss + t.length, ss + t.length); } catch (eSr) {}
          _clampBook(true);
        };
        var _clipText = function (dt) {
          if (!dt) return '';
          var a = '', b = '';
          try { a = String(dt.getData('text') || ''); } catch (eA) {}
          try { b = String(dt.getData('text/plain') || ''); } catch (eB) {}
          return a.length >= b.length ? a : b;
        };
        /* ===== v67：彻底解决「粘贴只进 1000 字」 =====
           现象：上限已经是 10000（计数显示 1000/10000），但粘进来的正文只有 1000 字。
           原因：部分手机浏览器/输入法对「单次粘贴」有内部长度上限（常见正好 1000 字），
           事件里的 clipboardData 与浏览器原生插入都只给前 1000 字——所以改输入框上限没用。
           对策：三条互不依赖的通道，任意一条能用就能放满 10000：
             1) 粘贴后自动用异步剪贴板 API 再读一次全文，比框里长就整体换成全文；
             2) 「📋 读取剪贴板全文」按钮：直接读剪贴板（不经过粘贴通道）；
             3) 「📄 导入 txt」按钮：选文件整篇读入（完全绕开剪贴板）。
           三条都走 _clampBook，超过 10000 按 Unicode 码点截断，不会写出半个 emoji。 */
        var _replaceBook = function (txt) {
          _bEl.value = String(txt || '');
          try { _bEl.setSelectionRange(_bEl.value.length, _bEl.value.length); } catch (eSel2) {}
          _clampBook(true);
          var n = Array.from(_bEl.value || '').length;
          if (n > 0) toast('已写入 ' + n + ' 字');
        };
        var _readClip = function (cb) {
          var done = false;
          var fin = function (t) { if (done) return; done = true; cb(String(t || '')); };
          try {
            if (navigator.clipboard && navigator.clipboard.readText) {
              navigator.clipboard.readText().then(function (t) { fin(t); }, function () { fin(''); });
              setTimeout(function () { fin(''); }, 3000);
              return;
            }
          } catch (eClip) {}
          fin('');
        };
        var _pasteGuard = function (delay) {
          /* 不拦原生粘贴：先让浏览器照常插（maxlength=10000 兜底），插完再拿剪贴板全文比对。
             只做「更长的才替换」，且只在原框为空 / 原内容是新全文前缀时才动手，绝不吞掉已有内容。 */
          var before = (_bEl.value || '').length;
          var t0 = Date.now();
          var settle = function (left) {
            var grown = (_bEl.value || '').length - before;
            var goFull = function () {
              _clampBook(true);
              _readClip(function (full) {
                if (!full) return;
                var cur = _bEl.value || '';
                var fl = Array.from(full).length, cl = Array.from(cur).length;
                if (fl <= cl) return;
                if (before > 0 && full.indexOf(cur) !== 0) return;
                _bEl.value = before > 0 ? (cur + full.slice(cur.length)) : full;
                try { _bEl.setSelectionRange(_bEl.value.length, _bEl.value.length); } catch (eS3) {}
                _clampBook(true);
                toast('已按剪贴板全文补全：' + Array.from(_bEl.value).length + ' 字');
              });
            };
            if (grown > 0) { goFull(); return; }
            if (left > 0 && Date.now() - t0 < 1200) { setTimeout(function () { settle(left - 1); }, 110); return; }
            goFull();
          };
          setTimeout(function () { settle(delay === 0 ? 0 : 6); }, delay === 0 ? 0 : 40);
        };
        _bEl.addEventListener('paste', function (ev) {
          try {
            var txt = _clipText(ev.clipboardData || window.clipboardData || null);
            /* 桌面端事件里通常就是全文：直接写，省一次异步读剪贴板 */
            if (txt && Array.from(txt).length > 1000) { ev.preventDefault(); _pasteFull(txt); return; }
            /* 正好 1000 字＝极可能是粘贴通道截断：不等原生插入，立刻按剪贴板全文补 */
            if (txt && Array.from(txt).length === 1000) { ev.preventDefault(); _pasteGuard(0); return; }
          } catch (eP0) {}
          _pasteGuard(1);
        }, true);
        _bEl.addEventListener('drop', function (ev) {
          var txt = '';
          try { txt = _clipText(ev.dataTransfer); } catch (eDr) {}
          if (txt) { ev.preventDefault(); _pasteFull(txt); return; }
          setTimeout(function () { _clampBook(true); }, 0);
        }, true);
        var _clipBtn = mask.querySelector('#aieBookClip');
        if (_clipBtn) _clipBtn.addEventListener('click', function () {
          if (!navigator.clipboard || !navigator.clipboard.readText) {
            toast('这个浏览器不给网页读剪贴板，请用「📄 导入 txt」'); return;
          }
          _readClip(function (t) {
            if (!t) { toast('读不到剪贴板（可能没授权），可以长按输入框粘贴，或用「📄 导入 txt」'); return; }
            _replaceBook(t);
          });
        });
        var _fileBtn = mask.querySelector('#aieBookFile');
        if (_fileBtn) _fileBtn.addEventListener('click', function () {
          var inp = document.createElement('input');
          inp.type = 'file'; inp.accept = '.txt,text/plain,text/*,application/json,application/octet-stream';
          inp.addEventListener('change', function () {
            var f = (inp.files || [])[0]; if (!f) return;
            var fr = new FileReader();
            fr.onload = function () { _replaceBook(String(fr.result || '')); };
            fr.onerror = function () { toast('文件读取失败'); };
            try { fr.readAsText(f, 'utf-8'); } catch (eR) { toast('这个文件读不了'); }
          });
          inp.click();
        });
        /* v66b：change / blur 只做「超长复查」，绝不再调用 _growBook() 重排高度。
           否则点「保存世界书」时 textarea 失焦触发重排，按钮瞬间下移约 230px，
           mousedown 与 mouseup 落在不同元素上 → click 丢失 → 点了没保存（实测坐实）。
           高度只由 input / 粘贴时的 _growBook() 决定，此时布局已稳定。 */
        var _recheckBook = function () {
          var arr = Array.from(_bEl.value || '');
          if (arr.length > BOOK_TEXT_MAX) _bEl.value = arr.slice(0, BOOK_TEXT_MAX).join('');
          _fitBook();
        };
        _bEl.addEventListener('change', _recheckBook);
        _bEl.addEventListener('blur', _recheckBook);
        _fitBook();
        setTimeout(function () { try { _bEl.focus(); } catch (eFo) {} _growBook(); }, 60);
      }
    } catch (eBookCnt) {}
    /* v48：Key 很长时框要能自己长高（最多 150px），不然一长串 key 只看到前两行 */
    try {
      var _kEl = mask.querySelector('#aieApiKey');
      if (_kEl) {
        var _fitKey = function () {
          try {
            _kEl.style.height = 'auto';
            _kEl.style.height = Math.min(150, Math.max(58, _kEl.scrollHeight)) + 'px';
          } catch (eF) {}
        };
        _kEl.addEventListener('input', _fitKey);
        setTimeout(_fitKey, 0);
        setTimeout(_fitKey, 120);
      }
    } catch (eKeyFit) {}

    function close() {
      mask.remove(); ecoMask = null;
      try { if (typeof onSaved === 'function') onSaved(); } catch (e2) {}
    }
    mask.querySelector('#aieX').addEventListener('click', close);
    mask.querySelector('#aieClose').addEventListener('click', close);
    mask.addEventListener('click', function (ev) { if (ev.target === mask) close(); });

    mask.querySelectorAll('input[data-pid]').forEach(function (ck) {
      ck.addEventListener('change', function () {
        var eco = loadEco();
        eco.presets[ck.getAttribute('data-pid')] = ck.checked;
        saveEco(eco);
      });
    });
    mask.querySelectorAll('input[data-book]').forEach(function (ck) {
      ck.addEventListener('change', function () {
        var eco = loadEco();
        var b = eco.books[Number(ck.getAttribute('data-book'))];
        if (!b) return;
        eco.mounted[b.name] = ck.checked;
        saveEco(eco);
      });
    });
    mask.querySelector('#aieBookAdd').addEventListener('click', function () {
      var nm = clean(mask.querySelector('#aieBookName').value);
      var raw = String(mask.querySelector('#aieBookText').value || '');
      if (!nm) {
        var _e0 = loadEco();
        nm = '世界书 ' + (((_e0.books || []).length) + 1);
      }
      if (Array.from(raw).length > BOOK_TEXT_MAX) { toast('世界书最多 ' + BOOK_TEXT_MAX.toLocaleString() + ' 字，请删减后再保存'); return; }
      var tx = cleanBook(raw);
      if (!tx) { toast('世界书内容不能为空'); return; }
      var eco = loadEco();
      var i = eco.books.findIndex(function (b) { return b.name === nm; });
      if (i >= 0) { eco.books[i].text = tx; eco.mounted[nm] = true; }
      else { eco.books.push({ name: nm, text: tx }); eco.mounted[nm] = true; }
      saveEco(eco);
      toast('世界书已保存并挂载');
      mask.remove(); ecoMask = null;
      openEco(onSaved);
    });
    mask.querySelector('#aieApiSave').addEventListener('click', function () {
      var eco = loadEco();
      var raw = clean(mask.querySelector('#aieApiUrl').value);
      var url = normalizeApiUrl(raw);
      eco.api = {
        url: url,
        key: clean(mask.querySelector('#aieApiKey').value),
        model: clean(mask.querySelector('#aieApiModel').value)
      };
      saveEco(eco);
      if (url && url !== raw.replace(/\/+$/, '')) {
        mask.querySelector('#aieApiUrl').value = url;
        toast('接口已保存，已自动补全为 ' + url.slice(-26));
      } else toast(eco.api.url ? '接口已保存' : '已清空接口，改用本地改写');
    });
  }

  /* ---------- 字卡列表入口（v62：双击字卡条＝改一下语气，去掉原来的 ✎ 图标） ---------- */
  function ccItemPayload(item) {
    var raw = item.getAttribute('data-raw') || '';
    if (!raw) {
      var tEl = item.querySelector('.cc-txt .t') || item.querySelector('.cc-txt');
      raw = tEl ? (tEl.textContent || '') : '';
    }
    var txt = stripNo(clean(raw));
    if (!txt || /^data:/.test(txt)) return null;
    return {
      text: txt || clean(raw),
      g: item.getAttribute('data-g') || '',
      idx: Number(item.getAttribute('data-idx')),
      label: '角色字卡',
      /* v92：带上外面徽章已算好的 TA 评分（dataset.satScore），
         弹窗初始星级＝外面显示的分数，不再自己重新算 */
      score: Number(item.dataset.satScore) || 0
    };
  }
  function decorateList() {
    var page = $('page-custom-cards');
    if (!page || page.hidden) return;
    var list = $('cc-list');
    if (!list) return;
    list.querySelectorAll('.cc-item').forEach(function (item) {
      /* 老版本注入的 ✎ 图标：清掉 */
      try { var ob = item.querySelector('.cc-rewrite'); if (ob && ob.parentNode) ob.parentNode.removeChild(ob); } catch (eOld) {}
      if (item.__ccDbl) return;
      item.__ccDbl = 1;
      /* v63：长按字卡＝打开「改一下语气」（替代原来的长按拖动移动）。
         长按后松手会补发一次 click，用捕获阶段拦掉，避免同时打开「编辑字卡」。 */
      var lpTimer = null, lpX = 0, lpY = 0;
      item.style.setProperty('-webkit-touch-callout', 'none');
      item.style.setProperty('-webkit-user-select', 'none');
      item.addEventListener('pointerdown', function (ev) {
        if (ev.button !== 0 && ev.pointerType === 'mouse') return;
        lpX = ev.clientX; lpY = ev.clientY;
        if (lpTimer) clearTimeout(lpTimer);
        lpTimer = setTimeout(function () {
          lpTimer = null;
          var pay2 = ccItemPayload(item);
          if (!pay2) return;
          item.__ccLongFired = true;
          try { openRewrite(pay2); } catch (eLpRw) {}
          try { if (navigator.vibrate) navigator.vibrate(12); } catch (eLpV2) {}
        }, 450);
      });
      item.addEventListener('pointermove', function (ev) {
        if (lpTimer && (Math.abs(ev.clientX - lpX) > 10 || Math.abs(ev.clientY - lpY) > 10)) {
          clearTimeout(lpTimer); lpTimer = null;
        }
      });
      var lpCancel = function () { if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; } };
      item.addEventListener('pointerup', lpCancel);
      item.addEventListener('pointercancel', lpCancel);
      item.addEventListener('pointerleave', lpCancel);
      item.addEventListener('click', function (ev) {
        if (item.__ccLongFired) {
          item.__ccLongFired = false;
          try { ev.preventDefault(); ev.stopPropagation(); } catch (eCc) {}
        }
      }, true);
      var lastTap = 0;
      item.addEventListener('touchend', function (ev) {
        var t = Date.now();
        if (t - lastTap > 340) { lastTap = t; return; }
        lastTap = 0;
        var pay = ccItemPayload(item);
        if (!pay) return;
        try { ev.preventDefault(); ev.stopPropagation(); } catch (e) {}
        openRewrite(pay);
        try { if (navigator.vibrate) navigator.vibrate(12); } catch (eV) {}
      }, { passive: true });
      item.addEventListener('dblclick', function (ev) {
        var pay = ccItemPayload(item);
        if (!pay) return;
        ev.preventDefault(); ev.stopPropagation();
        openRewrite(pay);
      });
    });
  }

  var deco = null;
  function schedule() {
    if (deco) return;
    deco = setTimeout(function () { deco = null; try { decorateList(); } catch (e) {} }, 200);
  }
  function boot() {
    injectStyle();
    schedule();
    var list = $('cc-list');
    if (list && !list.__crwObs) {
      list.__crwObs = new MutationObserver(schedule);
      list.__crwObs.observe(list, { childList: true, subtree: false });
    }
    var page = $('page-custom-cards');
    if (page && !page.__crwPageObs) {
      page.__crwPageObs = new MutationObserver(schedule);
      page.__crwPageObs.observe(page, { attributes: true, attributeFilter: ['hidden'] });
    }
    var tabs = $('cc-tabs');
    if (tabs && !tabs.__crwTabBound) {
      tabs.__crwTabBound = true;
      tabs.addEventListener('click', function () { setTimeout(schedule, 80); });
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 1000);
  setTimeout(boot, 3000);
  setInterval(schedule, 4000);

  window.openCardRewrite = openRewrite;
  window.openAIEco = openEco;
  window.__crwPresetOn = presetOn;
  window.__crwLocalRewrite = localRewrite;
  /* 数据导入/回填后内存副本要作废，否则新写入的设定会被旧缓存挡住 */
  try {
    document.addEventListener('mochi-restore-done', function () { ecoCache = null; });
    document.addEventListener('contact-switched', function () { ecoCache = null; });
    window.addEventListener('storage', function (e) { if (e && (e.key === ECO_KEY || e.key === null)) ecoCache = null; });
  } catch (eEcoEvt) {}
})();

</script>
<!-- PERF-PLAN 阶段 1：上一行是 ext 外置脚本 defer 注入锚，构建时被整体替换为 35 个外置 js 标签；本行说明必须连同注释符号一起整体留在注释内，勿删。#797 教训：说明若写在注释结尾之外＝变正文裸文本（全页面右侧白色乱码条），其中的标签样本会被浏览器当真开标签，吞掉其后全部尾部 DOM -->

  <!-- PWA 安装到桌面按钮（Chrome/Edge 触发 beforeinstallprompt 时显示） -->
  <button class="pwa-install" id="pwa-install" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"/></svg>
    <span>安装到桌面</span>
  </button>
  <!-- iOS Safari 添加到主屏幕提示（v8.x #956：点明 Safari 标签页 7 天清空风险） -->
  <div class="pwa-ios-hint" id="pwa-ios-hint" hidden>
    <span>⚠ Safari 标签页 7 天不用会被系统清空数据 · 点「分享」→「添加到主屏幕」（装前先导出备份）</span>
  </div>
  <!-- v3.26.x #134：文档完整性双锚点（防「桌面图标/功能整块缺失」反复复发）。
       产物 index.html 约 3.6MB 且尾部两块脚本（决策/全屏/移动适配/pwa 更新器）最易
       被弱网截断，截断不报任何错 → 必须有「读到尾部」的标志才能自检。
       ① DOM 锚点元素（id=mochi-html-eof）：device.js 启动自检用（缺失=文档被截断）；
       ② EOF 注释文本 __MOCHI_EOF__：sw.js 写缓存前用 text() 校验（残缺体不进缓存）。
       两者都必须存在；构建产物在 </html> 后还会再写一份 __MOCHI_EOF__ 兜底注释。 -->
<script>
/* v60 聊天长图：参考「言字卡」(github.com/yanxu233/jinzhierchuanyanzika) 的
   foreignObject + 站点原生样式长图思路，按本应用的 DOM 独立实现（未复制其代码）。
   入口：聊天「更多」→ 存成长图（全部已渲染消息）；长按消息 → 长图起点 / 截到这里。 */
(function () {
  var CS_FROM = null;
  function csToast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function csSleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

  function csCollectCSS() {
    var out = '';
    Array.prototype.forEach.call(document.styleSheets, function (sh) {
      try { Array.prototype.forEach.call(sh.cssRules, function (r) { out += r.cssText + '\n'; }); } catch (e) {}
    });
    /* SVG 里没有 <body> / <html>：给依赖它们的规则各配一个 .chatshot-body 孪生选择器 */
    out = out.replace(/(^|[,\n])(\s*)body(?=[.#\[:\s,{])/g, '$1$2body, .chatshot-body');
    out = out.replace(/(^|[,\n])(\s*)html\[data-theme=(['"])([^'"]+)\3\]/g, function (m, p1, p2, q, v) {
      return p1 + p2 + 'html[data-theme=' + q + v + q + '], .chatshot-body[data-theme=' + q + v + q + ']';
    });
    out = out.replace(/:root\[data-theme=(['"])([^'"]+)\1\]/g, ':root[data-theme=$1$2$1], .chatshot-body[data-theme=$1$2$1]');
    out = out.replace(/(^|[,\n])(\s*)\[data-theme=(['"])([^'"]+)\3\]/g, function (m, p1, p2, q, v) {
      return p1 + p2 + '[data-theme=' + q + v + q + '], .chatshot-body[data-theme=' + q + v + q + ']';
    });
    return out + '\n'
      + '*{animation:none !important;transition:none !important;content-visibility:visible !important;contain-intrinsic-size:none !important}\n'
      + '.chatshot-body .phone,.chatshot-body .page,.chatshot-body .app{height:auto !important;max-height:none !important;overflow:visible !important;box-shadow:none !important;border-radius:0 !important}\n'
      + '.chatshot-body .chat-body{height:auto !important;min-height:0 !important;max-height:none !important;overflow:visible !important}\n';
  }

  function csCopyVars(wrap) {
    var bcs = getComputedStyle(document.body), hcs = getComputedStyle(document.documentElement);
    [hcs, bcs].forEach(function (cs) {
      for (var i = 0; i < cs.length; i++) {
        var pr = cs[i];
        if (pr.indexOf('--') === 0) wrap.style.setProperty(pr, cs.getPropertyValue(pr));
      }
    });
    wrap.style.width = '100%';
    wrap.style.fontFamily = bcs.fontFamily;
    wrap.style.fontSize = bcs.fontSize;
    wrap.style.lineHeight = bcs.lineHeight;
    wrap.style.color = bcs.color;
    wrap.style.background = bcs.backgroundColor;
    wrap.style.margin = '0';
    wrap.style.padding = '0';
  }

  function csShell(W, css) {
    var list = document.getElementById('chat-body');
    var chain = [];
    for (var el = list.parentElement; el && el !== document.body; el = el.parentElement) chain.unshift(el);
    var root = null, parent = null;
    chain.forEach(function (node) {
      var c = node.cloneNode(false);
      c.removeAttribute('hidden');
      c.style.cssText += ';height:auto !important;max-height:none !important;overflow:visible !important;flex:none;position:relative;';
      if (parent) parent.appendChild(c); else root = c;
      parent = c;
    });
    var area = list.cloneNode(false);
    area.style.cssText += ';height:auto !important;max-height:none !important;min-height:0 !important;overflow:visible !important;flex:none;';
    if (parent) parent.appendChild(area); else root = area;

    var wrap = document.createElement('div');
    wrap.setAttribute('xmlns', 'http://www.w3.org/1999/xhtml');
    wrap.className = 'chatshot-body';
    Array.prototype.forEach.call(document.body.attributes, function (a) {
      if (a.name === 'class' || a.name.indexOf('data-') === 0) wrap.setAttribute(a.name, a.value);
    });
    var th = document.documentElement.getAttribute('data-theme');
    if (th) wrap.setAttribute('data-theme', th);
    csCopyVars(wrap);
    wrap.style.width = W + 'px';
    var st = document.createElement('style');
    st.textContent = css;
    wrap.appendChild(st);
    wrap.appendChild(root);

    var host = document.createElement('div');
    host.style.cssText = 'position:absolute;left:-99999px;top:0;width:' + W + 'px;pointer-events:none;';
    host.appendChild(wrap);
    document.body.appendChild(host);
    return { host: host, wrap: wrap, area: area };
  }

  function csFixImgs(root) {
    Array.prototype.forEach.call(root.querySelectorAll('img'), function (im) {
      var d = im.getAttribute('data-src') || im.getAttribute('data-favsrc') || im.getAttribute('data-original');
      if (d && !im.getAttribute('src')) im.setAttribute('src', d);
    });
  }
  function csImagesReady(root) {
    var imgs = Array.prototype.slice.call(root.querySelectorAll('img'));
    return Promise.all(imgs.map(function (im) {
      if (im.complete && im.naturalWidth > 0) return null;
      return new Promise(function (r) { im.onload = r; im.onerror = r; setTimeout(r, 2500); });
    }));
  }
  function csOuterH(el) {
    var cs = getComputedStyle(el);
    return el.getBoundingClientRect().height + (parseFloat(cs.marginTop) || 0) + (parseFloat(cs.marginBottom) || 0);
  }

  function csPngBlob(svg, W, H) {
    return new Promise(function (res, rej) {
      var im = new Image();
      im.onload = function () {
        try {
          var scale = Math.max(0.5, Math.min(2, Math.sqrt(16e6 / (W * H))));
          var cv = document.createElement('canvas');
          cv.width = Math.round(W * scale); cv.height = Math.round(H * scale);
          var cx = cv.getContext('2d');
          cx.scale(scale, scale); cx.drawImage(im, 0, 0);
          cv.toBlob(function (b) { b ? res(b) : rej(new Error('encode')); }, 'image/png');
        } catch (e) { rej(e); }
      };
      im.onerror = function () { rej(new Error('svg-render')); };
      im.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(new XMLSerializer().serializeToString(svg));
    });
  }
  function csSave(blob, name) {
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { try { URL.revokeObjectURL(url); } catch (e) {} }, 30000);
  }

  async function csRenderPart(items, W, css, name) {
    var sh = csShell(W, css);
    try {
      items.forEach(function (el) { sh.area.appendChild(el); });
      csFixImgs(sh.wrap);
      await csImagesReady(sh.wrap);
      await csSleep(60);
      var H = Math.max(40, Math.ceil(sh.wrap.getBoundingClientRect().height));
      var NS = 'http://www.w3.org/2000/svg';
      var svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('width', W); svg.setAttribute('height', H);
      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
      var fo = document.createElementNS(NS, 'foreignObject');
      fo.setAttribute('x', '0'); fo.setAttribute('y', '0');
      fo.setAttribute('width', W); fo.setAttribute('height', H);
      fo.appendChild(sh.wrap);
      svg.appendChild(fo);
      var blob = await csPngBlob(svg, W, H);
      csSave(blob, name);
    } finally {
      if (sh.host && sh.host.parentNode) sh.host.parentNode.removeChild(sh.host);
    }
  }

  async function csExport(range) {
    var list = document.getElementById('chat-body');
    if (!list) { csToast('请先在聊天页使用'); return; }
    var kids = Array.prototype.slice.call(list.children).filter(function (el) {
      if (!el.classList) return false;
      return !el.classList.contains('chat-typing') && !el.classList.contains('msg-time-divider')
        && !el.classList.contains('msg-day-tag')
        && !el.classList.contains('chat-loading') && el.id !== 'chat-loading';
    });
    if (range) {
      kids = kids.filter(function (el) {
        var i = Number(el.dataset && el.dataset.idx);
        return !isNaN(i) && i >= range.lo && i <= range.hi;
      });
    }
    if (!kids.length) { csToast('这一段没有可截的消息'); return; }
    var W = list.clientWidth || Math.min(390, document.documentElement.clientWidth || 390);
    var css = csCollectCSS();
    csToast('正在生成长图…');
    /* 量高：先建一份屏外壳把克隆节点全放进去 */
    var probe = csShell(W, css);
    var clones = kids.map(function (el) { var c = el.cloneNode(true); probe.area.appendChild(c); return c; });
    csFixImgs(probe.wrap);
    try { await csImagesReady(probe.wrap); } catch (e) {}
    var BUD = 5200, parts = [], cur = { items: [], h: 0 };
    clones.forEach(function (el) {
      var h = csOuterH(el);
      if (cur.items.length && cur.h + h > BUD) { parts.push(cur); cur = { items: [], h: 0 }; }
      cur.items.push(el); cur.h += h;
    });
    if (cur.items.length) parts.push(cur);
    if (probe.host && probe.host.parentNode) probe.host.parentNode.removeChild(probe.host);
    var cut = false;
    if (parts.length > 20) { parts = parts.slice(parts.length - 20); cut = true; }
    var d = new Date(), pad = function (x) { return x < 10 ? '0' + x : '' + x; };
    var stamp = d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate()) + '-' + pad(d.getHours()) + pad(d.getMinutes());
    try {
      for (var k = 0; k < parts.length; k++) {
        var nm = '聊天长图-' + stamp + (parts.length > 1 ? '-' + (k + 1) : '') + '.png';
        await csRenderPart(parts[k].items, W, css, nm);
        await csSleep(420);
      }
      csToast((cut ? '记录太长，已存最近 20 张 · ' : '') + '长图已保存（' + parts.length + ' 张 · ' + clones.length + ' 条）');
    } catch (e) {
      csToast('生成失败：' + (e && e.message ? e.message : '换个浏览器试试'));
    }
  }
  window.chatShotExport = csExport;

  function csActLabel() {
    var lab = document.getElementById('cs-shot-act-label');
    if (!lab) return;
    var i = window.__csActiveIdx;
    if (CS_FROM == null) lab.textContent = '长图起点';
    else if (String(CS_FROM) === String(i)) lab.textContent = '取消起点';
    else lab.textContent = '截到这里';
  }
  function csClosest(t, sel) {
    while (t && t !== document) {
      if (t.matches && t.matches(sel)) return t;
      t = t.parentNode;
    }
    return null;
  }
  document.addEventListener('click', function (e) {
    var t = e.target;
    var shot = csClosest(t, '#more-chatshot');
    if (shot) {
      e.preventDefault(); e.stopPropagation();
      var mp = document.getElementById('chat-more-panel'); if (mp) mp.hidden = true;
      csExport(null); return;
    }
  }, true);
})();
</script>

<script>
/* v61 开屏界面：视频 / 图片 / 音乐三区 + 随机顺序 + 严格搭配 + 数字进度条。
   规则：一次只出「视频+音乐」或「图片+音乐」，视频与图片绝不共存。
   进度条走到 100% 只把「正在连接…」换成「连接成功…」，不跳桌面。 */
(function () {
  'use strict';
  var KEY = 'op-v61-cfg', NS = 'xy-home-v2';
  var store = window.xyStore ? window.xyStore(NS) : {
    get: function (k) { try { return localStorage.getItem(NS + ':' + k); } catch (e) { return null; } },
    set: function (k, v) { try { localStorage.setItem(NS + ':' + k, v); } catch (e) {} }
  };
  var OP_BLOB = {};
  /* 静态站点的媒体资源必须带当前链接的 sharecode 才能取到，否则服务端回「链接不完整」403 */
  var OP_Q = '';
  try {
    var _mq = /[?&]sharecode=([^&#]+)/.exec(location.search || '');
    if (_mq) {
      OP_Q = 'sharecode=' + encodeURIComponent(_mq[1]);
      try { localStorage.setItem('mochi-sharecode', _mq[1]); } catch (eS1) {}
    } else {
      /* v92g：从历史记录/恢复的标签打开时 URL 可能丢参数——用上次记住的 sharecode 兜底，
        否则媒体资源会 403（开屏没视频没音乐的隐性原因之一） */
      var _sc = localStorage.getItem('mochi-sharecode');
      if (_sc) OP_Q = 'sharecode=' + encodeURIComponent(_sc);
    }
  } catch (eQ) {}
  var cfg = null;
  var curVisual = null, curMusic = null, curImgIdx = 0;
  var opAudio = null, opImgTimer = null, opProgTimer = null;
  var opDismissed = false;   /* v63：用户是否已点开屏进入网站，用于进站兜底门控 */
  /* v66：只在起播同步一次；视频 / 音乐各自独立循环。进桌面不停音乐（选 B）。 */
  var opSyncTimer = null, opAudioUnlocked = false, opGestureBound = false, opUnmuteTimer = null;
  var opLastVTime = 0, opAligned = false;
  var opMusicOff = false;
  try { opMusicOff = localStorage.getItem('mochi-op-music-off') === '1'; } catch (eOffR) {}
  var ZONES = [
    { k: 'video', ico: '▶', accept: 'video/*', add: '＋ 添加视频' },
    { k: 'image', ico: '▣', accept: 'image/*', add: '＋ 添加图片' },
    { k: 'music', ico: '♪', accept: '', add: '＋ 上传音乐文件' }
  ];
  function $(id) { return document.getElementById(id); }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function grad(c1, c2, label) {
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="720" height="1280"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="' + c1 + '"/><stop offset="1" stop-color="' + c2 + '"/></linearGradient></defs><rect width="100%" height="100%" fill="url(#g)"/><text x="50%" y="50%" fill="#ffffff" fill-opacity=".82" font-size="44" text-anchor="middle" font-family="sans-serif" letter-spacing="8">' + label + '</text></svg>';
    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
  }
  function defCfg() {
    return {
      names: { video: '视频区', image: '图片区', music: '音乐区' },
      list: {
        video: [{ id: 'v-preset', name: '开屏视频', src: 'media/opening-video.mp4', local: false }],
        image: [
          { id: 'i-1', name: '暮色', src: grad('#5b4b7a', '#20233b', '暮色'), local: false },
          { id: 'i-2', name: '夜航', src: grad('#274060', '#0d1b2a', '夜航'), local: false },
          { id: 'i-3', name: '晨光', src: grad('#c98a6b', '#5a3b56', '晨光'), local: false }
        ],
        music: [
          { id: 'm-1', name: '音乐 1', src: 'media/opening-1.mp3', local: false },
          { id: 'm-2', name: '音乐 2', src: 'media/opening-2.mp3', local: false },
          { id: 'm-3', name: '音乐 3', src: 'media/opening-3.mp3', local: false },
          { id: 'm-4', name: '音乐 4', src: 'media/opening-4.mp3', local: false }
        ]
      },
      mode: 'random', pair: 'video', next: null,
      orderIdx: { video: 0, image: 0, music: 0 },
      auto: false, vsound: false
    };
  }
  function loadCfg() {
    var d = defCfg(), c = null;
    try { c = JSON.parse(store.get(KEY) || 'null'); } catch (e) {}
    if (!c || typeof c !== 'object') { d.__default = true; return d; }
    if (c.names) d.names = Object.assign(d.names, c.names);
    if (c.list) ZONES.forEach(function (z) { if (Array.isArray(c.list[z.k])) d.list[z.k] = c.list[z.k]; });
    if (c.mode === 'random' || c.mode === 'order') d.mode = c.mode;
    if (c.pair === 'video' || c.pair === 'image') d.pair = c.pair;
    if (c.next && typeof c.next === 'object') d.next = c.next;
    if (c.orderIdx) d.orderIdx = Object.assign(d.orderIdx, c.orderIdx);
    d.auto = !!c.auto; d.vsound = !!c.vsound;
    opResetDeadOnce(d);   /* v92v：升级后清一次音乐区旧失效标记 */
    return d;
  }
  /* v87（修复「刷新后开屏没有视频、单击没有音乐」）：
     store.get 在大键回填/存储未就绪时会短暂读到 null，老代码拿到 null 后直接用默认搭配，
     还会把默认搭配写回存储——用户自己添加的视频 / 音乐搭配就这样被冲掉了。
     ① cfg 读取加 IDB 兜底（当前前缀键 + 历史 xy-home-v2:op-v61-cfg，取「更丰满」的那份）；
     ② 默认搭配绝不写回存储，避免覆盖用户数据；
     ③ 开屏启动改为等 cfg 就绪（带 1.6s 超时）再搭配播放，进度条先照常走。 */
  function opCfgRichness(c) {
    if (!c || !c.list) return -1;
    var n = 0, custom = 0;
    ZONES.forEach(function (z) {
      var l = c.list[z.k];
      if (!Array.isArray(l)) return;
      n += l.length;
      l.forEach(function (it) { if (it && !(it.id === 'v-preset' || /^i-[123]$/.test(String(it.id)) || /^m-[1234]$/.test(String(it.id)))) custom++; });
    });
    return custom * 1000 + n;
  }
  function opMergeCfg(raw) {
    var c;
    try { c = JSON.parse(raw); } catch (e) { return null; }
    if (!c || typeof c !== 'object') return null;
    var d = loadCfgBase();
    if (c.names) d.names = Object.assign(d.names, c.names);
    if (c.list) ZONES.forEach(function (z) { if (Array.isArray(c.list[z.k])) d.list[z.k] = c.list[z.k]; });
    if (c.mode === 'random' || c.mode === 'order') d.mode = c.mode;
    if (c.pair === 'video' || c.pair === 'image') d.pair = c.pair;
    if (c.next && typeof c.next === 'object') d.next = c.next;
    if (c.orderIdx) d.orderIdx = Object.assign(d.orderIdx, c.orderIdx);
    d.auto = !!c.auto; d.vsound = !!c.vsound;
    opResetDeadOnce(d);   /* v92v：升级后清一次音乐区旧失效标记 */
    return d;
  }
  function loadCfgBase() {
    var d = defCfg();
    d.__default = true;
    return d;
  }
  function opCfgIdbKeys() {
    var keys = [];
    try { var pfx = (window.activePrefix ? window.activePrefix() : 'default') || 'default'; keys.push(NS + ':' + pfx + ':' + KEY); } catch (eK1) {}
    keys.push(NS + ':' + KEY);            /* v83 之前的历史落点 */
    return keys;
  }
  function opLoadCfgAsync() {
    var sync = loadCfg();                  /* memoryCache / localStorage 快路径 */
    if (!sync.__default) return Promise.resolve(sync);
    if (!window.idbGet) return Promise.resolve(sync);
    var done = false;
    return Promise.race([
      new Promise(function (res) { setTimeout(function () { if (!done) { done = true; res(sync); } }, 1600); }),
      (function () {
        var keys = opCfgIdbKeys();
        return Promise.all(keys.map(function (k) {
          return Promise.resolve(window.idbGet(k)).then(function (v) {
            var c = null;
            try { c = (typeof v === 'string') ? JSON.parse(v) : (v && typeof v === 'object' ? v : null); } catch (eP) {}
            return c || null;
          }, function () { return null; });
        })).then(function (found) {
          if (done) return sync;
          done = true;
          var best = null, bestScore = -1;
          found.forEach(function (c) { var s = opCfgRichness(c); if (s > bestScore) { bestScore = s; best = c; } });
          var merged = best ? opMergeCfg(JSON.stringify(best)) : null;
          if (merged && opCfgRichness(merged) > opCfgRichness(sync)) {
            merged.__default = false;
            try { store.set(KEY, JSON.stringify(merged)); } catch (eBack) {}   /* 迁回正式落点 */
            return merged;
          }
          return sync;
        }, function () { if (!done) { done = true; } return sync; });
      })()
    ]);
  }
  function saveCfg() {
    /* v87：UI 主动改动＝允许把默认搭配落盘；开机自动流程走 saveCfgSoft（默认不落盘） */
    if (cfg && cfg.__default) { try { delete cfg.__default; } catch (eD) { cfg.__default = false; } }
    try { store.set(KEY, JSON.stringify(cfg)); } catch (e) {}
  }
  function saveCfgSoft() {
    /* v87：默认搭配绝不写回存储，避免覆盖用户数据 */
    if (cfg && cfg.__default) return;
    try { store.set(KEY, JSON.stringify(cfg)); } catch (e) {}
  }
  function opSrcSync(it) {
    if (!it) return '';
    if (it.local) return OP_BLOB[it.id] || '';
    var u = it.src || '';
    if (OP_Q && /^media\//.test(u) && u.indexOf('sharecode=') < 0) u += (u.indexOf('?') >= 0 ? '&' : '?') + OP_Q;
    return u;
  }
  function opEnsureSrc(it) {
    return new Promise(function (res) {
      if (!it) { res(''); return; }
      var s = opSrcSync(it);
      if (s) { res(s); return; }
      if (!it.local || !window.idbGet) { res(''); return; }
      try {
        Promise.resolve(window.idbGet('op-media:' + it.id)).then(function (v) {
          try {
            if (v && typeof v === 'object') OP_BLOB[it.id] = URL.createObjectURL(v);
            else if (typeof v === 'string' && v.indexOf('data:') === 0) OP_BLOB[it.id] = v;
          } catch (e) {}
          res(OP_BLOB[it.id] || '');
        }, function () { res(''); });
      } catch (e) { res(''); }
    });
  }
  function opPickFrom(list, key) {
    if (!list || !list.length) return null;
    if (cfg.mode === 'order') {
      var i = cfg.orderIdx[key] || 0;
      var it = list[((i % list.length) + list.length) % list.length];
      cfg.orderIdx[key] = (i + 1) % list.length;
      return it;
    }
    return list[Math.floor(Math.random() * list.length)];
  }
  /* v89：失效素材自愈——加载失败（404 / 本地文件丢失）的条目标记 _dead，
     之后挑选、重试、预设全部跳过；面板里显示「已失效」。治「选了视频和音乐却播不出」：
     预置 media/*.mp4 在单文件部署里根本不存在，旧配置里残留的这些条目会把整条链拖死。 */
  function opAlive(arr) { return (arr || []).filter(function (x) { return x && !x._dead; }); }
  /* v92v→v92w：一次性复位音乐区 _dead——v92q/t「是视频就标失效」、v92v「API 不存在
     就当无音轨」都误杀过带声音的音乐，升级后重新探测（结论不明一律放行），
     把音乐区旧标记清一次。只清音乐区，视频区预置素材的真失效标记不动 */
  function opResetDeadOnce(d) {
    try {
      if (!d || d.__default || !d.list || !Array.isArray(d.list.music)) return;
      if (store.get('op-v92w-deadreset') === '1') return;
      store.set('op-v92w-deadreset', '1');
      d.list.music.forEach(function (x) { if (x) delete x._dead; });
    } catch (e0) {}
  }
  function opMarkDead(it) {
    if (!it || it._dead) return;
    it._dead = 1;
    try { saveCfgSoft(); } catch (e) {}
    try {
      if (!window.__opDeadToasted) { window.__opDeadToasted = 1; toast('「' + (it.name || '素材') + '」加载失败，已自动跳过'); }
    } catch (e2) {}
  }
  /* v89：当前画面区全失效时自动切到另一区（视频↔图片），别锁死在白屏区 */
  function opEnsureAlivePair() {
    var vz = cfg.pair;
    if (!opAlive(cfg.list[vz]).length) {
      var other = vz === 'video' ? 'image' : 'video';
      if (opAlive(cfg.list[other]).length) { cfg.pair = other; vz = other; }
    }
    return vz;
  }
  function opChoose() {
    var vz = opEnsureAlivePair();             /* 只可能是 video 或 image */
    var vl = opAlive(cfg.list[vz]), ml = opAlive(cfg.list.music);
    var out = null;
    if (cfg.next && cfg.next.pair === cfg.pair) {
      var nv = vl.filter(function (x) { return x.id === cfg.next.visualId; })[0];
      var nm = ml.filter(function (x) { return x.id === cfg.next.musicId; })[0];
      if (cfg.next.visualId && cfg.next.musicId && (!nv || !nm)) { cfg.next = null; }
      else out = { visual: nv || opPickFrom(vl, vz), music: nm || opPickFrom(ml, 'music') };
      cfg.next = null; saveCfgSoft();         /* 预设用一次即清，避免一直锁死 */
    }
    if (!out) out = { visual: opPickFrom(vl, vz), music: opPickFrom(ml, 'music') };
    saveCfgSoft();
    return out;
  }
  function opUpdateNow(n) {
    var k = $('op-now-k'), v = $('op-now-v'), m = $('op-now-m');
    if (k) k.textContent = (cfg.pair === 'video' ? '视频' : '图片') + ' ＋ 音乐 · ' + (cfg.mode === 'random' ? '随机' : '顺序');
    if (v) v.textContent = n.visual ? n.visual.name : '暂无画面素材';
    if (m) m.textContent = n.music ? ('♪ ' + n.music.name) : '暂无音乐';
  }
  function opTapHint(show) { var h = $('op-tap-hint'); if (h) h.hidden = true; }  /* v63：进站即显示开屏、点任意处进入，不再提示「点一下开始播放」 */
  /* v66：视频与音乐只在「起播那一刻」同步一次，之后各自独立循环、互不干涉：
     · 视频 loop 自己循环，循环回绕不再 seek 音乐；
     · 音乐 loop 播完原本完整内容后自己回到开头，全程不被视频对齐打断；
     · v72：进桌面即自动停止开屏音乐（撤销 v66 选 B），音乐只在开屏页播放。
     浏览器拦截无手势有声自动播放：静音起播保证时间轴一起走，首次手势立即出声。 */
  function ensureAudio() {
    if (opAudio) return;
    opAudio = new Audio();
    opAudio.preload = 'auto'; opAudio.style.display = 'none';
    opAudio.loop = true;      /* 音乐播完原本内容后再循环 */
    opAudio.muted = true;     /* v67b：出生即静音——静音自动播放才是所有浏览器都放行的 */
    document.body.appendChild(opAudio);
    /* v67：媒体一就绪就起播，别再等那两次 260ms 轮询——
       「刷新后只有视频没有音乐」很多时候就是音乐文件比视频慢，轮询早过了。 */
    ['canplay', 'loadeddata', 'canplaythrough'].forEach(function (evn) {
      opAudio.addEventListener(evn, function () {
        var pg = $('page-opening');
        if (!pg || pg.hidden || pg.classList.contains('op-config') || opAudioUnlocked || opMusicOff) return;
        if (opAudio.paused) opFallbackMutedPlay();
        opAlignOnce();
      });
    });
  }
  /* 起播一次性对齐：把音乐进度对到视频当前时间，只在一次搭配开始时执行一次。 */
  function opAlignOnce() {
    if (opAligned || !opAudio || !cfg || cfg.pair !== 'video') return;
    var v = $('op-video');
    if (!v || v.readyState < 1) return;
    var ad = opAudio.duration;
    if (!isFinite(ad) || ad <= 0) return;
    try {
      var vt = v.currentTime || 0;
      var target = vt % ad;
      var cur = opAudio.currentTime || 0;
      var diff = Math.abs(cur - target);
      if (Math.min(diff, Math.abs(ad - diff)) > 0.35) opAudio.currentTime = target;
      opAligned = true;
      opLastVTime = vt;
    } catch (eAlign) {}
  }
  /* 兼容旧调用点（手势解锁 / play().then）：本质都只是「起播对齐一次」，
     已对齐就直接返回，绝不再周期性 seek 音乐。 */
  function opSyncAudioToVideo() { opAlignOnce(); }
  function opStartAudioSync() {
    if (opSyncTimer) { clearInterval(opSyncTimer); opSyncTimer = null; }
  }
  /* 首次任意手势（含 pointerdown / touchstart）立刻取消静音、对齐视频并出声。
     监听常驻但已解锁时直接返回，不影响正常点击。 */
  function opBindGestureUnlock() {
    if (opGestureBound) return;
    opGestureBound = true;
    var unlock = function () {
      var pg = $('page-opening');
      /* v72：只在开屏页可见时解锁/续播。进桌面后音乐已由 opStopAll 停掉，
         若这里还响应桌面手势，用户点一下就会把开屏音乐重新唤醒。 */
      if (!pg || pg.hidden) return;
      /* v92z：搭配面板模式下不解锁——面板里点任何按钮都不该把音乐放出来 */
      if (pg.classList.contains('op-config')) return;
      if (!opAudio || opMusicOff) return;
      /* v70：开屏上任意一次触摸就把音乐放出来，不用等到进主页。 */
      /* 已经解锁但被浏览器暂停（切后台、来电）也要能续上 */
      if (opAudioUnlocked) {
        if (opAudio.paused) {
          try { opAudio.muted = false; opAudioTryPlay(); } catch (eR2) {}
        }
        return;
      }
      try {
        opAudio.muted = false; opAudio.volume = 1;
        opSyncAudioToVideo();
        if (opAudio.paused) opAudioTryPlay();
        opAudioUnlocked = true;
      } catch (eUnlock) {}
    };
    ['pointerdown', 'touchstart', 'touchend', 'click', 'keydown', 'wheel'].forEach(function (ev) {
      document.addEventListener(ev, unlock, { capture: true, passive: true });
    });
    /* 从后台切回前台也续一次（手机锁屏再解锁是常见场景） */
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') unlock();
    });
  }
  /* 静音自动播放被所有浏览器允许：让音频时间轴跟视频一起走起来（音画同步），
     保持静音等首次手势再取消静音出声。绝不试探性 un-mute——浏览器在无手势
     取消静音时会把音频 pause，那反而停掉音乐。 */
  function opFallbackMutedPlay() {
    var pg = $('page-opening');
    if (!pg || pg.hidden || pg.classList.contains('op-config') || !opAudio || opMusicOff) return;
    try {
      if (!opAudioUnlocked) opAudio.muted = true;
      var pr2 = opAudio.play();
      if (pr2 && pr2.catch) pr2.catch(function () {});
    } catch (eMuted) {}
  }
  /* v64：不依赖 play() 的 Promise 状态。浏览器拦截「无手势有声自动播放」时，
     这个 Promise 可能一直 pending（既不 resolve 也不 reject），旧代码只挂 .catch，
     兜底永远不触发 → 音乐一直不响，只有点「重新连接」按钮（用户手势）才有声。
     现在：进站就有声尝试 + 主动延时轮询（仍 paused 就静音起播）+ 首次手势解锁，
