key: 'gf:' + g.id, rec: g, mine: false
})).concat(d.theirs.filter(t => t.fav).slice().reverse().map(t => ({
ts: t.ts, ico: '💌', text: t.text, sub: pn() + '捡到的', key: 'tf:' + t.id, rec: t, mine: false
