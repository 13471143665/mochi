var p2 = function (x) { return (x < 10 ? '0' : '') + x; };
var fname = 'mochi-card-audit-' + d.getFullYear() + p2(d.getMonth() + 1) + p2(d.getDate()) + '-' + p2(d.getHours()) + p2(d.getMinutes()) + '.docx';
if (typeof window.mochiDiagExportDocx === 'function') {
try {
