const m = n < UTF8_SAMPLE ? n : UTF8_SAMPLE;
let extra = 0, quoted = 0; // extra＝相对「1 字节/字符」多出的字节；quoted＝转义后会多 1 字节的字符数
for (let i = 0; i < m; i++) {
const c = str.charCodeAt(i);
