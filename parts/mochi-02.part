function renderCook() {
const c = loadCook();
let html = '<div class="fish-sub">厨房</div>';
html += '<div class="fish-subhead">我的灶台</div>';
if (!c.mine.length) html += '<div class="fish-empty">灶台空着，从下面选鱼烹饪</div>';
