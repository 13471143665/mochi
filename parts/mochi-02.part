const firstClear = firsts.indexOf(g.diff) < 0;
if (firstClear) { firsts.push(g.diff); writeFirst(firsts); }
const totalYuan = COIN_CLEAR + Math.round(g.coinFen / YUAN) + COIN_ALL + (firstClear ? COIN_FIRST : 0);
