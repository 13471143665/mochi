const k = idbKeys[cursor++];
expKey = k;
expKeyBytes = 0;
try {
    if (k.indexOf('xy-home-v2:') !== 0 && !OP_MEDIA_KEY_RE.test(k)) continue; /* v92q：开屏搭配媒体文件一并进完整备份 */
    if (k === SNAPSHOT_KEY) continue; // v3.7.0：副本键不进导出文件
