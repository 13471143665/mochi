const reCat = kind === 'taste' && it.g === 'like';
let phase = reCat ? 'cat' : 'text', newCat = it.cat || '', ctl = null;
ctl = window.openModal('编辑', it.t, function (v) {
if (phase === 'cat') {
if (!v) return;
newCat = String(v); phase = 'text';
