ocean:   { ico: '🌊', name: '海洋', kinds: ['🐬', '🐟', '🐠', '🦈', '🐙', '🦀', '🐡', '🦐', '🐳', '🐚', '🌊', '⛵', '🪸', '⭐', '🫧', '🦞', '🦑', '🦦', '🦭', '🐢', '⚓', '🎣', '🚤', '💧', '🧜', '🐋', '🦩'] },
animal:  { ico: '🦊', name: '动物', kinds: ['🐰', '🐱', '🐶', '🐭', '🐹', '🐻', '🐼', '🐨', '🦁', '🐮', '🐷', '🐸', '🐵', '🦊', '🐔', '🦆', '🦉', '🐧', '🦄', '🐝', '🦋', '🐞', '🐌', '🐢', '🐬', '🦜', '🐾'] },
bloom:   { ico: '🌷', name: '繁花', kinds: ['🌸', '🌹', '🌷', '🌻', '🌺', '💐', '🌼', '🌿', '🍀', '🌱', '🌵', '🎋', '🍁', '🍂', '🍃', '🌾', '🪷', '🪻', '🌴', '🌳', '🌲', '🍄', '🌰', '🥀', '🏵️', '💮', '🎄'] }
