else { if (storeSetScope(u.scope, u.key, u.old)) n++; }
});
undoStack = [];
updateUndoBtn();
try { if (window.dcfRefreshUI) DCF.forEach(function (d) { window.dcfRefreshUI(d[0]); }); } catch (e) {}
render();
toast(n ? '已撤销上次修复' : '撤销失败');
