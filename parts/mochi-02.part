var res = false;
try { res = fn(); } catch (e) { res = 'fail'; }
try { if (res !== false && res !== 'fail' && window.dcfRefreshUI) DCF.forEach(function (d) { window.dcfRefreshUI(d[0]); }); } catch (e) {}
