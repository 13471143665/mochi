+ '版本：' + appVer() + '\n时间：' + new Date().toLocaleString() + '\n设备：' + (navigator.userAgent || '');
}
var head = '版本：' + appVer()
+ '\n时间：' + new Date().toLocaleString()
+ '\n设备：' + (navigator.userAgent || '')
+ '\n当前桌面：' + deskName(activeCid())
+ (buildErr ? '\n自检中途出错：' + buildErr : '')
+ '\n\n';
