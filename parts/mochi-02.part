      '#aiePsFold[hidden]{display:none}',
      '.aie-box p{margin:0 0 9px;font-size:10.5px;color:#a396ab;line-height:1.55}',
      '.aie-ck{display:flex;align-items:center;gap:9px;padding:6px 0;font-size:12.5px;color:#403447;border-bottom:1px dashed #f1ebf6}',
      '.aie-ck:last-child{border-bottom:0}',
      '.aie-ck input{width:17px;height:17px;accent-color:#8f5fd0;flex:none}',
