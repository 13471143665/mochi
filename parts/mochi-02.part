const hubStyle = document.createElement('style');
hubStyle.textContent =
'.fhub-tabs{display:flex;gap:8px;overflow-x:auto;padding:2px 14px 8px;scrollbar-width:none}.fhub-tabs::-webkit-scrollbar{display:none}' +
'.fhub-tag{flex:0 0 auto;padding:6px 13px;border-radius:20px;font-size:12px;color:var(--muted,#666);background:rgba(0,0,0,.055);white-space:nowrap;cursor:pointer;transition:background .15s,color .15s;-webkit-tap-highlight-color:transparent}.fhub-tag:active{transform:scale(.97)}.fhub-tag.on{color:#fff;background:#111}' +
'.fhub-hot{display:flex;gap:8px;align-items:center;padding:10px 2px 0}.fhub-hot-label{flex:0 0 auto;font-size:12px;color:var(--muted,#999)}' +
'.fhub-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:10px 0 4px}' +
'.fhub-cat{position:relative;padding:12px;border-radius:16px;cursor:pointer;-webkit-tap-highlight-color:transparent}.fhub-cat:active{transform:scale(.97)}' +
'.fhub-cat-ico{width:36px;height:36px;border-radius:10px;background:rgba(0,0,0,.055);display:flex;align-items:center;justify-content:center;margin-bottom:9px}' +
'.fhub-cat-ico svg{width:20px;height:20px;stroke:var(--ink,#111)}' +
'.fhub-cat-name{font-size:14px;font-weight:600;line-height:1.3;padding-right:30px}' +
'.fhub-cat-n{position:absolute;top:10px;right:10px;font-size:11px;color:var(--muted,#999);background:rgba(0,0,0,.05);border-radius:10px;padding:2px 8px;font-weight:600}' +
'[data-theme="dark"] .fhub-tag{background:rgba(255,255,255,.09)}' +
'[data-theme="dark"] .fhub-tag.on{background:var(--ink,#eee);color:var(--card-bg,#1e1e1e)}' +
'[data-theme="dark"] .fhub-cat-ico{background:rgba(255,255,255,.09)}' +
'[data-theme="dark"] .fhub-cat-n{background:rgba(255,255,255,.09)}' +
'.fhub-seen-bar{display:flex;align-items:center;gap:10px;margin:10px 0 0;padding:12px 14px;border-radius:16px;background:rgba(47,111,208,.1);cursor:pointer;-webkit-tap-highlight-color:transparent}' +
'.fhub-seen-bar:active{transform:scale(.98)}' +
'.fhub-seen-t{flex:1;min-width:0;font-size:13px;font-weight:700;color:#2f6fd0;line-height:1.4}' +
'.fhub-seen-go{flex:0 0 auto;font-size:12px;font-weight:700;color:#2f6fd0}' +
'[data-theme="dark"] .fhub-seen-bar{background:rgba(47,111,208,.16)}' +
'[data-theme="dark"] .fhub-seen-t,[data-theme="dark"] .fhub-seen-go{color:#8fb4ef}' +
'.fhub-badge{display:inline-block;margin-top:4px;margin-right:6px;font-size:11px;font-weight:700;color:#2f6fd0}' +
'[data-theme="dark"] .fhub-badge{color:#8fb4ef}';
document.head.appendChild(hubStyle);
const body = document.getElementById('fhub-body');
const page = document.getElementById('page-featurehub');
if (!body || !page) return;
const tags = document.getElementById('fhub-tags');
const input = document.getElementById('fhub-search');
const empty = document.getElementById('fhub-empty');
const ARROW = '<div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>';
function entryRow(it) {
const row = document.createElement('div');
row.className = 'set-row';
row.innerHTML = '<div class="txt">' + it.n + '<span class="sub">' + it.d + '</span></div>' + ARROW;
row.addEventListener('click', () => jump(it));
return row;
}
function groupBlock(grp) {
const wrap = document.createElement('div');
const title = document.createElement('div');
title.className = 'gs-title';
title.textContent = grp.g;
const card = document.createElement('div');
card.className = 'set-group glass';
grp.items.forEach(it => card.appendChild(entryRow(it)));
wrap.appendChild(title);
wrap.appendChild(card);
wrap.style.display = 'none';
return wrap;
}
const FREQ_KEY = 'xy-home-v2:fhub-freq';
const HOT_N = 4;
const home = document.createElement('div');
const hot = document.createElement('div');
hot.className = 'fhub-hot';
home.appendChild(hot);
const byName = {};
HUB.forEach(grp => grp.items.forEach(it => { if (!byName[it.n]) byName[it.n] = it; }));
let freq = {};
function renderHot() {
const names = Object.keys(freq).filter(n => byName[n] && freq[n] > 0)
.sort((a, b) => freq[b] - freq[a]).slice(0, HOT_N);
hot.style.display = names.length ? '' : 'none';
hot.innerHTML = names.length ? '<span class="fhub-hot-label">常用</span>' : '';
names.forEach(nm => {
const it = byName[nm];
const c = document.createElement('div');
c.className = 'fhub-tag';
c.textContent = it.n;
c.addEventListener('click', () => jump(it));
hot.appendChild(c);
});
}
function loadFreq() {
try { freq = JSON.parse(localStorage.getItem(FREQ_KEY)) || {}; } catch (e) { freq = {}; }
renderHot();
if (typeof window.idbGet === 'function') {
try { window.idbGet(FREQ_KEY).then(v => { if (v && typeof v === 'object' && Object.keys(v).length) { freq = v; renderHot(); } }).catch(() => {}); } catch (e) {}
}
}
function bumpFreq(it) {
freq[it.n] = (freq[it.n] || 0) + 1;
try { localStorage.setItem(FREQ_KEY, JSON.stringify(freq)); } catch (e) { /* 存储满不影响跳转 */ }
if (typeof window.idbSet === 'function') { try { window.idbSet(FREQ_KEY, freq).catch(() => {}); } catch (e) {} }
renderHot();
}
renderHot();
loadFreq();
const grid = document.createElement('div');
grid.className = 'fhub-grid';
HUB.forEach((grp, gi) => {
const tile = document.createElement('div');
tile.className = 'fhub-cat glass';
tile.innerHTML = '<div class="fhub-cat-n">' + grp.items.length + '</div>' +
'<div class="fhub-cat-ico">' + (CAT_ICO[gi] || '') + '</div>' +
'<div class="fhub-cat-name">' + grp.g + '</div>';
tile.addEventListener('click', () => { if (input) input.value = ''; setHubView(gi); });
grid.appendChild(tile);
});
home.appendChild(grid);
body.appendChild(home);
let view = 'home';
const SEEN_KEY = 'xy-home-v2:fhub-seen';
let seen = {};
let seenReady = false; // IDB 为准（同 fhub-freq 口径）：回填完成前名单可能偏多，不闪存量假数字
const MARK_BY_APP = {}, MARK_BY_ID = {};
let inUnseen = false; // #937 unseen 视闩：横幅点开置位；视图被复位（切页/退出）而闩仍在时跟随重建
function setHubView(v) { inUnseen = false; view = v; update(); }
HUB.forEach(grp => grp.items.forEach(it => {
const go = it.go || [];
const sel = (go.length > 1 ? go[go.length - 1] : go[0]) || '';
if (!sel || it.__seenIds) return;
it.__seenIds = true; // 闩在同一条目上：防自身重复登记；多条目共用一个选择器时各进名单（点了同一入口都算到达）
if (sel.indexOf('[data-app=') >= 0) {
const q = /"([^"]+)"|'([^']+)'/;
const v = q.exec(sel.slice(sel.indexOf('[data-app=')));
const app = v ? (v[1] || v[2]) : '';
if (app) (MARK_BY_APP[app] = MARK_BY_APP[app] || []).push({ g: grp.g, n: it.n });
} else if (/^#[A-Za-z][\w-]*$/.test(sel)) {
(MARK_BY_ID[sel.slice(1)] = MARK_BY_ID[sel.slice(1)] || []).push({ g: grp.g, n: it.n });
}
}));
function bumpSeen(names) {
if (!seenReady) return; // 等 IDB 合并后再写，防 LS 残值覆盖更全的 IDB 快照
let touched = 0;
names.forEach(o => { if (!seen[o.n]) { seen[o.n] = Date.now(); touched++; } });
if (!touched) return;
try { localStorage.setItem(SEEN_KEY, JSON.stringify(seen)); } catch (e) { /* 存储满不影响提醒 */ }
if (typeof window.idbSet === 'function') { try { window.idbSet(SEEN_KEY, seen).catch(() => {}); } catch (e) {} }
renderSeen();
}
function loadSeen() {
try { seen = JSON.parse(localStorage.getItem(SEEN_KEY)) || {}; } catch (e) { seen = {}; }
const ready = () => { seenReady = true; renderSeen(); };
if (typeof window.idbGet === 'function') {
try {
window.idbGet(SEEN_KEY).then(v => {
if (v && typeof v === 'object') { Object.keys(v).forEach(k => { if (!seen[k]) seen[k] = v[k]; }); }
ready();
}).catch(ready);
} catch (e) { ready(); }
}
setTimeout(ready, 1500); // idbGet 挂起时静默（fhub-freq 同款口径）：兜底用 LS 初值解锁，幂等
}
function unseenList() {
if (!seenReady) return [];
const out = [];
HUB.forEach(grp => { const items = grp.items.filter(it => !seen[it.n]); if (items.length) out.push({ g: grp.g, items }); });
return out;
}
document.addEventListener('click', e => {
try {
const t = e.target;
if (!t || !t.closest) return;
const app = t.closest('[data-app]');
if (app) { const l = MARK_BY_APP[app.dataset.app]; if (l) bumpSeen(l); return; }
const byId = t.closest('[id]');
if (byId) { const l = MARK_BY_ID[byId.id]; if (l) bumpSeen(l); }
} catch (err) {}
}, true);
const seenBar = document.createElement('div');
seenBar.className = 'fhub-seen-bar';
seenBar.id = 'fhub-seen-bar';
seenBar.innerHTML = '<div class="fhub-seen-t"></div><div class="fhub-seen-go">去看看 →</div>';
seenBar.style.display = 'none';
seenBar.addEventListener('click', () => { if (input) input.value = ''; inUnseen = true; view = 'unseen'; update(); });
home.insertBefore(seenBar, grid);
const hubRow = document.getElementById('row-featurehub');
function renderSeen() {
const un = unseenList();
const n = un.reduce((s, g) => s + g.items.length, 0);
if (inUnseen && !n) inUnseen = false; // 名单清零＝自动退出未试视图
seenBar.style.display = (n && view !== 'unseen' && !inUnseen) ? '' : 'none';
seenBar.querySelector('.fhub-seen-t').textContent = '还没试过：' + n + ' 个功能';
if (hubRow) {
let b = hubRow.querySelector('.fhub-badge');
if (n) {
if (!b) { b = document.createElement('span'); b.className = 'fhub-badge'; const txt = hubRow.querySelector('.txt'); if (txt) txt.insertBefore(b, txt.querySelector('.sub') || null); }
b.textContent = n + ' 个没试过';
} else if (b) b.remove();
}
if (view === 'unseen' && inUnseen) update(); // 名单在视闩期间变化（点掉一条）→ 就地重建过滤列表
else if (view === 'unseen') setHubView('home'); // 名单清零 → 退出过滤视图（否则系统返回手势会退回这张过期空列表）
}
const groups = [];
let built = false;
function ensureBuilt() {
if (built) return; // 幂等：切回重进不再重建
built = true;
HUB.forEach(grp => groups.push(groupBlock(grp)));
groups.forEach(el => body.appendChild(el));
update(); // 首建后按当前视图（home）落一次显隐，横幅/角标同步
}
if (tags) {
[['首页', 'home']].concat(HUB.map((g, i) => [g.g, i])).forEach((pair) => {
const d = document.createElement('div');
d.className = 'fhub-tag';
d.textContent = pair[0];
d.addEventListener('click', () => { if (input) input.value = ''; setHubView(pair[1]); });
tags.appendChild(d);
});
}
function norm(s) { return String(s || '').toLowerCase().replace(/\s+/g, ''); }
function cardRows(gi) {
const card = groups[gi] ? groups[gi].querySelector('.set-group') : null;
return card ? Array.prototype.slice.call(card.children) : [];
}
let seenWraps = []; // #937 unseen 视图的动态容器：每次 update 先整体移除再按视图重建/复位
function update() {
if (empty) empty.hidden = true;
seenWraps.forEach(el => el.remove());
seenWraps = [];
const q = input ? norm(input.value) : '';
if (q) {
if (home) home.style.display = 'none';
if (tags) tags.style.display = 'none';
let hits = 0;
const raw = input ? input.value : '';
const terms = window.mochiSearch ? window.mochiSearch.terms(raw) : raw.trim().toLowerCase().split(/\s+/);
const kwRaw = raw.trim();
HUB.forEach((grp, gi) => {
let gHit = 0;
const card = groups[gi] ? groups[gi].querySelector('.set-group') : null;
if (card && !card.__fhubOrder) card.__fhubOrder = Array.prototype.slice.call(card.children);
const base = (card && card.__fhubOrder) || cardRows(gi);
const rankByRow = new Map();
grp.items.forEach((it, ii) => {
const hay = norm(it.n + it.d + (it.k || '') + (it.g || ''));
const show = terms.every(w => hay.indexOf(w) >= 0);
const el = base[ii];
if (el) el.style.display = show ? '' : 'none';
if (show) { gHit++; hits++; rankByRow.set(ii, window.mochiSearch ? window.mochiSearch.rank(it.n, kwRaw) : 2); }
});
if (card && card.__fhubOrder) {
card.__fhubOrder
.map((el, ii) => ({ el, ii, rk: rankByRow.has(ii) ? rankByRow.get(ii) : 9 }))
.sort((a, b) => a.rk - b.rk || a.ii - b.ii)
.forEach(o => card.appendChild(o.el));
}
if (groups[gi]) groups[gi].style.display = gHit ? '' : 'none';
});
if (empty) empty.hidden = hits > 0;
return;
}
if (view === 'unseen') {
if (home) home.style.display = 'none';
if (tags) tags.style.display = 'none';
groups.forEach(el => { el.style.display = 'none'; });
const un = unseenList();
let lastCard = null;
un.forEach(gr => {
const wrap = document.createElement('div');
const title = document.createElement('div');
title.className = 'gs-title';
title.textContent = gr.g + '（' + gr.items.length + ' 个没试过）';
const card = document.createElement('div');
card.className = 'set-group glass';
gr.items.forEach(it => card.appendChild(entryRow(it)));
wrap.appendChild(title);
wrap.appendChild(card);
body.appendChild(wrap);
seenWraps.push(wrap);
lastCard = card;
});
if (empty) empty.hidden = !!lastCard;
return;
}
Array.prototype.forEach.call(body.querySelectorAll('.set-row'), r => { r.style.display = ''; });
groups.forEach((el) => {
const card = el ? el.querySelector('.set-group') : null;
if (card && card.__fhubOrder) card.__fhubOrder.forEach(node => card.appendChild(node));
});
if (home) home.style.display = view === 'home' ? '' : 'none';
if (tags) {
tags.style.display = view === 'home' ? 'none' : '';
Array.prototype.forEach.call(tags.children, (t, i) => t.classList.toggle('on', i - 1 === view));
}
groups.forEach((el, i) => { el.style.display = i === view ? '' : 'none'; });
renderSeen(); // #937：回首页/切组时横幅按当前 view 复位显隐
}
if (input) input.addEventListener('input', update);
function toast(msg) {
let t = document.getElementById('cc-toast');
if (!t) { t = document.createElement('div'); t.id = 'cc-toast'; document.body.appendChild(t); }
t.textContent = msg; t.className = 'cc-toast'; void t.offsetWidth; t.className = 'cc-toast show';
clearTimeout(t._timer); t._timer = setTimeout(() => { t.className = 'cc-toast'; }, 2400);
}
function jump(it) {
if (it.go && it.go.length) {
try {
const fireSel = function (sel2) { const el2 = document.querySelector(sel2); if (el2 && typeof el2.click === 'function') { el2.click(); return true; } return false; };
if (!fireSel(it.go[0])) { toast('「' + it.n + '」的位置：' + (it.where || it.g) + '（入口暂不可达，如有需要请在对应页面寻找）'); return; }
bumpFreq(it); bumpSeen([{ g: it.g, n: it.n }]);
const crossPage = it.go.length > 1 && it.go[0].indexOf('[data-app=') >= 0;
it.go.slice(1).forEach(function (sel2, k2) {
if (crossPage) { setTimeout(function () { try { fireSel(sel2); } catch (e2) {} }, 350 + k2 * 120); }
else { try { fireSel(sel2); } catch (e2) {} }
});
} catch (e) { /* 落到位置提示 */ toast('「' + it.n + '」的位置：' + (it.where || it.g) + '（入口暂不可达，如有需要请在对应页面寻找）'); }
return;
}
toast('「' + it.n + '」的位置：' + (it.where || it.g));
bumpSeen([{ g: it.g, n: it.n }]);
}
let hubFrom = 'setting';
function openHub(from, kw) {
ensureBuilt(); // #1452 阶段 A：首次打开才建目录行（幂等；已建则空转）
document.querySelectorAll('.page').forEach(p => { p.hidden = true; });
page.hidden = false;
hubFrom = from;
if (input) input.value = kw ? String(kw) : '';
setHubView('home');
if (kw && input) { try { input.focus(); } catch (e) {} }
}
const back = document.getElementById('fhub-back');
if (back) {
back.addEventListener('click', () => {
document.querySelectorAll('.page').forEach(p => { p.hidden = true; });
const target = document.getElementById(hubFrom === 'desktop' ? 'page-phone' : 'page-setting');
if (target) target.hidden = false;
});
}
const row = document.getElementById('row-featurehub');
if (row) row.addEventListener('click', () => openHub('setting'));
window.mochiFeatureHubOpen = function (kw) { openHub('setting', kw); };
window.mochiHubItemsFor = function (sels) {
try {
const want = Array.isArray(sels) ? sels : [sels];
const out = [];
HUB.forEach(function (g) {
(g.items || []).forEach(function (it) {
const go = it.go || [];
for (let i = 0; i < want.length; i++) {
if (want[i] && go.indexOf(want[i]) >= 0) {
out.push({ g: g.g, n: it.n, d: it.d, go: go.slice(), where: it.where || '' });
return;
}
}
});
});
return out;
} catch (e) { return []; }
};
{
if (!page.hidden) ensureBuilt();
else {
const mo = new MutationObserver(function () {
if (page.hidden) return;
mo.disconnect(); // 只跑一次
ensureBuilt();
});
mo.observe(page, { attributes: true, attributeFilter: ['hidden'] });
}
}
loadSeen();
update();
})();
if (window.__mochiLoaded) window.__mochiLoaded.push("feature-hub.js");
} catch (__e) { if (window.__mochiErrLoaded) window.__mochiErrLoaded.push("feature-hub.js"); try { console.error("[JS] feature-hub.js", __e && __e.message || __e); } catch (x) {} if (window.__jsErrors) window.__jsErrors.push("[feature-hub.js] " + String(__e && __e.message || __e)); } })();
</script>
<script>/* inline: settings-help.js */
(function () { try {
(function () {
var DESC = [
{ sel: '#sf-group-chat-row', name: '开启群聊', d: '开启后桌面出现「群聊」入口，可新建群聊、邀请联系人一起聊天（同时桌面占卜图标会收进隐藏池——第一页留给群聊入口，需要用占卜时走 设置 → 工具 → 占卜，与点桌面图标等效；若在桌面装修里手动固定过占卜则不受影响）。\n默认：关闭。\n影响范围：全局，所有桌面/联系人共用；关闭只是隐藏入口，已有群聊数据保留。' },
{ sel: '#sf-night-mode-row', name: '夜间免打扰模式', d: '开启后只在夜里 22:00–次日 07:00 生效：这段时间内只拦「TA 主动发起」的打扰——不再主动发消息（拍一拍、邀请、主动查岗等同一条链一并暂停）、不自动发互动卡 / 查岗卡、不自动换头像换昵称、不自动换位 / 送礼 / 发朋友圈动态，也不主动打来电话，其他桌面也不会跨桌面查岗 / 求聊天 / 来电。时段外（07:00–22:00）行为完全不变，进出时段自动切换、无需手动操作。\n默认：关闭（要整夜勿扰 / 免打扰时再打开）。\n机制：你自己发的消息与 TA 对你的回复照常即时送达（夜里也能正常聊天，提示音照旧）；你当刻操作引发的回执与账目（你玩游戏的战绩、红包领取 / 退回、通话记录、存钱罐、决定结果）与你点开的功能（手动查岗、继续说、让TA邀请我）一律放行，不受限。被拦的换头像 / 换位等定时动作当次不计时，7:00 后自动补上，不会丢也不会堆成一堆。本项是全站共用的一个总闸，所有桌面一起生效（不随联系人区分），切换后立刻生效。\n影响范围：TA 主动消息 / 自动互动卡 / 自动换头像换昵称 / 自动换位 / 自动送礼 / 朋友圈自动动态 / 主动来电 / 跨桌面查岗 / 跨桌面求聊天 / 跨桌面来电；聊天记录、字卡、桌面设置等数据不受影响。\n行下小字会显示当前状态并自动刷新：「开启 · 当前生效中（22:00–7:00）」＝此刻正处夜间时段；「开启 · 当前不在夜间时段」＝已开启，到 22:00 才起作用。\n名称：本项原名「夜间模式」——旧叫法容易被当成「深色模式」（夜里把界面调暗），它管的其实是夜里别让 TA 主动来打扰，故更名。' },
{ sel: '#row-theme-mode', name: '深色模式', d: '切换全站主题。\n点击选择：「关闭」=浅色、「已开启」=深色、「跟随系统」=随手机系统明暗自动切换。\n默认：浅色。\n影响范围：全局所有页面，不随桌面区分。' },
{ sel: '#row-appearance', name: '手机桌面美化', d: '进入桌面美化子页：主题配色、壁纸、图标、字号、圆角、桌面组件等的总入口。\n美化页最上方那条「边看边调（即时生效）」＝边改边看的调色条：点开是底部抽屉（颜色 / 尺寸 / 背景 / 图标 / 底部栏 五个分区，改哪个当场见效，不用来回翻设置）。\n新增（#1008）：抽屉的标题行可以按住往上拖，把它挪到不挡视线的地方（会话内记住位置；拖回底部附近会自动吸附回去）；它默认停在底部导航之上，所以开着它也能点底部导航去别的页面接着调。抽屉里的「收起」只折叠控件区、标题行留着，点标题行上的「展开」回来。\n新增（#769）：底部导航栏也能美化——首页/字卡/设置三个按钮可各自上传图标图片（可调图片透明度、更换或恢复默认），整条栏可调背景/整栏透明度、底色、圆角、模糊、图标大小；在「边看边调 → 底部栏」分区或设置页「底部导航栏」组操作。\n影响范围：子页内多数美化项按联系人桌面独立保存（每个桌面可不同）。\n本行只是入口，不改变任何设置。' },
{ sel: '#row-entry-show-list', name: '打开时显示联系人列表', d: '开启后，每次打开应用直接列出全部联系人 / 桌面，点其中一位即进入 TA 的桌面。\n默认：关闭。\n影响范围：全局设置，不随桌面区分。\n与「打开时先进入此间」的区别：本项不经过此间，打开即出列表；两者同时开启时以「先进入此间」为准（此间看完后同样会出这份列表）。\n注意：一旦在下面设置了「默认进入的桌面」，本项会被取代（自动关闭并置灰）；把默认桌面设为「关闭」即可恢复。' },
{ sel: '#row-entry-default-contact', name: '默认进入的桌面', d: '设置后，每次打开应用直接进入所选联系人桌面。\n默认：关闭（不设置，沿用上次所在的桌面）。\n影响范围：全局设置，不随桌面区分。\n取代关系：本项开启时会自动关闭并禁用「打开时先进入此间」和「打开时显示联系人列表」——默认桌面已决定每次进入哪个桌面，不再需要每次选择；把本项设为「关闭」即可恢复这两项。\n注意：所选桌面被删除时会自动退回「关闭」并恢复上述两项。' },
{ sel: '#row-general', name: '回复设置', d: '进入回复设置页：调整 TA 的回复速度、连发条数、撤回 / 已读不回 / 拍一拍等行为概率，以及「聊天触发概率总档」和各分类概率。\n影响范围：页内参数按联系人桌面独立保存。\n本行只是入口。' },
{ sel: '#row-call-settings', name: '通话设置', d: '进入通话设置页：来电频率、接听 / 挂断触发概率、通话界面背景等。\n影响范围：页内概率按联系人桌面独立保存。\n本行只是入口。' },
{ sel: '#row-sfx-settings', name: '音效设置', d: '进入音效设置页：来电铃声、收件音、发送音，可选用内置音效或上传自定义音频。\n默认：全部静音（不播放），需进页主动选择。\n影响范围：音效按联系人桌面独立保存。\n本行只是入口。' },
{ sel: '#row-featurehub', name: '功能大全', d: '进入功能大全：全应用功能索引，支持搜索、点条目直达对应页面或设置。\n本行只是入口，不改变任何设置。' },
{ sel: '#bg-keepalive', name: '后台保活', d: '开启后页面切到后台时用一段「静音音频」+ 屏幕唤醒锁维持运行，TA 的消息与定时事件不中断。\n\n【它只是这个网页的「保活」，没有别的意思】保活的对象就是本页这个浏览器网页本身——让它在切到后台时不被系统冻结，TA 的消息才照常产生。它不安装任何东西、不在系统后台常驻、不读取手机里的其他数据、不联网上传、也不会开机自启；关掉本开关或关掉页面即彻底结束，不改动手机 / 系统的任何设置。\n\n【为什么会影响其他 App 的声音】保活靠的就是让网页在后台持续播放一段音频（手机系统据此认为页面仍在运行、不冻结）。而手机同一时间通常只允许一路音频占用音频通道：开着保活时，其他 App 的音频会受影响（例如听歌音量变小）。\n\n【别的 App 刷视频/听音乐会把保活截断】别的 App 出声（刷视频、听歌、看视频号）会把保活音频暂停＝保活失效：安卓按 5 秒→10 秒→…最长 1 分钟的退避节奏尝试恢复；iPhone 上不回抢（避免反复截停对方的视频/音乐），回本页才恢复。被截断期间页面可能被系统冻结＝后台消息收不到、后台弹窗不弹。\n\n【后台挂久了会失效】系统省电/内存策略会把挂久的页面冻结甚至丢弃重载（Edge「睡眠标签页」/Chrome「内存节省程序」默认约 30 分钟丢弃一次，表现＝「回来时页面自己刷新了」）。失效后请彻底关闭网页重新打开，再把「后台保活」「后台弹窗」开关重新打开；想推迟失效：平时从浏览器标签页打开本站的，可在浏览器设置把本站加入「永不睡眠 / 始终保持活动」名单；已添加到主屏幕 / 桌面的本站是独立应用，那两个标签页开关管不到它——该去 系统设置 → 应用 → 本浏览器 → 省电里选「无限制 / 允许后台活动」，并在最近任务里把本站锁定（详见 使用说明第 11 节）。\n\n【开着保活时不会在后台自动换新版】换新版要重载页面、而重载会把后台运行打断——所以开着「后台保活」或「后台通知」时，应用不会在后台自己刷新：顶部出现「检测到新版本」条时，由你自己挑时间点「刷新使用新版」（不点也不影响使用，下次彻底关闭网页重开会自然换到新版）。这是刻意的设计，不是更新坏了。\n\n【这是手机 / 浏览器的限制，不是 bug】任何网页想后台保活都绕不开；不需要后台收消息时，关掉本开关，其他声音立刻恢复正常。\n\n【什么情况才算 bug】关掉保活后本页仍发出异常声音（电流声 / 嗡鸣 / 嘟嘟声），或开着保活时本页声音异常——那才是 bug，请带机型 + 浏览器反馈。\n\n默认：关闭。\n机制：播放音乐时会短暂让位，音乐结束后自动恢复；开启「后台通知」时会自动一并开启本项（但若你手动关过本开关，就保持你的选择、不会再被自动打开）。\n影响范围：全局生效。\n注意：关掉它＝后台不再产生消息，「后台弹窗」也就收不到；页面后台常驻会耗电、也可能发热，不用时建议关闭。\n用的哪段音频见下一行「保活音频」，那段音频走哪条通道（会不会压低别的 App 的声音）见「保活不抢其他 App 的声音」。' },
{ sel: '#bg-keep-audio-btn', name: '保活音频', d: '选择后台保活播放哪段音频（点右侧按钮切换）。\n· 默认静音音频：内置生成、近乎无声，最省事，推荐。\n· 自定义音频：上传自己的音频（白噪音 / 助眠声，或一段更彻底的静音文件），按原音量循环播放。\n\n注意：默认静音音频走下一行「保活不抢其他 App 的声音」那条通道，不再占用手机音频通道；一旦你上传了自定义音频（那是你要出声放的），它仍按媒体通道循环播放，会占用手机音频通道、可能影响其他 App 的声音；后台保活关闭时不会播放。\n影响范围：全局生效，所有桌面共用同一段音频。' },
{ sel: '#bg-keep-noduck', name: '保活不抢其他 App 的声音', d: '作用：决定保活那段近无声音频「从哪条通道出声」。\n· 开（默认）＝走「站内音效」那条通道：页面照样持续出声、系统照样不冻结它，但不再向手机声明「本站正在放媒体」——你在别的 App 听歌 / 看视频时不会被本站压低音量，切进切出也不再忽响忽轻。代价：通知栏那条「Mochi 后台保活」媒体横幅不再出现（那条横幅本身就是那次音频通道的占用）。\n· 关＝回到老路：<audio> 媒体元素常播＋通知栏媒体横幅，个别只认这条横幅豁免的浏览器后台收消息更稳，但会压低其他 App 的音量。\n· 上传了自定义保活音频时本开关不参与——那是你要出声放的东西，恒走媒体通道。\n背景：任何持续播放的音频都会占用手机音频通道，这是通道性质、不是某个机型的问题；两条路都留着，按你的体验选。\n默认：开启。\n影响范围：全局生效。\n怎么确认当前走的是哪条：设置→查看诊断→【保活现场】的「锚=」那一格（媒体元素(占媒体通道) / WebAudio(不占媒体通道)）。' },
{ sel: '#bg-notify', name: '后台通知（后台弹窗）', d: '作用：页面切到后台（含锁屏、切到别的应用）时，TA 发来新消息就用系统通知弹横幅，不用一直守着聊天页。\n默认：关闭。\n机制：开启会请求系统通知权限，授权成功后自动联动开启「后台保活」（你手动关过保活则不会替你打开，只提示）；开关只记「你想不想要」，不会因为一次权限读数被自动关掉：权限没到位时开关保持开着＋行下标红说明缺哪一步，允许后自动生效（不用再点第二次开关）；需 HTTPS 环境。权限「还没决定」时（弹窗挂着没点、或直接切走了）开关会保持开启并提示你去允许——这时通知还不会来，允许后自动生效，不用再点第二次开关。\n影响范围：全局生效（不随桌面区分）。\n\n—— 后台弹窗 · 使用说明 ——\n【它是什么】「后台弹窗」＝页面还在后台运行时，TA 发消息弹系统通知（锁屏、通知栏也能看到）。消息和内容都在本机生成，不联网、不上传。\n【开启步骤（安卓 / 电脑）】① 用安卓或电脑上的 Chrome / Edge（Chromium 内核），并且是 https:// 打开（GitHub Pages 地址本身就是 HTTPS）——小米 / vivo / OPPO 等自带浏览器、UC、夸克没有通知能力，开不起来；② 地址栏左侧图标 → 网站设置 → 通知 → 允许（首次打开本开关时也会弹一次授权；没弹授权框、或被静默拒绝，多半是 Chrome 对授权框反复弹过的站自动挡——可在 地址栏左侧图标 → 权限 → 通知 里改「允许」，或 Chrome ⋮ → 设置 → 网站设置 → 通知 → 「添加网站例外」→ 输入本站网址；此权限与「经期提醒」共用）；③ 以上都改了仍不弹＝Chrome 对本站的自动屏蔽无法解除，换 Edge / 电脑打开本站即可（聊天记录在 设置 → 通用 导出 / 导入 迁移）；③ 打开本开关——它会自动把「后台保活」一起打开（TA 的消息由页面定时器产生，页面在后台被冻结就没消息可弹）；④ 手机 系统设置 → 应用 → 浏览器 → 通知：允许；小米 / HyperOS 等系统还要在「通知类别」里打开「在屏幕上方显示 / 悬浮通知」，否则只进通知栏、不弹横幅；⑤ 系统省电 / 后台管理里不要把该浏览器设成「限制后台运行」。\n【怎么确认通了】点右边「测试」＝两段自测：第一段当场列出开关 / 通知权限 / 后台保活（含锚点）/ 后台服务（Service Worker）的真实读数，并真发一条测试通知、回读系统通知队列，卡在哪一环直接写在结果里，不再被网络拖时间；第一段通了会接着请你测第二段（后台阶段）——点「现在测（切后台）」后按 Home 把页面切到后台（可锁屏），页面会在后台 5 秒后自动再发一条，回到本页出结论并问你看没看到（屏幕上方横幅网页读不到，只能由你确认）。\n【收不到怎么办】① iPhone / iPad：Safari 标签页里没有网页通知能力，本开关在那里开不起来（不是网站坏了）。要 Safari 分享菜单 →「添加到主屏幕」，之后从桌面图标打开本站——那边 Notification 在场、可以授权、能弹系统通知（设置→信息诊断 里【保活现场】写「通知=开/granted」「最近通知通道=sw」就是这个形态）。装在 iPhone 上也仍要靠「后台保活」把页面撑住：iOS 不给网页推送服务端，应用被系统收回后不保证弹。这期间请靠「桌面消息弹窗」的应用内横幅，切回应用时还会提示「你不在的时候收到 N 条新消息」；② 后台得先「有消息」：TA 的聊天消息按「主动发送」的间隔 + 概率随机产生，关掉主动发送、或开着免打扰（应用内档位，主动发送被弱化到最长 3 小时一次），后台就没有东西可弹；开着「夜间免打扰模式」（原「夜间模式」）时 22:00–7:00 整段不主动发消息，后半夜本来就没东西可弹；③ 刚切到后台的 15 秒内不发通知（多半是你刚看完的消息在补触发）；④ 内容去重：与最近 5 分钟聊过、最近 2 分钟弹过、或你刚在前台看过的同一条内容不会重复弹（TA 字卡重复率高，同一句被吞掉属正常，不是坏了）。⑤ 手机开了勿扰 / 免打扰（系统层压制）：安卓的「勿扰 / 免打扰」、iPhone 的「专注模式」（勿扰·睡眠·驾驶·工作）会把所有应用的通知静默收进通知栏——屏幕上方不弹横幅，而网页读不到这个状态，所以「测试」体检全绿、通知真发出去了，你可能还是什么都没看到。一步自查：下拉通知栏看那条测试通知在不在，在＝被系统压住，关掉勿扰或在勿扰设置里把本浏览器（或桌面上的 Mochi）加进「允许的应用 / 例外」。同一族还有三处：通知被长按成「静默 / 减少干扰」或浏览器「网站通知」那一类被单独关掉、锁屏设成「隐藏通知内容」（只有解锁后通知栏里才有）、iPhone 开过「定时推送摘要」（通知攒到点才出现）。电脑端＝Windows「请勿打扰 / 专注助手」、macOS「专注模式」。别和本站自己的两个档搞混：回复设置里的「免打扰」与「夜间免打扰模式」管的是有没有消息可弹，本条的系统勿扰管的是有消息也弹不出来——它在手机系统设置里，网页读不到、也替你关不掉。\n【挂久了会失效】后台弹窗跟着保活走：保活被截断（别的 App 刷视频/听歌占用音频通道）或页面被系统冻结/丢弃重载（挂后台太久；Edge「睡眠标签页」/Chrome「内存节省程序」约 30 分钟；手机内存紧张时更快——本页越重，几分钟也可能被丢）时，后台弹窗一起停摆。其实被回收后只是回到本页时自动重载一遍：开关会自动恢复，「后台保活」在你碰一下页面时就自动接上，聊天记录都在本机不会丢。\n【止住回收最有效的一步】先去 系统设置 → 应用 → 你用的浏览器（或已加到桌面的「Mochi」）→ 省电 / 电池策略，选「无限制 / 允许后台活动」，再在最近任务里把本站锁定、别横向划掉。⚠ 只关 Edge「睡眠标签页」/ Chrome「内存节省程序」往往白忙活：那两个只管浏览器里的标签页，已添加到主屏幕 / 桌面的本站是独立应用，改那里管不到它（设置→信息诊断 里「被系统回收过 N 次」一直涨就是没改对地方）。再把 设置→查看存储 里最占地方的两项清一清（页越轻越不容易被丢）。想再加一层保险：把本站添加到桌面图标并开启「离线消息提醒」——页面被回收甚至全部关掉后，浏览器也会定时唤醒弹一条。\n【和「离线消息提醒」的区别】两者完全独立、互不影响：后台弹窗＝页面还在后台时 TA 发消息弹通知（本开关 + 后台保活 + 通知权限）；离线消息提醒＝页面全部关掉后，浏览器隔几小时唤醒一次、随机抽一条想念文案弹通知（仅安卓 / 电脑上的 Chrome、Edge 且添加到主屏幕）。不开哪一个都不影响另一个。\n【代价】开启后页面会在后台持续运行，比较耗电、也可能发热，不需要时回本页关掉；通知会在锁屏 / 通知栏显示消息内容，介意就到系统设置里关掉本应用通知。' },
{ sel: '#sf-edge-guard', name: '全屏边缘防误触', d: '全屏时在屏幕左右边缘加一层拦截，尽量挡住国产浏览器自带的边缘上/下滑（调音量/亮度）手势。\n默认：关闭。\n机制：仅在进入全屏时生效；对系统级手势可能无效，最可靠仍是浏览器设置里关闭边缘滑动调节。\n影响范围：按联系人桌面独立保存。' },
{ sel: '#bg-notify-nodedup', name: '通知逐条弹（关闭去重）', d: '作用：打开后联系人每条消息都单独弹一条系统通知，不做内容去重——字卡重复率高、连发多条时也能逐条看到。\n默认：关闭（连发内容相同或近期弹过的消息只弹一条，防同句连轰）。\n机制：只影响系统通知的弹与不弹；聊天记录、未读角标、「你不在的时候收到 N 条」汇总都不受影响。\n两类仍不弹（那不是新消息）：① 切后台头 15 秒内的旧内容；② 页面被系统冻结/重载后重放的旧消息。\n代价：开启后同句可能连环弹，略吵，按需开。' },
{ sel: '#desk-msg-en', name: '桌面消息弹窗', d: '开启后，不在聊天页时 TA 发来新消息会在桌面顶部弹出消息横幅。\n默认：开启。\n影响范围：按联系人桌面独立保存；关闭后仅在聊天页内看到消息，不再弹横幅。\n注意：这是「应用内横幅」，不是系统通知——它只在这个页面还活着的时候弹（iPhone / iPad 的 Safari 标签页形态拿不到系统通知，只能靠它看后台消息；装到主屏幕的独立应用形态两边都能用）；页面切回前台时还会提示「你不在的时候收到 N 条新消息」。' },
{ sel: '#row-export', name: '导出数据', d: '导出备份文件，用于换机或防丢失。点开先选范围：完整备份 / 不含音乐文件 / 只备份文字 / 仅聊天记录（全部桌面联系人 + 群聊，消息引用到的图片语音一并带走）。\n机制：纯本地导出，无后端。\n影响范围：按所选范围；「仅聊天记录」不算全量备份，不更新定期备份提醒的导出时间。\niOS Safari 可能被系统清空存储，建议定期导出完整备份。\niPhone / iPad 更稳妥的用法：把本站「添加到主屏幕」后从桌面图标使用——Safari 标签页连续 7 天没打开会被系统自动清空全部数据，而主屏幕应用与 Safari 是两套独立存储（切换前先导出、切过去后在桌面应用里导入）。' },
{ sel: '#row-import', name: '导入数据', d: '从备份文件恢复数据。点开先选范围：「完整备份」按文件覆盖本机全部数据（设置/字卡/朋友圈/音乐等），「仅聊天记录」只恢复各桌面联系人与群聊的聊天、其他数据一律不动（可从整份备份里单独找回聊天）。\n机制：导入后触发数据回填，请等待恢复完成再操作。\n建议：导入前先「导出数据」留底。' },
{ sel: '#safe-top-force', name: '顶部避让修正', d: '独立应用（添加到主屏幕）形态专用修正：iPhone / iPad 添加到主屏幕后，顶部「Mochi」行与手机系统时间重叠时开启；底部出现白带时关闭。\n默认：关闭（系统保留形态）。\n机制：改后会自动刷新页面生效。\n影响范围：只在「添加到主屏幕」后打开（独立应用形态）时生效；浏览器里直接打开时本开关无效果——安卓要调顶部遮挡 / 底部裁切请用「屏幕适配微调」。' },
{ sel: '#row-diagnostics', name: '设备兼容诊断', d: '采集本机设备与浏览器环境信息，一键复制本机环境信息。\n机制：只读，不改动任何业务数据；有未读兼容错误时行上显示角标，点开即清零。\n很多「像 bug 的问题」其实是设备 / 浏览器限制（App 内置浏览器能力受限、国产浏览器没有通知能力、iOS 顶部状态栏藏不掉、浏览器「桌面版网站」模式让布局变形、系统省电杀掉后台等），逐条对照见 设置 → 关于 → 使用说明 第 12 节「设备与浏览器限制」；为什么会有这些限制、哪些属于「设备限制」而不是网站坏了，见 第 13 节「本站只是一个网页」（浏览器选择器怎么决定能不能多选、批量上传图片看这一节）。' },
{ sel: '#row-screen-diag', name: '屏幕适配诊断', d: '定位跨设备屏幕适配问题（顶部空白 / 底部裁切 / 缩放异常），生成可读报告与机读签名，可导出或复制。\n机制：只读；产生的诊断记录可在「查看存储」里清理。' },
{ sel: '#row-screen-adj', name: '屏幕适配微调', d: '跨机型屏幕适配没对上（顶部被状态栏遮挡、底部被手势条裁掉、页面底部留白、全屏时桌面图标偏上、整页偏移、正文太小）都在这一处自己调：八轴滑杆边拖边看、当场见效，双击滑杆回默认 0，「全部恢复默认」一键归零。\n不必钻在设置里盲调：面板会自动停在底部导航/输入栏之上，点「收起」变成一枚小胶囊（点开合、可拖走让位），带着它切页看现场；面板顶部写明「正在调：桌面 / 聊天」，旁边两枚页签里反色高亮的那一枚＝你正在调的那一页，点另一枚就切过去接着调；滑杆按生效页面分三组——两个页面通用的位置轴、只影响桌面页的「桌面图标区」、只影响聊天正文文字的「文字大小」，当前页那一组带「你正在这一页」标记。\n三个入口同一面板：设置 → 工具 → 屏幕适配微调；桌面长按空白进装修模式 → 「屏幕适配」；聊天页右上角「聊天设置」→ 美化 → 屏幕适配微调。\n机制：偏移轴（顶部/底部/页面高度/桌面/整体位移）以「系统基准+你的偏移」双层落层，不破坏自动适配；键盘间隙轴只在键盘弹出期间生效（输入栏离键盘悬空=往正压向键盘、被键盘盖住=往负抬回）；文字大小轴只在气泡/输入框/设置列表等正文原字号上叠加，不是整页缩放。\n改完本机永久保存（跨桌面共用、换设备不跟随）；与「屏幕适配诊断」配合使用——先诊断差多少 px，再来拖对应轴。' },
{ sel: '#cs-screen-adj', name: '屏幕适配微调（聊天设置里调）', d: '在聊天页里直接调屏幕适配，不用绕去设置：正文太小 / 顶栏底栏错位 / 底部被手势条裁掉 / 页面底部留白，点本行开面板、拖着滑杆边看边调，当场见效；双击滑杆回默认 0，「全部恢复默认」一键归零。\n面板展开态会自己停在聊天输入栏与底部导航之上（不用收起也不会挡住说话和切页）；面板顶部写明「正在调：聊天」，且「聊天」那枚页签反色高亮＝确认在调聊天页、不会看错。\n与「顶栏 / 底栏位置微调」的区别：那一行只挪聊天的顶栏与输入栏；本行是整个页面的适配轴（页面高度、整体位移、桌面图标区、正文文字大小等），跨桌面共用。\n同一面板的三个入口：聊天设置 → 美化 → 屏幕适配微调（本行）；设置 → 工具 → 屏幕适配微调；桌面长按空白进装修模式 → 「屏幕适配」。\n改完本机永久保存（换设备各自调）；先跑「设置 → 屏幕适配诊断」看差多少 px，再来拖对应轴更准。' },
{ sel: '#row-func-diag', name: '功能诊断', d: '逐个测试全部功能入口 / 页面 / 图标能否正常打开与关闭（约 15 秒），自动判定「正常 / 需注意 / 异常」。\n机制：只读，测试期间会临时开合页面，不改业务数据。' },
{ sel: '#row-storage-view', name: '查看存储', d: '查看本地存储占用：按功能列出 localStorage 与 IndexedDB 的空间，并可定向清理诊断记录、本地音乐、同域其他站点等（不动业务数据）。\n也可从这里进入图片压缩。\n手机卡顿多是「存的东西太多」：字卡库大的话，这里能看清是谁在占地方。「字卡库瘦身」会把重复的图只留一份，明显腾出空间；「媒体池重建」是聊天里图片显示不出来时用来找回图片的，跟卡顿无关。' },
{ sel: '#row-img-compress', name: '压缩图片', d: '把历史遗留的偏大图片按「新上传」同标准重新压缩一遍，覆盖原图、不可撤销。\n默认：上传时已自动压缩，本项只处理旧图。\n机制：会跳过动图（GIF）、和聊天共用的图、以及本来就小的图。\n影响范围：字卡库与桌面美化等图片数据。\n大图片是手机（安卓 / iOS）卡顿与存储膨胀的主因之一；字卡库里的超大图片卡（单张超过 512KB）可在「字卡使用状态自检」里看到。' },
{ sel: '#row-perf-optimize', name: '卡顿自检 · 一键优化（手机卡顿怎么办）', d: '作用：字卡库特别大导致卡顿时，先检查一遍各桌面的字卡库有多大（分轻 / 中 / 重），再把最大的那部分提前读好、准备好。做完之后打开聊天、翻字卡就不用临时等它。\n默认：不会自动做任何改动，你点了才开始。\n放心：只读、只整理，不删除也不改写你的任何数据；本项只作用于当前桌面的字卡库，数据本身完全不变。字卡库确实很大时，打开应用后会主动提醒你一次。\n\n—— 手机卡顿怎么办（安卓 / iPhone）· 使用说明 ——\n【先分清两种「卡」】● 打开时慢几秒＝正常：这个应用把所有页面、代码和字卡装在一个约 5.5MB 的文件里，手机第一次打开要先整个下下来、读一遍，配置不高的手机慢几秒很正常；第二次打开有缓存，会快很多。● 用着一直卡、越用越卡＝手机里存的东西太多了（下面讲的都是这一类；另外几个会加重卡顿的因素见后面「还有谁在拖后腿」）。\n【为什么东西多了就卡】最主要的是图片。图片不是以「图片」的形式单独存的，而是被转换成一长串文字，跟聊天记录、字卡混在一起存——所以它占的地方比原图还大约三分之一。手机每次打开都要把这些内容读一遍，东西越多读得越久，表现就是卡。\n【谁最占地方？没有统一答案，看你自己的】聊天记录滚得久、字卡库堆了很多大图或语音卡、本地音乐攒得多、美化图片多——都可能成为你这台手机上的第一名，怎么用就怎么占，跟别人不一样很正常。作为参考，我们见过一整份聊天记录大到 155MB（1656 条消息），也见过一个字卡库 44MB、个别情况超过 100MB。所以别照别人的排序删自己的数据：先到 设置 → 工具 →「查看存储」，它会把每一项占用都列出来，谁最大一眼可见，再对症处理（下面清单也按「先看清、再对症」排列）。\n【iPhone 和安卓，卡的地方不一样】iPhone 卡在「内存不够」：iOS 对单个网页允许占用的内存比安卓更严格，超了系统会直接把页面关掉，所以切回来时会白一下、重新加载一下——数据不会丢，但用着会顿、会闪。安卓卡在「手机不够快」：配置低的手机处理器慢，表现为滑动掉帧、打开字卡库要等几秒，存的东西越多等得越久。两种都不是网站坏了。\n【还有谁在拖后腿】① 开着「后台保活」：页面会在后台一直运行（靠播放一段静音音频撑着），更耗电、更容易发热，也更容易掉帧；② 手机开了省电模式或限制了后台运行——iPhone 的「低电量模式」会把整机帧率锁到一半（约 30fps），滑动/切页/打字全会变卡，属系统行为，关掉（设置 → 电池 → 低电量模式）立刻恢复；③ 浏览器标签页开太多；④ 用了浏览器的「桌面版网站」模式；⑤ 很久没有重新打开过应用。\n【按这个顺序优化（都不会删你的数据）】① 就点本行「卡顿自检 · 一键优化」——它会把最大的那部分提前读好、准备好，之后用起来就顺。② 设置 → 工具 →「查看存储」：先看清是谁在占地方。「字卡库瘦身」会把重复的图只留一份，明显腾出空间；顺手清一下诊断缓存（清它不影响聊天、字卡、头像、音乐）。注意「媒体池重建」不是用来腾空间的——它是聊天里图片显示不出来时用来找回图片的，跟卡顿无关。本地音乐要到 桌面「音乐」→ ⚙ 设置 →「清理本地音频缓存」里清。③ 设置 → 工具 →「压缩图片」：把以前存下的偏大图片重新压小（新上传的图本来就压好了，这里只处理旧图；覆盖原图、不可撤销）。它不处理动图（GIF）和本来就小的图，所以表情包动图特别多的话，这一步省不出多少，得靠下一步手动删。④ 精简字卡：字卡库 → 公用字卡 / 专属字卡，把不用的大图卡、语音卡删掉。「字卡使用状态自检」会帮你标出特别大的图片卡（单张超过 512KB，约半兆），那些最占地方。⑤ 瘦聊天记录：聊天页 → 聊天设置 →「数据」，可以把旧的聊天记录单独导出或删掉——一定要先导出备份再删。如果「查看存储」里最大的一块正是它，这一步通常比前面几步都明显；每个联系人桌面的聊天是分开存的，要一个个看。⑥ 不用的时候把「后台保活」关掉（设置 → 系统）。⑦ iPhone：一定要用 Safari「添加到主屏幕」，之后从桌面图标打开——独立应用比浏览器标签页稳得多，也不容易被系统清掉；尽量别同时开很多标签页；真卡了就把它完全划掉、重新打开一次。⑧ 安卓：别用浏览器的「桌面版网站」模式，用手机版会顺很多；如果它认错了设备，用 设置 → 系统 →「手机布局（强制）」掰回来。⑨ 保持最新版：新版一直在做流畅度优化，顶部出现「检测到新版本」时点更新；开屏底部有部署时间可核对。\n【别误会：不是让你少存图】现在你上传的字卡图会自动压小（最长边 720 像素，表情包 480、头像 256），单张比以前的旧图小得多，正常存、正常用完全不用担心。真正拖慢手机的只有两种：以前没有压缩标准时存下的老图，和只进不出、越存越多的旧记录（聊天记录是其中最典型的一项）。把这两样清掉就够了，之后照常用。例外：要铺满屏幕的背景图会保留较大尺寸（最长边 2880 像素），但每台桌面通常也就一两张，不会堆起来。\n【千万别做】不要用「清除本地数据」来治卡顿——它不会修好任何东西，只会把你的数据全删光（聊天、字卡、头像、背景、音乐都没了）。真要清，先去「导出数据」备份。另外，打开时慢几秒是正常的，不是坏了。' },
{ sel: '#row-card-audit', name: '字卡使用状态自检', d: '进入字卡自检页：一眼看清「自定义字卡」与「系统预设字卡」当前能不能被联系人用到、用不到卡在哪一步。\n覆盖：二级密码锁状态与影响范围（哪些池被锁停、哪些豁免）、默认聊天字卡/词典/其他互动功能字卡的开关与概率、单卡关闭与分组停用、情绪/回应/心情/情话/位置等字卡池、公用库与各桌面专属库的可用量、图片/语音卡健康。\n还覆盖「回复设置 → 聊天」那半边闸门（字卡池是满的却看不到字卡时，通常卡在这里）：词典拼字、梦角自由造句、多字卡回复、聊天回应字卡、自定义字卡占比、拍一拍/表情包/emoji/图片/语音/颜文字/引用等附加件、已读不回与主动发送。\n概率口径：生效值＝存盘值 ×「系统预设字卡·聊天概率总档」÷100（总档只缩放系统预设侧，梦角造句不过总档）；「预设默认字卡覆盖」＝生效聊天概率 ×(1−自定义字卡占比)，不是「系统预设 X% / 自定义 (100−X)%」的二选一。\n怎么用：每行点「调整」跳到对应页面手动改（回复设置侧直达「回复设置 → 聊天」）；点「修复」按默认值一键恢复（不改字卡内容）；顶部可切「只看有问题」。\n机制：只读诊断，不改动任何开关或数据；随解锁、切桌面、数据回填实时刷新，可一键复制报告。' },
{ sel: '#row-open-divination', name: '占卜（设置 → 工具 入口）', d: '作用：直接打开占卜页——塔罗（78 张完整牌库，带正逆位）/ 雷诺曼（40 张），1 / 3 / 7 张三种牌阵，历史记录可按联系人桌面独立保存。\n机制：点本行与点桌面【占卜】图标完全等效（走同一条打开路径，含「打开即渲染历史记录」）；占卜页左上角返回回桌面。\n为什么设置里也有入口：开启「群聊模式」期间，桌面占卜图标会收进隐藏池（第一页留给「群聊」入口）——这是最初的设计，不是图标丢了；桌面找不到占卜时从本行进即可。行下小字会随群聊开关写明当前状态（「桌面图标已收起」/「与点桌面图标等效」）。\n例外：你若在桌面装修的组件库里把占卜显式加回过桌面，群聊开启期间它也会照常显示（此时小字不再提示收起）。\n影响范围：本行只是入口，不改变任何设置与数据。' },
{ sel: '#row-reset', name: '清除本地数据', d: '清空本机全部应用数据（头像 / 昵称 / 背景 / 图标 / 纪念日 / 聊天 / 字卡 / 音乐 / 设置等），不可恢复。\n机制：会二次确认；清空全部 xy-home-v2 数据——所有联系人桌面（含当前之外的其他桌面）+ 公用字卡 / 我的表情包 / 存钱罐等全局共享数据 + IndexedDB 整库删除，清完自动重启为全新状态。\n建议：先「导出数据」备份再清除。' },
{ sel: '#row-guide', name: '使用说明', d: '进入完整说明页：从「快速开始」「安装到桌面」「iPhone 与 iOS 限制」，到「数据与备份」「常见问题」「权限、隐私与反馈」，再到四节长文——「后台弹窗 · 怎么用（安卓 / 电脑）」「手机卡顿怎么办（安卓 / iPhone）」「设备与浏览器限制（看着像 bug，其实不是）」「本站只是一个网页（前端网站）· 很多做不到是设备限制」。\n机制：页内可搜索，输入关键词（如「语音」「备份」「卡顿」「通知」「全屏」「密码」）会过滤条目，分组标题命中则整组展开。\n本行只是入口，不改变任何设置。' },
{ sel: '#row-about', name: '功能介绍与二改许可', d: '查看功能介绍、原创署名与二改许可说明（私人二改随意；二改 mochi 原网站后要公开须经作者同意；本站链接与代码库链接禁止二传）。\n本行只是入口；设置页底部另有常驻的版本、署名与防骗声明。' },
{ sel: '#row-guidebook', name: '新手引导', d: '重新播放 3 步新手引导：设置「我」「TA」→ 添加字卡 → 开始聊天，每步可一键跳到对应位置。\n默认：全新环境首次打开会自动弹一次，之后不再打扰；本行供随时重看。\n影响范围：只展示引导、不改任何数据。' },
{ sel: '#row-changelog', name: '版本与更新', d: '显示当前版本，并说明更新机制。\n机制：有新版本时开屏出现「⇩ 有新版本 · 点此更新」，点一下即更新到最新；本行弹窗里也有「检查更新」按钮，走同一条刷新链。\n【iPhone / iPad 必读】添加到主屏幕后从桌面图标打开的独立应用不会自动换新版——iOS 点开图标显示的常是上次缓存的旧页面，新版修复对你不生效。顶部弹「有新版本」时点它更新；错过提示就：从后台任务里把本应用彻底上划关闭 → 重新打开（有时要这样关开两轮才换到新缓存），再回到本页看版本时间是否已变成最新部署时间。若某个问题「开发者说已修复，你这里还在」，先按上面步骤更新到最新版再报。\n影响范围：只替换程序文件，聊天记录 / 字卡 / 头像 / 背景图 / 音乐等本机数据全部保留。' },
{ sel: '#row-opensource', name: '开源与致谢', d: '本作代码完全开源、支持私人部署与二传二改；此处汇总原创署名与灵感来源 / 感谢名单。\n本行只是只读说明入口，不改变任何设置。' },
{ sel: '#row-privacy', name: '隐私与数据安全', d: '说明数据存放位置与保护方式：纯本地应用，无后端 / 无账号 / 无需联网，数据只存本机 localStorage + IndexedDB，作者看不到、不上传。\n提醒：卸载或清除浏览器数据会删除本机数据且无法找回，唯一可靠防线是定期「导出数据」完整备份。\n本行只是只读说明入口。' },
{ sel: '#row-faq-app', name: '会不会做成 App', d: '说明为什么不考虑做成 App：功能太多，做成 App 的 Bug 只会更多，且同样存在设备适配问题，作者没有相应精力与金钱。\n本行只是只读说明入口。' },
{ sel: '#row-faq-app2', name: '自己转 App 使用', d: '说明为什么“链接转应用”不可取：没有原代码，本质是浏览器套壳，不是真正的 App，反而更容易出适配问题；直接用浏览器体验更稳定，或用“浏览器安装快捷方式到桌面”的 PWA 方式（可正常使用、可全屏）。\n本行只是只读说明入口。' },
{ sel: '#row-faq-addcard', name: '怎么添加字卡', d: '系统预设字卡只是补充类与功能衍生卡，个人使用要按自己情况添加聊天字卡：聊天 / 写信 / 朋友圈 用 自定义字卡里的【公用字卡】【专享字卡】添加。\n本行只是只读说明入口。' },
{ sel: '#row-faq-fullscreen', name: '全屏模式失效', d: '浏览器切后台再切回会导致全屏失效（浏览器限制），只能手动重新开全屏；也可用“安装快捷方式到桌面”的方式使用。手机自身顶部栏需自行开全屏隐藏，切后台后同样失效。\n本行只是只读说明入口。' },
{ sel: '#row-faq-preset', name: '系统预设字卡与功能设置', d: '建议打开系统预设字卡与功能设置（作者自用默认全开）：全开是为了不限制梦角表达，关掉反而和基础传讯网站差别不大；可先全开使用，再按个人适应情况调整。\n整组停用：字卡库→系统预设字卡 下的各页都能按分组整体停用——默认聊天字卡/词典/其他互动功能字卡/联系人跨桌面查岗在分组标题右侧，聊天情绪字卡/聊天回应字卡/TA的心情也在分组标题右侧，寻踪日常/位置卡/TA的询问·小问题·好奇·吐槽·查岗·邀请在列表上方的「整组停用『本类』」条。停用后该组字卡不再用于聊天/写信/朋友圈/词典拼字/各功能触发，组内单卡开关的设定原样保留，重新启用分组即恢复。开关按联系人桌面独立保存。\n嫌某一类整体太频繁，除整组停用外还可把该类的触发概率调到 0（设置→回复设置 的「系统预设字卡·聊天触发概率」，或各页自己的概率行）。\n本行只是只读说明入口。' },
{ sel: '#row-faq-st-lose', name: '数据为什么会自己没', d: '本站数据只存在本机浏览器里，无云端：浏览器 / 系统在清理垃圾、存储不足、长时间不打开、卸载重装、换机换浏览器时会自动清掉网站数据——属设备限制、不是 bug，删了也找不回。\n本行弹窗里有完整的「哪些操作会清数据」清单。本行只是只读说明入口。' },
{ sel: '#row-faq-st-perm', name: '浏览器存储权限', d: '浏览器要允许「保存网站数据」本站才能存东西，并关掉「退出时 / 定期自动清除」类开关；手机清理类 App（管家 / 安全中心）也要把浏览器加白名单。\n本行弹窗里有 iPhone Safari / 安卓 Chrome / 国产自带浏览器的逐项设置说明。本行只是只读说明入口。' },
{ sel: '#row-faq-st-incog', name: '无痕模式', d: '无痕（隐私 / 隐身 / InPrivate）模式关掉就全部清空，聊天记录、字卡、设置一样不留、无法找回——本站绝对不要用无痕模式打开，用正常模式 + 定期备份。\n本行只是只读说明入口。' },
{ sel: '#row-faq-st-backup', name: '备份与恢复', d: '唯一防线是定期导出：设置 → 通用 → 导出数据 → 完整备份，文件存到浏览器清不到的地方（微信收藏 / 云盘 / 电脑）；恢复走 导入数据。换设备 / 换浏览器数据不自动同步，全靠备份文件搬家；浏览器入口与桌面快捷方式两份存储不互通。\n本行只是只读说明入口。' },
{ sel: '#row-faq-st-bug', name: '丢数据是不是 bug', d: '先自查：最近是否清过浏览器数据 / 用过一键清理 / 开过无痕 / 重装过浏览器 / 换机换浏览器换入口；其它网站登录状态是否也被清；丢的是全部还是个别。全排除且高频反复丢才疑似 bug。\n本行只是只读说明入口。' }
];
var MAP = {};
DESC.forEach(function (it) { MAP[it.sel] = it; });
window.__settingsHelpDesc = MAP;
function rowOf(anchor) {
if (!anchor) return null;
if (anchor.classList && (anchor.classList.contains('set-row') || anchor.classList.contains('gs-row'))) return anchor;
return anchor.closest ? anchor.closest('.set-row, .gs-row') : null;
}
function inject() {
DESC.forEach(function (it) {
var anchor = document.querySelector(it.sel);
if (!anchor) return;
var row = rowOf(anchor);
if (!row) return;
var label = row.querySelector('.txt') || row.querySelector(':scope > span');
if (!label || label.querySelector('.tag')) return;
var tag = document.createElement('span');
tag.className = 'tag';
tag.setAttribute('data-setdesc', it.sel);
tag.setAttribute('role', 'button');
tag.setAttribute('tabindex', '0');
tag.textContent = '功能说明';
label.appendChild(tag);
});
}
function show(e, el) {
if (e) { e.preventDefault(); e.stopPropagation(); }
var it = MAP[el.getAttribute('data-setdesc')];
if (!it || !window.openModal) return;
window.openModal('【' + it.name + '】功能说明', '', function () {}, { noInput: true, staticText: it.d });
}
document.addEventListener('click', function (e) {
var t = e.target && e.target.closest ? e.target.closest('[data-setdesc]') : null;
if (t) show(e, t);
}, true);
document.addEventListener('keydown', function (e) {
if (e.key !== 'Enter' && e.key !== ' ') return;
var t = e.target && e.target.closest ? e.target.closest('[data-setdesc]') : null;
if (t) show(e, t);
});
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', inject);
else inject();
function switchRowLabel(input) {
var row = rowOf(input);
if (!row) return '';
var label = row.querySelector('.txt') || row.querySelector(':scope > span');
if (!label) return '';
var box = label.cloneNode(true);
Array.prototype.forEach.call(box.querySelectorAll('.sub, .tag'), function (n) { if (n.parentNode) n.parentNode.removeChild(n); });
return (box.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 24);
}
document.addEventListener('change', function (e) {
var input = e.target;
if (!input || input.type !== 'checkbox' || input.disabled) return;
if (input.hasAttribute('data-no-toast') || !rowOf(input)) return;
if (input.closest && input.closest('[data-no-toast]')) return;
if (typeof window.toast !== 'function') return;
var before = window.__lastToastAt || 0;
var on = !!input.checked;
var name = switchRowLabel(input);
setTimeout(function () {
if ((window.__lastToastAt || 0) !== before) return;
window.toast((name ? name + ' ' : '') + (on ? '已开启' : '已关闭'));
}, 0);
}, true);
})();
if (window.__mochiLoaded) window.__mochiLoaded.push("settings-help.js");
} catch (__e) { if (window.__mochiErrLoaded) window.__mochiErrLoaded.push("settings-help.js"); try { console.error("[JS] settings-help.js", __e && __e.message || __e); } catch (x) {} if (window.__jsErrors) window.__jsErrors.push("[settings-help.js] " + String(__e && __e.message || __e)); } })();
</script>
<script>/* inline: onboarding.js */
(function () { try {
(function () {
const G = 'xy-home-v2:';
const MARK = G + '__guide-done';
const SYS = [MARK, G + '__onboard-done', G + '__edge-backup-hint-done', G + '__last-backup', G + '__last-backup-remind', G + '__auto-backup-snapshot'];
function isFreshEnv() {
try {
for (let i = 0; i < localStorage.length; i++) {
const k = localStorage.key(i);
if (!k || k.indexOf(G) !== 0) continue;
if (SYS.indexOf(k) >= 0) continue;
return false; // 有任何业务数据键 → 老环境
}
return true;
} catch (e) { return false; }
}
function splashGone() {
const s = document.getElementById('splash');
return !s || !s.isConnected || s.classList.contains('hide');
}
function modalOpen() {
try {
const m = document.getElementById('modal-mask');
if (m && !m.hidden) return true;
const qa = document.getElementById('qa-mask');
if (qa && !qa.hidden) return true;
} catch (e) {}
return false;
}
function markDone() { try { localStorage.setItem(MARK, String(Date.now())); } catch (e) {} }
const st = document.createElement('style');
st.textContent =
'.mg-guide-mask{position:fixed;inset:0;z-index:96;background:rgba(0,0,0,.42);display:flex;align-items:center;justify-content:center;padding:18px;-webkit-tap-highlight-color:transparent}' +
'.mg-guide-mask[hidden]{display:none}' +
'.mg-guide{width:min(340px,100%);max-height:82vh;overflow-y:auto;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:18px;padding:18px 16px 16px;box-shadow:0 14px 40px rgba(0,0,0,.3)}' +
'.mg-guide-t{font-size:16px;font-weight:800;text-align:center;margin-bottom:3px}' +
'.mg-guide-sub{font-size:12px;color:var(--muted,#888);text-align:center;margin-bottom:14px}' +
'.mg-guide-step{display:flex;gap:10px;align-items:flex-start;padding:11px 12px;border-radius:12px;background:rgba(0,0,0,.04);margin-bottom:9px;cursor:pointer}' +
'.mg-guide-step:active{transform:scale(.98)}' +
'.mg-guide-n{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--ink,#111);color:var(--card-bg,#fff);font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}' +
'.mg-guide-b{flex:1;min-width:0;display:block}' +
'.mg-guide-h{display:block;font-size:13.5px;font-weight:700;margin-bottom:2px}' +
'.mg-guide-d{display:block;font-size:12px;line-height:1.6;color:var(--muted,#777)}' +
'.mg-guide-go{flex:0 0 auto;font-size:12px;font-weight:700;color:#2f6fd0;align-self:center}' +
'.mg-guide-foot{display:flex;gap:9px;margin-top:12px}' +
'.mg-guide-btn{flex:1;text-align:center;padding:11px;border-radius:11px;font-size:13px;font-weight:700;cursor:pointer}' +
'.mg-guide-btn.primary{background:var(--ink,#111);color:var(--card-bg,#fff)}' +
'.mg-guide-btn.ghost{background:rgba(0,0,0,.06);color:var(--ink,#111)}' +
'[data-theme="dark"] .mg-guide-step{background:rgba(255,255,255,.07)}' +
'[data-theme="dark"] .mg-guide-btn.ghost{background:rgba(255,255,255,.1)}' +
'[data-theme="dark"] .mg-guide-go{color:#8fb4ef}' +
'.mg-guide-warn{display:block;margin-top:6px;padding:6px 8px;border-radius:8px;background:rgba(214,132,60,.13);color:#9a5520;font-size:11.5px;line-height:1.6}' +
'[data-theme="dark"] .mg-guide-warn{background:rgba(214,132,60,.18);color:#e4ae7f}' +
'.mg-guide-tip{display:block;margin-top:6px;padding:6px 8px;border-radius:8px;background:rgba(47,111,208,.1);color:#2f6fd0;font-size:11.5px;line-height:1.6}' +
'[data-theme="dark"] .mg-guide-tip{background:rgba(47,111,208,.16);color:#8fb4ef}';
document.head.appendChild(st);
const STEPS = [
{ n: '1', h: '设置「我」和「TA」', d: '回桌面，点顶部两个头像 / 昵称，即可改名、换头像（这里是桌面那一套）。',
warn: '桌面的昵称 / 头像与聊天里的是<b>两套、互不同步</b>：桌面改完，聊天里仍显示默认「我」「TA」；聊天里的名字和头像要在「聊天页右上角 → 聊天设置 → 形象」里单独设置。',
tip: '聊天头像和聊天昵称另有一条快路：聊天输入栏左边的「更多功能」（⋯）→ 互动类 → <b>头像和昵称互动</b>——头像可上传多张头像库、点库里的图即换；昵称可存多个文字昵称、点名字即换；两边都能开「TA 随机更换 / TA 主动给我换」（每 1-8 小时一次）。',
go: 'name' },
{ n: '2', h: '先添加字卡', d: '底部「字卡库」→ 公用字卡 / 专属字卡 添加或导入；不加字卡，TA 就没有话可说。', go: 'cards' },
{ n: '3', h: '开始聊天', d: '回桌面点「聊天」图标，随便发一条消息试试（TA 会按概率回复）。', go: 'chat' }
];
let mask = null, built = false;
function build() {
if (built) return;
built = true;
mask = document.createElement('div');
mask.className = 'mg-guide-mask';
mask.hidden = true;
const box = document.createElement('div');
box.className = 'mg-guide';
let html = '<div class="mg-guide-t">新手上路 · 3 步就能用</div><div class="mg-guide-sub">点任意一步可直接跳到对应位置</div>';
STEPS.forEach(function (s) {
html += '<div class="mg-guide-step" data-gstep="' + s.go + '">'
+ '<span class="mg-guide-n">' + s.n + '</span>'
+ '<span class="mg-guide-b"><span class="mg-guide-h">' + s.h + '</span><span class="mg-guide-d">' + s.d + '</span>'
+ (s.warn ? '<span class="mg-guide-warn">' + s.warn + '</span>' : '')
+ (s.tip ? '<span class="mg-guide-tip">' + s.tip + '</span>' : '')
+ '</span>'
+ '<span class="mg-guide-go">去 →</span></div>';
});
html += '<div class="mg-guide-foot"><div class="mg-guide-btn primary" data-gact="done">知道了，开始用</div><div class="mg-guide-btn ghost" data-gact="close">以后再说</div></div>';
box.innerHTML = html;
mask.appendChild(box);
document.body.appendChild(mask);
box.addEventListener('click', function (e) {
const t = e.target;
const step = t && t.closest ? t.closest('[data-gstep]') : null;
if (step) { const g = step.getAttribute('data-gstep'); close(); goStep(g); return; }
const act = t && t.closest ? t.closest('[data-gact]') : null;
if (act) close();
});
mask.addEventListener('click', function (e) { if (e.target === mask) close(); });
}
function close() { if (mask) mask.hidden = true; markDone(); }
function goStep(go) {
try {
const phone = document.querySelector('.tab[data-page="page-phone"]');
if (go === 'name') { if (phone) phone.click(); return; }
if (go === 'chat') {
if (phone) phone.click();
const c = document.querySelector('.app[data-app="chat"]');
if (c) c.click();
return;
}
if (go === 'cards') {
const tab = document.querySelector('.tab[data-page="page-chatcard"]');
if (tab) tab.click();
const li = document.getElementById('li-custom-cards-public') || document.getElementById('li-custom-cards');
if (li) li.click();
return;
}
} catch (e) {}
}
window.openMochiGuide = function () { build(); mask.hidden = false; };
let shown = false;
const poll = setInterval(function () {
if (shown) { clearInterval(poll); return; }
if (!window.__mochiDataReady || !splashGone()) return;
if (modalOpen()) return; // 等 pwa.js 的「全新环境·导入备份」弹窗先关闭
shown = true; clearInterval(poll);
setTimeout(function () {
try { if (localStorage.getItem(MARK)) return; } catch (e) {}
if (!isFreshEnv()) return; // 老用户不打扰
window.openMochiGuide();
}, 400);
}, 300);
(function injectSettingRow() {
const about = document.querySelector('#page-setting .them-sec[data-sec="about"]');
const guideRow = document.getElementById('row-guide');
const helpGroup = (guideRow && guideRow.closest) ? guideRow.closest('.set-group') : null;
const host = helpGroup || about || document.querySelector('#page-setting .them-sec[data-sec="tools"]');
if (!host) return;
const row = document.createElement('div');
row.className = 'set-row';
row.id = 'row-guidebook';
row.innerHTML = '<div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 114 2c-.9.7-1.5 1.2-1.5 2.2"/><circle cx="12" cy="17" r=".6" fill="#111111"/></svg></div>'
+ '<div class="txt">新手引导<span class="sub">3 步上手：设置昵称头像（桌面 / 聊天分开设）/ 添加字卡 / 开始聊天</span></div>'
+ '<div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>';
const guideSub = document.getElementById('guide-sub');
if (helpGroup && guideSub && guideSub.parentNode === host) host.insertBefore(row, guideSub);
else host.appendChild(row);
row.addEventListener('click', function () { window.openMochiGuide(); });
})();
})();
if (window.__mochiLoaded) window.__mochiLoaded.push("onboarding.js");
} catch (__e) { if (window.__mochiErrLoaded) window.__mochiErrLoaded.push("onboarding.js"); try { console.error("[JS] onboarding.js", __e && __e.message || __e); } catch (x) {} if (window.__jsErrors) window.__jsErrors.push("[onboarding.js] " + String(__e && __e.message || __e)); } })();
</script>
<script>/* inline: page-coach.js */
(function () { try {
(function () {
const G = 'xy-home-v2:';
const MARK = G + '__coach-seen';
function seen() {
try { const v = JSON.parse(localStorage.getItem(MARK) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; }
}
function markSeen(id) {
try {
const v = seen();
if (v.indexOf(id) < 0) { v.push(id); localStorage.setItem(MARK, JSON.stringify(v)); }
} catch (e) {}
}
function resetAll() {
try { localStorage.removeItem(MARK); } catch (e) {}
const bars = document.querySelectorAll('.pc-bar');
for (let i = 0; i < bars.length; i++) bars[i].remove();
}
const REG = [
{
id: 'chatcard', page: 'page-chatcard',
name: '字卡库（公用 / 专属）',
open: ['.tab[data-page="page-chatcard"]'],
skipText: '你已经有字卡，这页不再提示',
tip: '先选「公用字卡」，右上「+」添加或用「批量导入」导入；一张卡都没有时，TA 就没有话可说。',
act: { label: '去添加字卡', go: ['#li-custom-cards-public'] },
hubs: ['.tab[data-page="page-chatcard"]'],
need: function () {
try {
const has = function (raw) {
if (!raw) return false;
const d = typeof raw === 'string' ? JSON.parse(raw) : raw;
for (const k in d) { if (Array.isArray(d[k]) && d[k].some(function (g) { return g && Array.isArray(g[1]) && g[1].length; })) return true; }
return false;
};
return !has(window.xyStore(window.activePrefix()).get('cc-groups')) && !has(window.xyStore(G).get('cc-groups-public'));
} catch (e) { return false; }
}
},
{
id: 'theme', page: 'page-theme',
name: '手机桌面美化',
open: ['#row-appearance'],
tip: '这一页有主题色、壁纸、图标、字号、圆角、组件七八组——先用「方案」一键套用，再按需要逐项微调。',
act: { label: '去套用方案', go: ['.them-tab[data-tab="scheme"]'] },
hubs: ['#row-appearance']
},
{
id: 'reply-settings', page: 'page-reply-settings',
name: '回复设置',
open: ['#row-general'],
tip: '看着像一屏参数，其实先只调「回复速度（最短/最长）」和「回复条数」就够用，其余保持默认。',
hubs: ['#row-general']
}
];
(function injectStyle() {
const st = document.createElement('style');
st.textContent =
'.pc-bar{margin:10px 12px 4px;border-radius:12px;background:rgba(47,111,208,.09);border:1px solid rgba(47,111,208,.22);padding:10px 12px;font-size:12.5px;line-height:1.6;color:var(--ink,#111)}' +
'.pc-row{display:flex;gap:8px;align-items:flex-start}' +
'.pc-txt{flex:1;min-width:0}' +
'.pc-act{flex:0 0 auto;font-size:12.5px;font-weight:700;color:#2f6fd0;background:none;border:0;padding:0;cursor:pointer;white-space:nowrap}' +
'.pc-x{flex:0 0 auto;color:var(--muted,#999);font-size:15px;line-height:1;padding:0 2px;cursor:pointer}' +
'.pc-more{margin-top:8px;border-top:1px dashed rgba(47,111,208,.28);padding-top:6px;max-height:34vh;overflow-y:auto}' +
'.pc-item{padding:7px 2px;border-bottom:1px solid rgba(0,0,0,.06);cursor:pointer}' +
'.pc-item:last-child{border-bottom:0}' +
'.pc-item .pc-n{font-weight:700}' +
'.pc-item .pc-d{color:var(--muted,#777);font-size:12px;display:block;margin-top:1px}' +
'.pc-toggle{margin-top:7px;font-size:12px;color:#2f6fd0;cursor:pointer;display:inline-block}' +
'[data-theme="dark"] .pc-bar{background:rgba(143,180,239,.12);border-color:rgba(143,180,239,.3)}' +
'[data-theme="dark"] .pc-act,[data-theme="dark"] .pc-toggle{color:#8fb4ef}' +
'[data-theme="dark"] .pc-item{border-bottom-color:rgba(255,255,255,.08)}' +
'.pc-sh-mask{position:fixed;inset:0;z-index:97;background:rgba(0,0,0,.42);display:flex;align-items:flex-end;justify-content:center;-webkit-tap-highlight-color:transparent}' +
'.pc-sh-mask[hidden]{display:none}' +
'.pc-sh{width:min(430px,100%);max-height:84vh;overflow-y:auto;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:18px 18px 0 0;padding:16px 14px calc(14px + var(--mochi-safe-bottom,env(safe-area-inset-bottom,0px)));box-shadow:0 -10px 34px rgba(0,0,0,.3)}' +
'.pc-sh-t{font-size:16px;font-weight:800;text-align:center;margin-bottom:4px}' +
'.pc-sh-s{font-size:12px;line-height:1.7;color:var(--muted,#888);margin-bottom:12px}' +
'.pc-sh-item{padding:10px 12px;border-radius:12px;background:rgba(0,0,0,.04);margin-bottom:8px;cursor:pointer}' +
'.pc-sh-item:active{transform:scale(.99)}' +
'.pc-sh-h{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700}' +
'.pc-sh-st{flex:1;font-weight:400;font-size:11px;color:var(--muted,#888)}' +
'.pc-sh-go{flex:0 0 auto;font-size:12px;font-weight:700;color:#2f6fd0;white-space:nowrap}' +
'.pc-sh-d{font-size:12px;line-height:1.7;color:var(--muted,#777);margin-top:4px}' +
'.pc-sh-msg{margin:2px 2px 10px;padding:9px 11px;border-radius:10px;background:rgba(47,111,208,.12);color:#2f6fd0;font-size:12px;line-height:1.65}' +
'.pc-sh-msg[hidden]{display:none}' +
'.pc-sh-foot{display:flex;gap:9px;margin-top:4px}' +
'.pc-sh-btn{flex:1;padding:12px;border:0;border-radius:12px;font-size:13px;font-weight:700;font-family:inherit;background:rgba(0,0,0,.07);color:var(--ink,#111);cursor:pointer}' +
'.pc-sh-btn.main{background:var(--ink,#111);color:var(--card-bg,#fff)}' +
'[data-theme="dark"] .pc-sh-item{background:rgba(255,255,255,.07)}' +
'[data-theme="dark"] .pc-sh-btn{background:rgba(255,255,255,.12)}' +
'[data-theme="dark"] .pc-sh-btn.main{background:#8fb4ef;color:#111}' +
'[data-theme="dark"] .pc-sh-go{color:#8fb4ef}';
document.head.appendChild(st);
})();
function runGo(go) {
try {
(go || []).forEach(function (sel) {
const el = document.querySelector(sel);
if (el) el.click();
});
} catch (e) {}
}
function buildBar(cfg) {
const bar = document.createElement('div');
bar.className = 'pc-bar';
bar.setAttribute('data-pc', cfg.id);
const items = (window.mochiHubItemsFor ? window.mochiHubItemsFor(cfg.hubs) : []) || [];
let html = '<div class="pc-row"><span class="pc-txt"><b>先把这页用起来：</b>' + cfg.tip + '</span>'
+ (cfg.act ? '<button class="pc-act" data-pcact="1">' + cfg.act.label + '</button>' : '')
+ '<span class="pc-x" data-pcx="1">×</span></div>';
if (items.length) {
html += '<div class="pc-toggle" data-pctoggle="1">这页还有什么（' + items.length + '）▾</div><div class="pc-more" hidden>';
items.forEach(function (it, i) {
html += '<div class="pc-item" data-pcitem="' + i + '"><span class="pc-n">' + it.n + '</span><span class="pc-d">' + (it.d || '') + '</span></div>';
});
html += '</div>';
}
bar.innerHTML = html;
bar.addEventListener('click', function (e) {
const t = e.target;
if (!t || !t.closest) return;
if (t.closest('[data-pcx]')) { bar.remove(); return; }
if (t.closest('[data-pcact]')) { runGo(cfg.act && cfg.act.go); bar.remove(); return; }
const tg = t.closest('[data-pctoggle]');
if (tg) {
const more = bar.querySelector('.pc-more');
if (more) { more.hidden = !more.hidden; tg.textContent = tg.textContent.replace(/[▾▴]$/, more.hidden ? '▾' : '▴'); }
return;
}
const it = t.closest('[data-pcitem]');
if (it) { const k = parseInt(it.getAttribute('data-pcitem'), 10); if (items[k]) runGo(items[k].go); }
});
return bar;
}
function mountBar(page, bar) {
if (page.scrollHeight - page.clientHeight > 0) { page.insertBefore(bar, page.firstChild); return; }
const all = page.querySelectorAll('*');
for (let i = 0; i < all.length; i++) {
const n = all[i];
if (n === bar || (n.closest && n.closest('.pc-bar'))) continue;
let oy = '';
try { oy = getComputedStyle(n).overflowY; } catch (e) { continue; }
if (!/(auto|scroll)/.test(oy)) continue;
if (!n.firstElementChild || n.clientHeight < 120) continue;
n.insertBefore(bar, n.firstChild);
return;
}
page.insertBefore(bar, page.firstChild);
}
REG.forEach(function (cfg) {
const page = document.getElementById(cfg.page);
if (!page || !window.MutationObserver) return;
const mo = new MutationObserver(function () {
const old = page.querySelector('.pc-bar[data-pc="' + cfg.id + '"]');
if (page.hidden) { if (old) old.remove(); return; } // 离开即收起：提示不常驻页面（回来由已看标记决定不再弹）
if (seen().indexOf(cfg.id) >= 0) return;
if (old) return;
setTimeout(function () { // 等页面入场一帧，别和切页动画抢主线程
try {
if (page.hidden || seen().indexOf(cfg.id) >= 0) return;
if (page.querySelector('.pc-bar[data-pc="' + cfg.id + '"]')) return;
if (typeof cfg.need === 'function' && !cfg.need()) { markSeen(cfg.id); return; }
mountBar(page, buildBar(cfg));
markSeen(cfg.id); // 「一生一次」：显示即标记，避免忽略后反复打扰；要重看走设置里的重置
} catch (e) {}
}, 380);
});
mo.observe(page, { attributes: true, attributeFilter: ['hidden'] });
});
document.addEventListener('click', function (e) {
const t = e.target;
if (!t || !t.closest) return;
if (t.closest('#memo-empty-add')) { const i = document.getElementById('memo-inp'); if (i) { try { i.focus(); } catch (e0) {} } return; }
if (t.closest('#feed-empty-pub')) { const b = document.getElementById('feed-publish-btn'); if (b) b.click(); return; }
if (t.closest('#dl-empty-put')) { const b = document.getElementById('d-put'); if (b) b.click(); return; }
});
(function injectSettingRow() {
const sec = document.querySelector('#page-setting .them-sec[data-sec="tools"]')
|| document.querySelector('#page-setting .them-sec[data-sec="about"]');
if (!sec) return;
const grp = document.createElement('div');
grp.className = 'set-group glass';
grp.innerHTML = '<div class="set-row" id="row-pagetips">'
+ '<div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 00-3.5 10.9V16h7v-2.1A6 6 0 0012 3z"/><path d="M10 19h4"/></svg></div>'
+ '<div class="txt">使用提示<span class="sub">点开可看每页会提示什么、重新显示这些上手提示、直接去对应页面</span></div>'
+ '<div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>'
+ '</div>';
sec.appendChild(grp);
function tipToast(msg) {
try { if (typeof window.toast === 'function') { window.toast(msg); return; } } catch (e) {}
try {
let t = document.getElementById('cc-toast');
if (!t) { t = document.createElement('div'); t.id = 'cc-toast'; document.body.appendChild(t); }
t.textContent = msg; t.className = 'cc-toast'; void t.offsetWidth; t.className = 'cc-toast show';
clearTimeout(t._timer); t._timer = setTimeout(function () { t.className = 'cc-toast'; }, 2400);
} catch (e) {}
}
const row = grp.querySelector('#row-pagetips');
if (row) row.addEventListener('click', function () { openSheet(); });
let sheet = null;
function willShow(cfg) {
try { return !(typeof cfg.need === 'function' && !cfg.need()); } catch (e) { return true; }
}
function ensureSheet() {
if (sheet && sheet.isConnected) return sheet;
sheet = document.createElement('div');
sheet.className = 'pc-sh-mask';
sheet.id = 'pc-sheet-mask'; // id 形态：mobile-adapt FLOAT_SELECTORS / tabs 返回键清单按 id 登记
sheet.hidden = true;
sheet.innerHTML = '<div class="pc-sh">'
+ '<div class="pc-sh-t">使用提示</div>'
+ '<div class="pc-sh-s">复杂页面第一次进去会自己在页面里显示一条「先把这页用起来」；看过就不再打扰。可以在这里重新显示，也可以直接去对应页面。</div>'
+ '<div class="pc-sh-list"></div>'
+ '<div class="pc-sh-msg" hidden></div>'
+ '<div class="pc-sh-foot">'
+ '<button type="button" class="pc-sh-btn main" data-shreset="1">重新显示这些提示</button>'
+ '<button type="button" class="pc-sh-btn" data-shclose="1">关闭</button>'
+ '</div></div>';
document.body.appendChild(sheet);
sheet.addEventListener('click', function (e) {
const t = e.target;
if (!t || !t.closest) return;
if (t.closest('[data-shclose]') || t === sheet) { closeSheet(); return; }
if (t.closest('[data-shreset]')) {
resetAll();
tipToast('已重置：再进入那些页面会重新看到上手提示');
renderSheet(true);
return;
}
const it = t.closest('[data-shgo]');
if (it) {
const cfg = REG[parseInt(it.getAttribute('data-shgo'), 10)];
closeSheet();
if (cfg) setTimeout(function () { runGo(cfg.open); }, 60); // 等遮罩收起再切页，免与入场动画抢帧
}
});
return sheet;
}
function renderSheet(justReset) {
if (!sheet) return;
let html = '';
REG.forEach(function (cfg, i) {
const ok = willShow(cfg);
html += '<div class="pc-sh-item" data-shgo="' + i + '">'
+ '<div class="pc-sh-h"><span>' + cfg.name + '</span>'
+ '<span class="pc-sh-st">' + (ok ? '下次进入会提示' : (cfg.skipText || '这页当前不需要提示')) + '</span>'
+ '<span class="pc-sh-go">去看看 →</span></div>'
+ '<div class="pc-sh-d">' + cfg.tip + '</div></div>';
});
sheet.querySelector('.pc-sh-list').innerHTML = html;
const msg = sheet.querySelector('.pc-sh-msg');
if (justReset) {
let n = 0;
REG.forEach(function (c) { if (willShow(c)) n++; });
msg.textContent = n
? '已重新显示：进入上面标着「下次进入会提示」的 ' + n + ' 个页面，就会看到「先把这页用起来」提示条。'
: '已重新显示：不过这几页目前都不需要提示（条件见上方说明）。';
msg.hidden = false;
} else {
msg.hidden = true; msg.textContent = '';
}
}
function openSheet() { ensureSheet(); renderSheet(false); sheet.hidden = false; }
function closeSheet() { if (sheet) sheet.hidden = true; } // 关＝置 hidden（属性变更会解开 mobile-adapt 的背景滚动锁）
})();
window.mochiPageTipsReset = resetAll; // 供验证脚本/调试复位
window.mochiPageTipsPanel = function () { // 供验证脚本/调试直达面板
const row = document.getElementById('row-pagetips');
if (row) row.click();
};
})();
if (window.__mochiLoaded) window.__mochiLoaded.push("page-coach.js");
} catch (__e) { if (window.__mochiErrLoaded) window.__mochiErrLoaded.push("page-coach.js"); try { console.error("[JS] page-coach.js", __e && __e.message || __e); } catch (x) {} if (window.__jsErrors) window.__jsErrors.push("[page-coach.js] " + String(__e && __e.message || __e)); } })();
