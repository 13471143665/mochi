      '.crw-out:focus{border-color:#9a9a9a}',
      '.crw-pri{background:#111;color:#fff;box-shadow:none}',
      '.crw-sec{border-color:#e2e2e2;color:#333}',
      '.crw-eco-link{color:#777}',
      '[data-theme="dark"] .crw-mask{background:rgba(0,0,0,.62)}',
