        '<div class="qd-tip" id="qd-edit-tip">保存后 TA 会在今天随机时刻写批注（可在设置里改）</div>' +
      '</div>';
    D.body.appendChild(sheet);

    /* ---- 当日记录 ---- */
    var day = D.createElement('div');
    day.id = 'qd-day'; day.className = 'qd-sheet';
    day.innerHTML =
      '<div class="qd-sheet-box">' +
        '<div class="qd-sheet-hd"><span id="qd-day-title">今天的记录</span><button class="qd-x" id="qd-day-x">✕</button></div>' +
        '<div class="qd-daylist" id="qd-day-list"></div>' +
        '<div class="qd-row"><button class="qd-btn" id="qd-day-add">＋ 再记一笔</button></div>' +
      '</div>';
    D.body.appendChild(day);

    /* ---- 日记本 ---- */
    var diary = D.createElement('div');
    diary.id = 'qd-diary'; diary.className = 'qd-ov qd-page qd-diary';
    diary.innerHTML =
      '<div class="qd-wall"></div>' +
      '<div class="qd-dwrap">' +
        '<div class="qd-dhd">' +
          '<button class="qd-icbtn" id="qd-diary-home" aria-label="回到主页"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.6L12 3.6l8.5 7"/><path d="M5.6 9.4V20h12.8V9.4"/><path d="M9.8 20v-5.4h4.4V20"/></svg></button>' +
          '<button class="qd-icbtn" id="qd-diary-back" aria-label="返回"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>' +
          '<div class="qd-dtitle">日记本</div>' +
        '</div>' +
        '<div class="qd-dtop"><div class="qd-bub"><textarea id="qd-bub" data-ce-skip="1" rows="1" placeholder="欢迎业主回家！"></textarea></div></div>' +
        '<div class="qd-dbody" id="qd-dbody">' +
          '<div class="qd-memories">' +
            '<div class="qd-mem-hd"><span>OUR SMALL MEMORIES</span><span id="qd-mem-n">00 / 00</span></div>' +
            '<div class="qd-polaroids" id="qd-album"></div>' +
          '</div>' +
          '<div class="qd-search2">' +
            '<input type="text" id="qd-search" data-ce-skip="1" placeholder="搜索关键词" autocomplete="off">' +
            '<input type="text" data-ce-skip="1" id="qd-search-date" placeholder="日期 2026-11" autocomplete="off">' +
          '</div>' +
          '<div class="qd-dsec-h qd-route-hd"><span>成长路线<i id="qd-route-n"></i></span>' +
            '<div class="qd-daynav">' +
              '<button id="qd-dprev" aria-label="最早记录"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>' +
              '<button id="qd-dnext" aria-label="最新记录"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7"/></svg></button>' +
            '</div>' +
          '</div>' +
          '<div class="qd-list" id="qd-list"></div>' +
        '</div>' +
      '</div>';
    D.body.appendChild(diary);

    /* ---- 设置 ---- */
    var set = D.createElement('div');
    set.id = 'qd-set'; set.className = 'qd-ov qd-page';
    set.innerHTML =
      '<div class="qd-wall"></div><div class="qd-wrap">' +
        '<div class="qd-hd">' +
          '<button class="qd-icbtn" id="qd-set-back" aria-label="返回"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>' +
          '<div class="qd-title" style="font-size:19px">四象限设置</div>' +
        '</div>' +
        '<div class="qd-set-body" id="qd-set-body">' +
          '<div class="qd-set-h">美化 · 两个界面通用</div>' +
          '<div class="qd-sec">' +
            '<div class="qd-srow" id="qd-row-wall"><div class="n">四象限壁纸<small>浅色 / 深色两栏，跟随深色模式；主页与日记本共用</small></div><div class="v" id="qd-wall-v">未设置</div></div>' +
            '<div class="qd-srow" id="qd-row-bub"><div class="n">气泡背景图<small>浅色 / 深色两栏；用作四个格子的底纹</small></div><div class="v" id="qd-bub-v">未设置</div></div>' +
            '<div class="qd-srow" id="qd-row-color"><div class="n">排版块颜色<small>格子底色（没有气泡图时生效）</small></div><div class="v"><b id="qd-color-v">默认</b></div></div>' +
          '</div>' +
          '<div class="qd-set-h">批注</div>' +
          '<div class="qd-sec">' +
            '<div class="qd-srow" id="qd-row-annot-on"><div class="n">每天随机加批注<small>记录后当天随机时刻出现，00:00 截止</small></div><div class="v" id="qd-annot-on-v">开</div></div>' +
            '<div class="qd-srow" id="qd-row-annot-count"><div class="n">每天条数<small>1～20 句（每格最多 5 句），随机时刻出现</small></div><div class="v"><b id="qd-annot-count-v">3</b> 句</div></div>' +
            '<div class="qd-srow" id="qd-row-cat"><div class="n">内容分类与概率<small>按专属字卡的分类分别调概率（点开设置）</small></div><div class="v" id="qd-cat-v">默认</div></div>' +
          '</div>' +
          '<div class="qd-set-h">说明</div>' +
          '<div class="qd-sec" style="padding:12px 14px"><div class="qd-tip" style="line-height:1.8">· 长按格子写一笔；右上角＋记一笔；页面底部「今天的全部记录」看今天所有。<br>· 每一格的图片统一排在格子底部，从左到右；图片只存本机。<br>· 日记本：照片在上，搜索居中，下面是成长路线；点一格只看这一格的当天记录，不再编辑。</div></div>' +
        '</div>' +
      '</div>';
    D.body.appendChild(set);

    /* ---- 单日查看 ---- */
    var view = D.createElement('div');
    view.id = 'qd-view'; view.className = 'qd-view';
    view.innerHTML =
      '<div class="qd-view-in">' +
        '<button class="qd-view-x" id="qd-view-x">✕</button>' +
        '<div class="qd-view-card" id="qd-view-card"></div>' +
      '</div>';
    D.body.appendChild(view);

    /* ---- 图片查看 ---- */
    var photo = D.createElement('div');
    photo.id = 'qd-photo'; photo.className = 'qd-photo';
    photo.innerHTML =
      '<button class="qd-photo-x" id="qd-photo-x">✕</button>' +
      '<button class="qd-photo-nav l" id="qd-photo-l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>' +
      '<div class="qd-photo-img"><img id="qd-photo-img" alt=""></div>' +
      '<button class="qd-photo-nav r" id="qd-photo-r"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>' +
      '<div class="qd-photo-bar"><div class="qd-bubble" id="qd-photo-time"></div></div>';
    D.body.appendChild(photo);

    /* v77：全部照片（从拍立得点开） */
    var allp = D.createElement('div');
    allp.id = 'qd-allp'; allp.className = 'qd-allp';
    allp.innerHTML =
      '<div class="qd-allp-box">' +
        '<div class="qd-allp-hd"><b>所有照片</b><span id="qd-allp-n"></span>' +
          '<button class="qd-allp-x" id="qd-allp-x" aria-label="关闭">✕</button></div>' +
        '<div class="qd-allp-grid" id="qd-allp-grid"></div>' +
      '</div>';
    D.body.appendChild(allp);

    /* v77：日记本改名弹窗（不走通用 openModal，避免输入被增强器接管读不到） */
    var lpop = D.createElement('div');
    lpop.id = 'qd-label-pop'; lpop.className = 'qd-label-pop';
    lpop.innerHTML =
      '<div class="qlp-box"><b>日记本名字</b>' +
        '<input id="qd-label-in" data-ce-skip="1" maxlength="16" placeholder="留空＝日记本">' +
        '<div class="qlp-row">' +
          '<button id="qd-label-cancel" type="button">取消</button>' +
          '<button id="qd-label-ok" type="button">保存</button>' +
        '</div>' +
      '</div>';
    D.body.appendChild(lpop);

    /* ---- 图库 ---- */
    var gal = D.createElement('div');
    gal.id = 'qd-gal'; gal.className = 'qd-gal';
    gal.innerHTML = '<div class="qd-gal-box" id="qd-gal-box"></div>';
    D.body.appendChild(gal);

    /* ---- 字卡勾选 ---- */
    var pick = D.createElement('div');
    pick.id = 'qd-pick'; pick.className = 'qd-pick';
    pick.innerHTML = '<div class="qd-pick-box" id="qd-pick-box"></div>';
    D.body.appendChild(pick);

    /* ---- 分类概率 ---- */
    var catp = D.createElement('div');
    catp.id = 'qd-cat'; catp.className = 'qd-cat';
    catp.innerHTML = '<div class="qd-cat-box" id="qd-cat-box"></div>';
    D.body.appendChild(catp);

    /* ---- 开屏署名设置 ---- */
    var sign = D.createElement('div');
    sign.id = 'qd-sign'; sign.className = 'qd-gal';
    sign.innerHTML = '<div class="qd-gal-box" id="qd-sign-box"></div>';
    D.body.appendChild(sign);

    bindAll();
  }

  /* ---------------- 绑定 ---------------- */
  function bindAll() {
    on($('qd-back'), 'click', closeQuad);
    on($('qd-diary-home'), 'click', function () {
      /* v79：日记本左上「回主页」——先关日记本，再关四象限，落回桌面 */
      var d = $('qd-diary'); if (d) d.classList.remove('on');
      var q = $('qd-page'); if (q) q.classList.remove('on');
      var s2 = $('qd-set'); if (s2) s2.classList.remove('on');
    });
    on($('qd-set-btn'), 'click', openSet);
    on($('qd-set-back'), 'click', function () { $('qd-set').classList.remove('on'); });
    on($('qd-diary-back'), 'click', function () { $('qd-diary').classList.remove('on'); });

    on($('qd-edit-x'), 'click', closeEdit);
    on($('qd-edit'), 'click', function (e) { if (e.target === $('qd-edit')) closeEdit(); });
    on($('qd-edit-pick'), 'click', function () {
      pickImage(function (ids) {
        ids.forEach(function (id) { editImgs.push(id); });
        renderEditImgs();
        setTimeout(renderEditImgs, 450);
      });
    });
    on($('qd-edit-save'), 'click', saveEdit);
    on($('qd-edit-del'), 'click', delEditing);

    on($('qd-day-x'), 'click', function () { $('qd-day').classList.remove('on'); });
    on($('qd-day'), 'click', function (e) { if (e.target === $('qd-day')) $('qd-day').classList.remove('on'); });
    on($('qd-day-add'), 'click', function () {
      var z = $('qd-day').getAttribute('data-z') || 'exp';
      $('qd-day').classList.remove('on');
      openEdit(z, null);
    });

    on($('qd-search'), 'input', renderDiary);
    on($('qd-search-date'), 'input', renderDiary);
    on($('qd-dprev'), 'click', function () { scrollDiary('oldest'); });
    on($('qd-dnext'), 'click', function () { scrollDiary('latest'); });
    on($('qd-today'), 'click', function () { openDaySheet('all'); });
    on($('qd-allp-x'), 'click', function () { $('qd-allp').classList.remove('on'); });
    on($('qd-label-ok'), 'click', saveDiaryLabel);
    on($('qd-label-cancel'), 'click', function () { $('qd-label-pop').classList.remove('on'); });
    on($('qd-label-pop'), 'click', function (e) {
      var pop = $('qd-label-pop');
      /* 长按弹起时的那一下 click 会落在刚出现的遮罩上，400ms 内不当成「点空白关闭」 */
      if (Date.now() - (pop.__t || 0) < 400) return;
      if (e.target === pop) pop.classList.remove('on');
    });
    var lin = $('qd-label-in');
    if (lin) lin.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); saveDiaryLabel(); } });
    on($('qd-allp'), 'click', function (e) { if (e.target === $('qd-allp')) $('qd-allp').classList.remove('on'); });
    var bub = $('qd-bub');
    if (bub) {
      on(bub, 'input', function () {
        S.diary.text = bub.value;
        growBubble();
        save();
      });
      on(bub, 'focus', function () { setTimeout(growBubble, 30); });
    }
    function closeDayView() {
      var v = $('qd-view'); if (!v) return;
      v.classList.remove('on'); v.classList.remove('readonly');
    }
    on($('qd-view-x'), 'click', closeDayView);
    on($('qd-view'), 'click', function (e) { if (e.target === $('qd-view')) closeDayView(); });

    on($('qd-photo-x'), 'click', function () { $('qd-photo').classList.remove('on'); });
    on($('qd-photo-l'), 'click', function () { stepPhoto(-1); });
    on($('qd-photo-r'), 'click', function () { stepPhoto(1); });

    on($('qd-set'), 'click', function (e) { if (e.target === $('qd-set')) $('qd-set').classList.remove('on'); });
    on($('qd-row-wall'), 'click', function () { openGallery('wall'); });
    on($('qd-row-bub'), 'click', function () { openGallery('bub'); });
    on($('qd-row-color'), 'click', pickCardColor);
    on($('qd-row-annot-on'), 'click', function () {
      S.annot.on = !S.annot.on; save(); renderSet(); toast(S.annot.on ? '已开启每天批注' : '已关闭每天批注');
    });
    on($('qd-row-annot-count'), 'click', pickAnnotCount);
    on($('qd-row-cat'), 'click', openCatProb);
    on($('qd-cat'), 'click', function (e) { if (e.target === $('qd-cat')) $('qd-cat').classList.remove('on'); });

    /* v75：四象限向右滑 → 日记本 */
    var qp = $('qd-page');
    if (qp) {
      var sw = { x: 0, y: 0, t: 0, on: false };
      qp.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) { sw.on = false; return; }
        sw.x = e.touches[0].clientX; sw.y = e.touches[0].clientY;
        sw.t = Date.now(); sw.on = true;
      }, { passive: true });
      qp.addEventListener('touchmove', function (e) {
        if (!sw.on || e.touches.length !== 1) return;
        var dx = e.touches[0].clientX - sw.x, dy = e.touches[0].clientY - sw.y;
        if (dx > 64 && Math.abs(dx) > Math.abs(dy) * 1.6 && Date.now() - sw.t < 800) {
          sw.on = false;
          openDiary();
        }
      }, { passive: true });
      qp.addEventListener('touchend', function () { sw.on = false; }, { passive: true });
      qp.addEventListener('touchcancel', function () { sw.on = false; }, { passive: true });
    }

    /* 底部 tab 切换时收起 */
    D.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest) return;
      if (e.target.closest('.tab')) { closeAll(); }
    }, true);
  }

  function closeAll() {
    ['qd-page', 'qd-diary', 'qd-set', 'qd-edit', 'qd-day', 'qd-view', 'qd-photo', 'qd-gal', 'qd-pick', 'qd-sign'].forEach(function (id) {
      var e = $(id); if (e) e.classList.remove('on');
    });
  }
  function isQuadOpen() { var p = $('qd-page'); return !!(p && p.classList.contains('on')); }
  function closeQuad() { $('qd-page').classList.remove('on'); }

  /* ---------------- 渲染主界面 ---------------- */
  function renderQuad() {
    if (!loaded || !$('qd-grid')) return;
    var today = dkey(new Date());
    var recsToday = S.recs.filter(function (r) { return r.d === today; });
    var grid = $('qd-grid');
    grid.innerHTML = '';
    ZONES.forEach(function (z) { grid.appendChild(buildCell(z, today)); });

    var dt = new Date();
    var wk = '日一二三四五六'[dt.getDay()];
    $('qd-date').textContent = today + ' 星期' + wk + ' · 今天 ' + recsToday.length + ' 条记录';

    var foot = '';
    if (!S.annot.on) foot = '批注已关闭（设置里可重新打开）';
    else {
      var pp = S.plan[today], pending = 0;
      if (pp && Array.isArray(pp.slots)) {
        pp.slots.forEach(function (t, i) { if (!pp.done[i]) pending++; });
      }
      if (!recsToday.length) foot = '今天还没记录 · 长按格子或点右上角＋写一笔';
      else if (!usableCats()) foot = 'TA 的批注需要「专属字卡」· 去 字卡库 → 专属字卡 添加';
      else if (pending > 0) foot = 'TA 会在今天 00:00 前随机再写 ' + pending + ' 句批注';
      else foot = '今天的批注已经写完了 · 明天继续';
    }
    $('qd-foot').textContent = foot;
    renderDiaryBar();
    syncQdCard();
  }

  function buildCell(z, today) {
    var cell = mk('div', 'qd-cell');
    cell.setAttribute('data-z', z.k);
    var hd = mk('div', 'qd-cell-hd');
    /* v80（用户直派「日记本的经历图标也要加在四象限」）：四格小图标同步到主格子 */
    var zico = mk('span', 'qd-dc-ico qd-cell-ico');
    zico.innerHTML = ZICONS[z.k] || '';
    hd.appendChild(zico);
    hd.appendChild(mk('span', 'qd-chip', z.n));
    var add = mk('button', 'qd-cell-add', '＋');
    add.type = 'button';
    add.setAttribute('aria-label', '记一笔');
    on(add, 'click', function (e) { touchStop(e); openEdit(z.k, null); });
    hd.appendChild(add);
    cell.appendChild(hd);

    var body = mk('div', 'qd-body');
    var recs = S.recs.filter(function (r) { return r.d === today && r.z === z.k; })
      .sort(function (a, b) { return b.at - a.at; });

    recs.slice(0, 3).forEach(function (r) {
      var e = mk('div', 'qd-entry');
      e.setAttribute('data-rec', r.id);
      e.appendChild(mk('div', 'qd-entry-t', hm(r.at)));
      e.appendChild(mk('div', 'qd-entry-x', r.t || '（图片）'));
      body.appendChild(e);
    });
    if (recs.length > 3) {
      var more = mk('div', 'qd-empty', '共 ' + recs.length + ' 条 · 点底部「今天的全部记录」');
      more.style.fontSize = '10px';
      body.appendChild(more);
    }
    cell.appendChild(body);

    /* v75：图片统一排到格子底部，从左到右 */
    var pics = [];
    recs.forEach(function (r) {
      (r.imgs || []).forEach(function (id) { pics.push({ id: id, at: r.at }); });
    });
    if (pics.length) {
      var strip = mk('div', 'qd-cell-imgs');
      pics.slice(0, 16).forEach(function (p, pi) {
        var im = mk('img', 'qd-cell-img'); im.alt = '';
        im.src = imgUse(p.id) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
        on(im, 'click', function (e) { touchStop(e); openPhoto(pics, pi); });
        strip.appendChild(im);
      });
      if (pics.length > 16) strip.appendChild(mk('span', 'qd-img-more', '+' + (pics.length - 16)));
      cell.appendChild(strip);
    }

    /* 便签：有批注就随机贴一张在方块上 */
    var notes = notesOf(today, z.k);
    var placed = [];
    notes.forEach(function (n, idx) {
      if (typeof n.nx !== 'number') {
        n.nx = 4 + Math.random() * 32;
        n.ny = 34 + Math.random() * 30;
        n.rot = (Math.random() * 8 - 4).toFixed(1);
        save();
      }
      var nx = n.nx, ny = n.ny, tries = 0;
      while (tries < 14) {
        var clash = false;
        for (var pi = 0; pi < placed.length; pi++) {
          if (Math.abs(nx - placed[pi][0]) < 30 && Math.abs(ny - placed[pi][1]) < 25) { clash = true; break; }
        }
        if (!clash) break;
        nx = 5 + ((idx + tries) % 3) * 30;
        ny = 18 + (Math.floor((idx + tries) / 3) % 3) * 26;
        tries++;
      }
      placed.push([nx, ny]);
      var st = mk('div', 'qd-sticky' + (idx >= 2 ? ' mini' : ''));
      st.style.left = nx + '%';
      st.style.top = ny + '%';
      st.style.setProperty('--rot', (n.rot || '-3') + 'deg');
      st.appendChild(mk('small', '', 'TA · ' + hm(n.revealAt)));
      st.appendChild(noteNode(n.t));
      on(st, 'click', function (e) { touchStop(e); openDaySheet(z.k); });
      cell.appendChild(st);
    });

    /* v74：长按格子＝大号四象限弹窗里写；单击条目＝编辑；单击空白＝也写 */
    var lp = 0, sx = 0, sy = 0, fired = false;
    cell.addEventListener('pointerdown', function (e) {
      if (e.target.closest('button')) return;
      fired = false; sx = e.clientX; sy = e.clientY;
      clearTimeout(lp);
      lp = setTimeout(function () {
        fired = true;
        if (navigator.vibrate) { try { navigator.vibrate(12); } catch (x) {} }
        /* v80（用户直派「四象限的单格长按可以看到一个大格子的弹窗，显示写过的全部内容」） */
        openZoneAll(z.k);
      }, 520);
    });
    cell.addEventListener('pointermove', function (e) {
      if (Math.abs(e.clientX - sx) > 10 || Math.abs(e.clientY - sy) > 10) clearTimeout(lp);
    });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
      cell.addEventListener(ev, function () { clearTimeout(lp); });
    });
    cell.addEventListener('click', function (e) {
      if (e.target.closest('button')) return;
      if (fired) { fired = false; try { e.preventDefault(); e.stopPropagation(); } catch (x) {} return; }
      var er = e.target.closest('[data-rec]');
      if (er) { openEdit(z.k, er.getAttribute('data-rec')); return; }
      openEdit(z.k, null);
    });
    return cell;
  }

  /* ---------------- 编辑 ---------------- */
  var editZone = 'exp', editId = null, editImgs = [], draftT = 0;
  function openEdit(zone, id) {
    ensureDom();
    editZone = zone; editId = id || null; editImgs = [];
    var z = zoneOf(zone);
    var rec = null;
    if (id) { for (var i = 0; i < S.recs.length; i++) if (S.recs[i].id === id) rec = S.recs[i]; }
    var chip = $('qd-edit-chip');
    if (chip) chip.textContent = z.n;
    $('qd-edit-title').textContent = id ? '编辑这一笔' : '记一笔';
    /* v80（用户直派「日记本只能编辑一次」）：每次打开编辑都换一支全新的输入框，
       手机上输入框被全局输入增强/输入法残影接管过一次后，第二次编辑会打不进字、
       表现为「只能编辑一次」。换新节点可彻底绕开，编辑次数不再受限。 */
    var ta0 = $('qd-edit-ta');
    if (ta0) {
      var nt0 = ta0.cloneNode(false);
      nt0.value = rec ? rec.t : '';
      nt0.placeholder = '写下这一刻…';
      ta0.parentNode.replaceChild(nt0, ta0);
    }
    editImgs = rec && rec.imgs ? rec.imgs.slice() : [];
    $('qd-edit-del').hidden = !id;
    var tip = $('qd-edit-tip');
    if (tip) {
      tip.textContent = S.annot.on
        ? ('保存后 TA 会在今天随机挑 ' + (S.annot.count || 3) + ' 个时刻写批注')
        : '批注已关闭 · 可在四象限设置里重新打开';
    }
    $('qd-edit').classList.add('on');
    applyLook();
    renderEditImgs();
    setTimeout(function () { try { $('qd-edit-ta').focus(); } catch (e) {} }, 120);
  }
  function closeEdit() { $('qd-edit').classList.remove('on'); editId = null; editImgs = []; }
  function renderEditImgs() {
    var box = $('qd-edit-imgs'); if (!box) return;
    box.innerHTML = '';
    editImgs.forEach(function (id, i) {
      var w = mk('div', 'qd-edit-img');
      var im = mk('img'); im.alt = '';
      im.src = imgUse(id) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
      w.appendChild(im);
      var x = mk('button', '', '×'); x.type = 'button';
      on(x, 'click', function () { editImgs.splice(i, 1); renderEditImgs(); });
      w.appendChild(x);
      box.appendChild(w);
    });
  }
  function saveEditDraft() { /* 图片异步返回后只需重绘，正式落库在保存时 */ }

  function saveEdit() {
    var t = String($('qd-edit-ta').value || '').trim();
    if (!t && !editImgs.length) { toast('写点什么，或加一张图'); return; }
    var rec = null;
    if (editId) { for (var i = 0; i < S.recs.length; i++) if (S.recs[i].id === editId) rec = S.recs[i]; }
    if (rec) {
      rec.t = t; rec.imgs = editImgs.slice(); rec.at = rec.at; rec.editedAt = Date.now();
    } else {
      S.recs.push({ id: uid(), d: dkey(new Date()), z: editZone, t: t, imgs: editImgs.slice(), at: Date.now() });
    }
    var d = dkey(new Date());
    if (!S.annot.pool.length) refreshPool(true);
    ensurePlan(d);
    save();
    closeEdit();
    renderQuad();
    if ($('qd-diary') && $('qd-diary').classList.contains('on')) renderDiary();
    var made = S.plan[d];
    if (made && S.annot.on) toast('已记下 · TA 会在今天随机时刻写批注');
    else toast('已记下');
  }

  function delEditing() {
    if (!editId) return;
    var id = editId;
    if (!window.openModal) { doDel(); return; }
    window.openModal('删除这条记录', '', function (v) { if (v === 'del') doDel(); },
      { noInput: true, pills: [{ label: '删除', value: 'del' }, { label: '取消', value: '' }] });
    function doDel() {
      S.recs = S.recs.filter(function (r) { return r.id !== id; });
      save(); closeEdit(); renderQuad();
      if ($('qd-diary') && $('qd-diary').classList.contains('on')) renderDiary();
      toast('已删除');
    }
  }

  /* ---------------- 当天全部 ---------------- */
  function openDaySheet(zone) {
    ensureDom();
    var today = dkey(new Date());
    $('qd-day').setAttribute('data-z', zone && zone !== 'all' ? zone : 'exp');
    $('qd-day-title').textContent = '今天的全部记录';
    var list = $('qd-day-list'); list.innerHTML = '';
    var any = false;
    ZONES.forEach(function (z) {
      var recs = S.recs.filter(function (r) { return r.d === today && r.z === z.k; }).sort(function (a, b) { return b.at - a.at; });
      var notes = notesOf(today, z.k).sort(function (a, b) { return b.revealAt - a.revealAt; });
      if (!recs.length && !notes.length) return;
      any = true;
      var gh = mk('div', 'qd-grp-h', z.n + ' · ' + z.sub);
      gh.style.cssText = 'margin-top:6px;padding-bottom:4px';
      list.appendChild(gh);
      /* v80（用户直派「标签直接贴到栏位并排」）：批注与记录按时间并排同列，不再单独成块 */
      var items = [];
      recs.forEach(function (r) { items.push({ at: r.at, kind: 'rec', r: r }); });
      notes.forEach(function (n) { items.push({ at: n.revealAt, kind: 'note', n: n }); });
      items.sort(function (a, b) { return b.at - a.at; });
      items.forEach(function (it) {
        if (it.kind === 'rec') {
          var r = it.r;
          var row = mk('div', 'qd-dayrow');
          row.appendChild(mk('div', 't', hm(r.at)));
          var x = mk('div', 'x');
          x.appendChild(D.createTextNode(r.t || '（图片）'));
          if (r.imgs && r.imgs.length) {
            var im = mk('div', 'im');
            r.imgs.forEach(function (id) {
              var i2 = mk('img'); i2.src = imgUse(id) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
              im.appendChild(i2);
            });
            x.appendChild(im);
          }
          row.appendChild(x);
          on(row, 'click', function () { $('qd-day').classList.remove('on'); openEdit(z.k, r.id); });
          list.appendChild(row);
        } else {
          var n = it.n;
          var nrow = mk('div', 'qd-dayrow qd-daynote');
          nrow.appendChild(mk('div', 't', hm(n.revealAt)));
          var nx = mk('div', 'x');
          nx.appendChild(mk('span', 'qd-note-tag', 'TA 批注'));
          nx.appendChild(noteNode(n.t));
          nrow.appendChild(nx);
          list.appendChild(nrow);
        }
      });
    });
    if (!any) list.appendChild(mk('div', 'qd-nores', '今天还没有记录。'));
    $('qd-day').classList.add('on');
  }

  /* ---------------- 日记本（v74：单页 · 照片在上 / 搜索居中 / 成长路线在下） ---------------- */
  var diaryDay = 0;
  /* v77：日记本名字 / 底部条 / 全部照片 */
  function renderDiaryBar() {
    var name = $('qdb-name'), cnt = $('qdb-n'), plus = $('qdb-plus');
    if (!name) return;
    var label = (S.diary && S.diary.label) || '';
    name.textContent = label || '日记本';
    /* v78：按需求去掉「N 条」小字，点击整条进入 */
    if (cnt) cnt.textContent = '';
    if (plus) plus.style.display = label ? 'none' : '';
    var bar = $('qd-diary-bar');
    if (bar) bar.setAttribute('aria-label', (label || '日记本') + '（长按改名）');
  }

  function editDiaryLabel() {
    var pop = $('qd-label-pop'), inp = $('qd-label-in');
    if (!pop || !inp) return;
    inp.value = (S.diary && S.diary.label) || '';
    pop.__t = Date.now();
    pop.classList.add('on');
    setTimeout(function () { try { inp.focus(); } catch (e) {} }, 60);
  }

  function saveDiaryLabel() {
    var inp = $('qd-label-in');
    var t = String(inp ? inp.value : '').trim().slice(0, 16);
    S.diary = S.diary || {};
    S.diary.label = t;
    save();
    renderDiaryBar();
    var pop = $('qd-label-pop'); if (pop) pop.classList.remove('on');
    toast(t ? '日记本已改名' : '已恢复默认名字');
  }

  function bindDiaryBar() {
    var bar = $('qd-diary-bar');
    if (!bar || bar.__bd) return;
    bar.__bd = 1;
    var lp = 0, fired = false, sx = 0, sy = 0;
    bar.addEventListener('pointerdown', function (e) {
      fired = false; sx = e.clientX; sy = e.clientY;
      clearTimeout(lp);
      lp = setTimeout(function () { fired = true; editDiaryLabel(); }, 520);
    });
    bar.addEventListener('pointermove', function (e) {
      if (Math.abs(e.clientX - sx) > 14 || Math.abs(e.clientY - sy) > 14) { clearTimeout(lp); lp = 0; }
    });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
      bar.addEventListener(ev, function () { clearTimeout(lp); lp = 0; });
    });
    bar.addEventListener('click', function (e) {
      touchStop(e);
      if (fired) { fired = false; return; }
      openDiary();
    });
  }

  function openAllPhotos(list, idx) {
    var box = $('qd-allp'); if (!box) return;
    var grid = $('qd-allp-grid'); if (!grid) return;
    grid.innerHTML = '';
    (list || []).forEach(function (p, i) {
      var it = mk('div', 'qd-allp-it');
      var im = mk('img'); im.alt = '';
      im.src = imgUse(p.id) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
      it.appendChild(im);
      it.appendChild(mk('small', '', fmtFull(p.at)));
      on(it, 'click', function (e) { touchStop(e); $('qd-allp').classList.remove('on'); openPhoto(list, i); });
      grid.appendChild(it);
    });
    var n = $('qd-allp-n');
    if (n) n.textContent = (list || []).length + ' 张';
    box.classList.add('on');
  }

  function openDiary() {
    ensureDom();
    $('qd-diary').classList.add('on');
    syncBubble();
    renderDiary();
    setTimeout(function () {
      var sc = $('qd-dbody');
      if (sc) sc.scrollTop = 0;
      pickDiaryDay(diaryDays().length - 1, false);
    }, 60);
  }
  function syncBubble() {
    var ta = $('qd-bub');
    if (!ta) return;
    ta.value = (S.diary && S.diary.text) || '';
    growBubble();
  }
  function growBubble() {
    var ta = $('qd-bub');
    if (!ta) return;
    ta.style.height = 'auto';
    ta.style.height = Math.min(120, Math.max(22, ta.scrollHeight)) + 'px';
  }

  function filtered() {
    var q = String(($('qd-search') || {}).value || '').trim().toLowerCase();
    var day = String(($('qd-search-date') || {}).value || '').trim();
    return S.recs.filter(function (r) {
      if (day && r.d.indexOf(day) !== 0) return false;
      if (!q) return true;
      var hay = (r.d + ' ' + (r.t || '')).toLowerCase();
      return hay.indexOf(q) >= 0;
    }).sort(function (a, b) { return a.at - b.at; });
  }

  function diaryDays() {
    var m = {};
    S.recs.forEach(function (r) { m[r.d] = 1; });
    return Object.keys(m).sort();
  }

  function renderDiary() {
    if (!$('qd-list')) return;
    var recs = filtered();

    /* v77：照片改成两张拍立得，只露最新两张；点开可看全部 */
    var album = $('qd-album'); album.innerHTML = '';
    var pics = [];
    recs.forEach(function (r) {
      (r.imgs || []).forEach(function (id) { pics.push({ id: id, at: r.at, d: r.d, z: r.z }); });
    });
    pics.sort(function (a, b) { return b.at - a.at; });
    var memN = $('qd-mem-n');
    if (memN) {
      var two = function (n) { n = Math.min(99, n); return (n < 10 ? '0' : '') + n; };
      memN.textContent = two(Math.min(2, pics.length)) + ' / ' + two(pics.length);
    }
    var CAPS = ['one little moment', 'another little moment'];
    for (var pi = 0; pi < 2; pi++) {
      (function (idx) {
        var p = pics[idx];
        var pol = mk('div', 'qd-pol' + (idx ? ' alt' : ''));
        pol.style.setProperty('--rot', (idx ? 2.4 : -2.8) + 'deg');
        if (p) {
          var im = mk('img'); im.alt = '';
          im.src = imgUse(p.id) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
          pol.appendChild(im);
          var cap = mk('div', 'qd-pol-cap');
          cap.textContent = fmtFull(p.at);
          pol.appendChild(cap);
          on(pol, 'click', function (e) { touchStop(e); openAllPhotos(pics, idx); });
        } else {
          var emp = mk('div', 'qd-pol-empty');
          emp.appendChild(mk('span', 'qd-pol-plus', '+'));
          emp.appendChild(mk('em', '', CAPS[idx]));
          pol.appendChild(emp);
          if (pics.length) on(pol, 'click', function (e) { touchStop(e); openAllPhotos(pics, 0); });
        }
        album.appendChild(pol);
      })(pi);
    }
    renderDiaryBar();

    /* 成长路线：按天分组，每天四格（经历/连接/行动/感受）；点一格＝只看当天这一格 */
    var list = $('qd-list'); list.innerHTML = '';
    var groups = {}, order = [];
    recs.forEach(function (r) {
      if (!groups[r.d]) { groups[r.d] = []; order.push(r.d); }
      groups[r.d].push(r);
    });
    if (!order.length) list.appendChild(mk('div', 'qd-nores', '还没有记录。'));
    order.forEach(function (d) {
      var g = mk('div', 'qd-grp');
      g.setAttribute('data-day', d);
      var gh = mk('div', 'qd-grp-h');
      gh.appendChild(mk('span', '', d));
      gh.appendChild(mk('small', '', groups[d].length + ' 条'));
      g.appendChild(gh);
      var box = mk('div', 'qd-dcells');
      ZONES.forEach(function (z) {
        var rs = groups[d].filter(function (r) { return r.z === z.k; })
          .sort(function (a, b) { return b.at - a.at; });
        var c = mk('div', 'qd-dcell' + (rs.length ? '' : ' off'));
        c.setAttribute('data-z', z.k);
        var top = mk('div', 'qd-dc-top');
        var zico = mk('span', 'qd-dc-ico');
        zico.innerHTML = ZICONS[z.k] || '';
        top.appendChild(zico);
        top.appendChild(mk('span', 'qd-dc-name', z.n));
        top.appendChild(mk('small', 'qd-dc-n', rs.length ? (rs.length + ' 条') : '空'));
        c.appendChild(top);
        c.appendChild(mk('div', 'qd-dc-txt', rs.length ? (rs[0].t || '（图片）') : '还没有记录'));
        var dns = S.notes.filter(function (n) { return n.d === d && n.z === z.k && n.revealAt <= Date.now(); })
          .sort(function (a, b) { return b.revealAt - a.revealAt; });
        if (rs.length) {
          var imgs = [];
          rs.forEach(function (r) { (r.imgs || []).forEach(function (id) { imgs.push(id); }); });
          if (imgs.length) {
            var th = mk('div', 'qd-dc-th');
            imgs.slice(0, 3).forEach(function (id) {
              var im = mk('img'); im.src = imgUse(id) || ''; im.alt = '';
              th.appendChild(im);
            });
            if (imgs.length > 3) th.appendChild(mk('span', 'qd-dc-more', '+' + (imgs.length - 3)));
            c.appendChild(th);
          }
        }
        if (dns.length) {
          /* v78：日记本里也用四象限的便签形象展示批注 */
          var ds = mk('div', 'qd-dc-sticky');
          ds.style.setProperty('--rot', (rs.length ? 2.2 : -2.2) + 'deg');
          ds.appendChild(mk('small', '', 'TA'));
          ds.appendChild(mk('span', '', dns[0].t));
          if (dns.length > 1) ds.appendChild(mk('i', '', '+' + (dns.length - 1)));
          c.appendChild(ds);
        }
        if (rs.length || dns.length) on(c, 'click', function () { openDayCell(d, z.k); });
        box.appendChild(c);
      });
      g.appendChild(box);
      list.appendChild(g);
    });
    var rn = $('qd-route-n'); if (rn) rn.textContent = order.length ? (order.length + ' 天') : '';
  }

  function pickDiaryDay(i, scroll) {
    var ds = diaryDays();
    if (!ds.length) return;
    diaryDay = Math.max(0, Math.min(i, ds.length - 1));
    var g = $('qd-list') ? $('qd-list').querySelector('[data-day="' + ds[diaryDay] + '"]') : null;
    if (g && scroll !== false) {
      try { g.scrollIntoView({ block: 'start', behavior: 'smooth' }); } catch (e) { try { g.scrollIntoView(); } catch (e2) {} }
      g.classList.remove('flash'); void g.offsetWidth; g.classList.add('flash');
    }
    var up = $('qd-dprev'), dn = $('qd-dnext');
    if (up) up.disabled = false;
    if (dn) dn.disabled = false;
  }

  /* v75：最早 / 最新（翻看记录时一键到头尾） */
  function scrollDiary(where) {
    var sc = $('qd-dbody'); if (!sc) return;
    var top = where === 'oldest' ? 0 : sc.scrollHeight;
    try { sc.scrollTo({ top: top, behavior: 'smooth' }); } catch (e) { sc.scrollTop = top; }
    var gs = sc.querySelectorAll('.qd-grp');
    if (gs.length) {
      var g = where === 'oldest' ? gs[0] : gs[gs.length - 1];
      g.classList.remove('flash'); void g.offsetWidth; g.classList.add('flash');
    }
  }

  /* v75：日记本点一格 → 只看当天这一格（只读，不再编辑） */
  var cellDay = '', cellZone = '';
  /* v80（用户直派「长按单格 → 大格子弹窗，显示写过的全部内容」）：一个象限的全部历史 */
  function openZoneAll(zk) {
    var z = zoneOf(zk);
    var box = $('qd-zoneall');
    if (!box) {
      box = D.createElement('div');
      box.id = 'qd-zoneall'; box.className = 'qd-view qd-zoneall';
      box.innerHTML =
        '<div class="qd-view-in">' +
          '<button class="qd-view-x" id="qd-zoneall-x">✕</button>' +
          '<div class="qd-view-card" id="qd-zoneall-card"></div>' +
        '</div>';
      D.body.appendChild(box);
      on($('qd-zoneall-x'), 'click', function () { box.classList.remove('on'); });
      on(box, 'click', function (e) { if (e.target === box) box.classList.remove('on'); });
    }
    var card = $('qd-zoneall-card');
    card.innerHTML = '';
    var recs = S.recs.filter(function (r) { return r.z === zk; }).sort(function (a, b) { return b.at - a.at; });
    var notes = S.notes.filter(function (n) { return n.z === zk && n.revealAt <= Date.now(); }).sort(function (a, b) { return b.revealAt - a.revealAt; });
    card.appendChild(mk('div', 'qd-view-d', z.n + ' · ' + z.sub));
    card.appendChild(mk('div', 'qd-view-sub', '这一格写过的全部内容 · 共 ' + recs.length + ' 条记录' + (notes.length ? ('，TA 批注 ' + notes.length + ' 条') : '')));
    var byDay = {}, dOrder = [];
    recs.forEach(function (r) { if (!byDay[r.d]) { byDay[r.d] = []; dOrder.push(r.d); } byDay[r.d].push(r); });
    dOrder.sort().reverse();
    if (!dOrder.length) card.appendChild(mk('div', 'qd-nores', '这一格还没有写过内容。长按格子写一笔，写过的都会留在这里。'));
    dOrder.forEach(function (d) {
      var sec = mk('div', 'qd-vsec');
      var hd = mk('div', 'qd-vsec-h', d);
      var cnt = byDay[d].length;
      hd.appendChild(mk('i', '', cnt + ' 条'));
      sec.appendChild(hd);
      byDay[d].forEach(function (r) {
        var row = mk('div', 'qd-vrow');
        row.appendChild(mk('small', '', hm(r.at)));
        row.appendChild(noteNode(r.t || '（图片）'));
        if (r.imgs && r.imgs.length) {
          var ib = mk('div', 'vimg');
          var lst = r.imgs.map(function (x) { return { id: x, at: r.at }; });
          r.imgs.forEach(function (id, ii) {
            var im = mk('img'); im.src = imgUse(id) || ''; im.alt = '';
            on(im, 'click', function (e) { touchStop(e); openPhoto(lst, ii); });
            ib.appendChild(im);
          });
          row.appendChild(ib);
        }
        sec.appendChild(row);
      });
      /* 这一天的 TA 批注也一起展示 */
      S.notes.filter(function (n) { return n.d === d && n.z === zk && n.revealAt <= Date.now(); })
        .sort(function (a, b) { return a.revealAt - b.revealAt; })
        .forEach(function (n) {
          var nrow = mk('div', 'qd-vrow qd-vnote');
          nrow.appendChild(mk('small', '', 'TA 的批注 · ' + hm(n.revealAt)));
          nrow.appendChild(noteNode(n.t));
          sec.appendChild(nrow);
        });
      card.appendChild(sec);
    });
    card.scrollTop = 0;
    box.classList.add('on');
  }
  function openDayCell(d, z) {
    cellDay = d; cellZone = z;
    renderDayCell();
    var v = $('qd-view'); if (!v) return;
    v.classList.add('readonly');
    v.classList.add('on');
  }
  function renderDayCell() {
    var card = $('qd-view-card'); if (!card) return;
    card.innerHTML = '';
    var z = zoneOf(cellZone);
    var recs = S.recs.filter(function (r) { return r.d === cellDay && r.z === cellZone; })
      .sort(function (a, b) { return a.at - b.at; });
    var notes = S.notes.filter(function (n) { return n.d === cellDay && n.z === cellZone && n.revealAt <= Date.now(); })
      .sort(function (a, b) { return a.revealAt - b.revealAt; });
    card.appendChild(mk('div', 'qd-view-d', cellDay + ' · ' + z.n));
    card.appendChild(mk('div', 'qd-view-sub', '共 ' + recs.length + ' 条 · 只看不改'));
    recs.forEach(function (r) {
      var row = mk('div', 'qd-vrow');
      row.appendChild(mk('small', '', fmtFull(r.at)));
      row.appendChild(noteNode(r.t || '（图片）'));
      if (r.imgs && r.imgs.length) {
        var ib = mk('div', 'vimg');
        var lst = r.imgs.map(function (x) { return { id: x, at: r.at }; });
        r.imgs.forEach(function (id, ii) {
          var im = mk('img'); im.src = imgUse(id) || ''; im.alt = '';
          on(im, 'click', function (e) { touchStop(e); openPhoto(lst, ii); });
          ib.appendChild(im);
        });
        row.appendChild(ib);
      }
      card.appendChild(row);
    });
    notes.forEach(function (n) {
      var row = mk('div', 'qd-vrow qd-vnote');
      row.appendChild(mk('small', '', 'TA · ' + hm(n.revealAt)));
      row.appendChild(noteNode(n.t));
      card.appendChild(row);
    });
    if (!recs.length && !notes.length) card.appendChild(mk('div', 'qd-nores', '这一格还没有记录。'));
  }

  /* ---------------- 单日查看 ---------------- */
  var viewDay = '';
  function openDayView(d) {
    viewDay = d;
    renderDayView();
    $('qd-view').classList.add('on');
  }
  function renderDayView() {
    var d = viewDay, card = $('qd-view-card');
    if (!card) return;
    card.innerHTML = '';
    var recs = S.recs.filter(function (r) { return r.d === d; }).sort(function (a, b) { return a.at - b.at; });
    card.appendChild(mk('div', 'qd-view-d', d));
    card.appendChild(mk('div', 'qd-view-sub', '共 ' + recs.length + ' 条 · 全部时间按年月日时分显示'));
    ZONES.forEach(function (z) {
      var rs = recs.filter(function (r) { return r.z === z.k; });
      var ns = S.notes.filter(function (n) { return n.d === d && n.z === z.k && n.revealAt <= Date.now(); });
      if (!rs.length && !ns.length) return;
      var sec = mk('div', 'qd-vsec');
      var hd = mk('div', 'qd-vsec-h', z.n);
      hd.appendChild(mk('i', '', z.sub));
      sec.appendChild(hd);
      rs.forEach(function (r) {
        var row = mk('div', 'qd-vrow');
        row.appendChild(mk('small', '', fmtFull(r.at)));
        row.appendChild(D.createTextNode(r.t || '（图片）'));
        if (r.imgs && r.imgs.length) {
          var ib = mk('div', 'vimg');
          r.imgs.forEach(function (id) {
            var im = mk('img'); im.src = imgUse(id) || '';
            im.alt = '';
            on(im, 'click', function () { openPhoto([{ id: id, at: r.at, d: r.d, z: r.z }], 0); });
            ib.appendChild(im);
          });
          row.appendChild(ib);
        }
        sec.appendChild(row);
      });
      ns.forEach(function (n) {
        var row = mk('div', 'qd-vrow');
        row.style.color = '#8a5f72';
        row.appendChild(mk('small', '', 'TA 的批注 · ' + fmtFull(n.revealAt)));
        row.appendChild(D.createTextNode(n.t));
        sec.appendChild(row);
      });
      card.appendChild(sec);
    });
    $('qd-view-card').scrollTop = 0;
  }

  /* ---------------- 图片查看 ---------------- */
  var photoList = [], photoIdx = 0;
  function openPhoto(list, idx) {
    if (!list || !list.length) return;
    photoList = list; photoIdx = Math.max(0, Math.min(idx, list.length - 1));
    renderPhoto();
    $('qd-photo').classList.add('on');
  }
  function renderPhoto() {
    var p = photoList[photoIdx]; if (!p) return;
    var im = $('qd-photo-img');
    im.src = imgUse(p.id) || '';
    $('qd-photo-time').textContent = fmtFull(p.at);
    $('qd-photo-l').disabled = photoIdx <= 0;
    $('qd-photo-r').disabled = photoIdx >= photoList.length - 1;
  }
  function stepPhoto(dir) {
    var j = photoIdx + dir;
    if (j < 0 || j >= photoList.length) return;
    photoIdx = j; renderPhoto();
  }

  /* ---------------- 设置 ---------------- */
  var signPanel = false;
  function openSet() {
    ensureDom();
    renderSet();
    $('qd-set').classList.add('on');
  }
  function renderSet() {
    if (!$('qd-set')) return;
    var mode = modeNow();
    var wl = S.wall[mode].length, bl = S.bub[mode].length;
    $('qd-wall-v').textContent = wl ? (wl + ' 张') : '未设置';
    $('qd-bub-v').textContent = bl ? (bl + ' 张') : '未设置';
    var cv = $('qd-color-v');
    if (cv) {
      if (isDark()) cv.textContent = '黑块白字';
      else if (S.cardColor) cv.innerHTML = '<i class="qd-dot" style="background:' + S.cardColor + '"></i>' + S.cardColor;
      else cv.textContent = '默认';
    }
    $('qd-annot-on-v').textContent = S.annot.on ? '开' : '关';
    $('qd-annot-count-v').textContent = S.annot.count;
    var pv = $('qd-pool-v'); if (pv) pv.textContent = S.annot.pool.length || '0';
    var on2 = CATS.filter(function (c) { return weightOf(c[0]) > 0; }).length;
    $('qd-cat-v').textContent = on2 + ' 类';
  }

  function pickCardColor() {
    if (!window.openModal) return;
    var SW = [
      { color: '#ffffff', label: '纯白' }, { color: '#f6eef2', label: '雾粉' },
      { color: '#efe6f4', label: '淡紫' }, { color: '#ffe9ef', label: '樱花' },
      { color: '#e8f1ff', label: '雾蓝' }, { color: '#e6f6ec', label: '薄荷' },
      { color: '#fff3d9', label: '奶油' }, { color: '#242024', label: '墨黑' }
    ];
    window.openModal('排版块颜色', '', function (v) {
      var c = (typeof v === 'number' && SW[v]) ? SW[v].color : v;
      if (!c) return;
      S.cardColor = c; save(); applyLook(); renderSet();
      toast('排版块颜色已更换');
    }, { colorPicker: true, noInput: true, color: S.cardColor || '#ffffff', swatches: SW });
  }

  function pickAnnotCount() {
    if (!window.openModal) return;
    var pills = [];
    [3, 5, 8, 12, 16, 20].forEach(function (i) { pills.push({ label: i + ' 句', value: String(i) }); });
    window.openModal('每天批注条数', '记录后会在 00:00 前随机时刻陆续出现。每天最多 20 句，每个格子最多 5 句。', function (v) {
      var n = parseInt(v, 10);
      if (!n) return;
      S.annot.count = Math.max(1, Math.min(20, n));
      save(); renderSet(); toast('每天 ' + S.annot.count + ' 句批注');
    }, { placeholder: '1～20', inputmode: 'numeric', maxlength: 2, pills: pills });
  }

  /* ---- v74：分类概率（截图 2 的 −/+ 样式） ---- */
  function openCatProb() {
    ensureDom();
    var m = $('qd-cat'), box = $('qd-cat-box');
    if (!m || !box) return;
    var pools = catPools();
    box.innerHTML = '';
    var hd = mk('div', 'qd-cat-hd');
    hd.appendChild(mk('span', '', '内容分类与概率'));
    var x = mk('button', 'qd-x', '✕'); x.type = 'button';
    on(x, 'click', function () { m.classList.remove('on'); });
    hd.appendChild(x);
    box.appendChild(hd);
    box.appendChild(mk('div', 'qd-cat-tip', '只对四象限的批注生效，和聊天里的概率互不影响。数值越高，这一类被抽到的机会越大（0＝不抽）。'));
    var list = mk('div', 'qd-cat-list');
    box.appendChild(list);
    CATS.forEach(function (c) {
      var n = (pools[c[0]] || []).length;
      var row = mk('div', 'qd-cat-row' + (n ? '' : ' off'));
      var cn = mk('div', 'cn');
      cn.appendChild(mk('span', '', c[1]));
      cn.appendChild(mk('small', '', n ? (n + ' 条可用') : '这个分类还没有可用文字卡'));
      row.appendChild(cn);
      var stp = mk('div', 'qd-stp');
      var mi = mk('button', '', '−'); mi.type = 'button';
      var inp = D.createElement('input');
      inp.type = 'text'; inp.readOnly = true; inp.value = String(weightOf(c[0]));
      var pl = mk('button', '', '＋'); pl.type = 'button';
      function setW(v) {
        v = Math.max(0, Math.min(100, v));
        S.annot.cat[c[0]] = v;
        inp.value = String(v);
        save(); renderSet();
      }
      on(mi, 'click', function () { setW(weightOf(c[0]) - 1); });
      on(pl, 'click', function () { setW(weightOf(c[0]) + 1); });
      if (!n) { mi.disabled = true; pl.disabled = true; }
      stp.appendChild(mi); stp.appendChild(inp); stp.appendChild(pl);
      row.appendChild(stp);
      list.appendChild(row);
    });
    var done = mk('button', 'qd-btn solid', '完成');
    done.type = 'button'; done.style.marginTop = '10px'; done.style.flex = 'none';
    on(done, 'click', function () { m.classList.remove('on'); });
    box.appendChild(done);
    m.classList.add('on');
  }

  /* ---- 分组 ---- */
  function openGroups() {
    ensureDom();
    var box = $('qd-gal-box');
    var m = $('qd-gal');
    if (!S.annot.pool.length) refreshPool(true);
    box.innerHTML = '';
    var hd = mk('div', 'qd-sheet-hd');
    hd.appendChild(mk('span', '', '批注内容分组'));
    var x = mk('button', 'qd-x', '✕'); x.type = 'button';
    on(x, 'click', function () { m.classList.remove('on'); });
    hd.appendChild(x);
    box.appendChild(hd);
    box.appendChild(mk('div', 'qd-tip', '从当前联系人的「专属字卡」取句（' + S.annot.pool.length + ' 条）。分组权重越高，被抽到的概率越大；不建分组＝全部等概率。'));

    var wrap = mk('div', '');
    wrap.style.cssText = 'overflow-y:auto;min-height:0;margin:8px 0';
    (S.annot.groups || []).forEach(function (g, gi) {
      var row = mk('div', '');
      row.style.cssText = 'padding:9px 10px;border-radius:11px;background:var(--bg-a,#f7f4f6);margin-bottom:7px';
      var top = mk('div', '');
      top.style.cssText = 'display:flex;align-items:center;gap:8px';
      top.appendChild(mk('span', '', g.name));
      top.firstChild.style.cssText = 'flex:1;font-size:13px;font-weight:600';
      var wv = mk('span', '', g.w + '%');
      wv.style.cssText = 'font-size:11px;color:var(--muted,#999);width:38px;text-align:right';
      top.appendChild(wv);
      var del = mk('button', 'qd-x', '×'); del.type = 'button';
      on(del, 'click', function () {
        S.annot.groups.splice(gi, 1); save(); openGroups(); renderSet();
      });
      top.appendChild(del);
      row.appendChild(top);
      var rg = D.createElement('input'); rg.type = 'range'; rg.min = '0'; rg.max = '100'; rg.value = String(g.w);
      rg.className = 'qd-range';
      on(rg, 'input', function () { g.w = parseInt(rg.value, 10) || 0; wv.textContent = g.w + '%'; });
      on(rg, 'change', function () { save(); renderSet(); });
      row.appendChild(rg);
      var sub = mk('div', '');
      sub.style.cssText = 'display:flex;align-items:center;gap:10px;margin-top:5px';
      var cnt = mk('span', '', (g.cards && g.cards.length) ? ('已选 ' + g.cards.length + ' 条') : '未指定（用全部字卡）');
      cnt.style.cssText = 'flex:1;font-size:10.5px;color:var(--muted,#999)';
      sub.appendChild(cnt);
      var pick = mk('button', '', '选卡');
      pick.type = 'button';
      pick.style.cssText = 'padding:4px 11px;border:1px solid var(--line,#e3dade);border-radius:7px;background:transparent;font-size:11px;color:var(--ink,#111)';
      on(pick, 'click', function () { openPickCards(gi); });
      sub.appendChild(pick);
      row.appendChild(sub);
      wrap.appendChild(row);
    });
    if (!S.annot.groups.length) wrap.appendChild(mk('div', 'qd-nores', '还没有分组。'));
    box.appendChild(wrap);

    var add = mk('button', 'qd-btn', '＋ 新建分组');
    add.type = 'button';
    add.style.cssText = 'width:100%;margin-bottom:8px;border:none;background:var(--ink,#111);color:var(--bg-b,#fff)';
    on(add, 'click', function () {
      if (!window.openModal) return;
      window.openModal('新建分组', '给这一组起个名字（例如：日常 / 撒娇 / 深夜）', function (v) {
        var name = String(v || '').trim();
        if (!name) return;
        S.annot.groups.push({ name: name.slice(0, 20), w: 50, cards: [] });
        save(); openGroups(); renderSet();
      }, { placeholder: '分组名' });
    });
    box.appendChild(add);
    var close = mk('button', 'qd-btn', '完成');
    close.type = 'button';
    close.style.cssText = 'width:100%';
    on(close, 'click', function () { m.classList.remove('on'); });
    box.appendChild(close);
    m.classList.add('on');
  }

  function openPickCards(gi) {
    var g = S.annot.groups[gi]; if (!g) return;
    var box = $('qd-pick-box');
    box.innerHTML = '';
    var hd = mk('div', 'qd-sheet-hd');
    hd.appendChild(mk('span', '', '选卡 · ' + g.name));
    var x = mk('button', 'qd-x', '✕'); x.type = 'button';
    on(x, 'click', function () { $('qd-pick').classList.remove('on'); });
    hd.appendChild(x);
    box.appendChild(hd);
    var sb = D.createElement('input');
    sb.type = 'text'; sb.placeholder = '搜索字卡…'; sb.className = 'qd-ta'; sb.setAttribute('data-ce-skip', '1');
    sb.style.cssText = 'min-height:0;height:34px;padding:0 10px;margin-top:8px;flex:none';
    box.appendChild(sb);
    var list = mk('div', 'qd-pick-list');
    box.appendChild(list);
    var sel = {};
    (g.cards || []).forEach(function (c) { sel[c] = 1; });

    function draw() {
      var q = String(sb.value || '').trim().toLowerCase();
      list.innerHTML = '';
      var pool = S.annot.pool;
      if (!pool.length) { list.appendChild(mk('div', 'qd-nores', '当前联系人还没有专属字卡。')); return; }
      pool.forEach(function (c) {
        if (q && c.toLowerCase().indexOf(q) < 0) return;
        var row = mk('label', 'qd-pick-row');
        var cb = D.createElement('input'); cb.type = 'checkbox'; cb.checked = !!sel[c];
        on(cb, 'change', function () { if (cb.checked) sel[c] = 1; else delete sel[c]; });
        row.appendChild(cb);
        row.appendChild(mk('span', '', c));
        list.appendChild(row);
      });
      if (!list.children.length) list.appendChild(mk('div', 'qd-nores', '没有匹配的字卡。'));
    }
    on(sb, 'input', draw);
    draw();

    var row = mk('div', 'qd-row');
    row.style.marginTop = '8px';
    var all = mk('button', 'qd-btn', '全选'); all.type = 'button';
    on(all, 'click', function () {
      if (!S.annot.pool.length) return;
      sel = {}; S.annot.pool.forEach(function (c) { sel[c] = 1; }); draw();
    });
    var none = mk('button', 'qd-btn', '清空'); none.type = 'button';
    on(none, 'click', function () { sel = {}; draw(); });
    row.appendChild(all); row.appendChild(none);
    box.appendChild(row);

    var ok = mk('button', 'qd-btn solid', '保存');
    ok.type = 'button';
    ok.style.marginTop = '8px';
    on(ok, 'click', function () {
      g.cards = Object.keys(sel);
      save(); $('qd-pick').classList.remove('on'); openGroups(); renderSet();
      toast('已保存 ' + g.cards.length + ' 条');
    });
    box.appendChild(ok);
    $('qd-pick').classList.add('on');
  }

  /* ---------------- 图库 ---------------- */
  function openGallery(kind) {
    ensureDom();
    var st = S[kind], m = $('qd-gal'), box = $('qd-gal-box');
    var mode = modeNow();
    box.innerHTML = '';
    var hd = mk('div', 'qd-sheet-hd');
    hd.appendChild(mk('span', '', kind === 'wall' ? '四象限壁纸' : '气泡背景图'));
    var x = mk('button', 'qd-x', '✕'); x.type = 'button';
    on(x, 'click', function () { m.classList.remove('on'); });
    hd.appendChild(x);
    box.appendChild(hd);
    box.appendChild(mk('div', 'qd-tip', '浅色 / 深色各一栏，跟随深色模式切换。单击＝使用这张；双击＝挪到本栏第一张；删除后 5 秒内可撤销。'));

    var tabs = mk('div', 'qd-gal-tabs');
    [['light', '浅色'], ['dark', '深色']].forEach(function (p) {
      var b = mk('button', '', p[1] + '（' + st[p[0]].length + '）');
      b.type = 'button';
      if (mode === p[0]) b.className = 'on';
      on(b, 'click', function () { openGalleryMode(kind, p[0]); });
      tabs.appendChild(b);
    });
    box.appendChild(tabs);

    m.setAttribute('data-kind', kind);
    m.setAttribute('data-mode', mode);
    renderGalleryBody(kind, mode, box);

    var up = mk('button', 'qd-btn solid', '＋ 上传新图（可多选）');
    up.type = 'button'; up.style.width = '100%'; up.style.marginBottom = '7px';
    on(up, 'click', function () {
      pickImage(function (ids) {
        ids.forEach(function (id) {
          if (st[mode].length >= 30) { toast('这一栏最多 30 张'); return; }
          st[mode].push(id);
        });
        if (!st.sel[mode] && st[mode].length) st.sel[mode] = st[mode][0];
        save(); applyLook(); openGalleryMode(kind, mode);
      });
    });
    box.appendChild(up);

    if (st[mode].length) {
      var cl = mk('button', 'qd-btn danger', '清空「' + (mode === 'dark' ? '深色' : '浅色') + '」这一栏');
      cl.type = 'button'; cl.style.width = '100%';
      on(cl, 'click', function () {
        st[mode].forEach(function (id) { dbDel('img:' + id); delete IMG[id]; });
        st[mode] = []; st.sel[mode] = '';
        save(); applyLook(); openGalleryMode(kind, mode); toast('已清空');
      });
      box.appendChild(cl);
    }
    m.classList.add('on');
  }

  function openGalleryMode(kind, mode) {
    var m = $('qd-gal'), box = $('qd-gal-box'), st = S[kind];
    box.innerHTML = '';
    var hd = mk('div', 'qd-sheet-hd');
    hd.appendChild(mk('span', '', kind === 'wall' ? '四象限壁纸' : '气泡背景图'));
    var x = mk('button', 'qd-x', '✕'); x.type = 'button';
    on(x, 'click', function () { m.classList.remove('on'); });
    hd.appendChild(x);
    box.appendChild(hd);
    box.appendChild(mk('div', 'qd-tip', '单击＝使用这张；双击＝挪到本栏第一张；删除后 5 秒内可撤销。'));
    var tabs = mk('div', 'qd-gal-tabs');
    [['light', '浅色'], ['dark', '深色']].forEach(function (p) {
      var b = mk('button', '', p[1] + '（' + st[p[0]].length + '）');
      b.type = 'button';
      if (mode === p[0]) b.className = 'on';
      on(b, 'click', function () { openGalleryMode(kind, p[0]); });
      tabs.appendChild(b);
    });
    box.appendChild(tabs);
    renderGalleryBody(kind, mode, box);

    var up = mk('button', 'qd-btn solid', '＋ 上传新图（可多选）');
    up.type = 'button'; up.style.width = '100%'; up.style.marginBottom = '7px';
    on(up, 'click', function () {
      pickImage(function (ids) {
        ids.forEach(function (id) {
          if (st[mode].length >= 30) { toast('这一栏最多 30 张'); return; }
          st[mode].push(id);
        });
        if (!st.sel[mode] && st[mode].length) st.sel[mode] = st[mode][0];
        save(); applyLook(); openGalleryMode(kind, mode);
      });
    });
    box.appendChild(up);
    if (st[mode].length) {
      var cl = mk('button', 'qd-btn danger', '清空「' + (mode === 'dark' ? '深色' : '浅色') + '」这一栏');
      cl.type = 'button'; cl.style.width = '100%';
      on(cl, 'click', function () {
        st[mode].forEach(function (id) { dbDel('img:' + id); delete IMG[id]; });
        st[mode] = []; st.sel[mode] = '';
        save(); applyLook(); openGalleryMode(kind, mode); toast('已清空');
      });
      box.appendChild(cl);
    }
    m.classList.add('on');
  }

  function renderGalleryBody(kind, mode, box) {
    var st = S[kind];
    var list = st[mode], active = st.sel[mode] || list[0] || '';
    if (!$('qd-gal').__undo || $('qd-gal').__undo.kind !== kind || $('qd-gal').__undo.mode !== mode) {
      /* 别的栏的撤销不显示 */
    } else {
      var u = $('qd-gal').__undo;
      var strip = mk('div', 'qd-gal-undo');
      strip.appendChild(mk('span', '', '刚删了 1 张，可撤销'));
      var ub = mk('button', '', '撤销'); ub.type = 'button';
      on(ub, 'click', function () {
        if (u.first) list.unshift(u.id); else list.push(u.id);
        IMG[u.id] = u.u;
        dbSet('img:' + u.id, u.u);
        save(); applyLook(); openGalleryMode(kind, mode);
        toast('已撤销');
      });
      strip.appendChild(ub);
      box.appendChild(strip);
    }

    var grid = mk('div', 'qd-gal-grid');
    if (!list.length) {
      grid.appendChild(mk('div', 'qd-gal-empty', '这一栏还没有图片，点下方「上传新图」加入（只加进当前这栏）'));
    }
    list.forEach(function (id, idx) {
      var cell = mk('div', 'qd-gcell');
      if (id === active) cell.className += ' on';
      var im = mk('img'); im.alt = '';
      im.src = imgUse(id) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
      cell.appendChild(im);
      if (idx === 0) cell.appendChild(mk('div', 'first', '① 首选'));
      var del = mk('button', 'del', '×'); del.type = 'button';
      on(del, 'click', function (e) {
        e.stopPropagation();
        var u = { id: id, u: IMG[id] || '', kind: kind, mode: mode, first: idx === 0 };
        var i = list.indexOf(id);
        if (i >= 0) list.splice(i, 1);
        if (st.sel[mode] === id) st.sel[mode] = list[0] || '';
        $('qd-gal').__undo = u;
        clearTimeout($('qd-gal').__undoT);
        $('qd-gal').__undoT = setTimeout(function () {
          var uu = $('qd-gal').__undo;
          $('qd-gal').__undo = null;
          if (uu) {
            var still = S.wall.light.indexOf(uu.id) >= 0 || S.wall.dark.indexOf(uu.id) >= 0 ||
              S.bub.light.indexOf(uu.id) >= 0 || S.bub.dark.indexOf(uu.id) >= 0;
            if (!still) { dbDel('img:' + uu.id); delete IMG[uu.id]; }
          }
          if ($('qd-gal').classList.contains('on')) openGalleryMode(kind, mode);
        }, 5000);
        save(); applyLook(); openGalleryMode(kind, mode);
        toast('已删除，5 秒内可撤销');
      });
      cell.appendChild(del);

      var tapAt = 0, tapT = 0;
      on(cell, 'click', function () {
        var now = Date.now();
        if (now - tapAt < 320) {
          clearTimeout(tapT); tapAt = 0;
          var i2 = list.indexOf(id);
          if (i2 > 0) { list.splice(i2, 1); list.unshift(id); st.sel[mode] = id; save(); applyLook(); toast('已挪到本栏第一张'); }
          openGalleryMode(kind, mode);
          return;
        }
        tapAt = now;
        tapT = setTimeout(function () {
          tapAt = 0;
          st.sel[mode] = id; save(); applyLook();
          $('qd-gal').classList.remove('on');
          toast('已切换');
        }, 260);
      });
      grid.appendChild(cell);
    });
    box.appendChild(grid);
  }

  /* ---------------- 开屏署名 ---------------- */
  var SIGN_KEY = 'mochi-op-sign';
  var SIGN_FONTS = [
    { k: 'default', n: '系统默认', css: "'PingFang SC','Microsoft YaHei',-apple-system,sans-serif" },
    { k: 'hei', n: '黑体', css: "'Heiti SC','SimHei','Microsoft YaHei',sans-serif" },
    { k: 'song', n: '宋体', css: "'Songti SC','SimSun','Noto Serif CJK SC',serif" },
    { k: 'kai', n: '楷体', css: "'Kaiti SC','KaiTi','STKaiti',serif" },
    { k: 'yuan', n: '圆体', css: "'Yuanti SC','PingFang SC','Microsoft YaHei',sans-serif" },
    { k: 'mono', n: '等宽', css: "'SF Mono','Menlo','Consolas','Courier New',monospace" }
  ];
  var SIGN = { t: '齊陳家', c: '', s: 15, f: 'default', b: false };
  function readSign() {
    try {
      var raw = localStorage.getItem(SIGN_KEY);
      if (raw) {
        var o = JSON.parse(raw);
        if (o && typeof o === 'object') {
          if (typeof o.t === 'string') SIGN.t = o.t;
          if (typeof o.c === 'string') SIGN.c = o.c;
          if (typeof o.s === 'number' && o.s >= 10 && o.s <= 40) SIGN.s = o.s;
          if (typeof o.f === 'string') SIGN.f = o.f;
          if (typeof o.b === 'boolean') SIGN.b = o.b;
        }
      }
    } catch (e) {}
    applySign();
  }
  function saveSign() { try { localStorage.setItem(SIGN_KEY, JSON.stringify(SIGN)); } catch (e) {} }
  function signFontCss(k) { for (var i = 0; i < SIGN_FONTS.length; i++) if (SIGN_FONTS[i].k === k) return SIGN_FONTS[i].css; return SIGN_FONTS[0].css; }
  function applySign() {
    var el = $('op-tap-tip'); if (!el) return;
    el.textContent = SIGN.t || '齊陳家';
    el.style.fontSize = SIGN.s + 'px';
    el.style.fontFamily = signFontCss(SIGN.f);
    el.style.fontWeight = SIGN.b ? '700' : '';
    el.style.color = SIGN.c || '';
    el.style.letterSpacing = '2px';
    el.style.opacity = '.92';
    var v = $('op-sign-val'); if (v) v.textContent = (SIGN.t || '齊陳家');
  }
  function openSignPanel() {
    ensureDom();
    var box = $('qd-sign-box'), m = $('qd-sign');
    box.innerHTML = '';
    var hd = mk('div', 'qd-sheet-hd');
    hd.appendChild(mk('span', '', '开屏署名文字'));
    var x = mk('button', 'qd-x', '✕'); x.type = 'button';
    on(x, 'click', function () { m.classList.remove('on'); });
    hd.appendChild(x);
    box.appendChild(hd);
    box.appendChild(mk('div', 'qd-tip', '显示在开屏「连接成功」上方。默认比那行字大一号。'));

    var pv = mk('div', 'qd-sign-pv', SIGN.t || '齊陳家');
    pv.id = 'qd-sign-pv';
    box.appendChild(pv);

    var inp = D.createElement('input');
    inp.type = 'text'; inp.value = SIGN.t; inp.className = 'qd-ta'; inp.setAttribute('data-ce-skip', '1');
    inp.style.cssText = 'min-height:0;height:38px;padding:0 12px;margin-bottom:9px;flex:none';
    inp.maxLength = 20; inp.placeholder = '署名文字';
    on(inp, 'input', function () {
      SIGN.t = inp.value;
      pv.textContent = SIGN.t || '齊陳家';
      applySign(); saveSign();
    });
    box.appendChild(inp);

    var rowc = mk('div', 'qd-row');
    var cb = mk('button', 'qd-btn', '颜色');
    cb.type = 'button';
    on(cb, 'click', function () {
      if (!window.openModal) return;
      var SW = [
        { color: '#111111', label: '黑' }, { color: '#ffffff', label: '白' },
        { color: '#9a5c72', label: '玫棕' }, { color: '#c58aa4', label: '粉' },
        { color: '#1a56db', label: '蓝' }, { color: '#1e8e5a', label: '绿' },
        { color: '#7048e8', label: '紫' }, { color: '#d6336c', label: '玫红' }
      ];
      window.openModal('署名颜色', '', function (v) {
        var c = (typeof v === 'number' && SW[v]) ? SW[v].color : v;
        if (!c) return;
        SIGN.c = c; applySign(); saveSign();
        cb.textContent = '颜色 · ' + c;
        pv.style.color = c;
      }, { colorPicker: true, noInput: true, color: SIGN.c || '#111111', swatches: SW });
    });
    rowc.appendChild(cb);
    if (SIGN.c) cb.textContent = '颜色 · ' + SIGN.c;

    var tb = mk('button', 'qd-btn', SIGN.b ? '加粗：开' : '加粗：关');
    tb.type = 'button';
    on(tb, 'click', function () {
      SIGN.b = !SIGN.b; tb.textContent = SIGN.b ? '加粗：开' : '加粗：关';
      applySign(); saveSign();
      pv.style.fontWeight = SIGN.b ? '700' : '';
    });
    rowc.appendChild(tb);
    box.appendChild(rowc);

    var lab = mk('div', 'qd-tip', '字号 · ' + SIGN.s + 'px（「连接成功」为 12.5px）');
    lab.style.margin = '10px 0 2px';
    box.appendChild(lab);
    var rg = D.createElement('input');
    rg.type = 'range'; rg.min = '10'; rg.max = '34'; rg.step = '1'; rg.value = String(SIGN.s);
    rg.className = 'qd-range';
    on(rg, 'input', function () {
      SIGN.s = parseInt(rg.value, 10) || 15;
      lab.textContent = '字号 · ' + SIGN.s + 'px（「连接成功」为 12.5px）';
      pv.style.fontSize = SIGN.s + 'px';
      applySign(); saveSign();
    });
    box.appendChild(rg);

    box.appendChild(mk('div', 'qd-set-h', '字体'));
    var fl = mk('div', 'qd-sign-f');
    SIGN_FONTS.forEach(function (f) {
      var b = mk('button', '', f.n); b.type = 'button';
      b.style.fontFamily = f.css;
      if (SIGN.f === f.k) b.className += ' on';
      on(b, 'click', function () {
        SIGN.f = f.k;
        fl.querySelectorAll('button').forEach(function (o) { o.classList.remove('on'); });
        b.classList.add('on');
        pv.style.fontFamily = f.css;
        applySign(); saveSign();
      });
      fl.appendChild(b);
    });
    box.appendChild(fl);

    pv.style.fontSize = SIGN.s + 'px';
    pv.style.fontFamily = signFontCss(SIGN.f);
    pv.style.fontWeight = SIGN.b ? '700' : '';
    if (SIGN.c) pv.style.color = SIGN.c;

    var reset = mk('button', 'qd-btn', '恢复默认（齊陳家 · 15px）');
    reset.type = 'button'; reset.style.width = '100%'; reset.style.marginTop = '10px';
    on(reset, 'click', function () {
      SIGN = { t: '齊陳家', c: '', s: 15, f: 'default', b: false };
      applySign(); saveSign(); openSignPanel(); toast('已恢复默认');
    });
    box.appendChild(reset);

    var ok = mk('button', 'qd-btn solid', '完成');
    ok.type = 'button'; ok.style.width = '100%'; ok.style.marginTop = '8px';
    on(ok, 'click', function () { m.classList.remove('on'); applySign(); });
    box.appendChild(ok);

    m.classList.add('on');
  }
  function hookSignRow() {
    var row = $('row-op-sign');
    if (!row) return;
    if (row.__qd) return;
    row.__qd = 1;
    on(row, 'click', function (e) { touchStop(e); openSignPanel(); });
  }

  /* ---------------- 主页入口（v77：四象限改成第二页卡片，第一页不再注入图标） ---------------- */
  function installIcon() {
    var old = document.querySelector('.app-grid[data-app="main"] .app[data-app="quadrant"]');
    if (old && old.parentNode) { try { old.parentNode.removeChild(old); } catch (e0) {} }

    var qdc = $('home-qd-card');
    if (qdc && !qdc.__qd) {
      qdc.__qd = 1;
      on(qdc, 'click', function (e) { touchStop(e); openQuadPage(); });
    }
    var xn = $('home-xinxun-card');
    if (xn && !xn.__xn) {
      xn.__xn = 1;
      on(xn, 'click', function (e) {
        touchStop(e);
        try { if (window.__xnOpen) window.__xnOpen(); else toast('心讯还没准备好'); } catch (x) {}
      });
    }
    syncQdCard();
  }

  function syncQdCard() {
    var el = $('qd-card-text');
    if (!el) return;
    var t = dkey(new Date()), n = 0;
    try { n = (S.recs || []).filter(function (r) { return r.d === t; }).length; } catch (e) { n = 0; }
    el.textContent = n ? ('今天 ' + n + ' 条记录') : '今天还没有记录';
  }

  function openQuadPage() {
    ensureDom();
    bindDiaryBar();
    renderDiaryBar();
    $('qd-page').classList.add('on');
    if (!loaded) { loadState(); }
    else renderQuad();
  }

  function openQuadFromIcon(e) { if (e) touchStop(e); openQuadPage(); }

  /* ---------------- 对外接口 ---------------- */
  window.__qd = {
    open: openQuadPage,
    diary: function () { ensureDom(); openDiary(); },
    state: function () { return S; },
    reset: function () { S.recs = []; S.notes = []; S.plan = {}; save(); renderQuad(); },
    addRec: function (zone, text) {
      S.recs.push({ id: uid(), d: dkey(new Date()), z: zone || 'exp', t: String(text || ''), imgs: [], at: Date.now() });
      ensurePlan(dkey(new Date())); tickPlan(); save(); renderQuad(); return S.recs.length;
    },
    tick: function () { tickPlan(); },
    resetPools: function () { POOL_CACHE = { at: 0, data: {} }; },
    cats: function () { return catPools(); },
    dayCell: function (d, z) { openDayCell(d, z); },
    scrollDiary: scrollDiary,
    openGallery: openGallery,
    sign: function () { return SIGN; },
    openSign: openSignPanel,
    applyLook: applyLook
  };

  /* ---------------- 启动 ---------------- */
  function boot() {
    readSign();
    hookSignRow();
    installIcon();
    /* v76：整理模式回到 mochi 原版，清掉 v75 存下的自由摆放偏移 */
    try { localStorage.removeItem('mochi-desk-offsets-v75'); } catch (e0) {}
    D.querySelectorAll('.app').forEach(function (a) { a.style.transform = ''; a.classList.remove('desk-moved'); });
    loadState().then(function () { setTimeout(tickPlan, 800); syncQdCard(); renderDiaryBar(); });
    D.addEventListener('contact-switched', function () {
      refreshPool(true);
      POOL_CACHE = { at: 0, data: {} };
      setTimeout(installIcon, 400);
    });
    /* 开屏提示文字可能被重建，定时对齐 */
    setInterval(function () {
      var el = $('op-tap-tip');
      if (el && el.textContent !== (SIGN.t || '齊陳家')) applySign();
    }, 4000);
    /* 批注：每 20 秒看一次有没有到点的 */
    setInterval(tickPlan, 20000);
    setInterval(function () {
      if (loaded && isQuadOpen()) renderQuad();
    }, 60000);
  }

  if (D.readyState === 'loading') D.addEventListener('DOMContentLoaded', boot);
  else boot();
})();

</script>
<script id="v78-quad">
/* ===== v78 =====
   1) 桌面图标唯一：同一 data-app 只保留一个
   2) 「图标设置」里新增「分组…」：勾选 2～4 个图标组成一组（替代原来的拖动聚拢）
   3) 日记本底部新增「四象限」返回条：点击回四象限，长按改名，未编辑时显示白色小加号
*/
(function () {
  'use strict';
  function $(id) { return document.getElementById(id); }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function lsGet(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
  function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }

  /* ---------------- 1. 桌面图标去重 ---------------- */
  var dedupeBusy = false;
  function dedupeDeskIcons() {
    if (dedupeBusy) return 0;
    dedupeBusy = true;
    var removed = 0;
    try {
      var seen = {};
      /* 只用一个选择器：.df-hold 本身就在 .page-slide 内，避免同一节点被选中两次而误删 */
      var nodes = [].slice.call(document.querySelectorAll('.page-slide .app[data-app]'));
      nodes.forEach(function (a) {
        var k = a.getAttribute('data-app');
        if (!k) return;
        if (seen[k]) {
          try { a.parentNode.removeChild(a); removed++; } catch (e) {}
        } else seen[k] = 1;
      });
    } catch (e) {}
    dedupeBusy = false;
    return removed;
  }
  window.__deskDedupe = dedupeDeskIcons;

  /* ---------------- 2. 图标设置 → 分组 ---------------- */
  var GKEY = 'mochi-desk-groups-v67';
  function loadGroups() {
    try { var a = JSON.parse(localStorage.getItem(GKEY) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; }
  }
  function saveGroups(a) { try { localStorage.setItem(GKEY, JSON.stringify(a)); } catch (e) {} }
  function refreshGroups() {
    try { if (window.__deskGroupsRefresh) window.__deskGroupsRefresh(); } catch (e) {}
  }
  function iconOf(a) {
    var i = a && a.querySelector ? a.querySelector('.app-ico') : null;
    return i ? i.innerHTML : '';
  }
  function nameOf(a) {
    var n = a && a.querySelector ? a.querySelector('.app-name') : null;
    return (n && n.textContent.trim()) || (a && a.getAttribute('data-app')) || '图标';
  }

  function openGroupPanel(curApp) {
    var old = $('igrp-mask'); if (old) old.remove();
    var slide = (curApp && curApp.closest('.page-slide')) || document.querySelector('.page-slide');
    var apps = slide ? [].slice.call(slide.querySelectorAll('.app[data-app]')) : [];
    var curKey = curApp ? curApp.getAttribute('data-app') : '';
    var groups = loadGroups();
    var sel = {};

    var mask = document.createElement('div');
    mask.className = 'igrp-mask';
    mask.id = 'igrp-mask';

    var oldHtml = '';
    if (groups.length) {
      oldHtml = '<div class="igrp-sec">已有分组</div><div class="igrp-old">';
      groups.forEach(function (g) {
        var full = (g.members || []).length >= 4;
        var has = curKey && (g.members || []).indexOf(curKey) >= 0;
        oldHtml += '<div class="igrp-old-row" data-gid="' + g.id + '">' +
          '<span class="n">' + (g.name || '分组') + '</span>' +
          '<span class="c">' + (g.members || []).length + '/4</span>' +
          '<button type="button" data-add="' + g.id + '"' + (full || has ? ' disabled' : '') + '>' +
          (has ? '已在组内' : (full ? '已满' : '加入')) + '</button></div>';
      });
      oldHtml += '</div>';
    }

    var gridHtml = '';
    apps.forEach(function (a) {
      var k = a.getAttribute('data-app');
      if (!k) return;
      gridHtml += '<div class="igrp-it" data-k="' + k + '"><span class="ck">✓</span>' +
        '<span class="ic">' + iconOf(a) + '</span>' +
        '<span class="nm">' + nameOf(a) + '</span></div>';
    });

    mask.innerHTML =
      '<div class="igrp-card">' +
        '<div class="igrp-hd"><b>选择分组</b><button type="button" id="igrp-x">✕</button></div>' +
        '<div class="igrp-tip">勾选 2～4 个图标组成一组；也可以把当前图标直接加进已有分组。每组最多 4 个，组成后桌面会出现分组图标，点它可展开。</div>' +
        oldHtml +
        '<div class="igrp-sec">新建分组（本页图标）</div>' +
        '<div class="igrp-grid" id="igrp-grid">' + gridHtml + '</div>' +
        '<div class="igrp-act">' +
          '<button type="button" class="ghost" id="igrp-cancel">取消</button>' +
          '<button type="button" class="solid" id="igrp-go" disabled>组成本组</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(mask);

    var go = $('igrp-go');
    function countSel() { return Object.keys(sel).length; }
    function syncGo() {
      if (!go) return;
      var n = countSel();
      go.disabled = n < 2;
      go.textContent = n ? ('组成本组（' + n + '/4）') : '组成本组';
    }
    mask.querySelectorAll('.igrp-it').forEach(function (it) {
      it.addEventListener('click', function () {
        var k = it.getAttribute('data-k');
        if (sel[k]) { delete sel[k]; it.classList.remove('on'); }
        else {
          if (countSel() >= 4) { toast('每组最多 4 个图标'); return; }
          sel[k] = 1; it.classList.add('on');
        }
        syncGo();
      });
    });
    function close() { try { mask.remove(); } catch (e) {} }
    $('igrp-x').addEventListener('click', close);
    $('igrp-cancel').addEventListener('click', close);
    mask.addEventListener('click', function (e) { if (e.target === mask) close(); });

    mask.querySelectorAll('[data-add]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!curKey) { toast('没识别到当前图标'); return; }
        var gid = btn.getAttribute('data-add');
        var gs = loadGroups();
        var g = gs.filter(function (x) { return x.id === gid; })[0];
        if (!g) return;
        if ((g.members || []).indexOf(curKey) >= 0) { toast('已经在组里了'); return; }
        if ((g.members || []).length >= 4) { toast('每组最多 4 个图标'); return; }
        gs.forEach(function (o) { if (o !== g) o.members = o.members.filter(function (k) { return k !== curKey; }); });
        g.members.push(curKey);
        saveGroups(gs);
        refreshGroups();
        close();
        toast('已加入「' + (g.name || '分组') + '」');
      });
    });

    /* v84（用户直派「管理分组长按可以改名」）：长按「已有分组」那一行改名 */
    mask.querySelectorAll('.igrp-old-row').forEach(function (row) {
      var gid = row.getAttribute('data-gid');
      var tmr = null, sx = 0, sy = 0, fired = false;
      var start = function (e) {
        sx = e.clientX || 0; sy = e.clientY || 0;
        if (tmr) clearTimeout(tmr);
        tmr = setTimeout(function () {
          tmr = null; fired = true;
          var gs = loadGroups();
          var g = gs.filter(function (x) { return x.id === gid; })[0];
          if (!g || !window.openModal) return;
          try { if (navigator.vibrate) navigator.vibrate(12); } catch (eV) {}
          window.openModal('分组改名', g.name || '分组', function (v) {
            /* v86（用户直派「分组改名可以输入 emoji」）：emoji/组合字符是多个 UTF-16 单元，
               旧代码 slice(0,12) 会把它切成半个代理对（显示成方块、存进去变乱码）。
               现在按码点截断，12 个字符（含 emoji）完整保留。 */
            var _raw = String(v == null ? '' : v).trim();
            var nm = (function () {
              try { return Array.from(_raw).slice(0, 12).join(''); } catch (eG) { return _raw.slice(0, 12); }
            })();
            if (!nm) return;
            var gs2 = loadGroups();
            var g2 = gs2.filter(function (x) { return x.id === gid; })[0];
            if (!g2) return;
            g2.name = nm;
            saveGroups(gs2);
            refreshGroups();
            try { close(); } catch (eC) {}
            try { if (window.__iconGroupPanel) window.__iconGroupPanel(); } catch (eR) {}
            toast('已改名为「' + nm + '」');
          }, { placeholder: '输入新的分组名（可用 emoji）', maxlength: 40 });
        }, 520);
      };
      var cancel = function () { if (tmr) { clearTimeout(tmr); tmr = null; } };
      row.addEventListener('pointerdown', start);
      row.addEventListener('pointermove', function (e) {
        if (Math.abs((e.clientX || 0) - sx) > 10 || Math.abs((e.clientY || 0) - sy) > 10) cancel();
      });
      ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (ev) { row.addEventListener(ev, cancel); });
      row.addEventListener('click', function (e) {
        if (!fired) return;
        fired = false;
        e.stopPropagation(); e.preventDefault();
      }, true);
    });

    go.addEventListener('click', function () {
      var keys = Object.keys(sel);
      if (keys.length < 2) { toast('至少选 2 个图标'); return; }
      var gs = loadGroups();
      gs.forEach(function (g) {
        g.members = (g.members || []).filter(function (k) { return keys.indexOf(k) < 0; });
      });
      gs = gs.filter(function (g) { return (g.members || []).length >= 2; });
      var nm = '分组 ' + (gs.length + 1);
      gs.push({ id: 'g' + Date.now().toString(36) + Math.floor(Math.random() * 900 + 100), name: nm, members: keys });
      saveGroups(gs);
      refreshGroups();
      close();
      toast('已组成「' + nm + '」（' + keys.length + ' 个图标）');
    });
  }
  window.__iconGroupPanel = openGroupPanel;

  function injectGroupPill(app) {
    /* v88（用户直派「回到原版 装修模式·点图标换图·点卡片设背景 的交互整体还原」）：
       「图标设置」弹窗恢复原版四个选项（上传/上移/下移/隐藏），不再注入「分组…」 */
    return;
    if (!app) return;
    var mask = $('modal-mask');
    if (!mask || mask.hidden) return;
    var pills = $('modal-pills');
    if (!pills || pills.querySelector('.igrp-pill')) return;
    if ((pills.textContent || '').indexOf('隐藏图标') < 0) return;   /* 只认「图标设置」这个弹窗 */
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'pill igrp-pill';
    b.textContent = '分组…';
    b.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      try { if (window.__closeModal) window.__closeModal(); } catch (x) {}
      var mm = $('modal-mask');
      if (mm) { mm.hidden = true; mm.style.display = 'none'; }
      openGroupPanel(app);
    });
    pills.appendChild(b);
  }

  function wrapIconMenu() {
    if (!window.openIconMenu || window.openIconMenu.__v78) return;
    var orig = window.openIconMenu;
    var wrapped = function (app) {
      try { orig.call(window, app); } catch (e) {}
      setTimeout(function () { injectGroupPill(app); }, 50);
      setTimeout(function () { injectGroupPill(app); }, 260);
    };
    wrapped.__v78 = 1;
    window.openIconMenu = wrapped;
  }

  /* ---------------- 3. 日记本底部「四象限」条 ---------------- */
  var QLABEL = 'mochi-quad-label';
  var QUAD_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
    '<rect x="3.5" y="3.5" width="7.2" height="7.2" rx="2"/><rect x="13.3" y="3.5" width="7.2" height="7.2" rx="2"/>' +
    '<rect x="3.5" y="13.3" width="7.2" height="7.2" rx="2"/><rect x="13.3" y="13.3" width="7.2" height="7.2" rx="2"/></svg>';

  function paintQuadBar() {
    var nm = $('qd-quad-name'), plus = $('qd-quad-plus');
    var label = lsGet(QLABEL);
    if (nm) nm.textContent = label || '四象限';
    if (plus) plus.style.display = label ? 'none' : '';
  }

  function mountQuadBar() {
    var dwrap = document.querySelector('#qd-diary .qd-dwrap');
    if (!dwrap || $('qd-quad-bar')) return;
    var bar = document.createElement('button');
    bar.className = 'qd-diary-bar qd-quad-bar';
    bar.id = 'qd-quad-bar';
    bar.type = 'button';
    bar.setAttribute('aria-label', '回到四象限（长按改名）');
    bar.innerHTML =
      '<span class="qdb-ico">' + QUAD_SVG + '<i class="qdb-plus" id="qd-quad-plus" aria-hidden="true">+</i></span>' +
      '<span class="qdb-name" id="qd-quad-name">四象限</span>' +
      '<span class="qdb-n"></span>' +
      '<span class="qdb-arrow" aria-hidden="true">→</span>';
    dwrap.appendChild(bar);
    paintQuadBar();

    var lp = 0, fired = false, sx = 0, sy = 0;
    bar.addEventListener('pointerdown', function (e) {
      fired = false; sx = e.clientX; sy = e.clientY;
      clearTimeout(lp);
      lp = setTimeout(function () { fired = true; openQuadLabel(); }, 520);
    });
    bar.addEventListener('pointermove', function (e) {
      if (Math.abs(e.clientX - sx) > 14 || Math.abs(e.clientY - sy) > 14) { clearTimeout(lp); lp = 0; }
    });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (ev) {
      bar.addEventListener(ev, function () { clearTimeout(lp); lp = 0; });
    });
    bar.addEventListener('click', function (e) {
      try { e.stopPropagation(); } catch (x) {}
      if (fired) { fired = false; return; }
      var d = $('qd-diary'); if (d) d.classList.remove('on');
    });
  }

  function ensureQuadLabelPop() {
    if ($('qd-quad-label-pop')) return;
    var pop = document.createElement('div');
    pop.id = 'qd-quad-label-pop';
    pop.className = 'qd-label-pop';
    pop.innerHTML =
      '<div class="qlp-box"><b>四象限入口名字</b>' +
        '<input id="qd-quad-label-in" data-ce-skip="1" maxlength="16" placeholder="留空＝四象限">' +
        '<div class="qlp-row">' +
          '<button type="button" id="qql-cancel">取消</button>' +
          '<button type="button" id="qql-ok">保存</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(pop);
    $('qql-cancel').addEventListener('click', function () { pop.classList.remove('on'); });
    $('qql-ok').addEventListener('click', saveQuadLabel);
    pop.addEventListener('click', function (e) {
      if (Date.now() - (pop.__t || 0) < 400) return;
      if (e.target === pop) pop.classList.remove('on');
    });
    var inp = $('qd-quad-label-in');
    if (inp) inp.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); saveQuadLabel(); }
    });
  }

  function openQuadLabel() {
    ensureQuadLabelPop();
    var pop = $('qd-quad-label-pop'), inp = $('qd-quad-label-in');
    if (!pop || !inp) return;
    inp.value = lsGet(QLABEL);
    pop.__t = Date.now();
    pop.classList.add('on');
    setTimeout(function () { try { inp.focus(); } catch (e) {} }, 60);
  }

  function saveQuadLabel() {
    var inp = $('qd-quad-label-in');
    var t = String(inp ? inp.value : '').trim().slice(0, 16);
    lsSet(QLABEL, t);
    paintQuadBar();
    var pop = $('qd-quad-label-pop'); if (pop) pop.classList.remove('on');
    toast(t ? '四象限入口已改名' : '已恢复默认「四象限」');
  }

  function ensureQuadBar() {
    var d = $('qd-diary');
    if (d) mountQuadBar();
  }

  /* ---------------- 启动 ---------------- */
  function boot() {
    wrapIconMenu();
    dedupeDeskIcons();
    ensureQuadBar();
    setTimeout(function () { wrapIconMenu(); dedupeDeskIcons(); ensureQuadBar(); }, 700);
    setTimeout(function () { dedupeDeskIcons(); ensureQuadBar(); }, 1900);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();

  /* 桌面重建 / 切联系人后保持图标唯一与分组形态 */
  document.addEventListener('contact-switched', function () {
    setTimeout(dedupeDeskIcons, 260);
    setTimeout(dedupeDeskIcons, 900);
  });
  document.addEventListener('decor-exited', function () { setTimeout(dedupeDeskIcons, 200); });
  try {
    var _rb = window.deskRebuild;
    if (typeof _rb === 'function' && !_rb.__v78) {
      var wrb = function () {
        try { _rb.apply(window, arguments); } catch (e) {}
        setTimeout(dedupeDeskIcons, 220);
      };
      wrb.__v78 = 1;
      window.deskRebuild = wrb;
    }
  } catch (eRb) {}

  /* 日记本 DOM 是懒创建的：监听 body 直接子节点，出现就补条 */
  try {
    var mo = new MutationObserver(function () { ensureQuadBar(); });
    mo.observe(document.body, { childList: true, subtree: false });
  } catch (eMo) {}
  setInterval(ensureQuadBar, 2500);
})();

</script>
<script id="v79-quad">
/* ===== v79 =====
   1) 心讯：完整抽屉接专属字卡 / 卡册 / 心讯设置 / 底栏搜索不溢出
   2) 日记本：只有成长路线滚动（样式在 v79.css）、四格小图标（主源码）
   3) 桌面：自动补位开关、图标换成大块、管理分组 / 管理音乐
*/
(function () {
  'use strict';

  function $(id) { return document.getElementById(id); }
  function mk(tag, cls, txt) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (txt != null) e.textContent = txt;
    return e;
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function lsGet(k, d) { try { var v = localStorage.getItem(k); return v == null ? d : v; } catch (e) { return d; } }
  function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function on(e, ev, fn) { if (e) e.addEventListener(ev, fn); }
  function plain(t) { var s = String(t == null ? '' : t); var i = s.indexOf('|||'); return i >= 0 ? s.slice(0, i) : s; }
  function fmtTime(ts) {
    try {
      var d = new Date(ts || 0);
      return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
    } catch (e) { return '--:--'; }
  }
  function fmtDay(ts) {
    try {
      var d = new Date(ts || 0);
      return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
    } catch (e) { return ''; }
  }

  /* ============================================================
     一、心讯设置
     ============================================================ */
  var XN_KEY = 'mochi-xn-set';
  var XN_DEF = {
    srcOwn: 1, srcPub: 1, deal: 'random', min: 1, max: 3,
    fold: 0, auto: 0, paper: 0, inner: 0, halo: 0, face: 'yin'
  };
  function xnConf() {
    var o = {};
    try { o = JSON.parse(lsGet(XN_KEY, '{}') || '{}') || {}; } catch (e) { o = {}; }
    var c = {};
    Object.keys(XN_DEF).forEach(function (k) { c[k] = (o[k] === undefined ? XN_DEF[k] : o[k]); });
    return c;
  }
  function xnSave(c) { lsSet(XN_KEY, JSON.stringify(c)); }
  function applyXnSet() {
    var c = xnConf();
    var pg = $('page-xinxun');
    if (!pg) return;
    pg.classList.add('xn-face');
    ['yin', 'rong', 'ling', 'zhang', 'jing'].forEach(function (k) { pg.classList.toggle('xn-face-' + k, c.face === k); });
    pg.classList.toggle('xn-paper', !!c.paper);
    pg.classList.toggle('xn-inner', !!c.inner);
    pg.classList.toggle('xn-halo', !!c.halo);
  }
  window.__xnApplySet = applyXnSet;

  var XN_TABS2 = [['src', '来源'], ['deal', '回牌'], ['show', '显示'], ['bg', '背景'], ['face', '牌面']];
  function openXnSet() {
    var old = $('xns-mask'); if (old) old.remove();
    var c = xnConf();
    var mask = mk('div', 'xns-mask'); mask.id = 'xns-mask';
    mask.innerHTML =
      '<div class="xns-sheet">' +
        '<div class="xns-hd"><b>心讯设置</b><small>XINXUN SETTINGS</small><button class="xns-x" id="xns-x">✕</button></div>' +
        '<div class="xns-tabs" id="xns-tabs">' + XN_TABS2.map(function (t) {
          return '<button class="xns-tab' + (t[0] === 'src' ? ' on' : '') + '" data-t="' + t[0] + '">' + t[1] + '</button>';
        }).join('') + '</div>' +
        '<div class="xns-body" id="xns-body"></div>' +
      '</div>';
    document.body.appendChild(mask);

    function swRow(title, sub, key) {
      return '<div class="xns-row"><div class="n">' + title + (sub ? '<small>' + sub + '</small>' : '') + '</div>' +
        '<button class="xns-sw' + (c[key] ? ' on' : '') + '" data-sw="' + key + '"></button></div>';
    }
    function paint(tab) {
      var box = $('xns-body');
      if (!box) return;
      if (tab === 'src') {
        box.innerHTML = '<div class="xns-sec">字卡来源</div>' +
          swRow('专属字卡', '只属于这个联系人的字卡（完整抽屉默认读这一档）', 'srcOwn') +
          swRow('公用字卡', '所有桌面共享的字卡', 'srcPub') +
          '<div class="xns-note">关掉某一档后，「完整抽屉」和心讯推荐都不再从这一档取卡。</div>';
      } else if (tab === 'deal') {
        box.innerHTML = '<div class="xns-sec">回牌方式</div>' +
          '<div class="xns-chips"><button class="xns-chip' + (c.deal === 'one' ? ' on' : '') + '" data-deal="one">一人一句</button>' +
          '<button class="xns-chip' + (c.deal === 'random' ? ' on' : '') + '" data-deal="random">随机张数</button></div>' +
          '<div class="xns-sec">随机张数范围</div>' +
          '<div class="xns-range"><span>最少</span><input type="range" min="1" max="5" step="1" id="xns-min" value="' + c.min + '"><b id="xns-min-v">' + c.min + ' 张</b></div>' +
          '<div class="xns-range"><span>最多</span><input type="range" min="1" max="5" step="1" id="xns-max" value="' + c.max + '"><b id="xns-max-v">' + c.max + ' 张</b></div>' +
          '<div class="xns-note">不管这一轮你推几张，TA 每轮在最少～最多之间随机回一个数。</div>';
        var mn = $('xns-min'), mx = $('xns-max');
        function clamp() {
          if (Number(mn.value) > Number(mx.value)) { mn.value = mx.value; }
          $('xns-min-v').textContent = mn.value + ' 张';
          $('xns-max-v').textContent = mx.value + ' 张';
          c.min = Number(mn.value); c.max = Number(mx.value); xnSave(c);
        }
        on(mn, 'input', clamp); on(mx, 'input', clamp);
      } else if (tab === 'show') {
        box.innerHTML = '<div class="xns-sec">显示</div>' +
          swRow('默认折叠「TA 在想什么」', '进入心讯时先收起选卡区，只留标题', 'fold') +
          swRow('自动换一批', '每 6 秒自动换一组候选卡', 'auto') +
          '<div class="xns-note">折叠和自动换都会记住，下次进入心讯直接按这个状态显示。</div>';
      } else if (tab === 'bg') {
        box.innerHTML = '<div class="xns-sec">纸感与细节</div>' +
          swRow('纸纹', '卡面上加一层很淡的横纹，像纸的纹理', 'paper') +
          swRow('内框', '卡面里再压一道细内框', 'inner') +
          swRow('保字晕', '文字外面加一层极淡的白色柔晕，图片上更易读', 'halo') +
          '<div class="xns-note">这三项只改观感，不影响字卡内容。</div>';
      } else {
        var FACES = [['yin', '框印'], ['rong', '环绒'], ['ling', '菱徽'], ['zhang', '圆章'], ['jing', '净面']];
        box.innerHTML = '<div class="xns-sec">牌面</div>' +
          '<div class="xns-chips">' + FACES.map(function (f) {
            return '<button class="xns-chip' + (c.face === f[0] ? ' on' : '') + '" data-face="' + f[0] + '">' + f[1] + '</button>';
          }).join('') + '</div>' +
          '<div class="xns-note">框印＝细内框＋一道内线；环绒＝双线圆角；菱徽＝左上角小菱；圆章＝右下角小圆章；净面＝只留文字。</div>';
      }
    }
    paint('src');
    on($('xns-x'), 'click', function () { mask.remove(); });
    on(mask, 'click', function (e) { if (e.target === mask) mask.remove(); });
    on($('xns-tabs'), 'click', function (e) {
      var b = e.target.closest('[data-t]'); if (!b) return;
      mask.querySelectorAll('.xns-tab').forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on');
      paint(b.getAttribute('data-t'));
    });
    on($('xns-body'), 'click', function (e) {
      var sw = e.target.closest('[data-sw]');
      if (sw) {
        var k = sw.getAttribute('data-sw');
        c[k] = c[k] ? 0 : 1;
        sw.classList.toggle('on', !!c[k]);
        xnSave(c); applyXnSet();
        return;
      }
      var d = e.target.closest('[data-deal]');
      if (d) {
        c.deal = d.getAttribute('data-deal');
        mask.querySelectorAll('[data-deal]').forEach(function (x) { x.classList.toggle('on', x === d); });
        xnSave(c);
        return;
      }
      var f = e.target.closest('[data-face]');
      if (f) {
        c.face = f.getAttribute('data-face');
        mask.querySelectorAll('[data-face]').forEach(function (x) { x.classList.toggle('on', x === f); });
        xnSave(c); applyXnSet();
        return;
      }
    });
  }
  window.__xnSetOpen = openXnSet;

  /* ============================================================
     二、完整抽屉（专属字卡）
     ============================================================ */
  var XD_CATS = [
    ['all', '全部'], ['own', '专属字卡'], ['pub', '公用字卡'],
    ['sticker', '表情包'], ['image', '图片'], ['emoji', 'emoji'], ['kao', '颜文字'], ['group', '分组']
  ];
  var XD_TYPES = [
    ['text', 'text'], ['kaomoji', 'kaomoji'], ['emoji', 'emoji'],
    ['sticker', 'sticker'], ['image', 'image']
  ];
  var xd = { cat: 'all', group: '', q: '', sel: {} };

  function scoped(type, scope) {
    try {
      if (typeof window.getScopedGroups === 'function') return window.getScopedGroups(type, scope) || [];
    } catch (e) {}
    return [];
  }
  function xdAll() {
    var c = xnConf();
    var out = [];
    var scopes = [];
    if (c.srcOwn) scopes.push('own');
    if (c.srcPub) scopes.push('public');
    if (!scopes.length) scopes = ['own'];
    XD_TYPES.forEach(function (t) {
      scopes.forEach(function (scope) {
        scoped(t[0], scope).forEach(function (g) {
          var gname = (g && g[0]) || '未分组';
          (g[1] || []).forEach(function (card) {
            if (typeof card !== 'string' || !card) return;
            out.push({ t: card, type: t[0], g: gname, scope: scope });
          });
        });
      });
    });
    return out;
  }
  function xdFiltered(all) {
    var list = all;
    if (xd.cat === 'own') list = list.filter(function (x) { return x.scope === 'own'; });
    else if (xd.cat === 'pub') list = list.filter(function (x) { return x.scope === 'public'; });
    else if (xd.cat === 'sticker') list = list.filter(function (x) { return x.type === 'sticker'; });
    else if (xd.cat === 'image') list = list.filter(function (x) { return x.type === 'image'; });
    else if (xd.cat === 'emoji') list = list.filter(function (x) { return x.type === 'emoji'; });
    else if (xd.cat === 'kao') list = list.filter(function (x) { return x.type === 'kaomoji'; });
    else if (xd.cat === 'group') list = list.filter(function (x) { return x.g === xd.group; });
    if (xd.q) {
      var q = xd.q.toLowerCase();
      list = list.filter(function (x) {
        return (plain(x.t).toLowerCase().indexOf(q) >= 0) || (String(x.g).toLowerCase().indexOf(q) >= 0);
      });
    }
    return list;
  }
  function cardKey(x) { return x.type + '|' + x.t; }

  function buildXdPage() {
    if ($('page-xn-drawer')) return $('page-xn-drawer');
    var host = ($('page-xinxun') && $('page-xinxun').parentNode) || ($('page-phone') && $('page-phone').parentNode);
    if (!host) return null;
    var pg = mk('div', 'page xnd-page');
    pg.id = 'page-xn-drawer';
    pg.hidden = true;
    pg.innerHTML =
      '<div class="xnd-head">' +
        '<button class="xnd-back" id="xnd-back" aria-label="返回"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>' +
        '<div class="xnd-title">字卡抽屉<small>专属字卡 · 搜索 / 多选 / 推给 TA</small></div>' +
        '<span class="xnd-sel" id="xnd-n">已选 0 张</span>' +
      '</div>' +
      '<div class="xnd-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>' +
        '<input id="xnd-q" data-ce-skip="1" type="text" placeholder="搜索字卡 / 牌名 / 情绪词 / 分组" autocomplete="off"></div>' +
      '<div class="xnd-chips" id="xnd-cats">' + XD_CATS.map(function (c) {
        return '<button class="xnd-chip' + (c[0] === 'all' ? ' on' : '') + '" data-cat="' + c[0] + '">' + c[1] + '</button>';
      }).join('') + '</div>' +
      '<div class="xnd-chips" id="xnd-groups" hidden></div>' +
      '<div class="xnd-tip" id="xnd-tip"></div>' +
      '<div class="xnd-grid" id="xnd-grid"></div>' +
      '<div class="xnd-foot"><button id="xnd-clear">清空</button><button class="pri" id="xnd-push">推给 TA</button></div>';
    host.appendChild(pg);

    on($('xnd-back'), 'click', function () { hidePage(pg, 'page-xinxun'); });
    on($('xnd-q'), 'input', function () { xd.q = String(this.value || '').trim(); paintXd(); });
    on($('xnd-cats'), 'click', function (e) {
      var b = e.target.closest('[data-cat]'); if (!b) return;
      xd.cat = b.getAttribute('data-cat');
      xd.group = '';
      pg.querySelectorAll('#xnd-cats .xnd-chip').forEach(function (x) { x.classList.toggle('on', x === b); });
      paintXd();
    });
    on($('xnd-groups'), 'click', function (e) {
      var b = e.target.closest('[data-g]'); if (!b) return;
      xd.group = b.getAttribute('data-g');
      pg.querySelectorAll('#xnd-groups .xnd-chip').forEach(function (x) { x.classList.toggle('on', x === b); });
      paintXd();
    });
    on($('xnd-grid'), 'click', function (e) {
      var c = e.target.closest('[data-k]'); if (!c) return;
      var k = c.getAttribute('data-k');
      if (xd.sel[k]) delete xd.sel[k]; else xd.sel[k] = 1;
      c.classList.toggle('on', !!xd.sel[k]);
      paintSel();
    });
    on($('xnd-clear'), 'click', function () { xd.sel = {}; paintXd(); });
    on($('xnd-push'), 'click', pushXd);
    return pg;
  }

  function paintSel() {
    var n = Object.keys(xd.sel).length;
    var el = $('xnd-n'); if (el) el.textContent = '已选 ' + n + ' 张';
    var btn = $('xnd-push');
    if (btn) { btn.disabled = !n; btn.textContent = n ? ('推给 TA（' + n + '）') : '推给 TA'; }
  }

  function paintXd() {
    var grid = $('xnd-grid'); if (!grid) return;
    var all = xdAll();
    var list = xdFiltered(all);

    var gbox = $('xnd-groups');
    if (gbox) {
      if (xd.cat === 'group') {
        var names = [];
        all.forEach(function (x) { if (names.indexOf(x.g) < 0) names.push(x.g); });
        gbox.hidden = false;
        gbox.innerHTML = names.slice(0, 24).map(function (g) {
          return '<button class="xnd-chip' + (xd.group === g ? ' on' : '') + '" data-g="' + esc(g) + '">' + esc(g) + '</button>';
        }).join('') || '<span class="xnd-tip">还没有分组</span>';
      } else gbox.hidden = true;
    }

    var tip = $('xnd-tip');
    if (tip) tip.textContent = '筛选后 ' + list.length + ' 张 · 共 ' + all.length + ' 张 · 点字卡多选，底部推到心讯';

    grid.innerHTML = '';
    if (!list.length) {
      grid.innerHTML = '<div class="xnd-empty">' + (all.length ? '没有符合条件的字卡' : '还没有字卡，先去字卡库添加') + '</div>';
      paintSel();
      return;
    }
    var LIMIT = 400;
    list.slice(0, LIMIT).forEach(function (x) {
      var k = cardKey(x);
      var isMedia = (x.type === 'sticker' || x.type === 'image');
      var c = mk('div', 'xnd-card' + (isMedia ? ' media' : '') + (xd.sel[k] ? ' on' : ''));
      c.setAttribute('data-k', k);
      if (isMedia) {
        var im = mk('img'); im.alt = ''; im.loading = 'lazy'; im.src = x.t;
        c.appendChild(im);
        c.appendChild(mk('small', '', x.g));
      } else {
        c.appendChild(mk('span', '', plain(x.t)));
        c.appendChild(mk('small', '', x.g));
      }
      grid.appendChild(c);
    });
    if (list.length > LIMIT) {
      var more = mk('div', 'xnd-empty', '只显示前 ' + LIMIT + ' 张，用搜索或分组再缩小范围');
      more.style.gridColumn = '1/-1';
      grid.appendChild(more);
    }
    paintSel();
  }

  function pushXd() {
    var keys = Object.keys(xd.sel);
    if (!keys.length) return;
    var byKey = {};
    xdAll().forEach(function (x) { byKey[cardKey(x)] = x; });
    var texts = [], medias = [];
    keys.forEach(function (k) {
      var x = byKey[k];
      if (!x) return;
      if (x.type === 'sticker' || x.type === 'image') medias.push(x.t);
      else texts.push(plain(x.t));
    });
    /* 回牌方式（「一人一句 / 随机张数」）说的是 TA 每轮回几张，
       不是「你推几张」——你在这里选了几张就发几张，绝不偷偷截断。 */
    var sent = 0;
    texts.forEach(function (t, i) {
      setTimeout(function () {
        try { if (window.chatSendMsg) window.chatSendMsg(t); } catch (e) {}
      }, i * 220);
      sent++;
    });
    medias.forEach(function (src) {
      try {
        if (window.chatSendMedia && window.chatSendMedia(src)) sent++;
      } catch (e) {}
    });
    xd.sel = {};
    paintXd();
    if (sent) {
      var tail = medias.length ? '，' + medias.length + ' 张图片在草稿栏等你点发送' : '';
      toast('已推 ' + sent + ' 张给 ' + partnerName() + tail);
    } else {
      toast('没有可推送的字卡');
    }
  }
  function partnerName() {
    try { return (window.activeStore && window.activeStore().get('lbl-partner')) || 'TA'; } catch (e) { return 'TA'; }
  }

  function showPage(pg) {
    if (!pg) return;
    if (typeof window.__yzxOpenPage === 'function') { try { window.__yzxOpenPage(pg); return; } catch (e) {} }
    document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
    pg.hidden = false;
    var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = true;
    pg.classList.add('full');
  }
  function hidePage(pg, backId) {
    if (pg) { pg.hidden = true; pg.classList.remove('full'); }
    var b = $(backId) || $('page-xinxun') || $('page-phone');
    if (b) b.hidden = false;
  }

  window.__xnDrawerOpen = function () {
    var pg = buildXdPage();
    if (!pg) { toast('抽屉还没准备好'); return; }
    applyXnSet();
    xd.sel = {};
    paintXd();
    showPage(pg);
  };

  /* ============================================================
     三、卡册
     ============================================================ */
  function buildAlbumPage() {
    if ($('page-xn-album')) return $('page-xn-album');
    var host = ($('page-xinxun') && $('page-xinxun').parentNode) || ($('page-phone') && $('page-phone').parentNode);
    if (!host) return null;
    var pg = mk('div', 'page xna-page');
    pg.id = 'page-xn-album';
    pg.hidden = true;
    pg.innerHTML =
      '<div class="chat-head">' +
        '<span class="ch-back" id="xna-back"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></span>' +
        '<span class="ch-name">卡册</span>' +
      '</div>' +
      '<div class="xna-body" id="xna-body"></div>';
    host.appendChild(pg);
    on($('xna-back'), 'click', function () { hidePage(pg, 'page-xinxun'); });
    return pg;
  }
  window.__xnAlbumOpen = function () {
    var pg = buildAlbumPage();
    if (!pg) return;
    var body = $('xna-body');
    var list = [];
    try { list = (window.getChatMsgs ? window.getChatMsgs() : []) || []; } catch (e) { list = []; }
    list = list.filter(function (m) { return m && !m.special && !m.retracted && (m.text || (m.parts && m.parts.length)); });
    var days = {}, order = [];
    list.forEach(function (m) {
      var d = fmtDay(m.ts || Date.now());
      if (!days[d]) { days[d] = []; order.push(d); }
      days[d].push(m);
    });
    order.sort().reverse();
    body.innerHTML = '';
    if (!order.length) {
      body.innerHTML = '<div class="xnd-empty">还没有可以收进卡册的消息</div>';
    } else {
      order.forEach(function (d) {
        var g = mk('div', 'xna-day');
        var h = mk('div', 'xna-day-h');
        h.appendChild(mk('span', '', d === fmtDay(Date.now()) ? ('今天 · ' + d) : d));
        h.appendChild(mk('small', '', days[d].length + ' 张'));
        g.appendChild(h);
        var grid = mk('div', 'xna-grid');
        days[d].forEach(function (m) {
          var c = mk('div', 'xna-c' + (m.side === 'out' ? ' me' : ''));
          var media = (m.type === 'sticker' || m.type === 'image') ? m.text : '';
          var partImg = (m.parts || []).filter(function (p) { return p && p.k === 'img'; })[0];
          if (media || partImg) {
            var im = mk('img'); im.alt = ''; im.loading = 'lazy';
            im.src = media || partImg.v;
            c.appendChild(im);
          } else {
            c.appendChild(mk('span', '', plain(m.text).slice(0, 90)));
          }
          c.appendChild(mk('i', '', (m.side === 'out' ? '你出' : 'TA 递') + ' · ' + fmtTime(m.ts)));
          grid.appendChild(c);
        });
        g.appendChild(grid);
        body.appendChild(g);
      });
    }
    showPage(pg);
  };

  /* ============================================================
     四、桌面：自动补位 / 图标换成大块
     ============================================================ */
  var AF_KEY = 'mochi-desk-autofill';
  var OF_KEY = 'mochi-desk-offsets-v79';
  var BK_KEY = 'mochi-block-icons-v79';

  function afOn() { return lsGet(AF_KEY, '1') !== '0'; }
  function setAf(on) {
    lsSet(AF_KEY, on ? '1' : '0');
    if (on) { lsSet(OF_KEY, '{}'); applyOffsets(); }
    /* v82：同步整理模式工具栏上的总开关文案 */
    var _ab = document.getElementById('decor-autofill');
    if (_ab) _ab.textContent = '自动补位：' + (on ? '开' : '关');
    toast(on ? '自动补位已开：拖完自动排整齐' : '自动补位已关：图标可以随便放，不会回流');
  }
  window.__v79AfOn = afOn;
  window.__v79SetAf = setAf;
  /* v82：工具栏总开关——点一下切换开/关 */
  (function bindAfBtn() {
    var _ab = document.getElementById('decor-autofill');
    if (!_ab || _ab.__v82) return;
    _ab.__v82 = 1;
    _ab.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      setAf(!afOn());
    });
  })();
  /* 进装修模式时把开关文案对齐当前状态 */
  var _phAf = document.getElementById('page-phone');
  if (_phAf) {
    try {
      new MutationObserver(function () {
        if (!_phAf.classList.contains('decor-on')) return;
        var _ab = document.getElementById('decor-autofill');
        if (_ab) _ab.textContent = '自动补位：' + (afOn() ? '开' : '关');
      }).observe(_phAf, { attributes: true, attributeFilter: ['class'] });
    } catch (eMo2) {}
  }
  function offsets() { try { return JSON.parse(lsGet(OF_KEY, '{}') || '{}') || {}; } catch (e) { return {}; } }
  function saveOffsets(o) { lsSet(OF_KEY, JSON.stringify(o)); }
  function applyOffsets() {
    var o = offsets();
    document.querySelectorAll('.app-grid').forEach(function (g) {
      var gid = g.getAttribute('data-app') || '';
      var map = (o && o[gid]) || {};
      g.querySelectorAll('.app').forEach(function (a) {
        if (a.closest('.df-hold')) { a.style.transform = ''; return; }
        var k = a.getAttribute('data-app') || (a.classList.contains('desk-folder') ? 'folder:' + (a.getAttribute('data-fid') || '') : '');
        var v = map[k];
        if (v && (Math.abs(v[0]) > 0.5 || Math.abs(v[1]) > 0.5)) {
          a.style.transform = 'translate(' + v[0] + 'px,' + v[1] + 'px)';
          a.classList.add('desk-moved');
        } else {
          a.style.transform = '';
          a.classList.remove('desk-moved');
        }
      });
    });
  }
  window.__v79ApplyOffsets = applyOffsets;

  window.__v79FreeDrop = function (el, info, cx, cy) {
    if (afOn()) return false;
    var phone = $('page-phone');
    if (!phone || !(phone.classList.contains('decor-on') || phone.classList.contains('desk-move-mode'))) return false;
    if (!info || info.type !== 'grid') return false;
    var grid = el.closest ? el.closest('.app-grid') : null;
    if (!grid) return false;
    var gid = grid.getAttribute('data-app') || '';
    /* v82：分组图标同样支持自由摆放 */
    var key = el.getAttribute('data-app') || (el.classList.contains('desk-folder') ? 'folder:' + (el.getAttribute('data-fid') || '') : '');
    if (!key) return false;
    var base = el.getBoundingClientRect();
    if (!base.width) return false;
    var o = offsets();
    var map = o[gid] || {};
    var cur = map[key] ? map[key][0] : 0, curY = map[key] ? map[key][1] : 0;
    var bLeft = base.left - cur, bTop = base.top - curY;
    var nx = 0, ny = 0;
    if (typeof cx === 'number' && typeof cy === 'number') {
      nx = cx - (bLeft + base.width / 2);
      ny = cy - (bTop + base.height / 2);
    }
    var lim = 220;
    nx = Math.max(-lim, Math.min(lim, nx));
    ny = Math.max(-lim, Math.min(lim, ny));
    el.style.transform = 'translate(' + nx + 'px,' + ny + 'px)';
    el.classList.add('desk-moved');
    map[key] = [nx, ny];
    o[gid] = map;
    saveOffsets(o);
    /* v83：分组图标不许盖在小组件上——落点压到组件就自动让位回网格 */
    if (el.classList && el.classList.contains('desk-folder') && window.__folderKeepOffWidgets) {
      setTimeout(function () { try { window.__folderKeepOffWidgets(false); } catch (eK) {} }, 60);
    }
    if (navigator.vibrate) { try { navigator.vibrate(8); } catch (e) {} }
    return true;
  };

  function blockSub(k) {
    var M = {
      chat: '和 TA 说说话', feed: '看看最近的朋友圈', divination: '抽一张，问一句',
      note: '收着你说过的话', music: '正在播放', worldsense: '世界感知',
      mail: '未读来信', reading: '在读进度', 'memo-arc': '梦角档案', 'my-arc': '我的档案',
      'memo': '随手记一笔', stats: '聊天统计', period: '经期记录', quadrant: '今天还没有记录'
    };
    return M[k] || '';
  }
  function blocks() { try { return JSON.parse(lsGet(BK_KEY, '{}') || '{}') || {}; } catch (e) { return {}; } }
  function saveBlocks(o) { lsSet(BK_KEY, JSON.stringify(o)); }
  function applyBlocks() {
    var b = blocks();
    document.querySelectorAll('.app[data-app]').forEach(function (a) {
      var k = a.getAttribute('data-app');
      var want = !!b[k];
      if (want) {
        a.classList.add('app-blk');
        var nm = a.querySelector('.app-name');
        if (nm && !nm.parentNode.classList.contains('app-blk-tx')) {
          var tx = mk('div', 'app-blk-tx');
          nm.parentNode.insertBefore(tx, nm);
          tx.appendChild(nm);
          tx.appendChild(mk('div', 'app-blk-sub', blockSub(k)));
        }
        if (!a.querySelector('.app-blk-sub')) {
          var nm2 = a.querySelector('.app-name');
          if (nm2) nm2.parentNode.appendChild(mk('div', 'app-blk-sub', blockSub(k)));
        }
      } else {
        a.classList.remove('app-blk');
        var tx2 = a.querySelector('.app-blk-tx');
        if (tx2) {
          var n2 = tx2.querySelector('.app-name');
          if (n2) a.appendChild(n2);
          tx2.remove();
        }
      }
    });
  }
  window.__v79ApplyBlocks = applyBlocks;
  function toggleBlock(app) {
    if (!app) return;
    var k = app.getAttribute('data-app'); if (!k) return;
    var b = blocks();
    if (b[k]) { delete b[k]; toast('已变回小图标'); }
    else { b[k] = 1; toast('已换成大块'); }
    saveBlocks(b);
    applyBlocks();
  }

  /* ============================================================
     五、图标设置里加钩子
     ============================================================ */
  function injectIconPills(app) {
    /* v88：同上——「换成大块 / 自动补位 / 管理分组…」不再注入，图标设置回到原版 */
    return;
    var mask = $('modal-mask');
    if (!mask || mask.hidden) return;
    var pills = $('modal-pills');
    if (!pills) return;
    if ((pills.textContent || '').indexOf('隐藏图标') < 0) return;
    if (pills.querySelector('.v79-pill')) return;
    var k = app ? app.getAttribute('data-app') : '';
    var isBlk = app ? app.classList.contains('app-blk') : false;

    function pill(txt, fn) {
      var b = mk('button', 'pill v79-pill', txt);
      b.type = 'button';
      on(b, 'click', function (e) {
        e.preventDefault(); e.stopPropagation();
        try { if (window.__closeModal) window.__closeModal(); } catch (x) {}
        try { mask.hidden = true; mask.style.display = 'none'; } catch (x2) {}
        setTimeout(fn, 60);
      });
      pills.appendChild(b);
      return b;
    }
    if (k) {
      pill(isBlk ? '变回小图标' : '换成大块', function () { toggleBlock(app); });
    }
    pill('自动补位：' + (afOn() ? '开' : '关'), function () {
      setAf(!afOn());
      if (window.openIconMenu && app) setTimeout(function () { window.openIconMenu(app); }, 120);
    });
    pill('管理分组…', function () { openGroupManager(); });
  }
  function wrapIconMenu() {
    if (!window.openIconMenu || window.openIconMenu.__v79) return;
    var orig = window.openIconMenu;
    var w = function (app) {
      try { orig.call(window, app); } catch (e) {}
      setTimeout(function () { injectIconPills(app); }, 70);
      setTimeout(function () { injectIconPills(app); }, 300);
    };
    w.__v79 = 1;
    window.openIconMenu = w;
  }

  /* ============================================================
     六、管理分组
     ============================================================ */
  var GKEY = 'mochi-desk-groups-v67';
  function loadGroups() { try { var a = JSON.parse(lsGet(GKEY, '[]') || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
  function saveGroups(a) { lsSet(GKEY, JSON.stringify(a)); }
  function appName(k) {
    var a = document.querySelector('.app[data-app="' + k + '"]');
    var n = a && a.querySelector('.app-name');
    return (n && n.textContent.trim()) || k;
  }
  function refreshGroups() { try { if (window.__deskGroupsRefresh) window.__deskGroupsRefresh(); } catch (e) {} }

  function panel(title, sub, rows, footBtns) {
    var mask = mk('div', 'mg-mask');
    mask.innerHTML = '<div class="mg-box"><div class="mg-hd"><b>' + title + '</b>' +
      (sub ? '<small>' + sub + '</small>' : '') + '<button class="mg-x">✕</button></div>' +
      '<div class="mg-list"></div><div class="mg-ft"></div></div>';
    document.body.appendChild(mask);
    var list = mask.querySelector('.mg-list');
    var ft = mask.querySelector('.mg-ft');
    if (!rows.length) list.innerHTML = '<div class="mg-empty">' + (sub === 'music' ? '音乐库还是空的' : '还没有分组') + '</div>';
    rows.forEach(function (r) {
      var row = mk('div', 'mg-row');
      row.setAttribute('data-id', r.id);
      row.innerHTML = '<span class="mg-ck">✓</span><span class="mg-nm">' + esc(r.name) +
        (r.sub ? '<small>' + esc(r.sub) + '</small>' : '') + '</span>';
      list.appendChild(row);
    });
    function close() { mask.remove(); }
    mask.querySelector('.mg-x').addEventListener('click', close);
    mask.addEventListener('click', function (e) { if (e.target === mask) close(); });
    return { mask: mask, list: list, ft: ft, close: close };
  }

  function openGroupManager() {
    var groups = loadGroups();
    var rows = groups.map(function (g) {
      return {
        id: g.id, name: g.name || '分组',
        sub: (g.members || []).map(appName).join(' / ')
      };
    });
    var ui = panel('管理分组', groups.length + ' 组', rows);
    var sel = {};
    /* v84（用户直派「管理分组长按可以改名」）：长按分组行改名，不影响点选 */
    ui.list.querySelectorAll('.mg-row').forEach(function (row) {
      var gid = row.getAttribute('data-id');
      var tmr = null, sx = 0, sy = 0, fired = false;
      row.addEventListener('pointerdown', function (e) {
        sx = e.clientX || 0; sy = e.clientY || 0;
        if (tmr) clearTimeout(tmr);
        tmr = setTimeout(function () {
          tmr = null; fired = true;
          var gs = loadGroups();
          var g = gs.filter(function (x) { return x.id === gid; })[0];
          if (!g || !window.openModal) return;
          try { if (navigator.vibrate) navigator.vibrate(12); } catch (eV) {}
          window.openModal('分组改名', g.name || '分组', function (v) {
            /* v86（用户直派「分组改名可以输入 emoji」）：emoji/组合字符是多个 UTF-16 单元，
               旧代码 slice(0,12) 会把它切成半个代理对（显示成方块、存进去变乱码）。
               现在按码点截断，12 个字符（含 emoji）完整保留。 */
            var _raw = String(v == null ? '' : v).trim();
            var nm = (function () {
              try { return Array.from(_raw).slice(0, 12).join(''); } catch (eG) { return _raw.slice(0, 12); }
            })();
            if (!nm) return;
            var gs2 = loadGroups();
            var g2 = gs2.filter(function (x) { return x.id === gid; })[0];
            if (!g2) return;
            g2.name = nm;
            saveGroups(gs2);
            refreshGroups();
            try { ui.close(); } catch (eC) {}
            toast('已改名为「' + nm + '」');
          }, { placeholder: '输入新的分组名（可用 emoji）', maxlength: 40 });
        }, 520);
      });
      var cancel = function () { if (tmr) { clearTimeout(tmr); tmr = null; } };
      row.addEventListener('pointermove', function (e) {
        if (Math.abs((e.clientX || 0) - sx) > 10 || Math.abs((e.clientY || 0) - sy) > 10) cancel();
      });
      ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (ev) { row.addEventListener(ev, cancel); });
      row.addEventListener('click', function (e) {
        if (!fired) return;
        fired = false;
        e.stopPropagation(); e.preventDefault();
      }, true);
    });
    ui.list.addEventListener('click', function (e) {
      var row = e.target.closest('.mg-row'); if (!row) return;
      var id = row.getAttribute('data-id');
      if (sel[id]) delete sel[id]; else sel[id] = 1;
      row.classList.toggle('on', !!sel[id]);
    });
    function ids() { return Object.keys(sel); }
    function b(txt, cls, fn) {
      var x = mk('button', cls || '', txt);
      on(x, 'click', fn);
      ui.ft.appendChild(x);
      return x;
    }
    b('全选', '', function () {
      var all = ids().length === rows.length;
      sel = {};
      if (!all) rows.forEach(function (r) { sel[r.id] = 1; });
      ui.list.querySelectorAll('.mg-row').forEach(function (r) { r.classList.toggle('on', !!sel[r.getAttribute('data-id')]); });
    });
    b('删除', 'danger', function () {
      var chosen = ids();
      if (!chosen.length) { toast('先勾选分组'); return; }
      var gs = loadGroups().filter(function (g) { return chosen.indexOf(g.id) < 0; });
      saveGroups(gs);
      refreshGroups();
      ui.close();
      toast('已解散 ' + chosen.length + ' 组，图标回到原来的那一页');
    });
    b('移动', 'pri', function () {
      var chosen = ids();
      if (!chosen.length) { toast('先勾选分组'); return; }
      openMoveGroups(chosen, ui);
    });
  }

  function openMoveGroups(chosen, prev) {
    var slides = [].slice.call(document.querySelectorAll('#desktop-pages .page-slide'));
    var rows = slides.map(function (s, i) {
      return { id: String(i), name: (i === 0 ? '第 1 页（首页）' : '第 ' + (i + 1) + ' 页'), sub: (s.querySelectorAll('.app').length + ' 个图标') };
    });
    var ui = panel('移动到哪一页', chosen.length + ' 组', rows);
    var pick = null;
    ui.list.addEventListener('click', function (e) {
      var row = e.target.closest('.mg-row'); if (!row) return;
      pick = Number(row.getAttribute('data-id'));
      ui.list.querySelectorAll('.mg-row').forEach(function (r) { r.classList.toggle('on', r === row); });
    });
    var btn = mk('button', 'pri', '移动到这里');
    on(btn, 'click', function () {
      if (pick == null) { toast('先选一页'); return; }
      var target = slides[pick];
      var grid = target && target.querySelector('.app-grid');
      if (!grid) { toast('这一页没有图标网格'); return; }
      var groups = loadGroups();
      var moved = 0;
      chosen.forEach(function (gid) {
        var g = groups.filter(function (x) { return x.id === gid; })[0];
        if (!g) return;
        (g.members || []).forEach(function (k) {
          var a = document.querySelector('.app[data-app="' + k + '"]');
          if (!a) return;
          a.style.transform = '';
          grid.appendChild(a);
          moved++;
        });
      });
      try {
        var order = [].slice.call(grid.querySelectorAll('.app')).map(function (a) { return a.getAttribute('data-app'); });
        if (grid.getAttribute('data-app')) localStorage.setItem('app-icon-order-' + grid.getAttribute('data-app'), JSON.stringify(order));
      } catch (e) {}
      refreshGroups();
      try { if (window.deskRebuild) window.deskRebuild(); } catch (e2) {}
      ui.close(); if (prev) try { prev.close(); } catch (e3) {}
      toast('已移动 ' + moved + ' 个图标到第 ' + (pick + 1) + ' 页');
    });
    ui.ft.appendChild(btn);
  }

  /* 整理模式顶栏加「管理分组」 */
  function mountDecorBtn() {
    var bar = $('decor-bar');
    if (!bar || $('decor-manage-groups')) return;
    var b = mk('button', 'decor-add', '管理分组');
    b.id = 'decor-manage-groups';
    b.type = 'button';
    /* v80（用户直派「管理分组是音乐的，把原来桌面的分组功能改回去」）：
       这个按钮不再打开通用列表面板，改回 v78 的桌面分组面板（勾选图标成组 / 已有分组加入） */
    on(b, 'click', function (e) {
      e.stopPropagation();
      try { if (window.__iconGroupPanel) { window.__iconGroupPanel(); return; } } catch (eI) {}
      openGroupManager();
    });
    var done = $('decor-done');
    if (done && done.parentNode === bar) bar.insertBefore(b, done);
    else bar.appendChild(b);
  }

  /* ============================================================
     七、管理音乐
     ============================================================ */
  function musicLib() {
    try { return (window.__yzMusic && window.__yzMusic.lib && window.__yzMusic.lib()) || []; } catch (e) { return []; }
  }
  function openMusicManager() {
    var lib = musicLib();
    var rows = lib.map(function (m) {
      return { id: m.id, name: m.name || '未命名', sub: (m.artist || '') + (m.playlistId ? ' · 歌单' : '') };
    });
    var ui = panel('管理音乐', lib.length + ' 首', rows);
    var sel = {};
    ui.list.addEventListener('click', function (e) {
      var row = e.target.closest('.mg-row'); if (!row) return;
      var id = row.getAttribute('data-id');
      if (sel[id]) delete sel[id]; else sel[id] = 1;
      row.classList.toggle('on', !!sel[id]);
    });
    function ids() { return Object.keys(sel); }
    function b(txt, cls, fn) {
      var x = mk('button', cls || '', txt);
      on(x, 'click', fn); ui.ft.appendChild(x); return x;
    }
    b('全选', '', function () {
      var all = ids().length === rows.length;
      sel = {};
      if (!all) rows.forEach(function (r) { sel[r.id] = 1; });
      ui.list.querySelectorAll('.mg-row').forEach(function (r) { r.classList.toggle('on', !!sel[r.getAttribute('data-id')]); });
    });
    b('删除', 'danger', function () {
      var chosen = ids();
      if (!chosen.length) { toast('先勾选歌曲'); return; }
      try {
        if (window.openModal) {
          window.openModal('删除选中的 ' + chosen.length + ' 首音乐？', '只从音乐库移出，本机文件不会被删除。', function () {
            if (window.__yzMusic && window.__yzMusic.removeSongs) window.__yzMusic.removeSongs(chosen);
            ui.close();
            toast('已删除 ' + chosen.length + ' 首');
          }, { noInput: true });
        }
      } catch (e) {}
    });
    b('移动', 'pri', function () {
      var chosen = ids();
      if (!chosen.length) { toast('先勾选歌曲'); return; }
      openMoveMusic(chosen, ui);
    });
    /* v80（用户直派）：把勾选的歌移动到别的歌单 */
    b('移到歌单', '', function () {
      var chosen = ids();
      if (!chosen.length) { toast('先勾选歌曲'); return; }
      openMoveMusicTo(chosen, ui);
    });
  }
  function openMoveMusicTo(chosen, prev) {
    var pls = [];
    try { pls = (window.__yzMusic && window.__yzMusic.playlists && window.__yzMusic.playlists()) || []; } catch (eP) { pls = []; }
    if (!pls.length) { toast('还没有歌单'); return; }
    var lib = musicLib();
    var rows = pls.map(function (p) {
      var inPl = lib.filter(function (m) { return String(m.playlistId || '') === String(p.id); }).length;
      return { id: String(p.id), name: p.name || '歌单', sub: inPl + ' 首在里面' };
    });
    var ui2 = panel('移到歌单', chosen.length + ' 首', rows);
    var pick = null;
    ui2.list.addEventListener('click', function (e) {
      var row = e.target.closest('.mg-row'); if (!row) return;
      pick = row.getAttribute('data-id');
      ui2.list.querySelectorAll('.mg-row').forEach(function (r) { r.classList.toggle('on', r === row); });
    });
    var btn = mk('button', 'pri', '移到这里');
    on(btn, 'click', function () {
      if (!pick) { toast('先选一个歌单'); return; }
      var n = 0;
      try { n = window.__yzMusic.moveSongsTo(chosen, pick) || 0; } catch (eM) {}
      ui2.close();
      toast(n > 0 ? '已把 ' + n + ' 首移进「' + ((pls.filter(function (p) { return String(p.id) === String(pick) })[0] || {}).name || '歌单') + '」' : '选的歌已经在这个歌单里了');
      if (n > 0 && prev) try { prev.close(); } catch (e2) {}
    });
    ui2.ft.appendChild(btn);
  }
  function openMoveMusic(chosen, prev) {
    var rows = [
      { id: 'top', name: '移到最前', sub: '按勾选的顺序排到最上面' },
      { id: 'up', name: '上移一位', sub: '每首往上挪一格' },
      { id: 'down', name: '下移一位', sub: '每首往下挪一格' },
      { id: 'bottom', name: '移到最后', sub: '排到整个音乐库末尾' }
    ];
    var ui = panel('移动歌曲', chosen.length + ' 首', rows);
    var pick = null;
    ui.list.addEventListener('click', function (e) {
      var row = e.target.closest('.mg-row'); if (!row) return;
      pick = row.getAttribute('data-id');
      ui.list.querySelectorAll('.mg-row').forEach(function (r) { r.classList.toggle('on', r === row); });
    });
    var btn = mk('button', 'pri', '确认移动');
    on(btn, 'click', function () {
      if (!pick) { toast('先选一种移动方式'); return; }
      try {
        if (window.__yzMusic && window.__yzMusic.moveSongs) window.__yzMusic.moveSongs(chosen, pick);
      } catch (e) {}
      ui.close(); if (prev) try { prev.close(); } catch (e2) {}
      toast('已移动');
    });
    ui.ft.appendChild(btn);
  }

  function mountMusicBtn() {
    var tools = document.querySelector('[data-mpanel="lib"] .sm-tools');
    if (!tools || $('music-manage-v79')) return;
    var b = mk('button', 'sm-tool', '管理音乐');
    b.id = 'music-manage-v79';
    b.type = 'button';
    b.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h10M4 12h16M4 18h7"/><path d="M17 4l2 2-2 2"/></svg>管理音乐';
    on(b, 'click', function (e) { e.stopPropagation(); openMusicManager(); });
    tools.appendChild(b);
  }

  /* ============================================================
     八、启动
     ============================================================ */
  function boot() {
    applyXnSet();
    applyOffsets();
    applyBlocks();
    wrapIconMenu();
    mountDecorBtn();
    mountMusicBtn();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 600);
  setTimeout(boot, 1600);
  setTimeout(boot, 3000);
  setInterval(function () { mountDecorBtn(); mountMusicBtn(); applyXnSet(); }, 3000);

  document.addEventListener('contact-switched', function () {
    setTimeout(function () { applyOffsets(); applyBlocks(); }, 400);
  });
  document.addEventListener('decor-exited', function () { setTimeout(applyOffsets, 200); });
  window.addEventListener('load', function () { setTimeout(function () { applyOffsets(); applyBlocks(); }, 700); });
})();

</script>
<style id="v80-css">
/* ===== v80 =====
   1) 心讯：翻牌牌桌（参考言字卡：消息＝卡牌，TA 的牌背面「言」落桌后翻面）
   2) 日记本：浏览器缩成小窗（矮视口）时整个界面可滚动；全屏仍锁定、只有成长路线滚动
   3) 弹层高度改用可视视口计算，手机小窗里「今天的全部记录」等关闭键不再被顶出屏幕
*/
/* ---- 2. 日记本小窗可滚 ---- */
@media (max-height:640px), (max-width:352px){
  #qd-diary .qd-dwrap{overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;scrollbar-width:none}
  #qd-diary .qd-dwrap::-webkit-scrollbar{display:none}
  #qd-diary .qd-dbody{flex:none;overflow:visible}
  #qd-diary .qd-list{overflow:visible;flex:none}
}
/* ---- 3. 弹层高度：按可视视口算，小窗里 ✕ 一直够得着 ---- */
.qd-sheet{padding-top:12px}
.qd-sheet-box{max-height:calc(100% - 30px)}
#qd-edit.qd-epop .qd-sheet-box{max-height:calc(100% - 26px)}
.qd-view-in{max-height:calc(100% - 22px)}
.qd-view-card{max-height:calc(100dvh - 128px)}
.qd-gal-box{max-height:calc(100% - 24px)}
.qd-cat-box{max-height:calc(100% - 24px)}
.qd-pick-box{max-height:calc(100% - 24px)}
.xns-sheet{max-height:calc(100% - 26px)}
.mg-box{max-height:calc(100% - 24px)}
/* ---- 「今天的全部记录」：批注标签与记录并排 ---- */
.qd-dayrow.qd-daynote .x{display:flex;align-items:flex-start;gap:7px;flex-wrap:wrap}
/* v80：四象限主格子标题里的小图标（与日记本成长路线同款） */
.qd-cell-ico{margin-right:1px;vertical-align:middle;width:16px;height:16px}
.qd-cell-ico svg{width:15px;height:15px}
.qd-note-tag{flex:none;font-size:9px;line-height:1;padding:3px 7px;border-radius:3px 3px 8px 3px;
  background:linear-gradient(160deg,#fff4cc,#ffe9ae);color:#6d5320;font-weight:700;letter-spacing:.4px;
  box-shadow:0 2px 6px rgba(120,90,40,.16);transform:rotate(-1.6deg)}
[data-theme="dark"] .qd-note-tag{background:linear-gradient(160deg,#3d3520,#2b2416);color:#ece0b8}

/* ---- 1. 心讯翻牌牌桌 ---- */
#page-xinxun .xn-body{overflow:hidden;justify-content:flex-end}
#xnTable2{flex:1 1 auto;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;
  display:flex;flex-direction:column;align-items:stretch;padding:4px 16px 8px;scrollbar-width:none}
#xnTable2::-webkit-scrollbar{display:none}
.xn-day2{align-self:center;flex:none;margin:10px 0 6px;padding:3px 14px;border-radius:999px;
  background:rgba(0,0,0,.05);color:#8a8a8a;font-size:10px;letter-spacing:.2px}
[data-theme="dark"] .xn-day2{background:rgba(255,255,255,.08);color:#bbb}
.xn-dc2{position:relative;width:158px;flex:none;min-height:88px;perspective:820px;cursor:pointer;
  transform:rotate(var(--rot,0deg));transform-origin:50% 50%;
  -webkit-user-select:none;user-select:none;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.xn-dc2.me{align-self:flex-start}
.xn-dc2.ta{align-self:flex-end}
.xn-dc2.in{animation:xnDc2In .44s cubic-bezier(.2,.8,.2,1) backwards}
@keyframes xnDc2In{from{opacity:0;transform:translateY(-16px) scale(.93) rotate(var(--rot,0deg))}to{opacity:1;transform:rotate(var(--rot,0deg))}}
.xn-dc2 .in3{display:grid;grid-template:1fr/1fr;width:100%;transform-style:preserve-3d;
  transition:transform .52s cubic-bezier(.2,.8,.2,1)}
.xn-dc2.up .in3{transform:rotateY(180deg)}
.xn-dc2[data-face="bk"] .fr{visibility:hidden}
.xn-dc2[data-face="fr"] .bk{visibility:hidden}
.xn-dc2.flipping[data-face="bk"] .fr,
.xn-dc2.flipping[data-face="bk"] .bk{visibility:visible}
.xn-dc2 .fc{grid-area:1/1;position:relative;border-radius:4px;overflow:hidden;min-height:88px;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  background:#fff;border:1px solid rgba(0,0,0,.10);
  box-shadow:0 1px 2px rgba(0,0,0,.05),0 8px 20px rgba(0,0,0,.07)}
[data-theme="dark"] .xn-dc2 .fc{background:#242426;border-color:rgba(255,255,255,.14)}
.xn-dc2 .fr{transform:rotateY(180deg);display:flex;flex-direction:column;padding:10px 12px 8px;min-height:88px}
.xn-dc2 .edge{position:absolute;inset:5px;border:1px solid rgba(0,0,0,.08);border-radius:2px;pointer-events:none}
[data-theme="dark"] .xn-dc2 .edge{border-color:rgba(255,255,255,.10)}
.xn-dc2 .tx{position:relative;font-size:12.2px;line-height:1.55;word-break:break-word;color:#222;text-align:left;white-space:pre-wrap}
[data-theme="dark"] .xn-dc2 .tx{color:#eee}
.xn-dc2 .meta{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-top:auto;padding-top:6px;
  font-size:8.5px;letter-spacing:.08em;color:rgba(0,0,0,.42)}
[data-theme="dark"] .xn-dc2 .meta{color:rgba(255,255,255,.45)}
.xn-dc2 .meta .tm{white-space:nowrap;font-variant-numeric:tabular-nums}
.xn-dc2 .bk{grid-area:1/1;display:grid;place-items:center;background:#f3f1ee;border:1px solid rgba(0,0,0,.10);border-radius:4px;
  box-shadow:0 1px 2px rgba(0,0,0,.05),0 8px 20px rgba(0,0,0,.07)}
[data-theme="dark"] .xn-dc2 .bk{background:#2a2a2d;border-color:rgba(255,255,255,.14)}
.xn-dc2 .bk b{font-family:"Songti SC","SimSun",serif;font-size:17px;font-weight:500;letter-spacing:.06em;
  width:40px;height:40px;border:1px solid rgba(0,0,0,.4);border-radius:50%;display:grid;place-items:center;color:#333;background:#fff}
[data-theme="dark"] .xn-dc2 .bk b{background:#333;color:#eee;border-color:rgba(255,255,255,.4)}
.xn-dc2 .bk-tm{position:absolute;right:9px;bottom:5px;font-size:8px;color:rgba(0,0,0,.34);font-variant-numeric:tabular-nums}
[data-theme="dark"] .xn-dc2 .bk-tm{color:rgba(255,255,255,.38)}
.xn-empty2{align-self:center;text-align:center;color:#b5b5b5;font-size:11px;line-height:1.9;padding:26px 18px}
</style>
<script id="v80-js">
/* ================= v80 =================
   1) 心讯：翻牌牌桌（参考言字卡 xinxun 实现）＋ 返回键兜底
   2) 桌面：阅读室图标偏移一次性复位（屏幕适配误存的偏移清掉）
*/
(function () {
  'use strict';
  function $(id) { return document.getElementById(id); }
  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function partner() {
    try { var s = window.activeStore && window.activeStore(); var n = s && s.get && s.get('lbl-partner'); if (n) return n; } catch (e) {}
    return 'TA';
  }

  /* ---------- 2. 阅读室偏移复位（一次性） ---------- */
  try {
    if (!localStorage.getItem('mochi-fix-read-offset-v80')) {
      var OFIX = JSON.parse(localStorage.getItem('mochi-desk-offsets-v79') || '{}');
      if (OFIX && typeof OFIX === 'object') {
        var chF = false;
        Object.keys(OFIX).forEach(function (g) {
          if (OFIX[g] && OFIX[g].reading) { delete OFIX[g].reading; chF = true; }
        });
        if (chF) localStorage.setItem('mochi-desk-offsets-v79', JSON.stringify(OFIX));
      }
      localStorage.setItem('mochi-fix-read-offset-v80', '1');
    }
  } catch (e0) {}
  function clearReadTransform() {
    try {
      var a = document.querySelector('.app[data-app="reading"]');
      if (a) { a.style.transform = ''; a.classList.remove('desk-moved'); }
    } catch (eT) {}
  }
  setTimeout(clearReadTransform, 400);
  setTimeout(clearReadTransform, 2000);

  /* ---------- 1-1. 心讯返回键兜底（用户直派「心讯的返回键无反应」） ---------- */
  document.addEventListener('click', function (e) {
    var b = e.target && e.target.closest ? e.target.closest('#xnBack') : null;
    if (!b) return;
    var pg = $('page-xinxun');
    if (!pg || pg.hidden) return;
    e.preventDefault(); e.stopPropagation();
    try { if (window.__yzxClosePage) { window.__yzxClosePage(pg); return; } } catch (e1) {}
    pg.classList.remove('full');
    document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
    var back = $('page-phone');
    if (back) {
      back.hidden = false;
      var tb = document.querySelector('.tabbar'); if (tb) tb.hidden = false;
      var ph = document.querySelector('.phone'); if (ph) ph.classList.remove('no-statusbar');
    }
  }, true);

  /* ---------- 1-2. 心讯翻牌牌桌 ---------- */
  var FLIP_MS = 520;
  var xnFlipped = {};      /* key -> 1 已翻过面的牌（本次会话内记忆，避免重复动画） */
  var xnPainted = 0;       /* 已画到第几条 */
  var xnTimer2 = null;

  function xnMsgs() {
    var arr = [];
    try { arr = (window.getChatMsgs ? window.getChatMsgs() : []) || []; } catch (e) { arr = []; }
    return arr.filter(function (m) {
      if (!m || m.special || m.retracted) return false;
      var t = m.text;
      if (typeof t !== 'string' || !t.trim()) return false;
      if (t.length > 300) return false;
      if (t.indexOf('data:') === 0 || t.indexOf('@@m:') === 0 || t.indexOf('http') === 0) return false;
      if (t.indexOf('|||') >= 0) return false;
      return true;
    }).slice(-60);
  }
  function xnKey(m) {
    return (m.ts || 0) + '|' + (m.side || '') + '|' + String(m.text).slice(0, 48);
  }
  function pad2(n) { return n < 10 ? '0' + n : '' + n; }
  function xnHMS(ms) { var d = new Date(ms || Date.now()); return pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds()); }
  function xnDayLabel(ms) {
    var d = new Date(ms || Date.now()), t = new Date();
    var same = function (a, b) { return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); };
    if (same(d, t)) return '今天';
    var y = new Date(t.getTime() - 86400000);
    if (same(d, y)) return '昨天';
    return (d.getMonth() + 1) + '月' + d.getDate() + '日';
  }
  function xnCardEl(m, idx) {
    var by = m.side === 'out' ? 'me' : 'ta';
    var base = by === 'me' ? -2.4 : 2.4;
    var rot = (base + (((idx * 37) % 9) - 4) * 0.55).toFixed(2);
    var el = document.createElement('div');
    el.className = 'xn-dc2 ' + by;
    el.style.setProperty('--rot', rot + 'deg');
    el.setAttribute('data-k', xnKey(m));
    var who = by === 'me' ? '你 出' : (partner() + ' 说');
    el.innerHTML =
      '<div class="in3">' +
        '<div class="bk"><b>言</b><span class="bk-tm">' + xnHMS(m.ts) + '</span></div>' +
        '<div class="fc fr"><span class="edge"></span><div class="tx">' + esc(m.text) + '</div>' +
          '<div class="meta"><span class="who">' + esc(who) + '</span><span class="tm">' + xnHMS(m.ts) + '</span></div>' +
        '</div>' +
      '</div>';
    var up = by === 'me' || !!xnFlipped[xnKey(m)];
    el.classList.toggle('up', up);
    el.setAttribute('data-face', up ? 'fr' : 'bk');
    el.addEventListener('click', function () {
      if (el.classList.contains('up')) return;
      xnFlipped[el.getAttribute('data-k')] = 1;
      el.classList.add('up');
      el.classList.add('flipping');
      setTimeout(function () { el.classList.remove('flipping'); if (el.isConnected) el.setAttribute('data-face', 'fr'); }, FLIP_MS);
    });
    return el;
  }
  function xnTableEnsure() {
    var body = document.querySelector('#page-xinxun .xn-body');
    if (!body) return null;
    var t = $('xnTable2');
    if (!t) {
      t = document.createElement('div');
      t.id = 'xnTable2';
      body.insertBefore(t, body.firstChild);
    }
    return t;
  }
  function xnTableSnap() {
    var t = $('xnTable2');
    if (t) t.scrollTop = t.scrollHeight;
  }
  function xnTableRender(animateTail) {
    var t = xnTableEnsure();
    if (!t) return;
    var msgs = xnMsgs();
    t.innerHTML = '';
    if (!msgs.length) {
      t.innerHTML = '<div class="xn-empty2">' + esc(partner()) + ' 的心讯会落在这里的牌桌上<br>底下「TA 在想什么」点一张推过去，牌就会翻给你看</div>';
      xnPainted = 0;
      return;
    }
    var lastDay = '', taIdx = [];
    msgs.forEach(function (m, i) {
      var day = xnDayLabel(m.ts);
      if (day !== lastDay) {
        var dEl = document.createElement('div');
        dEl.className = 'xn-day2';
        dEl.textContent = day;
        t.appendChild(dEl);
        lastDay = day;
      }
      var el = xnCardEl(m, i);
      if (m.side !== 'out') taIdx.push(el);
      if (i >= xnPainted) el.classList.add('in');
      t.appendChild(el);
    });
    xnPainted = msgs.length;
    /* 最近几张 TA 的牌：落桌后依次翻面（参考视频的翻牌节奏） */
    var tail = animateTail === false ? [] : taIdx.slice(-4);
    taIdx.slice(0, Math.max(0, taIdx.length - 4)).forEach(function (el) {
      var k = el.getAttribute('data-k');
      xnFlipped[k] = 1;
      el.classList.add('up');
      el.setAttribute('data-face', 'fr');
    });
    tail.forEach(function (el, i) {
      var k = el.getAttribute('data-k');
      if (xnFlipped[k]) return;
      setTimeout(function () {
        if (!el.isConnected || el.classList.contains('up')) return;
        xnFlipped[k] = 1;
        el.classList.add('up');
        el.classList.add('flipping');
        setTimeout(function () { el.classList.remove('flipping'); if (el.isConnected) el.setAttribute('data-face', 'fr'); xnTableSnap(); }, FLIP_MS);
      }, 500 + i * 340);
    });
    xnTableSnap();
  }
  function xnTableTick() {
    var pg = $('page-xinxun');
    if (!pg || pg.hidden) return;
    var n = xnMsgs().length;
    if (n !== xnPainted) xnTableRender(true);
  }
  /* 包一层 __xnOpen：打开心讯时顺带把牌桌画好、启动轮询 */
  var _xnOpen0 = window.__xnOpen;
  window.__xnOpen = function () {
    if (typeof _xnOpen0 === 'function') { try { _xnOpen0(); } catch (e2) {} }
    setTimeout(function () { xnTableRender(true); }, 60);
    if (!xnTimer2) xnTimer2 = setInterval(xnTableTick, 2500);
  };
})();
</script>
<script>/* inline: desk-icons-v81.js */
/* v81（用户直派）：桌面第一页新增图标——
   ① 四象限 ② 日历 ③ 心讯
   （v92r：原第一页阅读室图标 read2 已按用户要求下架并清理）
   key 说明：qd / xinxun 复用各自模块既有的点击监听；cal1 是本模块
   新加的入口键（避免与第三页日历的 data-app 重复，防止
   「图标顺序恢复」按 key 认领时把别的页图标搬走）。 */
(function () {
try {
  if (window.__mochiLoaded) window.__mochiLoaded.push("desk-icons-v81.js");
  var ICONS = {
    qd: '<svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="7.2" height="7.2" rx="1.6"/><rect x="13.3" y="3.5" width="7.2" height="7.2" rx="1.6"/><rect x="3.5" y="13.3" width="7.2" height="7.2" rx="1.6"/><rect x="13.3" y="13.3" width="7.2" height="7.2" rx="1.6"/></svg>',
    cal1: '<svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="2.2"/><path d="M3.5 9.6h17M8.2 2.8v4.2M15.8 2.8v4.2"/></svg>',
    xinxun: '<svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 6.8A2.3 2.3 0 016.8 4.5h10.4a2.3 2.3 0 012.3 2.3v7a2.3 2.3 0 01-2.3 2.3h-7.1l-3.6 3.2c-.6.5-1.5.1-1.5-.7v-2.5a2.3 2.3 0 01-.5-1.3z"/><path fill="#111111" stroke="none" d="M12 12.6s-2.8-1.7-2.8-3.5c0-1.1.9-1.9 1.9-1.9.7 0 1.1.3 1.4.9.3-.6.7-.9 1.4-.9 1 0 1.9.8 1.9 1.9 0 1.8-2.8 3.5-2.8 3.5z"/></svg>'
  };
  var NAMES = { qd: '四象限', cal1: '日历', xinxun: '心讯' };

  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }

  function mount() {
    /* v92r（用户直派）：第一页阅读室图标（read2）已下架——
       清掉可能残留的旧节点，并把 'app-read2' 从已保存的桌面布局记忆里剔除 */
    document.querySelectorAll('.app[data-app="read2"]').forEach(function (n) { if (n.parentNode) n.parentNode.removeChild(n); });
    try { if (typeof syncDeskLayout === 'function') syncDeskLayout(null, ['app-read2']); } catch (e) {}
    var grid = document.querySelector('.app-grid[data-app="main"]');
    if (!grid) return;
    Object.keys(ICONS).forEach(function (k) {
      if (grid.querySelector('.app[data-app="' + k + '"]')) return;
      if (document.querySelector('.app[data-app="' + k + '"]')) return;
      var a = document.createElement('div');
      a.className = 'app';
      a.setAttribute('data-app', k);
      a.setAttribute('data-desk-widget', 'app-' + k);
      a.innerHTML = '<div class="app-ico">' + ICONS[k] + '</div><div class="app-name">' + NAMES[k] + '</div>';
      grid.appendChild(a);
    });
  }

  function showPageEl(pg) {
    if (!pg) return;
    document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
    pg.hidden = false;
  }

  document.addEventListener('click', function (e) {
    var ph = document.getElementById('page-phone');
    if (ph && ph.classList.contains('decor-on')) return; /* 整理模式交给图标设置 */
    var a = e.target.closest && e.target.closest('.app[data-app]');
    if (!a) return;
    var grid = a.closest('.app-grid');
    if (grid && grid.classList.contains('editing')) return;
    var k = a.getAttribute('data-app');
    if (k === 'qd') {
      e.preventDefault(); e.stopPropagation();
      try { window.__qd.open(); } catch (err) { toast('四象限还没加载好，稍后再点'); }
    } else if (k === 'cal1') {
      e.preventDefault(); e.stopPropagation();
      if (typeof window.__calOpen === 'function') { try { window.__calOpen(); } catch (err) {} }
      else showPageEl(document.getElementById('page-calendar'));
    }
    /* xinxun 走 extras-yz.js 既有监听（window.__xnOpen），这里不重复处理 */
  }, true);

  function boot() { try { mount(); } catch (e) {} }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  setTimeout(boot, 1200);
  setTimeout(boot, 3000);
} catch (e) { try { console.error('[desk-icons-v81]', e && e.message); } catch (x) {} }
})();
</script>
<script>/* v86：输入可靠性 + 浮层防残留（用户直派「无法在任何功能和界面输入文字和 emoji」） */
(function () {
  'use strict';

  /* ============================================================
     一、底部浮层不再「永久残留」
     「组件 → 调整图片位置」「图标 → 调整图片位置」两个面板都是
     position:fixed;bottom:0;z-index:96，且只有面板自己的按钮能关。
     用户点别处/进别的页面后面板仍在，整条底部（含输入栏、软键盘区）
     都被它盖住 —— 表现就是「什么界面都点不进输入框」。
     这里补齐自动收起：点面板外、打开任何弹窗、切页面/点图标、按 Esc。
     ============================================================ */
  var PANELS = ['card-fit-panel', 'icon-fit-panel'];

  function panelShown(p) {
    try {
      if (!p) return false;
      var cs = getComputedStyle(p);
      return cs.display !== 'none' && cs.visibility !== 'hidden' && p.getBoundingClientRect().height > 0;
    } catch (e) { return false; }
  }

  function hidePanels() {
    var hid = false;
    PANELS.forEach(function (id) {
      var p = document.getElementById(id);
      if (p && getComputedStyle(p).display !== 'none') { p.style.display = 'none'; hid = true; }
    });
    if (hid) {
      try { window.__iconFitPanelOpen = false; } catch (e) {}
      try {
        Array.prototype.forEach.call(document.querySelectorAll('.app'), function (a) {
          if (a.style && a.style.boxShadow) a.style.boxShadow = '';
        });
      } catch (e2) {}
    }
    return hid;
  }
  window.__hideDeskFloatPanels = hidePanels;

  function outsideClick(e) {
    var any = false, inside = false;
    PANELS.forEach(function (id) {
      var p = document.getElementById(id);
      if (!panelShown(p)) return;
      any = true;
      if (p.contains(e.target)) inside = true;
    });
    if (any && !inside) hidePanels();
  }
  document.addEventListener('pointerdown', outsideClick, true);
  document.addEventListener('mousedown', outsideClick, true);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') hidePanels();
  }, true);

  /* 打开任何弹窗（modal-mask 显形）时先收起浮层，避免两层叠在一起 */
  try {
    var mm = document.getElementById('modal-mask');
    if (mm && window.MutationObserver) {
      new MutationObserver(function () {
        try {
          if (!mm.hidden && getComputedStyle(mm).display !== 'none') hidePanels();
        } catch (e) {}
      }).observe(mm, { attributes: true, attributeFilter: ['hidden', 'style', 'class'] });
    }
  } catch (e) {}

  /* 切页面 / 点图标 / 点装修栏时收起 */
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t || !t.closest) return;
    if (t.closest('.app') || t.closest('.tab') || t.closest('.tabbar') || t.closest('.decor-bar')) hidePanels();
  }, true);

  /* ============================================================
     二、输入框抢回自己的手势
     桌面图标/组件/分组都挂了拖拽与长按监听，命中测试粗的地方会
     把落在输入框上的 pointerdown / touchstart 当成拖拽起点并
     preventDefault —— 移动端被 preventDefault 的手势不会再聚焦，
     软键盘也就弹不出来。这里让文本输入框在第一跳就截住事件。
     ============================================================ */
  var TEXT_INPUT_TYPES = {
    text: 1, search: 1, url: 1, tel: 1, email: 1, password: 1, number: 1,
    date: 1, 'datetime-local': 1, month: 1, time: 1, week: 1
  };

  function isTextEditable(el) {
    if (!el || !el.tagName) return false;
    var tag = el.tagName;
    if (tag === 'TEXTAREA') return true;
    if (tag === 'INPUT') {
      var ty = String(el.type || 'text').toLowerCase();
      return !!TEXT_INPUT_TYPES[ty];
    }
    return el.isContentEditable === true;
  }

  ['pointerdown', 'touchstart', 'mousedown'].forEach(function (ev) {
    document.addEventListener(ev, function (e) {
      if (!isTextEditable(e.target)) return;
      try { e.stopPropagation(); } catch (err) {}
    }, true);
  });

  /* 触摸抬手 / 点击后仍未聚焦就补一次 focus
     （个别 WebView 点 input 不主动聚焦，或点在了输入框边缘的空白处） */
  function ensureFocus(t) {
    if (!t || !isTextEditable(t) || t.disabled || t.readOnly) return;
    if (document.activeElement === t) return;
    try { t.focus({ preventScroll: true }); } catch (err) {
      try { t.focus(); } catch (e2) {}
    }
  }
  document.addEventListener('touchend', function (e) { ensureFocus(e.target); }, true);
  document.addEventListener('click', function (e) { ensureFocus(e.target); }, true);

  /* ============================================================
     三、可编辑元素强制可选中
     #page-phone 整体是 user-select:none，老代码只为聊天输入单独放开过；
     弹窗、日记本、四象限等处的可编辑区在不同 WebView 里会被继承成不可选，
     表现为「点得进去、光标不进字」。这里统一兜底。
     ============================================================ */
  try {
    var st = document.createElement('style');
    st.id = 'v86-input-guard';
    st.textContent =
      'input,textarea,select,[contenteditable="true"],[contenteditable=""]{' +
        '-webkit-user-select:text!important;user-select:text!important;' +
        '-webkit-touch-callout:default!important;pointer-events:auto!important}' +
      '.desk-move-mode input,.desk-move-mode textarea,.desk-move-mode [contenteditable="true"],' +
      '.decor-on input,.decor-on textarea,.decor-on [contenteditable="true"]{touch-action:auto!important}';
    document.head.appendChild(st);
  } catch (e) {}
})();
</script>
  <span id="mochi-html-eof" hidden aria-hidden="true"></span>
<!-- __MOCHI_EOF__ -->
<style>/* v89：桌面右上角悬浮播放小框 */
#desk-mini-player{position:absolute;top:48px;right:12px;z-index:30;display:flex;align-items:center;gap:7px;padding:7px 9px 7px 12px;border-radius:999px;background:rgba(255,255,255,.85);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:0 4px 16px rgba(0,0,0,.14);border:1px solid rgba(0,0,0,.06);max-width:72%;user-select:none;-webkit-user-select:none;touch-action:manipulation}
#desk-mini-player[hidden]{display:none}
#desk-mini-player .dmp-note{font-size:12px;color:#999;flex:none}
#desk-mini-player .dmp-name{display:flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;color:#222;white-space:nowrap;overflow:hidden;max-width:110px;cursor:pointer}
#desk-mini-player .dmp-name svg{width:12px;height:12px;flex:none;color:#888}
#desk-mini-player button{border:0;background:transparent;padding:3px;display:flex;align-items:center;justify-content:center;color:#111;cursor:pointer;flex:none}
#desk-mini-player button svg{width:14px;height:14px}
#desk-mini-player .dmp-play svg{width:17px;height:17px}
#desk-mini-player.playing .dmp-note{color:#111;animation:dmpPulse 1.1s ease-in-out infinite}
@keyframes dmpPulse{0%,100%{opacity:.4}50%{opacity:1}}
[data-theme="dark"] #desk-mini-player{background:rgba(30,30,32,.85);border-color:rgba(255,255,255,.1)}
[data-theme="dark"] #desk-mini-player .dmp-name{color:#eee}
[data-theme="dark"] #desk-mini-player button{color:#f0f0f0}
[data-theme="dark"] #desk-mini-player .dmp-note{color:#888}
</style>
<script>/* v89：播放器封面页功能条接线 + 桌面右上角悬浮播放小框 */
if (window.__mochiLoaded) window.__mochiLoaded.push("v89.js");
(function () {
try {
  /* ---------- 1. 封面页顶部功能条：复用歌词页既有按钮（点镜像按钮＝点原按钮） ---------- */
  function mirrorClick(mid, cid) {
    var c = document.getElementById(cid);
    if (!c) return;
    c.addEventListener('click', function (e) {
      try { e.stopPropagation(); } catch (x) {}
      var m = document.getElementById(mid);
      if (m) m.click();
    });
  }
  mirrorClick('npLyricTa', 'npLyricTaCov');   /* TA 也摘一句 */
  mirrorClick('npLyricBtn', 'npLyricOpenCov');/* 去歌词页 */
  mirrorClick('npFav', 'npFavCov');           /* 收藏 */
  /* 收藏状态镜像：npFav 的 on 类 / npFavIco 的 fill 属性变化时同步到封面条 */
  (function () {
    var fav = document.getElementById('npFav'), ico = document.getElementById('npFavIco');
    var fc = document.getElementById('npFavCov'), fico = document.getElementById('npFavIcoCov');
    if (!fav || !fc) return;
    var sync = function () {
      fc.classList.toggle('on', fav.classList.contains('on'));
      var t = fc.querySelector('span'); if (t) t.textContent = fav.classList.contains('on') ? '已收藏' : '收藏';
      if (fico && ico) fico.setAttribute('fill', ico.getAttribute('fill') || 'none');
    };
    try { new MutationObserver(sync).observe(fav, { attributes: true, attributeFilter: ['class'] }); } catch (e1) {}
    if (ico) { try { new MutationObserver(sync).observe(ico, { attributes: true, attributeFilter: ['fill'] }); } catch (e2) {} }
    sync();
    setInterval(sync, 900); /* 兜底：状态总对得上 */
  })();

  /* ---------- 2. 桌面右上角悬浮播放小框 ---------- */
  var ph = document.getElementById('page-phone');
  if (ph && !document.getElementById('desk-mini-player')) {
    var box = document.createElement('div');
    box.id = 'desk-mini-player';
    box.innerHTML =
      '<span class="dmp-note">♪</span>' +
      '<span class="dmp-name">未在播放</span>' +
      '<button class="dmp-play" type="button" aria-label="播放/暂停"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg></button>' +
      '<button class="dmp-next" type="button" aria-label="下一首"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>';
    ph.appendChild(box);
    var nameEl = box.querySelector('.dmp-name');
    var noteEl = box.querySelector('.dmp-note');
    var playBtn = box.querySelector('.dmp-play');
    var ICO_PLAY = '<path d="M8 5.5v13l11-6.5z"/>';
    var ICO_PAUSE = '<path d="M7 5.5h3.5v13H7zM13.5 5.5H17v13h-3.5z"/>';
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function editOn() {
      try {
        if (ph.classList.contains('decor-on') || ph.classList.contains('desk-move-mode')) return true;
        var gs = document.querySelectorAll('.app-grid');
        for (var i = 0; i < gs.length; i++) { if (gs[i].classList.contains('editing')) return true; }
      } catch (e) {}
      return false;
    }
    function yz() { return window.__yzMusic || null; }
    function tick() {
      try {
        var m = yz();
        var playing = !!(m && m.playing());
        var vis = ph && !ph.hidden;
        /* v91：悬浮播放小框受「播放器组件右上角悬浮开关」控制（dmp-on，默认开） */
        var dmpOn = true;
        try { var _s91 = window.xyStore && window.xyStore('xy-home-v2'); if (_s91 && String(_s91.get('dmp-on') || '1') === '0') dmpOn = false; } catch (_e91) {}
        var show = vis && !editOn() && dmpOn;
        box.hidden = !show;
        if (!show) return;
        var cur = m ? m.current() : null;
        if (cur) {
          noteEl.style.display = 'none';
          nameEl.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2v11"/><circle cx="6.5" cy="18" r="2.6"/><circle cx="16.5" cy="15" r="2.6"/></svg>' + esc(cur.name || '未在播放');
        } else {
          noteEl.style.display = '';
          nameEl.textContent = '未在播放';
        }
        playBtn.querySelector('svg').innerHTML = playing ? ICO_PAUSE : ICO_PLAY;
        box.classList.toggle('playing', playing);
      } catch (e) {}
    }
    function startDefault() {
      try {
        var m = yz(); if (!m) return;
        var lib = m.lib();
        if (lib && lib.length) m.play(lib[0].id);
        else toast('先去曲库添加一首歌');
      } catch (e) {}
    }
    playBtn.addEventListener('click', function (e) {
      try { e.stopPropagation(); } catch (x) {}
      var m = yz(); if (!m) return;
      if (m.current()) m.toggle(); else startDefault();
    });
    box.querySelector('.dmp-next').addEventListener('click', function (e) {
      try { e.stopPropagation(); } catch (x) {}
      var m = yz(); if (!m) return;
      if (m.current()) m.next(); else startDefault();
    });
    nameEl.addEventListener('click', function () {
      try { if (window.__npOpen) window.__npOpen(true); } catch (e) {}
    });
    setInterval(tick, 700);
    tick();
    try { document.querySelectorAll('.page').forEach(function (p) { new MutationObserver(tick).observe(p, { attributes: true, attributeFilter: ['hidden'] }); }); } catch (e3) {}
    try { ph.addEventListener('classchange', tick); } catch (e4) {}
    setInterval(function () { if (!ph.hidden && editOn() !== box.__lastEdit) { box.__lastEdit = editOn(); tick(); } }, 500);
  }
} catch (eX) { try { console.error('[v89]', eX && eX.message); } catch (y) {} }
})();
</script>

<script>/* v90：第一页日历隐藏 + 播放器封面锚点对齐歌词定点 / 换封面（milk 开屏已移除） */
if (window.__mochiLoaded) window.__mochiLoaded.push("v90.js");
(function () {
try {
  function st() { try { return window.xyStore('xy-home-v2'); } catch (e) { return null; } }

  /* ---------- 第一页「日历」图标（v81 注入的 cal1）一次性隐藏 ---------- */
  (function () {
    var s = st(); if (!s) return;
    if (s.get('v90-cal1-hidden') === '1') return;
    s.set('v90-cal1-hidden', '1');
    var h = [];
    try { h = JSON.parse(s.get('hidden-icons') || '[]'); } catch (e) { h = []; }
    if (Array.isArray(h) && h.indexOf('cal1') < 0) { h.push('cal1'); s.set('hidden-icons', JSON.stringify(h)); }
  })();
  /* v81 的图标是异步挂载的（1.2s / 3s 各补挂一次），隐藏要在挂载后再补一遍 */
  (function () {
    function applyCal1Hide() {
      try {
        var s = st(); if (!s) return;
        var h = []; try { h = JSON.parse(s.get('hidden-icons') || '[]'); } catch (e) { h = []; }
        if (!Array.isArray(h) || h.indexOf('cal1') < 0) return;
        document.querySelectorAll('.app[data-app="cal1"]').forEach(function (a) { a.style.display = 'none'; });
      } catch (e) {}
    }
    setTimeout(applyCal1Hide, 400);
    setTimeout(applyCal1Hide, 1300);
    setTimeout(applyCal1Hide, 3100);
  })();


  /* ================= 播放器：封面与歌词定点重合 + 「封面」上传 ================= */
  var npAnchorY = null;
  function npE(id) { return document.getElementById(id); }
  function npSyncAnchor() {
    var main = npE('npMain'), cov = npE('npCover'), lrc = npE('npLrc'), body = npE('npLrcBody');
    if (!main || !cov) return;
    /* v92l：彻底废弃「封面与歌词定点重合」的位移逻辑。
       旧代码用歌词区中心 Y 反复改写 npCover.style.marginTop（dataset.mt 累积），
       MutationObserver 又在 hidden/class 变化时反复触发，导致封面被越推越偏、
       「自己往上移动」盖住顶部功能条（收藏💓 / 封面 / 歌词按钮看不见）。
       现在封面回归正常流式布局，位置由 CSS 决定，不再被 JS 挪动。 */
    if (cov.dataset.mt) { delete cov.dataset.mt; cov.style.marginTop = ''; }
    return;
  }
  try {
    ['npMain', 'npLrc', 'page-now'].forEach(function (id) {
      var el = npE(id);
      if (el) new MutationObserver(function () { setTimeout(npSyncAnchor, 80); })
        .observe(el, { attributes: true, attributeFilter: ['hidden', 'class'] });
    });
    window.addEventListener('resize', npSyncAnchor);
    setTimeout(npSyncAnchor, 300);
  } catch (eO) {}

  var covBar = npE('npCovBar');
  if (covBar && !covBar.__v90) {
    covBar.__v90 = 1;
    var chip = document.createElement('button');
    chip.className = 'np-lrc-chip'; chip.id = 'npCoverUpCov'; chip.textContent = '封面'; chip.title = '自定义这首歌的封面';
    var lrcChip = npE('npLyricOpenCov');
    if (lrcChip) covBar.insertBefore(chip, lrcChip); else covBar.appendChild(chip);
    var inp = document.createElement('input');
    inp.type = 'file'; inp.accept = 'image/*'; inp.style.display = 'none';
    document.body.appendChild(inp);
    chip.addEventListener('click', function (e) { try { e.stopPropagation(); } catch (x) {} inp.value = ''; inp.click(); });
    inp.addEventListener('change', function () {
      var f = inp.files && inp.files[0]; if (!f) return;
      var rd = new FileReader();
      rd.onload = function () {
        var img = new Image();
        img.onload = function () {
          try {
            var long = 640, w, h;
            if (img.width >= img.height) { w = long; h = Math.round(img.height * long / img.width); }
            else { h = long; w = Math.round(img.width * long / img.height); }
            var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
            cv.getContext('2d').drawImage(img, 0, 0, w, h);
            var url;
            try { url = cv.toDataURL('image/jpeg', 0.85); } catch (eC) { url = rd.result; }
            var yz = window.__yzMusic, curTrack = yz && yz.current ? yz.current() : null;
            if (curTrack && yz.setCover && yz.setCover(curTrack.id, url)) {
              var c = npE('npCover');
              if (c) c.innerHTML = '<img src="' + url + '" alt="">';
              try { window.toast('封面已更新'); } catch (eT) {}
            } else {
              try { window.toast('先播放一首歌，再换它的封面'); } catch (eT2) {}
            }
          } catch (eE) { try { window.toast('这张图处理失败，换一张试试'); } catch (eT3) {} }
        };
        img.src = rd.result;
      };
      rd.readAsDataURL(f);
    });
  }
} catch (eX) { try { console.error('[v90]', eX && eX.message); } catch (y) {} }
})();
</script>

<script>/* v91：①组件卡片跟随深浅模式 ②播放器组件右上角悬浮开关 ③普通模式长按卡片弹设置 ④封面空态提示 */
if (window.__mochiLoaded) window.__mochiLoaded.push("v91.js");
(function () {
try {
  function st91() { try { return window.xyStore('xy-home-v2'); } catch (e) { return null; } }
  function toast91(msg) { try { (window.toast || function () {})(msg); } catch (e) {} }

  /* ---------- 1. 桌面小组件卡片：深色模式强制黑卡白字（浅色保持白卡黑字/用户自定义色） ---------- */
  var v91css = document.createElement('style');
  v91css.id = 'v91-css';
  v91css.textContent = [
    /* !important 压过「组件背景」写进 :root 内联的 --widget-bg，深色=黑卡；文字颜色本就跟随 --ink（深色自动白字） */
    'html[data-theme="dark"]{--widget-bg:#1e1e1e !important;}',
    /* 播放器组件右上角悬浮开关 */
    '#music-widget{position:relative;}',
    '#dmp-toggle{position:absolute;top:8px;right:10px;z-index:6;width:28px;height:28px;border-radius:999px;border:0;' +
      'background:rgba(127,127,127,.16);color:var(--ink,#111);display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;}',
    '#dmp-toggle svg{width:15px;height:15px;pointer-events:none;}',
    '#dmp-toggle.off{opacity:.4;}',
    '#dmp-toggle:active{transform:scale(.92);}',
    /* 封面空态提示 */
    '#npCovHint{font-size:12px;line-height:1.7;color:#b9b9b9;text-align:center;padding:0 16px;pointer-events:none;}',
    '#npCovHint b{display:block;font-size:13px;font-weight:600;color:#a9a9a9;margin-bottom:2px;}',
    '[data-theme="dark"] #npCovHint{color:#8a8a8a;}[data-theme="dark"] #npCovHint b{color:#9a9a9a;}'
  ].join('\n');
  document.head.appendChild(v91css);

  /* ---------- 2. 播放器组件右上角「悬浮」开关：控制桌面右上角悬浮播放小框 ---------- */
  var mw = document.getElementById('music-widget');
  if (mw && !document.getElementById('dmp-toggle')) {
    var tg = document.createElement('button');
    tg.id = 'dmp-toggle';
    tg.type = 'button';
    tg.title = '悬浮播放小框开关';
    tg.setAttribute('aria-label', '悬浮播放小框开关');
    tg.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
      '<rect x="3" y="5" width="18" height="13" rx="2.4"/><path d="M10 9.2l4.6 2.3L10 13.8z" fill="currentColor" stroke="none"/></svg>';
    mw.appendChild(tg);
    var syncTg = function () {
      var s = st91();
      var off = !!(s && String(s.get('dmp-on') || '1') === '0');
      tg.classList.toggle('off', off);
    };
    syncTg();
    tg.addEventListener('click', function (e) {
      try { e.stopPropagation(); } catch (x) {}
      var s = st91(); if (!s) return;
      var off = String(s.get('dmp-on') || '1') === '0';
      if (off) { s.remove('dmp-on'); toast91('悬浮播放小框已开启（桌面右上角）'); }
      else { s.set('dmp-on', '0'); toast91('悬浮播放小框已关闭'); }
      syncTg();
    });
    try { new MutationObserver(syncTg).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] }); } catch (e) {}
  }

  /* ---------- 3. 普通模式长按卡片 ≈ 装修模式点卡片：弹组件设置菜单（含组件颜色） ---------- */
  var ph91 = document.getElementById('page-phone');
  if (ph91 && !ph91.__v91lp) {
    ph91.__v91lp = 1;
    var lpTimer = null, lpX = 0, lpY = 0;
    var lpCancel = function () { if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; } };
    ph91.addEventListener('pointerdown', function (e) {
      try {
        if (e.button !== undefined && e.button !== 0) return;
        var t = e.target;
        if (!t || !t.closest) return;
        if (t.closest('button,input,label,a,select,textarea,.mw-progress,.np-lrc-sizes')) return;
        if (ph91.classList.contains('decor-on')) return; /* 装修模式单击已接管 */
        var card = t.closest('[data-card-bg]');
        if (!card) return;
        lpX = e.clientX; lpY = e.clientY;
        lpTimer = setTimeout(function () {
          lpTimer = null;
          window.__v91CardMenu = true;
          try { if (navigator.vibrate) navigator.vibrate(15); } catch (_v) {}
          card.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
          setTimeout(function () { window.__v91CardMenu = false; }, 80);
        }, 550);
      } catch (e2) {}
    }, { passive: true });
    ph91.addEventListener('pointermove', function (e) {
      if (lpTimer && (Math.abs(e.clientX - lpX) > 12 || Math.abs(e.clientY - lpY) > 12)) lpCancel();
    }, { passive: true });
    ph91.addEventListener('pointerup', lpCancel, { passive: true });
    ph91.addEventListener('pointercancel', lpCancel, { passive: true });
    ph91.addEventListener('scroll', lpCancel, { capture: true, passive: true });
  }

  /* ---------- 4. 播放页封面空态提示（有歌后 innerHTML 被正常封面接管，提示自动消失） ---------- */
  var cov91 = document.getElementById('npCover');
  if (cov91 && !cov91.firstChild && !document.getElementById('npCovHint')) {
    var hint = document.createElement('div');
    hint.id = 'npCovHint';
    hint.innerHTML = '<b>还没有封面</b>播放歌曲后显示封面 · 点上方「封面」可自定义，封面与歌词定点位置重合';
    cov91.appendChild(hint);
  }
} catch (eX) { try { console.error('[v91]', eX && eX.message); } catch (y) {} }
})();
</script>

<script>/* v92o：桌面横滑——标准翻页器（一次手势最多翻一页）
   v92j/v92k 放开惯性后，快速甩动能从第 1 页飞到第 3 页；用户要求改回真机桌面那种
   「不管多用力多快，一次滑动只到相邻页」。做法：touchmove 期间 preventDefault 接管
   （跟手 1:1），松手后按位移/速度判定目标是「相邻页」，缓动过去——原生惯性不再存在，
   所以永远不可能连翻两页。竖向意图（|dy|>|dx|）不接管，页面内上下滚动不受影响；
   装修/拖图标模式下不接管。吸附兜底（文档回正 / 巡逻 / 旋转）全部保留。 */
if (window.__mochiLoaded) window.__mochiLoaded.push("v92.js");
(function () {
try {
  var pages = document.getElementById('desktop-pages');
  if (!pages || pages.__v92snap) return;
  pages.__v92snap = 1;
  pages.style.scrollSnapType = 'none';
  function slides() { return Array.prototype.slice.call(pages.querySelectorAll('.page-slide')); }
  function targets() {
    var ss = slides(), arr = [];
    for (var i = 0; i < ss.length; i++) arr.push(ss[i].offsetLeft);
    return arr;
  }
  function editBusy() {
    try {
      var ph = document.getElementById('page-phone');
      if (ph && (ph.classList.contains('decor-on') || ph.classList.contains('desk-move-mode'))) return true;
      var gs = document.querySelectorAll('.app-grid');
      for (var i = 0; i < gs.length; i++) { if (gs[i].classList.contains('editing')) return true; }
    } catch (e) {}
    return false;
  }
  var lastScrollAt = 0, rafId = 0, debT = null, touching = false;
  /* ---------- 接管横滑：跟手 + 松手判相邻页 ---------- */
  var track = null;
  pages.addEventListener('touchstart', function (e) {
    touching = true;
    if (e.touches.length !== 1 || editBusy()) { track = null; return; }
    var t0 = e.touches[0];
    track = { x: t0.clientX, y: t0.clientY, sl: pages.scrollLeft, t: Date.now(), dir: null, lx: t0.clientX };
  }, { passive: true, capture: true });
  pages.addEventListener('touchmove', function (e) {
    if (!track || e.touches.length !== 1) return;
    var t0 = e.touches[0];
    var dx = t0.clientX - track.x, dy = t0.clientY - track.y;
    if (!track.dir) {
      if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return;
      track.dir = Math.abs(dx) > Math.abs(dy) ? 'h' : 'v';
      if (track.dir === 'v') { track = null; return; } /* 竖滑交还给页面自己滚 */
    }
    if (track.dir !== 'h') return;
    e.preventDefault(); /* 关键：阻断原生惯性，一次手势只可能翻一页 */
    pages.scrollLeft = track.sl - dx;
    track.lx = t0.clientX;
  }, { passive: false, capture: true });
  function endTouch(e) {
    touching = false;
    if (!track) return;
    var tr = track; track = null;
    if (tr.dir !== 'h') return;
    var ts = targets();
    if (!ts.length) return;
    var sl = pages.scrollLeft, start = 0, dist = 1e9;
    /* 关键：以「手势起点所在页」为基准——终点位置手指已经滑出去大半页了，
       若再叠加速度判定就会连翻两页；起点基准保证无论多用力都只到相邻页 */
    for (var i = 0; i < ts.length; i++) { var d = Math.abs(tr.sl - ts[i]); if (d < dist) { dist = d; start = i; } }
    var w = pages.clientWidth || 360;
    var passed = sl - ts[start];            /* 从起点页滑出去多少（>0＝向下一页） */
    var dx = (tr.lx != null ? tr.lx : e.changedTouches[0].clientX) - tr.x;
    var dt = Math.max(1, Date.now() - tr.t);
    var vel = dx / dt;                       /* px/ms：左滑（dx<0）＝翻下一页 */
    var target = start;
    if (passed > w * 0.28 || vel < -0.45) target = start + 1;
    else if (passed < -w * 0.28 || vel > 0.45) target = start - 1;
    target = Math.max(0, Math.min(ts.length - 1, target)); /* 相邻页封顶 */
    var want = ts[target];
    lastScrollAt = Date.now();
    if (Math.abs(sl - want) > 1) {
      try { pages.scrollTo({ left: want, behavior: 'smooth' }); }
      catch (eS) { pages.scrollLeft = want; }
    }
  }
  pages.addEventListener('touchend', endTouch, { passive: true, capture: true });
  pages.addEventListener('touchcancel', function () { touching = false; track = null; }, { passive: true, capture: true });
  function resnap(force) {
    try {
      /* 文档级横向偏移保险：整页被推走时拉回 */
      var de = document.documentElement, bd = document.body;
      if (de && de.scrollLeft !== 0) de.scrollLeft = 0;
      if (bd && bd.scrollLeft !== 0) bd.scrollLeft = 0;
      if (window.scrollX !== 0) window.scrollTo(0, window.scrollY || 0);
      if (touching || track) return;
      var ts = targets();
      if (!ts.length) return;
      var sl = pages.scrollLeft, best = 0, dist = 1e9;
      for (var i = 0; i < ts.length; i++) {
        var d = Math.abs(sl - ts[i]);
        if (d < dist) { dist = d; best = i; }
      }
      var want = ts[best];
      if (Math.abs(sl - want) > 1) {
        try { pages.scrollTo({ left: want, behavior: 'smooth' }); }
        catch (eS) { pages.scrollLeft = want; }
      }
    } catch (e) {}
  }
  /* 静止守望：缓动动画结束后对齐（程序平滑滚动期间不打断） */
  function watch() {
    cancelAnimationFrame(rafId);
    var t0 = Date.now();
    var tick = function () {
      if (touching || track) { rafId = requestAnimationFrame(tick); return; }
      if (Date.now() - lastScrollAt >= 280 || Date.now() - t0 > 5000) { resnap(true); return; }
      rafId = requestAnimationFrame(tick);
    };
    rafId = requestAnimationFrame(tick);
  }
  var t = null;
  pages.addEventListener('scroll', function () {
    lastScrollAt = Date.now();
    clearTimeout(t);
    t = setTimeout(function () { resnap(); }, 380);
  }, { passive: true });
  window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(function () { resnap(true); }, 180); });
  window.addEventListener('orientationchange', function () { clearTimeout(t); t = setTimeout(function () { resnap(true); }, 300); });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) setTimeout(function () { resnap(true); }, 220); });
  /* 进站头 10 秒内每 500ms 兜底回正一次，之后每 1.2 秒巡逻（巡逻只在静止时吸附） */
  var _n92 = 0;
  var _iv92 = setInterval(function () {
    _n92++;
    resnap(_n92 <= 4);
    if (_n92 >= 20) {
      clearInterval(_iv92);
      setInterval(function () { resnap(); }, 1200);
    }
  }, 500);
  setTimeout(function () { resnap(true); }, 300);
  setTimeout(function () { resnap(true); }, 1500);
} catch (eX) { try { console.error('[v92]', eX && eX.message); } catch (y) {} }
})();
</script>

<script>
/* v92e：开屏进站可靠性加固——真机上「双击进不去」的多重兜底：
   ① 整个开屏页（不只舞台层）都响应双击；② 右下角常驻「进入桌面」按钮；
   ③ 画面没真正出帧 8 秒 / 无论如何 12 秒后自动进站；④ URL 带 #desk 直接跳过开屏；⑤ 单击后轻提示「再点一下进入桌面」。 */
(function () {
  'use strict';
  function ready() {
    var pg = document.getElementById('page-opening');
    if (!pg || pg.__v92e) return;
    pg.__v92e = 1;
    function enter() {
      try {
        if (typeof window.opCloseScreen === 'function') { window.opCloseScreen(); return; }
        pg.hidden = true;
        document.querySelectorAll('.page').forEach(function (p) { if (p !== pg) p.hidden = true; });
        var ph = document.getElementById('page-phone'); if (ph) ph.hidden = false;
        var tb = document.querySelector('.tab[data-page="page-phone"]'); if (tb) tb.click();
      } catch (eE) {}
    }
    window.__mochiForceEnter = enter;
    /* ① 整页捕获双击（覆盖 toast、进度条、文字等一切区域） */
    var taps = [], hintT = null;
    pg.addEventListener('click', function (e) {
      if (pg.classList.contains('op-config')) return;
      if (e.target.closest && e.target.closest('.op-panel, #op-back, #op-cfg, #op-replay, .op-enter-btn')) return;
      var now = Date.now();
      taps.push(now);
      taps = taps.filter(function (t) { return now - t < 700; });
      if (taps.length >= 2) { taps = []; clearTimeout(hintT); enter(); return; }
      /* 单击后 700ms 内没有第二击 → 轻提示「再点一下进入桌面」（不挡操作） */
      clearTimeout(hintT);
      hintT = setTimeout(function () {
        try {
          var h = document.getElementById('v92e-hint');
          if (!h) {
            h = document.createElement('div');
            h.id = 'v92e-hint';
            h.style.cssText = 'position:absolute;left:50%;bottom:76px;transform:translateX(-50%);z-index:29;padding:8px 16px;border-radius:999px;background:rgba(0,0,0,.55);color:#fff;font-size:12.5px;letter-spacing:1px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);pointer-events:none;opacity:0;transition:opacity .25s;';
            h.textContent = '轻点出音乐 · 双击进桌面';
            pg.appendChild(h);
          }
          requestAnimationFrame(function () { h.style.opacity = '1'; });
          setTimeout(function () { h.style.opacity = '0'; }, 1600);
        } catch (eH) {}
      }, 700);
    }, true);
    /* ② 右下角「进入桌面」按钮 */
    var btn = document.createElement('button');
    btn.className = 'op-enter-btn';
    btn.setAttribute('aria-label', '进入桌面');
    btn.textContent = '进入桌面 ›';
    btn.style.cssText = 'position:absolute;right:14px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:30;padding:10px 18px;border-radius:999px;border:none;background:rgba(0,0,0,.55);color:#fff;font-size:13px;letter-spacing:1px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);box-shadow:0 4px 14px rgba(0,0,0,.25);';
    btn.addEventListener('click', function (e) { e.stopPropagation(); enter(); });
    pg.appendChild(btn);
    /* ③ 兜底进站（v92f）：8 秒时若画面没有真正渲染出帧（视频 readyState<2 或图片未解码，
       修复此前只查 .on 类被「加载中假象」绕过的问题）；12 秒无条件进站。
       v92y（用户要求）：音乐正在响（用户点了一下在听）就不自动进站，
       听多久都行，什么时候双击进桌面由用户自己决定 */
    function visualReallyPlaying() {
      try {
        var v = document.getElementById('op-video');
        var im = document.getElementById('op-image');
        if (v && v.classList.contains('on') && v.readyState >= 2 && !v.error) return true;
        if (im && im.classList.contains('on') && im.complete && im.naturalWidth > 0) return true;
      } catch (eV) {}
      return false;
    }
    function musicReallyPlaying() {
      /* v92y：音乐「真的出声了」= 正在播且未静音（用户点过屏幕解锁）。
         opAudio 在开屏模块闭包里，查 DOM 时只认开屏音乐元素（v93a：带 data-opid
         标记），别把聊天语音等无关 audio 误当成开屏音乐挡住自动进站 */
      try {
        var a = document.querySelector('audio[src][data-opid]') || document.querySelector('audio[src]');
        return !!(a && !a.paused && a.muted === false);
      } catch (eM) { return false; }
    }
    setTimeout(function () {
      if (pg.hidden || pg.classList.contains('op-config')) return;
      if (musicReallyPlaying()) return;
      if (!visualReallyPlaying()) {
        try { (window.toast || function () {})('开屏素材不可用，已自动进入桌面'); } catch (eT) {}
        enter();
      }
    }, 8000);
    setTimeout(function () {
      if (pg.hidden || pg.classList.contains('op-config')) return;
      if (musicReallyPlaying()) return;
      enter();
    }, 12000);
    /* ④ #desk 应急直达 */
    if (/desk/.test(location.hash)) enter();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready);
  else ready();
  setTimeout(ready, 600);
})();
</script>
<style>/* v92h：修复「加载聊天记录时界面边边缩起来」——所有应用通用的壳宽塌缩
   根因：html,body 都是 display:flex，body 作为 flex item 宽度由内容收缩决定；
   真机窄屏/force-mobile 下 .phone{width:100%} 相对 body，于是壳宽跟着页面内容
   的 max-content 走——聊天记录加载前后、各应用页打开时内容宽度一变，
   整个手机壳就跟着缩放（表现为左右边缘缩进、界面忽宽忽窄）。
   修复：给 body 固定 100% 宽，断开「内容宽度→壳宽」反馈；宽屏桌面端
   body 100% + 原有 justify-content:center 手机壳依旧居中，观感不变。 */
html, body { width:100% !important; }
/* 双保险（仅窄屏/真机/平板场景，桌面宽屏手机壳仍固定 390px 居中） */
@media (max-width:900px) { .phone { min-width:100%; } }
html.force-mobile .phone { min-width:100%; }
html.tablet .phone { min-width:100vw; }
</style>

<script>/* v92p：开屏搭配 · 数据管理（导出 / 导入）
   导出＝搭配设置（xy-home-v2:op-v61-cfg）+ 本机上传的视频/图片/音乐文件（IndexedDB op-media:*，转 base64 打包进一个 JSON 文件）；
   导入＝读回该 JSON，先还原设置再逐个还原媒体文件，完成后刷新页面让新搭配生效。 */
if (window.__mochiLoaded) window.__mochiLoaded.push("v92p.js");
(function () {
try {
  if (window.__v92pOp) return; window.__v92pOp = 1;
  var st = window.xyStore('xy-home-v2');
  var CFG_KEY = 'op-v61-cfg';
  function $(id) { return document.getElementById(id); }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function stamp() { var d = new Date(); return '' + d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate()); }

  function readAsDataURL(blob) {
    return new Promise(function (res, rej) {
      var fr = new FileReader();
      fr.onload = function () { res(String(fr.result)); };
      fr.onerror = function () { rej(new Error('read fail')); };
      fr.readAsDataURL(blob);
    });
  }

  function buildUI() {
    var scroll = document.querySelector('#op-panel .op-panel-scroll');
    if (!scroll || $('op-data-sec')) return;
    var sec = document.createElement('div');
    sec.className = 'op-sec'; sec.id = 'op-data-sec';
    sec.innerHTML =
      '<div class="op-sec-t">数据管理</div>' +
      '<div class="op-next-btns"><button id="op-d-export">导出数据</button><button id="op-d-import">导入数据</button></div>' +
      '<div class="op-next-tip">导出＝搭配设置＋本机上传的视频/图片/音乐打包成一个文件（可在换设备后导入恢复）；大文件导出会稍慢。导入会覆盖当前搭配。</div>';
    scroll.appendChild(sec);
    sec.querySelector('#op-d-export').addEventListener('click', doExport);
    sec.querySelector('#op-d-import').addEventListener('click', doImport);
  }
  /* 面板是动态渲染的，开面板时确保按钮区存在 */
  var mo = new MutationObserver(function () { buildUI(); });
  var pnl = $('op-panel');
  if (pnl) mo.observe(pnl, { childList: true, subtree: true });
  buildUI();

  async function doExport() {
    try {
      toast('正在打包开屏搭配…');
      var cfgRaw = st.get(CFG_KEY) || '';
      var media = [];
      if (window.idbListKeys) {
        var keys = await Promise.resolve(window.idbListKeys());
        var mk = (keys || []).filter(function (k) { return /^op-media:/.test(String(k)); });
        if (mk.length && window.idbGetMany) {
          var map = await Promise.resolve(window.idbGetMany(mk));
          for (var i = 0; i < mk.length; i++) {
            var v = map ? map[mk[i]] : null;
            if (!v) continue;
            var blob = (v && typeof v === 'object' && v.blob) ? v.blob : v;
            if (!(blob instanceof Blob)) continue;
            try {
              var data = await readAsDataURL(blob);
              media.push({ key: String(mk[i]), name: blob.name || '', type: blob.type || '', data: data });
            } catch (eR) {}
          }
        }
      }
      var pack = {
        app: 'mochi-feature-data', feature: 'opening', featureName: '开屏搭配', version: '1.0',
        exportTime: new Date().toISOString(),
        cfg: cfgRaw,
        media: media
      };
      var blob = new Blob([JSON.stringify(pack)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'mochi-开屏搭配-' + stamp() + '.json';
      document.body.appendChild(a); a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 4000);
      toast('已导出（含 ' + media.length + ' 个媒体文件）');
    } catch (eE) { toast('导出失败：' + (eE && eE.message || eE)); }
  }

  function dataURLtoBlob(u) {
    return fetch(u).then(function (r) { return r.blob(); });
  }

  function doImport() {
    var inp = document.createElement('input');
    inp.type = 'file'; inp.accept = 'application/json,.json';
    inp.addEventListener('change', async function () {
      var f = inp.files && inp.files[0]; if (!f) return;
      try {
        var text = await f.text();
        var pack = JSON.parse(text);
        if (!pack || (pack.feature !== 'opening' && !pack.cfg && !(pack.media || []).length)) { toast('这不是开屏搭配的导出文件'); return; }
        var n = 0;
        if (pack.cfg) st.set(CFG_KEY, typeof pack.cfg === 'string' ? pack.cfg : JSON.stringify(pack.cfg));
        var list = pack.media || [];
        for (var i = 0; i < list.length; i++) {
          var it = list[i];
          if (!it || !it.key || !it.data) continue;
          try {
            var blob = await dataURLtoBlob(it.data);
            if (it.name) try { blob = new File([blob], it.name, { type: it.type || blob.type }); } catch (eF) {}
            await Promise.resolve(window.idbSet(it.key, blob));
            n++;
          } catch (eM) {}
        }
        toast('导入完成（' + n + ' 个媒体文件），正在刷新…');
        setTimeout(function () { try { location.reload(); } catch (e) {} }, 900);
      } catch (eP) { toast('导入失败：文件读不了或格式不对'); }
    });
    inp.click();
  }
} catch (eX) { try { console.error('[v92p]', eX && eX.message); } catch (y) {} }
})();
</script>

</body>
</html>
