        '<div class="qd-grid" id="qd-grid"></div>' +
        '<div class="qd-foot" id="qd-foot"></div>' +
        '<button class="qd-today" id="qd-today" type="button">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M8 3v4M16 3v4M3.5 9.5h17"/><path d="M8 13h3M8 16.6h7M13.4 13h2.6"/></svg>' +
          '<span>今天的全部记录</span>' +
        '</button>' +
        '<button class="qd-diary-bar" id="qd-diary-bar" type="button" aria-label="打开日记本（长按改名）">' +
          '<span class="qdb-ico">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 4.5A1.5 1.5 0 016 3h12.5v16H6a1.5 1.5 0 00-1.5 1.5z"/><path d="M4.5 4.5v16"/><path d="M8 7.5h7M8 11h5"/></svg>' +
            '<i class="qdb-plus" id="qdb-plus" aria-hidden="true">+</i>' +
          '</span>' +
          '<span class="qdb-name" id="qdb-name">日记本</span>' +
          '<span class="qdb-n" id="qdb-n"></span>' +
          '<span class="qdb-arrow" aria-hidden="true">→</span>' +
        '</button>' +
      '</div>';
    D.body.appendChild(page);

    /* ---- 编辑弹层 ---- */
    var sheet = D.createElement('div');
    sheet.id = 'qd-edit'; sheet.className = 'qd-sheet qd-epop';
    sheet.innerHTML =
      '<div class="qd-sheet-box">' +
        '<div class="qd-sheet-hd"><span class="qd-chip" id="qd-edit-chip">经历</span><span id="qd-edit-title">记一笔</span><button class="qd-x" id="qd-edit-x">✕</button></div>' +
