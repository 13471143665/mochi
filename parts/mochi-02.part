ctx.fillStyle = s.flashWall > 0 ? '#ffe08a' : '#ffffff';
ctx.beginPath(); ctx.arc(b.x, b.y, bR, 0, Math.PI * 2); ctx.fill();
if ((s.diff === 'casual' || s.diff === 'easy') && now != null) {
let showArrow = false;
