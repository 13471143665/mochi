  function opUserActivated() {
    try { return !!(navigator.userActivation && navigator.userActivation.hasBeenActive); } catch (e) { return false; }
  }
  /* v67b：诊断证明——先试「有声自动播放」会被 Chrome 拒绝（NotAllowedError），
     而且这个元素之后连静音 play() 都会被持续拒绝。
     所以顺序必须是：先静音起播（所有浏览器都放行）→ 等首次手势再解除静音。
     若本页已经有过用户手势（比如从桌面图标再次打开开屏），就直接有声起播。 */
  /* v70（用户报 bug「刷新后开屏只有视频没有音乐」）：
     开屏期间必须直接出声，不能等到进主页点那一下。
     但浏览器策略又要求「先静音才放行」，所以顺序是：
     ① 静音起播（一定成功，保证时间轴在跑）→ ② 立刻试着解除静音：
        访问过的站点/MEI 达标的浏览器会直接放行 → 开屏就有音乐；
     ③ 若被拦（元素被浏览器 pause），300ms 后自动退回静音继续跑，绝不把音乐弄停，
        等开屏上任意手势/进主页那一下再出声。 */
  function opTryUnmute() {
    if (!opAudio || opMusicOff || opAudioUnlocked) return;
    var pg = $('page-opening');
    if (!pg || pg.hidden || pg.classList.contains('op-config')) return;
    try {
      opAudio.muted = false; opAudio.volume = 1;
      if (opAudio.paused) {
        var prU = opAudio.play();
        if (prU && prU.catch) prU.catch(function () {});
      }
    } catch (eUm) {}
    setTimeout(function () {
      try {
        if (!opAudio || opMusicOff) return;
        var pg2 = $('page-opening');
        if (!pg2 || pg2.hidden || pg2.classList.contains('op-config')) return;
        if (opAudio.paused || opAudio.muted) {
          /* 被策略拦截 → 回静音继续跑（音量先静音但时间轴不断） */
          opAudio.muted = true;
          opFallbackMutedPlay();
        } else {
          opAudioUnlocked = true;
          opAlignOnce();
        }
      } catch (eUm2) {}
    }, 320);
  }
  function opTryPlayAudio() {
    if (!opAudio || opMusicOff) return;
    opBindGestureUnlock();
    opAudioUnlocked = false;
    try { opAudio.muted = true; } catch (eMu3) {}
    opFallbackMutedPlay();
    opAlignOnce();
    /* 先静音拿到播放许可，再马上试出声——能放行的浏览器开屏就有音乐 */
    setTimeout(opTryUnmute, 60);
    /* v92x：持续尝试解除静音（有些浏览器在站点被访问过/MEI 达标后才放行有声播放），
       开屏期间每 900ms 试一次；开屏关掉后自动停 */
    try { clearInterval(opUnmuteTimer); } catch (eT0) {}
    opUnmuteTimer = setInterval(function () {
      var pg = $('page-opening');
      if (!pg || pg.hidden || pg.classList.contains('op-config') || !opAudio || opAudioUnlocked) { try { clearInterval(opUnmuteTimer); } catch (eT1) {} return; }
      if (!opAudio.paused) return; /* 已经在响就不用再试 */
      opTryUnmute();
    }, 900);
  }
  /* v92z：起播失败自愈——某些浏览器里元素被「无手势 play」拒绝过一次后，
     连手势 play() 都会持续拒绝（NotAllowedError 阴影）。手势播放失败时
     重建一个新的 audio 元素再试：新元素 + 用户手势 = 一定放行 */
  var opMusicErr = '';
  function opAudioRebuild() {
    try {
      var old = opAudio;
      var nu = new Audio();
      nu.preload = 'auto'; nu.style.display = 'none';
      nu.loop = true; nu.muted = false; nu.volume = 1;
      if (old) {
        try { nu.src = old.src || ''; } catch (eS) {}
        try { nu.dataset.opid = (old.dataset && old.dataset.opid) || ''; } catch (eD) {}
        try { old.pause(); old.removeAttribute('src'); old.load(); } catch (eO) {}
      }
      document.body.appendChild(nu);
      ['canplay', 'loadeddata'].forEach(function (evn) {
        nu.addEventListener(evn, function () {
          /* v93a：开屏页已关（进桌面/设置）后绝不复活音乐——
             之前这里没有 hidden 检查，双击进桌面 opStopAll 停掉后，
             若这个重建元素的 canplay 事件晚到（网络慢才加载完），
             会自己 play() 把音乐在桌面里重新放出来（乱播放主因） */
          var pgR = $('page-opening');
          if (pgR && (pgR.hidden || pgR.classList.contains('op-config'))) return;
          if (opAudio === nu && opAudioUnlocked && !opMusicOff && nu.paused) { try { nu.play(); } catch (eC) {} }
        });
      });
      opAudio = nu;
      return true;
    } catch (eR) { return false; }
  }
  function opAudioTryPlay(el) {
    el = el || opAudio;
    if (!el) return;
    /* v93a：开屏页已关（进桌面/设置）后绝不尝试起播——手势激活是一次全局状态，
       桌面里任何残余调用都可能借「已激活」把开屏音乐放出来 */
    var pgT = $('page-opening');
    if (pgT && (pgT.hidden || pgT.classList.contains('op-config'))) return;
    try {
      var p = el.play();
      if (p && p.then) p.then(function () { opMusicErr = ''; }).catch(function (e) {
        var nm = (e && e.name) || '未知错误';
        /* 手势上下文里的拒绝 → 重建元素立刻重试一次 */
        if (opUserActivated() && el === opAudio) {
          if (opAudioRebuild() && opAudio.src) {
            var p2 = opAudio.play();
            if (p2 && p2.then) p2.then(function () { opMusicErr = ''; }).catch(function (e2) { opMusicErr = (e2 && e2.name) || nm; });
            return;
          }
        }
        opMusicErr = nm;
      });
    } catch (eT) { opMusicErr = (eT && eT.name) || '未知错误'; }
  }
  /* v92z：开屏左下角音乐状态指示条——把音乐系统的真实状态亮出来，
     不再让「开关被关了 / 没文件 / 被浏览器拦截 / 元素被玩坏」静默吞掉；
     点指示条可直接修复（开开关 / 重新起播） */
  var opChipEl = null;
  function opMusicChip() {
    var pg = $('page-opening');
    if (!pg || pg.hidden || pg.classList.contains('op-config')) {
      if (opChipEl && opChipEl.parentNode) { opChipEl.parentNode.removeChild(opChipEl); }
      opChipEl = null;
      return;
    }
    if (!opChipEl) {
      opChipEl = document.createElement('div');
      opChipEl.id = 'op-music-chip';
      opChipEl.style.cssText = 'position:absolute;left:12px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:31;max-width:72%;padding:7px 12px;border-radius:999px;background:rgba(0,0,0,.5);color:#fff;font-size:11.5px;letter-spacing:.5px;-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);pointer-events:auto;cursor:pointer;';
      opChipEl.addEventListener('click', function (e) { e.stopPropagation(); opChipTap(); });
      pg.appendChild(opChipEl);
    }
    var txt = '', warn = false;
    if (opMusicOff) { txt = '♪ 开屏音乐开关已关闭 · 点这里开启'; warn = true; }
    else if (!opAlive(cfg.list.music).length) { txt = '♪ 音乐区还没有可用音乐 · 进「搭配」上传'; warn = true; }
    else if (opMusicErr) { txt = '⚠ 音乐起播失败(' + opMusicErr + ') · 点我重试'; warn = true; }
    else if (!opAudio || !opAudio.src || opAudio.readyState < 1) { txt = '♪ 音乐加载中…'; }
    else if (opAudio.error) { txt = '⚠ 音乐文件无法解码 · 可在搭配里删除重传'; warn = true; }
    else if (!opAudio.paused && !opAudio.muted) { txt = '♪ 音乐播放中'; }
    else if (!opAudio.paused && opAudio.muted) { txt = '已静音待解锁 · 轻点屏幕任意处出声'; }
    else { txt = '♪ 音乐待播放 · 轻点屏幕任意处出声'; warn = true; }
    opChipEl.textContent = txt;
    opChipEl.style.background = warn ? 'rgba(158,64,32,.75)' : 'rgba(0,0,0,.5)';
  }
  function opChipTap() {
    try {
      if (opMusicOff) { window.opSetOpMusic && window.opSetOpMusic(true); toast('开屏音乐已开启'); opMusicErr = ''; opReplayMedia(); return; }
      opMusicErr = '';
      ensureAudio();
      if (opAudio) {
        opAudio.muted = false; opAudio.volume = 1;
        if (opAudio.paused) opAudioTryPlay();
      }
    } catch (eC) {}
  }
  setInterval(opMusicChip, 600);
  function opPlayVisual(item) {
    if ($('page-opening') && $('page-opening').classList.contains('op-config')) return;
    var v = $('op-video'), im = $('op-image'), fb = $('op-fallback');
    try { v.pause(); } catch (e) {}
    v.classList.remove('on'); im.classList.remove('on'); fb.classList.remove('on');
    clearInterval(opImgTimer); opImgTimer = null;
    if (cfg.pair === 'video') {
      if (!item) { fb.classList.add('on'); return; }
      opEnsureSrc(item).then(function (src) {
        if (curVisual !== item || $('page-opening').hidden) return;
        if (!src) {
          /* v89：本地文件丢了（IDB 里没有）→ 标失效并换下一个，别停在白屏 */
          opMarkDead(item);
          var vlMiss = opAlive(cfg.list.video);
          if (vlMiss.length && curVisual === item) { opPlayVisual(vlMiss[0]); return; }
          if (opAlive(cfg.list.image).length) { cfg.pair = 'image'; opReplayMedia(); return; }
          fb.classList.add('on'); return;
        }
        /* v85：恢复视频播放（带动画） */
        v.src = src; v.muted = !cfg.vsound; v.loop = true; v.classList.add('on');
        /* v87：视频加载失败（404/损坏）自动换列表里下一个，别卡在白屏 */
        v.onerror = function () {
          if ($('page-opening').hidden || curVisual !== item) return;
          opMarkDead(item);                     /* v89：这个资源确定是坏的 */
          var vl = opAlive(cfg.list.video);
          if (vl.length) { opPlayVisual(vl[0]); return; }
          /* v87：默认预置视频缺失（单文件部署没有 media/ 目录）时退到图片轮播，别白屏 */
          if (cfg.pair === 'video' && opAlive(cfg.list.image).length) {
            cfg.pair = 'image';
            opReplayMedia();
          }
        };
        var pr = v.play();
        if (pr && pr.then) pr.then(function () { opAlignOnce(); }).catch(function () { opTapHint(true); });
        else { opAlignOnce(); }
      });
    } else {
      var list = cfg.list.image || [];
      if (!list.length) { fb.classList.add('on'); return; }
      var show = function (it) {
        if (!it) return;
        opEnsureSrc(it).then(function (src) {
          if ($('page-opening').hidden) return;
          if (src) { im.src = src; im.classList.add('on'); fb.classList.remove('on'); return; }
          /* v89：这张图加载失败 → 标失效，换下一张还活着的 */
          opMarkDead(it);
          var il = opAlive(list);
          if (il.length) { curImgIdx = 0; show(il[0]); }
          else fb.classList.add('on');
        });
      };
      curImgIdx = Math.max(0, list.indexOf(item));
      show(list[curImgIdx] || list[0]);
      if (list.length > 1) {
        opImgTimer = setInterval(function () {
          if ($('page-opening').hidden) { clearInterval(opImgTimer); return; }
          curImgIdx = cfg.mode === 'order' ? (curImgIdx + 1) % list.length : Math.floor(Math.random() * list.length);
          show(list[curImgIdx]);
        }, 6000);
      }
    }
  }
  function opPlayMusic(item) {
    /* v85（用户反馈「开屏要有动画有音乐」）：恢复开屏音乐播放 */
    if ($('page-opening') && $('page-opening').classList.contains('op-config')) return;
    ensureAudio();
    if (!item) { try { opAudio.pause(); } catch (e) {} return; }
    opEnsureSrc(item).then(function (src) {
      if ($('page-opening').hidden) return;
      if (!src) {
        /* v89：本地音乐文件丢了 → 标失效并换下一首还活着的 */
        opMarkDead(item);
        var mlMiss = opAlive(cfg.list.music);
        if (mlMiss.length) opPlayMusic(mlMiss[0]);
        return;
      }
      if (opAudio.dataset.opid !== item.id) {
        opAudio.src = src; opAudio.dataset.opid = item.id;
        try { opAudio.currentTime = 0; } catch (eCt) {}
      }
      /* v92q→v92t/v92v：带画面轨的不再一律跳过——先看有没有音轨：
         录屏带声音的（webkitAudioDecodedByteCount>0）直接放；
         真无声的视频才标失效跳下一首，别让开屏静音 */
      if (!item._hasAudio) {
        try {
          opProbeVideoMeta(src).then(function (hasV) {
            if (!hasV || item._hasAudio) return; /* 纯音频，直接放 */
            opAudioVerdict(src).then(function (verdict) {
              if (verdict !== false) { item._hasAudio = 1; saveCfg(); return; } /* 有声音/不确定，都放行 */
              if ($('page-opening').hidden) return;
              opMarkDead(item);
              try { opAudio.pause(); } catch (ePv) {}
              try { window.toast('「' + (item.name || '') + '」没有声音（视频轨但无音轨），开屏音乐已跳过；可在开屏搭配里删除它'); } catch (eTv) {}
              var mlV = opAlive(cfg.list.music);
              if (mlV.length) opPlayMusic(mlV[0]);
            });
          }).catch(function () {});
        } catch (ePr) {}
      }
      opAudio.loop = true;                 /* v66：音乐播完原本内容后自己循环 */
      /* v87：音乐加载失败自动换下一个，别让「单击没声音」卡死在坏资源上 */
      opAudio.onerror = function () {
        if ($('page-opening').hidden) return;
        opMarkDead(item);                    /* v89：这首确定是坏的 */
        var ml = opAlive(cfg.list.music);
        if (ml.length) opPlayMusic(ml[0]);
      };
      /* v68：进站先静音跑起来，进主页那一下点击再出声 */
      opAudioUnlocked = false;
      try { opAudio.muted = true; opAudio.volume = 1; } catch (eMu) {}
      opLastVTime = 0; opAligned = false;
      if (opMusicOff) { try { opAudio.pause(); } catch (eMo) {} return; }
      opTryPlayAudio();                   /* 静音起播（放行）+ 首次手势解除静音 */
      opAlignOnce();                      /* v66：只在起播对齐一次，之后各自独立循环 */
    });
  }
  function opProgress() {
    var box = $('op-load'), lab = $('op-load-label'), pct = $('op-load-pct'), bar = $('op-load-bar');
    clearInterval(opProgTimer);
    box.classList.remove('done'); lab.textContent = '正在链接…';
    pct.textContent = '0%'; bar.style.width = '0%';
    var dur = 3200, step = 45, t0 = Date.now();
    opProgTimer = setInterval(function () {
      var r = Math.min(1, (Date.now() - t0) / dur);
      var p = Math.round(r * 100);
      if (r >= 1) {
        clearInterval(opProgTimer);
        lab.textContent = '连接成功…'; box.classList.add('done');
      }
      pct.textContent = p + '%'; bar.style.width = p + '%';
    }, step);
  }
  function opStopAll() {
    /* v92y（用户明确要求）：双击进入桌面后，音乐和视频都立即停止，不残留不淡出。
       （开屏期间的音乐照常：单击屏幕就出声，停在开屏上随便听） */
    try { $('op-video').pause(); } catch (e) {}
    clearInterval(opImgTimer); clearInterval(opProgTimer);
    if (opSyncTimer) { clearInterval(opSyncTimer); opSyncTimer = null; }
    try { clearInterval(opUnmuteTimer); } catch (eU0) {}
    /* v93a：彻底断播——pause 复位 + 回静音 + 复位解锁标记。
       之前只 pause：解锁标记还挂着 true、元素没回静音，
       任何残留监听器（canplay 晚到 / visibilitychange）都能把音乐续播起来 */
    opAudioUnlocked = false;
    try { if (opAudio) { opAudio.pause(); opAudio.currentTime = 0; opAudio.muted = true; opAudio.volume = 1; } } catch (eSm) {}
    opPill(false);
  }
  function opStopMusic() {
    opMusicOff = true;   /* 本次会话停；是否永久关由外观分区开关写 localStorage */
    try { if (opAudio) { opAudio.pause(); opAudio.currentTime = 0; } } catch (eStop) {}
    opPill(false);
  }
  /* v67：进入网站后，只要开屏音乐还在响，就右上角挂一个小开关。
     点一下暂停/继续，点 ✕ 直接关掉并从此不再显示（对应「关掉就不再显示」）。
     v70：只在桌面主页出现——它 z-index 305 会浮在播放器 ⋯ 菜单 / 搭配面板上面挡住按钮。 */
  function opPillVisibleOk() {
    var ph = $('page-phone'), pg = $('page-opening');
    if (pg && !pg.hidden) return false;   /* 开屏页上不挂小条 */
    return !!(ph && !ph.hidden);
  }
  function opPillSync() {
    var el = document.getElementById('op-music-pill');
    if (!el) return;
    var on = !!(opAudio && !opMusicOff && !opAudio.paused);
    opPill(on);
  }
  function opPill(show) {
    var el = document.getElementById('op-music-pill');
    if (show && !opPillVisibleOk()) show = false;
    if (!show) {
      if (el) el.hidden = true;
      return;
    }
    if (!el) {
      el = document.createElement('div');
      el.id = 'op-music-pill'; el.className = 'op-pill'; el.hidden = true;
      el.innerHTML = '<button id="op-pill-toggle" title="暂停 / 继续开屏音乐">' +
        '<svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>' +
        '<span id="op-pill-txt">开屏音乐</span></button><button class="op-pill-x" id="op-pill-close" title="关掉并不再显示">✕</button>';
      document.body.appendChild(el);
      var tg = document.getElementById('op-pill-toggle');
      if (tg) tg.addEventListener('click', function (e) {
        e.stopPropagation(); e.preventDefault();
        try {
          if (!opAudio) return;
          if (opAudio.paused) {
            opAudio.muted = false; opAudio.volume = 1;
            var p = opAudio.play(); if (p && p.catch) p.catch(function () {});
            var t1 = document.getElementById('op-pill-txt'); if (t1) t1.textContent = '开屏音乐';
          } else {
            opAudio.pause();
            var t2 = document.getElementById('op-pill-txt'); if (t2) t2.textContent = '已暂停';
          }
        } catch (eTg) {}
      });
      var cl2 = document.getElementById('op-pill-close');
      if (cl2) cl2.addEventListener('click', function (e) {
        e.stopPropagation(); e.preventDefault();
        opStopMusic();                 /* 停 + 隐藏，本次进入不再出现 */
        toast('开屏音乐已关闭');
      });
    }
    el.hidden = false;
    var tx = document.getElementById('op-pill-txt');
    if (tx) tx.textContent = '开屏音乐';
  }
  function opSyncSegs() {
    document.querySelectorAll('#op-mode-seg button, .op-seg-mode button').forEach(function (b) { b.classList.toggle('on', b.dataset.mode === cfg.mode); });
    document.querySelectorAll('#op-pair-seg button, .op-seg-pair button').forEach(function (b) { b.classList.toggle('on', b.dataset.pair === cfg.pair); });
  }
  function opBindRename(el, getCur, onSave) {
    var tm = null, fired = false;
    function start() {
      fired = false; clearTimeout(tm);
      tm = setTimeout(function () {
        fired = true;
        var cur = getCur();
        if (window.openModal) window.openModal('修改名称', cur, function (v) {
          var t = String(v == null ? '' : v).trim().slice(0, 24);
          if (t) onSave(t);
        }, { maxlength: 24, placeholder: '输入新名称' });
        else { var t = window.prompt('修改名称', cur); if (t) onSave(String(t).trim().slice(0, 24)); }
      }, 520);
    }
    function cancel() { clearTimeout(tm); }
    el.addEventListener('touchstart', start, { passive: true });
    ['touchend', 'touchmove', 'touchcancel', 'mouseup', 'mouseleave'].forEach(function (ev) { el.addEventListener(ev, cancel, { passive: true }); });
    el.addEventListener('mousedown', function (e) { if (e.button === 0) start(); });
    el.addEventListener('click', function (e) { if (fired) { e.stopPropagation(); e.preventDefault(); fired = false; } }, true);
  }
  function opNameInList(id) {
    var all = (cfg.list.video || []).concat(cfg.list.image || [], cfg.list.music || []);
    var h = all.filter(function (x) { return x.id === id; })[0];
    return h ? h.name : '';
  }
  function opSetNext(zone, item) {
    var n = (cfg.next && cfg.next.pair === cfg.pair) ? Object.assign({}, cfg.next) : { pair: cfg.pair, visualId: '', musicId: '' };
    if (zone === 'music') n.musicId = item.id;
    else { n.pair = zone; n.visualId = item.id; }
    cfg.pair = n.pair;                 /* 永远只保留一种画面：视频或图片 */
    cfg.next = n;
    saveCfg(); opRenderPanel(); opSyncSegs();
    toast('已设为下一次进页面的搭配');
  }
  /* v67：分区内置顶 / 置底（只动本区数组，跨区不互相影响） */
  function opMoveItem(zone, id, dir) {
    var arr = (cfg.list[zone] || []).slice();
    var i = -1, k;
    for (k = 0; k < arr.length; k++) { if (arr[k].id === id) { i = k; break; } }
    if (i < 0) return;
    if (dir === 'top' && i === 0) { toast('已经是第一位了'); return; }
    if (dir === 'bottom' && i === arr.length - 1) { toast('已经是最后一位了'); return; }
    var it = arr.splice(i, 1)[0];
    if (dir === 'top') arr.unshift(it); else arr.push(it);
    cfg.list[zone] = arr;
    /* 顺序播放的游标跟着归零，避免置顶后下一次还从中间开始 */
    if (cfg.mode === 'order') cfg.orderIdx[zone] = 0;
    saveCfg(); opRenderPanel();
    toast(dir === 'top' ? ('已置顶「' + it.name + '」') : ('已置底「' + it.name + '」'));
  }
  /* v70：顶栏「排序」按钮打开的弹层——本区所有条目列出来，逐条点「置顶 / 置底」。
     主列表里不再每条都挂两个箭头，一眼干净；弹层里操作完即时刷新。 */
  var opSortEl = null, opSortZone = '';
  function opSortEsc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function opRenderSort() {
    if (!opSortEl) return;
    var zone = opSortZone;
    var items = cfg.list[zone] || [];
    var name = cfg.names[zone] || '';
    var rows = items.map(function (it, idx) {
      return '<div class="ops-row" data-opsid="' + opSortEsc(it.id) + '">' +
        '<span class="ops-idx">' + (idx + 1) + '</span>' +
        '<span class="ops-nm">' + opSortEsc(it.name) + '</span>' +
        '<button type="button" class="ops-act" data-opsdir="top" title="挪到本区第一位"><svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg>置顶</button>' +
        '<button type="button" class="ops-act" data-opsdir="bottom" title="挪到本区最后一位"><svg viewBox="0 0 24 24"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>置底</button>' +
        '</div>';
    }).join('');
    opSortEl.innerHTML =
      '<div class="ops-card">' +
        '<div class="ops-hd"><b>排序 · ' + opSortEsc(name) + '</b><button type="button" class="ops-x" data-opsclose="1">完成</button></div>' +
        '<div class="ops-tip">点「置顶」把这条挪到本区第一位，点「置底」挪到最后一位；列表里也能按住左边的 ≡ 拖动排序。</div>' +
        '<div class="ops-list">' + (rows || '<div class="ops-empty">这一区还没有内容</div>') + '</div>' +
      '</div>';
  }
  function opOpenSort(zone) {
    opSortZone = zone || opSortZone || 'video';
    if (!opSortEl) {
      opSortEl = document.createElement('div');
      opSortEl.id = 'op-sort-panel';
      document.body.appendChild(opSortEl);
      opSortEl.addEventListener('click', function (e) {
        var t = e.target;
        if (t === opSortEl || (t.closest && t.closest('[data-opsclose]'))) { opSortEl.classList.remove('on'); return; }
        var b = t.closest && t.closest('[data-opsdir]');
        if (!b) return;
        var row = b.closest('[data-opsid]');
        if (!row) return;
        opMoveItem(opSortZone, row.getAttribute('data-opsid'), b.getAttribute('data-opsdir'));
        opRenderSort();
      });
    }
    opRenderSort();
    opSortEl.classList.add('on');
  }
  window.opOpenSort = opOpenSort;
  function opDelete(zone, id) {
    var arr = cfg.list[zone] || [];
    var it = arr.filter(function (x) { return x.id === id; })[0];
    cfg.list[zone] = arr.filter(function (x) { return x.id !== id; });
    if (it && it.local) {
      try { if (OP_BLOB[id]) URL.revokeObjectURL(OP_BLOB[id]); } catch (e) {}
      delete OP_BLOB[id];
      try { if (window.idbDelete) window.idbDelete('op-media:' + id); } catch (e) {}
    }
    if (cfg.next && (cfg.next.visualId === id || cfg.next.musicId === id)) cfg.next = null;
    saveCfg(); opRenderPanel(); toast('已删除');
  }
  function opAdd(zone, allowAll) {
    var z = ZONES.filter(function (x) { return x.k === zone; })[0];
    var inp = document.createElement('input');
    inp.type = 'file'; inp.multiple = true;
    /* v92o：音乐区不限定 accept——Android 上限定 audio/* 会弹「最近媒体」小选择器，
       只给最近几首歌；不限类型才会打开完整文件管理器（可进「内部存储」逐层选歌） */
    if (z.accept) inp.accept = z.accept;
    inp.addEventListener('change', function () {
      var files = Array.prototype.slice.call(inp.files || []);
      if (!files.length) return;
      /* v92q→v92t/v92u：音乐区默认探测拒真视频；「添加文件」入口(allowAll)不限制，
         文件形式全部放行——真视频由播放时的视频轨探测自动跳过兜底 */
      if (zone === 'music' && !allowAll) {
        opProbeMusicFiles(files).then(function (r) {
          if (!r.ok.length) { toast((r.bad[0] || '文件') + ' 是视频/图片文件，放不进音乐区（开屏音乐只收音频）'); return; }
          if (r.bad.length) toast('有 ' + r.bad.length + ' 个视频/图片文件被拒收（音乐区只收音频）');
          opCommitAdd(zone, r.ok);
        });
        return;
      }
      opCommitAdd(zone, files);
    });
    inp.click();
  }
  /* v92t：把选中的文件真正写入音乐区（原 opAdd 内联逻辑抽出，供异步探测后调用） */
  function opCommitAdd(zone, files) {
      var big = 0, okN = 0;
      files.forEach(function (f) {
        /* v92k：超过 40MB 的音频在多数手机浏览器里存不进 IndexedDB，提前提示，不静默失败 */
        if (f.size > 40 * 1024 * 1024) { big++; }
        var id = 'm' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
        try { OP_BLOB[id] = URL.createObjectURL(f); } catch (e) {}
        try { if (window.idbSet) window.idbSet('op-media:' + id, f); } catch (e) {}
        cfg.list[zone].push({ id: id, name: String(f.name || '未命名').replace(/\.[^.]+$/, '').slice(0, 40), src: '', local: true });
        okN++;
      });
      saveCfg(); opRenderPanel();
      if (zone === 'music') toast('已上传 ' + okN + ' 首音乐到「' + cfg.names[zone] + '」，刷新后仍保留'
        + (big ? '；有 ' + big + ' 个文件超过 40MB，可能无法长期保存' : ''));
      else toast('已添加 ' + okN + ' 个到' + cfg.names[zone]);
  }
  /* v92t：探测媒体源/文件是否真带视频轨（loadedmetadata 时画面宽高>0）。
     纯音频装在 mp4 壳里（视频转音频常见产物、m4a）videoWidth===0，不算视频 */
  function opProbeVideoMeta(src) {
    return new Promise(function (res) {
      var v = document.createElement('video');
      var done = false;
      var fin = function (x) { if (done) return; done = true; try { v.removeAttribute('src'); v.load(); } catch (e) {} res(x); };
      try {
        v.preload = 'metadata'; v.muted = true;
        v.onloadedmetadata = function () { fin(v.videoWidth > 0); };
        v.onerror = function () { fin(false); };
        setTimeout(function () { fin(false); }, 6000);
        v.src = src;
      } catch (e) { fin(false); }
    });
  }
  /* v92w：音轨探测两步走——
     ① 快速路：静音起播读 webkitAudioDecodedByteCount（>0 立即判「有声音」）；
        API 不存在或 3.5 秒没结论 → 返回 null（不确定）
     ② 兜底路：AudioContext.decodeAudioData 真解一遍音频数据——
        解出样本=有音轨(true)，抛错=没有音轨(false)，环境不支持=null
     结论策略：只有「明确解不出音轨」才判无声音；其余一律放行，
     宁可多播、绝不误杀用户上传的音乐 */
  function opDecodeHasAudio(src) {
    return new Promise(function (res) {
      try {
        fetch(src).then(function (r) { return r.arrayBuffer(); }).then(function (ab) {
          try {
            var AC = window.AudioContext || window.webkitAudioContext;
            if (!AC) { res(null); return; }
            var ac = new AC();
            var finish = function (v) { try { if (ac.close) ac.close(); } catch (eX) {} res(v); };
            ac.decodeAudioData(ab, function (buf) {
              try {
                var ch = (buf && buf.numberOfChannels) || 0, len = (buf && buf.length) || 0;
                finish(ch > 0 && len > 0);
              } catch (eC) { finish(null); }
            }, function () { finish(false); });
          } catch (e2) { res(null); }
        }).catch(function () { res(null); });
      } catch (e) { res(null); }
    });
  }
  function opProbeHasAudio(src) {
    return new Promise(function (res) {
      var v = document.createElement('video');
      var done = false, timer = null, to = null, apiExists = false;
      var fin = function (x) {
        if (done) return; done = true;
        try { clearInterval(timer); } catch (e0) {}
        try { clearTimeout(to); } catch (e1) {}
        try { v.pause(); v.removeAttribute('src'); v.load(); } catch (e2) {}
        res(x);
      };
      try { apiExists = 'webkitAudioDecodedByteCount' in v; } catch (eA) {}
      try {
        v.preload = 'auto'; v.muted = true; v.volume = 0;
        v.onloadedmetadata = function () {
          var p = v.play();
          try { if (p && p.catch) p.catch(function () {}); } catch (eP) {}
        };
        if (apiExists) {
          timer = setInterval(function () {
            if (done) return;
            var n = 0;
            try { n = v.webkitAudioDecodedByteCount || 0; } catch (e3) {}
            if (n > 0) fin(true);
          }, 250);
        }
        to = setTimeout(function () { fin(null); }, apiExists ? 3500 : 800);
        v.src = src;
      } catch (e) { fin(null); }
    });
  }
  function opAudioVerdict(src) {
    return opProbeHasAudio(src).then(function (quick) {
      if (quick === true) return true;
      if (quick === false) return false;   /* API 存在、播了、音频解码为 0：确证无音轨 */
      return opDecodeHasAudio(src);        /* 不确定 → 真解码兜底 */
    });
  }
  function opProbeMusicFiles(files) {    var ok = [], bad = [], tasks = [];
    files.forEach(function (f) {
      var t = f.type || '', nm = f.name || '';
      /* 图片直接拒；明确是音频的直接放行；其余（mp4/mov/未知类型）探测内容。
         v92v：带画面轨的不再一刀切拒——录屏等带音轨的也能当开屏音乐放，
         探测出有声音就收；真无声（没录声音的录屏）才拒 */
      if (/^image\//i.test(t) || /\.(jpg|jpeg|png|gif|webp|bmp)$/i.test(nm)) { bad.push(nm || '未命名'); return; }
      if (/^audio\//i.test(t) || /\.(mp3|m4a|aac|wav|ogg|oga|opus|flac)$/i.test(nm)) { ok.push(f); return; }
      var src = '';
      try { src = URL.createObjectURL(f); } catch (e) {}
      tasks.push(opProbeVideoMeta(src).then(function (hasV) {
        if (!hasV) { try { if (src) URL.revokeObjectURL(src); } catch (e2) {} ok.push(f); return; }
        return opAudioVerdict(src).then(function (verdict) {
          try { if (src) URL.revokeObjectURL(src); } catch (e3) {}
          if (verdict === false) bad.push(nm || '未命名'); else ok.push(f);  /* 不确定也放行 */
        });
      }));
    });
    return Promise.all(tasks).then(function () { return { ok: ok, bad: bad }; });
  }
  /* v92q：条目预览浮层——双击条目查看原始视频/音乐/图片 */
  var _pv = null;
  function opPreviewClose() {
    if (_pv && _pv.parentNode) {
      try {
        var m = _pv.querySelector('video,audio');
        if (m) { try { m.pause(); } catch (eP1) {} try { m.src = ''; } catch (eP2) {} }
      } catch (eP0) {}
      _pv.parentNode.removeChild(_pv);
    }
    _pv = null;
  }
  function opPreview(zone, it) {
    opEnsureSrc(it).then(function (src) {
      if (!src) { toast('这个条目的原始文件不在本机（预置素材或已失效，双击看不了）'); return; }
      opPreviewClose();
      var pnl = $('op-panel'); if (!pnl) return;
    _pv = document.createElement('div');
    _pv.id = 'op-preview';
    _pv.style.cssText = 'position:absolute;inset:0;z-index:40;background:rgba(8,8,10,.97);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:18px;gap:14px';
    var title = document.createElement('div');
    title.style.cssText = 'color:#eee;font-size:13px;letter-spacing:1px;max-width:92%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:center';
    title.textContent = (it.name || '（未命名）') + ' · 预览';
    _pv.appendChild(title);
    if (zone === 'video') {
      var v = document.createElement('video');
      v.src = src; v.controls = true; v.autoplay = true; v.playsInline = true; v.preload = 'auto';
      v.style.cssText = 'max-width:100%;max-height:60vh;border-radius:12px;background:#000';
      _pv.appendChild(v);
    } else if (zone === 'music') {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:16px;width:100%';
      var disc = document.createElement('div');
      disc.style.cssText = 'width:110px;height:110px;border-radius:50%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;font-size:38px;color:#eee';
      disc.textContent = '♪';
      var a = document.createElement('audio');
      a.src = src; a.controls = true; a.autoplay = true; a.preload = 'auto';
      a.style.cssText = 'width:86%;max-width:320px';
      wrap.appendChild(disc); wrap.appendChild(a);
      _pv.appendChild(wrap);
    } else {
      var im = document.createElement('img');
      im.src = src; im.style.cssText = 'max-width:100%;max-height:60vh;border-radius:12px';
      _pv.appendChild(im);
    }
    var close = document.createElement('button');
    close.type = 'button'; close.textContent = '关闭预览';
    close.style.cssText = 'border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.1);color:#eee;font-family:inherit;font-size:12px;padding:8px 20px;border-radius:999px;cursor:pointer';
    close.addEventListener('click', function (e) { try { e.stopPropagation(); } catch (eS2) {} opPreviewClose(); });
    _pv.appendChild(close);
    _pv.addEventListener('dblclick', function (e) { e.stopPropagation(); });
    _pv.addEventListener('click', function (e) { if (e.target === _pv) opPreviewClose(); });
    pnl.appendChild(_pv);
    });
  }
  function opFillNext() {
    var vs = $('op-next-visual'), ms = $('op-next-music');
    if (!vs || !ms) return;
    var vl = cfg.list[cfg.pair] || [], ml = cfg.list.music || [];
    vs.innerHTML = ''; ms.innerHTML = '';
    var a0 = document.createElement('option'); a0.value = ''; a0.textContent = '（自动搭配）'; vs.appendChild(a0);
    vl.forEach(function (it) { var o = document.createElement('option'); o.value = it.id; o.textContent = it.name; vs.appendChild(o); });
    var b0 = document.createElement('option'); b0.value = ''; b0.textContent = '（自动搭配）'; ms.appendChild(b0);
    ml.forEach(function (it) { var o = document.createElement('option'); o.value = it.id; o.textContent = it.name; ms.appendChild(o); });
    if (cfg.next && cfg.next.pair === cfg.pair) { vs.value = cfg.next.visualId || ''; ms.value = cfg.next.musicId || ''; }
    var tip = $('op-next-tip');
    if (tip) tip.textContent = (cfg.next && cfg.next.pair === cfg.pair)
      ? ('已预设下一次：' + (opNameInList(cfg.next.visualId) || '自动') + ' ＋ ' + (opNameInList(cfg.next.musicId) || '自动') + '（用一次后自动清除）')
      : '未预设，进页面时按当前播放模式自动搭配。';
  }
  /* v68：按住左侧握把拖动＝在本区内换位（参考音乐列表「长按拖动调整播放顺序」）。
     拖动期间只挪 DOM，松手才写回 cfg 并落盘，避免重渲染打断手势。 */
  function opBindDrag(handle, zone, row, listEl) {
    if (!handle || !row || !listEl) return;
    handle.addEventListener('pointerdown', function (ev) {
      try { ev.preventDefault(); ev.stopPropagation(); } catch (eP0) {}
      if (ev.pointerType === 'mouse' && ev.button !== 0) return;
      var moved = false;
      row.classList.add('dragging');
      /* 注意：不能把指针捕获设在握把上——每次 insertBefore 换位都会把行从 DOM 摘下再插入，
         指针捕获随之被浏览器释放，拖动会中途断掉。改为整个 document 上监听。 */
      var prevUserSelect = document.body.style.userSelect;
      document.body.style.userSelect = 'none';
      var onMove = function (e) {
        var el = document.elementFromPoint(e.clientX, e.clientY);
        var over = (el && el.closest) ? el.closest('.op-item') : null;
        if (!over || over === row || over.parentNode !== listEl) return;
        moved = true;
        var r2 = over.getBoundingClientRect();
        var before = (e.clientY - r2.top) < r2.height / 2;
        listEl.insertBefore(row, before ? over : over.nextSibling);
      };
      var finish = function () {
        document.removeEventListener('pointermove', onMove, true);
        document.removeEventListener('pointerup', finish, true);
        document.removeEventListener('pointercancel', finish, true);
        try { document.body.style.userSelect = prevUserSelect; } catch (eUs) {}
        row.classList.remove('dragging');
        if (!moved) return;
        var order = Array.prototype.slice.call(listEl.querySelectorAll('.op-item')).map(function (x) { return x.dataset.opid; });
        var by = {}; (cfg.list[zone] || []).forEach(function (x) { by[x.id] = x; });
        var arr = [];
        order.forEach(function (id) { if (by[id]) { arr.push(by[id]); delete by[id]; } });
        (cfg.list[zone] || []).forEach(function (x) { if (by[x.id]) arr.push(x); });
        cfg.list[zone] = arr;
        if (cfg.mode === 'order') cfg.orderIdx[zone] = 0;   /* 顺序模式的游标归零，下一轮从第一位开始 */
        saveCfg();
        toast('已调整「' + cfg.names[zone] + '」顺序');
        opRenderPanel();
      };
      document.addEventListener('pointermove', onMove, true);
      document.addEventListener('pointerup', finish, true);
      document.addEventListener('pointercancel', finish, true);
    });
  }
  function opRenderPanel() {
    var host = $('op-zones'); if (!host) return;
    host.innerHTML = '';
    ZONES.forEach(function (z) {
      var items = cfg.list[z.k] || [];
      var sec = document.createElement('section'); sec.className = 'op-zone';
      var hd = document.createElement('div'); hd.className = 'op-zone-hd';
      var ico = document.createElement('span'); ico.className = 'op-zone-ico'; ico.textContent = z.ico;
      var nm = document.createElement('span'); nm.className = 'op-zone-name'; nm.textContent = cfg.names[z.k];
      var cnt = document.createElement('span'); cnt.className = 'op-zone-cnt'; cnt.textContent = items.length + ' 个';
      var hint = document.createElement('span'); hint.className = 'op-zone-hint'; hint.textContent = '长按改名';
      /* v70：置顶 / 置底不再挂在每个条目上，改成顶栏这一个「排序」按钮（弹层里逐条置顶/置底） */
      var sortBtn = document.createElement('button'); sortBtn.type = 'button'; sortBtn.className = 'op-zone-sort'; sortBtn.title = '排序：置顶 / 置底（本区）';
      sortBtn.innerHTML = '<svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h9M8 18h5"/><path d="M4 4v16M2 18l2 2 2-2"/></svg><span>排序</span>';
      ['pointerdown', 'touchstart', 'mousedown'].forEach(function (ev) { sortBtn.addEventListener(ev, function (e) { e.stopPropagation(); }, { passive: true }); });
      sortBtn.addEventListener('click', function (e) { e.stopPropagation(); opOpenSort(z.k); });
      [ico, nm, cnt, hint, sortBtn].forEach(function (x) { hd.appendChild(x); });
      opBindRename(hd, function () { return cfg.names[z.k]; }, function (v) {
        cfg.names[z.k] = v; saveCfg(); opRenderPanel(); toast('已改名为「' + v + '」');
      });
      sec.appendChild(hd);
      var list = document.createElement('div'); list.className = 'op-zone-list';
      if (!items.length) { var e = document.createElement('div'); e.className = 'op-zone-empty'; e.textContent = '还没有内容，点下面添加'; list.appendChild(e); }
      items.forEach(function (it, idx) {
        var row = document.createElement('div'); row.className = 'op-item'; row.dataset.opid = it.id;
        var top = document.createElement('div'); top.className = 'op-item-top';
        var name = document.createElement('span'); name.className = 'op-item-name'; name.textContent = it.name; name.title = '长按改名';
        opBindRename(name, function () { return it.name; }, function (v) {
          it.name = v; saveCfg(); opRenderPanel(); opUpdateNow({ visual: curVisual, music: curMusic }); toast('已改名');
        });
        var tag = document.createElement('span'); tag.className = 'op-item-tag'; tag.textContent = (it._dead ? '已失效 · ' : '') + (idx + 1) + '·' + (it.local ? '本地' : '预置');   /* v89：失效素材标注 */
        if (it._dead) row.style.opacity = '.45';
        /* v70：条目右侧不再放 ↑↓ 圆按钮（用户要求「不需要每个都加」），
           置顶/置底统一收到顶栏「排序」按钮的弹层里；条目前的 ≡ 握把仍可按住拖动排序。 */
        /* 左侧握把：按住拖动可自由换位（和音乐列表的拖动排序一致） */
        var grip = document.createElement('button'); grip.type = 'button'; grip.className = 'op-grip'; grip.title = '按住拖动排序';
        grip.innerHTML = '<svg viewBox="0 0 24 24"><path d="M8 6h8M8 12h8M8 18h8"/></svg>';
        top.appendChild(grip); top.appendChild(name); top.appendChild(tag);
        var btns = document.createElement('div'); btns.className = 'op-item-btns';
        var use = document.createElement('button'); use.textContent = '设为下次';
        use.addEventListener('click', function () { opSetNext(z.k, it); });
        var del = document.createElement('button'); del.className = 'op-del'; del.textContent = '删除';
        del.addEventListener('click', function () { opDelete(z.k, it.id); });
        [use, del].forEach(function (x) { btns.appendChild(x); });
        row.appendChild(top); row.appendChild(btns);
        opBindDrag(grip, z.k, row, list);
        /* v92q：双击条目＝预览原始内容（视频区播视频 / 音乐区放音乐 / 图片区看图） */
        row.addEventListener('dblclick', function (e) {
          try { e.stopPropagation(); } catch (eS1) {}
          opPreview(z.k, it);
        });
        list.appendChild(row);
      });
      sec.appendChild(list);
      var add = document.createElement('button'); add.className = 'op-zone-add'; add.textContent = z.add;
      add.addEventListener('click', function () { opAdd(z.k); });
      sec.appendChild(add);
      /* v92u（用户直派「加一个可以添加文件的功能」）：音乐区再加一个「添加文件」入口，
         不做任何类型拦截——文件形式全部放行，视频转的音乐一定进得来 */
      if (z.k === 'music') {
        var addAll = document.createElement('button'); addAll.className = 'op-zone-add';
        addAll.textContent = '＋ 添加文件';
        addAll.addEventListener('click', function () { opAdd(z.k, true); });
        sec.appendChild(addAll);
      }
      /* v92q：视频区/音乐区补一行说明（双击条目＝预览原始内容） */
      if (z.k === 'video') {
        var tipV = document.createElement('div'); tipV.className = 'op-zone-tip';
        tipV.textContent = '双击列表里的条目可以直接播放原视频预览；长按名字可改名。';
        sec.appendChild(tipV);
      }
      /* v92k：音乐区补一行上传说明，明确「点按钮＝从手机里选音频文件」 */
      if (z.k === 'music') {
        var tipU = document.createElement('div'); tipU.className = 'op-zone-tip';
        tipU.textContent = '「上传音乐文件」会打开手机文件管理器选歌（mp3 / m4a / wav / 视频转出来的音乐等，可多选），自动过滤真视频；「添加文件」不限制类型，选什么都能加进来。双击列表条目可直接试听；文件存在本机浏览器里，刷新、退出都不会丢，换设备请重新上传。';
        sec.appendChild(tipU);
      }
      host.appendChild(sec);
    });
    opFillNext();
    var a = $('op-auto'), vs = $('op-vsound');
    if (a) a.checked = !!cfg.auto;
    if (vs) vs.checked = !!cfg.vsound;
    opSyncSegs();
  }
  function opEnter() {
    /* v87：进度条先照常走；cfg 等异步兜底读完（最多 1.6s）再搭配播放，
       避免「存储未就绪 → 读到空 → 用默认搭配 → 默认媒体 404 → 白屏没视频没音乐」 */
    opProgress();
    opLoadCfgAsync().then(function (c) {
      if ($('page-opening').hidden) { cfg = c; return; }
      cfg = c;
      var n = opChoose();
      curVisual = n.visual; curMusic = n.music;
      opSyncSegs(); opUpdateNow(n);
      opPlayVisual(curVisual); opPlayMusic(curMusic);
      opRenderPanel();
    });
  }
  function opReplayMedia() {
    var n = opChoose();
    curVisual = n.visual; curMusic = n.music;
    opUpdateNow(n); opPlayVisual(curVisual); opPlayMusic(curMusic); opRenderPanel();
  }
  function opOpen() {
    var pg = $('page-opening'); if (!pg) return;
    /* v72：opStopMusic 只是「本次会话停」，重开开屏要按用户持久设置复位，
       否则从桌面图标再次打开开屏会没音乐。 */
    try { opMusicOff = localStorage.getItem('mochi-op-music-off') === '1'; } catch (eMo) {}
    pg.classList.remove('op-leaving');
    document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
    pg.hidden = false;
    document.querySelectorAll('.tab').forEach(function (t) { t.classList.remove('active'); });
    var pnl = $('op-panel'); if (pnl) pnl.hidden = true;
    opPill(false);
    opEnter();
  }
  /* v71：单击开屏＝只把音乐放出声（不进入），双击才进入。
     这段「手势起播」原先内嵌在 opDismiss 里，现在抽出来给单击复用。 */
  function opGesturePlay() {
    /* v85：恢复单击起播音乐；v92z：失败不再吞掉——起播被拒时重建元素重试，
       失败原因亮在左下角状态条上 */
    try {
      ensureAudio();
      if (opAudio && !opMusicOff) {
        opAudio.muted = false; opAudio.volume = 1;
        opSyncAudioToVideo();
        if (opAudio.paused) opAudioTryPlay();
        opAudioUnlocked = true;
      }
    } catch (eGp) {}
  }
  /* v63（参考 milk welcome-animation）：点开屏任意处＝淡出并进入网站桌面
     v71：改为只有双击才走这里；单击走 opGesturePlay()。 */
  function opDismiss() {
    var pg = $('page-opening'); if (!pg || pg.hidden || pg.classList.contains('op-leaving')) return;
    opDismissed = true;
    /* 选 B：进桌面不停音乐，起播后继续循环，直到悬浮开关 / 播放器收起才停。 */
    opGesturePlay();
    pg.classList.add('op-leaving');
    setTimeout(function () { opClose(); }, 330);
  }
  function opClose() {
    opDismissed = true;   /* v63：任何方式进入桌面后，进站兜底都不再把开屏弹回 */
    var _pgx = $('page-opening');
    if (_pgx) { _pgx.hidden = true; _pgx.classList.remove('op-leaving'); }
    opStopAll();
    var tab = document.querySelector('.tab[data-page="page-phone"]');
    if (tab) tab.click();
    else {
      document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
      var ph = $('page-phone'); if (ph) ph.hidden = false;
    }
    var pnl = $('op-panel'); if (pnl) pnl.hidden = true;
    /* v72：进桌面音乐已自动停，右下角「开屏音乐」小条不再出现 */
    setTimeout(function () { opPill(false); }, 420);
  }
  function bind() {
    var back = $('op-back'); if (back) back.addEventListener('click', opClose);
    var cb = $('op-cfg'); if (cb) cb.addEventListener('click', function () {
      /* v92i：播放态点「搭配」也切进配置模式。旧逻辑只把 hidden 置 false，
         但 CSS 里 #page-opening:not(.op-config) .op-panel 是 display:none!important，
         面板永远显示不出来＝用户反馈「开屏的设置点不开」。来自播放态时打上
         data-op-from-play 标记，关闭面板时回到播放态而不是设置页。 */
      var pgC = $('page-opening');
      if (pgC && !pgC.classList.contains('op-config')) {
        pgC.classList.add('op-config');
        pgC.setAttribute('data-op-from-play', '1');
        opPill(false);
        /* v92z：进搭配面板音乐必须停——面板是编辑环境，不是听歌环境 */
        try { if (opAudio) { opAudio.pause(); opAudio.muted = true; } } catch (eCf) {}
        try { clearInterval(opUnmuteTimer); } catch (eCf2) {}
      }
      $('op-panel').hidden = false; opRenderPanel();
    });
    var cl = $('op-panel-close'); if (cl) cl.addEventListener('click', function () {
      /* v65：从「设置 → 外观」进来的配置模式，关闭面板要回到设置页；开屏展示态只收面板 */
      if (window.opCloseConfig && $('page-opening') && $('page-opening').classList.contains('op-config')) window.opCloseConfig();
      else $('op-panel').hidden = true;
    });
    var rp = $('op-replay'); if (rp) rp.addEventListener('click', function () { opEnter(); toast('正在重新连接…'); });
    document.querySelectorAll('#op-mode-seg button, .op-seg-mode button').forEach(function (b) {
      b.addEventListener('click', function () { cfg.mode = b.dataset.mode; saveCfg(); opSyncSegs(); opReplayMedia(); });
    });
    document.querySelectorAll('#op-pair-seg button, .op-seg-pair button').forEach(function (b) {
      b.addEventListener('click', function () {
        cfg.pair = b.dataset.pair;
        if (cfg.next && cfg.next.pair !== cfg.pair) cfg.next = null;
        saveCfg(); opEnter();
      });
    });
    var ns = $('op-next-save');
    if (ns) ns.addEventListener('click', function () {
      var v = $('op-next-visual').value, m = $('op-next-music').value;
      cfg.next = (!v && !m) ? null : { pair: cfg.pair, visualId: v, musicId: m };
      saveCfg(); opRenderPanel(); toast(cfg.next ? '已保存，下一次进页面生效' : '已清除预设');
    });
    var nc = $('op-next-clear');
    if (nc) nc.addEventListener('click', function () { cfg.next = null; saveCfg(); opRenderPanel(); toast('已清除预设'); });
    var au = $('op-auto'); if (au) au.addEventListener('change', function () { cfg.auto = this.checked; saveCfg(); });
    var vs = $('op-vsound'); if (vs) vs.addEventListener('change', function () {
      cfg.vsound = this.checked; saveCfg();
      try { $('op-video').muted = !cfg.vsound; } catch (e) {}
    });
    var stage = $('page-opening');
    /* v71：单击只放音乐、双击（约 320ms 内的第二下）才淡出进入网站。
       自己按「时间＋坐标」判双击，不依赖 dblclick——触屏上 dblclick 经常不触发。 */
    var opTapAt = 0, opTapX = 0, opTapY = 0;
    if (stage) stage.addEventListener('click', function (e) {
      /* v65：配置模式（设置 → 外观 → 开屏搭配设置）下点面板控件不进入桌面。 */
      if (stage.classList.contains('op-config')) return;
      var t = e.target;
      if (t && t.closest && t.closest('.op-panel')) return;
      var now = Date.now ? Date.now() : (new Date()).getTime();
      var x = e.clientX || 0, y = e.clientY || 0;
      if (now - opTapAt < 320 && Math.abs(x - opTapX) < 48 && Math.abs(y - opTapY) < 48) {
        opTapAt = 0;
        opDismiss();     /* 双击 → 进入网站 */
        return;
      }
      opTapAt = now; opTapX = x; opTapY = y;
      opGesturePlay();   /* 单击 → 只把音乐放出声 */
    });
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest ? e.target.closest('.app[data-app="opening"]') : null;
      if (!t) return;
      var ph = $('page-phone');
      if (ph && ph.classList.contains('decor-on')) return;
      if (t.closest('.app-grid.editing')) return;
      e.stopPropagation(); e.preventDefault();
      opOpen();
    }, true);
    /* v67b：能放行的浏览器（多数真机 Chrome/Safari 允许静音自动播放）会在这轮重试里起播；
       严格策略下仍被拦也只会安静失败，等首次手势立刻出声。 */
    var _audioTries = 0;
    setInterval(function () {
      if (_audioTries > 16) return;
      var pg2 = $('page-opening');
      if (!pg2 || pg2.hidden || pg2.classList.contains('op-config') || !opAudio || opMusicOff || opAudioUnlocked) return;
      if (!opAudio.paused) return;
      _audioTries++;
      opFallbackMutedPlay();
      opAlignOnce();
    }, 600);
    var pg = $('page-opening');
    if (pg && window.MutationObserver) {
      new MutationObserver(function () { if (pg.hidden) opStopAll(); }).observe(pg, { attributes: true, attributeFilter: ['hidden'] });
    }
    /* v70：切到播放器 / 音乐 / 设置等页面时收起「开屏音乐」小条（只在桌面主页显示） */
    try {
      document.querySelectorAll('.page').forEach(function (p) {
        new MutationObserver(function () { opPillSync(); }).observe(p, { attributes: true, attributeFilter: ['hidden'] });
      });
    } catch (ePv) {}
    window.opOpenScreen = opOpen;
    window.opCloseScreen = opClose;
    window.opStopMusic = opStopMusic;
    window.opPill = opPill;
    window.opMusicPlaying = function () { try { return !!(opAudio && !opMusicOff && !opAudio.paused); } catch (eMp) { return false; } };
    window.opMusicIsOn = function () { return !opMusicOff; };
    window.opSetOpMusic = function (en) {
      opMusicOff = !en;
      try {
        if (en) localStorage.removeItem('mochi-op-music-off');
        else localStorage.setItem('mochi-op-music-off', '1');
      } catch (eLs) {}
      if (en) {
        var _pgS = $('page-opening');
        try {
          /* v93a：只在开屏页正以播放态显示时才起播；
             在桌面/设置里开开关＝只记偏好，下次开屏生效，绝不现场放歌
             （旧代码在开屏页隐藏时反而 play()，音乐就在桌面里响出来） */
            if (opAudio && _pgS && !_pgS.hidden && !_pgS.classList.contains('op-config')) {
            opAudio.muted = false; opAudio.volume = 1;
            if (opAudio.paused) { var p = opAudio.play(); if (p && p.catch) p.catch(function () {}); }
          }
        } catch (eEn) {}
      } else opStopMusic();
    };
    /* v66：桌面「播放器」收起＝主动关闭开屏音乐（对应「主动关闭才会消失」） */
    document.addEventListener('click', function (e) {
      var t = e.target; if (!t || !t.closest) return;
      if (t.closest('#npClose')) { try { opStopMusic(); } catch (eNp) {} }
    }, true);
    /* v65：设置 → 外观 → 开屏搭配设置。只显示搭配面板、不重新搭配也不播放；
       关闭时回到设置页「外观」分区，开屏进站展示态完全不受影响。 */
    window.opOpenConfig = function () {
      var pg2 = $('page-opening'); if (!pg2) return;
      pg2.classList.remove('op-leaving');
      document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
      pg2.hidden = false;
      pg2.classList.remove('op-config');
      pg2.removeAttribute('data-op-from-play');   /* v92i：清掉播放态来源标记 */
      pg2.classList.add('op-config');
      opPill(false);   /* v70：配置面板打开时先收起右下角「开屏音乐」小条，别挡住排序按钮 */
      /* v92z：进搭配面板音乐必须停——面板是编辑环境，不是听歌环境 */
      try { if (opAudio) { opAudio.pause(); opAudio.muted = true; } } catch (eCf) {}
      try { clearInterval(opUnmuteTimer); } catch (eCf2) {}
      var pnl = $('op-panel'); if (pnl) pnl.hidden = false;
      opRenderPanel();
    };
    window.opRenderPanel = opRenderPanel;   /* v92p：导入数据后刷新面板列表 */
    window.opCloseConfig = function () {
      var pg2 = $('page-opening');
      /* v92i：来自开屏播放态（点「搭配」进来）时，关闭面板＝回到播放态继续开屏；
         从「设置 → 外观」进来的才回设置页。 */
      var fromPlay = !!(pg2 && pg2.getAttribute('data-op-from-play') === '1');
      if (pg2) { pg2.removeAttribute('data-op-from-play'); pg2.classList.remove('op-config'); pg2.hidden = fromPlay ? false : true; }
      if (fromPlay) {
        var pnl0 = $('op-panel'); if (pnl0) pnl0.hidden = true;
        try { opReplayMedia(); } catch (eR) {}
        setTimeout(function () { opPill(true); }, 320);
        return;
      }
      if (pg2) { pg2.hidden = true; }
      opStopAll();
      var pnl = $('op-panel'); if (pnl) pnl.hidden = true;
      opDismissed = true;
      var tab = document.querySelector('.tab[data-page="page-setting"]');
      if (tab) tab.click();
      else {
        document.querySelectorAll('.page').forEach(function (p) { p.hidden = true; });
        var s = $('page-setting'); if (s) s.hidden = false;
      }
      setTimeout(function () {
        var t = document.querySelector('#set-tabs .them-tab[data-tab="look"]');
        if (t) t.click();
      }, 60);
      /* v72：回设置页时开屏音乐同样已停，不再恢复小条 */
      setTimeout(function () { opPill(false); }, 320);
    };
  }
  cfg = loadCfg();
  bind();
  /* v63（参考 milk welcome-animation 默认可见、加载完淡出）：进站/刷新＝先自动显示开屏，
     点任意处淡出进入网站。用 opDismissed 门控，用户点过之后不再被启动兜底弹回。 */
  var opBootN = 0;
  function opBoot() {
    if (opDismissed || opBootN > 3) return;
    var pg = $('page-opening');
    if (pg && pg.hidden) { opBootN++; opOpen(); }
  }
  opBoot();
  document.addEventListener('DOMContentLoaded', function () { setTimeout(opBoot, 0); });
  window.addEventListener('load', function () { setTimeout(opBoot, 60); setTimeout(opBoot, 420); });
  setTimeout(opBoot, 900);
})();
</script>

<script>
/* v65：设置 → 外观 接线（开屏入口 + 全局字体切换） */
(function () {
  'use strict';
  function $(id) { return document.getElementById(id); }

  document.addEventListener('click', function (e) {
    var t = e.target; if (!t || !t.closest) return;
    if (t.closest('#row-opening-open')) {
      if (window.opOpenScreen) window.opOpenScreen();
      return;
    }
    if (t.closest('#row-opening-config')) {
      if (window.opOpenConfig) window.opOpenConfig();
      return;
    }
  }, true);

  var FONTS = [
    { k: 'default', n: '系统默认', css: "'PingFang SC','Microsoft YaHei',-apple-system,sans-serif" },
    { k: 'hei',     n: '黑体',     css: "'Heiti SC','SimHei','Microsoft YaHei',sans-serif" },
    { k: 'song',    n: '宋体',     css: "'Songti SC','SimSun','Noto Serif CJK SC',serif" },
    { k: 'kai',     n: '楷体',     css: "'Kaiti SC','KaiTi','STKaiti',serif" },
    { k: 'yuan',    n: '圆体',     css: "'Yuanti SC','PingFang SC','Microsoft YaHei',sans-serif" },
    { k: 'mono',    n: '等宽',     css: "'SF Mono','Menlo','Consolas','Courier New',monospace" }
  ];
  var KEY = 'mochi-app-font';

  function readKey() { try { return localStorage.getItem(KEY) || 'default'; } catch (e) { return 'default'; } }
  function byKey(k) { for (var i = 0; i < FONTS.length; i++) { if (FONTS[i].k === k) return FONTS[i]; } return FONTS[0]; }

  function apply(k) {
    var f = byKey(k);
    try { document.documentElement.style.setProperty('--mochi-font', f.css); } catch (e) {}
    try { localStorage.setItem(KEY, f.k); } catch (e) {}
    var val = $('font-val'); if (val) val.textContent = f.n;
    var pv = $('fp-preview'); if (pv) pv.style.fontFamily = f.css;
    var list = $('fp-list');
    if (list) list.querySelectorAll('.fp-item').forEach(function (b) { b.classList.toggle('on', b.dataset.k === f.k); });
  }

  function render() {
    var list = $('fp-list'); if (!list) return;
    list.innerHTML = '';
    FONTS.forEach(function (f) {
      var b = document.createElement('button');
      b.className = 'fp-item'; b.type = 'button'; b.dataset.k = f.k;
      b.textContent = f.n; b.style.fontFamily = f.css;
      b.addEventListener('click', function () {
        apply(f.k);
        try { if (window.toast) window.toast('字体已切换为「' + f.n + '」'); } catch (eT) {}
      });
      list.appendChild(b);
    });
  }

  render();
  apply(readKey());

  /* ============ v66：开屏外观（背景 / 加载条 / 文字颜色） ============
     取色器复用「聊天设置 → 美化 → 气泡颜色」同款写法：
     openModal({ colorPicker:true, color:cur, swatches:[{color,label}] })，
     回调 v 为色板索引（number）或自定义颜色字符串。 */
  var OP_SW = [
    { color: '#ffffff', label: '白色' },
    { color: '#111111', label: '默认黑' },
    { color: '#444444', label: '深灰' },
    { color: '#f5f5f7', label: '雾白' },
    { color: '#ffd6e0', label: '樱花粉' },
    { color: '#d6e4ff', label: '雾霭蓝' },
    { color: '#d8f5e0', label: '薄荷绿' },
    { color: '#fff3d6', label: '奶油黄' },
    { color: '#e8dcff', label: '淡紫' },
    { color: '#ffdcc0', label: '暖橘' },
    { color: '#d6336c', label: '玫红' },
    { color: '#1a56db', label: '蓝' },
    { color: '#1e8e5a', label: '绿' },
    { color: '#7048e8', label: '紫' }
  ];
  var OP_ROWS = [
    { row: 'row-op-bg',   val: 'op-bg-val',   key: 'mochi-op-bg',   def: '#ffffff', css: '--op-bg',         title: '开屏背景颜色' },
    { row: 'row-op-bar',  val: 'op-bar-val',  key: 'mochi-op-bar',  def: '#111111', css: '--op-load-bar',  title: '加载条颜色' },
    { row: 'row-op-text', val: 'op-text-val', key: 'mochi-op-text', def: '#111111', css: '--op-load-text', title: '加载条文字颜色' }
  ];
  function opGet(key, def) { try { return localStorage.getItem(key) || def; } catch (e) { return def; } }
  function opApplyColors() {
    OP_ROWS.forEach(function (r) {
      var c = opGet(r.key, r.def);
      try { document.documentElement.style.setProperty(r.css, c); } catch (e) {}
      var v = $(r.val); if (v) v.textContent = (c === r.def ? '默认 ' : '') + c;
    });
  }
  OP_ROWS.forEach(function (r) {
    var el = $(r.row); if (!el) return;
    el.addEventListener('click', function () {
      if (!window.openModal) return;
      window.openModal(r.title, '', function (v) {
        var color = (typeof v === 'number' && OP_SW[v]) ? OP_SW[v].color : v;
        if (!color) return;
        try { localStorage.setItem(r.key, color); } catch (e) {}
        opApplyColors();
        try { if (window.toast) window.toast(r.title + '已更换为 ' + color); } catch (eT) {}
      }, { colorPicker: true, color: opGet(r.key, r.def), swatches: OP_SW });
    });
  });
  opApplyColors();

  /* v67：开屏音乐总开关（默认开）。
     旧版只监听 checkbox 的 change：手机上点整行没反应、点开关本体偶尔也不冒泡，
     用户看到的就是「点了没效果」。现在整行可点：capture 里 preventDefault 后自己翻转状态，
     不再依赖 label 转发 / 冒泡，一次点击一定生效。 */
  var opMusicEn = $('op-music-en');
  if (opMusicEn) {
    var on0 = true; try { on0 = localStorage.getItem('mochi-op-music-off') !== '1'; } catch (e0) {}
    opMusicEn.checked = on0;
    var lastEn = on0;
    var applyEn = function (v, tip) {
      opMusicEn.checked = v;
      if (v === lastEn) { if (tip) { try { if (window.toast) window.toast(v ? '开屏音乐本来就是开的' : '开屏音乐本来就是关的'); } catch (eT0) {} } return; }
      lastEn = v;
      try { if (window.opSetOpMusic) window.opSetOpMusic(v); } catch (eS) {}
      try { if (window.toast) window.toast(v ? '开屏音乐已开启' : '开屏音乐已关闭（进站不再播放）'); } catch (eT) {}
    };
    opMusicEn.addEventListener('change', function () { applyEn(opMusicEn.checked, false); });
    var rowM = $('row-op-music');
    if (rowM) rowM.addEventListener('click', function (e) {
      try { e.preventDefault(); } catch (eP) {}
      applyEn(!opMusicEn.checked, true);
    }, true);
  }

  /* ============ v67：开屏背景照片 ============
     存本机（压缩后 dataURL），作为开屏底图垫在视频/图片下面，不影响任何搭配。 */
  var BG_KEY = 'mochi-op-bgimg';
  function opBgGet() { try { return localStorage.getItem(BG_KEY) || ''; } catch (e) { return ''; } }
  function opApplyBgImg() {
    var v = opBgGet();
    var el = document.getElementById('op-bgimg');
    if (el) {
      if (v) { el.style.backgroundImage = 'url("' + v + '")'; el.classList.add('on'); }
      else { el.style.backgroundImage = ''; el.classList.remove('on'); }
    }
    var lab = $('op-bgimg-val'); if (lab) lab.textContent = v ? '已设置（点这里更换）' : '未设置';
    var rm = $('row-op-bgimg-rm'); if (rm) rm.hidden = !v;
  }
  function opSetBgImg(dataUrl) {
    if (!dataUrl) return;
    try { localStorage.setItem(BG_KEY, dataUrl); }
    catch (eLs) { try { if (window.toast) window.toast('这张图太大存不进本机，换一张小一点的'); } catch (eT) {} return; }
    opApplyBgImg();
    try { if (window.toast) window.toast('开屏背景照片已设置'); } catch (eT2) {}
  }
  var bgRow = $('row-op-bgimg');
  if (bgRow) bgRow.addEventListener('click', function () {
    var inp = document.createElement('input');
    inp.type = 'file'; inp.accept = 'image/*';
    inp.addEventListener('change', function () {
      var f = (inp.files || [])[0]; if (!f) return;
      var fr = new FileReader();
      fr.onload = function () {
        var raw = String(fr.result || '');
        if (window.compressImageFit) {
          Promise.resolve(window.compressImageFit(raw, 1440, 700 * 1024)).then(opSetBgImg, function () { opSetBgImg(raw); });
        } else opSetBgImg(raw);
      };
      fr.onerror = function () { try { if (window.toast) window.toast('这张图读不了'); } catch (e) {} };
      fr.readAsDataURL(f);
    });
    inp.click();
  });
  var bgRm = $('row-op-bgimg-rm');
  if (bgRm) bgRm.addEventListener('click', function () {
    try { localStorage.removeItem(BG_KEY); } catch (e) {}
    opApplyBgImg();
    try { if (window.toast) window.toast('已移除开屏背景照片'); } catch (e1) {}
  });
  opApplyBgImg();
})();
</script>

<script>
/* ===== v67：桌面图标整理 =====
   ① 长按任意桌面图标（约 0.5 秒）→ 直接进「整理模式」，不用再进装修 → 编辑布局；
   ② 整理模式里拖动图标可自由换位、拖到屏幕两边自动翻页（复用原有拖拽）；
   ③ 把一个图标拖到另一个图标上松手 → 聚拢成一个分组；点分组图标展开成员，可解散。 */
(function () {
  'use strict';
  var GKEY = 'mochi-desk-groups-v67';
  var PH = document.getElementById('page-phone');
  if (!PH) return;

  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function loadGroups() { try { var a = JSON.parse(localStorage.getItem(GKEY) || '[]'); return Array.isArray(a) ? a : []; } catch (e) { return []; } }
  function saveGroups(a) { try { localStorage.setItem(GKEY, JSON.stringify(a)); } catch (e) {} }
  function appEl(k) { return document.querySelector('.app[data-app="' + k + '"]'); }
  function keyOf(el) { return el && el.getAttribute ? el.getAttribute('data-app') : ''; }
  function moveModeOn() { return PH.classList.contains('decor-on'); }

  /* ---------- 聚拢 / 展开 ---------- */
  function applyGroups() {
    var groups = loadGroups();
    /* 少于两个成员的分组自动解散 */
    var kept = groups.filter(function (g) {
      g.members = (g.members || []).filter(function (k) { return !!appEl(k); });
      /* v74：每组最多 4 个，历史多出来的放回桌面 */
      if (g.members.length > 4) g.members = g.members.slice(0, 4);
      return g.members.length >= 2;
    });
    if (kept.length !== groups.length) saveGroups(kept);
    var ids = kept.map(function (g) { return g.id; });

    /* 清掉已解散的收纳盒，把成员放回网格 */
    Array.prototype.slice.call(document.querySelectorAll('.df-hold')).forEach(function (h) {
      if (ids.indexOf(h.getAttribute('data-fid')) >= 0) return;
      Array.prototype.slice.call(h.querySelectorAll('.app')).forEach(function (a) {
        /* v79（用户直派「在本页解散分组后图标回到本页」）：优先放回分组所在的这一页 */
        var sl = h.closest('.page-slide');
        var g0 = (sl && sl.querySelector('.app-grid')) || document.querySelector('.app-grid[data-app="main"]') || document.querySelector('.app-grid');
        if (g0) g0.appendChild(a);
        a.classList.remove('in-folder');
        try { a.style.transform = ''; } catch (e0) {}
      });
      h.remove();
    });
    Array.prototype.slice.call(document.querySelectorAll('.desk-folder')).forEach(function (f) {
      if (ids.indexOf(f.getAttribute('data-fid')) < 0) f.remove();
    });

    kept.forEach(function (g) {
      /* v82（用户直派「分组跟普通图标一样可以移动位置和页面」）：
         ① 分组图标已存在的位置优先（拖动后不被弹回成员所在页）；
         ② 位置持久化——网格顺序表里用 'folder:<id>' 记录分组图标的位置，
            applyGroups 每次重建都按顺序表放回，跨页拖动也能站住。 */
      var fkey = 'folder:' + g.id;
      var f = document.querySelector('.desk-folder[data-fid="' + g.id + '"]');
      var hostGrid = null, slide = null, firstInGrid = null;
      if (f && f.closest('.app-grid')) hostGrid = f.closest('.app-grid');
      if (!hostGrid) {
        for (var i = 0; i < g.members.length; i++) {
          var a0 = appEl(g.members[i]);
          if (!a0) continue;
          var hg = a0.closest('.app-grid');
          if (hg) { hostGrid = hg; slide = hg.closest('.page-slide'); firstInGrid = a0; break; }
          var hd = a0.closest('.df-hold');
          if (hd && hd.closest('.page-slide')) {
            slide = hd.closest('.page-slide');
            hostGrid = slide.querySelector('.app-grid');
            break;
          }
        }
      }
      if (!hostGrid) { if (f && f.parentNode) f.parentNode.removeChild(f); return; }
      if (!slide) slide = hostGrid.closest('.page-slide');
      if (!f) {
        f = document.createElement('div');
        f.className = 'app desk-folder';
        f.setAttribute('data-fid', g.id);
        f.innerHTML = '<div class="app-ico"><span class="df-grid"></span></div><div class="app-name"></div>';
      }
      if (f.parentNode !== hostGrid) hostGrid.appendChild(f);
      (function placeFolder() {
        /* v82：顺序表以 store 为准（localStorage 只是滞后镜像，读它会把分组弹回原位） */
        var ord = null;
        try {
          var _st = (window.activeStore && window.activeStore()) || null;
          var raw = _st ? _st.get('app-icon-order-' + (hostGrid.getAttribute('data-app') || '')) : null;
          if (raw == null) raw = localStorage.getItem('app-icon-order-' + (hostGrid.getAttribute('data-app') || ''));
          ord = JSON.parse(raw || '[]');
        } catch (eO) { ord = null; }
        if (Array.isArray(ord) && ord.indexOf(fkey) >= 0) {
          for (var oi = ord.indexOf(fkey) + 1; oi < ord.length; oi++) {
            var ck = String(ord[oi]), ref = null;
            if (ck.indexOf('folder:') === 0) ref = hostGrid.querySelector('.desk-folder[data-fid="' + ck.slice(7) + '"]');
            else ref = hostGrid.querySelector('.app[data-app="' + ck + '"]');
            if (ref && ref.parentNode === hostGrid && ref !== f) { hostGrid.insertBefore(f, ref); return; }
          }
          hostGrid.appendChild(f);
          return;
        }
        /* 没有顺序记录：能找到成员就放成员前，否则留在原地（不跳） */
        if (firstInGrid && firstInGrid.parentElement === hostGrid) hostGrid.insertBefore(f, firstInGrid);
      })();
      /* v82：收纳盒跟随分组所在页（跨页拖动后成员盒也搬过去） */
      var hold = null;
      Array.prototype.slice.call(document.querySelectorAll('.df-hold[data-fid="' + g.id + '"]')).forEach(function (h) {
        if (!hold || (slide && h.closest('.page-slide') === slide)) hold = h;
      });
      if (!hold) {
        hold = document.createElement('div');
        hold.className = 'df-hold'; hold.setAttribute('data-fid', g.id);
      }
      if (slide && hold.closest('.page-slide') !== slide) slide.appendChild(hold);
      else if (!hold.parentNode && slide) slide.appendChild(hold);
      var mini = f.querySelector('.df-grid');
      if (mini) mini.innerHTML = '';
      var shown = 0;
      g.members.forEach(function (k) {
        var a = appEl(k); if (!a) return;
        if (shown < 4) {
          var m = document.createElement('span'); m.className = 'df-mini';
          var ico = a.querySelector('.app-ico');
          if (ico) m.innerHTML = ico.innerHTML;
          if (mini) mini.appendChild(m);
          shown++;
        }
        if (a.parentNode !== hold) hold.appendChild(a);
        a.classList.add('in-folder');
      });
      var nm = f.querySelector('.app-name');
      if (nm) nm.textContent = g.name || ('分组 ' + g.members.length);
    });
    /* v83（用户直派「分组返回不能出现盖在组件上的情况」）：
       分组图标（含返回分组弹层后重建的位置）如果压在桌面小组件卡片上，
       自动让位：先撤自由摆放偏移，还压着就换一个不压组件的格子。
       每次分组形态重建（返回弹层 / 拖动落定 / 桌面重建）都会跑一遍。 */
    try { keepFolderOffWidgets(true); } catch (eK0) {}
  }
  /* v83：找出页面上真正可见的「小组件卡片」（排除图标网格和图标本身） */
  function qdWidgets() {
    return Array.prototype.slice.call(document.querySelectorAll('[data-desk-widget]')).filter(function (w) {
      var k = w.getAttribute('data-desk-widget') || '';
      if (k === 'apps' || k === 'p2apps' || k === 'p3apps' || k.indexOf('app-') === 0) return false;
      if (w.closest('.app-grid') || w.closest('.df-hold')) return false;
      var r = w.getBoundingClientRect();
      return r.width > 8 && r.height > 8;
    });
  }
  function folderOverWidget(f, cards) {
    var r = f.getBoundingClientRect();
    if (!r.width || !r.height) return false;
    for (var i = 0; i < cards.length; i++) {
      var w = cards[i].getBoundingClientRect();
      var ox = Math.min(r.right, w.right) - Math.max(r.left, w.left);
      var oy = Math.min(r.bottom, w.bottom) - Math.max(r.top, w.top);
      if (ox > 2 && oy > 2 && (ox * oy) >= r.width * r.height * 0.25) return true;
    }
    return false;
  }
  function keepFolderOffWidgets(silent) {
    var cards = qdWidgets();
    if (!cards.length) return false;
    var fixed = false;
    Array.prototype.slice.call(document.querySelectorAll('.app-grid .desk-folder')).forEach(function (f) {
      if (f.closest('.df-hold')) return;
      if (!folderOverWidget(f, cards)) return;
      /* ① 先撤自由摆放偏移——「盖上去」多半是偏移残留 */
      if (f.style.transform && f.style.transform !== 'none') {
        f.style.transform = ''; f.classList.remove('desk-moved');
        try {
          var grid0 = f.closest('.app-grid');
          var gid0 = grid0 ? (grid0.getAttribute('data-app') || '') : '';
          var fk = 'folder:' + (f.getAttribute('data-fid') || '');
          var o = JSON.parse(localStorage.getItem('mochi-desk-offsets-v79') || '{}') || {};
          if (o[gid0] && o[gid0][fk]) { delete o[gid0][fk]; localStorage.setItem('mochi-desk-offsets-v79', JSON.stringify(o)); }
        } catch (e0) {}
        if (!folderOverWidget(f, cards)) { fixed = true; return; }
      }
      /* ② 网格格子本身在组件底下：逐个插入位试，选第一个不压组件的 */
      var grid = f.closest('.app-grid');
      if (!grid) return;
      var kids = Array.prototype.slice.call(grid.children).filter(function (c) { return c !== f; });
      var done = false;
      for (var ci = 0; ci < kids.length && !done; ci++) {
        grid.insertBefore(f, kids[ci]);
        if (!folderOverWidget(f, cards)) done = true;
      }
      if (!done) grid.appendChild(f);
      fixed = true;
    });
    if (fixed && !silent) { try { toast('分组图标不能盖在组件上，已自动让位'); } catch (eT) {} }
    return fixed;
  }
  window.__folderKeepOffWidgets = keepFolderOffWidgets;
  window.__deskGroupsRefresh = applyGroups;

  function addToGroup(a, b) {
    var ka = keyOf(a), kb = keyOf(b);
    if (!ka || !kb || ka === kb) return;
    var groups = loadGroups();
    var ga = null, gb = null, i;
    for (i = 0; i < groups.length; i++) {
      if (groups[i].members.indexOf(ka) >= 0) ga = groups[i];
      if (groups[i].members.indexOf(kb) >= 0) gb = groups[i];
    }
    /* v74：分组上限 4 个 */
    if (ga && gb && ga !== gb) {
      var merged = ga.members.concat(gb.members.filter(function (k) { return ga.members.indexOf(k) < 0; }));
      if (merged.length > 4) { toast('每个分组最多 4 个图标'); return; }
      ga.members = merged;
      groups = groups.filter(function (g) { return g.id !== gb.id; });
    } else if (ga) {
      if (ga.members.indexOf(kb) < 0) {
        if (ga.members.length >= 4) { toast('每个分组最多 4 个图标'); return; }
        ga.members.push(kb);
      }
    } else if (gb) {
      if (gb.members.indexOf(ka) < 0) {
        if (gb.members.length >= 4) { toast('每个分组最多 4 个图标'); return; }
        gb.members.unshift(ka);
      }
    } else {
      groups.push({ id: 'g' + Date.now().toString(36) + Math.floor(Math.random() * 900 + 100), name: '分组', members: [ka, kb] });
    }
    saveGroups(groups);
    applyGroups();
    toast('已聚拢成一个分组（最多 4 个），点分组图标可以展开');
  }

  /* v74：拖到已有分组图标上＝加进这个分组 */
  function addElToGroup(a, fid) {
    var ka = keyOf(a);
    if (!ka || !fid) return;
    var groups = loadGroups();
    var g = groups.filter(function (x) { return x.id === fid; })[0];
    if (!g) return;
    if (g.members.indexOf(ka) >= 0) return;
    if (g.members.length >= 4) { toast('每个分组最多 4 个图标'); return; }
    groups.forEach(function (o) { if (o !== g) o.members = o.members.filter(function (k) { return k !== ka; }); });
    g.members.push(ka);
    saveGroups(groups.filter(function (x) { return x.members.length >= 2; }));
    applyGroups();
    toast('已放进分组（' + g.members.length + '/4）');
    try { if (navigator.vibrate) navigator.vibrate(18); } catch (e) {}
    try { if (navigator.vibrate) navigator.vibrate(22); } catch (e) {}
  }

  function openSheet(fid) {
    var groups = loadGroups();
    var g = groups.filter(function (x) { return x.id === fid; })[0];
    if (!g) return;
    var mask = document.createElement('div');
    mask.className = 'dfx-mask';
    var items = g.members.map(function (k) {
      var a = appEl(k);
      var nm = a && a.querySelector('.app-name') ? a.querySelector('.app-name').textContent : k;
      var ico = a && a.querySelector('.app-ico') ? a.querySelector('.app-ico').innerHTML : '';
      return '<button class="dfx-item" data-k="' + k + '"><span class="dfx-ico">' + ico + '</span><span class="dfx-nm">' + nm + '</span></button>';
    }).join('');
    mask.innerHTML = '<div class="dfx-card"><div class="dfx-hd"><b>分组 · ' + g.members.length + ' 个图标</b><button class="dfx-x">✕</button></div>' +
      '<div class="dfx-grid">' + items + '</div>' +
      '<div class="dfx-btns"><button id="dfx-ungroup">解散分组</button><button id="dfx-close">完成</button></div></div>';
    document.body.appendChild(mask);
    function close() {
      try { window.__dfxClosedAt = Date.now(); } catch (eT) {}   /* v86：关闭时刻，拦穿透重开 */
      mask.remove();
    }
    mask.querySelector('.dfx-x').addEventListener('click', close);
    mask.querySelector('#dfx-close').addEventListener('click', close);
    mask.addEventListener('click', function (e) { if (e.target === mask) close(); });
    mask.querySelector('#dfx-ungroup').addEventListener('click', function () {
      var all = loadGroups().filter(function (x) { return x.id !== fid; });
      saveGroups(all);
      close();
      applyGroups();
      toast('已解散分组');
    });
    mask.querySelectorAll('.dfx-item').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var k = btn.getAttribute('data-k');
        close();
        setTimeout(function () {
          var a = appEl(k);
          if (a) { try { a.click(); } catch (e) {} }
        }, 60);
      });
    });
  }

  /* ---------- 长按进整理 ---------- */
  var lpT = null, lpEl = null, lx = 0, ly = 0, suppressUntil = 0;
  function cancelLp() { if (lpT) { clearTimeout(lpT); lpT = null; } lpEl = null; }
  PH.addEventListener('pointerdown', function (e) {
    if (e.button && e.button !== 0) return;
    if (moveModeOn()) return;
    var el = e.target.closest ? e.target.closest('.app') : null;
    if (!el) return;
    /* v82：分组图标跟普通图标一样——长按也能进整理模式（点按仍是展开分组） */
    lpEl = el; lx = e.clientX; ly = e.clientY;
    if (lpT) clearTimeout(lpT);
    lpT = setTimeout(function () {
      lpT = null;
      if (!lpEl) return;
      suppressUntil = Date.now() + 1000;
      try { if (navigator.vibrate) navigator.vibrate(18); } catch (ev) {}
      try { if (window.__deskEnterMoveMode) window.__deskEnterMoveMode(); } catch (e2) {}
      toast('整理模式：拖动图标换位／点图标可设置和分组／完成退出');
      lpEl = null;
    }, 520);
  }, true);
  PH.addEventListener('pointermove', function (e) {
    if (!lpEl) return;
    if (Math.abs(e.clientX - lx) > 10 || Math.abs(e.clientY - ly) > 10) cancelLp();
  }, true);
  PH.addEventListener('pointerup', cancelLp, true);
  PH.addEventListener('pointercancel', cancelLp, true);

  /* 长按刚触发时，随后的 click 不要再打开应用 */
  PH.addEventListener('click', function (e) {
    if (Date.now() < suppressUntil) {
      try { e.stopPropagation(); e.preventDefault(); } catch (e0) {}
    }
  }, true);

  /* ---------- 松手时判断有没有落在另一个图标上 ---------- */
  PH.addEventListener('pointerup', function () {
    /* v78：去掉「拖到另一个图标上聚拢」——分组统一到「图标设置 → 分组」里勾选 */
    return;
    if (!moveModeOn()) return;
    var clone = document.querySelector('.desk-drag-clone');
    var drag = PH.querySelector('.desk-dragging');
    if (!clone || !drag || !drag.classList.contains('app')) return;
    if (drag.classList.contains('desk-folder')) return;
    var r1 = clone.getBoundingClientRect();
    if (!r1.width || !r1.height) return;
    var best = null, bestOv = 0, bestFolder = null;
    Array.prototype.slice.call(PH.querySelectorAll('.page-slide .app')).forEach(function (a) {
      if (a === drag) return;
      var isFolder = a.classList.contains('desk-folder');
      if (!isFolder && a.closest('.df-hold')) return;
      var r2 = a.getBoundingClientRect();
      if (!r2.width || !r2.height) return;
      var ox = Math.min(r1.right, r2.right) - Math.max(r1.left, r2.left);
      var oy = Math.min(r1.bottom, r2.bottom) - Math.max(r1.top, r2.top);
      if (ox <= 0 || oy <= 0) return;
      var ov = (ox * oy) / Math.min(r1.width * r1.height, r2.width * r2.height);
      if (ov > bestOv) { bestOv = ov; best = a; bestFolder = isFolder ? a : null; }
    });
    if (best && bestOv >= 0.34) {
      if (bestFolder) addElToGroup(drag, bestFolder.getAttribute('data-fid'));
      else addToGroup(drag, best);
    }
  }, true);

  /* ---------- 点分组图标 = 展开 ---------- */
  PH.addEventListener('click', function (e) {
    var f = e.target.closest ? e.target.closest('.desk-folder') : null;
    if (!f) return;
    /* v82：装修/整理模式里点分组＝交给图标设置，不展开 */
    if (moveModeOn() || PH.classList.contains('decor-on')) return;
    /* v86（用户直派「点开分组要摁两次才能关掉」）：关闭分组的那个手势会穿透到底下的
       分组图标上，把面板又打开一次——关闭后 380ms 内不再响应打开。 */
    try { if (window.__dfxClosedAt && Date.now() - window.__dfxClosedAt < 380) return; } catch (eC) {}
    try { e.preventDefault(); e.stopPropagation(); } catch (e0) {}
    openSheet(f.getAttribute('data-fid'));
  }, true);

  /* ---------- 各种时机保持分组形态 ---------- */
  document.addEventListener('contact-switched', function () { setTimeout(applyGroups, 90); });
  document.addEventListener('decor-exited', function () { setTimeout(applyGroups, 90); });
  /* 桌面布局重建（切联系人 / 加删页 / 装修落盘）后也把分组折回去 */
  try {
    var _dr = window.deskRebuild;
    if (typeof _dr === 'function') {
      window.deskRebuild = function () {
        try { _dr.apply(window, arguments); } catch (eDr) {}
        setTimeout(applyGroups, 140);
      };
    }
  } catch (eDd) {}
  PH.addEventListener('pointerup', function () { setTimeout(applyGroups, 200); }, false);
  setTimeout(applyGroups, 400);
  window.addEventListener('load', function () { setTimeout(applyGroups, 700); });
})();
</script>

<script>
/* ===== v69：音乐播放器背景 —— 参考「聊天壁纸」的深浅两栏图库 =====
   ① 浅色 / 深色各一栏，每栏可存多张（有序 id 列表，第一张＝本栏首选）；
   ② 点缩略图＝临时切换到这张；双击缩略图＝把它挪到本栏第一张（两栏都支持）；
   ③ 切深浅模式（含「跟随系统」自动切）时强制用目标栏的第一张；
   ④ 从 v68「每栏单张 mochi-np-bg-dark / -light」平滑迁移，不丢老图。 */
(function () {
  'use strict';
  var PFX = 'mochi-np-bg-';
  var LIST_L = PFX + 'list-light', LIST_D = PFX + 'list-dark';
  var OLD_L = 'mochi-np-bg-light', OLD_D = 'mochi-np-bg-dark';
  var MAX = 12;
  function $(id) { return document.getElementById(id); }
  function g(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
  function sv(k, v) { try { localStorage.setItem(k, v); return true; } catch (e) { return false; } }
  function rm(k) { try { localStorage.removeItem(k); } catch (e) {} }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function isDark() { try { return document.documentElement.getAttribute('data-theme') === 'dark'; } catch (e) { return false; } }
  function keyOf(mode) { return mode === 'dark' ? LIST_D : LIST_L; }
  function activeKey(mode) { return PFX + 'active-' + mode; }
  function itemKey(id) { return PFX + 'item-' + id; }
  function thbKey(id) { return PFX + 'thb-' + id; }
  function readList(mode) {
    var raw = g(keyOf(mode));
    if (!raw) return [];
    try { var v = JSON.parse(raw); return Array.isArray(v) ? v : []; } catch (e) { return []; }
  }
  function saveList(mode, arr) { return sv(keyOf(mode), JSON.stringify(arr)); }

  /* v68 → v69 迁移：老的单张图升成该栏第一张 */
  function migrate() {
    [['light', OLD_L], ['dark', OLD_D]].forEach(function (p) {
      var mode = p[0], oldKey = p[1];
      if (g(keyOf(mode))) return;              /* 新列表已存在（哪怕是 []），别覆盖 */
      var old = g(oldKey); if (!old) return;
      var id = 'm' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      if (!sv(itemKey(id), old)) return;
      saveList(mode, [id]);
      sv(activeKey(mode), id);
    });
  }

  /* 切到某模式：强制用该栏第一张（这就是「第一张」的含义） */
  function forceFirstOfMode(mode) {
    var list = readList(mode);
    if (list.length) sv(activeKey(mode), list[0]);
    else rm(activeKey(mode));
  }

  function apply() {
    var el = $('np-bg'), pg = $('page-now');
    var mode = isDark() ? 'dark' : 'light';
    var list = readList(mode), other = readList(mode === 'dark' ? 'light' : 'dark');
    var active = g(activeKey(mode));
    if (list.indexOf(active) < 0) active = list[0] || '';
    var url = active ? g(itemKey(active)) : '';
    if (!url && other.length) url = g(itemKey(other[0])) || '';   /* 本栏空 → 回退另一栏第一张 */
    if (el && pg) {
      if (url) {
        el.style.backgroundImage = 'url("' + url + '")';
        el.classList.add('on'); pg.classList.add('has-bg');
      } else {
        el.style.backgroundImage = '';
        el.classList.remove('on'); pg.classList.remove('has-bg');
      }
    }
    var nd = readList('dark').length, nl = readList('light').length;
    var vd = $('np-bg-dark-val'); if (vd) vd.textContent = nd ? (nd + ' 张') : '未设置';
    var vl = $('np-bg-light-val'); if (vl) vl.textContent = nl ? (nl + ' 张') : '未设置';
    var rd = $('row-np-bg-dark-rm'); if (rd) rd.hidden = !nd;
    var rl = $('row-np-bg-light-rm'); if (rl) rl.hidden = !nl;
  }

  /* 双击：把这张挪到本栏第一张（浅色 / 深色两栏都支持） */
  function moveFirst(id, mode) {
    var list = readList(mode);
    var i = list.indexOf(id);
    if (i < 0) return;
    if (i === 0) { toast('已经是第一张了'); return; }
    list.splice(i, 1); list.unshift(id);
    saveList(mode, list);
    sv(activeKey(mode), id);
    toast('已挪到' + (mode === 'dark' ? '深色' : '浅色') + '栏的第一张');
    apply();
    var p = $('np-bg-panel');
    if (p && p.style.display === 'flex') openPanel(mode);
  }

  function compress(raw, maxSide, limit, cb) {
    if (window.compressImageFit) {
      Promise.resolve(window.compressImageFit(raw, maxSide, limit)).then(
        function (u) { cb(u || raw); }, function () { cb(raw); });
    } else cb(raw);
  }

  function addFiles(fs, mode) {
    if (!fs || !fs.length) return;
    var done = 0, fail = 0;
    toast('正在处理 ' + fs.length + ' 张图片…');
    var chain = Promise.resolve();
    Array.prototype.forEach.call(fs, function (f) {
      chain = chain.then(function () { return new Promise(function (res) {
        var fr = new FileReader();
        fr.onload = function () {
          compress(String(fr.result || ''), 1440, 620 * 1024, function (u) {
            if (!u) { fail++; res(); return; }
            var list = readList(mode);
            if (list.length >= MAX) { fail++; toast('这一栏已满（' + MAX + ' 张），请先删几张'); res(); return; }
            var id = 'n' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
            if (!sv(itemKey(id), u)) { fail++; toast('本机空间不足，这张没存进去'); res(); return; }
            list.push(id);
            if (!saveList(mode, list)) { rm(itemKey(id)); fail++; res(); return; }
            compress(u, 320, 60 * 1024, function (th) { if (th && th !== u) sv(thbKey(id), th); });
            if (!g(activeKey(mode))) sv(activeKey(mode), list[0]);  /* 该栏第一张＝默认首选 */
            done++;
            res();
          });
        };
        fr.onerror = function () { fail++; res(); };
        fr.readAsDataURL(f);
      }); });
    });
    chain.then(function () {
      toast('已加入 ' + done + ' 张' + (fail ? '，' + fail + ' 张失败' : ''));
      apply();
      var p = $('np-bg-panel');
      if (p && p.style.display === 'flex') openPanel(mode);
    });
  }

  function pickFiles(mode) {
    var inp = document.createElement('input');
    inp.type = 'file'; inp.accept = 'image/*'; inp.multiple = true;
    inp.addEventListener('change', function () { addFiles(inp.files, mode); });
    inp.click();
  }

  function clearMode(mode) {
    readList(mode).forEach(function (id) { rm(itemKey(id)); rm(thbKey(id)); });
    saveList(mode, []); rm(activeKey(mode));
    apply(); toast('已清空' + (mode === 'dark' ? '深色' : '浅色') + '模式图库');
  }

  var panelMode = '';
  function openPanel(mode) {
    panelMode = mode || panelMode || (isDark() ? 'dark' : 'light');
    var m = $('np-bg-panel');
    if (!m) {
      m = document.createElement('div'); m.id = 'np-bg-panel';
      m.style.cssText = 'position:fixed;inset:0;z-index:92;align-items:center;justify-content:center;background:rgba(0,0,0,.45);display:none';
      document.body.appendChild(m);
      m.addEventListener('click', function (e) { if (e.target === m) m.style.display = 'none'; });
    }
    m.innerHTML = '';
    m.style.display = 'flex';
    var box = document.createElement('div');
    box.style.cssText = 'width:min(92vw,420px);max-height:84vh;overflow-y:auto;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:16px;padding:16px;box-shadow:0 8px 30px rgba(0,0,0,.25)';
    var hd = document.createElement('div');
    hd.innerHTML = '<div style="font-size:16px;font-weight:600">播放器背景</div>' +
      '<div style="font-size:12px;color:var(--muted,#888);margin-top:4px;line-height:1.5">浅色 / 深色各一栏（跟「深色模式」对应）· 点缩略图切换 · <b>双击图片挪到第一张</b>（本栏首选，切到该模式自动用它）· 误删可撤销</div>';
    box.appendChild(hd);
    var tabs = document.createElement('div');
    tabs.style.cssText = 'display:flex;gap:8px;margin:12px 0';
    [['light', '浅色模式'], ['dark', '深色模式']].forEach(function (p) {
      var b = document.createElement('button');
      var on = panelMode === p[0];
      b.setAttribute('data-np-tab', p[0]);
      b.textContent = p[1] + '（' + readList(p[0]).length + '）';
      b.style.cssText = 'flex:1;padding:8px 10px;border-radius:10px;font-size:13px;font-weight:600;border:1px solid ' + (on ? 'transparent' : 'var(--card-border,#e5e5e5)') + ';background:' + (on ? 'var(--ink,#111)' : 'var(--btn-cancel-bg,#fafafa)') + ';color:' + (on ? 'var(--bg-b,#fff)' : 'var(--ink,#111)');
      b.addEventListener('click', function () { if (panelMode !== p[0]) openPanel(p[0]); });
      tabs.appendChild(b);
    });
    box.appendChild(tabs);
    var list = readList(panelMode);
    var active = g(activeKey(panelMode)); if (list.indexOf(active) < 0) active = list[0] || '';
    var grid = document.createElement('div');
    grid.style.cssText = 'display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0';
    if (!list.length) {
      var empty = document.createElement('div');
      empty.style.cssText = 'grid-column:1/-1;font-size:13px;color:var(--muted,#999);text-align:center;padding:26px 0';
      empty.textContent = '这一栏还没有壁纸，点下方「上传新图」加入（只加进当前这栏）';
      grid.appendChild(empty);
    }
    list.forEach(function (id, idx) {
      var cell = document.createElement('div');
      cell.setAttribute('data-np-id', id);
      cell.style.cssText = 'position:relative;border-radius:10px;overflow:hidden;border:2px solid ' + (id === active ? 'var(--btn-bg,#111)' : 'transparent') + ';cursor:pointer;aspect-ratio:9/16;background:var(--bg-b,#f2f2f2)';
      var im = document.createElement('img');
      im.alt = '';
      im.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
      var th = g(thbKey(id));
      im.src = th || g(itemKey(id)) || 'data:image/gif;base64,R0lGODlhAQABAAAAACwAAAAAAQABAAA=';
      cell.appendChild(im);
      if (idx === 0) {
        var first = document.createElement('div');
        first.textContent = '① 首选';
        first.setAttribute('data-np-first', '1');
        first.style.cssText = 'position:absolute;left:2px;bottom:2px;font-size:10px;color:#fff;background:rgba(0,0,0,.55);padding:1px 5px;border-radius:6px';
        cell.appendChild(first);
      }
      /* 单击＝切换（延后 260ms 让位双击）；双击（320ms 内两次）＝挪到本栏第一张 */
      var tapAt = 0, tapTimer = 0;
      cell.addEventListener('click', function () {
        var now = Date.now();
        if (now - tapAt < 320) {
          clearTimeout(tapTimer); tapAt = 0;
          moveFirst(id, panelMode);
          return;
        }
        tapAt = now;
        tapTimer = setTimeout(function () {
          tapAt = 0;
          sv(activeKey(panelMode), id);
          apply();
          toast('已切换壁纸');
          m.style.display = 'none';
        }, 260);
      });
      var del = document.createElement('div');
      del.textContent = '×';
      del.setAttribute('data-np-del', id);
      del.style.cssText = 'position:absolute;top:2px;right:2px;width:20px;height:20px;line-height:18px;text-align:center;border-radius:50%;background:rgba(0,0,0,.55);color:#fff;font-size:14px';
      del.addEventListener('click', function (e) {
        e.stopPropagation();
        var full = g(itemKey(id)), thb = g(thbKey(id)), wasFirst = idx === 0;
        saveList(panelMode, readList(panelMode).filter(function (x) { return x !== id; }));
        rm(itemKey(id)); rm(thbKey(id));
        if (g(activeKey(panelMode)) === id) {
          var nl2 = readList(panelMode);
          if (nl2.length) sv(activeKey(panelMode), nl2[0]); else rm(activeKey(panelMode));
        }
        m.__undo = { id: id, full: full, thb: thb, first: wasFirst, mode: panelMode };
        if (m.__undoT) clearTimeout(m.__undoT);
        m.__undoT = setTimeout(function () { m.__undo = null; if (m.style.display === 'flex') openPanel(panelMode); }, 5000);
        apply(); toast('已删除，5 秒内可撤销');
        openPanel(panelMode);
      });
      cell.appendChild(del);
      grid.appendChild(cell);
    });
    box.appendChild(grid);
    if (m.__undo) {
      var strip = document.createElement('div');
      strip.style.cssText = 'display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:10px;background:var(--bg-b,#f6f6f6);margin-bottom:8px';
      var stx = document.createElement('span');
      stx.style.cssText = 'flex:1;font-size:12px;color:var(--muted,#888)';
      stx.textContent = '刚删了 1 张，可撤销'; strip.appendChild(stx);
      var ub = document.createElement('button'); ub.textContent = '撤销';
      ub.setAttribute('data-np-undo', '1');
      ub.style.cssText = 'padding:5px 14px;border:none;border-radius:8px;background:var(--ink,#111);color:#fff;font-size:12px;font-weight:600';
      ub.addEventListener('click', function () {
        var u = m.__undo; m.__undo = null;
        if (m.__undoT) { clearTimeout(m.__undoT); m.__undoT = null; }
        if (u && u.full) {
          var lm = u.mode, l2 = readList(lm);
          if (u.first) l2.unshift(u.id); else l2.push(u.id);
          saveList(lm, l2); sv(itemKey(u.id), u.full); if (u.thb) sv(thbKey(u.id), u.thb);
        }
        toast('已撤销删除'); apply(); openPanel(panelMode);
      });
      strip.appendChild(ub); box.appendChild(strip);
    }
    var upBtn = document.createElement('button');
    upBtn.textContent = '＋ 上传新图（可多选，加进当前这一栏）';
    upBtn.setAttribute('data-np-upload', '1');
    upBtn.style.cssText = 'width:100%;padding:11px;border:none;border-radius:10px;background:var(--ink,#111);color:var(--bg-b,#fff);font-size:14px;font-weight:600;margin-bottom:8px';
    upBtn.addEventListener('click', function () { pickFiles(panelMode); });
    box.appendChild(upBtn);
    if (list.length) {
      var clear = document.createElement('button');
      clear.textContent = '清空「' + (panelMode === 'dark' ? '深色' : '浅色') + '」这一栏';
      clear.setAttribute('data-np-clear', '1');
      clear.style.cssText = 'width:100%;padding:10px;border:1px solid rgba(163,45,45,.35);border-radius:10px;background:var(--danger-soft,#fff5f5);color:var(--danger-ink,#a32d2d);font-size:13px';
      clear.addEventListener('click', function () { clearMode(panelMode); openPanel(panelMode); });
      box.appendChild(clear);
    }
    var close = document.createElement('button');
    close.textContent = '关闭';
    close.style.cssText = 'width:100%;padding:9px;margin-top:8px;border:1px solid var(--card-border,#ddd);border-radius:10px;background:transparent;color:var(--ink,#111);font-size:13px';
    close.addEventListener('click', function () { m.style.display = 'none'; });
    box.appendChild(close);
    m.appendChild(box);
  }

  /* 设置页两行 / 两个清空按钮 */
  document.addEventListener('click', function (e) {
    var t = e.target; if (!t || !t.closest) return;
    if (t.closest('#row-np-bg-dark')) { openPanel('dark'); return; }
    if (t.closest('#row-np-bg-light')) { openPanel('light'); return; }
    if (t.closest('#row-np-bg-dark-rm')) { clearMode('dark'); return; }
    if (t.closest('#row-np-bg-light-rm')) { clearMode('light'); return; }
  }, true);

  /* 主题切换：强制用目标栏第一张（「跟随系统」自动切也走这里） */
  var seen = isDark() ? 'dark' : 'light';
  try {
    new MutationObserver(function () {
      var m = isDark() ? 'dark' : 'light';
      if (m !== seen) forceFirstOfMode(m);
      seen = m;
      apply();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  } catch (eMo) {}

  migrate();
  apply();
  window.addEventListener('load', apply);
  setTimeout(apply, 400);

  /* 对外接口（保留 applyNpBg 名兼容旧调用；并便于验证） */
  window.applyNpBg = apply;
  window.openNpBgPanel = openPanel;
  window.npBgMoveFirst = moveFirst;
  window.npBgClearMode = clearMode;
  window.__npBgDebug = function () {
    return {
      light: readList('light'), dark: readList('dark'),
      firstLight: readList('light')[0] || '', firstDark: readList('dark')[0] || '',
      activeLight: g(activeKey('light')), activeDark: g(activeKey('dark')),
      url: ($('np-bg') ? $('np-bg').style.backgroundImage : ''),
      isDark: isDark()
    };
  };
})();
</script>

<style id="v77-css">
/* ===== v74 四象限 / 日记本 / 开屏署名 / 桌面分组 ===== */
.qd-ov{position:fixed;inset:0;z-index:420;display:none;background:var(--bg-b,#f7f4f6);color:var(--qd-ink,#2a2024);
  font-family:inherit;-webkit-tap-highlight-color:transparent;overscroll-behavior:contain}
.qd-ov.on{display:flex;flex-direction:column}
.qd-ov *{box-sizing:border-box}
.qd-page{--qd-ink:#2f2329;--qd-muted:#9c8b93;--qd-card:#ffffff;--qd-line:rgba(154,120,140,.20);
  --qd-chip-a:#c58aa4;--qd-chip-b:#9a6a88;--qd-shadow:0 6px 20px rgba(120,74,98,.10);
  --qd-veil:rgba(255,252,253,.55)}
[data-theme="dark"] .qd-page{--qd-ink:#f3e8ee;--qd-muted:#a89aa1;--qd-card:#1a1a1a;--qd-line:rgba(255,255,255,.13);
  --qd-chip-a:#8c5f77;--qd-chip-b:#6a4560;--qd-shadow:0 6px 20px rgba(0,0,0,.35);
  --qd-veil:rgba(20,15,18,.58)}
.qd-wall{position:absolute;inset:0;background:var(--qd-wall-fill,none) center/cover no-repeat,linear-gradient(160deg,#fdf6f8,#f3e9ef 45%,#efe6f4);
  pointer-events:none}
[data-theme="dark"] .qd-wall{background:var(--qd-wall-fill,none) center/cover no-repeat,linear-gradient(160deg,#191418,#221a20 50%,#1b161d)}
.qd-wrap{position:relative;z-index:1;display:flex;flex-direction:column;height:100%;min-height:0;
  padding:calc(env(safe-area-inset-top,0px) + 10px) 0 calc(env(safe-area-inset-bottom,0px) + 6px)}
.qd-hd{display:flex;align-items:center;gap:8px;padding:2px 16px 6px;flex:none}
.qd-icbtn{width:34px;height:34px;flex:none;border:none;border-radius:50%;background:rgba(255,255,255,.7);color:var(--qd-ink,#2f2329);
  display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(120,74,98,.10);cursor:pointer}
[data-theme="dark"] .qd-icbtn{background:rgba(255,255,255,.08)}
.qd-icbtn svg{width:18px;height:18px}
.qd-title{font-size:21px;font-weight:700;letter-spacing:2px;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.qd-hd-act{display:flex;gap:6px;flex:none}
.qd-pill{border:none;border-radius:999px;padding:7px 13px;font-size:12.5px;font-weight:600;cursor:pointer;
  background:rgba(255,255,255,.75);color:var(--qd-ink,#2f2329);box-shadow:0 2px 8px rgba(120,74,98,.10)}
[data-theme="dark"] .qd-pill{background:rgba(255,255,255,.09)}
.qd-pill.solid{background:linear-gradient(135deg,var(--qd-chip-a,#c58aa4),var(--qd-chip-b,#9a6a88));color:#fff}
.qd-date{padding:0 18px 8px;font-size:11.5px;color:var(--qd-muted,#9c8b93);letter-spacing:.4px;flex:none}
/* v74：四象限整体缩小一点，四周留白 */
.qd-grid{flex:1 1 auto;min-height:0;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;
  gap:10px;padding:0 30px;max-width:420px;margin:0 auto;width:100%;height:min(64vh,540px);max-height:min(64vh,540px)}
.qd-cell{position:relative;min-height:0;display:flex;flex-direction:column;border-radius:16px;overflow:hidden;
  padding:10px 10px 34px;background:var(--qd-card-fill,var(--qd-card,#fff));
  background-size:cover;background-position:center;box-shadow:var(--qd-shadow);border:1px solid rgba(255,255,255,.05);
  user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
[data-theme="dark"] .qd-cell{border-color:rgba(255,255,255,.06)}
.qd-cell-hd{display:flex;align-items:center;gap:4px;flex:none}
.qd-chip{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:7px;font-size:12px;font-weight:700;
  letter-spacing:1px;color:#fff;background:linear-gradient(135deg,var(--qd-chip-a,#c58aa4),var(--qd-chip-b,#9a6a88));
  box-shadow:0 2px 8px rgba(140,90,116,.22)}
.qd-num{font-size:10px;font-weight:600;color:var(--qd-muted,#9c8b93);opacity:.6;letter-spacing:1px}
.qd-cell-all{margin-left:auto;border:0;background:transparent;color:var(--qd-muted,#9c8b93);font-size:9.5px;
  letter-spacing:.3px;padding:2px 2px;cursor:pointer;font-family:inherit;flex:none}
.qd-cell-all:active{opacity:.6}
.qd-body{flex:1;min-height:0;padding-bottom:2px;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;
  font-size:12.5px;line-height:1.6;color:var(--qd-ink,#2f2329);scrollbar-width:none}
.qd-body::-webkit-scrollbar{display:none}
.qd-empty{font-size:12.5px;line-height:1.7;color:var(--qd-muted,#9c8b93);opacity:.9;padding:2px 0}
.qd-entry{padding:2px 0 4px;cursor:pointer}
.qd-entry+.qd-entry{border-top:1px dashed var(--qd-line);margin-top:4px;padding-top:5px}
.qd-entry-t{font-size:10px;color:var(--qd-muted,#9c8b93);letter-spacing:.3px;margin-bottom:1px}
.qd-entry-x{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;white-space:pre-wrap}
.qd-thumbs{display:flex;gap:5px;margin-top:6px;flex-wrap:wrap}
.qd-thumb{width:34px;height:34px;border-radius:7px;object-fit:cover;background:rgba(150,120,140,.14);display:block}
.qd-thumb-more{width:34px;height:34px;border-radius:7px;display:flex;align-items:center;justify-content:center;
  font-size:11px;color:var(--qd-muted,#9c8b93);background:rgba(150,120,140,.14)}
.qd-add{position:absolute;right:7px;bottom:7px;width:24px;height:24px;border-radius:50%;border:none;cursor:pointer;
  background:linear-gradient(135deg,var(--qd-chip-a,#c58aa4),var(--qd-chip-b,#9a6a88));color:#fff;font-size:15px;
  line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(140,90,116,.30);z-index:4}
.qd-foot{flex:none;padding:6px 18px 2px;font-size:10.5px;line-height:1.5;color:var(--qd-muted,#9c8b93);text-align:center;letter-spacing:.2px}

/* ---- 便签：贴在方块上的批注 ---- */
.qd-sticky{position:absolute;z-index:3;max-width:64%;padding:7px 8px 8px;border-radius:3px 3px 9px 3px;
  background:linear-gradient(160deg,#fff9dc,#ffeeb2);color:#6a5320;font-size:10px;line-height:1.45;
  box-shadow:0 5px 12px rgba(120,90,40,.22);transform:rotate(var(--rot,-3deg));cursor:pointer;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;
  text-align:left}
.qd-sticky:before{content:'';position:absolute;top:-4px;left:50%;width:15px;height:8px;transform:translateX(-50%);
  background:rgba(255,255,255,.62);border-radius:1px;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.qd-sticky small{display:block;font-size:8.5px;opacity:.6;margin-bottom:1px;letter-spacing:.3px}
/* 同一格有多条批注时，后面的便签缩小，避免互相盖住 */
.qd-sticky.mini{font-size:9px;max-width:56%;padding:5px 6px 6px;-webkit-line-clamp:2}
.qd-sticky.mini small{font-size:8px;margin-bottom:0}
[data-theme="dark"] .qd-sticky{background:linear-gradient(160deg,#3b341f,#2a2517);color:#ece0b8;
  box-shadow:0 5px 12px rgba(0,0,0,.45)}
[data-theme="dark"] .qd-sticky:before{background:rgba(255,255,255,.22)}

/* ---- 编辑弹层（v74：大号单独四象限板块） ---- */
.qd-sheet{position:fixed;inset:0;z-index:440;display:none;align-items:flex-end;justify-content:center;
  background:rgba(0,0,0,.36);backdrop-filter:blur(2px)}
.qd-sheet.on{display:flex}
.qd-sheet-box{width:100%;max-width:520px;max-height:88vh;display:flex;flex-direction:column;gap:10px;
  padding:14px 16px calc(env(safe-area-inset-bottom,0px) + 14px);border-radius:20px 20px 0 0;
  background:var(--bg-b,#fff);color:var(--ink,#111);box-shadow:0 -10px 40px rgba(0,0,0,.22);
  animation:qdUp .26s cubic-bezier(.2,.8,.3,1)}
@keyframes qdUp{from{transform:translateY(30px);opacity:.6}to{transform:none;opacity:1}}
.qd-sheet-hd{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;flex:none}
.qd-sheet-hd span{flex:1}
.qd-x{border:none;background:transparent;color:var(--muted,#999);font-size:19px;line-height:1;cursor:pointer;padding:2px 4px}
.qd-ta{width:100%;min-height:104px;max-height:40vh;resize:vertical;border:1px solid var(--line,#e9e2e6);border-radius:12px;
  padding:10px 12px;font-size:14px;line-height:1.7;background:var(--bg-a,#faf8f9);color:var(--ink,#111);font-family:inherit;outline:none}
.qd-ta:focus{border-color:var(--qd-chip-a,#c58aa4)}
.qd-edit-imgs{display:flex;gap:8px;flex-wrap:wrap;max-height:116px;overflow-y:auto;flex:none}
.qd-edit-img{position:relative;width:56px;height:56px;border-radius:9px;overflow:hidden;background:#eee}
.qd-edit-img img{width:100%;height:100%;object-fit:cover;display:block}
.qd-edit-img button{position:absolute;top:1px;right:1px;width:17px;height:17px;border:none;border-radius:50%;
  background:rgba(0,0,0,.6);color:#fff;font-size:11px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center}
.qd-row{display:flex;gap:8px;align-items:center;flex:none}
.qd-btn{flex:1;padding:10px;border-radius:12px;border:1px solid var(--line,#e9e2e6);background:transparent;
  color:var(--ink,#111);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
.qd-btn.solid{border:none;background:linear-gradient(135deg,var(--qd-chip-a,#c58aa4),var(--qd-chip-b,#9a6a88));color:#fff}
.qd-btn.danger{color:#a3314a;border-color:rgba(163,49,74,.25)}
.qd-tip{font-size:11px;color:var(--muted,#999);line-height:1.6}
/* 居中弹窗形态：像一块放大的四象限格子 */
#qd-edit.qd-epop{align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.44)}
#qd-edit.qd-epop .qd-sheet-box{width:min(90vw,372px);max-width:372px;max-height:82vh;border-radius:22px;border:1px solid rgba(150,110,120,.10);
  background:var(--qd-card-fill,var(--qd-card,#fff));background-size:cover;background-position:center;
  padding:14px 14px 12px;box-shadow:0 20px 60px rgba(60,30,45,.36);animation:qdPop .24s cubic-bezier(.2,.85,.3,1)}
@keyframes qdPop{from{transform:scale(.9);opacity:.35}to{transform:none;opacity:1}}
.qd-epop .qd-sheet-hd{color:var(--qd-ink,#2f2329);font-size:13px;gap:7px}
.qd-epop .qd-sheet-hd .qd-chip{height:22px;font-size:12px;flex:none}
.qd-epop .qd-sheet-hd #qd-edit-title{flex:1;min-width:0;font-size:12.5px;font-weight:600}
.qd-epop .qd-x{color:var(--qd-muted,#9c8b93)}
.qd-epop .qd-ta{background:rgba(255,255,255,.72);border:1px dashed rgba(150,110,120,.26);color:#2b2326;font-size:13.5px;min-height:122px}
[data-theme="dark"] .qd-epop .qd-ta{background:rgba(0,0,0,.42);border-color:rgba(255,255,255,.14);color:#f3ecf0}
.qd-epop .qd-btn{background:rgba(255,255,255,.5);border:1px solid rgba(150,110,120,.24);color:#3a2d33;font-size:12.5px;padding:9px}
[data-theme="dark"] .qd-epop .qd-btn{background:rgba(255,255,255,.10);border-color:rgba(255,255,255,.14);color:#f3ecf0}
.qd-epop .qd-btn.solid{background:linear-gradient(135deg,var(--qd-chip-a,#c58aa4),var(--qd-chip-b,#9a6a88));color:#fff;border:0}
.qd-epop .qd-btn.danger{background:rgba(255,255,255,.5);color:#a3314a;border-color:rgba(163,49,74,.22)}
.qd-epop .qd-tip{color:var(--qd-muted,#9c8b93);font-size:10.5px;text-align:center}

/* ---- 当日记录列表 ---- */
.qd-daylist{display:flex;flex-direction:column;gap:8px;overflow-y:auto;min-height:0}
.qd-dayrow{display:flex;gap:10px;align-items:flex-start;padding:10px 11px;border-radius:12px;background:var(--bg-a,#faf8f9);
  border:1px solid var(--line,#efe8ec);cursor:pointer}
.qd-dayrow .t{font-size:10.5px;color:var(--muted,#999);flex:none;width:38px;padding-top:2px}
.qd-dayrow .x{flex:1;min-width:0;font-size:13px;line-height:1.65;white-space:pre-wrap;word-break:break-word}
.qd-dayrow .im{display:flex;gap:3px;flex-wrap:wrap;margin-top:5px}
.qd-dayrow .im img{width:34px;height:34px;border-radius:6px;object-fit:cover}

/* ================= 日记本（v74：单页 · 照片在上 · 记录在下） ================= */
.qd-diary{background:transparent}
.qd-dwrap{position:relative;z-index:1;display:flex;flex-direction:column;height:100%;min-height:0;
  padding:calc(env(safe-area-inset-top,0px) + 8px) 0 calc(env(safe-area-inset-bottom,0px) + 6px)}
.qd-dhd{display:flex;align-items:center;gap:8px;padding:2px 14px 6px;flex:none}
.qd-dtitle{font-size:19px;font-weight:700;letter-spacing:2px;flex:1;min-width:0;color:var(--qd-ink,#2f2329)}
.qd-dtop{flex:none;padding:0 14px 8px}
.qd-bub{position:relative;border-radius:16px 16px 16px 5px;padding:9px 12px 9px;background:rgba(255,255,255,.82);
  border:1px solid rgba(255,255,255,.6);box-shadow:0 4px 14px rgba(120,74,98,.10);color:#3a2d33}
[data-theme="dark"] .qd-bub{background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.06);color:#f0e8ec}
.qd-bub:after{content:'';position:absolute;left:14px;bottom:-5px;border:6px solid transparent;
  border-top-color:rgba(255,255,255,.82);border-left:0}
[data-theme="dark"] .qd-bub:after{border-top-color:rgba(255,255,255,.09)}
.qd-bub textarea{width:100%;display:block;border:0;background:transparent;resize:none;outline:none;overflow:hidden;
  font-family:inherit;font-size:13px;line-height:1.7;color:inherit;padding:0;margin:0;min-height:22px}
.qd-bub textarea::placeholder{color:rgba(120,90,100,.45)}
[data-theme="dark"] .qd-bub textarea::placeholder{color:rgba(240,225,230,.4)}
.qd-dbody{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  padding:0 14px 26px;scrollbar-width:none}
.qd-dbody::-webkit-scrollbar{display:none}
.qd-dsec-h{display:flex;align-items:baseline;gap:7px;font-size:10.5px;font-weight:700;letter-spacing:2px;
  color:rgba(120,90,80,.62);padding:2px 1px 7px;flex:none}
[data-theme="dark"] .qd-dsec-h{color:rgba(240,225,220,.5)}
.qd-dsec-h i{font-style:normal;font-size:9.5px;letter-spacing:0;font-weight:400;opacity:.8}
.qd-dphotos{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:12px}
.qd-ph{position:relative;aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:rgba(150,110,100,.14);cursor:pointer}
.qd-ph img{width:100%;height:100%;object-fit:cover;display:block}
.qd-ph span{position:absolute;left:0;right:0;bottom:0;color:#fff;text-align:center;
  padding:4px 1px 2px;background:linear-gradient(transparent,rgba(0,0,0,.62));line-height:1.25}
.qd-ph span b{display:block;font-size:6.5px;font-weight:500;opacity:.92;letter-spacing:0}
.qd-ph span i{display:block;font-style:normal;font-size:8px;font-weight:600}
.qd-phempty{grid-column:1/-1;font-size:11.5px;color:rgba(120,90,80,.55);padding:8px 2px 10px}
/* 搜索栏：夹在照片与成长路线中间 */
.qd-search2{display:flex;gap:7px;align-items:center;margin:2px 0 14px}
.qd-search2 input{flex:1;min-width:0;height:34px;border-radius:10px;border:1px solid rgba(140,110,90,.22);
  background:rgba(255,255,255,.78);padding:0 11px;font-size:12px;color:#3a2d2a;font-family:inherit;outline:none}
.qd-search2 input+input{flex:0 0 106px;width:106px;padding:0 8px;font-size:11px}
[data-theme="dark"] .qd-search2 input{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.12);color:#efe6e1}
.qd-grp{margin-bottom:12px}
.qd-grp-h{display:flex;align-items:center;gap:7px;font-size:10.5px;font-weight:700;color:#8d5f6f;letter-spacing:.6px;
  padding:3px 0 5px;border-bottom:1px dashed rgba(150,110,100,.28);margin-bottom:6px;cursor:pointer}
.qd-grp-h small{margin-left:auto;font-size:9.5px;font-weight:400;opacity:.7;letter-spacing:0}
[data-theme="dark"] .qd-grp-h{color:#d3a7b6;border-color:rgba(255,255,255,.14)}
.qd-item{display:block;padding:6px 0;font-size:12px;line-height:1.6;color:#4a3733;cursor:pointer}
[data-theme="dark"] .qd-item{color:#e6d9d4}
.qd-item:active{opacity:.7}
.qd-item .h{font-size:8.5px;line-height:1.4;color:rgba(120,90,80,.58);letter-spacing:.1px;margin-bottom:1px}
[data-theme="dark"] .qd-item .h{color:rgba(240,225,220,.44)}
.qd-item .b{display:flex;align-items:flex-start;gap:5px}
.qd-item .z{flex:none;font-size:8.5px;line-height:1.55;padding:0 4px;border-radius:4px;background:rgba(180,120,140,.16);color:#9a5c72;margin-top:1px}
[data-theme="dark"] .qd-item .z{background:rgba(220,160,185,.16);color:#e0b6c6}
.qd-item .x{flex:1;min-width:0;-webkit-line-clamp:3;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word}
.qd-item .pin{font-size:8.5px;color:rgba(150,110,120,.6);margin-left:4px;flex:none}
.qd-item .th{display:flex;gap:4px;margin-top:5px;flex-wrap:wrap}
.qd-item .th img{width:34px;height:34px;border-radius:6px;object-fit:cover;display:block}
.qd-nores{font-size:11px;color:rgba(120,90,80,.55);line-height:1.7;padding:6px 2px}
/* 上下一天 */
.qd-daynav{position:absolute;right:6px;top:50%;transform:translateY(-50%);z-index:5;display:flex;
  flex-direction:column;gap:12px}
.qd-daynav button{width:36px;height:36px;border-radius:50%;border:1.3px solid rgba(150,110,120,.4);
  background:rgba(255,255,255,.72);color:#7a5560;display:flex;align-items:center;justify-content:center;
  cursor:pointer;box-shadow:0 3px 10px rgba(120,74,98,.14)}
.qd-daynav button svg{width:17px;height:17px}
[data-theme="dark"] .qd-daynav button{background:rgba(30,26,29,.78);border-color:rgba(255,255,255,.18);color:#efe4ea}
.qd-daynav button[disabled]{opacity:.3;pointer-events:none}
.qd-grp.flash{animation:qdFlash 1.1s ease}
@keyframes qdFlash{0%{background:rgba(197,138,164,.22)}100%{background:transparent}}
.qd-gday{padding:9px 11px;border-radius:12px;background:rgba(255,255,255,.66);border:1px solid rgba(255,255,255,.6);
  margin-bottom:8px;box-shadow:0 3px 12px rgba(120,74,98,.08)}
[data-theme="dark"] .qd-gday{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.05)}
.qd-gday-h{display:flex;align-items:baseline;gap:6px;font-size:11px;font-weight:700;color:#7d5262;margin-bottom:4px}
[data-theme="dark"] .qd-gday-h{color:#d8acbc}
.qd-gday-h small{font-size:9px;font-weight:400;opacity:.7}
.qd-grow{font-size:12px;line-height:1.7;color:#4a3733;padding:4px 0;display:flex;gap:7px;cursor:pointer}
[data-theme="dark"] .qd-grow{color:#e6d9d4}
.qd-grow .t{flex:none;font-size:9px;opacity:.55;padding-top:3px;width:30px}
.qd-grow .x{flex:1;min-width:0;word-break:break-word}
.qd-grow .th{display:flex;gap:4px;margin-top:4px;flex-wrap:wrap}
.qd-grow .th img{width:30px;height:30px;border-radius:5px;object-fit:cover}

/* ---- 单日查看（去掉上下箭头） ---- */
.qd-view{position:fixed;inset:0;z-index:465;display:none;background:rgba(14,10,12,.72);backdrop-filter:blur(4px)}
.qd-view.on{display:flex;align-items:center;justify-content:center}
.qd-view-in{position:relative;width:min(92vw,430px);max-height:86vh;display:flex;flex-direction:column;gap:10px}
.qd-view-card{background:var(--bg-b,#fff);color:var(--ink,#111);border-radius:18px;padding:16px;
  max-height:78vh;overflow-y:auto;box-shadow:0 16px 50px rgba(0,0,0,.35)}
.qd-view-d{font-size:15px;font-weight:700;letter-spacing:1px;margin-bottom:2px}
.qd-view-sub{font-size:10.5px;color:var(--muted,#999);margin-bottom:10px}
.qd-vsec{margin-top:11px}
.qd-vsec-h{display:flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;color:#9a5c72;margin-bottom:4px}
[data-theme="dark"] .qd-vsec-h{color:#dda9bd}
.qd-vsec-h i{font-style:normal;font-size:9.5px;color:var(--muted,#999);font-weight:400}
.qd-vrow{font-size:13px;line-height:1.7;padding:6px 0;border-bottom:1px dashed var(--line,#eee);white-space:pre-wrap;word-break:break-word}
.qd-vrow small{display:block;font-size:9.5px;color:var(--muted,#999);margin-bottom:2px;letter-spacing:.3px}
.qd-vrow .vimg{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.qd-vrow .vimg img{width:64px;height:64px;object-fit:cover;border-radius:8px;margin:0;cursor:pointer}
.qd-view-x{position:absolute;right:-2px;top:-44px;width:32px;height:32px;border-radius:50%;border:none;
  background:rgba(255,255,255,.16);color:#fff;font-size:15px;cursor:pointer;z-index:2}

/* ---- 图片查看 ---- */
.qd-photo{position:fixed;inset:0;z-index:470;display:none;background:#0b090a;flex-direction:column}
.qd-photo.on{display:flex}
.qd-photo-img{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;padding:12px}
.qd-photo-img img{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px}
.qd-photo-bar{flex:none;display:flex;align-items:center;justify-content:center;gap:14px;
  padding:12px 16px calc(env(safe-area-inset-bottom,0px) + 18px)}
.qd-bubble{max-width:74%;padding:8px 14px;border-radius:14px 14px 14px 4px;background:rgba(255,255,255,.94);color:#2b2326;
  font-size:12px;letter-spacing:.4px;box-shadow:0 6px 20px rgba(0,0,0,.35);position:relative}
.qd-bubble:after{content:'';position:absolute;left:0;bottom:-5px;border:6px solid transparent;border-top-color:rgba(255,255,255,.94);border-left:0}
.qd-photo-x{position:absolute;right:14px;top:calc(env(safe-area-inset-top,0px) + 12px);width:34px;height:34px;border-radius:50%;
  border:none;background:rgba(255,255,255,.16);color:#fff;font-size:17px;cursor:pointer;z-index:2}
.qd-photo-nav{position:absolute;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;
  border:1.3px solid rgba(255,255,255,.55);background:rgba(255,255,255,.12);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2}
.qd-photo-nav svg{width:15px;height:15px}
.qd-photo-nav.l{left:8px}.qd-photo-nav.r{right:8px}
.qd-photo-nav[disabled]{opacity:.25;pointer-events:none}

/* ---- 设置 ---- */
.qd-sec{background:var(--card-bg,#fff);border-radius:16px;padding:4px 14px;margin:0 14px 10px;flex:none}
.qd-srow{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--line,#f0eaee);cursor:pointer}
.qd-srow:last-child{border-bottom:none}
.qd-srow .n{flex:1;min-width:0;font-size:13.5px;font-weight:600;color:var(--ink,#111)}
.qd-srow .n small{display:block;font-size:10.5px;color:var(--muted,#999);font-weight:400;margin-top:3px;line-height:1.5}
.qd-srow .v{flex:none;font-size:11.5px;color:var(--muted,#999)}
.qd-srow .v b{color:var(--ink,#111);font-weight:600}
.qd-dot{display:inline-block;width:11px;height:11px;border-radius:3px;margin-right:5px;vertical-align:-1px;
  border:1px solid rgba(0,0,0,.12)}
.qd-set-body{flex:1;min-height:0;overflow-y:auto;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 16px)}
.qd-set-h{font-size:10.5px;letter-spacing:2px;color:var(--muted,#999);padding:12px 18px 6px;font-weight:600}
.qd-toast{position:fixed;left:50%;bottom:22%;transform:translateX(-50%);z-index:600;max-width:80vw;
  padding:9px 16px;border-radius:999px;background:rgba(20,16,18,.86);color:#fff;font-size:12.5px;
  opacity:0;pointer-events:none;transition:opacity .2s}
.qd-toast.on{opacity:1}

/* ---- 图库 ---- */
.qd-gal{position:fixed;inset:0;z-index:450;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.46)}
.qd-gal.on{display:flex}
.qd-gal-box{width:min(92vw,430px);max-height:84vh;display:flex;flex-direction:column;background:var(--card-bg,#fff);color:var(--ink,#111);
  border-radius:18px;padding:15px;box-shadow:0 14px 44px rgba(0,0,0,.30)}
.qd-gal-tabs{display:flex;gap:8px;flex:none;margin:10px 0}
.qd-gal-tabs button{flex:1;padding:8px;border-radius:10px;font-size:12.5px;font-weight:600;cursor:pointer;
  border:1px solid var(--line,#e6dee3);background:transparent;color:var(--ink,#111)}
.qd-gal-tabs button.on{background:var(--ink,#111);color:var(--bg-b,#fff);border-color:transparent}
.qd-gal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;overflow-y:auto;min-height:0;margin:4px 0 10px}
.qd-gcell{position:relative;aspect-ratio:9/16;border-radius:9px;overflow:hidden;background:rgba(150,120,140,.12);
  cursor:pointer;border:2px solid transparent}
.qd-gcell.on{border-color:var(--ink,#111)}
.qd-gcell img{width:100%;height:100%;object-fit:cover;display:block}
.qd-gcell .first{position:absolute;left:2px;bottom:2px;font-size:9px;color:#fff;background:rgba(0,0,0,.55);
  padding:1px 4px;border-radius:5px}
.qd-gcell .del{position:absolute;top:2px;right:2px;width:19px;height:19px;border-radius:50%;border:none;
  background:rgba(0,0,0,.55);color:#fff;font-size:12px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center}
.qd-gal-empty{grid-column:1/-1;text-align:center;font-size:12px;color:var(--muted,#999);padding:26px 0}
.qd-gal-undo{display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:9px;background:var(--bg-a,#f7f4f6);margin-bottom:8px}
.qd-gal-undo span{flex:1;font-size:11.5px;color:var(--muted,#999)}
.qd-gal-undo button{padding:4px 12px;border:none;border-radius:7px;background:var(--ink,#111);color:#fff;font-size:11.5px;cursor:pointer}

/* ---- 概率弹窗（截图 2 的样式） ---- */
.qd-cat{position:fixed;inset:0;z-index:452;display:none;align-items:center;justify-content:center;
  background:rgba(0,0,0,.46);padding:16px}
.qd-cat.on{display:flex}
.qd-cat-box{width:min(92vw,400px);max-height:84vh;display:flex;flex-direction:column;background:var(--card-bg,#fff);
  color:var(--ink,#111);border-radius:18px;padding:15px 14px;box-shadow:0 16px 50px rgba(0,0,0,.32)}
.qd-cat-hd{display:flex;align-items:center;gap:8px;flex:none;font-size:15px;font-weight:700}
.qd-cat-hd span{flex:1}
.qd-cat-list{flex:1;min-height:0;overflow-y:auto;margin-top:6px;border-top:1px solid var(--line,#eee)}
.qd-cat-row{display:flex;align-items:center;gap:8px;padding:9px 2px;border-bottom:1px solid var(--line,#f2edf0)}
.qd-cat-row .cn{flex:1;min-width:0;font-size:13px}
.qd-cat-row .cn small{display:block;font-size:9.5px;color:var(--muted,#999);margin-top:2px}
.qd-stp{display:flex;align-items:center;gap:4px;flex:none}
.qd-stp button{width:26px;height:26px;border-radius:8px;border:1px solid var(--line,#e2dade);background:var(--bg-a,#f6f3f5);
  color:var(--ink,#111);font-size:14px;line-height:1;cursor:pointer;font-family:inherit}
.qd-stp input{width:42px;height:26px;text-align:center;border:0;border-bottom:1px solid var(--line,#ddd);
  background:transparent;color:var(--ink,#111);font-size:13px;font-family:inherit;outline:none}
.qd-cat-row.off{opacity:.45}
.qd-cat-tip{font-size:10.5px;color:var(--muted,#999);line-height:1.6;margin:6px 0 2px;flex:none}

/* ---- 开屏署名 ---- */
#page-opening .op-load .op-tap-tip{margin:0 0 6px;letter-spacing:2px}

.qd-sign-pv{text-align:center;padding:16px 8px 12px;font-size:15px;letter-spacing:1.2px;
  background:linear-gradient(160deg,#fff,#f4eef2);border-radius:12px;margin-bottom:10px;color:#111}
[data-theme="dark"] .qd-sign-pv{background:linear-gradient(160deg,#221d21,#171317);color:#eee}
.qd-sign-f{display:flex;gap:7px;flex-wrap:wrap;margin:4px 0 10px}
.qd-sign-f button{padding:7px 13px;border-radius:9px;border:1px solid var(--line,#e6dee3);background:transparent;
  font-size:12.5px;color:var(--ink,#111);cursor:pointer}
.qd-sign-f button.on{background:var(--ink,#111);color:var(--bg-b,#fff);border-color:transparent}
.qd-range{width:100%;accent-color:#b5768f}

/* ---- 字卡勾选 ---- */
.qd-pick{position:fixed;inset:0;z-index:455;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.46)}
.qd-pick.on{display:flex}
.qd-pick-box{width:min(92vw,430px);max-height:82vh;display:flex;flex-direction:column;background:var(--card-bg,#fff);
  border-radius:16px;padding:14px}
.qd-pick-list{flex:1;min-height:0;overflow-y:auto;margin:8px 0;border-top:1px solid var(--line,#eee)}
.qd-pick-row{display:flex;gap:9px;align-items:flex-start;padding:8px 2px;border-bottom:1px solid var(--line,#f3eef1);
  font-size:12.5px;line-height:1.55;cursor:pointer}
.qd-pick-row input{margin-top:3px;flex:none;accent-color:#b5768f}
.qd-pick-row span{flex:1;min-width:0;word-break:break-word}

/* 右边缘滑页条：只在整理模式出现 */
.desk-edge-strip{position:fixed;right:0;top:50%;transform:translateY(-50%) translateX(120%);z-index:8800;
  width:30px;height:170px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;
  padding:12px 0;border-radius:16px 0 0 16px;background:rgba(20,20,22,.42);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.18);border-right:0;touch-action:none;opacity:0;
  transition:transform .25s ease,opacity .25s ease;pointer-events:none}
.desk-edge-strip.on{transform:translateY(-50%) translateX(0);opacity:1;pointer-events:auto}
.desk-edge-strip .de-arrow{width:22px;height:22px;border:0;background:transparent;color:rgba(255,255,255,.85);
  font-size:12px;line-height:1;display:flex;align-items:center;justify-content:center;cursor:pointer}
.desk-edge-strip .de-track{flex:1;width:3px;margin:6px 0;border-radius:2px;background:rgba(255,255,255,.22);position:relative}
.desk-edge-strip .de-track i{position:absolute;left:-2px;top:50%;width:7px;height:7px;margin-top:-4px;
  border-radius:50%;background:#fff;box-shadow:0 0 6px rgba(255,255,255,.8);transition:top .18s}
.desk-edge-strip .de-dots{font-size:8px;color:rgba(255,255,255,.7);letter-spacing:1px;padding-bottom:2px}

/* ================= v74：AI 生态去紫（深浅通用） ================= */
.aie-tab{background:#f0f0f0;color:#333}
.aie-tab.on{background:#111;color:#fff}
.aie-fold{border-color:#e2e2e2;color:#333}
.aie-btn{background:#111;color:#fff}
.aie-btn.lite{background:#f0f0f0;color:#333}
.aie-ck input{accent-color:#111}
.aie-ck{border-bottom-color:#f0f0f0}
.aie-mask{background:rgba(0,0,0,.42)}
[data-theme="dark"] .aie-tab{background:#2a2a2e;color:#ddd}
[data-theme="dark"] .aie-tab.on{background:#f0f0f0;color:#111}
[data-theme="dark"] .aie-fold{border-color:#3a3a3a;color:#ddd}
[data-theme="dark"] .aie-btn{background:#f0f0f0;color:#111}
[data-theme="dark"] .aie-btn.lite{background:#2a2a2e;color:#ddd}
[data-theme="dark"] .aie-ck input{accent-color:#ddd}
[data-theme="dark"] .aie-ck{border-bottom-color:#2e2e35}
[data-theme="dark"] .crw-pri{background:#f0f0f0;color:#111}
[data-theme="dark"] .crw-sec{background:#26262b;border-color:#3a3a42;color:#ddd}

/* ================= v75 ================= */
/* 格子：＋ 在右上角；图片统一排到底部 */
.qd-cell{padding:10px 10px 12px}
.qd-cell-add{margin-left:auto;border:0;cursor:pointer;flex:none;width:26px;height:26px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:17px;line-height:1;padding:0;
  color:#fff;background:linear-gradient(135deg,var(--qd-chip-a,#c58aa4),var(--qd-chip-b,#9a6a88));
  box-shadow:0 2px 8px rgba(140,90,116,.24);font-family:inherit}
.qd-cell-add:active{transform:scale(.92)}
.qd-cell-imgs{flex:none;display:flex;align-items:center;gap:5px;padding-top:7px;
  overflow-x:auto;overflow-y:hidden;scrollbar-width:none}
.qd-cell-imgs::-webkit-scrollbar{display:none}
.qd-cell-img{width:40px;height:40px;border-radius:8px;object-fit:cover;flex:none;display:block;
  background:rgba(150,120,140,.14);cursor:pointer}
.qd-img-more{font-size:10px;color:var(--qd-muted,#9c8b93);flex:none;padding:0 2px}

/* 页面底部「今天的全部记录」 */
.qd-grid{height:min(58vh,500px);max-height:min(58vh,500px)}
.qd-today{flex:none;align-self:center;margin:2px auto 10px;display:inline-flex;align-items:center;gap:6px;
  height:34px;padding:0 16px;border-radius:17px;border:1px solid rgba(180,140,160,.28);
  background:rgba(255,255,255,.72);color:#7a5568;font-size:12px;font-weight:600;letter-spacing:.5px;
  font-family:inherit;cursor:pointer;box-shadow:0 3px 12px rgba(140,100,120,.12)}
.qd-today svg{width:15px;height:15px;flex:none}
.qd-today:active{transform:scale(.97)}
[data-theme="dark"] .qd-today{background:rgba(30,26,30,.7);border-color:rgba(255,255,255,.16);color:#e8d7df}

/* 日记本：成长路线标题行 + 最早 / 最新 */
.qd-route-hd{justify-content:space-between;align-items:center}
.qd-route-hd>span{display:flex;align-items:baseline;gap:7px}
.qd-route-hd .qd-daynav{position:static;transform:none;flex-direction:row;gap:8px;margin-left:auto}
.qd-route-hd .qd-daynav button{width:30px;height:30px;border-radius:50%;padding:0;cursor:pointer;
  border:1.4px solid rgba(150,110,125,.42);background:transparent;color:#8d5f6f;
  display:flex;align-items:center;justify-content:center}
.qd-route-hd .qd-daynav button svg{width:15px;height:15px}
.qd-route-hd .qd-daynav button:active{background:rgba(150,110,125,.14)}
[data-theme="dark"] .qd-route-hd .qd-daynav button{border-color:rgba(255,255,255,.3);color:#e6cdd8}

/* 日记本：每天四个格子（经历 / 连接 / 行动 / 感受） */
.qd-dcells{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.qd-dcell{border-radius:12px;padding:9px 10px;min-height:68px;display:flex;flex-direction:column;gap:4px;
  background:rgba(255,255,255,.58);border:1px solid rgba(180,150,165,.18);cursor:pointer}
.qd-dcell:active{transform:scale(.985)}
.qd-dcell.off{opacity:.55;cursor:default}
.qd-dcell.off:active{transform:none}
.qd-dc-top{display:flex;align-items:center;gap:5px}
.qd-dc-name{font-size:11px;font-weight:700;color:#8d5f6f;letter-spacing:1px}
.qd-dc-n{margin-left:auto;font-size:9.5px;color:rgba(140,110,120,.7)}
.qd-dc-txt{font-size:11.5px;line-height:1.5;color:#4a3733;display:-webkit-box;-webkit-line-clamp:2;
  -webkit-box-orient:vertical;overflow:hidden;word-break:break-word}
.qd-dc-th{display:flex;gap:4px;margin-top:auto}
.qd-dc-th img{width:28px;height:28px;border-radius:5px;object-fit:cover;background:rgba(150,120,140,.14)}
.qd-dc-more{font-size:9px;color:rgba(140,110,120,.8);align-self:flex-end}
[data-theme="dark"] .qd-dcell{background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.1)}
[data-theme="dark"] .qd-dc-name{color:#e0bccb}
[data-theme="dark"] .qd-dc-txt{color:#e6d9d4}
[data-theme="dark"] .qd-dcell.off{opacity:.45}

/* 批注里的图片 / 表情包 */
.qd-note-img{display:inline-block;vertical-align:middle}
.qd-note-img img{max-width:96px;max-height:72px;border-radius:6px;display:block}

/* 单格只读查看 */
.qd-view.readonly .qd-view-sub{color:rgba(140,110,120,.9)}

/* ================= v77 ================= */
/* 修：排版块颜色 / 每天条数 的弹窗被四象限页（z 420）盖住，看起来像「回到桌面才出现」 */
.modal-mask{z-index:470}

/* 四象限底部：日记本条（可改名、长按编辑、箭头纯装饰） */
.qd-diary-bar{flex:none;align-self:stretch;margin:0 16px 12px;display:flex;align-items:center;gap:9px;
  height:50px;padding:0 15px;border-radius:15px;border:1px solid rgba(180,140,160,.26);
  background:rgba(255,255,255,.8);color:#6f4f5e;font-family:inherit;font-size:15px;font-weight:600;
  letter-spacing:.4px;cursor:pointer;box-shadow:0 4px 16px rgba(140,100,120,.1);
  user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;text-align:left}
.qd-diary-bar:active{transform:scale(.99)}
.qdb-ico{position:relative;width:22px;height:22px;flex:none;display:flex;align-items:center;justify-content:center;color:#8d5f6f}
.qdb-ico svg{width:19px;height:19px}
.qdb-plus{position:absolute;right:-7px;top:-7px;width:14px;height:14px;border-radius:50%;
  background:#fff;color:#b0899c;font-style:normal;font-size:12px;line-height:14px;text-align:center;
  font-weight:700;box-shadow:0 1px 4px rgba(0,0,0,.2)}
.qdb-name{flex:none;max-width:46%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.qdb-n{font-size:11px;font-weight:500;color:rgba(140,110,120,.75);margin-left:1px}
.qdb-arrow{margin-left:auto;font-size:20px;line-height:1;color:#b0899c;pointer-events:none}
[data-theme="dark"] .qd-diary-bar{background:rgba(28,24,28,.8);border-color:rgba(255,255,255,.16);color:#e8d7df}
[data-theme="dark"] .qdb-ico{color:#e6cdd8}
[data-theme="dark"] .qdb-plus{background:#f0f0f0;color:#444}
[data-theme="dark"] .qdb-n{color:rgba(230,205,216,.6)}
[data-theme="dark"] .qdb-arrow{color:#c9a6b6}

/* 日记本照片：两张拍立得 */
.qd-memories{flex:none;margin:2px 0 12px}
.qd-mem-hd{display:flex;align-items:center;justify-content:space-between;padding:0 4px 8px;
  font-size:9px;letter-spacing:2.2px;color:rgba(120,96,108,.6);text-transform:uppercase}
.qd-polaroids{display:flex;justify-content:center;gap:14px;padding:7px 2px 4px}
.qd-pol{position:relative;width:calc(50% - 9px);max-width:150px;aspect-ratio:.82;display:flex;flex-direction:column;
  background:#fff;border-radius:2px;padding:6px 6px 0;
  box-shadow:0 7px 18px rgba(120,90,105,.16),0 1px 3px rgba(120,90,105,.1);
  transform:rotate(var(--rot,-2.6deg));transition:transform .2s}
.qd-pol:active{transform:rotate(var(--rot,-2.6deg)) scale(.985)}
.qd-pol img{flex:1;min-height:0;width:100%;object-fit:cover;display:block;border-radius:1px}
.qd-pol-cap{flex:none;height:22px;line-height:22px;text-align:center;font-size:8px;
  color:rgba(120,96,108,.62);letter-spacing:.3px;white-space:nowrap;overflow:hidden}
.qd-pol-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  background:linear-gradient(160deg,#f5f2f0,#edeae7);border-radius:1px}
.qd-pol-plus{font-size:21px;line-height:1;color:rgba(150,130,140,.65)}
.qd-pol-empty em{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:10.5px;
  color:rgba(150,130,140,.8);letter-spacing:.2px;text-align:center;padding:0 5px;line-height:1.4}
[data-theme="dark"] .qd-pol{background:#2a2729;box-shadow:0 7px 18px rgba(0,0,0,.4)}
[data-theme="dark"] .qd-pol-empty{background:linear-gradient(160deg,#312d30,#2a2729)}
[data-theme="dark"] .qd-pol-cap{color:rgba(230,210,220,.55)}
[data-theme="dark"] .qd-mem-hd{color:rgba(230,210,220,.55)}

/* 全部照片弹窗 */
.qd-allp{position:fixed;inset:0;z-index:520;display:none;align-items:center;justify-content:center;
  background:rgba(28,22,26,.5);padding:18px}
.qd-allp.on{display:flex}
.qd-allp-box{width:min(92vw,430px);max-height:82vh;display:flex;flex-direction:column;
  background:#fff;border-radius:20px;padding:14px 14px 8px;box-shadow:0 20px 50px rgba(0,0,0,.28)}
.qd-allp-hd{flex:none;display:flex;align-items:center;gap:8px;padding:0 2px 10px}
.qd-allp-hd b{font-size:14px;color:#4a3733;letter-spacing:.5px}
.qd-allp-hd span{font-size:11px;color:#9c8b93}
.qd-allp-x{margin-left:auto;border:0;background:transparent;font-size:17px;line-height:1;color:#9c8b93;cursor:pointer;padding:4px}
.qd-allp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;overflow:auto;padding-bottom:6px}
.qd-allp-it{position:relative;aspect-ratio:1;border-radius:9px;overflow:hidden;background:#f0eef0;cursor:pointer}
.qd-allp-it img{width:100%;height:100%;object-fit:cover;display:block}
.qd-allp-it small{position:absolute;left:0;right:0;bottom:0;padding:2px 4px;font-size:8px;color:#fff;
  background:linear-gradient(transparent,rgba(0,0,0,.55));text-align:right;letter-spacing:.2px}
[data-theme="dark"] .qd-allp-box{background:#1c1a1d}
[data-theme="dark"] .qd-allp-hd b{color:#e8d7df}
[data-theme="dark"] .qd-allp-it{background:#2a2729}

/* 日记本改名弹窗 */
.qd-label-pop{position:fixed;inset:0;z-index:480;display:none;align-items:center;justify-content:center;
  background:rgba(28,22,26,.42);padding:22px}
.qd-label-pop.on{display:flex}
.qlp-box{width:min(88vw,330px);background:#fff;border-radius:18px;padding:16px 16px 12px;
  box-shadow:0 18px 44px rgba(0,0,0,.24)}
.qlp-box b{display:block;font-size:15px;color:#4a3733;margin-bottom:10px;letter-spacing:.5px}
.qlp-box input{width:100%;height:42px;border-radius:11px;border:1px solid rgba(154,120,140,.3);
  background:#faf8f9;padding:0 12px;font-size:14px;font-family:inherit;color:#3a2e33;outline:none}
.qlp-box input:focus{border-color:#c58aa4}
.qlp-row{display:flex;gap:8px;margin-top:12px}
.qlp-row button{flex:1;height:40px;border-radius:11px;border:1px solid rgba(154,120,140,.28);
  background:#f5f2f4;color:#6f4f5e;font-family:inherit;font-size:13.5px;cursor:pointer}
.qlp-row #qd-label-ok{background:#8d5f6f;border-color:#8d5f6f;color:#fff}
[data-theme="dark"] .qlp-box{background:#1c1a1d}
[data-theme="dark"] .qlp-box b{color:#e8d7df}
[data-theme="dark"] .qlp-box input{background:#26232a;border-color:rgba(255,255,255,.16);color:#eee}
[data-theme="dark"] .qlp-row button{background:#26232a;border-color:rgba(255,255,255,.14);color:#ddd}
[data-theme="dark"] .qlp-row #qd-label-ok{background:#e8d7df;border-color:#e8d7df;color:#1c1a1d}

</style>
<style id="v78-css">
/* ===== v78 ===== */

/* ---- 1. 四象限格子里的便签：四格通用，抬高层级、限制尺寸，避免被图片条盖住 ---- */
.qd-cell .qd-sticky{z-index:7;max-width:62%}
.qd-cell .qd-sticky.mini{z-index:7;max-width:54%}
.qd-cell .qd-sticky small{pointer-events:none}

/* ---- 2. 「今天的全部记录」里的批注 = 便签形象（截图2） ---- */
.qd-daysticky-wrap{padding:6px 2px 8px;display:flex}
.qd-sticky.qd-daysticky{position:relative;display:inline-block;left:auto;top:auto;
  max-width:92%;padding:8px 10px 9px;border-radius:3px 3px 10px 3px;
  transform:rotate(var(--rot,-1.8deg));box-shadow:0 5px 14px rgba(120,90,40,.18),0 1px 2px rgba(120,90,40,.12)}
.qd-sticky.qd-daysticky:before{content:'';position:absolute;top:-4px;left:22px;width:26px;height:9px;
  background:rgba(255,255,255,.55);transform:rotate(-3deg);border-radius:1px;
  box-shadow:0 1px 2px rgba(0,0,0,.06)}
[data-theme="dark"] .qd-sticky.qd-daysticky{background:linear-gradient(160deg,#3b341f,#2a2517);color:#ece0b8}
[data-theme="dark"] .qd-sticky.qd-daysticky:before{background:rgba(255,255,255,.18)}

/* ---- 3. 日记本成长路线格子里的小便签 ---- */
.qd-dcell{position:relative}
.qd-dc-sticky{position:absolute;right:4px;bottom:4px;z-index:3;max-width:46%;
  padding:3px 5px 4px;border-radius:2px 2px 6px 2px;
  background:linear-gradient(160deg,#fff4cc,#ffe9ae);color:#6d5320;
  font-size:8.5px;line-height:1.25;box-shadow:0 2px 7px rgba(120,90,40,.2);
  transform:rotate(var(--rot,-2deg));pointer-events:none;
  display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;
  white-space:nowrap;text-overflow:ellipsis;word-break:break-all}
.qd-dc-sticky small{display:inline;font-size:7.5px;opacity:.62;letter-spacing:.3px;margin-right:3px}
.qd-dc-sticky i{font-style:normal;font-size:7.5px;opacity:.6;margin-left:2px}
[data-theme="dark"] .qd-dc-sticky{background:linear-gradient(160deg,#3d3520,#2b2416);color:#ece0b8}

/* 日记本左上角「返回」按钮：按要求挪到底部「四象限」条，这里不再显示 */
#qd-diary .qd-dhd #qd-diary-back{display:none}
#qd-diary .qd-dhd{padding-left:16px}

/* ---- 4. 日记本底部「四象限」返回条（复用 .qd-diary-bar 外观） ---- */
.qd-quad-bar{margin-top:2px}
.qd-quad-bar .qdb-ico{position:relative}
.qd-quad-bar .qdb-plus{position:absolute;right:-4px;top:-4px;width:12px;height:12px;border-radius:50%;
  background:#fff;color:#a06a80;font-size:10px;line-height:12px;text-align:center;font-weight:700;
  box-shadow:0 1px 3px rgba(0,0,0,.16);font-style:normal}
[data-theme="dark"] .qd-quad-bar .qdb-plus{background:#2a2328;color:#f0dde6}
.qd-quad-bar .qdb-name{max-width:none}
.qd-quad-bar .qdb-n{display:none}

/* 四象限 / 日记本改名弹窗共用样式已存在；四象限条用独立小弹窗 */
#qd-quad-label-pop.qd-label-pop{z-index:530}
#qd-quad-label-pop .qlp-row #qql-ok{background:#8d5f6f;border-color:#8d5f6f;color:#fff}
[data-theme="dark"] #qd-quad-label-pop .qlp-row #qql-ok{background:#e8d7df;border-color:#e8d7df;color:#1c1a1d}

/* ---- 5. 图标设置里的「分组…」按钮 ---- */
#modal-pills .pill.igrp-pill{position:relative}
#modal-pills .pill.igrp-pill:after{content:'';position:absolute;right:8px;top:50%;width:6px;height:6px;
  border-right:1.6px solid currentColor;border-bottom:1.6px solid currentColor;
  transform:translateY(-70%) rotate(-45deg);opacity:.55}

/* ---- 6. 分组选择面板 ---- */
.igrp-mask{position:fixed;inset:0;z-index:530;background:rgba(18,12,15,.44);
  display:flex;align-items:flex-end;justify-content:center;backdrop-filter:blur(2px)}
.igrp-card{width:100%;max-width:440px;max-height:80vh;overflow:auto;-webkit-overflow-scrolling:touch;
  background:#fff;color:#2b2226;border-radius:20px 20px 0 0;
  padding:16px 16px calc(14px + env(safe-area-inset-bottom,0px));
  box-shadow:0 -10px 34px rgba(0,0,0,.22);animation:igrpUp .22s ease}
@keyframes igrpUp{from{transform:translateY(22px);opacity:.6}to{transform:none;opacity:1}}
[data-theme="dark"] .igrp-card{background:#1f1b1e;color:#f0e7ea}
.igrp-hd{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:4px}
.igrp-hd b{font-size:16px;letter-spacing:.5px}
.igrp-hd button{border:0;background:transparent;color:inherit;font-size:20px;line-height:1;padding:2px 4px;opacity:.55;cursor:pointer}
.igrp-tip{font-size:11.5px;line-height:1.6;color:#8a7680;margin:2px 0 12px}
[data-theme="dark"] .igrp-tip{color:#a99aa2}
.igrp-sec{font-size:10.5px;font-weight:700;letter-spacing:1.6px;color:#a08b95;margin:14px 0 7px}
.igrp-old{display:flex;flex-direction:column;gap:7px}
.igrp-old-row{display:flex;align-items:center;gap:9px;padding:9px 11px;border-radius:12px;
  background:#faf6f8;border:1px solid #f0e6ea}
[data-theme="dark"] .igrp-old-row{background:#282226;border-color:#382f35}
.igrp-old-row .n{flex:1;min-width:0;font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.igrp-old-row .c{font-size:11px;color:#a08b95;flex:none}
.igrp-old-row button{flex:none;border:0;border-radius:9px;padding:6px 11px;font-size:12px;
  background:#2b2226;color:#fff;cursor:pointer}
[data-theme="dark"] .igrp-old-row button{background:#efe4e9;color:#221b1f}
.igrp-old-row button[disabled]{opacity:.4;cursor:default}
.igrp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px 6px}
.igrp-it{display:flex;flex-direction:column;align-items:center;gap:5px;padding:9px 3px 7px;border-radius:13px;
  border:1.5px solid transparent;background:#faf7f9;cursor:pointer;position:relative;
  -webkit-tap-highlight-color:transparent;user-select:none}
[data-theme="dark"] .igrp-it{background:#262125}
.igrp-it.on{border-color:#c58aa4;background:#fdf3f7}
[data-theme="dark"] .igrp-it.on{border-color:#c58aa4;background:#332830}
.igrp-it .ic{width:30px;height:30px;display:flex;align-items:center;justify-content:center;opacity:.9}
.igrp-it .ic svg{width:24px;height:24px}
.igrp-it .nm{font-size:9.5px;color:#6f5d66;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
[data-theme="dark"] .igrp-it .nm{color:#c9b8c2}
.igrp-it .ck{position:absolute;right:5px;top:5px;width:15px;height:15px;border-radius:50%;
  border:1.4px solid #cbb6c1;background:#fff;font-size:9px;line-height:13px;text-align:center;color:#fff}
[data-theme="dark"] .igrp-it .ck{background:#1f1b1e;border-color:#5a4a53}
.igrp-it.on .ck{background:#c58aa4;border-color:#c58aa4;color:#fff}
.igrp-act{display:flex;gap:10px;margin-top:16px}
.igrp-act button{flex:1;border:0;border-radius:13px;padding:12px;font-size:14px;font-weight:700;cursor:pointer}
.igrp-act .ghost{background:#f3edf0;color:#5d4b55}
[data-theme="dark"] .igrp-act .ghost{background:#2b2529;color:#d9c8d1}
.igrp-act .solid{background:#2b2226;color:#fff}
[data-theme="dark"] .igrp-act .solid{background:#efe4e9;color:#221b1f}
.igrp-act .solid[disabled]{opacity:.4}

</style>
<style id="v79-css">
/* ===== v79 =====
   1) 心讯：完整抽屉（专属字卡）/ 卡册 / 心讯设置
   2) 日记本：只有成长路线滚动、四格小图标、左上回主页
   3) 桌面：自动补位开关、图标换成大块、管理分组 / 管理音乐
*/

/* ---- 1. 心讯底栏搜索：占位文字不再溢出（被全站输入增强器替换后字号失控） ---- */
.xn-search input{min-width:0;font-size:11.5px;line-height:1;text-overflow:ellipsis}
.xn-search input::placeholder{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:11.5px;letter-spacing:0}
.xn-foot{gap:7px}
.xn-foot>span{max-width:82px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.xn-tools{gap:2px}
.xn-tools button{width:30px;height:30px}

/* ---- 2. 日记本：只有成长路线滚动 ---- */
#qd-diary .qd-dbody{display:flex;flex-direction:column;overflow:hidden;padding-bottom:4px}
#qd-diary .qd-memories,#qd-diary .qd-search2,#qd-diary .qd-route-hd{flex:0 0 auto}
#qd-diary .qd-list{flex:1 1 auto;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;
  overscroll-behavior:contain;padding-bottom:14px;scrollbar-width:none}
#qd-diary .qd-list::-webkit-scrollbar{display:none}
#qd-diary .qd-dhd{gap:7px}
#qd-diary .qd-dhd #qd-diary-home{display:flex}
/* 四格小图标（经历 / 连接 / 行动 / 感受） */
.qd-dc-ico{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;flex:none;
  margin-right:4px;color:rgba(150,100,120,.85);vertical-align:-3px}
.qd-dc-ico svg{width:14px;height:14px;display:block}
[data-theme="dark"] .qd-dc-ico{color:rgba(230,190,210,.8)}
.qd-dc-top{display:flex;align-items:center;gap:2px}

/* ---- 3. 心讯 · 完整抽屉 ---- */
.xnd-page{background:linear-gradient(180deg,#fbfbfc,#f4f5f7);display:flex;flex-direction:column}
[data-theme="dark"] .xnd-page{background:linear-gradient(180deg,#151516,#1d1d1f)}
.xnd-head{flex:none;display:flex;align-items:center;gap:9px;padding:14px 16px 8px}
.xnd-back{width:32px;height:32px;border:0;border-radius:50%;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.06);
  display:flex;align-items:center;justify-content:center;cursor:pointer;color:#222;flex:none}
.xnd-back svg{width:17px;height:17px}
[data-theme="dark"] .xnd-back{background:#242426;color:#eee}
.xnd-title{flex:1;min-width:0;font-size:16px;font-weight:700;letter-spacing:1px}
.xnd-title small{display:block;font-size:10px;font-weight:400;color:#9b9b9b;letter-spacing:.4px;margin-top:2px}
.xnd-sel{flex:none;font-size:10.5px;color:#9b9b9b;padding:4px 9px;border-radius:999px;background:rgba(0,0,0,.04)}
.xnd-search{flex:none;margin:2px 16px 8px;height:38px;border-radius:999px;background:#fff;border:1px solid rgba(0,0,0,.06);
  display:flex;align-items:center;gap:8px;padding:0 14px;box-shadow:0 1px 4px rgba(0,0,0,.03)}
.xnd-search svg{width:14px;height:14px;color:#b3b3b3;flex:none}
.xnd-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-family:inherit;font-size:12.5px;color:#222}
.xnd-search input::placeholder{color:#bdbdbd;font-size:12px}
[data-theme="dark"] .xnd-search{background:#242426;border-color:#333}
[data-theme="dark"] .xnd-search input{color:#eee}
.xnd-chips{flex:none;display:flex;gap:7px;overflow-x:auto;padding:0 16px 7px;scrollbar-width:none}
.xnd-chips::-webkit-scrollbar{display:none}
.xnd-chip{flex:none;height:30px;padding:0 13px;border-radius:999px;border:1px solid rgba(0,0,0,.08);background:#fff;
  font-family:inherit;font-size:11.5px;color:#555;cursor:pointer;white-space:nowrap}
.xnd-chip.on{background:#111;color:#fff;border-color:#111;font-weight:600}
[data-theme="dark"] .xnd-chip{background:#242426;border-color:#333;color:#ddd}
[data-theme="dark"] .xnd-chip.on{background:#f0f0f0;color:#111;border-color:#f0f0f0}
.xnd-tip{flex:none;padding:0 17px 6px;font-size:10.5px;color:#a3a3a3;letter-spacing:.2px}
.xnd-grid{flex:1 1 auto;min-height:0;overflow-y:auto;display:grid;grid-template-columns:1fr 1fr;gap:8px;
  padding:2px 14px 12px;align-content:start;overscroll-behavior:contain}
.xnd-card{position:relative;min-height:62px;border-radius:12px;border:1px solid rgba(0,0,0,.07);background:#fff;
  padding:11px 11px 10px;font-size:12px;line-height:1.55;color:#2b2b2b;cursor:pointer;overflow:hidden;
  display:flex;flex-direction:column;justify-content:center;word-break:break-word}
.xnd-card small{display:block;font-size:9px;color:#b0b0b0;margin-top:5px;letter-spacing:.3px}
.xnd-card.on{border-color:#111;box-shadow:0 0 0 1.5px #111 inset}
.xnd-card.on:after{content:'✓';position:absolute;right:7px;top:6px;font-size:11px;font-weight:700;color:#111}
.xnd-card.media{padding:0;min-height:96px;overflow:hidden}
.xnd-card.media img{width:100%;height:100%;object-fit:cover;display:block;position:absolute;inset:0}
.xnd-card.media small{position:absolute;left:8px;right:8px;bottom:6px;color:#fff;text-shadow:0 1px 4px rgba(0,0,0,.55);margin:0}
.xnd-card.media.on:after{color:#fff;background:#111;width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;right:6px;top:6px}
[data-theme="dark"] .xnd-card{background:#242426;border-color:#333;color:#eaeaea}
[data-theme="dark"] .xnd-card.on{border-color:#f0f0f0;box-shadow:0 0 0 1.5px #f0f0f0 inset}
[data-theme="dark"] .xnd-card.on:after{color:#f0f0f0}
.xnd-empty{grid-column:1/-1;text-align:center;color:#b3b3b3;font-size:12px;padding:34px 0}
.xnd-foot{flex:none;display:flex;gap:9px;padding:9px 16px calc(env(safe-area-inset-bottom,0px) + 12px);
  border-top:1px solid rgba(0,0,0,.06);background:rgba(255,255,255,.86);backdrop-filter:blur(12px)}
[data-theme="dark"] .xnd-foot{background:rgba(24,24,26,.9);border-top-color:rgba(255,255,255,.08)}
.xnd-foot button{flex:none;height:42px;padding:0 16px;border-radius:12px;border:1px solid rgba(0,0,0,.1);
  background:#fff;font-family:inherit;font-size:12.5px;color:#444;cursor:pointer}
.xnd-foot button.pri{flex:1;background:#111;color:#fff;border-color:#111;font-weight:700}
.xnd-foot button:disabled{opacity:.45}
[data-theme="dark"] .xnd-foot button{background:#242426;border-color:#3a3a3a;color:#ddd}
[data-theme="dark"] .xnd-foot button.pri{background:#f0f0f0;color:#111;border-color:#f0f0f0}

/* ---- 4. 心讯 · 卡册 ---- */
.xna-page{background:#f7f7f8;display:flex;flex-direction:column}
[data-theme="dark"] .xna-page{background:#141415}
.xna-body{flex:1;min-height:0;overflow-y:auto;padding:4px 16px 22px;overscroll-behavior:contain}
.xna-day{margin-bottom:16px}
.xna-day-h{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;color:#8b6b7a;
  letter-spacing:.6px;padding:6px 0 7px;border-bottom:1px dashed rgba(150,110,100,.25);margin-bottom:8px}
.xna-day-h small{margin-left:auto;font-weight:400;color:#aaa;letter-spacing:0}
.xna-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.xna-c{border-radius:10px;background:#fff;border:1px solid rgba(0,0,0,.06);padding:9px 10px;font-size:11.5px;
  line-height:1.5;color:#333;word-break:break-word;max-height:104px;overflow:hidden;position:relative}
.xna-c i{font-style:normal;font-size:9px;color:#b0b0b0;display:block;margin-top:4px}
.xna-c.me{background:#f2f4f7}
.xna-c img{width:100%;height:70px;object-fit:cover;border-radius:6px;display:block}
[data-theme="dark"] .xna-c{background:#242426;border-color:#333;color:#e6e6e6}
[data-theme="dark"] .xna-c.me{background:#2c2c30}

/* ---- 5. 心讯 · 设置 ---- */
.xns-mask{position:fixed;inset:0;z-index:9100;background:rgba(20,18,20,.32);display:flex;align-items:flex-end;
  -webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}
.xns-mask[hidden]{display:none}
.xns-sheet{width:100%;max-height:86vh;background:#fff;border-radius:22px 22px 0 0;display:flex;flex-direction:column;
  box-shadow:0 -12px 40px rgba(0,0,0,.18);animation:xnsUp .26s cubic-bezier(.22,1,.36,1) both}
@keyframes xnsUp{from{transform:translateY(28px);opacity:.4}to{transform:none;opacity:1}}
[data-theme="dark"] .xns-sheet{background:#1b1b1d;color:#eee}
.xns-hd{flex:none;display:flex;align-items:center;padding:16px 18px 6px}
.xns-hd b{font-size:15px;letter-spacing:1px}
.xns-hd small{font-size:9.5px;color:#aaa;letter-spacing:1.6px;margin-left:7px}
.xns-x{margin-left:auto;width:30px;height:30px;border:0;background:rgba(0,0,0,.05);border-radius:50%;
  color:#666;font-size:15px;cursor:pointer}
[data-theme="dark"] .xns-x{background:rgba(255,255,255,.09);color:#ddd}
.xns-tabs{flex:none;display:flex;gap:6px;overflow-x:auto;padding:6px 16px 10px;scrollbar-width:none}
.xns-tabs::-webkit-scrollbar{display:none}
.xns-tab{flex:none;border:0;background:transparent;font-family:inherit;font-size:12.5px;color:#8e8e8e;
  padding:7px 10px;border-radius:9px;cursor:pointer}
.xns-tab.on{background:#111;color:#fff;font-weight:600}
[data-theme="dark"] .xns-tab.on{background:#efefef;color:#111}
.xns-body{flex:1;min-height:0;overflow-y:auto;padding:0 18px 20px;overscroll-behavior:contain}
.xns-sec{font-size:10px;font-weight:700;letter-spacing:1.4px;color:#9a9a9a;padding:14px 2px 7px}
.xns-row{display:flex;align-items:center;gap:10px;padding:12px 2px;border-bottom:1px solid rgba(0,0,0,.06)}
[data-theme="dark"] .xns-row{border-bottom-color:rgba(255,255,255,.08)}
.xns-row .n{flex:1;min-width:0;font-size:12.5px;color:#2b2b2b;line-height:1.5}
[data-theme="dark"] .xns-row .n{color:#e8e8e8}
.xns-row .n small{display:block;font-size:10px;color:#a3a3a3;margin-top:2px;line-height:1.5}
.xns-sw{flex:none;width:42px;height:24px;border-radius:999px;background:#dedede;position:relative;cursor:pointer;
  transition:background .2s;border:0;padding:0}
.xns-sw:after{content:'';position:absolute;left:2px;top:2px;width:20px;height:20px;border-radius:50%;background:#fff;
  box-shadow:0 1px 3px rgba(0,0,0,.2);transition:transform .2s}
.xns-sw.on{background:#111}
.xns-sw.on:after{transform:translateX(18px)}
[data-theme="dark"] .xns-sw{background:#3a3a3a}
[data-theme="dark"] .xns-sw.on{background:#efefef}
[data-theme="dark"] .xns-sw.on:after{background:#1b1b1d}
.xns-chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.xns-chip{padding:7px 12px;border-radius:999px;border:1px solid rgba(0,0,0,.12);background:#fff;
  font-family:inherit;font-size:11.5px;color:#555;cursor:pointer}
.xns-chip.on{background:#111;color:#fff;border-color:#111;font-weight:600}
[data-theme="dark"] .xns-chip{background:#242426;border-color:#38383c;color:#ddd}
[data-theme="dark"] .xns-chip.on{background:#efefef;color:#111}
.xns-range{display:flex;align-items:center;gap:10px;padding:10px 2px 2px}
.xns-range input[type=range]{flex:1;accent-color:#111}
[data-theme="dark"] .xns-range input[type=range]{accent-color:#eee}
.xns-range b{flex:none;font-size:11.5px;font-weight:600;min-width:34px;text-align:right}
.xns-note{font-size:10.5px;line-height:1.7;color:#a3a3a3;padding:8px 2px 2px}

/* 牌面风格（作用于心讯里的字卡） */
.xn-face .xn-cc{position:relative}
.xn-face-yin .xn-cc{border:1px solid rgba(0,0,0,.16);box-shadow:inset 0 0 0 3px #fff,inset 0 0 0 4px rgba(0,0,0,.12),0 1px 4px rgba(0,0,0,.04)}
.xn-face-rong .xn-cc{border-radius:14px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.12),0 2px 8px rgba(120,90,110,.12)}
.xn-face-ling .xn-cc:before{content:'';position:absolute;left:6px;top:6px;width:5px;height:5px;border:1px solid rgba(0,0,0,.22);transform:rotate(45deg)}
.xn-face-zhang .xn-cc:before{content:'';position:absolute;right:6px;bottom:6px;width:11px;height:11px;border:1px solid rgba(0,0,0,.25);border-radius:50%}
.xn-face-jing .xn-cc{box-shadow:none;border-color:rgba(0,0,0,.05)}
.xn-paper .xn-card{background-image:linear-gradient(0deg,rgba(0,0,0,.012) 1px,transparent 1px);background-size:100% 4px}
.xn-inner .xn-cc:after{content:'';position:absolute;inset:4px;border:1px solid rgba(0,0,0,.07);border-radius:7px;pointer-events:none}
.xn-halo .xn-cc{text-shadow:0 0 1px rgba(255,255,255,.9),0 0 2px rgba(255,255,255,.9)}
[data-theme="dark"] .xn-face-yin .xn-cc{border-color:rgba(255,255,255,.2);box-shadow:inset 0 0 0 3px #242424,inset 0 0 0 4px rgba(255,255,255,.16)}
[data-theme="dark"] .xn-inner .xn-cc:after{border-color:rgba(255,255,255,.1)}
[data-theme="dark"] .xn-halo .xn-cc{text-shadow:none}

/* ---- 6. 桌面：图标换成大块 ---- */
.app.app-blk{grid-column:span 2;flex-direction:row;align-items:center;justify-content:flex-start;gap:11px;
  padding:12px 14px;min-height:76px;border-radius:17px;background:rgba(255,255,255,.9);
  border:1px solid rgba(0,0,0,.07);box-shadow:0 4px 14px rgba(0,0,0,.05);box-sizing:border-box}
.app.app-blk .app-ico{width:42px;height:42px;width:42px;height:42px;flex:none;border-radius:13px}
.app.app-blk .app-ico svg{width:23px;height:23px}
.app.app-blk .app-name{font-size:13px;font-weight:600;height:auto;line-height:1.3;max-width:100%;white-space:nowrap}
.app-blk-tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.app-blk-sub{font-size:10px;color:#9a9a9a;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
[data-theme="dark"] .app.app-blk{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.12)}
[data-theme="dark"] .app-blk-sub{color:#a8a8a8}

/* ---- 7. 管理面板（分组 / 音乐共用） ---- */
.mg-mask{position:fixed;inset:0;z-index:9200;background:rgba(18,16,18,.38);display:flex;align-items:center;justify-content:center;
  padding:18px;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.mg-box{width:100%;max-width:360px;max-height:82vh;background:#fff;border-radius:20px;display:flex;flex-direction:column;
  overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.22);animation:mgIn .22s ease both}
@keyframes mgIn{from{transform:scale(.96);opacity:.5}to{transform:none;opacity:1}}
[data-theme="dark"] .mg-box{background:#1c1c1e;color:#eee}
.mg-hd{flex:none;display:flex;align-items:center;padding:15px 17px 10px}
.mg-hd b{font-size:14px;letter-spacing:.6px}
.mg-hd small{margin-left:7px;font-size:10px;color:#aaa}
.mg-x{margin-left:auto;width:28px;height:28px;border:0;border-radius:50%;background:rgba(0,0,0,.05);color:#666;cursor:pointer}
[data-theme="dark"] .mg-x{background:rgba(255,255,255,.08);color:#ddd}
.mg-list{flex:1;min-height:0;overflow-y:auto;padding:2px 14px 8px;overscroll-behavior:contain}
.mg-row{display:flex;align-items:center;gap:10px;padding:11px 3px;border-bottom:1px solid rgba(0,0,0,.06);cursor:pointer}
[data-theme="dark"] .mg-row{border-bottom-color:rgba(255,255,255,.08)}
.mg-ck{width:19px;height:19px;flex:none;border-radius:6px;border:1.5px solid rgba(0,0,0,.22);display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff}
.mg-row.on .mg-ck{background:#111;border-color:#111}
.mg-nm{flex:1;min-width:0;font-size:12.5px;line-height:1.5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mg-nm small{display:block;font-size:9.5px;color:#a5a5a5;margin-top:2px}
.mg-ft{flex:none;display:flex;gap:7px;padding:10px 14px 14px;border-top:1px solid rgba(0,0,0,.06);flex-wrap:wrap}
[data-theme="dark"] .mg-ft{border-top-color:rgba(255,255,255,.08)}
.mg-ft button{flex:1;min-width:64px;height:38px;border-radius:11px;border:1px solid rgba(0,0,0,.1);background:#fff;
  font-family:inherit;font-size:12px;color:#333;cursor:pointer}
.mg-ft button.pri{background:#111;color:#fff;border-color:#111;font-weight:600}
.mg-ft button.danger{color:#b03a4a;border-color:rgba(176,58,74,.3)}
[data-theme="dark"] .mg-ft button{background:#262628;border-color:#3a3a3e;color:#ddd}
[data-theme="dark"] .mg-ft button.pri{background:#efefef;color:#111;border-color:#efefef}
.mg-empty{text-align:center;color:#b0b0b0;font-size:12px;padding:30px 0}

/* 整理模式里的「管理分组」按钮 */
#decor-bar #decor-manage-groups{display:inline-flex}

/* 抽屉里图片/表情包卡的水印底：浅色图上「表情包」也能看清 */
.xnd-card.media img{z-index:0}
.xnd-card.media:before{content:'';position:absolute;left:0;right:0;bottom:0;height:42%;pointer-events:none;
  z-index:1;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.42) 100%)}
.xnd-card.media small{z-index:2;font-size:9.5px}
.xnd-card.media.on:after{z-index:3}

</style>
<script id="v77-quad">
/* ================= v73 · 四象限 / 日记本 ================= */
(function () {
  'use strict';
  if (window.__qdInit) return;
  window.__qdInit = true;

  var D = document;
  function $(id) { return D.getElementById(id); }
  function pad2(n) { return n < 10 ? '0' + n : '' + n; }
  function dkey(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
  function fmtFull(ms) {
    var d = new Date(ms);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
  }
  function fmtDay(ms) { var d = new Date(ms); return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
  function hm(ms) { var d = new Date(ms); return pad2(d.getHours()) + ':' + pad2(d.getMinutes()); }
  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
  function toast(m) { try { if (window.toast) window.toast(m); } catch (e) {} }
  function setVar(k, v) { try { D.documentElement.style.setProperty(k, v); } catch (e) {} }
  function mk(tag, cls, txt) {
    var e = D.createElement(tag);
    if (cls) e.className = cls;
    if (txt != null) e.textContent = txt;
    return e;
  }
  function on(e, ev, fn) { if (e) e.addEventListener(ev, fn); }
  function touchStop(e) { try { e.stopPropagation(); } catch (x) {} }

  var ZONES = [
    { k: 'exp', n: '经历', num: '01', sub: '印象深刻的小事', ph: '例：甜品店上新了，下班看到夕阳' },
    { k: 'link', n: '连接', num: '02', sub: '和他有关的东西', ph: '例：他今天提到了那首歌' },
    { k: 'act', n: '行动', num: '03', sub: '因为他去做的事', ph: '例：尝试一种新食物' },
    { k: 'feel', n: '感受', num: '04', sub: '经历带来的感受', ph: '例：幸好有你' }
  ];
  /* v79：四格 / 日记本成长路线的小图标（用户直派「日记本的经历也要放个图标」） */
  var ZICONS = {
    exp: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V5.5l5-2 6 2 5-2V18l-5 2-6-2-5 2z"/><path d="M9 3.5v14.5M15 5.5V21"/></svg>',
    link: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13.5a4 4 0 005.7 0l2.6-2.6a4 4 0 00-5.7-5.7l-1.5 1.5"/><path d="M14 10.5a4 4 0 00-5.7 0l-2.6 2.6a4 4 0 005.7 5.7l1.5-1.5"/></svg>',
    act: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3L5 14h6l-1 7 8-11h-6z"/></svg>',
    feel: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5S4.5 15.2 4.5 9.9A4.9 4.9 0 0112 7.1a4.9 4.9 0 017.5 2.8c0 5.3-7.5 10.6-7.5 10.6z"/></svg>'
  };
  function zoneOf(k) { for (var i = 0; i < ZONES.length; i++) if (ZONES[i].k === k) return ZONES[i]; return ZONES[0]; }

  /* ---------------- 存储 ----------------
     v81（用户直派「数据导入后没有四象限的数据」）：旧版把四象限放在独立的
     xy-quadrant 库里，「导出数据 / 导入数据」只覆盖主库 mochi-db——备份里
     根本没有四象限，导入后自然全丢。现在统一写主库（xy-home-v2:qd-* 键），
     备份自动包含；首次启动把旧库数据一次性搬过来，老数据不丢。 */
  var QD_MIG = null;
  function oldOpen() {
    return new Promise(function (res) {
      try {
        /* v83：不写死版本号——老库若已是更高版本，带版本号打开会直接 VersionError，
           迁移静默失败＝四象限记录回不来；不带版本号按现状打开最稳。 */
        var r = indexedDB.open('xy-quadrant');
        r.onsuccess = function () {
          var db = r.result;
          try {
            if (!db.objectStoreNames.contains('kv')) {
              /* 找不到 kv 就退而取第一个仓库（老版本个别构建可能改过仓库名） */
              var names = [], i;
              for (i = 0; i < db.objectStoreNames.length; i++) names.push(db.objectStoreNames[i]);
              db.__qdst = names.length ? names[0] : 'kv';
            } else db.__qdst = 'kv';
          } catch (eN) { db.__qdst = 'kv'; }
          res(db);
        };
        r.onerror = function () { res(null); };
        r.onblocked = function () { res(null); };
      } catch (e) { res(null); }
    });
  }
  function qdKey(k) { return k.indexOf('img:') === 0 ? 'xy-home-v2:qd-img-' + k.slice(4) : 'xy-home-v2:qd-' + k; }
  var QD_EMPTY = ['', 'null', '[]', '{}', '""'];
  function qdValEmpty(v) { return v == null || QD_EMPTY.indexOf(String(v).trim()) >= 0; }
  function qdMigrate() {
    if (QD_MIG) return QD_MIG;
    QD_MIG = oldOpen().then(function (db) {
      if (!db || !window.idbGet || !window.idbSet) return;
      return new Promise(function (res) {
        var done = false;
        const fin = function () { if (!done) { done = true; res(); } };
        try {
          var st = db.__qdst || 'kv';
          var t = db.transaction(st, 'readonly');
          var rq = t.objectStore(st).openCursor();
          rq.onsuccess = function () {
            var c = rq.result;
            if (!c) { fin(); return; }
            var k = String(c.key || ''), v = c.value;
            if (v != null) {
              /* v83：当前值为空（没写过/被导入写成空）也补搬，不再只认 null */
              window.idbGet(qdKey(k)).then(function (cur) {
                if (qdValEmpty(cur)) { try { window.idbSet(qdKey(k), v); } catch (e) {} }
                try { c.continue(); } catch (e2) { fin(); }
              }).catch(function () { try { c.continue(); } catch (e3) { fin(); } });
            } else { try { c.continue(); } catch (e4) { fin(); } }
          };
          rq.onerror = fin;
          setTimeout(fin, 10000); // 兜底：旧库再大也在 10 秒内放行
        } catch (e) { fin(); }
      });
    }).catch(function () {});
    return QD_MIG;
  }
  function dbGet(k) {
    return qdMigrate().then(function () {
      if (!window.idbGet) return null;
      return window.idbGet(qdKey(k)).then(function (v) {
        if (v != null || k.indexOf('img:') !== 0) return v;
        /* 兜底：个别旧图还没搬完时再问一次旧库 */
        return oldOpen().then(function (db) {
          if (!db) return null;
          return new Promise(function (res) {
            try {
              var q = db.transaction('kv', 'readonly').objectStore('kv').get(k);
              q.onsuccess = function () { res(q.result); };
              q.onerror = function () { res(null); };
            } catch (e) { res(null); }
          });
        });
      });
    });
  }
  function dbSet(k, v) {
    return qdMigrate().then(function () {
      if (!window.idbSet) return false;
      return window.idbSet(qdKey(k), v);
    });
  }
  function dbDel(k) {
    return qdMigrate().then(function () {
      if (window.idbDelete) { try { return window.idbDelete(qdKey(k)); } catch (e) {} }
      return false;
    });
  }

  /* ---------------- 图片缓存 ---------------- */
  var IMG = {}, IMGQ = {};
  function imgUse(id) {
    if (!id) return '';
    if (IMG[id]) return IMG[id];
    if (!IMGQ[id]) {
      IMGQ[id] = 1;
      dbGet('img:' + id).then(function (v) {
        if (v) { IMG[id] = v; scheduleLook(); }
      });
    }
    return '';
  }
  function putImg(dataUrl) {
    var id = 'i' + uid();
    IMG[id] = dataUrl;                 /* 先入内存，缩略图立刻可见 */
    dbSet('img:' + id, dataUrl).then(function (ok) {
      if (!ok) toast('图片没存进去');
    });
    return id;
  }
  function pickImage(cb) {
    var inp = D.createElement('input');
    inp.type = 'file'; inp.accept = 'image/*'; inp.multiple = true;
    inp.addEventListener('change', function () {
      var fs = inp.files; if (!fs || !fs.length) return;
      toast('正在处理 ' + fs.length + ' 张图片…');
      var chain = Promise.resolve(), ids = [];
      Array.prototype.forEach.call(fs, function (f) {
        chain = chain.then(function () {
          return new Promise(function (res) {
            var fr = new FileReader();
            fr.onload = function () {
              var raw = String(fr.result || '');
              var done = function (u) { ids.push(putImg(u || raw)); setTimeout(res, 45); };
              if (window.compressImageFit) {
                Promise.resolve(window.compressImageFit(raw, 1280, 300 * 1024)).then(done, function () { done(raw); });
              } else done(raw);
            };
            fr.onerror = function () { res(); };
            fr.readAsDataURL(f);
          });
        });
      });
      chain.then(function () { cb(ids); });
    });
    inp.click();
  }

  /* ---------------- 状态 ---------------- */
  var S = {
    v: 1,
    recs: [],
    notes: [],
    plan: {},
    wall: { light: [], dark: [], sel: { light: '', dark: '' } },
    bub: { light: [], dark: [], sel: { light: '', dark: '' } },
    cardColor: '',
    annot: { on: true, count: 3, groups: [], pool: [], cat: {} },
    diary: { text: '' }
  };
  var loaded = false, loading = null, saveT = 0, lookT = 0;

  function norm() {
    if (!Array.isArray(S.recs)) S.recs = [];
    if (!Array.isArray(S.notes)) S.notes = [];
    if (!S.plan || typeof S.plan !== 'object') S.plan = {};
    ['wall', 'bub'].forEach(function (k) {
      if (!S[k]) S[k] = { light: [], dark: [], sel: { light: '', dark: '' } };
      if (!Array.isArray(S[k].light)) S[k].light = [];
      if (!Array.isArray(S[k].dark)) S[k].dark = [];
      if (!S[k].sel) S[k].sel = { light: '', dark: '' };
    });
    if (!S.annot || typeof S.annot !== 'object') S.annot = { on: true, count: 3, groups: [], pool: [], cat: {} };
    if (!Array.isArray(S.annot.groups)) S.annot.groups = [];
    if (!Array.isArray(S.annot.pool)) S.annot.pool = [];
    if (!S.annot.cat || typeof S.annot.cat !== 'object') S.annot.cat = {};
    if (typeof S.annot.count !== 'number') S.annot.count = 3;
    if (typeof S.cardColor !== 'string') S.cardColor = '';
    if (!S.diary || typeof S.diary !== 'object') S.diary = { text: '' };
    if (typeof S.diary.text !== 'string') S.diary.text = '';
  }

  /* v83：兜底收编——排查发现旧版本 / 备份导入链路曾把四象限状态写进
     带联系人前缀的键（xy-home-v2:default:qd-state / xy-home-v2:<桌面>:qd-state），
     而四象限读的是顶层 xy-home-v2:qd-state——数据其实还在，只是「换了名字」，
     看起来就是记录没回来。顶层为空时把前缀键里的数据收编到顶层（挑记录最多的一份，
     绝不覆盖已有数据），顺带把前缀命名的 qd-img 图片键也搬回顶层。 */
  function qdAdoptPrefixed() {
    var RE = /^xy-home-v2:(?:default|c[0-9a-z]{5,}):qd-state$/;
    var REIMG = /^xy-home-v2:(?:default|c[0-9a-z]{5,}):qd-img-(.+)$/;
    function lsCands() {
      var out = [];
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && RE.test(k)) { var v = localStorage.getItem(k); if (v && !qdValEmpty(v)) out.push(v); }
        }
      } catch (e0) {}
      return out;
    }
    function pickBest(list) {
      var best = null, bestScore = -1;
      (list || []).forEach(function (v) {
        try {
          var o = JSON.parse(String(v));
          var q = (o && o.quad) || {};
          var n = 0;
          Object.keys(q).forEach(function (k) { n += (Array.isArray(q[k]) ? q[k].length : 0); });
          var score = n * 10 + ((o && o.diary && o.diary.text) ? 1 : 0);
          if (score > bestScore) { bestScore = score; best = o; }
        } catch (e1) {}
      });
      return best;
    }
    var got = [];
    var scanIdb = window.idbListKeys
      ? window.idbListKeys().then(function (keys) {
          var ks = (keys || []).filter(function (k) { return RE.test(String(k)); });
          return Promise.all(ks.map(function (k) {
            return window.idbGet(String(k)).then(function (v) { if (!qdValEmpty(v)) got.push(String(v)); });
          }));
        }).catch(function () {})
      : Promise.resolve();
    return scanIdb.then(function () {
      got = got.concat(lsCands());
      var best = pickBest(got);
      var outRaw = null;
      if (best) {
        outRaw = JSON.stringify(best);
        try { window.idbSet('xy-home-v2:qd-state', outRaw); } catch (e2) {}
      }
      /* 前缀命名的图片键也搬回顶层（只补缺，不覆盖） */
      if (window.idbListKeys) {
        window.idbListKeys().then(function (keys) {
          (keys || []).forEach(function (k) {
            var m = REIMG.exec(String(k));
            if (!m) return;
            window.idbGet(String(k)).then(function (v) {
              if (v == null) return;
              return window.idbGet('xy-home-v2:qd-img-' + m[1]).then(function (cur) {
                if (cur == null) { try { window.idbSet('xy-home-v2:qd-img-' + m[1], v); } catch (e3) {} }
              });
            }).catch(function () {});
          });
        }).catch(function () {});
      }
      return outRaw;
    });
  }
  function loadState() {
    if (loading) return loading;
    loading = dbGet('state').then(function (raw) {
      var boot = (!raw || qdValEmpty(raw)) ? qdAdoptPrefixed().then(function (r2) { return r2 || raw; }) : Promise.resolve(raw);
      return boot.then(function (raw2) {
        if (raw2) {
          try {
            var o = JSON.parse(raw2);
            if (o && typeof o === 'object') {
              Object.keys(o).forEach(function (k) { S[k] = o[k]; });
            }
          } catch (e) {}
        }
        norm();
        loaded = true;
        applyLook();
        renderQuad();
        return S;
      });
    });
    return loading;
  }

  function save() {
    if (!loaded) return;
    clearTimeout(saveT);
    saveT = setTimeout(function () { dbSet('state', JSON.stringify(S)); }, 300);
  }

  /* ---------------- 外观（壁纸 / 气泡 / 块颜色） ---------------- */
  function isDark() {
    try { return D.documentElement.getAttribute('data-theme') === 'dark'; } catch (e) { return false; }
  }
  function modeNow() { return isDark() ? 'dark' : 'light'; }

  function applyLook() {
    var mode = modeNow();
    var wSel = S.wall.sel[mode] || S.wall[mode][0] || '';
    var bSel = S.bub.sel[mode] || S.bub[mode][0] || '';
    var wu = imgUse(wSel), bu = imgUse(bSel);
    var wVeil = isDark() ? 'rgba(18,14,17,.60)' : 'rgba(255,252,253,.52)';
    var bVeil = isDark() ? 'rgba(20,20,20,.55)' : 'rgba(255,255,255,.60)';
    setVar('--qd-wall-fill', wu ? 'linear-gradient(' + wVeil + ',' + wVeil + '),url("' + wu + '")' : '');
    var fill = '';
    /* v74：深色模式固定「黑块白字」，浅色里挑的块颜色只在浅色生效 */
    if (isDark()) {
      fill = bu ? ('linear-gradient(' + bVeil + ',' + bVeil + '),url("' + bu + '")') : '#111111';
    } else if (bu) {
      fill = 'linear-gradient(' + bVeil + ',' + bVeil + '),url("' + bu + '")';
    } else if (S.cardColor) {
      fill = S.cardColor;
    }
    setVar('--qd-card-fill', fill);
    /* v74：点完颜色立刻生效——直接写到已存在的格子上，不用等回桌面 */
    try {
      var cells = D.querySelectorAll('.qd-cell');
      for (var i = 0; i < cells.length; i++) {
        cells[i].style.background = fill || '';
        cells[i].style.backgroundSize = 'cover';
        cells[i].style.backgroundPosition = 'center';
      }
      var eb = D.querySelector('#qd-edit .qd-sheet-box');
      if (eb) {
        eb.style.background = fill || '';
        eb.style.backgroundSize = 'cover';
        eb.style.backgroundPosition = 'center';
      }
    } catch (eL) {}
  }
  function scheduleLook() {
    clearTimeout(lookT);
    lookT = setTimeout(function () { applyLook(); if (isQuadOpen()) renderQuad(); }, 60);
  }
  try {
    new MutationObserver(function () { applyLook(); }).observe(D.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  } catch (e) {}

  /* ---------------- 批注 ---------------- */
  function refreshPool(silent) {
    var arr = [];
    try { arr = (window.getCustomCards && window.getCustomCards()) || []; } catch (e) { arr = []; }
    arr = (arr || []).filter(function (x) {
      return typeof x === 'string' && x.trim() && x.indexOf('data:') !== 0 && x.indexOf('@@m:') !== 0 &&
        x.indexOf('http') !== 0 && x.indexOf('|||') < 0 && x.length <= 140;
    });
    S.annot.pool = arr;
    if (!silent) save();
    return arr;
  }
  /* v74：专属字卡分类（从颜文字到梦角自由造句），每类一个概率 */
  var CATS = [
    ['text', '主字卡'], ['kaomoji', '颜文字'], ['emoji', 'emoji'], ['sticker', '表情包'],
    ['image', '图片'], ['poke', '拍一拍'], ['lyric', '歌词摘取'], ['pick', '灵感拾取'],
    ['mjfree', '梦角自由造句']
  ];
  var POOL_CACHE = { at: 0, data: {} };
  function textCard(x) {
    if (typeof x !== 'string') return '';
    var t = x.trim();
    if (!t || t.length > 140) return '';
    if (t.indexOf('data:') === 0 || t.indexOf('@@m:') === 0 || t.indexOf('http') === 0 || t.indexOf('|||') >= 0) return '';
    return t;
  }
  /* v75：表情包 / 图片不做文字过滤，图片本身也能当批注 */
  function mediaCard(x) {
    if (typeof x !== 'string') return '';
    var t = x.trim();
    if (!t || t.length > 900000) return '';
    if (t.indexOf('data:image') === 0 || t.indexOf('http') === 0) return t;
    if (t.indexOf('@@m:') === 0 || t.indexOf('|||') >= 0) return t;
    return '';
  }
  function isMediaCard(t) {
    if (typeof t !== 'string' || !t) return false;
    if (t.indexOf('data:image') === 0) return true;
    if (t.indexOf('@@m:') === 0) return true;
    if (t.indexOf('|||') >= 0) return true;
    return /^https?:\/\//.test(t);
  }
  function cardOf(kind, x) {
    return (kind === 'sticker' || kind === 'image') ? mediaCard(x) : textCard(x);
  }
  /* 批注内容：文字直接显示，图片 / 表情包显示小图 */
  function noteNode(t, cls) {
    var txt = String(t || '');
    if (!isMediaCard(txt)) return D.createTextNode(txt);
    var src = '';
    if (txt.indexOf('@@m:') === 0) src = imgUse(txt.slice(4));
    else if (txt.indexOf('|||') >= 0) {
      var parts = txt.split('|||');
      for (var i = 0; i < parts.length; i++) {
        var p = parts[i];
        if (p.indexOf('data:image') === 0 || p.indexOf('http') === 0) { src = p; break; }
        if (p.indexOf('@@m:') === 0) { src = src || imgUse(p.slice(4)); }
      }
    } else src = txt;
    var w = mk('span', 'qd-note-img' + (cls ? ' ' + cls : ''));
    if (!src) { w.textContent = '［图片］'; return w; }
    var im = mk('img'); im.alt = ''; im.src = src;
    w.appendChild(im);
    return w;
  }
  function catPools() {
    var now = Date.now();
    if (POOL_CACHE.data && now - POOL_CACHE.at < 4000) return POOL_CACHE.data;
    var g = {};
    try { g = (window.getCcGroupsAll && window.getCcGroupsAll()) || {}; } catch (e) { g = {}; }
    var out = {};
    CATS.forEach(function (c) {
      var arr = [];
      (g[c[0]] || []).forEach(function (grp) {
        (grp[1] || []).forEach(function (x) {
          var t = cardOf(c[0], x);
          if (t && arr.indexOf(t) < 0) arr.push(t);
        });
      });
      out[c[0]] = arr;
    });
    POOL_CACHE = { at: now, data: out };
    return out;
  }
  function weightOf(k) {
    var w = Number(S.annot.cat[k]);
    return isNaN(w) ? 1 : Math.max(0, Math.min(100, w));
  }
  function pickText() {
    var pools = catPools();
    var keys = [], ws = [], tw = 0;
    CATS.forEach(function (c) {
      var list = pools[c[0]] || [];
      var w = weightOf(c[0]);
      if (!list.length || w <= 0) return;
      keys.push(c[0]); ws.push(w); tw += w;
    });
    if (!keys.length) {
      /* 全被调成 0，或者分类里没有字卡：退回「任取一张文字卡」 */
      CATS.some(function (c) { if ((pools[c[0]] || []).length) { keys = [c[0]]; ws = [1]; tw = 1; return true; } return false; });
      if (!keys.length) return '';
    }
    var r = Math.random() * tw, pick = keys[0];
    for (var i = 0; i < keys.length; i++) {
      r -= ws[i];
      if (r <= 0) { pick = keys[i]; break; }
    }
    var list = pools[pick] || [];
    if (!list.length) return '';
    return list[Math.floor(Math.random() * list.length)];
  }

  /* 计划：今天随机几个时刻；到点才生成、才出现（不提前、不补写昨天） */
  function usableCats() {
    var pools = catPools();
    for (var i = 0; i < CATS.length; i++) {
      if ((pools[CATS[i][0]] || []).length && weightOf(CATS[i][0]) > 0) return true;
    }
    return false;
  }

  function ensurePlan(d) {
    if (!S.annot.on) return;
    var p = S.plan[d];
    if (p && Array.isArray(p.slots)) return;
    var recs = S.recs.filter(function (r) { return r.d === d; });
    if (!recs.length) return;
    var now = Date.now();
    var end = new Date(); end.setHours(23, 59, 30, 0);
    var endMs = end.getTime();
    if (endMs <= now + 60000) return;
    /* v84（用户直派「每天批注上限 20 句，每个格子最多放 5 句」） */
    var madeToday = S.notes.filter(function (x) { return x && x.d === d; }).length;
    var n = Math.max(1, Math.min(20, parseInt(S.annot.count, 10) || 3));
    n = Math.min(n, Math.max(0, 20 - madeToday));
    if (!n) return;
    var slots = [], done = [];
    for (var i = 0; i < n; i++) {
      slots.push(now + 12000 + Math.random() * Math.max(30000, (endMs - now - 12000)));
      done.push(0);
    }
    slots.sort(function (a, b) { return a - b; });
    S.plan[d] = { slots: slots, done: done, made: 0 };
    save();
  }

  function tickPlan() {
    if (!loaded || !S.annot.on) return;
    var today = dkey(new Date());
    ensurePlan(today);
    var p = S.plan[today];
    if (!p || !Array.isArray(p.slots)) return;
    var now = Date.now(), changed = false;
    for (var i = 0; i < p.slots.length; i++) {
      if (p.done[i]) continue;
      if (p.slots[i] > now) continue;
      p.done[i] = 1;
      if (!S.annot.pool.length) refreshPool(true);
      var t = pickText();
      if (!t) continue;
      if (S.notes.filter(function (x) { return x && x.d === today; }).length >= 20) break; /* v84：每天最多 20 句 */
      var recs = S.recs.filter(function (r) { return r.d === today; });
      if (!recs.length) continue;
      var zs = [];
      recs.forEach(function (r) { if (zs.indexOf(r.z) < 0) zs.push(r.z); });
      /* v84：每个格子每天最多 5 句，本格满了就换别的格子；全满就跳过 */
      var room = zs.filter(function (zz) {
        var c = 0;
        S.notes.forEach(function (n2) { if (n2 && n2.d === today && n2.z === zz) c++; });
        return c < 5;
      });
      if (!room.length) continue;
      var z = room[Math.floor(Math.random() * room.length)];
      S.notes.push({
        id: uid(), d: today, z: z, t: t, at: now, revealAt: now,
        nx: 4 + Math.random() * 32, ny: 21 + Math.random() * 40,
        rot: (Math.random() * 8 - 4).toFixed(1)
      });
      p.made = (p.made || 0) + 1;
      changed = true;
    }
    if (changed) { save(); if (isQuadOpen()) renderQuad(); }
  }

  function notesOf(d, z) {
    var now = Date.now();
    return S.notes.filter(function (n) {
      return n.d === d && n.revealAt <= now && (!z || n.z === z);
    }).sort(function (a, b) { return a.revealAt - b.revealAt; });
  }

  /* ---------------- 主界面 ---------------- */
  function ensureDom() {
    if ($('qd-page')) return;

    /* ---- 主页面 ---- */
    var page = D.createElement('div');
    page.id = 'qd-page'; page.className = 'qd-ov qd-page';
    page.innerHTML =
      '<div class="qd-wall"></div>' +
      '<div class="qd-wrap">' +
        '<div class="qd-hd">' +
          '<button class="qd-icbtn" id="qd-back" aria-label="回到主页"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 10.6L12 3.6l8.5 7"/><path d="M5.6 9.4V20h12.8V9.4"/><path d="M9.8 20v-5.4h4.4V20"/></svg></button>' +
          '<div class="qd-title">四象限</div>' +
