var offN = offCountIn(ofRec);
deskInner += '<div class="storage-row"><span>' + esc(name) + (isCur ? '（当前桌面）' : '') + '<span class="ca-sub">' + (raw ? '库约 ' + kb + ' KB' : '空库') + ' · 停用分组 ' + offN + ' 个</span></span>' +
