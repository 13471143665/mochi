} catch (e) {}
}
const sfxPick = () => beep(500, 0.06, 0.14);
const sfxMatch = () => { beep(620, 0.08, 0.16); setTimeout(() => beep(830, 0.1, 0.16), 70); };
const sfxBad = () => beep(180, 0.07, 0.12);
