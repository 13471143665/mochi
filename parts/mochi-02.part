      '[data-theme="dark"] .crw-sec{background:#26262b;border-color:#38383f;color:#cfc0e0}',
      '[data-theme="dark"] .crw-cancel{color:#7c7787}',
      '[data-theme="dark"] .crw-eco-link{color:#b9a6cc}',
      /* v68：把原本的紫色全部换成常规色——浅色＝白底黑字，深色＝黑底白字 */
      '.crw-mask{background:rgba(0,0,0,.42)}',
