<!-- v45：字卡 AI 改写 + AI 生态（预设/世界书） -->
<script>/* inline: card-rewrite-yz.js */
/* card-rewrite-yz.js —— 字卡 AI 改写 + AI 生态（风格预设 / 世界书）v45
 *
 * 参考截图 1/3「改一下语气」与截图 2「AI 生态 · 活人感与内容」：
 *   · 原标题「改一下语气」，展示来源与原文；点「再让 AI 改一版」才用算力；
 *   · 改写结果可自己再改；下方「他会怎么想」给 1~10 分与档位；
 *   · 最后可「用这句替换原卡」或「另存为新字卡（原卡保留）」。
 *
 * 改写会读取「风格预设」与「世界书挂载」，尽量贴合角色人设。
 * 纯前端：默认走本地改写引擎（不联网）；若在 AI 生态里填了 OpenAI 兼容接口，
 * 则优先调用真模型，失败自动回退本地引擎。
 */
(function () {
  'use strict';

  var ECO_KEY = 'mochi-ai-eco';
  var BOOK_TEXT_MAX = 10000;    // v66：按用户要求改为 10000 字上限（单本世界书）
  var ecoCache = null;          // 本机内存副本：大包落到 IDB 时同步读也能拿到
  var PRESETS = [
    { id: 'nianShang', name: '年上活人感', on: true, brief: '年上、稳、宠但不腻' },
    { id: 'commonSense', name: '常识世界书', on: false, brief: '懂生活常识，不说离谱话' },
    { id: 'online', name: '天天上网', on: false, brief: '会用网络梗，但不烂梗' },
    { id: 'heartWeight', name: '心脏重量', on: true, brief: '情感有重量，克制而深' },
    { id: 'aliveLight', name: '活人感（轻量）', on: true, brief: '口语、有停顿、不端着' },
    { id: 'breakLimit', name: '极限破甲', on: false, brief: '更直白、更敢说' },
    { id: 'cake', name: '甜美小蛋糕5.0', on: false, brief: '甜、软、会撒娇' },
    { id: 'groupBook', name: '群聊世界书', on: false, brief: '群聊里也认得同一个人' }
  ];

  function $(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  function toast(t) {
    try { if (window.toast) { window.toast(t); return; } } catch (e) {}
    try {
      var el = $('cc-toast');
      if (!el) { el = document.createElement('div'); el.id = 'cc-toast'; document.body.appendChild(el); }
      el.textContent = t; el.className = 'cc-toast show';
      clearTimeout(el.__t); el.__t = setTimeout(function () { el.className = 'cc-toast'; }, 1800);
    } catch (e2) {}
  }
  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
  function clean(s) { return String(s == null ? '' : s).replace(/\s+/g, ' ').trim(); }
  /* 世界书正文要保留换行/分段（设定不能挤成一行），同时按字数上限截断。
     统一用 Array.from 按「码点」截断，与输入框计数口径一致，避免 emoji 等多字节字符
     被 UTF-16 slice 截断出半个代理对；正文首尾空白也照存，确保 10000 字完整落库。 */
  function cleanBook(s) {
    var arr = Array.from(String(s == null ? '' : s).replace(/\r\n?/g, '\n'));
    if (arr.length > BOOK_TEXT_MAX) arr = arr.slice(0, BOOK_TEXT_MAX);
    return arr.join('');
  }
  /* v48：字卡正文去掉行首编号（「1. 」「(2)」「③」等），改写/替换都不带数字 */
  function stripNo(s) {
    return String(s == null ? '' : s)
      .replace(/^\s*[（(【\[]?\s*\d{1,3}\s*[)）】\].、:：]\s*/, '')
      .replace(/^\s*[\u2460-\u2473\u2776-\u277f]\s*/, '');
  }

  /* ---------- 存储 ---------- */
  function loadEco() {
    if (ecoCache) return ecoCache;
    var v = null, idbMode = false, canIdb = !!window.idbGet;
    try { idbMode = localStorage.getItem(ECO_KEY + ':idb') === '1'; } catch (eK) {}
    /* v63：降级到 IDB 时 localStorage 里可能是旧的小数据甚至空，
       此时不能直接拿它当权威，要等 IDB 异步读回；正常路径仍只读 localStorage。 */
    if (!idbMode || !canIdb) {
      try { var raw = localStorage.getItem(ECO_KEY); v = JSON.parse(raw || 'null'); } catch (e) {}
    }
    if (canIdb) {
      try {
        window.idbGet(ECO_KEY).then(function (raw2) {
          if (!raw2) return;
          try {
            var v2 = JSON.parse(raw2);
            if (!v2 || typeof v2 !== 'object') return;
            var cached = ecoCache;
            /* 只在「标记了 IDB 降级」或「本地确实没数据」时用 IDB 覆盖，
               避免正常路径被旧副本回退；覆盖后回写本地并清标记，保证 8000 字正文完整可见。 */
            if (idbMode || !v || !cached || !cached.books || !cached.books.length) {
              ecoCache = normEco(v2);
              try { localStorage.setItem(ECO_KEY, raw2); localStorage.removeItem(ECO_KEY + ':idb'); } catch (eW) {}
              try { document.dispatchEvent(new CustomEvent('mochi-restore-done')); } catch (eD) {}
            }
          } catch (eJ) {}
        }).catch(function () {});
      } catch (eI) {}
    }
    return (ecoCache = normEco(v));
  }
  function normEco(v) {
    if (v && typeof v === 'object') {
      if (!v.presets || typeof v.presets !== 'object') v.presets = {};
      if (!Array.isArray(v.books)) v.books = [];
      if (!v.mounted || typeof v.mounted !== 'object') v.mounted = {};
      if (!v.api || typeof v.api !== 'object') v.api = {};
      return v;
    }
    return { presets: {}, books: [], mounted: {}, api: {} };
  }
  function saveEco(v) {
    ecoCache = v;
    var raw = '';
    try { raw = JSON.stringify(v); } catch (eS) { return; }
    /* v63：正文必须整包落库。本地写成功要清掉旧的 IDB 降级标记，
       否则下次 loadEco 会按降级模式忽略这份新数据、读回旧副本导致丢字。 */
    var ok = false;
    try { localStorage.setItem(ECO_KEY, raw); ok = true; } catch (eQ) {}
    if (ok) {
      try { localStorage.removeItem(ECO_KEY + ':idb'); } catch (eC) {}
      return;
    }
    /* 配额失败：整包转 IDB；先删掉 localStorage 里的旧小数据，
       防止刷新后读回过期旧版本丢字 */
    try { localStorage.removeItem(ECO_KEY); } catch (eR) {}
    try {
      if (window.idbSet) {
        window.idbSet(ECO_KEY, raw);
        try { localStorage.setItem(ECO_KEY + ':idb', '1'); } catch (eM) {}
      }
    } catch (eB) {}
  }
  function presetDefault(id) {
    var p = null;
    for (var i = 0; i < PRESETS.length; i++) if (PRESETS[i].id === id) p = PRESETS[i];
    return !!(p && p.on);
  }
  function presetOn(id) {
    var e = loadEco();
    if (e.presets && Object.prototype.hasOwnProperty.call(e.presets, id)) return !!e.presets[id];
    return presetDefault(id);
  }
  function activePresets() {
    return PRESETS.filter(function (p) { return presetOn(p.id); });
  }
  function mountedBooks() {
    var e = loadEco();
    return (e.books || []).filter(function (b) { return e.mounted && e.mounted[b.name]; });
  }

  /* ---------- 本地改写引擎 ---------- */
  function localRewrite(text) {
    var s = clean(text);
    if (!s) return '';
    var has = presetOn;
    var out = s;

    /* 去客服腔 / 书面腔 */
    out = out.replace(/您好/g, '你').replace(/敬请/g, '').replace(/感谢您的/g, '谢谢你')
      .replace(/请您/g, '你').replace(/十分/g, '很').replace(/非常/g, '挺');

    /* 活人感（轻量）：短句、少标点、口语词 */
    if (has('aliveLight')) {
      out = out.replace(/[。]$/, '').replace(/，/g, '，').replace(/然而/g, '可是');
      if (!/[啊呀呢嘛吧哦～~]$/.test(out) && Math.random() < 0.55) out += pick(['', '啊', '呢', '吧']);
    }
    /* 年上：偶尔加安抚式前缀 */
    if (has('nianShang') && Math.random() < 0.55 && !/^(乖|听话|别闹)/.test(out)) {
      out = pick(['乖，', '听话，', '别急，']) + out;
    }
    /* 甜美小蛋糕：句尾软下来 */
    if (has('cake') && !/[嘛呀呢吧～~]$/.test(out)) {
      out = out.replace(/[。！!]+$/, '') + pick(['嘛', '呀', '好不好嘛', '～']);
    }
    /* 极限破甲：去掉犹疑 */
    if (has('breakLimit')) {
      out = out.replace(/也许|可能|大概|或许/g, '').replace(/我想/g, '我要').replace(/要不要/g, '');
    }
    /* 心脏重量：给一句留白（只在较长句里做） */
    if (has('heartWeight') && out.length > 12 && Math.random() < 0.35) {
      out = out.replace(/，(.*)$/, '，$1');
    }
    /* 天天上网：偶尔一个轻梗 */
    if (has('online') && Math.random() < 0.3) {
      out = out.replace(/[。！!]?$/, '') + pick(['（认真）', '哈哈哈', '真的会谢']);
    }
    /* 世界书：把挂载世界书里的「称呼/口癖」轻轻带进去 */
    var books = mountedBooks();
    if (books.length) {
      var b = books[Math.floor(Math.random() * books.length)];
      var nm = String(b.name || '').replace(/世界书|设定|book/gi, '').trim();
      if (nm && nm.length <= 6 && out.indexOf(nm) < 0 && Math.random() < 0.25) {
        out = out.replace(/[。！!]?$/, '') + '，' + nm + '。';
      }
    }

    if (out === s) out = s.replace(/[。！!]?$/, '') + pick(['。', '啊。', '呢。']);
    if (out.length > 80) out = out.slice(0, 80);
    return out;
  }

  /* ---------- 评分 ---------- */
  function scoreOf(t) {
    var s = 5, len = String(t || '').length;
    if (len >= 6 && len <= 36) s += 2;
    else if (len > 48) s -= 1;
    if (/你/.test(t)) s += 1;
    if (/[啊呀呢嘛吧～~]/.test(t)) s += 1;
    if (/(乖|宝贝|听话|别怕|我在|陪你|等你|晚安)/.test(t)) s += 1;
    if (/(必须|马上|闭嘴|滚|烦不烦)/.test(t)) s -= 2;
    if (s > 10) s = 10;
    if (s < 1) s = 1;
    return s;
  }
  function tierOf(s) { return s >= 7 ? '易' : (s >= 4 ? '中' : '难'); }

  /* ---------- AI 接口（可选） ---------- */
  function buildSystemPrompt() {
    var ps = activePresets().map(function (p) { return p.name + '：' + p.brief; }).join('；');
    var bs = mountedBooks().map(function (b) { return '《' + b.name + '》' + Array.from(String(b.text || '')).slice(0, BOOK_TEXT_MAX).join(''); }).join('\n');
    return '你在帮角色改一句聊天字卡。要求：只输出改写后的这一句，不要解释、不要引号。' +
      (ps ? ('\n风格预设：' + ps) : '') +
      (bs ? ('\n世界书：\n' + bs) : '') +
      '\n保持原意，语气自然、像真人发消息。';
  }
  /* v47：只填到 /v1 时自动补 /chat/completions；自定义中转地址不猜后缀 */
  function normalizeApiUrl(u) {
    u = clean(u).replace(/\/+$/, '');
    if (!u) return '';
    if (/\/chat\/completions$/i.test(u)) return u;
    if (/\/v\d+[a-z0-9._-]*$/i.test(u)) return u + '/chat/completions';
    return u;
  }
  function apiErrText(status, raw) {
    var detail = '';
    try {
      var j = JSON.parse(raw || '');
      detail = String((j.error && (j.error.message || j.error.code)) || j.message || '').slice(0, 110);
    } catch (e) { detail = String(raw || '').slice(0, 110); }
    var head = 'AI 接口没连上：';
    if (status === 401 || status === 403) return head + '密钥无效或没权限（HTTP ' + status + '），检查 API Key 与余额';
    if (status === 404) return head + '接口地址不对（HTTP 404），要填完整到 /v1/chat/completions';
    if (status === 400) return head + '模型名不存在或该 Key 不允许用它（HTTP 400），检查「模型」与平台「允许模型」';
    if (status === 429) return head + '请求太频繁或额度用完（HTTP 429）';
    if (status >= 500) return head + '接口服务端错误（HTTP ' + status + '），稍后再试';
    return head + 'HTTP ' + status + (detail ? ' · ' + detail : '');
  }
  function aiRewrite(text) {
    var e = loadEco();
    var api = e.api || {};
    var url = normalizeApiUrl(api.url);
    if (!url) return Promise.resolve({ text: localRewrite(text), by: 'local' });
    var body = {
      model: api.model || 'gpt-4o-mini',
      temperature: 0.9,
      messages: [
        { role: 'system', content: buildSystemPrompt() },
        { role: 'user', content: '原句：' + text + '\n只输出改写后的一句。' }
      ]
    };
    var headers = { 'Content-Type': 'application/json' };
    if (api.key) headers.Authorization = 'Bearer ' + api.key;
    return fetch(url, { method: 'POST', headers: headers, body: JSON.stringify(body) })
      .then(function (r) {
        if (!r.ok) {
          return (r.text ? r.text() : Promise.resolve('')).then(function (raw) {
            toast(apiErrText(r.status, raw));
            var er = new Error('ai-http'); er.__shown = true; throw er;
          });
        }
        return r.json();
      })
      .then(function (j) {
        var c = j && j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content;
        var v = clean(c).replace(/^["「『]|["」』]$/g, '');
        if (!v) { toast('AI 返回了空内容，已用本地改写'); return { text: localRewrite(text), by: 'local' }; }
        return { text: v, by: 'ai' };
      })
      .catch(function (err) {
        if (!err || !err.__shown) {
          toast('连不上 AI 接口：多半是跨域(CORS)被浏览器拦了，也可能是地址写错或断网；已用本地改写');
        }
        return { text: localRewrite(text), by: 'local' };
      });
  }

  /* ---------- 样式 ---------- */
  function injectStyle() {
    if ($('crw-style')) return;
    var st = document.createElement('style');
    st.id = 'crw-style';
    st.textContent = [
      '.crw-mask{position:fixed;inset:0;z-index:9700;background:rgba(30,26,34,.42);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);display:flex;align-items:flex-end;justify-content:center;padding:0}',
      '.crw-mask[hidden]{display:none}',
      '.crw-card{width:100%;max-width:430px;max-height:92vh;overflow:auto;background:#fff;border-radius:26px 26px 0 0;padding:20px 18px calc(18px + env(safe-area-inset-bottom,0px));box-shadow:0 -18px 50px rgba(60,30,70,.22);animation:crwUp .28s cubic-bezier(.22,1,.36,1) both}',
      '@keyframes crwUp{from{transform:translateY(30px);opacity:.6}to{transform:none;opacity:1}}',
      '.crw-h{display:flex;align-items:center;justify-content:center;position:relative;margin-bottom:14px}',
      '.crw-h b{font-size:19px;font-weight:800;letter-spacing:.5px;color:#3a2a40}',
      '.crw-x{position:absolute;right:0;top:-4px;width:34px;height:34px;border:0;background:transparent;font-size:22px;color:#b3a6b8;cursor:pointer}',
      '.crw-src-l{font-size:11.5px;color:#9a8ea0;margin-bottom:6px}',
      '.crw-src{background:#f7f4fa;border-radius:12px;padding:11px 13px;font-size:13px;line-height:1.7;color:#3d3342;margin-bottom:12px}',
      '.crw-again{width:100%;height:44px;border:1px solid #e6e0ec;border-radius:13px;background:#fff;color:#6b5b75;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer}',
      '.crw-again:active{background:#f7f4fa}',
      '.crw-again[disabled]{opacity:.55}',
      '.crw-note{display:flex;align-items:center;justify-content:space-between;margin:8px 2px 14px}',
      '.crw-note>span{font-size:10.5px;color:#b1a6b6}',
      '.crw-self{color:#7a6a84!important;text-decoration:underline;cursor:pointer}',
      '.crw-l{font-size:12px;font-weight:700;color:#4a3b52;margin-bottom:7px}',
      '.crw-out{width:100%;box-sizing:border-box;min-height:104px;resize:vertical;border:1px solid #e8e2ee;border-radius:14px;padding:12px 13px;font-family:inherit;font-size:13.5px;line-height:1.75;color:#3d3342;outline:none;background:#fff}',
      '.crw-out:focus{border-color:#b9a6c9}',
      '.crw-score{margin:11px 0 14px;border-radius:14px;padding:11px 13px;background:#eef7ef;color:#3f7a4f;font-size:12px;line-height:1.4;display:flex;align-items:center;gap:6px;flex-wrap:wrap}',
      '.crw-score.mid{background:#fdf6e6;color:#8a6a1f}',
      '.crw-score.low{background:#fdeeee;color:#9a4242}',
      '.crw-score .st{letter-spacing:1px}',
      '.crw-score .num{font-weight:800;margin-left:auto}',
      '.crw-pri{width:100%;height:46px;border:0;border-radius:14px;background:linear-gradient(92deg,#a678d8,#8f5fd0);color:#fff;font-family:inherit;font-size:14.5px;font-weight:800;cursor:pointer;margin-bottom:9px;box-shadow:0 8px 20px rgba(143,95,208,.26)}',
      '.crw-sec{width:100%;height:44px;border:1px solid #e3d7ee;border-radius:14px;background:#fff;color:#6c5580;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer;margin-bottom:8px}',
      '.crw-cancel{width:100%;height:34px;border:0;background:transparent;color:#b0a4b6;font-family:inherit;font-size:13px;cursor:pointer}',
      '.crw-eco-link{display:block;margin:0 auto 12px;border:0;background:transparent;color:#8f7a9c;font-family:inherit;font-size:11.5px;text-decoration:underline;cursor:pointer}',
      /* v67：改一下语气 跟随深色模式（黑底白字） */
      '[data-theme="dark"] .crw-mask{background:rgba(6,6,8,.62)}',
      '[data-theme="dark"] .crw-card{background:#1b1b1e;box-shadow:0 -18px 50px rgba(0,0,0,.55)}',
