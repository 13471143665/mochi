return;
} catch (e) {}
}
var payload = {
app: 'mochi', kind: 'card-audit',
version: appVer(),
generatedAt: new Date().toISOString(),
ua: navigator.userAgent || '',
desktop: deskName(activeCid()),
buildError: buildErr || '',
