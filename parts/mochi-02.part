'<div class="dl-main"><div class="dl-txt"></div>' +
'<div class="dl-sub">' + fmtTime(r.ts) + ' · ' + taFit(r.sub) + '</div></div>' +
'<button class="dl-fav" title="收藏">' + (r.rec.fav ? '♥' : '♡') + '</button>';
