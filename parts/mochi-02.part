return {
diff: diff,
playerScore: 0, opponentScore: 0,
ball: { x: W / 2, y: H / 2, vx: 0, vy: 0, speed: INIT_SPEED },
player: { y: H / 2 - ppH / 2, vy: 0, targetY: H / 2 - ppH / 2 },
opponent: { y: H / 2 - pH / 2, vy: 0, targetY: H / 2 - pH / 2, reactUntil: 0, aiNextAt: 0 },
