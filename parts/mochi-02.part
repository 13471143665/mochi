} else if (lockAxis === 'v') {
if (adx >= TH && adx > ady * 1.5) { lockAxis = 'h'; dir = dx > 0 ? 'r' : 'l'; }
else if (ady >= TH) dir = dy > 0 ? 'd' : 'u';
} else {
lockAxis = adx > ady ? 'h' : 'v';
if (lockAxis === 'h') { if (adx >= TH) dir = dx > 0 ? 'r' : 'l'; }
else { if (ady >= TH) dir = dy > 0 ? 'd' : 'u'; }
