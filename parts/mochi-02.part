      '[data-theme="dark"] .crw-l{color:#dcd7e6}',
      '[data-theme="dark"] .crw-out{background:#232327;border-color:#38383f;color:#eeeaf5}',
      '[data-theme="dark"] .crw-out:focus{border-color:#6c5a80}',
      '[data-theme="dark"] .crw-score{background:#1f2b22;color:#9fd4ad}',
