html.tablet.ios-fs-active .phone { width:100vw; max-width:none; }
@media (display-mode: fullscreen) { html.tablet .phone { width:100vw; max-width:none; } }
html.tablet.ios-fs-active .phone { padding-top:max(env(safe-area-inset-top, 0px), 12px); }
