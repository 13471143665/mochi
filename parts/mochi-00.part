}
html.ios-pwa-standalone,
html.ios-pwa-standalone body { background: var(--bg-b); }
html.ios-pwa-standalone.ios-cover-top,
html.ios-pwa-standalone.ios-cover-top body { height:var(--mochi-ios-h, 100vh); min-height:0; align-items:flex-start; }
@supports (height: 100dvh) { html.ios-pwa-standalone.ios-cover-top body { height:var(--mochi-ios-h, 100dvh); } }
@media (display-mode: standalone) {
html, body { background: var(--bg-b); }
}
@media (max-width: 900px) {
.phone input:not([readonly]):not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="color"]):not([type="hidden"]):not([type="date"]):not([type="time"]):not([type="datetime-local"]):not([type="month"]):not([type="week"]):not([type="button"]):not([type="submit"]):not([type="reset"]),
.phone textarea:not([readonly]),
