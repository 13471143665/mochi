out.push({ prefix: G + cid + ':', key: 'avatar-lib', label: label + ' · 头像库' });
out.push({ prefix: G + cid + ':', key: 'avatar-me-lib', label: label + ' · 我的头像库' });
});
out.push({ prefix: G, key: 'avatar-lib', label: '旧版顶层头像库（残留）' });
