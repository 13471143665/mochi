[data-theme="dark"] {
--dark-card: #1e1e1e;
--dark-card-92: rgba(30,30,30,.92);
--dark-card-97: rgba(30,30,30,.97);
--dark-input: #2a2a2a;
--dark-border: rgba(255,255,255,.1);
--dark-border-12: rgba(255,255,255,.12);
--dark-soft: #aaa;
--dark-hover: rgba(255,255,255,.06);
--widget-bg:#1e1e1e; --widget-border:rgba(255,255,255,.12);
--widget-heart:#f0f0f0;
--ink-soft:#aaaaaa;
color-scheme:dark;
}
