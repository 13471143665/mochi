} catch (e) { return '诊断信息生成失败：' + (e && e.message); }
};
const openDiag = function (txt, waiting) {
if (opened || !window.openModal) return false;
opened = true;
cur = txt || '';
ctl = window.openModal(DIAG_TITLE, cur, function () { closed = true; }, {
noInput: true,
textarea: true,
textareaRows: 14,
big: true,
placeholder: '',
staticText: waiting ? TIP_WAIT : '本机环境信息如下，可复制或导出 docx 发给 AI 排查。',
copyBtn: {
label: '复制',
fn: function (c) {
const txt2 = c ? c.text() : cur;
