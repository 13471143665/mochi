const seed = store.get('phone-bg');
const id = 'g' + Date.now().toString(36);
pbgSaveList([id]);
store.set('phone-bg-item-' + id, seed);
store.set(PBG_ACTIVE, id);
compressImage(seed, 240).then(th => { if (th) store.set('phone-bg-item-thb-' + id, th); });
}
