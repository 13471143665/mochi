// 现在 3 秒未就绪先用基础环境信息开窗，读全后再原位补齐。
const basicDiagText = function () {
try {
const d = window.mochiDevice || {};
const L = [];
L.push('【设备兼容诊断 · 基础信息】');
L.push('时间：' + new Date().toLocaleString('zh-CN'));
L.push('页面：' + location.href);
L.push('协议：' + location.protocol);
L.push('UA：' + navigator.userAgent);
L.push('平台：' + (navigator.platform || '—'));
L.push('语言：' + (navigator.language || '—'));
L.push('屏幕：' + screen.width + '×' + screen.height + ' @' + (window.devicePixelRatio || 1) + 'x');
L.push('视口：' + window.innerWidth + '×' + window.innerHeight);
L.push('触摸：' + (('ontouchstart' in window) ? '支持' : '不支持'));
L.push('判定：' + (d.isMobile ? '手机布局' : '电脑外壳') + '（' + (d.mobileRule || '—') + '）');
L.push('存储：localStorage ' + (function () { try { localStorage.setItem('__d', '1'); localStorage.removeItem('__d'); return '可用'; } catch (e) { return '不可用'; } })());
L.push('剪贴板 API：' + (navigator.clipboard && navigator.clipboard.writeText ? '有' : '无（走兜底）'));
L.push('');
L.push('（完整存储明细仍在读取，读到后会自动补上）');
