html.ios-fs-active .phone .statusbar { padding-top:14px; }
html.tablet.ios-pwa-standalone.ios-fs-active .phone .statusbar { display:none; }
@media (max-width: 900px) {
.fs-css-active .phone { padding-top: max(env(safe-area-inset-top, 0px), 12px); }
}
