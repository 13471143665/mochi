}
function scheduleReplyTurn() {
const myCid = window.__activeCid || 'default';
const nowT = Date.now();
syncLastMineText(); // 每发一条都刷新「我最后那句」，到点那一刻再取快照＝轮内末尾那条
try { window.__replyWaitT0 = Date.now(); } catch (eRW) {} // #571 起点＝你话音落下这一刻，与到点无关
const c = cfg();
