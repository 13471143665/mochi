<!-- TA的吐槽（吐槽字卡管理页，独立页面） -->
<div class="page" id="page-ta-roast" hidden>
  <div class="chat-head">
    <span class="ch-back" id="tc-roast-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </span>
    <span class="ch-name">TA的吐槽</span>
  </div>
  <div class="gs-scroll">
    <button class="div-draw" id="tr-now">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 5.4 5.7.3-4.4 3.6 1.5 5.5-4.6-3.3-4.6 3.3 1.5-5.5-4.4-3.6 5.7-.3z"/></svg>
      让TA现在吐槽一次
    </button>
    <div class="set-group glass">
      <div class="gs-row"><span>TA 偶尔吐槽你一句</span><label class="toggle"><input type="checkbox" id="tr-enable"><span class="tk"></span></label></div>
      <div class="gs-row"><span>使用系统预设字卡</span><label class="toggle"><input type="checkbox" id="tr-default" checked><span class="tk"></span></label></div>
      <div class="gs-row"><span>触发概率</span><input type="range" id="tr-prob" min="1" max="100" step="1" class="tc-range"><span class="tc-prob-val" id="tr-prob-val">5%</span></div>
      <div class="gs-row"><span>自动弹窗概率</span><input type="range" id="tr-popup" min="0" max="100" step="1" class="tc-range"><span class="tc-prob-val" id="tr-popup-val">70%</span></div>
    </div>
    <div class="card-tabs" id="tr-tabs" style="padding:6px 12px 8px">
      <button class="cc-tab sel" data-tab="sys">系统预设</button>
      <button class="cc-tab" data-tab="mine">我的添加</button>
    </div>
    <div class="tc-search-wrap" style="padding:0 12px 8px">
      <input type="text" id="tr-search" class="tc-input" placeholder="搜索吐槽…" style="width:100%">
    </div>
    <div id="tr-sys-panel">
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0">系统预设字卡（可逐句开关，或整组停用一类，不可删除）</div>
        <div id="tr-sys-cats" style="padding:8px 14px 14px"></div>
      </div>
    </div>
    <div id="tr-mine-panel" hidden>
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0;display:flex;align-items:center;justify-content:space-between"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>添加吐槽字卡</span><button class="cc-tool" id="tr-new-grp" style="padding:4px 8px;font-size:11px">＋ 分组</button></div>
        <div class="tc-addform">
          <select id="tr-new-cat" class="tc-input">
            <option value="light">轻微调侃</option>
            <option value="familiar">熟悉感</option>
            <option value="sweet">情侣式调侃</option>
            <option value="mild">轻微嫌弃</option>
            <option value="serious">严肃吐槽</option>
            <option value="world">两个世界</option>
          </select>
          <input id="tr-new-text" class="tc-input" type="text" placeholder="吐槽内容…">
          <input id="tr-new-match" class="tc-input" type="text" placeholder="触发关键词，用 | 分隔（可选），如：熬夜|没睡">
          <button class="ta-add-btn" style="width:100%" id="tr-new-add">添加</button>
        </div>
      </div>
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0">我添加的字卡 <span style="font-size:11px;color:var(--muted);font-weight:400">（可停用/删除）</span></div>
        <div id="tr-mine-cats" style="padding:8px 14px 14px"></div>
      </div>
    </div>
  </div>
</div>

<!-- TA的查岗（查岗问题卡管理页，独立页面；触发开关/概率在 回复设置→查岗 按联系人设置） -->
<div class="page" id="page-ta-checkin" hidden>
  <div class="chat-head">
    <span class="ch-back" id="ckq-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </span>
    <span class="ch-name">TA的查岗</span>
  </div>
  <div class="gs-scroll">
    <button class="div-draw" id="ckq-now">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/><path d="M12 3a9 9 0 000 18"/></svg>
      让TA现在查岗一次
    </button>
    <div class="set-group glass">
      <div class="gs-row"><span>使用系统预设问题</span><label class="toggle"><input type="checkbox" id="ckq-default" checked><span class="tk"></span></label></div>
      <div class="gs-sub" style="padding:0 14px 14px">TA 来查岗的开关/概率/冷却/自动弹窗概率在「回复设置 → 查岗」里按联系人独立设置；这里的题库随当前桌面的联系人保存</div>
    </div>
    <div class="card-tabs" id="ckq-tabs" style="padding:6px 12px 8px">
      <button class="cc-tab sel" data-tab="sys">系统预设</button>
      <button class="cc-tab" data-tab="mine">我的添加</button>
    </div>
    <div class="tc-search-wrap" style="padding:0 12px 8px">
      <input type="text" id="ckq-search" class="tc-input" placeholder="搜索问题…" style="width:100%">
    </div>
    <div id="ckq-sys-panel">
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0">系统预设题库（可逐句开关，或整组停用一类，不可删除）</div>
        <div id="ckq-sys-cats" style="padding:8px 14px 14px"></div>
      </div>
    </div>
    <div id="ckq-mine-panel" hidden>
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg>批量导入文字查岗问题</div>
        <div class="tc-addform">
          <textarea id="ckq-batch" class="tc-input" rows="6" placeholder="每行一个问题，如：&#10;快说说，今天过得怎么样？&#10;发一句你现在看到的东西给我&#10;（单选题请在下方「我的添加」里用表单添加）"></textarea>
          <button class="ta-add-btn" style="width:100%" id="ckq-batch-add">批量导入</button>
        </div>
      </div>
      <div id="ckq-mine-cats"></div>
    </div>
  </div>
</div>

<!-- TA的邀请（联系人主动邀请话术管理页；触发开关/概率在 回复设置→其他 按联系人设置） -->
<div class="page" id="page-ta-invite" hidden>
  <div class="chat-head">
    <span class="ch-back" id="ti-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </span>
    <span class="ch-name">TA的邀请</span>
  </div>
  <div class="gs-scroll">
    <button class="div-draw" id="ti-now">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 10.5v3M5.5 12h3"/><path d="M15.5 11h.01M18.5 13h.01"/></svg>
      让TA现在邀请一次
    </button>
    <div class="set-group glass">
      <div class="gs-row"><span>使用系统预设话术</span><label class="toggle"><input type="checkbox" id="ti-default" checked><span class="tk"></span></label></div>
      <div class="gs-sub" style="padding:0 14px 14px">TA 主动邀请的开关/概率在「回复设置 → 其他」（猜拳 / 玩游戏 / 贴贴）按联系人独立设置；同意猜拳/Pong/贪吃蛇会打开对应半框，同意贴贴则 TA 会回应一句贴贴的话；拒绝都回一句婉拒。题库随当前桌面的联系人保存</div>
    </div>
    <div class="card-tabs" id="ti-tabs" style="padding:6px 12px 8px">
      <button class="cc-tab sel" data-tab="sys">系统预设</button>
      <button class="cc-tab" data-tab="mine">我的添加</button>
    </div>
    <div class="tc-search-wrap" style="padding:0 12px 8px">
      <input type="text" id="ti-search" class="tc-input" placeholder="搜索邀请话术…" style="width:100%">
    </div>
    <div id="ti-sys-panel">
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0">系统预设话术（可逐句开关，或整组停用一类，不可删除）</div>
        <div id="ti-sys-cats" style="padding:8px 14px 14px"></div>
      </div>
    </div>
    <div id="ti-mine-panel" hidden>
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/></svg>批量导入邀请话术</div>
        <div class="tc-addform">
          <select id="ti-batch-kind" class="tc-input">
            <option value="rps">导入到 · 猜拳邀请</option>
            <option value="pong">导入到 · Pong 邀请</option>
            <option value="snake">导入到 · 贪吃蛇邀请</option>
            <option value="cuddle">导入到 · 贴贴邀请</option>
          </select>
          <textarea id="ti-batch" class="tc-input" rows="5" placeholder="每行一条邀请话术，如：&#10;来猜拳呀，输的人答应一件事！&#10;敢不敢来一局 Pong？"></textarea>
          <button class="ta-add-btn" style="width:100%" id="ti-batch-add">批量导入</button>
        </div>
      </div>
      <div id="ti-mine-cats"></div>
    </div>
  </div>
</div>


<!-- 桌面今日情话（自定义字卡库） -->
<div class="page" id="page-quote-cards" hidden>
  <div class="chat-head">
    <span class="ch-back" id="quote-cards-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </span>
    <span class="ch-name">桌面今日情话</span>
  </div>
  <div class="gs-scroll">
    <div class="card-tabs" id="cq-tabs" style="padding:6px 12px 8px">
      <button class="cc-tab sel" data-tab="sys">系统预设</button>
      <button class="cc-tab" data-tab="mine">我的添加</button>
    </div>
    <div class="set-group glass" id="cq-sys-panel">
      <div class="gs-row"><span>使用系统预设情话</span><label class="toggle"><input type="checkbox" id="cq-default" checked><span class="tk"></span></label></div>
      <div class="cal-card-title" style="padding:14px 14px 0">系统预设情话（可逐句开关，不可删除）</div>
      <div id="cq-sys-list" style="padding:8px 14px 14px"></div>
    </div>
    <div class="set-group glass" id="cq-mine-panel" hidden>
      <div class="cal-card-title" style="padding:14px 14px 0;display:flex;align-items:center;justify-content:space-between"><span>批量输入情话</span><button class="cc-tool" id="cq-new-grp" style="padding:4px 8px;font-size:11px">＋ 分组</button></div>
      <div class="tc-addform">
        <select id="cq-batch-grp" class="tc-input"></select>
        <textarea id="cq-batch" class="tc-input" rows="6" placeholder="每行一句，如：&#10;我偏爱你。&#10;今天也很喜欢你。&#10;你是我的例外。"></textarea>
        <button class="ta-add-btn" style="width:100%" id="cq-batch-add">添加到今日情话</button>
      </div>
      <div class="cal-card-title" style="padding:14px 14px 0">我添加的情话</div>
      <div id="cq-mine-list" style="padding:8px 14px 14px"></div>
    </div>
    <div class="cal-card-title" style="padding:0 2px">桌面每天会从这些情话里随机展示一句</div>
  </div>
</div>

<!-- TA在身边位置卡（字卡库：方位/距离/状态/感知/彩蛋，位置面板词源） -->
<div class="page" id="page-loc-cards" hidden>
  <div class="chat-head">
    <span class="ch-back" id="loc-cards-back">
      <svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </span>
    <span class="ch-name">TA在身边位置卡</span>
  </div>
  <div class="gs-scroll">
    <div class="set-group glass">
      <div class="gs-row"><span>使用系统预设位置卡</span><label class="toggle"><input type="checkbox" id="loc-default" checked><span class="tk"></span></label></div>
    </div>
    <div class="cal-card-title" style="padding:0 14px 2px">TA 想告诉你的位置（发送字卡）</div>
    <div class="fav-tabs">
      <button class="fav-tab sel" data-loctab="dir"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M12 21s-6-5.3-6-10a6 6 0 1112 0c0 4.7-6 10-6 10z"/><circle cx="12" cy="11" r="2.2"/></svg>方位</button>
      <button class="fav-tab" data-loctab="dist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><circle cx="12" cy="12" r="9"/><path d="M12 12l3-3"/></svg>距离</button>
      <button class="fav-tab" data-loctab="state"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M13 2L4.5 13.5H11l-1 8.5L18.5 10H12l1-8z"/></svg>状态</button>
      <button class="fav-tab" data-loctab="sense"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>感知</button>
      <button class="fav-tab" data-loctab="egg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M12 3c4 5 6 8 6 11a6 6 0 11-12 0c0-3 2-6 6-11z"/></svg>彩蛋</button>
    </div>
    <div class="cal-card-title" style="padding:8px 14px 2px">你的感知（方位感知 · 不是精确定位）</div>
    <div class="fav-tabs">
      <button class="fav-tab" data-loctab="direct"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M12 3l3.5 3.5L12 10l-3.5-3.5z"/><path d="M12 3v18M12 10v11"/></svg>方向</button>
      <button class="fav-tab" data-loctab="rangef"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/></svg>距离感</button>
      <button class="fav-tab" data-loctab="power"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><circle cx="12" cy="12" r="2.5"/></svg>感知强度</button>
      <button class="fav-tab" data-loctab="touch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M8 14.5V7.2a1.5 1.5 0 0 1 3 0v7.3"/><path d="M11 14.5V6.5a1.5 1.5 0 0 1 3 0v8"/><path d="M14 14.5V7.8a1.5 1.5 0 0 1 3 0v6.7"/><path d="M6.5 14.5h12c0 3.5-2.7 6-6 6s-6-2.5-6-6"/><path d="M6 5a8.5 8.5 0 0 1 12 0"/></svg>触碰</button>
    </div>
    <div class="card-tabs" id="loc-tabs" style="padding:6px 12px 8px">
      <button class="cc-tab sel" data-tab="sys">系统预设</button>
      <button class="cc-tab" data-tab="mine">我的添加</button>
    </div>
    <div class="set-group glass" id="loc-sys-panel">
      <div class="cal-card-title" style="padding:14px 14px 0" id="cloc-sys-title">方位</div>
      <div id="cloc-sys-list" style="padding:8px 14px 14px"></div>
    </div>
    <div class="set-group glass" id="loc-mine-panel" hidden>
      <div class="cal-card-title" style="padding:14px 14px 0;display:flex;align-items:center;justify-content:space-between"><span>批量输入位置卡</span><button class="cc-tool" id="loc-new-grp" style="padding:4px 8px;font-size:11px">＋ 分组</button></div>
      <div class="tc-addform">
        <select id="cloc-batch-grp" class="tc-input"></select>
        <textarea id="cloc-batch" class="tc-input" rows="6" placeholder="每行一个，如：&#10;在咖啡店等你&#10;在回家的路上&#10;在你看不到的地方"></textarea>
        <button class="ta-add-btn" style="width:100%" id="cloc-batch-add">添加到我的位置卡</button>
      </div>
      <div class="cal-card-title" style="padding:14px 14px 0" id="cloc-mine-title">我的位置卡</div>
      <div id="cloc-mine-list" style="padding:8px 14px 14px"></div>
    </div>
    <div class="cal-card-title" style="padding:0 2px">TA 想告诉你 TA 在哪时，会从上面的发送字卡里选（发出后有光点动效）；方位感知用的是下面的感知字卡</div>
    <div class="cal-card-title" style="padding:4px 2px 0">光点落在哪儿＝TA 在哪儿：方位卡（在你左边 / 右边 / 身后 / 前面）落在画面对应方向；距离卡与状态卡跟着<b>最近一张方位卡</b>的方位走——「再近一点」朝屏幕中心靠近，「再远一点」朝屏幕边缘再退开。所以上一张说的是「在你右边」，接着发「再远一点」时，光点会出现在屏幕右侧靠边处，这是正常的（不是跑偏）。</div>
  </div>
</div>

<!-- 通用回答弹层（TA的好奇 / TA的吐槽 共用） -->
<div class="qa-mask" id="qa-mask" hidden>
  <div class="qa-panel">
    <div class="mg-head"><span id="qa-title">回答</span><button class="mg-close" id="qa-mask-close">✕</button></div>
    <div class="qa-body" id="qa-body"></div>
  </div>
</div>

<!-- 通话弹层（来电/去电/通话中） -->
<div class="call-mask" id="call-mask" hidden>
  <div class="call-panel">
    <div class="call-head">
      <span class="call-title">语音通话</span>
      <button class="call-minimize" id="call-minimize-btn" title="缩小到小框">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v5H3M16 3v5h5M8 21v-5H3M16 21v-5h5"/></svg>
      </button>
    </div>
    <div class="call-av" id="call-av"></div>
    <div class="call-name" id="call-name">TA</div>
    <div class="call-status" id="call-status">正在呼叫...</div>
    <div class="call-duration" id="call-duration">00:00</div>
    <div class="call-countdown" id="call-countdown" hidden></div>
    <div class="call-btns">
      <button class="call-btn call-hang" id="call-hang-btn" hidden>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 9c-1.6 0-3.1.25-4.5.7v2.1c0 .4-.2.7-.6.9-.8.4-1.5.9-2.2 1.5-.3.3-.7.3-1 0l-1.9-1.9c-.3-.3-.3-.8 0-1.1C4.8 8.9 8.2 7 12 7s7.2 1.9 10.2 5.2c.3.3.3.8 0 1.1l-1.9 1.9c-.3.3-.7.3-1 0-.7-.6-1.4-1.1-2.2-1.5-.4-.2-.6-.5-.6-.9v-2.1C15.1 9.25 13.6 9 12 9z"/></svg>
        挂断
      </button>
      <button class="call-btn call-reject" id="call-reject-btn" hidden>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 9c-1.6 0-3.1.25-4.5.7v2.1c0 .4-.2.7-.6.9-.8.4-1.5.9-2.2 1.5-.3.3-.7.3-1 0l-1.9-1.9c-.3-.3-.3-.8 0-1.1C4.8 8.9 8.2 7 12 7s7.2 1.9 10.2 5.2c.3.3.3.8 0 1.1l-1.9 1.9c-.3.3-.7.3-1 0-.7-.6-1.4-1.1-2.2-1.5-.4-.2-.6-.5-.6-.9v-2.1C15.1 9.25 13.6 9 12 9z"/></svg>
        拒绝
      </button>
      <button class="call-btn call-answer" id="call-answer-btn" hidden>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
        接听
      </button>
    </div>
  </div>
</div>

<!-- 通话小框（接通后最小化） -->
<div class="call-mini" id="call-mini" hidden>
  <div class="call-mini-av" id="call-mini-av"></div>
  <div class="call-mini-info">
    <div class="call-mini-name" id="call-mini-name">通话中</div>
    <div class="call-mini-time" id="call-mini-time">00:00</div>
  </div>
  <button class="call-mini-hang" id="call-mini-hang" title="挂断">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 9c-1.6 0-3.1.25-4.5.7v2.1c0 .4-.2.7-.6.9-.8.4-1.5.9-2.2 1.5-.3.3-.7.3-1 0l-1.9-1.9c-.3-.3-.3-.8 0-1.1C4.8 8.9 8.2 7 12 7s7.2 1.9 10.2 5.2c.3.3.3.8 0 1.1l-1.9 1.9c-.3.3-.7.3-1 0-.7-.6-1.4-1.1-2.2-1.5-.4-.2-.6-.5-.6-.9v-2.1C15.1 9.25 13.6 9 12 9z"/></svg>
  </button>
</div>

    <!-- 自定义聊天字卡（分类浏览，独立页面） -->
    <div class="page" id="page-custom-cards" hidden>
      <div class="chat-head">
        <span class="ch-back" id="cc-back">
          <svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </span>
        <span class="ch-name" id="cc-page-title">自定义聊天字卡</span>
      </div>
      <div class="card-tabs" id="cc-tabs">
        <button class="cc-tab sel" data-type="text"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>主字卡</button>
        <button class="cc-tab" data-type="kaomoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1018 0 9 9 0 00-18 0z"/><path d="M8.5 9.5l.01.01M15.5 9.5l.01.01"/><path d="M8.5 15a4.5 4.5 0 007 0"/></svg>颜文字</button>
        <button class="cc-tab" data-type="emoji"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9.5l.01.01M15 9.5l.01.01"/></svg>emoji</button>
        <button class="cc-tab" data-type="sticker"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9.5l.01.01M15 9.5l.01.01"/></svg>表情包</button>
        <button class="cc-tab" data-type="image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5-9 9"/></svg>图片</button>
        <button class="cc-tab" data-type="poke"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 000 18"/><circle cx="12" cy="12" r="2"/></svg>拍一拍</button>
        <button class="cc-tab" data-type="lyric"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V6l10-2v11"/><circle cx="6.5" cy="18" r="2.6"/><circle cx="16.5" cy="15" r="2.6"/><path d="M4 9.5h3M4 12.5h2"/></svg>歌词摘取</button>
        <!-- v3.32.x：其他互动功能字卡（自定义）——与系统预设【其他互动功能字卡】同分类，
             用户自建的功能字卡存本作用域 cc-groups 同名字段，各功能经 getLibPool 并入抽取；
             13 个功能 tab 仅「其他互动功能字卡」入口显示，公用/专属入口隐藏（openCcPage 按入口切换） -->
        <button class="cc-tab" data-type="fish">摸鱼</button>
        <button class="cc-tab" data-type="pick"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.9L19 9.8l-4.4 3.3L15.2 18 12 15.1 8.8 18l.6-4.9L5 9.8l5.1-1.9z"/><path d="M19 16.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/></svg>灵感拾取</button>
        <button class="cc-tab" data-type="period">经期</button>
        <button class="cc-tab" data-type="piggy">存钱罐</button>
        <button class="cc-tab" data-type="drift">漂流瓶</button>
        <button class="cc-tab" data-type="interact">互动回应</button>
        <button class="cc-tab" data-type="music">音乐</button>
        <!-- #317 梦角自由造句：程序生成（梦角说话截字重造句自动入库），这里可查看/删除 -->
        <button class="cc-tab" data-type="mjfree">梦角自由造句</button>
      </div>
      <div class="cc-toolbar">
        <button class="cc-tool" id="cc-new-group"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8a4 4 0 100 8 4 4 0 000-8z"/><path d="M19 12a7 7 0 00-.1-1.2l2-1.6-2-3.4-2.3 1a7 7 0 00-2-1.2L14.2 3h-4l-.4 2.6a7 7 0 00-2 1.2l-2.3-1-2 3.4 2 1.6A7 7 0 005 12c0 .4 0 .8.1 1.2l-2 1.6 2 3.4 2.3-1a7 7 0 002 1.2l.4 2.6h4l.4-2.6a7 7 0 002-1.2l2.3 1 2-3.4-2-1.6c.1-.4.1-.8.1-1.2z"/></svg>管理分组</button>
        <button class="cc-tool" id="cc-import"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>批量导入</button>
        <button class="cc-tool" id="cc-import-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>链接导入</button>
      </div>
      <div class="cc-toolbar">
        <button class="cc-tool" id="cc-manage-cards"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>管理字卡</button>
        <button class="cc-tool" id="cc-dedupe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 00-2-2H6a2 2 0 00-2 2v8a2 2 0 002 2h2"/><path d="M10 13.5l1.5 1.5L16 10"/></svg>去重复</button>
        <button class="cc-tool" id="cc-export"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M7 10l5-5 5 5"/><path d="M12 5v12"/></svg>导出数据</button>
        <button class="cc-tool" id="cc-import-data"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 5v12"/></svg>导入数据</button>
        <button class="cc-tool cc-tool-danger" id="cc-clear-all"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>清除全部</button>
      </div>
      <div id="cc-import-hint" style="font-size:11px;line-height:1.6;color:var(--muted);margin:-4px 0 8px">选不了多张或点了没反应，是浏览器 / 所在 App 的限制：换 Chrome / Edge 再试（详见 使用说明第 13 节）</div>
      <div class="cc-groups-bar" id="cc-groups-bar">
        <span class="cc-g-chip sel" data-g="">全部</span>
      </div>
      <div class="card-search glass">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input class="card-search-input" id="cc-search-input" placeholder="搜索字卡" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
      </div>
      <div class="card-list" id="cc-list">
        <!-- 字卡由 JS 按分类渲染 -->
      </div>
    </div>

<!-- 设置页 -->
    <div class="page" id="page-setting" hidden>
      <div class="set-title">设置</div>
      <!-- #542：设置项上百行、找一项要滚很久——顶部搜索框实时过滤 .set-row（跨 5 个 tag 显示匹配项），
           逻辑复刻美化页的 theme-search（personalize.js bindSettingsSearch）；清空后回到原 tag -->
      <!-- #578：外观（含边框/底色）走 setting.css 的 .theme-search 类样式——写在内联 style 上
           会被安卓 ce-box 转换丢掉（带 var() 的 border/background 简写复制不过去），手机端外框消失 -->
      <div class="theme-search-wrap" style="padding:8px 12px 0"><input class="theme-search" id="set-search-input" placeholder="搜索设置项（如 壁纸 / 备份 / 通知 / 概率）" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"></div>
      <!-- v3.33.x：设置页顶部 tag 分类——设置项太多一页堆到底，用户找不到功能；
           复用全站 .them-tabs/.them-sec 互斥显示观感（聊天设置/手机桌面美化同款） -->
      <div class="them-tabs" id="set-tabs">
        <div class="them-tab active" data-tab="basic">通用</div>
        <div class="them-tab" data-tab="look">外观</div>
        <div class="them-tab" data-tab="chat">聊天</div>
        <div class="them-tab" data-tab="system">系统</div>
        <div class="them-tab" data-tab="tools">工具</div>
        <div class="them-tab" data-tab="diag">信息诊断</div>
        <div class="them-tab" data-tab="about">关于</div>
      </div>
      <!-- 通用：全屏模式（置顶独立组） + 数据备份（导出/导入） + 联系人 / 桌面 + 入口行为 + 深色模式 / 手机桌面美化 -->
      <div class="them-sec" data-sec="basic">
      <!-- FIX 2026-09-20 #927：全屏模式自「系统」段提到通用首位、独立成组（用户：设置里的全屏模式要放在最前面一个显眼独立的地方）；
           行下小字首条写明「切后台会自动退出全屏＝设备限制、不是 bug」（原只在常见问题里，用户当 bug 报） -->
      <div class="set-group glass">
        <div class="set-row" id="sf-fullscreen-row">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 00-2 2v3M16 3h3a2 2 0 012 2v3M8 21H5a2 2 0 01-2-2v-3M16 21h3a2 2 0 002-2v-3"/></svg></div>
          <div class="txt"><span id="sf-fullscreen-label">全屏模式（隐藏手机状态栏）</span><span class="tag" id="sf-fullscreen-help" role="button" tabindex="0" aria-haspopup="dialog">功能说明</span></div>
          <label class="toggle"><input type="checkbox" id="sf-fullscreen"><span class="tk"></span></label>
        </div>
        <div class="gs-sub" id="sf-fullscreen-sub"><b>手机端切到后台（锁屏 / 切去别的应用）会自动退出全屏，这是设备限制、不是 bug</b>，切回来手动再开一次即可。<br>开启后尽量隐藏手机顶部状态栏/浏览器栏，让内容占满全屏。<br>iOS 限制：iPhone 顶部系统状态栏（时间/电量）由系统控制，任何网页都无法隐藏；从主屏幕打开时本开关会让内容顶满屏幕，应用内模拟状态栏（Mochi/时间/电量）下移到系统状态栏正下方、两栏不重叠。</div>
      </div>
      <!-- FIX 2026-09-19 #805（工作树被并行旧缓冲打回，2026-09-20 随 #927 重放）：导出数据/导入数据自「工具」段移入通用段——
           备份是防丢的唯一防线，放太靠后的 tag 用户不知道有这个功能；row id 不变，直达跳转按 closest('.them-sec') 动态取 tag -->
      <div class="set-group glass">
        <div class="set-row" id="row-export">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg></div>
          <div class="txt">导出数据<span class="sub">点开可选「仅聊天记录」：各桌面联系人 + 群聊，换机只搬聊天</span></div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
        <div class="set-row" id="row-import">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3M7 8l5-5 5 5"/><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/></svg></div>
          <div class="txt">导入数据<span class="sub">点开可选「仅聊天记录」：只恢复各桌面联系人与群聊，其他数据不动</span></div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
      </div>
      <div class="set-group glass">
        <div class="set-row" id="row-contacts">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6 8-6s8 2 8 6"/></svg></div>
          <div class="txt">联系人 / 桌面</div>
          <div class="val" id="contacts-val"></div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
        <div class="set-row" id="sf-group-chat-row">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/><circle cx="9" cy="11" r="1.2" fill="#111111"/><circle cx="13" cy="11" r="1.2" fill="#111111"/><circle cx="17" cy="11" r="1.2" fill="#111111"/></svg></div>
          <div class="txt">开启群聊</div>
          <label class="toggle"><input type="checkbox" id="sf-group-chat"><span class="tk"></span></label>
        </div>
      </div>
      <!-- #646：打开应用时的入口行为（默认均关闭）——「打开时显示联系人列表」+「默认进入的桌面」（contacts.js 接线） -->
      <div class="set-group glass">
        <div class="set-row" id="row-entry-show-list">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1.3" fill="#111111"/><circle cx="3.5" cy="12" r="1.3" fill="#111111"/><circle cx="3.5" cy="18" r="1.3" fill="#111111"/></svg></div>
          <div class="txt">打开时显示联系人列表<span class="sub">每次打开先列出全部联系人，点一个进入其桌面</span></div>
          <label class="toggle"><input type="checkbox" id="entry-show-list"><span class="tk"></span></label>
        </div>
        <div class="set-row" id="row-entry-default-contact">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg></div>
          <div class="txt">默认进入的桌面<span class="sub">开启后每次打开直接进入所选联系人桌面</span></div>
          <div class="val" id="entry-default-contact-val">关闭</div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
      </div>
      <div class="set-group glass">
        <!-- v45：深色模式开关移到聊天界面右上角（设置按钮旁），这里不再保留入口 -->
        <div class="set-row" id="row-appearance">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"/></svg></div>
          <div class="txt">手机桌面美化</div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
      </div>
      <!-- FIX 2026-09-19 #805（2026-09-20 随 #927 重放）：清除本地数据＝通用段末项（与导出/导入同一 tag，用户要求首屏可见；
           危险操作置段尾，与上方只读项拉开距离） -->
      <div class="set-group glass">
        <div class="set-row" id="row-reset">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6"/><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/></svg></div>
          <div class="txt">清除本地数据<span class="sub">不可恢复：清空本机全部数据（先「导出数据」备份再清）</span></div>
        </div>
      </div>
      </div><!-- /them-sec basic · row-reset -->
      <!-- v65：外观分区＝放在「通用」之外。开屏设置与换字体都在这里 -->
      <div class="them-sec" data-sec="look" hidden>
        <div class="set-group glass">
          <div class="set-row" id="row-opening-open">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9l5 3-5 3z"/></svg></div>
            <div class="txt">打开开屏<span class="sub">全屏播放当前搭配，轻点任意处进入网站</span></div>
            <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
          </div>
          <div class="set-row" id="row-opening-config">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h16"/><circle cx="9" cy="7" r="2" fill="#111111"/><circle cx="15" cy="12" r="2" fill="#111111"/><circle cx="8" cy="17" r="2" fill="#111111"/></svg></div>
            <div class="txt">开屏搭配设置<span class="sub">管理视频 / 图片 / 音乐、改名、随机或顺序、下次搭配</span></div>
            <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
          </div>
        </div>
        <div class="set-group glass">
          <div class="set-row" id="row-op-bg">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15l5-5 4 4 3-3 6 6"/></svg></div>
            <div class="txt">开屏背景颜色<span class="sub">默认白屏；可改回黑屏或任意颜色</span></div>
            <div class="val" id="op-bg-val">默认 #ffffff</div>
          </div>
          <div class="set-row" id="row-op-bgimg">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M3 17l5-4 4 3 3-2.5 6 4.5"/></svg></div>
            <div class="txt">开屏背景照片<span class="sub">垫在画面下面的底图；和「图片／视频＋音乐」的搭配互不冲突</span></div>
            <div class="val" id="op-bgimg-val">未设置</div>
          </div>
          <div class="set-row sub" id="row-op-bgimg-rm" hidden>
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6"/><path d="M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12"/></svg></div>
            <div class="txt">移除开屏背景照片</div>
          </div>
          <div class="set-row" id="row-op-bar">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="M3 8h11"/><path d="M3 16h7"/></svg></div>
            <div class="txt">加载条颜色<span class="sub">「正在链接…」下方那根进度条</span></div>
            <div class="val" id="op-bar-val">默认 #111111</div>
          </div>
          <div class="set-row" id="row-op-text">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M7 20l5-14 5 14M9 14h6"/></svg></div>
            <div class="txt">加载条文字颜色<span class="sub">「正在链接…／连接成功…」字体颜色</span></div>
            <div class="val" id="op-text-val">默认 #111111</div>
          </div>
          <div class="set-row" id="row-op-sign">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M7 20l5-14 5 14M9 14h6"/></svg></div>
            <div class="txt">开屏署名文字<span class="sub">显示在「连接成功」上方 · 可改内容 / 颜色 / 大小 / 字体</span></div>
            <div class="val" id="op-sign-val">齊陳家</div>
            <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
          </div>
          <div class="set-row" id="row-op-music">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></div>
            <div class="txt">开屏音乐<span class="sub">关掉后进站不再播放开屏音乐；进桌面后音乐继续循环</span></div>
            <label class="toggle"><input type="checkbox" id="op-music-en"><span class="tk"></span></label>
          </div>
        </div>
        <!-- v70：播放器背景（换壁纸）入口已移到「播放器 → 右上角 ⋯」，这里不再重复放 -->
        <div class="set-group glass fp-group">
          <div class="set-row" id="row-font">
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M7 20l5-14 5 14M9 14h6"/></svg></div>
            <div class="txt">应用字体<span class="sub">整站文字即时生效，选择后自动保存</span></div>
            <div class="val" id="font-val">系统默认</div>
          </div>
          <div class="fp-list" id="fp-list"></div>
          <div class="fp-preview" id="fp-preview">预览：山有木兮木有枝，心悦君兮君不知。 0123 ABC</div>
        </div>
      </div><!-- /them-sec look -->
      <!-- 聊天：回复 / 通话 / 音效 + 功能大全 + 功能介绍 -->
      <div class="them-sec" data-sec="chat">
      <div class="set-group glass">
        <div class="set-row" id="row-general">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v3M12 20v3M4.2 4.2l2.2 2.2M17.6 17.6l2.2 2.2M1 12h3M20 12h3M4.2 19.8l2.2-2.2M17.6 6.4l2.2-2.2"/></svg></div>
          <div class="txt">回复设置</div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
        <div class="set-row" id="row-call-settings">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg></div>
          <div class="txt">通话设置</div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
        <div class="set-row" id="row-sfx-settings">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.6v4.8a1 1 0 001 1h2.1l4.1 3.6V5L7.1 8.6H5a1 1 0 00-1 1z"/><path d="M15.4 9a3.4 3.4 0 010 6"/><path d="M18.4 6.4a8 8 0 010 11.2"/></svg></div>
          <div class="txt">音效设置</div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
        <div class="set-row" id="row-featurehub">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M11 8v6"/><path d="M8 11h6"/></svg></div>
          <div class="txt">功能大全<span class="sub">全应用功能索引 · 可搜索 · 点条目直达</span></div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
      </div>
      </div><!-- /them-sec chat -->
      <!-- 系统：应用锁 + 开屏问答门（隐私防护）+ 后台保活/通知 + 全屏边缘防误触 / 离线通知等系统开关
           （「全屏模式」主开关在通用段首位，#927） -->
      <div class="them-sec" data-sec="system">
      <div class="set-group glass">
        <div class="gs-row"><span>后台保活</span><label class="toggle"><input type="checkbox" id="bg-keepalive"><span class="tk"></span></label></div>
        <!-- v3.44.x：保活音频可选——默认内置静音音频 / 用户上传自定义音频（逻辑在 bg-keep.js） -->
        <div class="gs-row"><span>保活音频</span><button class="bg-notify-test" id="bg-keep-audio-btn" type="button">默认静音音频</button></div>
        <!-- #1489：保活不抢其他 App 的声音（作者直派 华为 Mate80／自带浏览器「在后台放音乐，进 mochi 突然变响、
             退出来又变轻」）——默认静音音频改走 WebAudio 通道，不再向系统声明「本站正在放媒体」＝不把别的
             App 的音量压低；关掉＝回到老路（媒体元素＋通知栏媒体条）。逻辑在 bg-keep.js 的 kaBuildTransducer -->
        <div class="gs-row"><span>保活不抢其他 App 的声音</span><label class="toggle"><input type="checkbox" id="bg-keep-noduck"><span class="tk"></span></label></div>
        <div class="gs-sub" id="bg-keep-noduck-sub"><b>默认开启</b>：保活那段近无声音频改走「站内音效」那条通道，不再向手机声明「本站正在放媒体」——你在别的 App 听歌 / 看视频时不会被它压低音量，切进切出也不再忽响忽轻。代价：通知栏那条「Mochi 后台保活」不再出现（那条媒体横幅本身就是这次音频通道的占用）；个别只认这条媒体条豁免的浏览器后台收消息可能变差，把本开关关掉即回到老路（有媒体条、会压低别的 App）。上传了自定义保活音频时本开关不参与——那是你要出声放的东西，照旧占用音频通道。</div>
        <!-- #977：后台保活两条硬限制当面铺在行下（用户直派「两功能要提示用户：后台长时间挂着会失效，
             需重新关掉网页打开并重新打开功能；别的 App 刷视频/听音乐会占用音频截断保活，也要写清楚」）。
             红色视觉复用 #961 红条族；完整口径见本组「功能说明」胶囊与 使用说明 第 10 节 -->
        <div class="gs-sub dict-lock-hint" id="bg-keep-sub">⚠️ <b>两条必知限制（手机/浏览器限制，不是故障）</b>：① <b>别的 App 刷视频、听音乐会把保活截断</b>——它们占用手机音频通道，保活音频被暂停＝保活失效，回到本页才自动恢复，截断期间后台消息收不到；② <b>后台挂久了会失效</b>——系统省电/内存策略会把挂久的页面冻结甚至丢弃重载（Edge「睡眠标签页」/Chrome「内存节省程序」约 30 分钟；手机内存紧张时更快——本页越重，几分钟也可能被丢），<b>失效后请彻底关闭网页重新打开，再把「后台保活」「后台弹窗」开关重新打开</b>。其实被回收后回到本页会自动重载：开关自动恢复、保活在你碰一下页面时就自动接上，数据不丢；<b>止住它最有效的一步＝去 系统设置 → 应用 → 本浏览器（或桌面上的 Mochi）→ 省电 / 电池策略 选「无限制 / 允许后台活动」，再在最近任务里把本站锁定、别横向划掉</b>；⚠ 只关 Edge「睡眠标签页」/ Chrome「内存节省程序」往往白忙活——那两个只管<b>浏览器里的标签页</b>，已添加到桌面的本站是独立应用，改那里管不到它。再把 设置→查看存储 里最占数据的两项清一清（页越轻越不容易被丢）。<br>另外：<b>开着「后台保活」或「后台通知」时，页面不会在后台自动换新版</b>——换新版要重载页面、会把后台运行打断；更新不再弹条提醒，想换新版就彻底关闭网页重开，或到 设置 → 关于 →「检查更新」手动刷（不刷也不影响使用）。</div>
        <div class="gs-row"><span>后台通知</span><label class="toggle"><input type="checkbox" id="bg-notify"><span class="tk"></span></label><button class="bg-notify-test" id="bg-notify-test">测试</button></div>
        <!-- v3.26.x：后台弹窗使用说明——要点直接铺在行下（用户直派「后台弹窗要有使用说明、详细说清楚」），
             完整步骤见本行「功能说明」胶囊（settings-help.js #bg-notify）与 使用说明 → 第 10 节 -->
        <div class="gs-sub" id="bg-notify-sub"><b>后台弹窗＝页面切到后台（锁屏 / 切到别的应用）时，TA 发消息用系统通知弹横幅。</b>必备：① 本机得有网页通知能力——安卓或电脑上的 Chrome / Edge（Chromium 内核）且 https 打开，或 iPhone / iPad 用 Safari「添加到主屏幕」后从桌面图标打开本站（标签页形态没有这个能力）；小米 / vivo / OPPO 自带浏览器、UC、夸克这些没有通知能力，开不起来；② 允许通知权限（地址栏左侧图标 → 网站设置 → 通知）；③ 本开关（会自动开启「后台保活」——后台不产生消息就无从弹起）；④ 系统设置里给浏览器允许通知、且不限制其后台运行/省电（小米 / 红米还要开「在屏幕上方显示 / 悬浮通知」）。<b>iPhone / iPad：Safari 标签页里没有网页通知能力，要到 Safari「添加到主屏幕」后从桌面图标打开本站，这个开关才开得了</b>——那边能授权、能弹系统通知；但 iOS 不给网页推送服务端，应用被系统收回后不保证弹，所以「后台保活」要一起开着，并可用「桌面消息弹窗」的应用内横幅兜底。点本行「功能说明」看完整步骤与「收不到」的排查，点右侧「测试」＝后台弹窗自测：第一段当场体检（开关/权限/保活/后台服务）并真发一条；成功后再点「现在测（切后台）」按 Home 切后台，第二段会由页面在后台再发一条、回来给结论。<b>⚠ 后台弹窗跟着保活一起：保活被截断/页面被丢弃＝后台弹窗一起停摆</b>（别的 App 刷视频、听歌占用音频；挂后台太久被系统冻结——见上方红字）；失效后彻底关闭网页重新打开，再把两个开关重新打开。<b>还有一条最容易漏：手机开了勿扰 / 免打扰（iPhone 叫「专注模式」）时，通知被系统静默收进通知栏、屏幕上方不弹横幅</b>——网页读不到它，「测试」体检全绿你也可能什么都没看到；先下拉通知栏看那条测试通知在不在，在＝被系统压住（去系统设置关掉勿扰，或把本浏览器 / 桌面上的 Mochi 加进勿扰的允许例外）。</div>
        <!-- #1059：通知逐条弹（关闭内容去重）——用户直派「联系人发来的多条消息我都要看到弹窗」。
             默认关闭＝保持去重（同内容/近期弹过只弹一条）；打开后每条消息都单独弹系统通知。 -->
        <div class="gs-row"><span>通知逐条弹（关闭去重）</span><label class="toggle"><input type="checkbox" id="bg-notify-nodedup"><span class="tk"></span></label></div>
        <div class="gs-sub" id="bg-notify-nodedup-sub">默认关闭：内容相同或近期弹过的消息只弹一条（去重，防同句连轰）。<b>打开后每条消息都弹</b>——字卡重复率高时会连环弹同句提示，按需开；聊天记录与未读角标不受影响。</div>
        <!-- FIX 2026-09-22 #1014：权限不到位时不再自动关开关（用户实报「切后台自动关闭」）——
             真实状态与一步到位的方法写在这条标红行里，由 bg-keep.js 按权限读数渲染（granted 时隐藏；
             设备根本没有通知能力时一直显示）。视觉复用 #961 红条族 .dict-lock-hint -->
        <div class="gs-sub dict-lock-hint" id="bg-notify-perm-warn" hidden></div>
        <!-- FIX 2026-09-20 #927：本段的「全屏模式（隐藏手机状态栏）」行（#sf-fullscreen 及其说明小字）已整体搬到
             「通用」段首位独立成组（用户点名要放最前面显眼处）；本段只留下方「全屏边缘防误触」等配套开关。 -->
        <!-- v3.26.x：布局手动兜底——浏览器「桌面版网站」模式会把 UA / screen / 触摸能力 /
             视口整套伪装成桌面，指纹识别必有漏网（vivo Y35 + Edge 连栽三轮）。识别失手时
             用户自己掰回来：本开关（或地址栏 ?mobile=1 / ?pc=1），持久存 localStorage，
             状态文案与绑定见 device.js（window.mochiDevice.setLayoutPref） -->
        <div class="set-row">
          <div class="txt">手机布局（强制）<span class="tag" id="sf-force-mobile-help" role="button" tabindex="0" aria-haspopup="dialog">功能说明</span></div>
          <label class="toggle"><input type="checkbox" id="sf-force-mobile"><span class="tk"></span></label>
        </div>
        <div class="gs-sub" id="sf-force-mobile-sub">…</div>
        <!-- v3.9.x：全屏边缘防误触——部分国产浏览器（雨见/UC/QQ 等）全屏下左右边缘上下滑
             会调节音量/亮度（浏览器自带手势，网页拦不住）。开启后用边缘拦截层+touchstart
             兜底尝试阻挡；对系统级手势可能无效，最可靠仍是浏览器设置关闭边缘滑动调节。 -->
        <div class="gs-row"><span>全屏边缘防误触</span><label class="toggle"><input type="checkbox" id="sf-edge-guard"><span class="tk"></span></label></div>
        <!-- v3.5.104：桌面消息弹窗开关（独立设置项）——非聊天页时 TA 新消息在桌面顶部弹横幅 -->
        <div class="gs-row"><span>桌面消息弹窗</span><label class="toggle"><input type="checkbox" id="desk-msg-en"><span class="tk"></span></label></div>
        <!-- v3.15.x：离线消息提醒（Periodic Background Sync）——页面全关后浏览器定期唤醒
             Service Worker，用本地快照弹一条 TA 的消息（零后端）；门槛是 Chromium 内核
             （安卓 / 电脑的 Chrome、Edge，不是「安卓」这个系统）且添加到桌面后生效，
             调度频率由系统决定；状态见下方说明行（#978 撤掉了静态「仅安卓」胶囊：
             桌面版 Chrome 同样可用，而安卓自带浏览器多数没有这个能力） -->
        <div class="set-row">
          <div class="txt">离线消息提醒<span class="tag" id="psync-help" role="button" tabindex="0" aria-haspopup="dialog">功能说明</span></div>
          <label class="toggle"><input type="checkbox" id="psync-en"><span class="tk"></span></label>
        </div>
        <div class="gs-row" style="display:block"><span id="psync-status" style="font-size:11px;color:var(--muted,#999);line-height:1.5;white-space:normal">…</span></div>
      </div>
      </div><!-- /them-sec system -->
      <!-- 工具：屏幕适配 / 字卡自检 / 各功能数据 / 信息诊断 / 存储 / 卡顿优化等数据与诊断工具
           （FIX 2026-09-20 #927：整机的「导出数据 / 导入数据」与段末「清除本地数据」在通用段，勿在此重建＝重复 id） -->
      <!-- v3.26.x 关于分类：使用说明（#row-guide / #guide-sub）已上移到「关于 → 帮助与支持」，
           与新手引导、功能介绍同属「了解应用」类；工具 tag 只留会改数据的操作 -->
      <div class="them-sec" data-sec="tools">
      <!-- v3.27.x #764：屏幕适配微调——#707「屏幕位置设置」合并升级收口（用户拍板：独立功能、放显眼位）。
           跨机型屏幕适配偏差（遮挡/裁切/留白/白带）自动修不完，把处置权交给用户：八轴滑杆实时预览
           （顶部/底部/页面高度/整体位移/左右安全边/桌面图标区/文字大小/键盘间隙（#1463，只在键盘弹出期间生效）；#990 起按「哪一页生效」
           分三组渲染并给当前页打标记）+ 双击滑杆复位 + 一键还原；存根命名空间 LS
           （屏幕是设备属性，跨桌面共用、换设备不跟随）。文字轴＝文字组逐条 calc 叠加（display-tune.css），
           不碰整页 zoom/scale 红线。id 沿用 row-screen-adj＝mochiScreenAdj/哨兵/搜索别名接线不断。 -->
      <div class="set-group glass">
        <div class="set-row" id="row-screen-adj">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/><path d="M12 18h.01"/></svg></div>
          <div class="txt">屏幕适配微调<span class="sub">顶部遮挡 / 底部裁切 / 页面留白 / 字太小？滑杆边拖边看、当场见效，双击滑杆复位；面板顶部「正在调」旁边两枚页签（桌面 / 聊天），反色高亮的那一枚＝你正在调的页面，点另一枚切过去看现场、「收起」变一枚小胶囊（不挡底部导航与输入栏）；滑杆按生效页面分三组（两页通用 / 只影响桌面页 / 只影响聊天正文文字），当前页那组带标记；面板挡画面时按住标题行上下拖即可挪开；桌面长按空白→装修模式「屏幕适配」、聊天设置→美化→屏幕适配微调 各有一个入口；本机永久保存（换设备各自调）</span></div>
          <div class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></div>
        </div>
        <!-- v3.26.x #185：顶部避让修正——「系统保留/覆盖」两形态 JS 无法区分（信号相同），
             不同机型各属其一：开启=声明本机为覆盖形态（恢复 env 顶部避让+全屏高度含 env），
             修「Mochi 行与系统时间重叠」；默认关=系统保留形态（修「底部白带」）。
             #978：本项真实门槛是「添加到主屏幕后的独立应用形态」（执行器 forceCover 的
             standalone 就是 ios-pwa-standalone 类），不是「iPhone」这个平台——iPhone 用
             Safari 直接打开时开关同样无效，故撤掉静态「仅 iPhone」胶囊，改由 JS 按形态提示。
             #1408（2026-09-29 作者点名「这个功能放错位置了，应该放在设置的【工具】里」）：本行
             自 #961 建的「信息诊断」段搬进「工具」段、紧跟「屏幕适配微调」——它与那八轴治的是
             同一件事（屏幕对不齐自己修），而「信息诊断」里全是只读报告，一个会改渲染落值的开关
             夹在那里既藏又混类目。行 id／开关 id 一字未动＝settings-help 功能说明胶囊、
             personalize.js 的形态判定与「去调整」跳转、device.js 的读写与哨兵全部照旧。 -->
        <div class="set-row">
          <div class="txt">顶部避让修正<span class="sub">只在「添加到主屏幕」后打开（iPhone / iPad 独立应用形态）才有意义；顶部 Mochi 行与手机时间重叠时建议开启，底部出现白带时关闭（改后自动刷新）。浏览器里直接打开时本开关无效果，安卓请用「屏幕适配微调」</span></div>
          <label class="toggle"><input type="checkbox" id="safe-top-force"><span class="tk"></span></label>
        </div>
      </div><!-- /set-group tools · safe-top-force -->
      <!-- #532 字卡使用状态自检（card-audit.js）——用户点名「放在【工具】靠前的地方」，
           独立成组：一眼看懂自定义/系统预设字卡能不能用、怎么调。
