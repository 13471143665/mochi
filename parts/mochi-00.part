}
@media (max-width: 900px) {
.tabbar {
margin-bottom:var(--mochi-safe-bottom,env(safe-area-inset-bottom,0px));
}
.phone .page.full .chat-input-row {
margin: 0;
border-radius: 0;
border-left: none; border-right: none; border-bottom: none;
padding-left: 12px; padding-right: 12px;
padding-top: 10px;
padding-bottom: calc(10px + var(--mochi-safe-bottom,env(safe-area-inset-bottom,0px)));
}
.phone .page.full .chat-head { padding-top: calc(10px + var(--mochi-safe-top, env(safe-area-inset-top, 0px))); }
.phone .page.full { padding-bottom: 0; }
/* v41 键盘态：手机壳高度＝实际可视高，底部不再留一条空白 */
html.kb-on, html.kb-on body { height:var(--kb-h, 100dvh); min-height:0; }
html.kb-on .phone { height:var(--kb-h, 100dvh); min-height:0; }
html.kb-on .phone .page.full .chat-input-row { padding-bottom:10px; }
html.kb-on #page-chat > .chat-input-row { margin-bottom:0; }
html.kb-on #page-chat::after { height:0; }
#page-chat { background: var(--page-bg-grad); }
/* v24：去掉 will-change/合成层——Android Edge 的输入法在提升为合成层的 contenteditable
   上会丢焦点或候选框错位，表现为「点得进去却打不了字」 */
.phone .chat-input { will-change:auto; -webkit-user-select:text; user-select:text; }
}
@media (display-mode: fullscreen) {
.phone .page.full .chat-head { padding-top: max(env(safe-area-inset-top, 0px), 12px); }
.phone .page.full .gs-title, .phone .page.full .card-tabs,
