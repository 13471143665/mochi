return !(t != null && DEFAULT_QUOTES.indexOf(String(t)) >= 0);
});
if (cleaned.length !== raw.length) store.set(KEY, JSON.stringify(cleaned));
}
store.set(MK, '1');
} catch (e) {}
})();
