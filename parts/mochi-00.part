if (enough) L.push('· 开头 10% 中位 ' + Math.round(early) + 'ms → 最后 10% 中位 ' + Math.round(late) + 'ms（' + (slow >= 0 ? '+' : '') + Math.round(slow * 1000) / 10 + '%；判级：<10% 未见降频 / 10~25% 轻度 / ≥25% 明显降频）');
