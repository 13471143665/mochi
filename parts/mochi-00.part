sp.textContent = text;
const h1 = bub.offsetHeight, o1 = bub.scrollWidth - bub.clientWidth;
sp.textContent = text + ' ' + kj;
const h2 = bub.offsetHeight, o2 = bub.scrollWidth - bub.clientWidth;
return (h2 > h1 || o2 > o1 + 1) ? '\n' : ' ';
} catch (e) {
