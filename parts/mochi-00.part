.fs-active .phone .page.full .gs-title, .fs-active .phone .page.full .card-tabs,
.fs-active .phone .page.full .div-h-title, .fs-active .phone .page.full .stats-top-name { padding-top: max(env(safe-area-inset-top, 0px), 12px); }
html.ios-native-fs .phone .page.full .chat-head,
html.ios-native-fs .phone .page.full .gs-title,
html.ios-native-fs .phone .page.full .card-tabs,
html.ios-native-fs .phone .page.full .div-h-title,
html.ios-native-fs .phone .page.full .stats-top-name { padding-top: 10px; }
.ios-fs-active .phone .page.full .chat-head,
.ios-fs-active .phone .page.full .gs-title,
.ios-fs-active .phone .page.full .card-tabs,
.ios-fs-active .phone .page.full .div-h-title,
