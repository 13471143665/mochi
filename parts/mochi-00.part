const BARE_KEYS = ['divine-history', 'xy-home-v2:age-confirmed'];
const wipeAppKeys = function () {
try {
Object.keys(localStorage)
.filter(k => k.indexOf('xy-home-v2:') === 0 || BARE_KEYS.indexOf(k) >= 0)
