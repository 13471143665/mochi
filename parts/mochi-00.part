if (r.allDone) { /* 首屏即终态 */ }
else if (r.onUpdate) {
r.onUpdate(function (txt, done2) {
cur = txt;
if (closed) return;
if (!modalAlive()) { closed = true; return; }
setModalText(txt);
if (!done2) setHint(TIP_WAIT);
});
}
}).catch(function () {
clearTimeout(guard);
if (!opened) openDiag(basicDiagText(), false);
