else if (t.indexOf('|||') >= 0) t = t.split('|||')[0].replace(/\.[^.]+$/, '').trim() || '[语音]';
else if (t.indexOf('<svg') >= 0) t = t.replace(/<[^>]*>/g, '').trim();
