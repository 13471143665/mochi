r.wishSent = Date.now();
marked = true;
}
if (marked) saveMsgs();
}
} catch (e) {}
try {
const els = document.querySelectorAll('#chat-body .msg-wish');
for (let i = 0; i < els.length; i++) {
const idx = Number(els[i].dataset.idx);
