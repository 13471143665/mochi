function runPersist() {
persistTimer = null;
if (!persistRun) return;
const wait = PERSIST_MIN_GAP - (performance.now() - lastPersistAt);
if (wait > 0) { persistTimer = setTimeout(runPersist, wait); return; }
const run = persistRun;
persistRun = null;
