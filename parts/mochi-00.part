L2.push('');
L2.push('== 功能逐项（共 ' + FUNC_ITEMS.length + ' 项）==');
rows.forEach(function (r) { L2.push(r); L2.push(''); });
L2.push('== 汇总 ==');
L2.push('正常 ' + okN + ' / 需注意 ' + warnN + ' / 异常 ' + badN + ' / 打开跳过 ' + skipN);
const bads = rows.filter(function (r) { return r.indexOf('✗') === 0; });
