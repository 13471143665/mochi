if (c && c.hint && txt2.length > 8000) c.hint(TIP_LONG);
copyText(txt2).then(function (ok2) {
const m2 = ok2 ? TIP_OK : '复制失败，请长按选字手动复制。';
if (c && c.hint) c.hint(m2);
