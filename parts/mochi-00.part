const back = localStorage.getItem(G + '__ls-probe');
localStorage.removeItem(G + '__ls-probe');
return back === 'p' ? 'ok' : 'unwritable(写入后读不回)';
} catch (e) {
return 'unwritable(' + ((e && e.name) || '异常') + ')';
}
}
function notice(msg) {
