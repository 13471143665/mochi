function showDeskPopup(opts) {
opts = opts || {};
let t = String(opts.text || '');
const phOf = function () {
if (opts.type === 'voice') return '[语音]';
if (opts.imgSub === 'sticker' || opts.type === 'sticker') return '[表情包]';
return '[图片]';
};
if (!t && opts.img) t = phOf();
if (!t) return;
if (chatIsInlineDataSrc(t)) t = phOf();
