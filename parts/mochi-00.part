try { const _cr = presetReplyPick('贴贴·回应', CUDDLE_REPLIES); if (_cr) addInTyped(name + ' ' + _cr); } catch (e) {}
return;
}
if (kind === 'rps') { if (window.openRpsPanel) window.openRpsPanel(); return; }
