const pct = parseInt(v, 10);
if (isNaN(pct) || pct < 0 || pct > 100) { toast('请输入 0-100 的数字'); return; }
if (pct === 100) store.remove('widget-opacity');
else store.set('widget-opacity', String(pct));
applyWidgetOpacity(pct);
syncWidgetOpacityUI();
}, {
maxlength: 3,
pills: [
{ label: '100%', value: '100' },
{ label: '80%', value: '80' },
{ label: '60%', value: '60' },
{ label: '40%', value: '40' },
{ label: '20%', value: '20' },
],
});
});
}
