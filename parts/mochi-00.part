back.click();
}
await sleep(230);
const closedOk = !pageVisible(it.page);
det.push('打开✓ ' + (Date.now() - t0) + 'ms，关闭' + (closedOk ? '✓' : '⚠'));
restoreDesk();
} else if (it.gated) {
