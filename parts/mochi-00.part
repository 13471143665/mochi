} catch (e) {}
}
idbDone.then(() => { wipeAppKeys(); try { location.reload(); } catch (e) {} });
}, { noInput: true });
}
});
}
const checkin = document.querySelector('.checkin');
if (checkin) {
const btn = checkin.querySelector('.ck-btn');
