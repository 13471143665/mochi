tip = el('div', 'gs-sub', '已由「默认进入的桌面」取代：每次打开直接进入所选桌面，不再先进入此间或显示联系人列表。要恢复，请把上面的默认桌面设为「关闭」。');
tip.id = 'entry-cjian-first-tip';
