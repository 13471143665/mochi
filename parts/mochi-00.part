const pos = { x: store.get('phone-bg-pos-x'), y: store.get('phone-bg-pos-y'), s: store.get('phone-bg-size') };
let n = 0;
others.forEach((c) => {
try {
const st = window.xyStore('xy-home-v2:' + c.id);
glist.forEach((gid) => {
const f = store.get('phone-bg-item-' + gid); if (f) st.set('phone-bg-item-' + gid, f);
