.garden-weather-bar {
display:flex; align-items:center; gap:8px;
padding:10px 18px; font-size:13px; color:var(--muted);
}
.garden-weather-ico { font-size:20px; }
.garden-weather-txt { flex:1; }
.garden-season { font-size:12px; opacity:.7; }
.garden-scroll { flex:1; overflow-y:auto; scrollbar-width:none; -ms-overflow-style:none; }
.garden-scroll::-webkit-scrollbar { display:none; }
.garden-grid {
display:grid; grid-template-columns:repeat(4, 1fr);
gap:8px; padding:0 18px 14px;
min-height:360px; align-content:start;
}
.garden-plot {
aspect-ratio:1;
border-radius:14px; background:rgba(255,255,255,.94);
border:1.5px solid rgba(0,0,0,.06);
display:flex; flex-direction:column; align-items:center; justify-content:center;
cursor:pointer; position:relative; overflow:hidden;
transition:border-color .2s ease, box-shadow .2s ease;
-webkit-tap-highlight-color:transparent;
user-select:none;
}
.garden-plot:active { border-color:rgba(0,0,0,.18); box-shadow:0 2px 10px rgba(0,0,0,.08); }
.garden-plot.empty { border-style:dashed; border-color:rgba(0,0,0,.12); background:rgba(255,255,255,.7); }
.garden-plot.watered { border-color:rgba(76,175,128,.35); }
.garden-plant-emoji { font-size:24px; line-height:1; transform-origin: 50% 80%; will-change: transform; }
.garden-plot.bloomed .garden-plant-emoji { animation: gardenSway 3.2s ease-in-out infinite; }
.garden-plot.wilted .garden-plant-emoji { filter: grayscale(.55) brightness(.9); }
.garden-plot.wilted { border-color: rgba(139,90,43,.45); background: rgba(245,235,220,.6); }
.garden-plant-stage.wilted-stage { color:#a1887f; font-weight:600; }
@keyframes gardenPop { 0% { transform: scale(.6); opacity:0; } 60% { transform: scale(1.12); opacity:1; } 100% { transform: scale(1); opacity:1; } }
@keyframes gardenBloom { 0% { transform: scale(.7) rotate(-12deg); opacity:0; } 50% { transform: scale(1.25) rotate(8deg); opacity:1; } 100% { transform: scale(1) rotate(0); opacity:1; } }
@keyframes gardenSway { 0%,100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
@keyframes gardenWilt { 0% { transform: scale(1.1) rotate(0); } 100% { transform: scale(.95) rotate(-6deg); } }
.garden-plant-name { font-size:10px; color:var(--ink); font-weight:600; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%; padding:0 4px; box-sizing:border-box; }
.garden-plant-stage { font-size:9px; color:var(--muted); margin-top:0; }
.garden-plot-empty-txt { font-size:9px; color:var(--muted); opacity:.5; }
.garden-water-bar {
position:absolute; bottom:3px; left:6px; right:6px; height:2px;
border-radius:1px; background:rgba(0,0,0,.06); overflow:hidden;
}
.garden-water-fill {
height:100%; border-radius:1px;
background:linear-gradient(90deg, #64b5f6, #42a5f5);
transition:width .4s ease;
}
.garden-water-fill.low { background:linear-gradient(90deg, #ef9a9a, #e57373); }
.garden-water-fill.ok { background:linear-gradient(90deg, #a5d6a7, #66bb6a); }
.garden-plot.selected { border-color:#111; box-shadow:0 2px 12px rgba(0,0,0,.12); }
.garden-grow-bar {
position:absolute; bottom:6px; left:6px; right:6px; height:2px;
border-radius:1px; background:rgba(0,0,0,.06); overflow:hidden;
}
.garden-grow-fill {
height:100%; border-radius:2px;
background:linear-gradient(90deg, #81c784, #4caf50);
transition:width .4s ease;
}
.garden-toolbar {
display:flex; flex-wrap:wrap; gap:4px; padding:0 12px 14px;
overflow-x:auto; scrollbar-width:none; -ms-overflow-style:none;
}
.garden-toolbar::-webkit-scrollbar { display:none; }
.garden-tool {
display:flex; flex-direction:column; align-items:center; gap:2px;
padding:8px 6px; border-radius:12px;
border:1px solid rgba(0,0,0,.1); background:rgba(255,255,255,.94);
cursor:pointer; font-family:inherit; font-size:11px; color:var(--ink);
min-width:42px; flex:0 0 auto;
transition:background .15s ease, border-color .15s ease;
-webkit-tap-highlight-color:transparent;
}
.garden-tool:active { background:#111; color:#fff; }
.garden-tool:active svg { stroke:#fff; }
.garden-tool svg { width:22px; height:22px; }
.garden-tool-label { font-size:11px; font-weight:600; }
.garden-tool.batch { background:rgba(76,175,80,.12); border-color:rgba(76,175,80,.3); }
.garden-tool.batch:active { background:#4caf50; }
.garden-log {
margin:0 18px 18px; padding:14px 16px;
border-radius:18px;
}
.garden-log-title { font-size:14px; font-weight:700; margin-bottom:10px; }
.garden-log-list { display:flex; flex-direction:column; gap:6px; max-height:200px; overflow-y:auto; scrollbar-width:none; -ms-overflow-style:none; }
.garden-log-list::-webkit-scrollbar { display:none; }
.garden-log-item {
display:flex; align-items:flex-start; gap:8px;
font-size:12px; color:var(--muted); line-height:1.4;
}
.garden-log-item .who { color:var(--ink); font-weight:600; flex-shrink:0; }
.garden-log-item .act { flex:1; }
.garden-log-item .tm { font-size:10px; opacity:.5; flex-shrink:0; }
.garden-plant-select {
display:grid; grid-template-columns:repeat(3, 1fr); gap:8px;
padding:6px 0;
}
.garden-seed {
display:flex; flex-direction:column; align-items:center; gap:4px;
padding:10px 6px; border-radius:14px;
border:1px solid rgba(0,0,0,.08); cursor:pointer;
font-size:12px; color:var(--ink); font-weight:600;
transition:border-color .15s ease, background .15s ease;
}
.garden-seed:active { background:rgba(0,0,0,.04); border-color:#111; }
.garden-seed .seed-emoji { font-size:28px; }
.garden-seed .seed-name { font-size:11px; }
.garden-level-bar {
display:flex; align-items:center; gap:8px;
padding:0 18px 10px; font-size:12px;
}
.garden-lv-num { font-weight:700; color:var(--ink); flex-shrink:0; }
.garden-lv-track { flex:1; height:6px; border-radius:3px; background:rgba(0,0,0,.06); overflow:hidden; }
.garden-lv-fill { height:100%; border-radius:3px; background:linear-gradient(90deg,#ffd54f,#ffb300); transition:width .4s ease; }
.garden-lv-exp { color:var(--muted); flex-shrink:0; font-size:11px; }
.garden-stats {
display:flex; justify-content:center; gap:20px;
padding:0 18px 12px; font-size:13px; color:var(--muted);
}
.gs-item b { color:var(--ink); font-size:16px; font-weight:700; margin-right:2px; }
.garden-dex { margin:0 18px 14px; padding:14px 16px; border-radius:18px; }
.garden-dex-title { font-size:14px; font-weight:700; margin-bottom:10px; }
.garden-dex-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.garden-dex-item {
display:flex; align-items:center; gap:6px; padding:8px 6px;
border-radius:12px; background:rgba(0,0,0,.03); font-size:11px;
flex-wrap:wrap;
}
.garden-dex-item.locked, .garden-dex-item.unknown { opacity:.4; justify-content:center; }
.garden-dex-item .dex-emoji { font-size:18px; }
.garden-dex-item .dex-name { color:var(--ink); font-weight:600; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.garden-dex-item .dex-cnt { color:var(--muted); font-size:10px; flex-shrink:0; }
.garden-dex-item.tap { cursor:pointer; -webkit-tap-highlight-color:transparent; }
.garden-dex-item.tap:active { background:rgba(0,0,0,.08); }
.garden-dex-item .dex-lang { flex-basis:100%; font-size:10px; color:var(--muted); line-height:1.3; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.garden-inv { margin:0 18px 18px; padding:14px 16px; border-radius:18px; }
.garden-inv-title { font-size:14px; font-weight:700; margin-bottom:10px; }
.garden-inv-list { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
.garden-inv-item {
font-size:12px; padding:4px 10px; border-radius:99px;
background:rgba(0,0,0,.04); color:var(--ink);
white-space:nowrap; max-width:100%; overflow:hidden; text-overflow:ellipsis;
}
.garden-inv-empty { font-size:12px; color:var(--muted); text-align:center; padding:8px 0; }
.garden-bouquet-btn {
display:block; width:100%; padding:10px; border-radius:14px;
border:none; background:#e85a8f; color:#fff; font-size:13px; font-weight:600;
cursor:pointer; font-family:inherit;
}
.garden-bouquet-btn:active { opacity:.8; }
.garden-visitor {
display:none; align-items:center; gap:8px;
margin:0 18px 10px; padding:10px 14px; border-radius:14px;
background:linear-gradient(90deg, rgba(255,215,0,.12), rgba(255,149,0,.08));
font-size:12px; color:var(--ink);
animation: gardenVisitorPulse 2s ease-in-out infinite;
}
.garden-visitor-emoji { font-size:20px; }
.garden-visitor-txt { flex:1; }
@keyframes gardenVisitorPulse {
0%,100% { transform: translateY(0); }
50% { transform: translateY(-2px); }
}
.garden-decor { margin:0 18px 14px; padding:14px 16px; border-radius:18px; }
.garden-decor-title { font-size:14px; font-weight:700; margin-bottom:10px; }
.garden-decor-list { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:10px; }
.garden-decor-item {
font-size:12px; padding:4px 10px; border-radius:99px;
background:rgba(0,0,0,.04); color:var(--ink);
white-space:nowrap; max-width:100%; overflow:hidden; text-overflow:ellipsis;
}
.garden-decor-buff { font-size:10px; color:#4caf50; font-weight:600; margin-left:2px; }
.garden-decor-empty { font-size:12px; color:var(--muted); text-align:center; padding:8px 0; }
.garden-decor-shop-btn {
display:block; width:100%; padding:10px; border-radius:14px;
border:none; background:#7cb342; color:#fff; font-size:13px; font-weight:600;
cursor:pointer; font-family:inherit;
}
.garden-decor-shop-btn:active { opacity:.8; }
.garden-decor-shop-ico {
display:inline-flex; align-items:center; justify-content:center;
width:20px; height:20px; border-radius:50%; background:#fff;
margin-right:5px; vertical-align:-5px; font-size:12px; color:#444;
}
.garden-lb { margin:0 18px 18px; padding:14px 16px; border-radius:18px; }
.garden-lb-title { font-size:14px; font-weight:700; margin-bottom:10px; }
.garden-lb-head {
display:flex; justify-content:space-between;
font-size:11px; color:var(--muted); margin-bottom:6px; padding:0 4px;
}
.garden-lb-row {
display:flex; align-items:center; gap:8px; margin-bottom:8px;
}
.lb-label { font-size:11px; color:var(--muted); width:32px; flex-shrink:0; }
.lb-bar {
flex:1; height:20px; border-radius:10px; overflow:hidden;
display:flex; font-size:10px; color:#fff; font-weight:600;
}
.lb-me {
height:100%; display:flex; align-items:center; justify-content:center;
background:linear-gradient(90deg, #42a5f5, #1e88e5);
transition: width .4s ease; min-width:0; overflow:hidden;
}
.lb-ta {
height:100%; display:flex; align-items:center; justify-content:center;
background:linear-gradient(90deg, #ef5350, #e53935);
transition: width .4s ease; min-width:0; overflow:hidden;
}
.garden-scroll { position: relative; }
[data-season="0"] .garden-plot { border-color: rgba(129,199,132,.32); }
[data-season="1"] .garden-plot { border-color: rgba(100,181,246,.32); }
[data-season="2"] .garden-plot { border-color: rgba(255,183,77,.32); }
[data-season="3"] .garden-plot { border-color: rgba(189,223,253,.45); }
.garden-plot.rare { box-shadow: 0 0 14px rgba(255,215,0,.45), inset 0 0 8px rgba(255,235,150,.2); }
.garden-plot.rare .garden-plant-emoji { position:relative; filter: drop-shadow(0 0 6px rgba(255,215,0,.7)); }
.garden-plot.rare.bloomed .garden-plant-emoji { animation: gardenSway 3.2s ease-in-out infinite; }
.garden-plot.rare.bloomed .garden-plant-emoji::after {
content:''; position:absolute; inset:-45%; z-index:-1; border-radius:50%;
background:radial-gradient(circle, rgba(255,215,0,.55), rgba(255,215,0,0) 70%);
opacity:.4; pointer-events:none;
animation:gardenRareHalo 2s ease-in-out infinite;
}
@keyframes gardenRareHalo { 0%,100% { opacity:.4; transform:scale(.9); } 50% { opacity:1; transform:scale(1.1); } }
.garden-dex-sub { font-size: 12px; font-weight: 700; margin: 10px 0 6px; color: #f9a825; }
.garden-dex-grid.rare-grid .garden-dex-item.rare { background: linear-gradient(90deg, rgba(255,215,0,.12), rgba(255,149,0,.08)); border: 1px solid rgba(255,215,0,.3); }
.garden-dex-item.rare .dex-emoji { filter: drop-shadow(0 0 3px rgba(255,215,0,.6)); }
.garden-daily {
margin: 0 18px 10px; padding: 10px 14px; border-radius: 14px;
background: linear-gradient(90deg, rgba(255,193,7,.12), rgba(255,152,0,.08));
}
.garden-daily-title { font-size: 12px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
.garden-daily-tasks { display: flex; gap: 8px; }
.garden-daily-task {
flex: 1; display: flex; align-items: center; gap: 4px; justify-content: center;
padding: 5px 4px; border-radius: 10px; background: rgba(255,255,255,.6);
font-size: 11px; color: var(--muted);
}
.garden-daily-task.done { background: rgba(76,175,80,.2); color: #2e7d32; font-weight: 600; }
.dt-emoji { font-size: 14px; }
.garden-achv { margin: 0 18px 18px; padding: 14px 16px; border-radius: 18px; background: rgba(255,255,255,.6); }
.garden-achv-title { font-size: 14px; font-weight: 700; margin-bottom: 10px; }
.garden-achv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.garden-achv-item {
display: flex; align-items: center; gap: 6px; padding: 8px 6px;
border-radius: 12px; background: rgba(0,0,0,.03); font-size: 11px;
opacity: .5;
}
.garden-achv-item.done { opacity: 1; background: linear-gradient(90deg, rgba(255,215,0,.14), rgba(255,149,0,.08)); }
.achv-emoji { font-size: 18px; }
.achv-name { color: var(--ink); font-weight: 600; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.garden-tabs {
display: flex; gap: 6px; padding: 8px 14px 10px;
overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none;
position: sticky; top: 0; z-index: 8;
background: linear-gradient(180deg, rgba(245,245,240,.96) 70%, rgba(245,245,240,0));
}
.garden-tabs::-webkit-scrollbar { display: none; }
.garden-tab {
flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; gap: 5px;
padding: 8px 14px; border-radius: 99px; border: 1px solid rgba(0,0,0,.08);
background: rgba(255,255,255,.9); cursor: pointer; font-family: inherit; color: var(--ink);
transition: background .15s ease, color .15s ease; -webkit-tap-highlight-color: transparent;
}
.garden-tab.active { background: linear-gradient(90deg, #66bb6a, #43a047); color: #fff; border-color: transparent; }
.gt-emoji { font-size: 14px; }
.garden-tab.active .gt-emoji { filter: drop-shadow(0 1px 1px rgba(0,0,0,.35)); }
.gt-name { font-size: 12px; font-weight: 600; white-space: nowrap; }
.garden-panel { display: none; padding-bottom: 8px; }
.garden-panel.active { display: block; }
.garden-fold-tile {
aspect-ratio: 1; border-radius: 14px;
border: 1.5px dashed rgba(0,0,0,.18); background: rgba(255,255,255,.55);
display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
font-size: 11px; color: var(--muted); cursor: pointer; user-select: none;
-webkit-tap-highlight-color: transparent;
}
.garden-fold-tile:active { background: rgba(0,0,0,.05); }
.garden-fold-hint { font-size: 9px; opacity: .6; }
.garden-log-toggle {
float: right; border: none; background: none; font-family: inherit;
font-size: 11px; font-weight: 600; color: #43a047; cursor: pointer; padding: 0;
}
.garden-log-list { max-height: 320px; }
.garden-craft { margin: 0 18px 18px; padding: 14px 16px; border-radius: 18px; background: rgba(255,255,255,.6); }
.garden-craft-title { font-size: 14px; font-weight: 700; margin-bottom: 10px; }
.garden-craft-list { display: flex; flex-direction: column; gap: 10px; }
.garden-recipe {
padding: 12px; border-radius: 14px; background: rgba(0,0,0,.03);
border: 1px solid transparent;
}
.garden-recipe.can { background: linear-gradient(90deg, rgba(232,90,143,.08), rgba(255,193,7,.06)); border-color: rgba(232,90,143,.25); }
.garden-recipe.made { border-color: rgba(76,175,80,.3); }
.recipe-head { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
.recipe-emoji { font-size: 18px; }
.recipe-name { font-size: 13px; font-weight: 700; color: var(--ink); }
.recipe-made { font-size: 10px; color: #4caf50; margin-left: auto; }
.recipe-need { font-size: 11px; color: var(--muted); margin-bottom: 4px; letter-spacing: 1px; }
.recipe-wish { font-size: 11px; color: var(--ink); opacity: .8; line-height: 1.5; margin-bottom: 8px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.recipe-btn {
display: block; width: 100%; padding: 7px; border-radius: 10px;
border: none; background: #e85a8f; color: #fff; font-size: 12px; font-weight: 600;
cursor: pointer; font-family: inherit;
}
.recipe-btn:active { opacity: .8; }
.recipe-btn[disabled] { opacity: .5; cursor: default; }
.recipe-need .rq.short { color: #e0524f; font-weight: 700; letter-spacing: 0; }
.recipe-lack { font-size: 11px; color: #e0524f; margin: -2px 0 4px; }
.garden-report { margin: 0 18px 18px; }
.garden-report-card {
padding: 18px 16px; border-radius: 18px;
background: linear-gradient(135deg, rgba(102,187,67,.12), rgba(255,193,7,.1));
text-align: center;
}
.report-year { font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
.report-lv { font-size: 12px; color: var(--muted); margin-bottom: 14px; }
.report-stats { display: flex; flex-wrap: wrap; justify-content: space-around; gap: 8px; margin-bottom: 14px; }
.rs-item { font-size: 11px; color: var(--muted); min-width: 0; }
.rs-item b { display: block; font-size: 18px; color: var(--ink); font-weight: 700; }
.report-row {
display: flex; justify-content: space-between; align-items: center;
padding: 8px 12px; margin-bottom: 4px; border-radius: 10px;
background: rgba(255,255,255,.5); font-size: 12px;
}
.report-row span { color: var(--muted); }
.report-row b { color: var(--ink); font-weight: 600; }
.report-share-btn {
display: block; width: 100%; margin-top: 12px; padding: 10px; border-radius: 14px;
border: none; background: #43a047; color: #fff; font-size: 13px; font-weight: 600;
cursor: pointer; font-family: inherit;
}
.report-share-btn:active { opacity: .8; }
.garden-fx {
position: absolute; left: 0; top: 0; width: 100%; height: 100%;
pointer-events: none; z-index: 5; border-radius: 14px; overflow: hidden;
}
.garden-fx.fx-water::before {
content: ""; position: absolute; left: 50%; top: -10px;
width: 8px; height: 8px; margin-left: -4px; border-radius: 50%;
background: radial-gradient(circle, #4fc3f7, #0288d1);
box-shadow: -10px 0 0 #4fc3f7, 10px 0 0 #29b6f6;
animation: fxDrop .9s ease-in forwards;
}
.garden-fx.fx-fert::before {
content: ""; position: absolute; left: 50%; top: 50%;
width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
border: 2px solid #ffb300; opacity: .8;
animation: fxRing .8s ease-out forwards;
}
.garden-fx.fx-harvest::before,
.garden-fx.fx-harvest::after {
content: ""; position: absolute; width: 6px; height: 6px; border-radius: 50%;
background: #ff80ab; box-shadow: 0 0 6px #ff80ab;
}
.garden-fx.fx-harvest::before { left: 20%; top: 50%; animation: fxFly1 1s ease-out forwards; }
.garden-fx.fx-harvest::after { right: 20%; top: 50%; animation: fxFly2 1s ease-out forwards; }
@keyframes fxDrop { to { top: 110%; } }
@keyframes fxRing { to { width: 80px; height: 80px; margin: -40px 0 0 -40px; opacity: 0; } }
@keyframes fxFly1 { to { transform: translate(-30px, -40px); opacity: 0; } }
@keyframes fxFly2 { to { transform: translate(30px, -40px); opacity: 0; } }
.garden-qual-tag {
display: inline-block; margin-left: 4px; padding: 1px 5px;
border-radius: 8px; font-size: 9px; font-weight: 700; letter-spacing: .5px;
background: linear-gradient(90deg, rgba(255,193,7,.18), rgba(255,111,0,.14));
color: #c67800;
}
.garden-tool.hybrid { background: rgba(156,39,176,.1); border-color: rgba(156,39,176,.3); }
.garden-tool.hybrid:active { background: #9c27b0; }
.garden-tool.reclaim { background: rgba(0,150,136,.1); border-color: rgba(0,150,136,.3); }
.garden-tool.reclaim:active { background: #009688; }
.garden-tool.shrink { background: rgba(233,30,99,.07); border-color: rgba(233,30,99,.25); }
.garden-tool.shrink:active { background: #e91e63; }
.garden-tool.replant.batch { background: rgba(76,175,80,.12); border-color: rgba(76,175,80,.3); }
.garden-craft-sub { font-size: 13px; font-weight: 700; margin: 14px 0 8px; }
.hybrid-list .garden-recipe.hybrid { background: rgba(156,39,176,.05); }
.hybrid-list .garden-recipe.hybrid.made { border-color: rgba(156,39,176,.3); background: rgba(156,39,176,.08); }
.recipe-locked { font-size: 10px; color: var(--muted); margin-left: auto; }
@media (prefers-reduced-motion: reduce) {
.garden-plot.bloomed .garden-plant-emoji,
.garden-plot.rare.bloomed .garden-plant-emoji { animation: none !important; }
.garden-plot.rare.bloomed .garden-plant-emoji::after { animation: none !important; } .garden-fx { display: none !important; }
}
.garden-dex-bar { margin-bottom: 10px; }
.garden-dex-search { width: 100%; padding: 8px 12px; border-radius: 12px; border: 1px solid rgba(0,0,0,.1); background: rgba(255,255,255,.8); font-size: 13px; margin-bottom: 8px; box-sizing: border-box; font-family: inherit; color: var(--ink); }
.garden-dex-seasons { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 8px; }
.garden-dex-season { padding: 4px 10px; border-radius: 99px; border: none; background: rgba(0,0,0,.05); font-size: 11px; cursor: pointer; font-family: inherit; color: var(--ink); -webkit-tap-highlight-color: transparent; }
.garden-dex-season.active { background: linear-gradient(90deg, #66bb6a, #43a047); color: #fff; }
.garden-dex-empty { text-align: center; padding: 20px; color: var(--muted); font-size: 13px; }
.garden-pot-mark { position: absolute; top: 2px; left: 3px; font-size: 9px; font-weight: 700; padding: 1px 4px; border-radius: 6px; background: linear-gradient(90deg, rgba(255,193,7,.3), rgba(255,111,0,.2)); color: #c67800; z-index: 4; }
.garden-tool.upgrade { background: rgba(255,193,7,.1); border-color: rgba(255,193,7,.3); }
.garden-tool.upgrade:active { background: #ffb300; }
.memo-body { flex:1; overflow-y:auto; box-sizing:border-box; padding:14px 14px 40px; display:flex; flex-direction:column; }
.memo-input-row { display:flex; gap:10px; margin-bottom:12px; }
.memo-inp { flex:1; min-width:0; height:44px; border:none; border-radius:12px; background:rgba(255,255,255,.75); box-shadow:inset 0 0 0 1px rgba(0,0,0,.07); padding:0 14px; font-size:15px; color:var(--ink,#222); box-sizing:border-box; }
.memo-inp:focus { outline:none; box-shadow:inset 0 0 0 1.5px rgba(0,0,0,.2); }
.memo-add { flex-shrink:0; border:none; border-radius:12px; background:#111; color:#fff; font-size:14px; font-weight:600; padding:0 20px; }
.memo-msg { padding:12px 14px; border-radius:14px; text-align:center; font-size:14px; color:var(--ink,#555); margin-bottom:12px; transition:opacity .2s; }
.memo-msg:empty { display:none; }
.memo-msg.fade { opacity:0; }
.memo-toolbar { display:flex; align-items:center; justify-content:space-between; margin:0 2px 10px; min-height:26px; }
.memo-count { font-size:12px; color:var(--ink-soft,#999); }
.memo-cleardone { font-size:12px; color:var(--ink-soft,#888); background:none; border:1px solid rgba(0,0,0,.12); border-radius:16px; padding:4px 12px; }
.memo-list { display:flex; flex-direction:column; gap:10px; }
.memo-item { display:flex; align-items:flex-start; gap:10px; padding:12px 10px 10px 12px; border-radius:14px; }
.mm-check { flex-shrink:0; width:22px; height:22px; border-radius:50%; border:1.5px solid rgba(0,0,0,.3); margin-top:2px; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:background .15s, border-color .15s; -webkit-tap-highlight-color:transparent; }
.mm-check svg { width:12px; height:12px; opacity:0; transition:opacity .15s; stroke:#fff; stroke-width:3; fill:none; stroke-linecap:round; stroke-linejoin:round; }
.memo-item.done .mm-check { background:#111; border-color:#111; }
.memo-item.done .mm-check svg { opacity:1; }
.mm-main { flex:1; min-width:0; }
.mm-text { font-size:15px; color:var(--ink,#222); line-height:1.45; white-space:pre-wrap; word-break:break-word; transition:opacity .2s; cursor:pointer; }
.memo-item.done .mm-text { opacity:.45; text-decoration:line-through; }
.memo-item.pinned .mm-text { font-weight:700; }
.mm-time { font-size:11px; color:var(--ink-soft,#aaa); margin-top:4px; }
.mm-time.due-overdue { color:#e05a5a; font-weight:600; }
.mm-time.due-today { color:#e8a23c; font-weight:600; }
.memo-item.urgent .mm-text { color:#c0392b; }
.memo-item.urgent.done .mm-text { color:var(--ink,#222); }
.mm-act, .mm-pin, .mm-del { flex-shrink:0; width:28px; height:28px; border:none; background:none; padding:0; border-radius:8px; display:flex; align-items:center; justify-content:center; cursor:pointer; -webkit-tap-highlight-color:transparent; }
.mm-act { color:var(--ink-soft,#b5b5b5); }
.mm-act svg { width:15px; height:15px; }
.mm-act:active { background:rgba(0,0,0,.06); }
.mm-due.on { color:#4a9fd4; }
.mm-share:active { color:#4a9fd4; }
.mm-pin { font-size:13px; opacity:.4; filter:grayscale(1); transition:opacity .15s, filter .15s; }
.mm-pin.on { opacity:1; filter:none; }
.mm-del { color:var(--ink-soft,#c0c0c0); }
.mm-del svg { width:13px; height:13px; }
.memo-empty { text-align:center; font-size:13px; color:var(--ink-soft,#aaa); padding:36px 0 8px; line-height:1.9; }
.memo-manage { margin-top:14px; display:flex; flex-wrap:wrap; gap:8px; justify-content:center; align-items:center; }
.memo-send-btn { font-size:12px; color:var(--ink-soft,#888); background:rgba(255,255,255,.7); border:1px solid rgba(0,0,0,.12); border-radius:16px; padding:6px 16px; cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.memo-send-btn:active { background:rgba(0,0,0,.06); }
.memo-remind-chips { display:flex; gap:8px; margin:-4px 0 12px; flex-wrap:wrap; }
.memo-rc { font-size:12px; color:var(--ink-soft,#888); background:rgba(255,255,255,.6); border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:4px 12px; cursor:pointer; user-select:none; -webkit-tap-highlight-color:transparent; transition:background .15s,color .15s,border-color .15s; }
.memo-rc.on { color:#fff; background:#4a9fd4; border-color:#4a9fd4; }
.mm-remind-marks { display:flex; gap:6px; margin-top:5px; align-items:center; }
.mm-rm { width:18px; height:18px; display:flex; align-items:center; justify-content:center; cursor:pointer; border-radius:5px; -webkit-tap-highlight-color:transparent; }
.mm-rm svg { width:14px; height:14px; }
.mm-rm:active { background:rgba(0,0,0,.06); }
.mm-rm.chat { color:#4a9fd4; }
.mm-rm.sysDue { color:#e8a23c; }
.mm-rm.contact { color:#7c5cd4; }
.memo-contact-mask { position:fixed; inset:0; z-index:95; background:rgba(0,0,0,.42); display:flex; align-items:center; justify-content:center; padding:24px; box-sizing:border-box; animation:mc-fade .18s ease; }
.memo-contact-card { position:relative; width:100%; max-width:340px; background:var(--card-bg,#fff); border-radius:18px; padding:16px 16px 18px; box-shadow:0 12px 40px rgba(0,0,0,.22); animation:mc-pop .22s cubic-bezier(.2,.8,.3,1); }
.mc-head { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
.mc-av { width:40px; height:40px; border-radius:50%; background:#e8e8e8 center/cover no-repeat; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:17px; font-weight:600; color:#fff; }
.mc-av.ph { background:linear-gradient(135deg,#7c8ea8,#5c7090); }
.mc-name { font-size:15px; font-weight:600; color:var(--ink,#222); }
.mc-bubble { background:rgba(74,159,212,.12); border-radius:14px; padding:12px 14px; font-size:15px; line-height:1.5; color:var(--ink,#222); word-break:break-word; white-space:pre-wrap; border-top-left-radius:4px; }
.mc-close { position:absolute; top:10px; right:10px; width:26px; height:26px; border:none; background:rgba(0,0,0,.05); border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--ink-soft,#999); -webkit-tap-highlight-color:transparent; }
.mc-close svg { width:13px; height:13px; }
.mc-close:active { background:rgba(0,0,0,.1); }
@keyframes mc-fade { from { opacity:0; } to { opacity:1; } }
@keyframes mc-pop { from { transform:scale(.92); opacity:0; } to { transform:scale(1); opacity:1; } }
.narc-scroll { flex:1; overflow-y:auto; box-sizing:border-box; padding:12px 14px 120px; scrollbar-width:none; -ms-overflow-style:none; }
.narc-scroll::-webkit-scrollbar { display:none; }
.narc-chips { display:flex; gap:8px; overflow-x:auto; padding:2px 2px 12px; scrollbar-width:none; }
.narc-chips::-webkit-scrollbar { display:none; }
.narc-chip { flex-shrink:0; display:inline-flex; align-items:center; height:32px; padding:0 16px; border-radius:18px;
background:var(--card-bg); border:1px solid var(--card-border); color:var(--soft-ink,#555);
font-size:13px; font-family:inherit; cursor:pointer; -webkit-tap-highlight-color:transparent; }
.narc-chip.on { background:var(--ink); border-color:var(--ink); color:#fff; font-weight:700; }
.narc-addchip { background:none; border-style:dashed; color:var(--soft-ink,#777); }
.narc-ai-note { margin:0 2px 10px; padding:8px 12px; border-radius:12px; background:var(--card-bg); border:1px dashed var(--card-border); font-size:11.5px; color:var(--muted,#999); line-height:1.6; }
.narc-hero { border-radius:16px; padding:16px 16px 14px; background:var(--card-bg); border:1px solid var(--card-border); }
.narc-hero-top { display:flex; align-items:baseline; justify-content:space-between; gap:10px; }
.narc-name { font-size:19px; font-weight:800; color:var(--ink); }
.narc-days { font-size:12px; color:var(--soft-ink,#888); }
.narc-hero-sub { margin-top:3px; font-size:11.5px; color:var(--muted,#999); }
.narc-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:14px; }
.narc-stat { text-align:center; padding:10px 4px 9px; border-radius:12px; background:rgba(0,0,0,.03); }
.narc-stat b { display:block; font-size:17px; color:var(--ink); line-height:1.1; }
.narc-stat span { display:block; margin-top:3px; font-size:10.5px; color:var(--soft-ink,#888); }
.narc-recent { margin-top:12px; padding:11px 13px; border-radius:12px; background:rgba(0,0,0,.03); font-size:12.5px; color:var(--soft-ink,#666); line-height:1.6; }
.narc-recent b { color:var(--ink); font-weight:800; }
.narc-recent .nr-date { font-size:11px; color:var(--muted,#aaa); margin-left:6px; }
.narc-nav { display:flex; gap:8px; overflow-x:auto; padding:14px 2px 12px; scrollbar-width:none; }
.narc-nav::-webkit-scrollbar { display:none; }
.narc-navchip { flex-shrink:0; padding:6px 14px; border-radius:16px; font-size:13px; color:var(--soft-ink,#555);
background:var(--card-bg); border:1px solid var(--card-border); cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-navchip.on { background:var(--ink); border-color:var(--ink); color:#fff; font-weight:700; }
.narc-sect { display:flex; align-items:center; justify-content:space-between; gap:8px; margin:2px 2px 10px; }
.narc-sect h3 { margin:0; font-size:15px; font-weight:800; color:var(--ink); }
.narc-sect-sub { font-size:11px; color:var(--muted,#999); }
.narc-add { border:none; background:none; color:var(--ink); font-size:13px; font-weight:700; padding:6px 2px; cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-add:active { opacity:.5; }
.narc-empty { text-align:center; color:var(--soft-ink,#aaa); font-size:13px; line-height:1.9; padding:30px 8px 10px; }
.narc-empty .ne-btn { display:inline-block; margin-top:10px; padding:8px 18px; border-radius:18px; background:var(--ink); color:#fff; font-size:13px; font-weight:700; border:none; cursor:pointer; font-family:inherit; }
.narc-empty .ne-btn.ghost { background:none; color:var(--soft-ink,#777); border:1px dashed var(--card-border); }
.narc-k { border-radius:14px; padding:13px 13px 9px; background:var(--card-bg); border:1px solid var(--card-border); margin-bottom:10px; }
.narc-k.retired { opacity:.58; }
.nk-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.nk-type { font-size:12px; font-weight:800; color:var(--soft-ink,#666); }
.nk-level { flex-shrink:0; font-size:11px; color:var(--soft-ink,#666); background:rgba(0,0,0,.05); border-radius:12px; padding:3px 9px; }
.narc-k.retired .nk-level { background:none; }
.nk-text { margin-top:7px; font-size:16px; line-height:1.5; color:var(--ink); white-space:pre-wrap; word-break:break-word; }
.nk-why { margin-top:7px; font-size:12.5px; color:var(--muted,#999); line-height:1.5; }
.nk-why::before { content:'为什么认为　'; color:var(--muted,#aaa); }
.nk-meta { margin-top:8px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
.nk-date { font-size:11px; color:var(--muted,#aaa); }
.nk-ops { display:flex; gap:14px; }
.nk-op { border:none; background:none; padding:2px 0; font-size:12px; color:var(--soft-ink,#888); cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.nk-op.warn { color:#c9665e; }
.nk-op:active { opacity:.5; }
.narc-note { margin-top:8px; padding-top:8px; border-top:1px dashed var(--card-border); font-size:12px; color:var(--muted,#999); line-height:1.5; }
.narc-btabs { display:flex; gap:8px; margin:0 2px 12px; }
.narc-btab { padding:5px 12px; border-radius:14px; font-size:12.5px; color:var(--soft-ink,#666); background:var(--card-bg); border:1px solid var(--card-border); cursor:pointer; font-family:inherit; }
.narc-btab.on { background:var(--ink); border-color:var(--ink); color:#fff; font-weight:700; }
.narc-item { border-radius:14px; padding:11px 13px 8px; background:var(--card-bg); border:1px solid var(--card-border); margin-bottom:10px; }
.ni-top { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.ni-star { flex-shrink:0; font-size:15px; line-height:1; color:var(--muted,#ccc); background:none; border:none; padding:2px; cursor:pointer; }
.ni-star.on { color:#f4b83a; }
.ni-text { margin-top:6px; font-size:15px; line-height:1.5; color:var(--ink); white-space:pre-wrap; word-break:break-word; }
.ni-why { margin-top:6px; font-size:12.5px; color:var(--muted,#999); line-height:1.5; white-space:pre-wrap; }
.ni-meta { margin-top:8px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
.ni-date { font-size:11px; color:var(--muted,#aaa); }
.ni-tag { font-size:10.5px; color:#4a9fd4; background:rgba(74,159,212,.12); border-radius:10px; padding:2px 8px; }
.narc-flag { flex-shrink:0; font-size:10px; color:#4a9fd4; background:rgba(74,159,212,.12); border-radius:10px; padding:2px 8px; line-height:1.4; }
.narc-item.solved { opacity:.55; }
.narc-hist { display:flex; gap:8px; margin-bottom:12px; }
.narc-hist .nh-dot { flex-shrink:0; width:8px; height:8px; border-radius:50%; background:var(--ink); margin-top:6px; }
.narc-hist .nh-wrap { flex:1; min-width:0; }
.narc-hist .nh-date { font-size:11px; color:var(--muted,#aaa); }
.narc-hist .nh-text { font-size:13.5px; color:var(--soft-ink,#555); line-height:1.5; margin-top:2px; }
.narc-hist .nh-text em { font-style:normal; color:var(--ink); font-weight:700; }
.narc-menu { margin-top:14px; border-radius:16px; background:var(--card-bg); border:1px solid var(--card-border); overflow:hidden; }
.narc-mrow { display:flex; align-items:center; gap:10px; width:100%; padding:13px 14px; background:none; border:none; border-top:1px solid var(--card-border);
cursor:pointer; font-family:inherit; text-align:left; -webkit-tap-highlight-color:transparent; }
.narc-mrow:first-child { border-top:none; }
.narc-mrow:active { background:rgba(0,0,0,.03); }
.nm-main { flex:1; min-width:0; display:block; }
.nm-title { display:flex; align-items:center; gap:6px; font-size:14.5px; font-weight:700; color:var(--ink); line-height:1.3; }
.nm-core { flex-shrink:0; font-style:normal; font-size:10px; padding:1px 7px; border-radius:8px; background:var(--ink); color:#fff; font-weight:600; }
.nm-desc { display:block; margin-top:2px; font-size:11px; color:var(--muted,#999); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.nm-count { flex-shrink:0; min-width:22px; text-align:center; font-size:11px; color:var(--soft-ink,#999); background:rgba(0,0,0,.05); padding:3px 8px; border-radius:10px; }
.nm-arrow { flex-shrink:0; color:var(--muted,#bbb); font-size:15px; }
.narc-backrow { margin:2px 0 12px; }
.narc-backhome { border:none; background:none; padding:4px 2px; font-size:13px; font-weight:700; color:var(--soft-ink,#777);
cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-backhome:active { opacity:.5; }
.narc-ghead { margin:16px 2px 8px; font-size:12.5px; font-weight:800; color:var(--soft-ink,#888); letter-spacing:.04em; }
.narc-menu + .narc-ghead, .narc-fields + .narc-ghead { margin-top:18px; }
.narc-gsub { font-weight:400; letter-spacing:0; font-size:11px; color:var(--muted,#aaa); margin-left:6px; }
.narc-fields { border-radius:14px; background:var(--card-bg); border:1px solid var(--card-border); overflow:hidden; }
.narc-frow { display:flex; align-items:flex-start; gap:10px; width:100%; padding:11px 13px; background:none; border:none;
border-top:1px solid var(--card-border); cursor:pointer; text-align:left; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-frow:first-child { border-top:none; }
.narc-frow:active { background:rgba(0,0,0,.03); }
.nf-label { flex-shrink:0; width:88px; font-size:12.5px; color:var(--soft-ink,#777); padding-top:1px; }
.nf-val { flex:1; min-width:0; font-size:13.5px; color:var(--ink); line-height:1.55; word-break:break-word; white-space:pre-wrap; }
.nf-val.empty { color:var(--muted,#bcbcbc); }
.nf-edit { flex-shrink:0; color:var(--muted,#c0c0c0); font-size:14px; padding-top:1px; }
.nk-type { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.nk-src { flex-shrink:0; font-size:10px; padding:2px 7px; border-radius:8px; background:rgba(74,159,212,.12); color:#4a9fd4; }
.nk-dots { flex-shrink:0; font-size:11px; letter-spacing:2px; color:var(--ink); opacity:.72; }
.ni-cat { flex-shrink:0; font-size:10px; color:var(--soft-ink,#777); background:rgba(0,0,0,.05); border-radius:8px; padding:2px 8px; }
.narc-btabs { flex-wrap:wrap; row-gap:8px; }
.narc-addrow { margin:0 2px 10px; text-align:right; }
.narc-tools { display:flex; gap:8px; margin-top:14px; }
.narc-tool { flex:1; padding:10px 0; border-radius:12px; background:var(--card-bg); border:1px solid var(--card-border);
font-size:13px; font-weight:700; color:var(--soft-ink,#555); cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-tool:active { opacity:.55; }
.narc-sect-btns { display:flex; align-items:center; gap:2px; flex-shrink:0; }
.narc-copy { border:none; background:none; color:var(--soft-ink,#999); font-size:12px; padding:6px 6px; cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-copy:active { opacity:.5; }
.narc-tabmg { border-style:dashed; color:var(--muted,#aaa); }
.ni-img { display:block; width:100%; max-height:220px; object-fit:cover; border-radius:10px; margin-top:8px; }
.ni-quote { font-size:15.5px; }
.narc-search { margin:0 2px 12px; }
.narc-hint { margin:6px 2px 0; font-size:11px; line-height:1.7; color:var(--muted,#aaa); }
.narc-q { width:100%; box-sizing:border-box; padding:11px 14px; border-radius:12px; border:1px solid var(--card-border);
background:var(--card-bg); color:var(--ink); font-size:14px; font-family:inherit; outline:none; }
.narc-q::placeholder { color:var(--muted,#bbb); }
.narc-sr { display:block; width:100%; box-sizing:border-box; text-align:left; padding:11px 13px; margin-bottom:8px;
border-radius:12px; background:var(--card-bg); border:1px solid var(--card-border); cursor:pointer; font-family:inherit; -webkit-tap-highlight-color:transparent; }
.narc-sr:active { background:rgba(0,0,0,.03); }
.nsr-head { display:block; font-size:11px; color:#4a9fd4; }
.nsr-text { display:block; margin-top:3px; font-size:13.5px; color:var(--ink); line-height:1.5; word-break:break-word; }
#page-room { overflow: hidden; }
.room-stage {
flex: 1; display: flex; flex-direction: column; gap: 10px;
padding: 10px 14px calc(12px + var(--mochi-safe-bottom,env(safe-area-inset-bottom,0px)));
min-height: 0;
overflow-y: auto; overscroll-behavior: auto;
scrollbar-width: none; -ms-overflow-style: none;
}
.room-stage::-webkit-scrollbar { display: none; }
.r-hud { display: flex; flex-wrap: wrap; gap: 6px; }
.r-chip {
position: relative;
font-size: 11px; color: var(--ink); opacity: .85;
background: var(--glass-bg, rgba(255,255,255,.55));
border: 1px solid rgba(0,0,0,.06); border-radius: 999px;
padding: 4px 10px;
}
.r-fly {
position: absolute; top: -13px; right: 4px; z-index: 5;
font-size: 11.5px; font-weight: 800; color: #c08a1e;
text-shadow: 0 1px 0 rgba(255,255,255,.7);
pointer-events: none;
animation: rFly .82s ease-out forwards;
}
@keyframes rFly { from { transform: translateY(2px); opacity: 1; } to { transform: translateY(-17px); opacity: 0; } }
.r-scene {
position: relative; flex: none;
height: clamp(238px, 54vw, 330px);
border-radius: 16px; overflow: hidden;
box-shadow: 0 10px 28px rgba(60,45,25,.16), 0 2px 6px rgba(0,0,0,.08);
transform: translateZ(0);
transition: filter .6s ease;
}
.r-scene {
filter: saturate(calc(var(--room-bright, 1) * .86 + .14)) brightness(max(var(--room-bright, 1), .45));
}
.r-wall {
position: absolute; left: 0; right: 0; top: 0; height: 44%;
transition: filter .6s ease;
}
.r-floor {
position: absolute; left: 0; right: 0; top: 44%; bottom: 0;
transition: filter .6s ease;
}
.wall-cream  { background: linear-gradient(#f7f0e2, #eee3cf); }
.wall-cloud  { background: radial-gradient(60px 26px at 22% 68%, #fff 55%, transparent 56%), radial-gradient(80px 30px at 72% 30%, #fff 55%, transparent 56%), linear-gradient(#dcebfb, #eef5fe); }
.wall-cabin  { background: repeating-linear-gradient(180deg, #caa06b 0 12px, #bd9160 12px 14px, #c39a67 14px 26px, #b98d5c 26px 28px); }
.wall-gardenw{ background: radial-gradient(7px 7px at 12% 30%, #f9a8c5 46%, transparent 50%), radial-gradient(6px 6px at 34% 66%, #f9a8c5 46%, transparent 50%), radial-gradient(7px 7px at 58% 24%, #ffd479 46%, transparent 50%), radial-gradient(6px 6px at 82% 60%, #f9a8c5 46%, transparent 50%), radial-gradient(5px 5px at 70% 84%, #fff 46%, transparent 50%), linear-gradient(#e4f4dd, #f0faea); }
.wall-starw  { background: radial-gradient(1.6px 1.6px at 14% 26%, #fff 50%, transparent 52%), radial-gradient(1.4px 1.4px at 32% 64%, #ffe9b8 50%, transparent 52%), radial-gradient(1.8px 1.8px at 55% 20%, #fff 50%, transparent 52%), radial-gradient(1.3px 1.3px at 74% 52%, #cfe4ff 50%, transparent 52%), radial-gradient(1.7px 1.7px at 88% 30%, #fff 50%, transparent 52%), radial-gradient(1.2px 1.2px at 44% 82%, #fff 50%, transparent 52%), linear-gradient(#232c54, #171d3c); }
.wall-nightw { background: linear-gradient(#2b3050, #191c33); }
.wall-stripe { background: repeating-linear-gradient(90deg, #faf3e6 0 26px, #f2e5d0 26px 52px); }
.wall-dusk   { background: linear-gradient(#f6c99f 0%, #e79a9e 38%, #8f7bb8 72%, #5d5a93 100%); }
.wall-checkerw{ background: conic-gradient(#efe3d2 25%, #e0cdb2 0 50%, #efe3d2 0 75%, #e0cdb2 0) 0 0/44px 44px; }
.r-wall::after {
content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 4px;
background: linear-gradient(rgba(74,56,34,.42), rgba(74,56,34,.24));
border-radius: 1px;
}
.wall-starw::after, .wall-nightw::after { background: linear-gradient(rgba(12,14,30,.75), rgba(12,14,30,.45)); }
.wall-starw::before {
content: ''; position: absolute; inset: 0; pointer-events: none;
background:
radial-gradient(2px 2px at 22% 38%, #fff 50%, transparent 55%),
radial-gradient(1.6px 1.6px at 62% 62%, #fff8dc 50%, transparent 55%),
radial-gradient(2.2px 2.2px at 84% 18%, #fff 50%, transparent 55%);
animation: rTwinkle 2.6s ease-in-out infinite alternate;
}
@keyframes rTwinkle { from { opacity: .25; } to { opacity: 1; } }
.floor-wood   { background: repeating-linear-gradient(90deg, #dcbd8e 0 15.8%, #d0ae7d 15.8% 16%, #d5b483 16% 33%, #c9a673 33% 33.2%); background-size: 100% 100%; }
.floor-light  { background: linear-gradient(#eef0f4, #e4e8ee); }
.floor-carpet { background: radial-gradient(120% 140% at 50% 0%, #f2dade 60%, #e9cbD2 61%); }
.floor-stone  { background: conic-gradient(#cfd3d8 25%, #c2c7cd 0 50%, #cfd3d8 0 75%, #c2c7cd 0) 0 0/34% 50%; }
.r-scene.night .r-wall { filter: brightness(.52) saturate(.85); }
.r-scene.night .r-floor { filter: brightness(.55) saturate(.85); }
.r-scene.night .wall-starw, .r-scene.night .wall-nightw { filter: brightness(.8); }
.r-scene.night.r-manual-light .r-wall,
.r-scene.night.r-manual-light .r-floor { filter: none; transition: none; }
.r-scene.r-manual-light.room-in { animation: none; }
.r-scene.r-manual-light { transition: none; }
.r-brightness { display: flex; align-items: center; gap: 8px; flex: none; min-width: 0; color: var(--ink); font-size: 12px; }
.r-brightness label { flex: none; }
.r-brightness output { display: inline-block; min-width: 34px; }
.r-brightness input[type="range"] { flex: 1; min-width: 0; width: 0; height: 32px; padding: 0; accent-color: var(--ink); }
.r-brightness button { flex: none; min-height: 32px; padding: 4px 8px; color: var(--ink); background: var(--glass-bg, rgba(255,255,255,.55)); border: 1px solid var(--card-border); border-radius: 8px; }
.r-brightness button:disabled { opacity: .5; }
.r-door {
position: absolute; left: 3.5%; top: 8%;
width: 17%; height: 84%;
background: linear-gradient(#a97c4f, #96693f);
border: 2px solid #7d5732; border-radius: 8px 8px 0 0;
box-shadow: inset 0 0 0 3px rgba(255,255,255,.08);
}
.r-door::after {
content: ''; position: absolute; right: 7px; top: 48%;
width: 6px; height: 6px; border-radius: 50%; background: #f4d98b;
}
.r-window {
position: absolute; top: 12%;
width: 21%; height: 66%;
border-radius: 8px;
border: 3px solid rgba(255,255,255,.75);
background: linear-gradient(#bfe0f8, #e8f4fd);
box-shadow: 0 2px 6px rgba(0,0,0,.12), inset 0 0 0 1px rgba(0,0,0,.06);
overflow: hidden;
}
.r-window.wa { left: 30%; }
.r-window.wb { right: 6%; }
.r-window.nw { background: linear-gradient(#1c2748, #31406e); border-color: rgba(210,220,255,.35); }
.r-sky {
position: absolute; inset: 0;
display: flex; align-items: center; justify-content: center;
font-size: 17px;
}
.r-window.wb::before, .r-window.wa::before {
content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px;
margin-left: -1px; background: rgba(255,255,255,.7);
}
.r-window::after {
content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px;
margin-top: -1px; background: rgba(255,255,255,.7);
}
.r-window.nw .r-sky::after {
content: ''; position: absolute; top: 22%; left: -34%;
width: 36%; height: 2px; border-radius: 1px;
background: linear-gradient(90deg, transparent, #fff);
transform: rotate(-22deg); opacity: 0;
animation: rMeteor 7s linear infinite;
}
.r-window.wb.nw .r-sky::after { animation-delay: 3.4s; }
@keyframes rMeteor {
0% { transform: rotate(-22deg) translateX(0); opacity: 0; }
5% { opacity: .95; }
11% { transform: rotate(-22deg) translateX(450%); opacity: 0; }
100% { transform: rotate(-22deg) translateX(450%); opacity: 0; }
}
.r-scene.raining .r-sky::before {
content: ''; position: absolute; left: 0; right: 0; top: -120%; height: 340%;
background: repeating-linear-gradient(172deg, transparent 0 8px, rgba(205,228,250,.85) 8px 9.5px);
animation: rRainfall .55s linear infinite;
pointer-events: none;
}
@keyframes rRainfall { to { transform: translateY(29.4%); } }
.r-cell { position: absolute; box-sizing: border-box; border-radius: 6px; }
.r-cell:hover { background: rgba(255,255,255,.18); }
.r-scene.placing .r-cell.ok {
outline: 1.5px solid rgba(96,168,96,.65); outline-offset: -3px;
}
.r-scene.placing .r-cell.ok::before {
content: ''; position: absolute; inset: 0; border-radius: inherit;
background: rgba(122,200,122,.28); opacity: .29; pointer-events: none;
animation: rBreath 1.6s ease-in-out infinite;
}
.r-scene.placing .r-cell.bad {
outline: 1.5px solid rgba(150,140,130,.35); outline-offset: -3px;
background: rgba(120,110,100,.10);
}
.r-scene.placing .r-cell.tgt {
outline: 2px solid rgba(80,170,90,.85); outline-offset: -3px;
background: rgba(110,200,110,.26);
animation: none;
}
.r-scene.placing .r-cell.tgt::before { animation: none; } @keyframes rBreath { 0%,100% { opacity: .29; } 50% { opacity: 1; } } .r-furn {
position: absolute; z-index: 5;
transform: translate(-50%, -92%);
font-size: clamp(24px, 7vw, 34px);
line-height: 1; cursor: pointer; user-select: none; -webkit-user-select: none;
-webkit-touch-callout: none; touch-action: none;
filter: drop-shadow(0 4px 3px rgba(40,30,15,.25));
transition: filter .3s ease;
}
.r-furn::before {
content: ''; position: absolute; left: 50%; bottom: -5px; z-index: -1;
width: 74%; height: 9px; transform: translateX(-50%);
background: radial-gradient(ellipse at center, rgba(60,45,20,.30), transparent 68%);
border-radius: 50%;
}
.r-furn:active { transform: translate(-50%, -86%); }
.r-furn.r-flip { transform: translate(-50%, -92%) scaleX(-1); }
.r-furn.r-flip:active { transform: translate(-50%, -86%) scaleX(-1); }
.r-furn.r-lit { filter: drop-shadow(0 4px 3px rgba(40,30,15,.25)) drop-shadow(0 0 9px rgba(255,208,112,.95)); }
.r-furn.r-lit.r-flkc { animation: rFlicker 1.7s ease-in-out infinite; }
@keyframes rFlicker { 0%,100% { opacity: 1; } 45% { opacity: .82; } 62% { opacity: .92; } }
.r-furn.dragging { z-index: 12; opacity: .88; cursor: grabbing; filter: drop-shadow(0 10px 8px rgba(40,30,15,.32)) drop-shadow(0 0 6px rgba(255,220,150,.5)); }
.r-pool {
position: absolute; z-index: 3; pointer-events: none;
width: 74px; height: 44px; transform: translate(-50%, -50%);
background: radial-gradient(ellipse at center, rgba(255,196,100,.38) 0%, rgba(255,196,100,.16) 46%, transparent 72%);
animation: rPoolIn .5s ease-out;
}
.r-pool-f { animation: rPoolIn .5s ease-out, rFlicker 1.7s ease-in-out infinite; }
@keyframes rPoolIn { from { opacity: 0; transform: translate(-50%, -50%) scale(.6); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
.r-bloom {
position: absolute; top: -9px; right: -7px;
font-size: 13px; text-decoration: none; line-height: 1;
animation: rBloomPop .5s cubic-bezier(.2,1.6,.4,1);
}
@keyframes rBloomPop { from { transform: scale(0) rotate(-40deg); } to { transform: scale(1) rotate(0); } }
#room-ta {
position: absolute; z-index: 7;
width: 44px; height: 50px;
transform: translate(-50%, -96%);
transition: left .68s ease, top .68s ease;
cursor: pointer;
}
.r-ta-glow {
position: absolute; left: 50%; top: 58%;
width: 46px; height: 46px; transform: translate(-50%, -50%);
border-radius: 50%;
background: radial-gradient(circle, rgba(255,222,150,.55) 0%, rgba(255,222,150,.18) 45%, transparent 70%);
animation: rGlow 3.2s ease-in-out infinite;
pointer-events: none;
}
@keyframes rGlow { 0%,100% { opacity: .75; } 50% { opacity: 1; } }
.r-ta-av {
position: absolute; left: 50%; top: 0;
width: 44px; height: 44px; transform: translateX(-50%) translateZ(0);
border-radius: 50%;
background-color: #efe6d6; background-size: cover; background-position: center;
box-shadow: 0 0 0 2px rgba(255,255,255,.75), 0 2px 6px rgba(0,0,0,.18);
pointer-events: none;
}
.r-ta-av.r-ta-sil {
background: linear-gradient(160deg, rgba(90,84,110,.85), rgba(60,58,86,.85));
}
#room-ta.r-faint .r-ta-av { opacity: .16; filter: blur(1.5px) grayscale(.5); }
#room-ta.r-faint .r-ta-glow { animation-duration: 5s; background: radial-gradient(circle, rgba(200,205,255,.4) 0%, rgba(200,205,255,.12) 45%, transparent 70%); }
#room-ta.walking .r-ta-av { animation: rBob .46s ease-in-out infinite; }
#room-ta.walking .r-ta-glow { animation-duration: 1.6s; }
@keyframes rBob { 0%,100% { transform: translateX(-50%) translateZ(0); } 50% { transform: translateX(-50%) translateY(-4px) translateZ(0); } }
#room-ta.seated .r-ta-av { width: 37px; height: 37px; margin-top: 7px; }
#room-ta.seated .r-ta-glow { width: 40px; height: 40px; top: 62%; }
.r-scene.room-in { animation: roomIn .95s ease-out; }
@keyframes roomIn { from { filter: brightness(.32); } to { filter: brightness(1); } }
.r-fete {
position: absolute; inset: 0; z-index: 20;
pointer-events: none; overflow: hidden; border-radius: inherit;
background: radial-gradient(circle at 50% 42%, rgba(255,240,198,.28), transparent 62%);
}
.r-fete-t {
position: absolute; top: 34%; left: 50%;
transform: translate(-50%, -50%);
font-size: 19px; font-weight: 800; color: #7a5a1e;
text-shadow: 0 1px 0 #fff, 0 0 16px rgba(255,215,130,.95);
white-space: nowrap;
animation: rFeteT 2.4s ease forwards;
}
@keyframes rFeteT {
0% { opacity: 0; transform: translate(-50%, -50%) scale(.55); }
14% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
78% { opacity: 1; }
100% { opacity: 0; transform: translate(-50%, -62%) scale(1); }
}
.r-fete i {
position: absolute; bottom: -24px; line-height: 1; opacity: 0;
animation: rFeteStar 1.9s ease-in forwards;
}
@keyframes rFeteStar {
0% { transform: translateY(0) rotate(0); opacity: 0; }
14% { opacity: 1; }
100% { transform: translateY(-270px) rotate(48deg); opacity: 0; }
}
.r-bubble {
position: absolute; z-index: 9; top: 8px; left: 50%;
transform: translateX(-50%);
max-width: 76%;
background: rgba(255,255,255,.94); color: #333;
border: 1px solid rgba(0,0,0,.07); border-radius: 12px;
padding: 7px 12px; font-size: 12.5px; line-height: 1.5;
box-shadow: 0 4px 12px rgba(0,0,0,.12);
white-space: pre-wrap; word-break: break-word;
pointer-events: none;
}
.r-bubble.pop { animation: rPop .28s ease; }
@keyframes rPop { from { transform: translateX(-50%) scale(.85); opacity: 0; } to { transform: translateX(-50%) scale(1); opacity: 1; } }
.r-banner {
position: absolute; z-index: 10; bottom: 8px; left: 50%;
transform: translateX(-50%);
display: flex; align-items: center; gap: 8px;
max-width: 92%;
background: rgba(28,26,22,.82); color: #fff;
border-radius: 999px; padding: 7px 8px 7px 14px;
font-size: 12px; white-space: nowrap;
}
.r-banner span { overflow: hidden; text-overflow: ellipsis; }
.r-banner button {
border: 0; border-radius: 999px; padding: 4px 12px;
font-size: 12px; background: rgba(255,255,255,.92); color: #333; font-weight: 600;
}
.r-banner[hidden] { display: none; }
.r-status {
text-align: center; font-size: 12.5px; color: var(--ink); opacity: .72;
min-height: 18px;
}
.r-sense-out {
white-space: pre-line;
font-size: 12.5px; line-height: 1.7; color: var(--ink);
background: var(--glass-bg, rgba(255,255,255,.55));
border: 1px solid rgba(0,0,0,.06); border-radius: 12px;
padding: 10px 12px; }
.r-bar { display: flex; gap: 8px; }
.r-bar button {
flex: 1; border: 0; border-radius: 14px;
padding: 11px 0; font-size: 13.5px; font-weight: 600;
background: var(--glass-bg, rgba(255,255,255,.66));
color: var(--ink);
border: 1px solid rgba(0,0,0,.06);
box-shadow: 0 2px 8px rgba(0,0,0,.06);
cursor: pointer;
}
.r-bar button:active { transform: translateY(1px); }
@media (prefers-reduced-motion: reduce) {
#page-room *,
#page-room *::before,
#page-room *::after {
animation-duration: .01ms !important;
animation-iteration-count: 1 !important;
transition-duration: .01ms !important;
}
}
[data-theme="dark"] .r-chip,
[data-theme="dark"] .r-sense-out,
[data-theme="dark"] .r-bar button { color: #eee; background: rgba(40,40,48,.66); border-color: rgba(255,255,255,.08); }
#page-drift { overflow: hidden; }
.drift-scroll {
flex: 1; overflow-y: auto;
display: flex; flex-direction: column; gap: 10px;
padding: 10px 14px calc(16px + var(--mochi-safe-bottom,env(safe-area-inset-bottom,0px)));
min-height: 0;
}
.drift-sea {
position: relative; flex: none;
height: clamp(180px, 46vw, 250px);
border-radius: 16px; overflow: hidden;
background: linear-gradient(#bfe3f7 0%, #d9f0fa 52%, #eaf7fc 100%);
box-shadow: 0 10px 28px rgba(40,80,110,.14), 0 2px 6px rgba(0,0,0,.06);
}
.drift-sea.night { background: linear-gradient(#1c2748 0%, #24335c 48%, #31507a 100%); }
.ds-moon {
position: absolute; top: 12%; right: 12%;
font-size: 26px; line-height: 1;
filter: drop-shadow(0 0 8px rgba(255,240,190,.85));
animation: dsGlow 3.6s ease-in-out infinite alternate;
opacity: 0; transition: opacity .8s ease;
}
.drift-sea.night .ds-moon { opacity: 1; }
.ds-sun {
position: absolute; top: 12%; right: 13%;
font-size: 22px; line-height: 1;
opacity: .9; transition: opacity .8s ease;
}
.drift-sea.night .ds-sun { opacity: 0; }
@keyframes dsGlow { from { transform: translateY(0); } to { transform: translateY(-3px); } }
.ds-cloud {
position: absolute; font-size: 17px; opacity: .75;
animation: dsCloud 26s linear infinite;
}
.drift-sea.night .ds-cloud { opacity: .28; }
.ds-cloud.c1 { top: 16%; left: -30px; animation-duration: 30s; }
.ds-cloud.c2 { top: 34%; left: 55%; animation-duration: 38s; animation-delay: -14s; }
@keyframes dsCloud { from { transform: translateX(0); } to { transform: translateX(120px); } }
.ds-wave {
position: absolute; left: 0; right: 0; bottom: 0; pointer-events: none;
}
.ds-wave.w1 {
height: 42%;
background:
radial-gradient(22px 11px at 11px 3px, rgba(255,255,255,.55) 46%, transparent 52%) repeat-x,
linear-gradient(rgba(96,168,214,.92), rgba(64,132,188,.96));
background-size: 44px 14px, auto;
border-radius: 10px 10px 0 0;
animation: dsWave1 6.5s linear infinite;
}
.ds-wave.w2 {
height: 32%;
background:
radial-gradient(18px 9px at 9px 2px, rgba(255,255,255,.4) 46%, transparent 52%) repeat-x,
linear-gradient(rgba(58,128,182,.95), rgba(38,102,156,1));
background-size: 36px 11px, auto;
animation: dsWave2 9.5s linear infinite reverse;
}
.drift-sea.night .ds-wave.w1 { background-image: radial-gradient(22px 11px at 11px 3px, rgba(210,228,255,.28) 46%, transparent 52%), linear-gradient(rgba(43,74,122,.95), rgba(30,56,100,1)); background-size: 44px 14px, auto; }
.drift-sea.night .ds-wave.w2 { background-image: radial-gradient(18px 9px at 9px 2px, rgba(200,220,255,.18) 46%, transparent 52%), linear-gradient(rgba(26,46,84,1), rgba(18,32,62,1)); background-size: 36px 11px, auto; }
@keyframes dsWave1 { to { background-position: 88px 3px, 0 0; } }
@keyframes dsWave2 { to { background-position: -72px 2px, 0 0; } }
.ds-bob {
position: absolute; z-index: 5;
left: 50%; bottom: 26%;
font-size: 30px; line-height: 1;
filter: drop-shadow(0 4px 3px rgba(20,50,80,.3));
animation: dsBob 3.2s ease-in-out infinite;
transition: none;
pointer-events: none;
}
@keyframes dsBob {
0%, 100% { transform: translate(-50%, 0) rotate(-7deg); }
50% { transform: translate(-50%, -7px) rotate(6deg); }
}
.ds-bob.d-arrive { animation: dsArrive 1.7s ease-in-out; }
@keyframes dsArrive {
0% { left: 8%; bottom: 20%; transform: rotate(-14deg); }
55% { left: 58%; bottom: 30%; transform: rotate(4deg); }
100% { left: 50%; bottom: 26%; transform: rotate(-7deg); }
}
.ds-cap {
position: absolute; z-index: 6; left: 0; right: 0; bottom: 7px;
text-align: center; font-size: 11px; letter-spacing: .12em;
color: rgba(255,255,255,.85); text-shadow: 0 1px 2px rgba(20,60,90,.45);
pointer-events: none;
}
.d-actions { display: flex; gap: 10px; flex: none; }
.d-pick {
flex: 1.6; border: 0; border-radius: 999px;
padding: 13px 0; font-size: 15px; font-weight: 700; letter-spacing: .08em;
color: #fff; cursor: pointer;
background: linear-gradient(135deg, #5aa7dd, #3f7fc0);
box-shadow: 0 6px 16px rgba(63,127,192,.35);
}
.d-pick:active { transform: translateY(1px); }
.d-pick:disabled { opacity: .55; box-shadow: none; cursor: default; }
.d-put {
flex: 1; border: 1px solid rgba(0,0,0,.08); border-radius: 999px;
padding: 13px 0; font-size: 13.5px; font-weight: 600;
color: var(--ink); cursor: pointer;
background: var(--glass-bg, rgba(255,255,255,.66));
box-shadow: 0 2px 8px rgba(0,0,0,.06);
}
.d-put:active { transform: translateY(1px); }
.d-open { flex: none; padding: 14px 14px 12px; }
.d-open.pop { animation: dOpenPop .34s cubic-bezier(.2,1.4,.4,1); }
@keyframes dOpenPop { from { transform: scale(.92) translateY(8px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
.do-head { font-size: 13px; font-weight: 700; color: var(--ink); opacity: .85; margin-bottom: 10px; }
.do-paper {
background:
repeating-linear-gradient(0deg, transparent 0 25px, rgba(120,160,200,.16) 25px 26px),
linear-gradient(#fffdf6, #fbf6ea);
border: 1px solid rgba(150,130,90,.22);
border-radius: 10px;
padding: 13px 14px 11px;
box-shadow: inset 0 1px 3px rgba(120,90,40,.08);
}
.do-txt {
font-size: 14.5px; line-height: 27px; color: #4a4237;
word-break: break-word; white-space: pre-wrap;
}
.do-sig { margin-top: 6px; text-align: right; font-size: 12px; color: #9a8b70; }
.do-extra { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.do-gift, .do-coin {
font-size: 11.5px; padding: 3px 10px; border-radius: 999px;
background: var(--glass-bg, rgba(255,255,255,.6));
border: 1px solid rgba(0,0,0,.06); color: var(--ink); opacity: .9;
}
.do-coin { color: #b07a12; border-color: rgba(176,122,18,.3); }
.do-btns { display: flex; gap: 8px; margin-top: 12px; }
.do-btns button {
flex: 1; border: 0; border-radius: 12px; padding: 10px 0;
font-size: 13px; font-weight: 600; cursor: pointer;
}
.do-fav {
background: var(--glass-bg, rgba(255,255,255,.66));
color: #c0566b; border: 1px solid rgba(192,86,107,.25);
}
.do-ok { background: linear-gradient(135deg, #5aa7dd, #3f7fc0); color: #fff; }
.do-theirs {
margin-top: 10px;
border: 1px dashed rgba(90,167,221,.5);
border-radius: 10px;
padding: 10px 12px 9px;
background: rgba(90,167,221,.08);
}
.do-theirs-head { font-size: 12.5px; font-weight: 700; color: var(--ink); opacity: .85; margin-bottom: 6px; }
.do-theirs-txt { font-size: 13.5px; line-height: 1.6; color: #4a4237; word-break: break-word; white-space: pre-wrap; }
.do-theirs-sig { margin-top: 5px; text-align: right; font-size: 11.5px; color: #8a9db0; }
[data-theme="dark"] .do-theirs { background: rgba(90,150,200,.14); border-color: rgba(120,180,230,.45); }
[data-theme="dark"] .do-theirs-txt { color: #e8e2d6; }
[data-theme="dark"] .do-theirs-sig { color: #9db2c8; }
.d-stats {
flex: none; text-align: center; font-size: 11.5px; color: var(--ink); opacity: .68;
min-height: 16px;
}
.d-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
.d-tab {
border: 1px solid rgba(0,0,0,.08); border-radius: 999px;
padding: 6px 14px; font-size: 12.5px; cursor: pointer;
background: var(--glass-bg, rgba(255,255,255,.55));
color: var(--ink); opacity: .78;
}
.d-tab.sel { opacity: 1; font-weight: 700; background: rgba(90,167,221,.22); border-color: rgba(90,167,221,.5); }
.d-list { display: flex; flex-direction: column; gap: 8px; min-height: 60px; flex: none; }
.dl-empty {
text-align: center; font-size: 12px; color: var(--ink); opacity: .55;
padding: 22px 10px;
background: var(--glass-bg, rgba(255,255,255,.4));
border: 1px dashed rgba(0,0,0,.1); border-radius: 12px;
}
.dl-row {
display: flex; align-items: flex-start; gap: 10px;
padding: 10px 12px; border-radius: 12px;
border: 1px solid rgba(0,0,0,.05);
}
.dl-ico { font-size: 17px; line-height: 1.3; flex: none; }
.dl-main { flex: 1; min-width: 0; }
.dl-txt { font-size: 13px; line-height: 1.55; color: var(--ink); word-break: break-word; white-space: pre-wrap; }
.dl-sub { margin-top: 3px; font-size: 11px; color: var(--ink); opacity: .55; }
.dl-fav {
flex: none; border: 0; background: transparent; cursor: pointer;
font-size: 15px; color: #c0566b; padding: 2px 4px; line-height: 1.4;
}
[data-theme="dark"] .drift-sea { box-shadow: 0 10px 28px rgba(0,0,0,.4); }
[data-theme="dark"] .do-paper { background: linear-gradient(#efe8da, #e7dfcd); }
[data-theme="dark"] .do-txt { color: #3d3730; }
[data-theme="dark"] .do-sig { color: #7a6d55; }
[data-theme="dark"] .d-pick { background: linear-gradient(135deg, #3d6f9d, #2d5479); }
[data-theme="dark"] .d-tab,
[data-theme="dark"] .d-put,
[data-theme="dark"] .do-gift,
[data-theme="dark"] .do-fav { color: #eee; background: rgba(40,40,48,.66); border-color: rgba(255,255,255,.09); }
[data-theme="dark"] .d-tab.sel { background: rgba(90,150,200,.3); }
[data-theme="dark"] .dl-row { border-color: rgba(255,255,255,.07); background: rgba(40,40,48,.5); }
[data-theme="dark"] .dl-empty { border-color: rgba(255,255,255,.14); background: rgba(40,40,48,.4); }
[data-theme="dark"] .do-coin { color: #d9a83e; border-color: rgba(217,168,62,.35); }
@media (prefers-reduced-motion: reduce) {
#page-drift *,
#page-drift *::before,
#page-drift *::after {
animation-duration: .01ms !important;
animation-iteration-count: 1 !important;
transition-duration: .01ms !important;
}
}
.applock-mask { position: fixed; inset: 0; z-index: 999999; display: flex; align-items: center; justify-content: center; padding: 24px; background: var(--overlay-bg, rgba(0, 0, 0, .45)); }
.applock-mask.hide { display: none; }
.applock-box { width: min(320px, 88vw); max-height: 88vh; overflow-y: auto; background: var(--card-bg, #fff); border: 1px solid var(--card-border, rgba(0, 0, 0, .1)); border-radius: 20px; padding: 24px 18px 18px; text-align: center; box-shadow: 0 12px 32px var(--shadow-strong, rgba(0, 0, 0, .2)); }
.applock-ico { margin: 0 auto 10px; width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--static-bg, rgba(0, 0, 0, .05)); }
.applock-ico svg { width: 26px; height: 26px; stroke: var(--ink, #111); }
.applock-title { font-size: 17px; font-weight: 700; color: var(--ink, #111); margin: 2px 0 4px; }
.applock-sub { font-size: 12px; line-height: 1.55; color: var(--muted, #8a8a8a); margin-bottom: 6px; white-space: normal; word-break: break-word; }
.applock-dots { display: flex; gap: 10px; justify-content: center; margin: 14px 0 14px; min-height: 14px; }
.applock-dots i { width: 12px; height: 12px; border-radius: 50%; border: 1.5px solid var(--line, #ddd); background: transparent; transition: background .12s, border-color .12s; }
.applock-dots i.on { background: var(--ink, #111); border-color: var(--ink, #111); }
.applock-dots i.err { background: var(--danger-ink, #a32d2d); border-color: var(--danger-ink, #a32d2d); }
.applock-keys { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 8px; max-width: 236px; margin: 0 auto; }
.applock-key { height: 52px; border-radius: 14px; border: none; background: var(--btn-cancel-bg, #eee); color: var(--ink, #111); font-size: 20px; font-weight: 600; display: flex; align-items: center; justify-content: center; cursor: pointer; touch-action: manipulation; user-select: none; -webkit-user-select: none; transition: transform .06s, opacity .12s; }
.applock-key:active { transform: scale(.92); }
.applock-key.dim { color: var(--muted, #999); font-weight: 400; }
.applock-key:disabled { opacity: .4; }
.applock-shake { animation: applockShake .4s; }
@keyframes applockShake { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-8px); } 40% { transform: translateX(8px); } 60% { transform: translateX(-6px); } 80% { transform: translateX(6px); } }
.applock-err { margin: 0 0 8px; font-size: 12px; color: var(--danger-ink, #a32d2d); min-height: 17px; line-height: 1.4; white-space: normal; }
.applock-links { margin-top: 14px; font-size: 12px; display: flex; justify-content: center; gap: 20px; }
.applock-links button { background: none; border: none; color: var(--soft-ink, #555); font-size: 12px; padding: 4px; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
.applock-acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.applock-ok { margin-top: 12px; width: 100%; padding: 10px; border: none; border-radius: 12px; background: var(--btn-bg, #111); color: var(--btn-ink, #fff); font-size: 15px; font-weight: 600; cursor: pointer; }
.applock-ok:disabled { opacity: .35; }
.applock-ok:active { transform: scale(.98); }
.applock-acts button { flex: 1; min-width: 88px; padding: 8px 10px; border-radius: 12px; border: 1px solid var(--card-border, rgba(0, 0, 0, .1)); background: var(--card-bg-97, #fff); color: var(--soft-ink, #555); font-size: 12px; cursor: pointer; }
.applock-acts button:active { background: var(--static-bg, rgba(0, 0, 0, .06)); }
.applock-mask[hidden] { display: none; }
.applock-txt { width: 100%; box-sizing: border-box; padding: 11px 13px; margin-top: 4px; border-radius: 12px; border: 1px solid var(--input-border, #e0e0e0); background: var(--input-bg, #fff); color: var(--ink, #111); font-size: 14px; outline: none; text-align: left; }
.applock-txt:focus { border-color: var(--input-focus-border, #999); }
.applock-btns { display: flex; gap: 10px; margin-top: 14px; }
.applock-btns button { flex: 1; padding: 11px 10px; border-radius: 12px; font-size: 14px; cursor: pointer; }
.applock-btns .al-primary { border: none; background: var(--btn-bg, #111); color: var(--btn-ink, #fff); font-weight: 600; }
.applock-btns .al-primary:active { transform: scale(.98); }
.applock-btns .al-ghost { border: 1px solid var(--card-border, rgba(0, 0, 0, .1)); background: var(--card-bg-97, #fff); color: var(--soft-ink, #555); }
.fd-intro { font-size:12.5px; line-height:1.75; color:#333; }
.fd-intro b { font-weight:700; color:var(--ink,#111); }
.fd-legend { font-size:11px; color:var(--muted,#777); line-height:1.7; margin-top:8px; }
.fd-legend b { color:var(--ink,#111); font-weight:700; }
.fd-group-title { font-size:12px; color:var(--muted,#777); font-weight:600; letter-spacing:.3px; margin:14px 4px 8px; }
.fd-card { padding:4px 0; }
.fd-row { padding:12px 14px; border-bottom:1px solid rgba(0,0,0,.05); }
.fd-row:last-child { border-bottom:none; }
.fd-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.fd-name { font-size:14px; font-weight:600; line-height:1.4; }
.fd-scope { display:inline-block; padding:1px 8px; border-radius:9px; font-size:10px; font-weight:400;
border:1px solid rgba(0,0,0,.08); background:rgba(0,0,0,.03); color:var(--muted,#777); }
.fd-scope.global { border-color:rgba(201,138,27,.35); background:rgba(201,138,27,.1); color:#a9731b; }
.fd-count { margin-top:3px; font-size:11px; color:var(--muted,#777); }
.fd-count.empty { opacity:.6; }
.fd-desc { font-size:11.5px; color:var(--muted,#777); line-height:1.6; margin-top:3px; }
.fd-btns { display:flex; gap:8px; margin-top:10px; }
.fd-btn { flex:1 1 0; padding:9px 6px; border:none; border-radius:12px; background:var(--ink,#111); color:var(--bg-b,#fff);
font-size:12.5px; font-weight:600; font-family:inherit; cursor:pointer; -webkit-tap-highlight-color:transparent; }
.fd-btn:active { opacity:.85; }
.fd-btn.danger { background:rgba(217,83,79,.12); color:#c0392b; }
.fd-btn.danger:active { background:rgba(217,83,79,.2); }
[data-theme="dark"] .fd-intro { color:#d6d6d6; }
[data-theme="dark"] .fd-intro b, [data-theme="dark"] .fd-legend b { color:#fff; }
[data-theme="dark"] .fd-btn.danger { background:rgba(217,83,79,.22); color:#ff9a94; }
[data-theme="dark"] .fd-scope { border-color:rgba(255,255,255,.14); background:rgba(255,255,255,.06); }
.fd-fbar { margin:10px 12px; padding:12px 14px; }
.fd-fbar-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.fd-fbar-name { font-size:13px; font-weight:600; color:var(--ink,#111); }
.fd-fbar-go { border:none; background:transparent; color:var(--muted,#777); font-size:12px;
font-family:inherit; padding:4px 2px; cursor:pointer; -webkit-tap-highlight-color:transparent; }
.fd-fbar .fd-count { margin-top:4px; font-size:11px; color:var(--muted,#777); }
.fd-fbar .fd-count.empty { opacity:.6; }
.fd-fbar .fd-btns { margin-top:10px; }
.fd-fbar[hidden] { display:none; }
[data-theme="dark"] .fd-fbar-name { color:#fff; }
:root { --mochi-text-adj: 0px; }
#screen-adj-panel[hidden] { display: none !important; }
.msg-bubble { font-size: calc(var(--chat-font-size, 14px) + var(--mochi-text-adj, 0px)); }
.msg-quote { font-size: calc(12px + var(--mochi-text-adj, 0px)); }
.chat-input { font-size: calc(15px + var(--mochi-text-adj, 0px)); }
.phone .chat-input[contenteditable="true"] { font-size: calc(15px + var(--mochi-text-adj, 0px)); }
.ch-name { font-size: calc(17px + var(--mochi-text-adj, 0px)); }
.set-row .txt { font-size: calc(14px + var(--mochi-text-adj, 0px)); }
.set-row .txt .sub { font-size: calc(11.5px + var(--mochi-text-adj, 0px)); }
.gc-set-row .txt { font-size: calc(14px + var(--mochi-text-adj, 0px)); }
.splash.eqz-active .splash-box,
.splash.eqz-active .splash-footcard { display: none; }
.eqz-page {
flex: 1; min-height: 0; width: 100%; box-sizing: border-box;
display: flex; flex-direction: column;
text-align: left;
}
.eqz-head {
padding: 0 0 12px;
border-bottom: 1px solid var(--sp-line, rgba(0, 0, 0, .08));
}
.eqz-back {
appearance: none; -webkit-appearance: none;
display: inline-block; margin: 0 0 10px; padding: 3px 11px;
font-size: 11.5px; font-weight: 700; line-height: 1.6; letter-spacing: 1px;
color: var(--muted, #8a8a8a); background: none; cursor: pointer; touch-action: manipulation;
border: 1px solid var(--card-border, rgba(0, 0, 0, .1)); border-radius: 999px;
}
.eqz-title { font-size: 15px; font-weight: 800; color: var(--ink, #111); letter-spacing: 1px; text-align: center; }
.eqz-sub { margin-top: 8px; font-size: 11.5px; line-height: 1.75; color: var(--muted, #8a8a8a); white-space: normal; }
.eqz-progress { margin-top: 10px; font-size: 11px; font-weight: 700; color: var(--sp-ink, #111); text-align: center; letter-spacing: 1px; }
.eqz-view { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.eqz-view[hidden] { display: none; }
.eqz-view .eqz-scroll { flex: 1; }
#eqz-view-result { overflow-y: auto; scrollbar-width: none; }
#eqz-view-result::-webkit-scrollbar { display: none; }
.eqz-scroll {
min-height: 0; overflow-y: auto;
padding: 14px 18px 6px; scrollbar-width: none; -ms-overflow-style: none;
}
.eqz-scroll::-webkit-scrollbar { display: none; }
.eqz-q { margin: 0 0 16px; }
.eqz-qh { font-size: 12.5px; font-weight: 700; color: var(--ink, #111); line-height: 1.7; margin-bottom: 8px; }
.eqz-idx { margin-right: 4px; }
.eqz-tag {
display: inline-block; margin-right: 6px; padding: 0 6px; border-radius: 6px;
font-size: 10px; font-weight: 700; vertical-align: 1px;
color: var(--soft-ink, #555); background: var(--static-bg, rgba(0, 0, 0, .06));
}
.eqz-opt {
display: flex; gap: 8px; align-items: flex-start; width: 100%;
padding: 9px 11px; margin-bottom: 6px;
border: 1px solid var(--card-border, rgba(0, 0, 0, .1)); border-radius: 11px;
background: var(--card-bg-97, transparent);
font-size: 12.5px; line-height: 1.65; color: var(--soft-ink, #555);
font-family: inherit; text-align: left; cursor: pointer; position: relative;
appearance: none; -webkit-appearance: none; touch-action: manipulation;
-webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none;
}
.eqz-opt::before {
content: ''; flex: 0 0 auto; width: 16px; height: 16px; margin: 2px 0 0; box-sizing: border-box;
border: 1.5px solid var(--card-border, rgba(0, 0, 0, .25)); background: transparent;
}
.eqz-opt.eqz-check::before { border-radius: 4px; }
.eqz-opt.eqz-radio::before { border-radius: 50%; }
.eqz-opt.is-sel::before { border-color: var(--sp-ink, #111); }
.eqz-opt.eqz-radio.is-sel::before {
background: radial-gradient(circle, var(--sp-ink, #111) 0, var(--sp-ink, #111) 2.5px, transparent 3px);
}
.eqz-opt.eqz-check.is-sel::before { background: var(--sp-ink, #111); }
.eqz-opt.eqz-check.is-sel::after {
content: ''; position: absolute; left: 15px; top: 14px; width: 8px; height: 4px; box-sizing: border-box;
border-left: 2px solid var(--btn-ink, #fff); border-bottom: 2px solid var(--btn-ink, #fff);
transform: rotate(-45deg); transform-origin: center;
}
.eqz-opt-t { flex: 1; white-space: normal; word-break: break-word; }
.eqz-opt.is-sel { border-color: var(--sp-ink, #111); background: var(--sp-soft, rgba(17, 17, 17, .055)); color: var(--ink, #111); }
.eqz-foot {
padding: 10px 18px calc(16px + var(--mochi-safe-bottom, env(safe-area-inset-bottom, 0px)));
border-top: 1px solid var(--sp-line, rgba(0, 0, 0, .08));
}
.eqz-note { margin-bottom: 8px; font-size: 11.5px; line-height: 1.6; color: var(--muted, #8a8a8a); white-space: normal; }
.eqz-btn {
width: 100%; padding: 12px; border: none; border-radius: 12px;
background: var(--btn-bg, #111); color: var(--btn-ink, #fff);
font-size: 15px; font-weight: 700; cursor: pointer; touch-action: manipulation;
}
.eqz-btn:active { transform: scale(.98); opacity: .9; }
.eqz-btn-ghost {
margin-top: 8px; background: none; color: var(--soft-ink, #555);
border: 1px solid var(--card-border, rgba(0, 0, 0, .1));
}
.eqz-rs { padding: 20px 18px 8px; }
.eqz-rs-t { font-size: 17px; font-weight: 800; margin: 0 0 12px; }
.eqz-rs-ok .eqz-rs-t { color: var(--ok-ink, #1c7c3c); }
.eqz-rs-bad .eqz-rs-t { color: var(--danger-ink, #a32d2d); }
.eqz-rs-d { font-size: 12px; line-height: 1.7; color: var(--muted, #8a8a8a); margin: 0 0 12px; white-space: normal; }
.eqz-rs-list { margin: 0 0 16px; }
.eqz-rs-li {
padding: 9px 12px; margin-bottom: 8px; font-size: 12.5px; line-height: 1.6;
color: var(--soft-ink, #555);
border: 1px solid var(--danger-ink, #a32d2d); border-radius: 11px;
white-space: normal; word-break: break-word;
}
.eqz-rs-n { font-weight: 800; color: var(--danger-ink, #a32d2d); margin-right: 6px; }
.splash.rules-open { overflow-y: auto; }
.splash.rules-open > #entry-rules-page [hidden] { display: none !important; }
.splash.rules-open > #entry-rules-page #nrz-prev[disabled] { opacity: .32; }
.splash.eqz-active > .eqz-page { padding-top:var(--mochi-safe-top, env(safe-area-inset-top, 0px)); }
.ur-wrap {
position: fixed; inset: 0; z-index: 30;
display: flex; align-items: center; justify-content: center;
padding: 22px; box-sizing: border-box;
background: rgba(0, 0, 0, .38);
}
.ur-card {
width: 100%; max-width: 330px; max-height: 80%;
overflow-y: auto; scrollbar-width: none; -ms-overflow-style: none;
padding: 18px 16px; box-sizing: border-box; text-align: left;
background: var(--card-bg-97, rgba(255, 255, 255, .97));
border: 1px solid var(--card-border, rgba(0, 0, 0, .1));
border-radius: 16px; box-shadow: 0 12px 34px rgba(0, 0, 0, .18);
}
.ur-card::-webkit-scrollbar { display: none; }
.ur-t { font-size: 14.5px; font-weight: 800; color: var(--ink, #111); line-height: 1.5; letter-spacing: .5px; text-align: center; }
.ur-d { margin-top: 10px; font-size: 12px; line-height: 1.75; color: var(--soft-ink, #555); white-space: normal; word-break: break-word; }
.ur-go {
width: 100%; margin-top: 14px; padding: 12px; border: none; border-radius: 12px;
background: var(--btn-bg, #111); color: var(--btn-ink, #fff);
font-size: 14px; font-weight: 700; cursor: pointer; touch-action: manipulation;
}
.ur-go:active { transform: scale(.98); opacity: .9; }
.ur-go[disabled] { opacity: .55; transform: none; cursor: default; }
.ur-st {
display: none; margin-top: 10px; padding: 8px 10px; box-sizing: border-box;
background: var(--static-bg, rgba(0, 0, 0, .04)); border-radius: 10px;
font-size: 11.5px; line-height: 1.65; color: var(--soft-ink, #555);
white-space: normal; word-break: break-word; text-align: left;
}
.ur-st.show { display: block; }
.ur-later {
width: 100%; margin-top: 8px; padding: 8px; background: none; border: none;
font-size: 11.5px; color: var(--muted, #8a8a8a); cursor: pointer; touch-action: manipulation;
}
</style>
<style id="yz-style">
/* ================= 言字卡风格 · 播放器 / 此间（v3.50.x） ================= */
.yz-page{display:flex;flex-direction:column;height:100%;background:#fff;color:#111}
.yz-page *{box-sizing:border-box}
.yz-top{flex:0 0 auto;height:46px;display:flex;align-items:center;padding:0 10px;padding-top:var(--mochi-safe-top,0px)}
.yz-back{width:38px;height:38px;display:flex;align-items:center;justify-content:center;border:0;background:none;padding:0;color:#111;cursor:pointer}
.yz-back svg{width:22px;height:22px}
.yz-body{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 18px 18px}
.yz-body::-webkit-scrollbar{display:none}

/* ---- 播放器头部 ---- */
.yz-greet{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:4px 0 12px}
.yz-eyebrow{font-size:11px;letter-spacing:1.6px;color:#9b9b9b;font-weight:500;text-transform:uppercase}
.yz-hi{font-size:30px;font-weight:700;line-height:1.15;margin-top:3px;letter-spacing:-.5px}
.yz-sub{font-size:12px;color:#8a8a8a;margin-top:4px}
.yz-acts{display:flex;align-items:center;gap:8px;padding-top:8px;flex:0 0 auto}
.yz-txtbtn{height:32px;padding:0 14px;border:1px solid #dedede;background:#fff;border-radius:999px;font-size:13px;color:#111;cursor:pointer;font-family:inherit}
.yz-txtbtn:active{background:#f5f5f5}
.yz-icobtn{width:34px;height:34px;border:0;background:none;padding:0;display:flex;align-items:center;justify-content:center;color:#111;cursor:pointer;border-radius:50%}
.yz-icobtn:active{background:#f4f4f4}
.yz-icobtn svg{width:21px;height:21px}

/* ---- tabs ---- */
.yz-tabs{flex:0 0 auto;display:flex;gap:22px;padding:0 18px;border-bottom:1px solid #f0f0f0;overflow-x:auto;scrollbar-width:none}
.yz-tabs::-webkit-scrollbar{display:none}
.yz-tab{position:relative;border:0;background:none;padding:12px 0 11px;font-size:14px;color:#8a8a8a;white-space:nowrap;cursor:pointer;font-family:inherit}
.yz-tab b{font-weight:400;font-size:12px;color:#a8a8a8;margin-left:2px}
.yz-tab.on{color:#111;font-weight:600}
.yz-tab.on b{color:#111;font-weight:600}
.yz-tab.on::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:#111;border-radius:2px}

/* ---- 区块标题 ---- */
.yz-sec{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin:22px 0 12px}
.yz-sec h3{font-size:20px;font-weight:600;margin:0;letter-spacing:-.2px}
.yz-sec span{font-size:11px;color:#9b9b9b}

/* ---- 搜索 ---- */
.yz-search{display:flex;height:46px;border-radius:12px;background:#f4f4f4;overflow:hidden}
/* mochi 全局把 input 换成了 contenteditable(.ce-box)，这里适配搜索框 */
.yz-search{position:relative}
.yz-inp{flex:1;min-width:0;display:flex;align-items:center;padding:0 14px;font-size:14px;color:#111;line-height:44px;white-space:nowrap;overflow-x:auto;outline:none;-webkit-overflow-scrolling:touch}
.yz-inp:empty:before{content:attr(data-ph);color:#a8a8a8}
.yz-inp:focus{outline:none}
.yz-search .ce-box{flex:1;min-width:0;display:flex;align-items:center;padding:0 14px;font-size:14px;color:#111;line-height:44px;white-space:nowrap;overflow-x:auto;outline:none;-webkit-overflow-scrolling:touch}
.yz-search .ce-box:empty:before{content:attr(data-ph);color:#a8a8a8}
.yz-search input.ce-ghost{position:absolute!important;left:0;top:0;width:1px!important;height:1px!important;opacity:0!important;border:0!important;padding:0!important;pointer-events:none}
.yz-search input:not(.ce-ghost){flex:1;min-width:0;position:static!important;width:auto!important;border:0;background:none;padding:0 14px;font-size:14px;outline:none}

.yz-search input{flex:1;min-width:0;border:0;background:none;padding:0 14px;font-size:14px;color:#111;outline:none;font-family:inherit}
.yz-search input::placeholder{color:#a8a8a8}
.yz-search button{flex:0 0 62px;border:0;background:#111;color:#fff;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
.yz-search button:active{opacity:.85}

/* ---- 网易云区块 ---- */
.yz-ncm{margin-top:24px}
.yz-ncm-login{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-top:10px}
.yz-ncm-login b{font-size:15px;font-weight:600;display:block}
.yz-ncm-login p{font-size:12px;color:#8a8a8a;line-height:1.65;margin:6px 0 0}
.yz-ncm-side{font-size:11px;color:#9b9b9b;white-space:nowrap;padding-top:2px}
.yz-hint{font-size:12px;color:#9b9b9b;line-height:1.75;margin:16px 0 0}

/* ---- 播放器列表 ---- */
.yz-row{display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid #f4f4f4;cursor:pointer}
.yz-row:active{background:#fafafa}
.yz-cov{flex:0 0 44px;width:44px;height:44px;border-radius:9px;background:#f2f2f2;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#b8b8b8}
.yz-cov img{width:100%;height:100%;object-fit:cover;display:block}
.yz-cov svg{width:19px;height:19px}
.yz-row-main{flex:1;min-width:0}
.yz-row-name{font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yz-row-sub{font-size:11.5px;color:#8a8a8a;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yz-row-end{flex:0 0 auto;display:flex;align-items:center;gap:6px;color:#a8a8a8;font-size:11px}
.yz-row-play{width:30px;height:30px;border:0;background:none;padding:0;color:#111;display:flex;align-items:center;justify-content:center;cursor:pointer}
.yz-row-play svg{width:17px;height:17px}
.yz-empty{font-size:12.5px;color:#a0a0a0;line-height:1.8;padding:26px 2px;text-align:center}
.yz-chip{display:inline-flex;align-items:center;height:26px;padding:0 10px;border-radius:999px;background:#f4f4f4;font-size:11.5px;color:#6f6f6f;margin:0 6px 8px 0}

/* ---- 迷你播放条 ---- */
.yz-now{position:sticky;bottom:8px;margin:14px 0 4px;display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:16px;background:#fff;border:1px solid #ececec;box-shadow:0 8px 28px rgba(0,0,0,.09)}
.yz-now[hidden]{display:none}
.yz-now-cov{flex:0 0 46px;width:46px;height:46px;border-radius:11px;background:#f2f2f2;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#b8b8b8}
.yz-now-cov img{width:100%;height:100%;object-fit:cover;display:block}
.yz-now-cov svg{width:19px;height:19px}
.yz-now-main{flex:1;min-width:0}
.yz-now-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yz-now-sub{font-size:11px;color:#8a8a8a;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yz-now-ctrl{flex:0 0 auto;display:flex;align-items:center;gap:4px}
/* 歌词全屏层 */
.yz-lyric{position:fixed;inset:0;z-index:80;background:#fff;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top)}
.yz-lyric[hidden]{display:none}
[data-theme="dark"] .yz-lyric{background:#0c0c0c}
.yz-lyric-top{flex:0 0 auto;display:flex;align-items:center;gap:8px;padding:14px 14px 10px}
.yz-lyric-close{flex:0 0 auto;border:0;background:transparent;color:#111;font-size:13px;font-family:inherit;padding:6px 2px;cursor:pointer}
.yz-lyric-ti{flex:1;min-width:0;text-align:center}
.yz-lyric-ti b{display:block;font-size:14px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#111}
.yz-lyric-ti span{display:block;font-size:11px;color:#9a9a9a;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.yz-lyric-ta{flex:0 0 auto;border:1px solid #e2e2e2;background:#fafafa;color:#111;font-size:11px;font-weight:600;font-family:inherit;border-radius:999px;padding:6px 10px;cursor:pointer;white-space:nowrap}
.yz-lyric-body{flex:1;min-height:0;overflow-y:auto;padding:10px 26px 140px;scroll-behavior:smooth;-webkit-overflow-scrolling:touch}
.yz-lrc-line{font-size:16px;line-height:1.95;color:#b5b5b5;padding:5px 0;transition:color .25s,transform .25s;cursor:pointer;word-break:break-word}
.yz-lrc-line.cur{color:#111;font-weight:600;transform:scale(1.02)}
.yz-lrc-line.sel{color:#111;font-weight:600;background:#f7f7f7;border-radius:8px;margin:0 -8px;padding-left:8px;padding-right:8px}
.yz-lrc-line i{display:block;font-style:normal;font-size:12px;color:#c2c2c2;margin-top:1px}
.yz-lrc-empty{padding:40px 0;text-align:center;color:#a8a8a8;font-size:13px;line-height:1.9}
.yz-lrc-retry{margin-top:14px;border:1px solid #e2e2e2;background:#fff;color:#111;font-size:12.5px;font-weight:600;font-family:inherit;border-radius:999px;padding:8px 18px;cursor:pointer}
.yz-lyric-act{position:absolute;left:12px;right:12px;bottom:calc(16px + env(safe-area-inset-bottom));background:#fff;border:1px solid #ececec;border-radius:16px;box-shadow:0 12px 40px rgba(0,0,0,.16);padding:12px}
.yz-lyric-act[hidden]{display:none}
.yz-lyric-sel{font-size:12.5px;line-height:1.7;color:#5a5a5a;padding:0 4px 10px;border-bottom:1px solid #f2f2f2;margin-bottom:10px;max-height:70px;overflow:hidden}
.yz-lyric-btns{display:flex;gap:8px}
.yz-lyric-btns button{flex:1;border:0;border-radius:10px;background:#111;color:#fff;font-size:12.5px;font-weight:600;font-family:inherit;padding:11px 0;cursor:pointer}
.yz-lyric-btns button.lite{background:#f4f4f4;color:#555}
[data-theme="dark"] .yz-lyric-ti b,[data-theme="dark"] .yz-lrc-line.cur,[data-theme="dark"] .yz-lyric-close{color:#f0f0f0}
[data-theme="dark"] .yz-lyric-act{background:#1e1e1e;border-color:#333}
[data-theme="dark"] .yz-lyric-btns button.lite{background:#2a2a2a;color:#bbb}
[data-theme="dark"] .yz-lyric-ta{background:#1e1e1e;border-color:#333;color:#eee}
[data-theme="dark"] .yz-lrc-line.sel{background:#1e1e1e}
.yz-nbtn{width:32px;height:32px;border:0;background:none;padding:0;display:flex;align-items:center;justify-content:center;color:#111;cursor:pointer;border-radius:50%}
.yz-nbtn svg{width:18px;height:18px}
.yz-nbtn.play{width:38px;height:38px;background:#111;color:#fff;border-radius:50%}
.yz-nbtn.play svg{width:16px;height:16px}
.yz-nbtn:active{opacity:.7}

/* ================= 此间 ================= */
.yz-cj-hero{text-align:center;padding:2px 0 14px}
.yz-cj-who{font-size:11.5px;color:#8a8a8a;letter-spacing:.2px}
.yz-cj-name{font-size:26px;font-weight:700;margin-top:4px;letter-spacing:1px}
.yz-cj-time{font-size:11.5px;color:#9b9b9b;margin-top:5px}
.yz-sense-lv{gap:8px;margin-bottom:10px}
.yz-sense-lv .yz-chip{flex:1;text-align:center;padding:8px 0;font-size:12.5px}
.yz-sense-lv .yz-chip.on{background:#111;border-color:#111;color:#fff;font-weight:600}
[data-theme="dark"] .yz-sense-lv .yz-chip.on{background:#eee;border-color:#eee;color:#111}
.yz-cj-tabs{display:flex;gap:4px;background:#f2f2f2;border-radius:999px;padding:4px;margin:0 0 14px}
.yz-cj-tab{flex:1;height:34px;border:0;border-radius:999px;background:none;font-size:13.5px;color:#6f6f6f;cursor:pointer;font-family:inherit}
.yz-cj-tab.on{background:#fff;color:#111;font-weight:600;box-shadow:0 1px 5px rgba(0,0,0,.09)}
.yz-card{background:#fff;border:1px solid #ececec;border-radius:18px;padding:15px 15px 16px;margin-bottom:12px}
.yz-card-h{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px}
.yz-card-h b{font-size:15px;font-weight:600}
.yz-tag{font-size:10.5px;color:#8a8a8a;background:#f4f4f4;border-radius:999px;padding:3px 8px;white-space:nowrap}
.yz-switch{position:relative;width:44px;height:26px;flex:0 0 auto;border-radius:999px;background:#e3e3e3;border:0;padding:0;cursor:pointer}
.yz-switch::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:left .18s}
.yz-switch.on{background:#111}
.yz-switch.on::after{left:21px}
.yz-weather{height:112px;border-radius:13px;background:linear-gradient(160deg,#c9cfd6,#e6e9ec 62%,#f2f4f6);position:relative;overflow:hidden;margin-bottom:12px}
.yz-weather i{position:absolute;left:14px;bottom:12px;font-style:normal;font-size:30px;color:rgba(255,255,255,.9)}
.yz-weather em{position:absolute;right:14px;bottom:14px;font-style:normal;font-size:11.5px;color:rgba(255,255,255,.92)}
.yz-clock{display:flex;align-items:flex-end;gap:9px;margin:2px 0 6px}
.yz-clock b{font-size:34px;font-weight:700;line-height:1;letter-spacing:-1px}
.yz-clock span{font-size:13px;color:#6f6f6f;padding-bottom:2px}
.yz-date{font-size:12px;color:#8a8a8a}
.yz-note{font-size:12px;color:#9b9b9b;line-height:1.65;margin-top:3px}
.yz-shich{display:flex;gap:5px;justify-content:space-between;margin:2px 0 12px}
.yz-shich i{flex:1;height:28px;border-radius:999px;background:#f4f4f4;font-style:normal;font-size:12px;color:#6f6f6f;display:flex;align-items:center;justify-content:center}
.yz-shich i.on{background:#111;color:#fff;font-weight:600}
.yz-shich i.out{background:#fff;color:#cfcfcf;border:1px dashed #eee}
.yz-tl{display:flex;gap:10px;padding:9px 0;border-top:1px solid #f5f5f5;font-size:12.5px}
.yz-tl b{flex:0 0 34px;font-weight:400;color:#6f6f6f}
.yz-tl span{flex:0 0 104px;color:#a0a0a0}
.yz-tl em{flex:1;font-style:normal;color:#111}
.yz-pills{display:flex;flex-wrap:wrap;gap:7px;margin:4px 0 10px}
.yz-pill{height:30px;padding:0 13px;border-radius:999px;border:1px solid #e2e2e2;background:#fff;font-size:12.5px;color:#6f6f6f;display:inline-flex;align-items:center;cursor:pointer;font-family:inherit}
.yz-pill.on{background:#111;border-color:#111;color:#fff}
.yz-quote{border-left:2px solid #d8d8d8;padding:2px 0 2px 10px;font-size:13px;line-height:1.7;color:#3d3d3d;margin:8px 0}
.yz-by{font-size:11px;color:#a0a0a0;margin-top:5px}
.yz-kv{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:#6f6f6f;margin-top:9px}
.yz-kv b{font-weight:600;color:#111}
.yz-2btn{display:flex;gap:10px;margin:12px 0}
.yz-2btn button{flex:1;height:44px;border-radius:13px;border:1px solid #e2e2e2;background:#fff;font-size:14px;color:#111;cursor:pointer;font-family:inherit}
.yz-2btn button:active{background:#f6f6f6}
.yz-dial{position:relative;width:186px;height:186px;margin:6px auto 10px;border-radius:50%;border:1px solid #efefef}
.yz-dial .c{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:15px;font-weight:600}
.yz-dial .a{position:absolute;font-size:14px;color:#9a9a9a;line-height:1}
.yz-dial .a.on{color:#111;font-size:15px}
/* 世界感知 · 记录页 */
.yz-weather{background:linear-gradient(160deg,#98a4b4,#c2cbd6 58%,#e3e8ee)}
.yz-weather::after{content:"";position:absolute;inset:0;background:radial-gradient(120% 80% at 78% 12%,rgba(255,255,255,.55),rgba(255,255,255,0) 60%)}
.yz-dial{border:1px dashed #e4e4e4}
.yz-dial::before{content:"";position:absolute;inset:24px;border-radius:50%;border:1px dashed #f1f1f1;pointer-events:none}
.yz-mood-sum{font-size:12.5px;color:#6f6f6f;margin:-4px 0 10px}
.yz-mood-sum b{color:#111;font-weight:600}
.yz-mood-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.yz-mood-chip{flex:1 1 28%;min-width:86px;border:1px solid #efefef;border-radius:12px;padding:9px 10px;background:#fafafa;display:flex;flex-direction:column;gap:2px}
.yz-mood-chip.now{background:#111;border-color:#111}
.yz-mood-chip small{font-size:10px;color:#a0a0a0}
.yz-mood-chip b{font-size:13px;font-weight:600;color:#111}
.yz-mood-chip em{font-style:normal;font-size:11.5px;color:#8a8a8a}
.yz-mood-chip.now small{color:rgba(255,255,255,.62)}
.yz-mood-chip.now b{color:#fff}
.yz-mood-chip.now em{color:rgba(255,255,255,.76)}
.yz-mood-day{border-top:1px solid #f4f4f4;padding:9px 0}
.yz-mood-day summary{list-style:none;display:flex;align-items:center;gap:8px;cursor:pointer;font-size:12.5px}
.yz-mood-day summary::-webkit-details-marker{display:none}
.yz-mood-day summary span{flex:0 0 50px;color:#6f6f6f}
.yz-mood-day summary em{flex:1;font-style:normal;color:#111}
.yz-mood-day summary i{font-style:normal;color:#c2c2c2;font-size:10px;transition:transform .2s}
.yz-mood-day[open] summary i{transform:rotate(180deg)}
.yz-mood-daybody{padding:6px 0 2px}
.yz-mood-line{display:flex;gap:10px;padding:4px 0 4px 50px;font-size:12px;color:#5a5a5a}
.yz-mood-line b{font-weight:400;color:#a8a8a8;flex:0 0 40px}
.yz-mood-quote{margin-top:10px;background:#f7f7f7;border-radius:10px;padding:10px 12px;font-size:12.5px;line-height:1.7;color:#5a5a5a}
.yz-clear{border:0;background:#f4f4f4;color:#6f6f6f;font-size:11px;font-family:inherit;border-radius:999px;padding:4px 10px;cursor:pointer;margin-left:auto}
.yz-chips{display:flex;flex-wrap:wrap;gap:7px;margin:2px 0 12px}
.yz-chip{border:1px solid #ececec;background:#fff;color:#6f6f6f;font-size:11.5px;font-family:inherit;border-radius:999px;padding:6px 12px;cursor:pointer}
.yz-chip.on{background:#111;border-color:#111;color:#fff;font-weight:600}
.yz-hist{display:flex;flex-direction:column}
.yz-hist-row{display:flex;align-items:flex-start;gap:8px;padding:8px 0;border-top:1px solid #f5f5f5;font-size:12.5px}
.yz-hist-row b{flex:0 0 32px;font-size:10px;font-weight:600;color:#8a8a8a;background:#f4f4f4;border-radius:4px;text-align:center;padding:2px 0;margin-top:1px}
.yz-hist-row span{flex:1;color:#3d3d3d;line-height:1.6;word-break:break-word}
.yz-hist-row i{flex:0 0 auto;font-style:normal;font-size:10.5px;color:#b5b5b5}
[data-theme="dark"] .yz-mood-chip{background:#1a1a1a;border-color:#2c2c2c}
[data-theme="dark"] .yz-mood-chip b{color:#eee}
[data-theme="dark"] .yz-mood-quote{background:#1a1a1a;color:#bbb}
[data-theme="dark"] .yz-mood-day summary em,[data-theme="dark"] .yz-mood-sum b{color:#eee}
[data-theme="dark"] .yz-chip{background:#1a1a1a;border-color:#2c2c2c;color:#aaa}
[data-theme="dark"] .yz-chip.on{background:#eee;border-color:#eee;color:#111}
[data-theme="dark"] .yz-hist-row span{color:#ddd}
[data-theme="dark"] .yz-hist-row b{background:#222;color:#999}
[data-theme="dark"] .yz-clear{background:#222;color:#999}
/* ============ v68：世界感知（#page-cjian）跟随深色 / 浅色模式 ============ */
[data-theme="dark"] .yz-page{background:#0c0c0c;color:#f0f0f0}
[data-theme="dark"] .yz-back{color:#f0f0f0}
[data-theme="dark"] .yz-tabs{border-bottom-color:#242424}
[data-theme="dark"] .yz-tab{color:#8f8f8f}
[data-theme="dark"] .yz-tab b{color:#757575}
[data-theme="dark"] .yz-tab.on,[data-theme="dark"] .yz-tab.on b{color:#f0f0f0}
[data-theme="dark"] .yz-tab.on::after{background:#f0f0f0}
[data-theme="dark"] .yz-cj-who,[data-theme="dark"] .yz-cj-time{color:#9a9a9a}
[data-theme="dark"] .yz-cj-tabs{background:#1c1c1c}
[data-theme="dark"] .yz-cj-tab{color:#9a9a9a}
[data-theme="dark"] .yz-cj-tab.on{background:#2c2c2c;color:#f0f0f0;box-shadow:0 1px 5px rgba(0,0,0,.5)}
[data-theme="dark"] .yz-card{background:#161616;border-color:#262626}
[data-theme="dark"] .yz-card-h b{color:#f0f0f0}
[data-theme="dark"] .yz-tag{background:#242424;color:#9a9a9a}
[data-theme="dark"] .yz-note,[data-theme="dark"] .yz-small,[data-theme="dark"] .yz-hint,[data-theme="dark"] .yz-by,[data-theme="dark"] .yz-sec span{color:#8f8f8f}
[data-theme="dark"] .yz-clock b{color:#f0f0f0}
[data-theme="dark"] .yz-clock span,[data-theme="dark"] .yz-date{color:#9a9a9a}
[data-theme="dark"] .yz-shich i{background:#212121;color:#9a9a9a}
[data-theme="dark"] .yz-shich i.on{background:#f0f0f0;color:#111}
[data-theme="dark"] .yz-shich i.out{background:transparent;border-color:#2c2c2c;color:#5a5a5a}
[data-theme="dark"] .yz-tl{border-top-color:#242424}
[data-theme="dark"] .yz-tl b{color:#9a9a9a}
[data-theme="dark"] .yz-tl span{color:#7a7a7a}
[data-theme="dark"] .yz-tl em{color:#eaeaea}
[data-theme="dark"] .yz-pill{background:#1c1c1c;border-color:#2e2e2e;color:#a8a8a8}
[data-theme="dark"] .yz-pill.on{background:#f0f0f0;border-color:#f0f0f0;color:#111}
[data-theme="dark"] .yz-quote{border-left-color:#3a3a3a;color:#d6d6d6}
[data-theme="dark"] .yz-kv{color:#9a9a9a}
[data-theme="dark"] .yz-kv b{color:#f0f0f0}
[data-theme="dark"] .yz-2btn button{background:#1c1c1c;border-color:#2e2e2e;color:#e8e8e8}
[data-theme="dark"] .yz-2btn button:active{background:#262626}
[data-theme="dark"] .yz-dial{border-color:#2e2e2e}
[data-theme="dark"] .yz-dial::before{border-color:#242424}
[data-theme="dark"] .yz-dial .a{color:#7a7a7a}
[data-theme="dark"] .yz-dial .a.on{color:#f0f0f0}
[data-theme="dark"] .yz-mood-sum,[data-theme="dark"] .yz-mood-sum b{color:#e8e8e8}
[data-theme="dark"] .yz-mood-day{border-top-color:#242424}
[data-theme="dark"] .yz-mood-day summary span{color:#9a9a9a}
[data-theme="dark"] .yz-mood-day summary em{color:#eaeaea}
[data-theme="dark"] .yz-mood-day summary i{color:#666}
[data-theme="dark"] .yz-mood-line{color:#a8a8a8}
[data-theme="dark"] .yz-mood-line b{color:#7a7a7a}
[data-theme="dark"] .yz-hist-row{border-top-color:#242424}
[data-theme="dark"] .yz-hist-row i{color:#7a7a7a}
[data-theme="dark"] .yz-grid2>div{background:#1c1c1c}
[data-theme="dark"] .yz-grid2 small,[data-theme="dark"] .yz-grid2 span{color:#8f8f8f}
[data-theme="dark"] .yz-grid2 b{color:#f0f0f0}
[data-theme="dark"] .yz-empty,[data-theme="dark"] .yz-row-sub,[data-theme="dark"] .yz-row-end{color:#8f8f8f}
[data-theme="dark"] .yz-sec h3{color:#f0f0f0}
[data-theme="dark"] .yz-search{background:#1c1c1c}
[data-theme="dark"] .yz-inp,[data-theme="dark"] .yz-search .ce-box,[data-theme="dark"] .yz-search input{color:#f0f0f0}
[data-theme="dark"] .yz-cov,[data-theme="dark"] .yz-now-cov{background:#242424;color:#666}
[data-theme="dark"] .yz-row,[data-theme="dark"] .yz-now{border-color:#262626}
[data-theme="dark"] .yz-now{background:#161616}
[data-theme="dark"] .yz-row:active{background:#1c1c1c}
.yz-grid2{display:flex;gap:10px}
.yz-grid2>div{flex:1;background:#f7f7f7;border-radius:12px;padding:9px 11px}
.yz-grid2 small{display:block;font-size:10.5px;color:#9b9b9b;margin-bottom:4px}
.yz-grid2 b{font-size:13px;font-weight:600}
.yz-grid2 span{float:right;font-size:10.5px;color:#a8a8a8;font-weight:400}
/* v22（用户直派「状态栏的排版要参考言字卡」）：底部三枚图标收成一枚悬浮胶囊，贴着内容下沿 */
.yz-foot{flex:0 0 auto;display:flex;justify-content:space-around;align-items:center;
margin:2px 14px calc(10px + env(safe-area-inset-bottom));padding:5px 12px;
background:rgba(255,255,255,.94);border:1px solid #ececec;border-radius:999px;
box-shadow:0 10px 30px rgba(0,0,0,.10);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.yz-foot button{width:56px;height:40px;border:0;background:none;color:#111;display:flex;align-items:center;justify-content:center;cursor:pointer;border-radius:999px}
.yz-foot button:active{background:#f1f1f1}
.yz-foot svg{width:20px;height:20px}
[data-theme="dark"] .yz-foot{background:rgba(28,28,28,.94);border-color:#2f2f2f;box-shadow:0 10px 30px rgba(0,0,0,.5)}
[data-theme="dark"] .yz-foot button{color:#f0f0f0}
[data-theme="dark"] .yz-foot button:active{background:#2a2a2a}
.yz-small{font-size:11.5px;color:#9b9b9b;line-height:1.7}


/* ===== 正在播放（点歌名弹出的大播放页） v48 按截图 2 重排 ===== */
#page-now{position:relative;background:#fff;padding-bottom:0;overflow:hidden}
.np-root{flex:1;min-height:0;display:flex;flex-direction:column;background:#fff;padding:0 24px}
/* ============ v68：音乐播放器可换背景（深色一栏 / 浅色一栏，跟随当前模式自动换图） ============ */
#page-now .np-bg{position:absolute;inset:0;z-index:0;display:none;background-position:center center;background-size:cover;background-repeat:no-repeat;pointer-events:none}
#page-now .np-bg.on{display:block}
/* 底色薄纱：保证歌名/歌词在任何照片上都看得清 */
#page-now .np-bg::after{content:"";position:absolute;inset:0;background:rgba(255,255,255,.72)}
[data-theme="dark"] #page-now .np-bg::after{background:rgba(10,10,12,.62)}
#page-now.has-bg .np-root{position:relative;z-index:1;background:transparent}
/* 播放器跟随深色模式：黑底白字（换了深色背景照片后文字也看得清） */
[data-theme="dark"] #page-now{background:#0c0c0c}
[data-theme="dark"] #page-now .np-root{background:#0c0c0c}
[data-theme="dark"] #page-now.has-bg .np-root{background:transparent}
[data-theme="dark"] #page-now .np-close,
[data-theme="dark"] #page-now .np-tbtn,
[data-theme="dark"] #page-now .np-top-c,
[data-theme="dark"] #page-now .np-title,
[data-theme="dark"] #page-now .np-cbtn,
[data-theme="dark"] #page-now .np-tool svg,
[data-theme="dark"] #page-now .np-tool.on{color:#f0f0f0}
[data-theme="dark"] #page-now .np-close svg{stroke:#f0f0f0}
[data-theme="dark"] #page-now .np-cap,
[data-theme="dark"] #page-now .np-artist,
[data-theme="dark"] #page-now .np-times,
[data-theme="dark"] #page-now .np-inv-txt,
[data-theme="dark"] #page-now .np-tool{color:#9a9a9a}
[data-theme="dark"] #page-now .np-hr{background:#262626}
[data-theme="dark"] #page-now .np-rail:before{background:#2c2c2c}
[data-theme="dark"] #page-now .np-fill{background:#f0f0f0}
[data-theme="dark"] #page-now .np-knob{background:#f0f0f0;box-shadow:0 0 0 3px #0c0c0c}
[data-theme="dark"] #page-now .np-play{background:#f0f0f0;color:#111}
[data-theme="dark"] #page-now .np-subbtn{background:#1c1c1c;border-color:#2e2e2e;color:#ccc}
[data-theme="dark"] #page-now .np-favbtn svg{stroke:#ccc}
[data-theme="dark"] #page-now .np-cover{background:#1c1c1c;color:#555;box-shadow:none}
[data-theme="dark"] #page-now .np-plus{border-color:#3a3a3a;color:#777}
[data-theme="dark"] #page-now .np-arrow{color:#666}
[data-theme="dark"] #page-now .np-lrc-chip{background:#1c1c1c;border-color:#2e2e2e;color:#bbb}
[data-theme="dark"] #page-now .np-lrc-sizes button.on{background:#2a2a2a;color:#f0f0f0}
[data-theme="dark"] #page-now .np-lrc-line{color:#5c5c5c}
[data-theme="dark"] #page-now .np-lrc-line.cur{color:#f0f0f0}
[data-theme="dark"] #page-now .np-lrc-line.sel{background:#242424;color:#f0f0f0}
.np-top{flex:0 0 auto;height:46px;display:flex;align-items:center;justify-content:space-between;padding-top:6px}
.np-close{width:34px;height:34px;margin-left:-8px;border:0;background:transparent;display:flex;align-items:center;justify-content:center;border-radius:50%;color:#111;cursor:pointer;flex:none}
.np-close svg{width:22px;height:22px}
.np-top-r{display:flex;align-items:center;gap:6px}
.np-tbtn{border:0;background:transparent;font-family:inherit;font-size:12.5px;font-weight:600;color:#111;display:inline-flex;align-items:center;gap:4px;padding:6px 4px;cursor:pointer;letter-spacing:.2px;white-space:nowrap}
.np-tbtn svg{width:17px;height:17px}
.np-dots svg{width:18px;height:18px}
.np-main{flex:1;min-height:0;display:flex;flex-direction:column;overflow-y:auto;padding:2px 0 8px;-webkit-overflow-scrolling:touch}
.np-main::-webkit-scrollbar{display:none}
.np-cap{text-align:center;font-size:11px;letter-spacing:2px;color:#9b9b9b;margin-bottom:10px}
/* v71：封面改小一些——不再撑满整行，正方形、居中，宽度取 74% / 260px / 34vh 的最小值 */
.np-cover{width:min(74%,260px,34vh);aspect-ratio:1/1;flex:none;align-self:center;margin:0 auto;border-radius:3px;background:#f2f2f2 center/cover no-repeat;display:flex;align-items:center;justify-content:center;color:#cfcfcf;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.07)}
.np-cover img{width:100%;height:100%;object-fit:cover;display:block}
.np-cover svg{width:44px;height:44px}
.np-top{position:relative}
.np-top-c{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:13.5px;font-weight:600;color:#111;letter-spacing:2px;pointer-events:none}
.np-main.lrc-on{overflow:hidden}
/* 歌词模式：封面/标题让位，歌词占满中段，当前句始终停在视觉中心 */
.np-main.lrc-on .np-cap,
.np-main.lrc-on .np-cover,
.np-main.lrc-on .np-title,
.np-main.lrc-on .np-artist,
.np-main.lrc-on .np-invite,
.np-main.lrc-on .np-hr{display:none}
.np-main.lrc-on .np-lrc{flex:1;min-height:0;padding:2px 0 0}
.np-main.lrc-on .np-lrc-body{padding:0;text-align:center}
.np-lrc-pad{height:40vh;pointer-events:none}
.np-lrc{flex:1;min-height:0;display:flex;flex-direction:column;padding-top:2px}
.np-lrc[hidden]{display:none}
.np-lrc-bar{display:flex;align-items:center;gap:6px;flex:none;padding:0 0 8px;flex-wrap:nowrap}
.np-lrc-chip{border:1px solid #e8e8e8;background:#fff;border-radius:999px;padding:5px 11px;font-family:inherit;font-size:11.5px;color:#6b6b6b;cursor:pointer;white-space:nowrap}
.np-lrc-chip:active{background:#f5f5f5}
.np-lrc-sizes{margin-left:auto;display:flex;gap:2px;align-items:center;flex:none}
.np-lrc-sizes button{border:0;background:transparent;font-family:inherit;font-size:11.5px;color:#b3b3b3;padding:5px 8px;border-radius:999px;cursor:pointer}
.np-lrc-sizes button.on{color:#111;font-weight:700;background:#f2f2f2}
/* ===== v89：封面页与歌词页排版一致 =====
   ① 封面页顶部同位置加一条与 np-lrc-bar 同款的胶囊功能条；
   ② 底部控制块（进度/按键/工具）在两种模式下都锚定到底部，位置不再互相对不齐 */
.np-cov-bar{display:flex;align-items:center;gap:6px;flex:none;padding:0 0 10px}
.np-main.lrc-on .np-cov-bar{display:none}
.np-cov-fav{display:inline-flex;align-items:center;gap:4px}
.np-cov-fav svg{width:12px;height:12px;flex:none}
.np-cov-fav.on{color:#d24a63;border-color:rgba(210,74,99,.35)}
.np-cov-fav.on svg{stroke:#d24a63}
.np-cov-lrc{margin-left:auto}
/* v92n：顶部条只留 TA/封面，封面按钮保持靠右 */
#npCovBar #npCoverUpCov{margin-left:auto}
.np-main .np-prog{margin-top:auto}
/* v92n：收藏/歌词固定在底部右下角（队列正上方），封面页与歌词页都显示，不再放顶部功能条 */
[data-theme="dark"] #page-now .np-cov-fav.on{color:#e8899b;border-color:rgba(232,136,136,.4)}
[data-theme="dark"] #page-now .np-cov-fav.on svg{stroke:#e8899b}
.np-lrc-body{flex:1;min-height:110px;overflow-y:auto;text-align:center;-webkit-overflow-scrolling:touch;padding:4px 0 20px;scrollbar-width:none}
.np-lrc-body::-webkit-scrollbar{display:none}
/* v52（图 3）：原文在上、译文在下，字距拉开、居中；非当前句淡灰，当前句深色放大 */
.np-lrc-line{font-size:15px;line-height:1.7;color:#c9c9c9;padding:8px 4px;transition:font-size .18s,color .18s;word-break:break-word;letter-spacing:1.5px}
.np-lrc-line.cur{color:#161616;font-weight:400;font-size:21px;line-height:1.4;letter-spacing:2.4px}
.np-lrc-line.sel{background:#f4f4f4;border-radius:10px;color:#111}
.np-lrc-body[data-sz="s"] .np-lrc-line{font-size:14px}
.np-lrc-body[data-sz="s"] .np-lrc-line.cur{font-size:17.5px}
.np-lrc-body[data-sz="l"] .np-lrc-line{font-size:19px}
.np-lrc-body[data-sz="l"] .np-lrc-line.cur{font-size:27px}
.np-modal{position:absolute;inset:0;z-index:12;display:flex;align-items:center;justify-content:center;padding:0 22px}
.np-modal[hidden]{display:none}
.np-modal-mask{position:absolute;inset:0;background:rgba(0,0,0,.34)}
.np-modal-card{position:relative;width:100%;max-width:340px;background:#fff;border-radius:18px;padding:20px 18px 14px;box-shadow:0 18px 50px rgba(0,0,0,.18);max-height:76vh;overflow-y:auto}
.np-modal-h{font-size:14px;font-weight:700;color:#111;text-align:center;letter-spacing:.5px}
.np-modal-desc{font-size:11.5px;color:#8d8d8d;line-height:1.75;margin-top:9px;text-align:center}
.np-modal-quote{font-size:13px;color:#333;line-height:1.85;text-align:center;margin:14px 0 12px;padding:12px;background:#f7f7f7;border-radius:12px;max-height:150px;overflow:auto}
.np-modal-btns{display:flex;flex-direction:column;gap:8px;margin-top:6px}
.np-modal-btns button{height:40px;border:0;border-radius:12px;background:#f4f4f4;color:#333;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer}
.np-modal-btns .np-mb-pri{background:#111;color:#fff}
.np-modal-btns .lite{background:transparent;color:#9a9a9a;font-weight:500;height:32px}
.np-ta-chips{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:14px 0 10px}
.np-ta-chips button{height:34px;border:1px solid #e6e6e6;background:#fff;border-radius:10px;font-family:inherit;font-size:12.5px;color:#444;cursor:pointer}
.np-ta-chips button.on{background:#111;color:#fff;border-color:#111;font-weight:700}
.np-modal-note{font-size:11px;color:#a0a0a0;text-align:center;line-height:1.65;margin-bottom:10px}
.np-title{font-size:23px;font-weight:600;line-height:1.35;color:#111;text-align:center;margin-top:16px;word-break:break-word}
.np-artist{font-size:12.5px;color:#8d8d8d;text-align:center;margin-top:7px}
.np-hr{height:1px;background:#f0f0f0;margin:14px 0;flex:none}
.np-invite{width:100%;border:0;background:transparent;display:flex;align-items:center;gap:9px;padding:2px 0;font-family:inherit;cursor:pointer}
.np-plus{width:20px;height:20px;border:1px dashed #c9c9c9;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#9a9a9a;flex:none}
.np-plus svg{width:11px;height:11px}
.np-inv-ava{width:26px;height:26px;border-radius:50%;background:#111;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center;flex:none;font-weight:600}
.np-inv-txt{font-size:13px;color:#8d8d8d;letter-spacing:.3px}
.np-arrow{width:16px;height:16px;margin-left:auto;color:#c2c2c2;flex:none}
.np-prog{margin-top:2px;padding:0 4px}
.np-times{padding:0 4px}
.np-rail{position:relative;height:22px;display:flex;align-items:center;cursor:pointer;touch-action:none}
.np-rail:before{content:'';position:absolute;left:0;right:0;height:2px;background:#ececec;border-radius:2px}
.np-fill{position:absolute;left:0;height:2px;background:#111;border-radius:2px;width:0}
.np-knob{position:absolute;left:0;width:9px;height:9px;border-radius:50%;background:#111;margin-left:-4.5px;box-shadow:0 0 0 3px #fff}
.np-times{display:flex;justify-content:space-between;font-size:11px;color:#9a9a9a;margin-top:2px}
.np-ctrl{display:flex;align-items:center;justify-content:center;gap:46px;margin-top:14px}
.np-cbtn{width:40px;height:40px;border:0;background:transparent;color:#111;display:flex;align-items:center;justify-content:center;cursor:pointer}
.np-cbtn svg{width:24px;height:24px}
.np-play{width:54px;height:54px;border-radius:50%;border:0;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,.22)}
.np-play svg{width:22px;height:22px}
/* v45：收藏只留图标、与「歌词」同一行，主控制区与底部工具栏回到原来的高度 */
.np-subbar{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:12px}
.np-subbtn{border:1px solid #e6e6e6;background:#fff;border-radius:99px;padding:5px 15px;font-family:inherit;font-size:11.5px;color:#6f6f6f;cursor:pointer;line-height:1.2}
.np-subbtn:active{background:#f4f4f4}
.np-favbtn{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border-radius:50%}
.np-favbtn svg{width:14px;height:14px;stroke:#6f6f6f;transition:stroke .18s ease,fill .18s ease}
.np-favbtn.on{color:#d24a63;border-color:rgba(210,74,99,.35)}
.np-favbtn.on svg{stroke:#d24a63}
.np-tools{display:grid;grid-template-columns:repeat(4,1fr);margin-top:12px}
.np-tool{border:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:7px;font-family:inherit;font-size:10.5px;color:#6f6f6f;cursor:pointer;padding:4px 0;min-width:0}
.np-tool > span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.np-tool.np-fav{gap:0;justify-content:center}
.np-tool svg{width:21px;height:21px;color:#111}
.np-tool.on{color:#111;font-weight:600}

/* 歌词层 */
.np-lyric{position:absolute;inset:0;z-index:7;background:#fff;display:flex;flex-direction:column;padding:0 24px}
.np-lyric[hidden]{display:none}
.np-ly-top{flex:1;min-width:0;text-align:center;line-height:1.2;padding:0 6px}
.np-ly-top b{display:block;font-size:13px;font-weight:600;color:#111;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.np-ly-top span{display:block;font-size:10.5px;color:#a0a0a0;margin-top:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.np-ln-body{flex:1;min-height:0;overflow-y:auto;padding:6px 0 130px;text-align:center;-webkit-overflow-scrolling:touch}
.np-ln-body::-webkit-scrollbar{display:none}
.np-ln{font-size:15px;line-height:1.6;color:#b9b9b9;padding:9px 6px;border-radius:10px;transition:color .2s,font-size .2s}
.np-ln.cur{color:#111;font-weight:600;font-size:17px}
.np-ln.sel{background:#f3f3f3;color:#111}
.np-ln i{display:block;font-style:normal;font-size:11px;color:#c9c9c9;margin-top:2px}
.np-ln-empty{padding:60px 0;text-align:center;color:#a8a8a8;font-size:13px;line-height:1.9}
.np-ln-empty button{margin-top:14px;border:1px solid #e2e2e2;background:#fff;color:#111;font-size:12.5px;font-weight:600;font-family:inherit;border-radius:999px;padding:8px 18px;cursor:pointer}
.np-ly-act{position:absolute;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #f0f0f0;padding:12px 20px calc(14px + env(safe-area-inset-bottom,0px));box-shadow:0 -8px 24px rgba(0,0,0,.06)}
.np-ly-act[hidden]{display:none}
.np-ly-sel{font-size:12.5px;color:#8d8d8d;text-align:center;margin-bottom:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 6px}
.np-ly-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.np-ly-btns button{height:38px;border:0;border-radius:12px;background:#111;color:#fff;font-family:inherit;font-size:12.5px;font-weight:600;cursor:pointer}
.np-ly-btns button.lite{background:#f4f4f4;color:#333}

/* 浮层 */
.np-pop{position:absolute;left:0;right:0;bottom:0;z-index:9;background:#fff;border-radius:18px 18px 0 0;box-shadow:0 -10px 30px rgba(0,0,0,.14);padding:16px 22px calc(18px + env(safe-area-inset-bottom,0px))}
.np-pop[hidden]{display:none}
.np-pop-h{font-size:13px;font-weight:700;margin-bottom:12px;color:#111;position:relative}
.np-pop-x{position:absolute;right:-4px;top:-6px;width:30px;height:30px;line-height:28px;text-align:center;border:0;background:transparent;font-family:inherit;font-size:22px;font-weight:400;color:#9a9a9a;cursor:pointer;padding:0}
.np-pop-x:active{color:#111}
.np-lrc-tip{font-size:10.5px;color:#b0b0b0;letter-spacing:.3px;text-align:center;padding:5px 0 1px}
.np-lrc-body.seeking .np-lrc-line.cur{color:#111}
.np-pop-row{display:flex;align-items:center;gap:12px}
.np-pop-row svg{width:20px;height:20px;flex:none;color:#111}
.np-pop-row input[type=range]{flex:1;accent-color:#111;height:22px}
.np-pop-row span{font-size:12px;color:#8d8d8d;width:44px;text-align:right}
.np-pop-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.np-pop-btns button{height:40px;border:0;border-radius:12px;background:#f4f4f4;font-family:inherit;font-size:13px;color:#222;cursor:pointer}
.np-pop-btns button.sel{background:#111;color:#fff}

/* ===================== 同屏（v26） ===================== */
#page-screen-share{position:relative;overflow:hidden;background:linear-gradient(180deg,#f6f5f3,#eceae6)}
[data-theme="dark"] #page-screen-share{background:linear-gradient(180deg,#171719,#101012)}
.ss-x{margin-left:auto;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--muted);cursor:pointer;flex:0 0 34px}
.ss-x:active{background:rgba(0,0,0,.05)}
.ss-scroll{flex:1;min-height:0;overflow-y:auto;padding:12px 16px 26px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.ss-scroll::-webkit-scrollbar{display:none}

/* ---- 邀请卡 ---- */
.ss-hero{position:relative;background:linear-gradient(165deg,#3d3d3f 0%,#2c2c2e 62%,#242426 100%);border-radius:26px;padding:20px 18px 17px;color:#f4f4f4;box-shadow:0 20px 44px rgba(0,0,0,.26);overflow:hidden}
.ss-hero::after{content:'';position:absolute;inset:0;border-radius:26px;border:1px solid rgba(255,255,255,.1);pointer-events:none}
.ss-tag{text-align:center;font-size:11.5px;letter-spacing:2.5px;color:rgba(255,255,255,.4);margin-bottom:8px}
.ss-illus{width:182px;height:182px;margin:0 auto;position:relative}
.ss-illus svg{width:100%;height:100%;display:block}
.ss-like{position:absolute;right:4px;bottom:8px;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.11);color:#fff;font-size:17px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.18s}
.ss-like:active{transform:scale(.92)}
.ss-like.on{color:#ff7088;border-color:rgba(255,112,136,.55);background:rgba(255,112,136,.14)}
.ss-title{text-align:center;font-size:21px;font-weight:600;letter-spacing:3px;margin:14px 0 9px;color:#fff}
.ss-desc{text-align:center;font-size:12px;line-height:1.9;color:rgba(255,255,255,.48);padding:0 8px}
.ss-field{display:flex;align-items:center;gap:10px;margin:17px 0 12px;padding:13px 14px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.09);font-size:13px}
.ss-field span{color:rgba(255,255,255,.42);flex:0 0 auto}
.ss-field b{font-weight:600;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ss-field i{font-style:normal;font-size:11.5px;color:rgba(255,255,255,.38);flex:0 0 auto}
.ss-field i.on{color:#8ee6a8}
.ss-main{width:100%;height:50px;border-radius:15px;border:0;background:#fff;color:#1b1b1b;font-size:15px;font-weight:600;letter-spacing:1px;transition:.18s;cursor:pointer;font-family:inherit}
.ss-main:active{transform:scale(.985)}
.ss-main[disabled]{background:rgba(255,255,255,.12);color:rgba(255,255,255,.45)}
.ss-prog{height:5px;border-radius:99px;background:rgba(255,255,255,.14);overflow:hidden;margin:2px 0 3px}
.ss-prog i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,#fff,#d6d6d6);transition:width .55s ease}
.ss-steps{display:flex;justify-content:space-between;margin-top:14px;padding:0 4px;font-size:11px;color:rgba(255,255,255,.32)}
.ss-steps i{font-style:normal;transition:color .3s}
.ss-steps i.on{color:#fff}

/* ---- 已连接 ---- */
.ss-conn-h{display:flex;align-items:baseline;gap:8px;padding:2px 2px 6px;font-size:16.5px;font-weight:600;color:var(--ink)}
.ss-conn-h span{font-size:11px;font-weight:500;color:#37b977;letter-spacing:.5px}
.ss-conn-sub{font-size:12.5px;line-height:1.7;color:var(--muted);padding:0 2px 12px}
.ss-shot{border-radius:16px;overflow:hidden;background:#0d0d0f;box-shadow:0 12px 30px rgba(0,0,0,.2)}
.ss-shot canvas{display:block;width:100%;height:auto}
.ss-shot-row{display:flex;gap:10px;margin:12px 0 2px}
.ss-shot-row button{flex:1;height:42px;border-radius:13px;border:1px solid rgba(0,0,0,.1);background:rgba(255,255,255,.72);font-size:13px;color:var(--ink);font-family:inherit;cursor:pointer}
.ss-shot-row button:active{background:rgba(0,0,0,.04)}
.ss-ask{margin-top:15px;padding:16px;border-radius:18px;background:rgba(255,255,255,.68);border:1px solid rgba(0,0,0,.06);box-shadow:0 6px 18px rgba(0,0,0,.05)}
.ss-ask p{margin:0 0 12px;font-size:13px;color:var(--ink);line-height:1.6}
.ss-ask div{display:flex;gap:10px}
.ss-ask button{flex:1;height:44px;border-radius:13px;border:1px solid rgba(0,0,0,.1);background:#fff;font-size:13.5px;color:var(--ink);font-family:inherit;cursor:pointer}
.ss-ask button.pri{background:#111;color:#fff;border-color:#111}
.ss-ask button:active{transform:scale(.985)}
[data-theme="dark"] .ss-shot-row button{background:rgba(255,255,255,.08);color:#eee;border-color:rgba(255,255,255,.12)}
[data-theme="dark"] .ss-ask{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.1)}
[data-theme="dark"] .ss-ask button{background:rgba(255,255,255,.1);color:#eee;border-color:rgba(255,255,255,.14)}
[data-theme="dark"] .ss-ask button.pri{background:#f2f2f2;color:#111;border-color:#f2f2f2}
.ss-skin-note{display:flex;align-items:center;gap:8px;margin-top:10px;font-size:11.5px;color:var(--muted);padding:0 2px}
.ss-skin-note b{font-weight:600;color:var(--ink)}

/* ---- 屏幕容器 ---- */
.ss-screen{position:absolute;inset:0;z-index:30;display:flex;flex-direction:column;overflow:hidden;background:#111}
.ss-screen-bar{position:absolute;top:0;left:0;right:0;z-index:6;display:flex;align-items:center;gap:7px;padding:calc(9px + var(--mochi-safe-top, env(safe-area-inset-top, 0px))) 15px 9px;font-size:11.5px;letter-spacing:1px;color:#fff;pointer-events:none}
.ss-screen-bar b{font-weight:600}
.ss-screen-bar .dot{width:5px;height:5px;border-radius:50%;background:#3fd08a;box-shadow:0 0 7px #3fd08a;flex:0 0 5px}
.ss-exit{margin-left:auto;pointer-events:auto;padding:6px 13px;border-radius:99px;font-size:11.5px;border:1px solid rgba(255,255,255,.3);color:#fff;background:rgba(0,0,0,.2);cursor:pointer;font-family:inherit}
.ss-exit:active{background:rgba(0,0,0,.4)}
.ss-skin{flex:1;min-height:0;position:relative;overflow:hidden}
/* 浅色皮肤下的顶部浮层与退出按钮 */
.ss-screen.ss-light .ss-screen-bar{color:#2b3546}
.ss-screen.ss-light .ss-screen-bar .dot{background:#2fae74;box-shadow:0 0 5px rgba(47,174,116,.5)}
.ss-screen.ss-light .ss-exit{color:#2b3546;border-color:rgba(43,53,70,.22);background:rgba(255,255,255,.6)}
.ss-switch{margin-left:9px;font-size:11.5px;color:var(--muted);text-decoration:underline;text-underline-offset:2px;cursor:pointer}
.ss-term-prompt .cmd{flex:0 0 auto;font-size:13px;letter-spacing:.2px;color:#d9d9de;white-space:nowrap}
.ss-mu-bar i{animation:ssMuBar 34s linear infinite}
@keyframes ssMuBar{from{width:33%}to{width:72%}}
.ss-term-lines{padding-bottom:12px}
.ss-diary-msgs{padding-bottom:10px}


/* ---- 皮肤：终端 ---- */
.ss-skin-term{background:#141416;padding:calc(40px + var(--mochi-safe-top, 0px)) 14px 14px;display:flex}
.ss-term-win{flex:1;min-width:0;background:#0d0d0f;border-radius:11px;border:1px solid rgba(255,255,255,.07);display:flex;flex-direction:column;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.45)}
.ss-term-bar{display:flex;align-items:center;gap:5px;padding:9px 11px;background:#1b1b1f;font-size:10.5px;color:rgba(255,255,255,.38);flex:0 0 auto}
.ss-term-bar i{width:7px;height:7px;border-radius:50%;background:#ff5f57;flex:0 0 7px}
.ss-term-bar i:nth-child(2){background:#febc2e}
.ss-term-bar i:nth-child(3){background:#28c840}
.ss-term-bar span{margin-left:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ss-term-head{display:flex;align-items:center;gap:10px;padding:12px 12px 9px;flex:0 0 auto}
.ss-term-av{width:42px;height:42px;border-radius:9px;background:#1d1d21;border:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;flex:0 0 42px;overflow:hidden}
.ss-term-av img{width:100%;height:100%;object-fit:cover}
.ss-term-id{flex:1;min-width:0}
.ss-term-id b{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:14px;color:#8ee6a8;letter-spacing:.4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ss-term-id span{display:block;font-size:10.5px;color:rgba(255,255,255,.34);margin-top:3px}
.ss-term-cam{width:33px;height:33px;border-radius:7px;border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.46);flex:0 0 33px}
.ss-term-cam svg{width:16px;height:16px}
.ss-term-rule{border-bottom:1px dashed rgba(255,255,255,.12);margin:0 12px 4px;flex:0 0 auto}
.ss-term-lines{flex:1;min-height:0;padding:6px 12px;display:flex;flex-direction:column;justify-content:flex-end;gap:10px;overflow:hidden}
.ss-ln{display:flex;align-items:center;gap:9px}
.ss-ln i{width:12px;font-style:normal;font-size:10px;color:rgba(255,255,255,.2);text-align:right;flex:0 0 12px}
.ss-ln .bar{height:7px;border-radius:4px;background:#3f5c7d;min-width:40px}
.ss-ln .bar.p{background:#6d4549}
.ss-ln .bar.s{height:6px;opacity:.85}
.ss-ln .txt{font-size:12.5px;color:#cfcfd6;letter-spacing:.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ss-term-prompt{padding:5px 12px 9px;font-size:13px;color:#d9d9de;display:flex;align-items:center;gap:1px;flex:0 0 auto;white-space:nowrap;overflow:hidden}
.ss-cur{display:inline-block;width:8px;height:16px;background:#e2e6e2;margin-left:3px;opacity:.9;animation:ssBlink 1.05s steps(1) infinite}
.ss-term-foot{display:flex;align-items:center;justify-content:space-between;padding:6px 10px;background:#d9a441;color:#191919;font-size:9.5px;font-family:ui-monospace,Menlo,monospace;letter-spacing:.5px;flex:0 0 auto}
.ss-term-foot .enter{padding:2px 9px;border:1px solid rgba(0,0,0,.45);border-radius:3px;font-weight:600}
@keyframes ssBlink{50%{opacity:0}}

/* ---- 皮肤：日记 ---- */
.ss-skin-diary{background:linear-gradient(170deg,#eef3fb 0%,#f9fbfe 52%,#eef2f9 100%);padding:calc(40px + var(--mochi-safe-top, 0px)) 14px 14px;display:flex;flex-direction:column;color:#3a4454}
.ss-diary-title{text-align:center;font-family:Georgia,"Times New Roman",serif;font-style:italic;font-size:23px;color:#5b6b84;letter-spacing:1px;flex:0 0 auto}
.ss-diary-title i{font-size:14px;font-style:italic;font-weight:400;opacity:.72;letter-spacing:.5px}
.ss-diary-nav{margin:8px auto 0;max-width:94%;width:94%;background:linear-gradient(180deg,#c6d5ee,#b0c1e5);color:#fff;font-size:11px;text-align:center;padding:5px 6px;border-radius:8px;letter-spacing:.4px;box-shadow:inset 0 1px 0 rgba(255,255,255,.45)}
.ss-diary-card{margin-top:9px;background:rgba(255,255,255,.88);border-radius:16px;border:1px solid rgba(120,140,170,.14);box-shadow:0 10px 26px rgba(120,140,170,.14);display:flex;flex-direction:column;flex:1;min-height:0;overflow:hidden}
.ss-diary-user{display:flex;align-items:center;gap:10px;padding:11px 13px;border-bottom:1px solid rgba(120,140,170,.12);flex:0 0 auto}
.ss-diary-av{width:34px;height:34px;border-radius:50%;background:#1a1a1a;overflow:hidden;flex:0 0 34px;display:flex;align-items:center;justify-content:center}
.ss-diary-av img{width:100%;height:100%;object-fit:cover}
.ss-diary-user b{display:block;font-size:13px;font-weight:600;color:#2c3646}
.ss-diary-user span{display:block;font-size:10px;color:#8b98aa;margin-top:2px}
.ss-diary-msgs{flex:1;min-height:0;padding:12px 12px 4px;display:flex;flex-direction:column;justify-content:flex-end;gap:11px;overflow:hidden}
.ss-bub{max-width:78%;border-radius:13px;padding:10px 12px;display:flex;flex-direction:column;gap:6px}
.ss-bub.in{align-self:flex-start;background:#fff;border:1px solid rgba(120,140,170,.16);box-shadow:0 3px 8px rgba(120,140,170,.1)}
.ss-bub.out{align-self:flex-end;background:#dbe6fb;border:1px solid rgba(120,140,170,.1)}
.ss-bub .sk{display:block;height:6px;border-radius:4px;background:#dfe4ec}
.ss-bub.out .sk{background:#c3d3ee}
.ss-bub .sk.w1{width:150px;max-width:100%}
.ss-bub .sk.w2{width:96px}
.ss-bub .sk.w3{width:120px}
.ss-bub.real{padding:9px 14px;font-size:13px;color:#354052;background:#fff;border:1px solid rgba(120,140,170,.2)}
.ss-diary-input{flex:0 0 auto;margin:4px 10px 10px;display:flex;align-items:center;gap:8px}
.ss-diary-input .box{flex:1;min-width:0;background:#fff;border:1px solid rgba(120,140,170,.18);border-radius:13px;padding:11px 13px;font-size:12.5px;color:#3a4454;box-shadow:0 3px 8px rgba(120,140,170,.1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ss-diary-input .send{flex:0 0 auto;padding:10px 13px;border-radius:13px;background:linear-gradient(180deg,#c6d5ee,#adbfe3);color:#fff;font-size:11.5px;letter-spacing:.3px}

/* ---- 皮肤：唱片 ---- */
.ss-skin-music{background:radial-gradient(circle at 50% 26%,#3d3149 0%,#231c2c 55%,#15111b 100%);padding:calc(42px + var(--mochi-safe-top, 0px)) 20px 20px;display:flex;flex-direction:column;align-items:center;color:#ece5f5}
.ss-mu-title{font-size:11.5px;letter-spacing:2px;color:rgba(236,229,245,.4);flex:0 0 auto}
.ss-disc{width:136px;height:136px;border-radius:50%;margin:18px 0 6px;position:relative;flex:0 0 auto;background:repeating-radial-gradient(circle at 50% 50%,#2a2233 0 2px,#1d1724 2px 4px);box-shadow:0 14px 34px rgba(0,0,0,.45)}
.ss-disc::before{content:'';position:absolute;inset:38px;border-radius:50%;background:linear-gradient(140deg,#f0c9d8,#b28ad6);box-shadow:inset 0 0 12px rgba(0,0,0,.25)}
.ss-disc::after{content:'';position:absolute;left:50%;top:50%;width:8px;height:8px;margin:-4px 0 0 -4px;border-radius:50%;background:#15111b}
.ss-disc.spin{animation:ssSpin 9s linear infinite}
@keyframes ssSpin{to{transform:rotate(360deg)}}
.ss-mu-song{margin-top:14px;font-size:15px;font-weight:600;letter-spacing:.5px;flex:0 0 auto}
.ss-mu-artist{margin-top:4px;font-size:11px;color:rgba(236,229,245,.45);flex:0 0 auto}
.ss-mu-lyric{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:9px;font-size:12.5px;color:rgba(236,229,245,.38);line-height:1.8;text-align:center;padding:8px 0;overflow:hidden}
.ss-mu-lyric b{color:#f0e9f8;font-weight:500;font-size:13.5px}
.ss-mu-bar{width:100%;height:3px;border-radius:99px;background:rgba(255,255,255,.13);overflow:hidden;flex:0 0 auto;margin-top:6px}
.ss-mu-bar i{display:block;height:100%;background:linear-gradient(90deg,#e7c7dd,#b39ae0);width:36%;border-radius:99px;transition:width .4s linear}
.ss-mu-times{width:100%;display:flex;justify-content:space-between;font-size:9.5px;color:rgba(236,229,245,.34);margin-top:6px;flex:0 0 auto}
.ss-mu-draft{margin-top:12px;width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:13px;padding:11px 13px;font-size:12px;color:rgba(236,229,245,.72);min-height:42px;flex:0 0 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.ss-term-av svg,.ss-diary-av svg{width:18px;height:18px}


/* ===== v29 同屏（用户直派「按截图提示、照视频效果来做；草稿箱可以点击」）
   参考截图/视频的口径：整页深色、卡片半透明毛玻璃、标题楷体字距大、按钮灰底白字、
   进度条细线 + 「正在发送给 X…」、三步骤带 1/3 2/3 3/3；
   终端右下加信封（草稿箱，带橙色未读数）+ [Enter]，点信封弹出 TA 的草稿箱。 ===== */
#page-screen-share{background:radial-gradient(120% 78% at 50% -6%,#202024 0%,#141416 46%,#0b0b0d 100%)}
#page-screen-share .chat-head{background:transparent;border-bottom:0;box-shadow:none;padding:6px 14px 10px}
#page-screen-share .ch-back{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.16)}
#page-screen-share .ch-back svg{stroke:#f2f2f2}
#page-screen-share .ss-x{color:rgba(255,255,255,.62)}
#page-screen-share .ss-x:active{background:rgba(255,255,255,.1)}
/* 浅色皮肤（日记）时头部切成深色字，否则「同屏」会白到看不见 */
#page-screen-share.light{background:#eef3fb}
#page-screen-share.light .ss-head-t{color:rgba(43,53,70,.52)}
#page-screen-share.light .ch-back{background:rgba(43,53,70,.06);border-color:rgba(43,53,70,.16)}
#page-screen-share.light .ch-back svg{stroke:#2b3546}
#page-screen-share.light .ss-x{color:rgba(43,53,70,.5)}
#page-screen-share.light .ss-x:active{background:rgba(43,53,70,.08)}
.ss-head-t{flex:1;text-align:center;font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;font-size:13px;letter-spacing:4px;color:rgba(255,255,255,.5)}

.ss-hero{background:linear-gradient(168deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,.08) 48%,rgba(255,255,255,.05) 100%);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);border-radius:30px;padding:22px 20px 20px;box-shadow:0 28px 62px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.16)}
.ss-hero::after{border-radius:30px;border-color:rgba(255,255,255,.13)}
.ss-tag{font-size:10.5px;letter-spacing:3.2px;color:rgba(255,255,255,.32);margin-bottom:7px}
.ss-illus{width:186px;height:186px}
.ss-title{font-family:"Kaiti SC","STKaiti","KaiTi","楷体",Georgia,serif;font-size:22px;font-weight:500;letter-spacing:4.5px;margin:16px 0 10px;color:#f7f5f2}
.ss-desc{font-size:11px;line-height:2.2;letter-spacing:1.5px;color:rgba(255,255,255,.35);padding:0 4px}
.ss-field{background:rgba(255,255,255,.055);border-color:rgba(255,255,255,.13);border-radius:15px;padding:14px 15px;margin:18px 0 12px;font-size:12.5px}
.ss-field b{font-weight:500;letter-spacing:.5px;color:rgba(255,255,255,.9)}
.ss-field i{font-size:10px;letter-spacing:1px}
.ss-main{background:rgba(255,255,255,.13);color:rgba(255,255,255,.86);border:1px solid rgba(255,255,255,.15);font-weight:500;letter-spacing:2.5px;font-size:14px;height:48px}
.ss-main[disabled]{background:rgba(255,255,255,.09);color:rgba(255,255,255,.4);border-color:rgba(255,255,255,.09)}
.ss-prog{height:3px;background:rgba(255,255,255,.1);margin:12px 2px 0}
.ss-prog i{background:linear-gradient(90deg,rgba(255,255,255,.55),#f6f4f1)}
.ss-sending{text-align:center;font-size:10px;letter-spacing:1.8px;color:rgba(255,255,255,.28);margin-top:9px}
.ss-steps{margin-top:18px;padding:0 6px;font-size:10px;letter-spacing:1.2px;color:rgba(255,255,255,.24)}
.ss-steps i{display:flex;flex-direction:column;align-items:center;gap:5px;font-style:normal}
.ss-steps i em{font-style:normal;font-size:8.5px;letter-spacing:.8px;color:rgba(255,255,255,.18)}
.ss-steps i.on em{color:rgba(255,255,255,.42)}

/* 已连接页：深色 */
.ss-conn-h{color:#f4f2ef;font-weight:500;letter-spacing:1px}
.ss-conn-h span{color:#5fd39a;font-size:10.5px;letter-spacing:1.5px}
.ss-conn-sub{color:rgba(255,255,255,.4);font-size:11.5px;letter-spacing:.8px;line-height:1.85}
.ss-shot{border-radius:18px;background:#111113;border:1px solid rgba(255,255,255,.09);box-shadow:0 20px 44px rgba(0,0,0,.6)}
.ss-shot-row button{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.14);color:rgba(255,255,255,.76);border-radius:14px;font-size:12px;letter-spacing:1px}
.ss-ask{background:rgba(255,255,255,.045);border-color:rgba(255,255,255,.1);border-radius:20px}
.ss-ask p{color:rgba(255,255,255,.7);font-size:12px;letter-spacing:.8px}
.ss-ask button{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.14);color:rgba(255,255,255,.82);font-size:12.5px;letter-spacing:1px}
.ss-ask button.pri{background:#f4f2ef;color:#141416;border-color:#f4f2ef;font-weight:600}
.ss-skin-note{color:rgba(255,255,255,.38);font-size:10.5px;letter-spacing:1px}
.ss-skin-note b{color:rgba(255,255,255,.78)}
.ss-switch{color:rgba(255,255,255,.5)}

/* 终端底栏：草稿箱信封 + [Enter] */
.ss-term-lines{padding-bottom:6px}
.ss-term-bot{display:flex;align-items:flex-end;gap:10px;padding:4px 10px 8px;flex:0 0 auto}
.ss-term-bot .ss-term-prompt{flex:1;min-width:0;padding:0;font-size:12.5px;overflow:hidden}
.ss-term-act{display:flex;flex-direction:column;align-items:center;gap:7px;flex:0 0 auto}
.ss-mail{position:relative;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.13);color:rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:inherit;padding:0}
.ss-mail svg{width:16px;height:16px}
.ss-mail:active{background:rgba(255,255,255,.12);color:#fff}
.ss-mail-badge{position:absolute;top:-3px;right:-4px;min-width:15px;height:15px;padding:0 4px;border-radius:99px;background:#f0a24a;color:#151517;font-size:9px;font-style:normal;font-weight:700;line-height:15px;text-align:center;box-shadow:0 0 0 2px #0d0d0f}
.ss-mail-badge[hidden]{display:none}
.ss-enter{padding:5px 10px;border-radius:5px;border:1px solid rgba(240,162,74,.6);background:rgba(240,162,74,.09);color:#f0a24a;font-size:10.5px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.4px;cursor:pointer}
.ss-enter:active{background:rgba(240,162,74,.22)}
.ss-term-foot{justify-content:flex-start;gap:8px}
.ss-term-foot .dotc{width:5px;height:5px;border-radius:50%;background:#191919;opacity:.55;flex:0 0 5px}

/* TA 的小心情气泡 */
.ss-nudge{position:absolute;right:16px;bottom:32%;max-width:66%;background:rgba(26,26,30,.97);border:1px solid rgba(255,255,255,.13);border-radius:15px;padding:9px 12px 10px;box-shadow:0 14px 34px rgba(0,0,0,.55);opacity:0;transform:translateY(10px);transition:opacity .45s ease,transform .45s ease;pointer-events:none;z-index:5}
.ss-nudge.on{opacity:1;transform:none}
.ss-nudge em{display:block;font-style:normal;font-size:9.5px;letter-spacing:1.2px;color:rgba(255,255,255,.34);margin-bottom:5px}
.ss-nudge span{font-size:12.5px;line-height:1.55;color:rgba(246,244,241,.92);word-break:break-word}
.ss-screen.ss-light .ss-nudge{background:rgba(255,255,255,.97);border-color:rgba(120,140,170,.22);box-shadow:0 14px 34px rgba(120,140,170,.3)}
.ss-screen.ss-light .ss-nudge em{color:rgba(58,68,84,.42)}
.ss-screen.ss-light .ss-nudge span{color:#2c3646}

/* 日记 / 唱片里的草稿箱入口 */
.ss-db-chip{display:inline-flex;align-items:center;gap:5px;font-size:9.5px;letter-spacing:1px;color:rgba(255,255,255,.4);background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:99px;padding:4px 10px;cursor:pointer;flex:0 0 auto}
.ss-db-chip:active{background:rgba(255,255,255,.14)}
.ss-db-chip i{font-style:normal;letter-spacing:1px}
.ss-diary-drafts{display:flex;justify-content:flex-end;gap:8px;padding:0 12px 6px;flex:0 0 auto}
.ss-screen.ss-light .ss-diary-drafts .ss-db-chip{color:rgba(58,68,84,.55);background:rgba(255,255,255,.72);border-color:rgba(120,140,170,.2)}
.ss-mu-drafts{display:flex;justify-content:center;gap:8px;margin-top:8px;flex:0 0 auto}

/* 草稿箱抽屉 */
.ss-drafts{position:absolute;inset:0;z-index:42;display:flex;flex-direction:column;justify-content:flex-end}
.ss-drafts[hidden]{display:none}
.ss-drafts-mask{position:absolute;inset:0;background:rgba(0,0,0,.5);-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px);animation:ssFade .26s ease}
.ss-drafts-sheet{position:relative;background:#1b1b1f;border-radius:24px 24px 0 0;border-top:1px solid rgba(255,255,255,.1);max-height:78%;display:flex;flex-direction:column;padding:16px 18px calc(14px + env(safe-area-inset-bottom,0px));animation:ssUp .34s cubic-bezier(.22,.8,.24,1);box-shadow:0 -20px 54px rgba(0,0,0,.65)}
.ss-drafts-head{display:flex;align-items:baseline;gap:9px;flex:0 0 auto;padding-bottom:11px;border-bottom:1px solid rgba(255,255,255,.07)}
.ss-drafts-head b{font-size:14.5px;letter-spacing:2px;color:#f4f2ef;font-weight:600}
.ss-drafts-head i{font-style:normal;font-size:9.5px;letter-spacing:1.2px;color:rgba(255,255,255,.3)}
.ss-drafts-all{margin-left:auto;font-size:10px;letter-spacing:1.4px;color:rgba(255,255,255,.42);padding:4px 9px;border-radius:99px;border:1px solid rgba(255,255,255,.11);cursor:pointer;align-self:center;flex:0 0 auto}
.ss-drafts-all.on{color:#f0a24a;border-color:rgba(240,162,74,.45);background:rgba(240,162,74,.1)}
.ss-drafts-x{margin-left:0;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.45);font-size:13px;cursor:pointer;align-self:center;flex:0 0 26px}
.ss-drafts-x:active{background:rgba(255,255,255,.1)}
.ss-drafts-list{flex:1;min-height:0;overflow-y:auto;padding:2px 0;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.ss-drafts-list::-webkit-scrollbar{display:none}
.ss-draft{display:flex;gap:11px;align-items:flex-start;padding:12px 2px 13px;border-bottom:1px dashed rgba(255,255,255,.07);cursor:pointer}
.ss-draft:last-child{border-bottom:0}
.ss-draft-ck{width:17px;height:17px;border-radius:50%;border:1px solid rgba(255,255,255,.22);flex:0 0 17px;margin-top:1px;position:relative;transition:background .18s,border-color .18s}
.ss-draft.on .ss-draft-ck{background:#f0a24a;border-color:#f0a24a}
.ss-draft.on .ss-draft-ck::after{content:'';position:absolute;left:5.5px;top:3px;width:5px;height:8px;border-right:1.7px solid #17171a;border-bottom:1.7px solid #17171a;transform:rotate(42deg)}
.ss-draft-b{flex:1;min-width:0}
.ss-draft.on .ss-draft-x{color:rgba(255,255,255,.55)}
.ss-draft-t{font-size:9px;letter-spacing:1.3px;color:rgba(255,255,255,.24);margin-bottom:6px}
.ss-draft-x{font-size:13px;line-height:1.65;color:rgba(246,244,241,.9);word-break:break-word}
.ss-drafts-empty{padding:34px 0;text-align:center;font-size:11.5px;letter-spacing:1.4px;color:rgba(255,255,255,.28)}
.ss-drafts-tools{flex:0 0 auto;display:flex;gap:9px;padding-top:12px}
.ss-drafts-del{flex:1;height:42px;border-radius:13px;border:1px solid rgba(240,120,110,.4);background:rgba(240,120,110,.11);color:#f08b82;font-size:12.5px;letter-spacing:2px;font-weight:500;font-family:inherit;cursor:pointer}
.ss-drafts-del[disabled]{border-color:rgba(255,255,255,.1);background:rgba(255,255,255,.045);color:rgba(255,255,255,.28);cursor:default}
.ss-drafts-del:not([disabled]):active{background:rgba(240,120,110,.24)}
.ss-drafts-foot{flex:0 0 auto;padding-top:9px;font-size:9.5px;letter-spacing:.9px;color:rgba(255,255,255,.2);text-align:center}
/* ===== 皮肤：字卡库（v31：同屏＝看 TA 在字卡库里挑一句话） ===== */
.ss-skin-cards{background:radial-gradient(120% 72% at 50% -8%,#232329 0%,#16161a 46%,#0b0b0d 100%);padding:calc(40px + var(--mochi-safe-top,0px)) 16px 12px;display:flex;flex-direction:column;color:#f2f0ed}
.ss-cc-hd{display:flex;align-items:baseline;gap:9px;flex:0 0 auto}
.ss-cc-t{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;font-size:19px;letter-spacing:4px;color:#f6f4f1}
.ss-cc-n{font-style:normal;font-size:9px;letter-spacing:1.3px;color:rgba(255,255,255,.3)}
.ss-cc-sub{margin-top:8px;font-size:10.5px;line-height:1.9;letter-spacing:1.1px;color:rgba(255,255,255,.3);flex:0 0 auto}
.ss-cc-box{margin-top:13px;display:flex;align-items:center;gap:9px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:12px 13px;flex:0 0 auto;transition:border-color .2s,background .2s}
.ss-cc-box.focus{border-color:rgba(240,162,74,.5);background:rgba(255,255,255,.075)}
.ss-cc-box svg{width:15px;height:15px;color:rgba(255,255,255,.34);flex:0 0 15px}
.ss-cc-input{flex:1;min-width:0;width:100%;background:transparent;border:0;outline:0;color:#f7f5f2;font-size:14px;letter-spacing:.8px;font-family:inherit;padding:0;caret-color:#f0a24a;-webkit-user-select:text;user-select:text}
.ss-cc-input::placeholder{color:rgba(255,255,255,.24);letter-spacing:1.2px}
.ss-cc-tags{display:flex;gap:7px;margin-top:10px;overflow-x:auto;flex:0 0 auto;padding-bottom:2px;scrollbar-width:none}
.ss-cc-tags::-webkit-scrollbar{display:none}
.ss-cc-tags span{flex:0 0 auto;font-size:10px;letter-spacing:1.1px;color:rgba(255,255,255,.44);background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:99px;padding:5px 11px;cursor:pointer}
.ss-cc-tags span:active{background:rgba(255,255,255,.12);color:#fff}
.ss-cc-list{flex:1;min-height:0;overflow-y:auto;margin-top:12px;display:flex;flex-direction:column;gap:9px;padding-bottom:4px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.ss-cc-list::-webkit-scrollbar{display:none}
.ss-card{position:relative;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:15px;padding:11px 14px 12px;cursor:pointer;animation:ssCardIn .42s cubic-bezier(.22,.8,.24,1) both;transition:border-color .2s,background .2s}
.ss-card:active{background:rgba(255,255,255,.08)}
.ss-card.on{border-color:rgba(240,162,74,.5);background:rgba(240,162,74,.09);box-shadow:0 0 0 1px rgba(240,162,74,.16)}
.ss-card-head{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.ss-card-head i{font-style:normal;font-size:8.5px;letter-spacing:1.4px;color:rgba(255,255,255,.26);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ss-card.on .ss-card-head i{color:rgba(240,162,74,.7)}
.ss-card-head em{font-style:normal;margin-left:auto;font-size:8px;letter-spacing:1px;color:rgba(255,255,255,.2);flex:0 0 auto}
.ss-card-b{font-size:13px;line-height:1.72;color:rgba(246,244,241,.92);word-break:break-word}
.ss-card-b b{font-weight:400;color:#f0a24a;background:rgba(240,162,74,.12);border-radius:3px;padding:0 1px}
.ss-cc-more{display:flex;align-items:center;gap:10px;font-size:9px;letter-spacing:1.6px;color:rgba(255,255,255,.24);padding:12px 0 2px}
.ss-cc-more::before,.ss-cc-more::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.07)}
.ss-cc-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:9px;padding:46px 0 20px;text-align:center}
.ss-cc-empty b{font-size:12px;letter-spacing:1.4px;color:rgba(255,255,255,.34);font-weight:400}
.ss-cc-empty span{font-size:10px;letter-spacing:1px;color:rgba(255,255,255,.2);line-height:1.9}
.ss-cc-bar{display:flex;gap:9px;align-items:center;flex:0 0 auto;padding-top:11px;border-top:1px solid rgba(255,255,255,.07);margin-top:10px}
.ss-cc-db{position:relative;flex:0 0 auto;display:flex;align-items:center;gap:6px;height:44px;padding:0 14px;border-radius:14px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:rgba(255,255,255,.6);font-size:10.5px;letter-spacing:1.4px;font-family:inherit;cursor:pointer}
.ss-cc-db:active{background:rgba(255,255,255,.12)}
.ss-cc-db svg{width:15px;height:15px}
.ss-cc-db i{position:absolute;top:-4px;right:-4px;min-width:15px;height:15px;padding:0 4px;border-radius:99px;background:#f0a24a;color:#151517;font-size:9px;font-style:normal;font-weight:700;line-height:15px;text-align:center;box-shadow:0 0 0 2px #101012}
.ss-cc-db i[hidden]{display:none}
.ss-cc-use{flex:1;height:44px;border-radius:14px;border:1px solid rgba(240,162,74,.42);background:rgba(240,162,74,.13);color:#f4b06a;font-size:13px;letter-spacing:2.5px;font-weight:500;font-family:inherit;cursor:pointer;transition:opacity .2s}
.ss-cc-use[disabled]{border-color:rgba(255,255,255,.1);background:rgba(255,255,255,.04);color:rgba(255,255,255,.34);cursor:default}
.ss-cc-use:not([disabled]):active{background:rgba(240,162,74,.24)}
@keyframes ssCardIn{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}

/* 其他皮肤里的「字卡」入口 */
.ss-cards-btn{position:relative;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.13);color:rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:inherit;padding:0}
.ss-cards-btn:active{background:rgba(255,255,255,.12);color:#fff}
.ss-cards-btn svg{width:15px;height:15px}
.ss-db-chip.on{border-color:rgba(240,162,74,.4);color:rgba(240,162,74,.85)}

@keyframes ssUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes ssFade{from{opacity:0}to{opacity:1}}

@font-face{font-family:'SSKai';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2')}

/* v29：手写楷体（霞鹜文楷子集，仅同屏页用字）——对齐参考截图里那种细笔画标题 */
.ss-title{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;font-size:23px;font-weight:400;letter-spacing:5px;margin:20px 0 14px;color:#f7f5f2}
.ss-desc{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;font-size:12px;line-height:2.25;letter-spacing:1.6px;color:rgba(255,255,255,.36)}
.ss-tag{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;font-size:11px;letter-spacing:3.6px;color:rgba(255,255,255,.34)}
.ss-field span,.ss-field i{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;letter-spacing:1.2px}
.ss-main{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;font-size:14.5px;letter-spacing:3px}
.ss-sending{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;letter-spacing:2px}
.ss-steps i{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;letter-spacing:1.6px}
.ss-conn-h,.ss-conn-sub{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif;letter-spacing:1.4px}
.ss-ask p{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif}
.ss-drafts-head b,.ss-drafts-foot{font-family:'SSKai',"Kaiti SC","STKaiti",Georgia,serif}

/* v29：卡片撑满一屏，内容按参考的呼吸感分布（步骤贴底） */
.ss-hero{display:flex;flex-direction:column;padding:24px 20px 20px}
.ss-hero-top,.ss-hero-mid,.ss-hero-bottom{flex:0 0 auto}
.ss-tag{margin-bottom:12px}
.ss-illus{margin:0 auto}
.ss-title{margin:32px 0 16px}
.ss-field{margin:26px 0 16px;padding:15px 16px}
.ss-main{height:52px;margin-top:0}
.ss-prog{margin:16px 2px 0}
.ss-sending{margin-top:11px}
.ss-steps{padding:32px 6px 0}


/* v29 细节：行内打字转蓝、日记头像、草稿箱胶囊留白 */
.ss-ln .txt{color:#7fb0e2;letter-spacing:.6px}
.ss-bub.in,.ss-bub.real{position:relative;margin-left:34px}
.ss-bub.in::before,.ss-bub.real::before{content:'';position:absolute;left:-34px;top:1px;width:26px;height:26px;border-radius:50%;border:1px solid rgba(0,0,0,.28);background:#141414 url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Ccircle cx='20' cy='20' r='20' fill='%23141414'/%3E%3Cpath d='M12.2 18.4l1.9-5.1 4.2 3h3.4l4.2-3 1.9 5.1v3.2c0 4.1-3.5 7.1-7.8 7.1s-7.8-3-7.8-7.1z' fill='%23ffffff'/%3E%3Ccircle cx='17' cy='19.2' r='1.5' fill='%23141414'/%3E%3Ccircle cx='23' cy='19.2' r='1.5' fill='%23141414'/%3E%3Cpath d='M18.6 22.6c.9.7 1.9.7 2.8 0' fill='none' stroke='%23141414' stroke-width='1.1' stroke-linecap='round'/%3E%3C/svg%3E") center/86% no-repeat;box-shadow:0 1px 3px rgba(120,140,170,.22)}}
.ss-drafts-sheet{padding-bottom:calc(20px + env(safe-area-inset-bottom,0px))}
.ss-mu-drafts{margin-bottom:6px}


/* v29：皮肤模式铺满头部以下；皮肤顶部留白相应收窄 */
.ss-scroll.ss-mode{padding:0;overflow:hidden}
.ss-screen{position:relative;inset:auto;height:100%;flex:1;min-height:0}
.ss-skin-term{padding:10px 12px 10px}
.ss-skin-diary{padding:12px 14px 12px}
.ss-skin-music{padding:14px 20px 14px}
.ss-term-win{border-radius:10px}

</style>
<style id="mochi-offline-fallback">
#mochi-go:target ~ .splash { display:none !important; }
#mochi-go:target ~ .phone { visibility:visible !important; opacity:1 !important; }
.mochi-offline-enter { display:block; width:min(324px,100%); box-sizing:border-box; margin:12px auto 4px; padding:12px 14px; border-radius:12px; background:#111; color:#fff; font-size:13px; font-weight:800; text-align:center; text-decoration:none; letter-spacing:.5px; }
[data-theme="dark"] .mochi-offline-enter { background:#f0f0f0; color:#111; }
</style>

<style id="op-v61-style">
/* ============ v61：聊天跨天日期常驻标签 ============ */
.msg-day-tag{position:relative;z-index:2;display:flex;justify-content:center;margin:10px 0 10px;pointer-events:none}
.msg-day-tag span{background:rgba(255,255,255,.92);border:1px solid rgba(0,0,0,.07);border-radius:999px;padding:4px 14px;font-size:10.5px;color:#5a5a5a;letter-spacing:.5px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
[data-theme="dark"] .msg-day-tag span{background:rgba(32,32,34,.94);border-color:rgba(255,255,255,.12);color:#e2e2e2}
/* ============ v61：收藏置顶 / 置底 ============ */
.fav-pin-bar{display:flex;align-items:center;justify-content:center;gap:18px;width:100%;margin:8px 0 10px;padding:2px 0;background:transparent}
.fav-out .fav-pin-bar{background:transparent}
.fav-pin-btn{width:34px;height:34px;display:flex;align-items:center;justify-content:center;padding:0;border:1px solid rgba(0,0,0,.10);background:#fff;color:#3a3a3a;border-radius:50%;font-family:inherit;cursor:pointer;transition:transform .12s}
.fav-pin-btn svg{width:17px;height:17px}
.fav-pin-btn:active{transform:scale(.92)}
.fav-pin-btn.on{background:#111;color:#fff;border-color:#111}
[data-theme="dark"] .fav-pin-bar{background:transparent}
[data-theme="dark"] .fav-pin-btn{background:#232326;border-color:rgba(255,255,255,.16);color:#e2e2e2}
[data-theme="dark"] .fav-pin-btn.on{background:#f0f0f0;color:#111;border-color:#f0f0f0}
/* ============ v61：开屏界面 ============ */
#page-opening{position:absolute;inset:0;z-index:60;padding:0!important;margin:0;background:var(--op-bg,#ffffff);overflow:hidden;display:block;transition:opacity .34s ease}
#page-opening[hidden]{display:none!important}
#page-opening.op-leaving{opacity:0;pointer-events:none}
.op-enter-hint{position:absolute;left:0;right:0;top:62%;transform:translateY(-50%);z-index:5;text-align:center;color:rgba(255,255,255,.95);font-size:12.5px;letter-spacing:2px;pointer-events:none;text-shadow:0 2px 14px rgba(0,0,0,.85);animation:opEnterPulse 2.2s ease-in-out infinite}
.op-enter-hint b{display:block;font-size:15px;font-weight:500;letter-spacing:7px;margin-bottom:7px}
.op-enter-hint small{display:block;font-size:10.5px;letter-spacing:1px;color:rgba(255,255,255,.62);margin-top:9px}
@keyframes opEnterPulse{0%,100%{opacity:.55}50%{opacity:1}}
.op-stage{position:absolute;inset:0;overflow:hidden;background:var(--op-bg,#ffffff)}
.op-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none}
.op-video.on,.op-image.on{display:block}
.op-fallback{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:var(--op-bg,#ffffff);color:var(--op-load-text,#111111)}
.op-fallback.on{display:flex}
.op-fb-in{text-align:center;color:rgba(255,255,255,.9)}
.op-fb-in b{display:block;font-size:34px;letter-spacing:8px;font-weight:300;margin-bottom:10px}
.op-fb-in span{font-size:11.5px;color:rgba(255,255,255,.55);letter-spacing:1px}
.op-shade{display:none}
.op-top{position:absolute;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:calc(env(safe-area-inset-top,0px) + 14px) 14px 10px;color:#fff;z-index:3}
.op-top button{display:flex;align-items:center;gap:5px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);color:#fff;font-family:inherit;font-size:11.5px;padding:7px 12px;border-radius:999px;cursor:pointer;backdrop-filter:blur(8px)}
.op-top button svg{width:14px;height:14px}
.op-tt{font-size:13px;letter-spacing:3px;font-weight:600;text-shadow:0 2px 10px rgba(0,0,0,.5)}
.op-now{position:absolute;top:calc(env(safe-area-inset-top,0px) + 66px);left:16px;right:16px;z-index:3;color:#fff;display:flex;flex-direction:column;gap:3px;text-shadow:0 1px 8px rgba(0,0,0,.7)}
.op-now-k{font-size:10px;letter-spacing:2px;color:rgba(255,255,255,.7)}
.op-now-v{font-size:15px;font-weight:600;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.op-now-m{font-size:11px;color:rgba(255,255,255,.75);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.op-ctrls{position:absolute;left:12px;right:12px;bottom:86px;z-index:3;display:flex;flex-wrap:wrap;gap:7px;align-items:center;justify-content:center}
.op-seg{display:flex;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.17);border-radius:999px;padding:3px;backdrop-filter:blur(10px)}
.op-seg button{border:0;background:transparent;color:rgba(255,255,255,.72);font-size:10.5px;padding:6px 10px;border-radius:999px;cursor:pointer;font-family:inherit;white-space:nowrap;transition:.2s}
.op-seg button.on{background:#fff;color:#111;font-weight:600}
.op-act{border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.12);color:#fff;font-family:inherit;font-size:10.5px;padding:9px 13px;border-radius:999px;cursor:pointer;backdrop-filter:blur(10px)}
.op-load{position:absolute;right:14px;bottom:16px;z-index:4;width:152px;padding:10px 12px;border-radius:14px;background:rgba(12,12,14,.55);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(12px);color:#fff;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.op-load-top{display:flex;align-items:baseline;justify-content:space-between;gap:6px}
.op-load-label{font-size:10.5px;letter-spacing:.5px;color:rgba(255,255,255,.85);white-space:nowrap}
.op-load-num{font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:.5px}
.op-load-track{height:4px;background:rgba(255,255,255,.2);border-radius:99px;overflow:hidden;margin-top:7px}
.op-load-track i{display:block;height:100%;width:0;background:var(--op-load-bar,#111111);border-radius:99px;transition:width .1s linear}
.op-load.done .op-load-track i{background:var(--op-load-done,#1e8e5a)}
.op-load.done .op-load-num{color:#9be7bb}
.op-panel{position:absolute;inset:0;z-index:20;background:rgba(12,12,14,.97);color:#f0f0f0;display:flex;flex-direction:column}
.op-panel[hidden]{display:none!important}
.op-panel-hd{display:flex;align-items:center;justify-content:space-between;padding:calc(env(safe-area-inset-top,0px) + 16px) 16px 12px;border-bottom:1px solid rgba(255,255,255,.09)}
.op-panel-hd b{font-size:15px;letter-spacing:1px}
.op-panel-hd button{border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.08);color:#eee;font-family:inherit;font-size:11px;padding:6px 14px;border-radius:999px;cursor:pointer}
/* v84（用户直派「开屏搭配的界面把返回键换到左上角」） */
.op-panel-hd{justify-content:flex-start;gap:10px}
.op-panel-hd .op-panel-back{width:32px;height:32px;padding:0;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;flex:none}
.op-panel-hd .op-panel-back svg{width:18px;height:18px}
.op-panel-hd .op-panel-sp{width:32px;flex:none}
/* v85：恢复开屏提示动画与淡出过渡 */
.op-panel-scroll{flex:1;overflow-y:auto;padding:14px 14px 46px;-webkit-overflow-scrolling:touch}
.op-tip{font-size:11px;line-height:1.65;color:#b9b9c2;background:rgba(126,224,164,.08);border:1px solid rgba(126,224,164,.18);border-radius:12px;padding:10px 12px;margin-bottom:14px}
.op-zone{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:16px;padding:12px;margin-bottom:12px}
.op-zone-hd{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;-webkit-user-select:none;padding-bottom:9px;border-bottom:1px dashed rgba(255,255,255,.1)}
.op-zone-ico{width:22px;height:22px;border-radius:7px;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:12px}
.op-zone-name{font-size:14px;font-weight:600}
.op-zone-cnt{font-size:10px;color:#909098}
.op-zone-hint{margin-left:auto;font-size:10px;color:#8c8c96}
.op-zone-list{margin-top:9px;display:flex;flex-direction:column;gap:6px}
.op-item{display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.05);border-radius:10px;padding:8px 9px}
.op-item-name{flex:1;min-width:0;font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.op-item-tag{font-size:9px;color:#8c8c96;white-space:nowrap}
.op-item button{border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.07);color:#ddd;font-family:inherit;font-size:9.5px;padding:5px 8px;border-radius:8px;cursor:pointer;white-space:nowrap}
.op-item button.op-del{border-color:rgba(255,120,120,.3);color:#ffb3b3}
.op-item button.on{background:#fff;color:#111;border-color:#fff}
.op-zone-empty{font-size:11px;color:#8c8c96;padding:8px 2px}
.op-zone-add{margin-top:10px;width:100%;border:1px dashed rgba(255,255,255,.24);background:transparent;color:#dcdce2;font-family:inherit;font-size:11.5px;padding:9px;border-radius:10px;cursor:pointer}
.op-zone-tip{margin-top:6px;font-size:10.5px;line-height:1.55;color:rgba(255,255,255,.45)}
.op-next,.op-sec{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);border-radius:16px;padding:12px;margin-bottom:12px}
.op-sec-t{font-size:12.5px;font-weight:600;margin-bottom:8px;letter-spacing:.5px}
.op-next-row{display:flex;align-items:center;gap:8px;margin:8px 0}
.op-next-row label{width:40px;font-size:11px;color:#b5b5bd;flex:none}
.op-next-row select{flex:1;min-width:0;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);color:#eee;font-family:inherit;font-size:11.5px;padding:8px 9px;border-radius:9px}
.op-next-row select option{background:#222;color:#eee}
.op-next-btns{display:flex;gap:8px;margin-top:10px}
.op-next-btns button{flex:1;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.09);color:#eee;font-family:inherit;font-size:11px;padding:9px;border-radius:9px;cursor:pointer}
.op-next-btns button:first-child{background:#fff;color:#111;border-color:#fff;font-weight:600}
.op-next-tip{font-size:10.5px;line-height:1.6;color:#909098;margin-top:9px}
.op-sw{display:flex;align-items:center;gap:9px;font-size:11.5px;color:#d5d5dc;padding:7px 0}
.op-sw input{width:16px;height:16px;accent-color:#7ee0a4}
.op-tap-hint{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;z-index:3;color:rgba(255,255,255,.85);font-size:12px;letter-spacing:1px;pointer-events:none}
.op-pseg{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:14px}
.op-pseg .op-seg{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.13)}
.op-pseg .op-seg button.on{background:#f2f2f2;color:#151515}
/* ============ v64：开屏只留 画面 + 正在链接/连接成功，其余功能与提示全部隐藏。
   v65：从「设置 → 外观」进入配置模式时（.op-config）单独放行搭配面板；
   开屏展示态仍然只剩画面与进度，不回归任何按钮/提示。 ============ */
#page-opening .op-top,#page-opening .op-now,#page-opening .op-tap-hint,#page-opening .op-enter-hint,#page-opening .op-ctrls,#page-opening .op-fallback{display:none!important}
#page-opening:not(.op-config) .op-panel{display:none!important}
#page-opening.op-config .op-panel{display:flex!important}
#page-opening.op-config .op-load{display:none!important}
#page-opening .op-load-num{display:none}
/* ============ v65：设置 → 外观 · 全局字体选择器 ============ */
.fp-group{padding:12px 14px}
.fp-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:2px}
.fp-item{border:1px solid var(--pill-border,rgba(0,0,0,.12));border-radius:10px;background:var(--card-bg,rgba(255,255,255,.6));color:var(--ink,#111);padding:9px 13px;font-size:13px;cursor:pointer;-webkit-tap-highlight-color:transparent}
.fp-item.on{background:var(--ink,#111);color:var(--bg-b,#fff);border-color:transparent}
.fp-preview{margin-top:12px;font-size:14px;line-height:1.8;color:var(--ink,#111)}
#page-opening .op-load{left:50%;right:auto;bottom:calc(env(safe-area-inset-bottom,0px) + 38px);transform:translateX(-50%);width:min(78vw,320px);text-align:center;background:transparent;border:0;box-shadow:none;-webkit-backdrop-filter:none;backdrop-filter:none;padding:0}
#page-opening .op-load-top{justify-content:center}
#page-opening .op-load-label{font-size:12.5px;letter-spacing:3px;color:var(--op-load-text,#111111)}
#page-opening .op-load-track{height:2px;margin-top:11px;background:var(--op-load-track,rgba(0,0,0,.16))}
/* ============ v67：开屏补充 ============ */
/* 「正在链接…」与「连接成功…」颜色完全同步：文字/进度条都用同一组变量，完成时不再偷偷变绿 */
.op-load.done .op-load-track i{background:var(--op-load-bar,#111111)!important}
.op-load.done .op-load-num{color:inherit!important}
.op-load.done .op-load-label{color:var(--op-load-text,#111111)!important}
#page-opening .op-load-track i{background:var(--op-load-bar,#111111)}
/* v71：双击进入——禁掉移动端双击缩放/双击选中；进度条下面给一行极轻的操作提示 */
#page-opening .op-stage{touch-action:manipulation;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.op-tap-tip{margin-top:11px;font-size:11px;letter-spacing:1.2px;color:var(--op-load-text,#111111);opacity:.85;text-align:center;pointer-events:none;white-space:nowrap;text-shadow:0 0 5px rgba(255,255,255,.92),0 1px 2px rgba(255,255,255,.7)}
/* 开屏背景照片：垫在视频/图片下面，跟「图片＋音乐」任何搭配都不冲突 */
.op-bgimg{position:absolute;inset:0;z-index:0;background-position:center center;background-size:cover;background-repeat:no-repeat;pointer-events:none;display:none}
.op-bgimg.on{display:block}
.op-media{z-index:1}
/* 浅色主题：搭配面板跟随白底黑字（深色主题仍是原来的黑底白字） */
html:not([data-theme="dark"]) .op-panel{background:rgba(255,255,255,.985);color:#1b1b1f}
html:not([data-theme="dark"]) .op-panel-hd{border-bottom-color:rgba(0,0,0,.08)}
html:not([data-theme="dark"]) .op-panel-hd b{color:#1b1b1f}
html:not([data-theme="dark"]) .op-panel-hd button{border-color:rgba(0,0,0,.14);background:rgba(0,0,0,.04);color:#333}
html:not([data-theme="dark"]) .op-tip{background:rgba(40,150,90,.07);border-color:rgba(40,150,90,.18);color:#3c5a48}
html:not([data-theme="dark"]) .op-zone,
html:not([data-theme="dark"]) .op-next,
html:not([data-theme="dark"]) .op-sec{background:rgba(0,0,0,.028);border-color:rgba(0,0,0,.07)}
html:not([data-theme="dark"]) .op-zone-hd{border-bottom-color:rgba(0,0,0,.08)}
html:not([data-theme="dark"]) .op-zone-ico{background:rgba(0,0,0,.05)}
html:not([data-theme="dark"]) .op-zone-cnt,
html:not([data-theme="dark"]) .op-zone-hint,
html:not([data-theme="dark"]) .op-item-tag,
html:not([data-theme="dark"]) .op-zone-empty,
html:not([data-theme="dark"]) .op-next-tip{color:#8a8a92}
html:not([data-theme="dark"]) .op-item{background:rgba(0,0,0,.035)}
html:not([data-theme="dark"]) .op-item button{border-color:rgba(0,0,0,.12);background:rgba(0,0,0,.03);color:#333}
html:not([data-theme="dark"]) .op-item button.op-del{border-color:rgba(200,60,60,.28);color:#c0392b}
html:not([data-theme="dark"]) .op-item button.on{background:#111;color:#fff;border-color:#111}
html:not([data-theme="dark"]) .op-zone-add{border-color:rgba(0,0,0,.18);color:#444}
html:not([data-theme="dark"]) .op-zone-tip{color:rgba(0,0,0,.45)}
html:not([data-theme="dark"]) .op-next-row select{background:#fff;border-color:rgba(0,0,0,.14);color:#222}
html:not([data-theme="dark"]) .op-next-row select option{background:#fff;color:#222}
html:not([data-theme="dark"]) .op-next-btns button{border-color:rgba(0,0,0,.14);background:rgba(0,0,0,.04);color:#333}
html:not([data-theme="dark"]) .op-next-btns button:first-child{background:#111;color:#fff;border-color:#111}
html:not([data-theme="dark"]) .op-sw{color:#444}
html:not([data-theme="dark"]) .op-sec-t{color:#1b1b1f}
html:not([data-theme="dark"]) .op-pseg .op-seg{background:rgba(0,0,0,.05);border-color:rgba(0,0,0,.1)}
html:not([data-theme="dark"]) .op-pseg .op-seg button{color:#666}
html:not([data-theme="dark"]) .op-pseg .op-seg button.on{background:#111;color:#fff}
/* 搭配面板每条：名称一行，按钮一行（置顶 / 置底 / 下次 / 删除） */
.op-item{flex-direction:column;align-items:stretch;gap:6px}
.op-item-top{display:flex;align-items:center;gap:7px;min-width:0}
.op-item-btns{display:flex;gap:6px}
.op-item-btns button{flex:1;padding:6px 0}
/* ============ v68：置顶 / 置底按「音乐列表」那两个圆形箭头图标来做 + 按住拖动排序 ============ */
.op-item-act{display:flex;align-items:center;gap:5px;flex:0 0 auto;margin-left:auto}
.op-item .op-ibtn{width:26px;height:26px;flex:0 0 auto;border-radius:50%;padding:0!important;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.07);color:#ddd}
.op-item .op-ibtn svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.op-item .op-ibtn:active{background:rgba(255,255,255,.18)}
.op-item .op-grip{width:22px;height:22px;flex:0 0 auto;border:0!important;background:transparent!important;color:inherit;opacity:.45;padding:0!important;display:flex;align-items:center;justify-content:center;cursor:grab;touch-action:none}
.op-item .op-grip svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round}
.op-item .op-grip:active{cursor:grabbing;opacity:.85}
.op-item.dragging{opacity:.55;outline:1px dashed rgba(255,255,255,.3)}
/* ============ v70：置顶 / 置底从「每个条目右侧两个箭头」收进顶栏一个「排序」按钮 ============ */
.op-zone-sort{margin-left:6px;flex:0 0 auto;display:inline-flex;align-items:center;gap:3px;height:24px;padding:0 9px!important;border-radius:999px!important;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.07);color:#ddd;font-size:10px!important;line-height:1}
.op-zone-sort svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.op-zone-sort:active{background:rgba(255,255,255,.18)}
html:not([data-theme="dark"]) .op-zone-sort{border-color:rgba(0,0,0,.12);background:rgba(0,0,0,.03);color:#333}
html:not([data-theme="dark"]) .op-zone-sort:active{background:rgba(0,0,0,.07)}
#op-sort-panel{position:fixed;inset:0;z-index:320;display:none;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.45)}
#op-sort-panel.on{display:flex}
.ops-card{width:min(100%,480px);max-height:78vh;display:flex;flex-direction:column;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:18px 18px 0 0;padding:16px 14px calc(env(safe-area-inset-bottom,0px) + 16px);box-shadow:0 -8px 30px rgba(0,0,0,.25)}
.ops-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.ops-hd b{font-size:15px}
.ops-x{border:1px solid var(--card-border,#ddd);background:transparent;color:var(--ink,#111);font-family:inherit;font-size:12px;padding:5px 14px;border-radius:999px;cursor:pointer}
.ops-tip{font-size:11px;line-height:1.6;color:var(--muted,#888);margin-bottom:10px}
.ops-list{overflow-y:auto;-webkit-overflow-scrolling:touch;display:flex;flex-direction:column;gap:8px}
.ops-row{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:12px;background:rgba(0,0,0,.04)}
.ops-idx{flex:0 0 auto;width:18px;font-size:11px;color:var(--muted,#999);text-align:center}
.ops-nm{flex:1;min-width:0;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ops-act{flex:0 0 auto;border:1px solid rgba(0,0,0,.12);background:transparent;color:var(--ink,#111);font-family:inherit;font-size:11px;padding:5px 8px;border-radius:8px;white-space:nowrap;cursor:pointer;display:inline-flex;align-items:center;gap:3px}
.ops-act svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.ops-act:active{background:rgba(0,0,0,.06)}
.ops-empty{font-size:12px;color:var(--muted,#999);text-align:center;padding:22px 0}
[data-theme="dark"] .ops-row{background:rgba(255,255,255,.07)}
[data-theme="dark"] .ops-act{border-color:rgba(255,255,255,.16);color:#e8e8e8}
[data-theme="dark"] .ops-act:active{background:rgba(255,255,255,.12)}
html:not([data-theme="dark"]) .op-item .op-ibtn{border-color:rgba(0,0,0,.12);background:rgba(0,0,0,.03);color:#333}
html:not([data-theme="dark"]) .op-item .op-ibtn:active{background:rgba(0,0,0,.08)}
html:not([data-theme="dark"]) .op-item.dragging{outline-color:rgba(0,0,0,.25)}
/* 进入网站后的「开屏音乐」悬浮开关 */
.op-pill{position:fixed;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 74px);z-index:305;display:flex;align-items:center;gap:2px;padding:5px 6px 5px 10px;border-radius:999px;background:rgba(20,20,24,.78);color:#fff;border:1px solid rgba(255,255,255,.16);box-shadow:0 8px 22px rgba(0,0,0,.28);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-size:11.5px}
.op-pill[hidden]{display:none!important}
.op-pill button{border:0;background:transparent;color:inherit;font-family:inherit;cursor:pointer;display:flex;align-items:center;gap:5px;padding:3px 5px;font-size:11.5px}
.op-pill svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.op-pill .op-pill-x{opacity:.68;font-size:13px;padding:3px 6px}
/* 桌面图标分组（聚拢） */
.desk-folder{cursor:pointer}
.df-grid{width:52px;height:52px;border-radius:18px;background:rgba(0,0,0,.06);display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:3px;padding:5px;box-sizing:border-box}
.df-mini{display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:6px}
.df-mini svg{width:17px;height:17px;stroke:var(--ink);max-width:100%;max-height:100%}
.df-mini img{width:100%;height:100%;object-fit:cover;border-radius:6px}
.df-hold{display:none!important}
.dfx-mask{position:fixed;inset:0;z-index:9600;background:rgba(20,18,24,.42);display:flex;align-items:flex-end;justify-content:center;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.dfx-card{width:100%;max-width:430px;background:var(--card-bg,#fff);color:var(--ink,#111);border-radius:24px 24px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom,0px));box-shadow:0 -16px 44px rgba(0,0,0,.22)}
.dfx-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.dfx-hd b{font-size:15px}
.dfx-x{border:0;background:transparent;color:var(--muted,#999);font-size:19px;cursor:pointer}
.dfx-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px 8px;max-height:52vh;overflow:auto}
.dfx-item{display:flex;flex-direction:column;align-items:center;gap:5px;border:0;background:transparent;color:inherit;font-family:inherit;cursor:pointer;padding:4px 0}
.dfx-ico{width:48px;height:48px;border-radius:16px;background:rgba(0,0,0,.05);display:flex;align-items:center;justify-content:center}
.dfx-ico svg{width:26px;height:26px;stroke:var(--ink);max-width:100%;max-height:100%}
.dfx-ico img{width:100%;height:100%;object-fit:cover;border-radius:16px}
.dfx-nm{font-size:10.5px;color:var(--ink);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dfx-btns{display:flex;gap:8px;margin-top:14px}
.dfx-btns button{flex:1;height:42px;border-radius:12px;border:1px solid rgba(0,0,0,.12);background:rgba(0,0,0,.04);color:var(--ink);font-family:inherit;font-size:13px;cursor:pointer}
.dfx-btns #dfx-ungroup{color:#c0392b;border-color:rgba(200,60,60,.28)}
</style>

</head>
<body>
<a id="mochi-go" aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden"></a>
  <!-- 开屏加载动画 -->
  <div class="phone">
      <div class="phone-bg-mask"></div>
      <!-- v62（用户直派「截图3顶部栏内容全部删掉」）：只留空的状态栏占位，不再显示 Mochi / 时间 / 信号电量 -->
      <div class="statusbar" aria-hidden="true" style="min-height:30px"></div>

    <!-- 手机桌面（两页：情侣空间 + 音乐播放器） -->
    <div class="page" id="page-phone">
      <div class="decor-bar" id="decor-bar" hidden>
        <span>装修模式 · 点图标换图 · 点卡片设背景 · 点卡片弹设置（含组件颜色）</span>
        <button class="decor-add" id="decor-edit-layout">编辑布局</button>
        <button class="decor-add" id="decor-add-widget">+ 添加卡片</button>
        <button class="decor-add" id="decor-restore-icon">恢复图标</button>
        <!-- #962：桌面页自己的「屏幕适配微调」入口——长按桌面空白进装修模式后即可就地开面板边看边调
             （此前只有 设置→工具 一个入口，在设置列表后面根本看不见桌面/聊天现场＝盲调） -->
        <button class="decor-add" id="decor-fit" title="屏幕适配微调（顶部遮挡/底部裁切/留白/字太小）">屏幕适配</button>
        <!-- v82（用户直派「自动补位做成一个总开关放在整理模式工具栏里」） -->
        <button class="decor-add" id="decor-autofill" title="开＝拖完自动排整齐；关＝图标可以随便放不回流">自动补位</button>
        <button class="decor-done" id="decor-done">完成</button>
      </div>
      <div class="desktop-pages" id="desktop-pages">
      <div class="page-slide">
      <div class="deco-widget" id="deco-widget" data-desk-widget="deco" data-card-bg="deco">
        <div class="deco-avatars">
          <div class="deco-avatar" id="avatar-partner" title="设置「TA」的头像">
            <div class="ring"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></div>
            <span class="lbl" id="lbl-partner" title="点击修改昵称">TA</span>
          </div>
          <span class="deco-heart" id="deco-heart"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.7-9.3-9A5.3 5.3 0 0112 6.4a5.3 5.3 0 019.3 5.6c-1.8 4.3-9.3 9-9.3 9z"/></svg></span>
          <div class="deco-avatar" id="avatar-user" title="设置「我」的头像">
            <div class="ring"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-6 8-6s8 2 8 6"/></svg></div>
            <span class="lbl" id="lbl-user" title="点击修改昵称">我</span>
          </div>
        </div>
        <div class="deco-love"><span id="love-days"></span><span id="love-date"></span></div>
      </div>

      <div class="mini-row" data-desk-widget="quote-row">
            <div class="mini-card glass" data-card-bg="quote">
              <div class="mc-top">今日情话</div>
              <div class="mc-b" id="love-quote"></div>
            </div>
            <!-- v79（用户直派「第二页的四象限和第一页的日历换一下」）：四象限卡自第二页移到首页，接替日历卡 -->
            <div class="mini-card glass home-qd-card" data-card-bg="qd" id="home-qd-card" title="点击进入四象限">
              <div class="mc-top">四象限</div>
              <div class="mc-b" id="qd-card-text">今天还没有记录</div>
            </div>
          </div>

      <!-- v21（用户直派「截图3的距下次经期转到截图1的今日情话下」）：经期倒计时大卡自组件池移回，紧跟今日情话这一行 -->
      <div class="desk-period glass" data-desk-widget="desk-period" data-card-bg="desk-period">
        <div class="dpd-inner">
          <div class="dpd-label" id="dpd-label">经期</div>
          <div class="dpd-days" id="dpd-days">—</div>
          <div class="dpd-sub" id="dpd-sub">未记录</div>
        </div>
      </div>


      <!-- 桌面功能（直接显示） -->
      <div class="app-grid" data-app="main" data-desk-widget="apps">
        <div class="app" data-app="chat" data-desk-widget="app-chat">
          <div class="app-badge-box"><div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></div><span class="app-badge" id="chat-badge" hidden></span></div>
          <div class="app-name">聊天</div>
        </div>
        <div class="app" data-app="feed" data-desk-widget="app-feed">
          <div class="app-badge-box"><div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg></div><span class="app-badge" id="feed-app-badge" hidden></span></div>
          <div class="app-name">朋友圈</div>
        </div>
        <div class="app" data-app="divination" data-desk-widget="app-divination">
          <div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M12 8.5l1.15 2.4 2.4 1.15-2.4 1.15L12 15.6l-1.15-2.4-2.4-1.15 2.4-1.15z"/></svg></div>
          <div class="app-name">占卜</div>
        </div>
        <div class="app" data-app="note" data-desk-widget="app-note">
          <div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h11a1 1 0 011 1v16l-6.5-4-6.5 4v-16a1 1 0 011-1z"/></svg></div>
          <div class="app-name">收藏</div>
        </div>
        <!-- #542 曾把功能大全提为桌面一级入口，#543 按用户要求撤出桌面（挤占原布局网格）：
             仅保留 设置 → 聊天 → 功能大全 入口，打开逻辑仍在 feature-hub.js -->
      </div>
      </div><!-- /page-slide 第一页 -->

      <!-- 第二页：音乐播放器 -->
      <div class="page-slide second">
        <div class="music-widget glass" id="music-widget" data-desk-widget="music" data-card-bg="music">
          <audio id="m-audio" preload="metadata"></audio>
          <div class="mw-head">
            <span class="mw-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;vertical-align:-2px;margin-right:3px"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>正在播放</span>
            <svg class="mw-bars" id="mw-bars" viewBox="0 0 24 24" fill="#111111"><rect class="b1" x="3" y="9" width="3" height="6" rx="1.5"/><rect class="b2" x="8.5" y="5" width="3" height="12" rx="1.5"/><rect class="b3" x="14" y="8" width="3" height="8" rx="1.5"/><rect class="b4" x="19.5" y="6" width="3" height="10" rx="1.5"/></svg>
          </div>

          <div class="mw-main">
            <div class="mw-cover" id="mw-cover">
              <svg class="mw-cover-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              <div class="mw-vinyl" id="mw-vinyl"></div>
            </div>
            <div class="mw-info">
              <div class="mw-song" id="mw-song">Moonlit Dream</div>
              <div class="mw-artist" id="mw-artist">DLSS · shell（月光梦）</div>
              <div class="mw-progress" id="mw-progress">
                <div class="mw-bar" id="mw-bar"><div class="mw-fill" id="mw-fill"></div><span class="mw-knob" id="mw-knob"></span></div>
                <div class="mw-times"><span id="mw-cur">0:00</span><span id="mw-dur">2:13</span></div>
              </div>
            </div>
          </div>

          <div class="mw-controls">
            <button class="mw-btn" id="mw-mode" title="播放模式">
              <svg id="mw-mode-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg>
            </button>
            <button class="mw-btn" id="mw-queue" title="播放列表">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h9"/></svg>
            </button>
            <button class="mw-btn" id="mw-prev" title="上一首">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 20L9 12l10-8z"/><path d="M5 19V5"/></svg>
            </button>
            <button class="mw-play" id="mw-play" title="播放/暂停">
              <svg id="mw-play-ico" viewBox="0 0 24 24" fill="#111111"><path d="M8 5.5v13l11-6.5z"/></svg>
            </button>
            <button class="mw-btn" id="mw-next" title="下一首">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4l10 8-10 8z"/><path d="M19 5v14"/></svg>
            </button>
            <button class="mw-heart" id="mw-heart" title="收藏">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5S4.5 15.2 4.5 9.9A4.9 4.9 0 0112 7.1a4.9 4.9 0 017.5 2.8c0 5.3-7.5 10.6-7.5 10.6z"/></svg>
            </button>
          </div>
        </div>

<!-- v18（用户直派「截图2的本周日常改成截图1的已摸鱼」）：原「本周日常」周历条改为「已摸鱼」卡；
     今日备忘 / 今天的心情自第三页移回，紧跟音乐播放器（用户：放到截图二音乐播放器的下面） -->
<div class="mini-row" data-desk-widget="memo-row">
<!-- v79（用户直派「第二页的四象限和第一页的日历换一下」）：日历卡自首页移到第二页，接替四象限卡的位置 -->
<div class="mini-card glass" data-card-bg="cal" title="打开日历">
<div class="mc-top">日历</div>
<div class="mc-b" id="mini-cal-text">—</div>
</div>
<!-- v53（用户直派「心情日记换成阅读室」）：原「心情日记」卡改为阅读室入口，显示在读的书与进度 -->
<div class="mini-card glass home-xinxun-card" data-card-bg="xinxun" id="home-xinxun-card" title="点击进入心讯">
<div class="mc-top">心讯</div>
<div class="mc-b" id="xinxun-card-text">还没有新心讯</div>
</div>
</div>

<!-- v21（用户直派「截图2的已摸鱼删掉」「距离周末还剩也删掉」）：
     原第二页「已摸鱼」卡与「离周末还有 N 天」摸鱼倒计时卡整体移除；
     摸鱼天数仍由第三页「和 TA 一起摸鱼」打卡卡维护 -->

<!-- 第二页功能：图标（音乐 / 聊天统计 / 提问记录），整组移到摸鱼组件（周末倒计时）下面 -->
<div class="app-grid p2-grid" data-app="p2" data-desk-widget="p2apps">
<div class="app" data-app="music" data-desk-widget="app-music">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></div>
<div class="app-name">音乐</div>
</div>
        <div class="app" data-app="worldsense" data-desk-widget="app-worldsense">
          <div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.4" cy="13.6" r="6.8"/><path d="M3.6 13.6h13.6"/><path d="M10.4 6.8c1.9 1.9 3 4.3 3 6.8s-1.1 4.9-3 6.8c-1.9-1.9-3-4.3-3-6.8s1.1-4.9 3-6.8z"/><path d="M18.3 6.1a6.3 6.3 0 010 8.6" stroke-width="1.45"/><path d="M20.7 3.7a9.8 9.8 0 010 13.4" stroke-width="1.45"/></svg></div>
          <div class="app-name">世界感知</div>
        </div>

        <div class="app" data-app="mail" data-desk-widget="app-mail">
          <div class="app-badge-box"><div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13.5" rx="2.5"/><path d="M3.5 7.5L12 13l8.5-5.5"/><path d="M5 17.5l4.5-4M19 17.5l-4.5-4"/></svg></div><span class="app-badge" id="mail-badge" hidden></span></div>
          <div class="app-name">信箱</div>
        </div>
        <div class="app" data-app="reading" data-desk-widget="app-reading">
          <div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.3 5.3 8.2 4.8 5.5 4.8H4v13.4h1.5c2.7 0 4.8.5 6.5 1.7 1.7-1.2 3.8-1.7 6.5-1.7H20V4.8h-1.5c-2.7 0-4.8.5-6.5 1.7z"/><path d="M12 6.5v13.4"/></svg></div>
<div class="app-name">阅读室</div>
</div>
<!-- v18：梦角档案 / 我的档案 自第三页并入，并排放在第二页（用户直派） -->
<div class="app" data-app="memo-arc" data-desk-widget="app-memo-arc">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 6.5h5L10 4.5h9a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-12z"/><path d="M12 7.6l1.2 2.7 2.7 1.2-2.7 1.2L12 15.4l-1.2-2.7-2.7-1.2 2.7-1.2z"/></svg></div>
<div class="app-name">梦角档案</div>
</div>
<div class="app" data-app="my-arc" data-desk-widget="app-my-arc">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 6.5h5L10 4.5h9a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-12z"/><circle cx="12" cy="9.5" r="1.9"/><path d="M8.4 15.6c.6-1.6 2-2.4 3.6-2.4s3 .8 3.6 2.4"/></svg></div>
<div class="app-name">我的档案</div>
</div>
</div>
      </div><!-- /page-slide 第二页 -->

      <!-- 第三页：摸鱼打卡 + 健康记录图标 -->
      <div class="page-slide third">
<!-- v18（用户直派「和他一起摸鱼替换截图3的距下个经期」）：打卡卡自第一页移入，替换原经期倒计时大卡；
     经期倒计时组件已收进桌面组件池（装修模式可再加回），经期记录仍可从下方图标进入 -->
<div class="app-grid p3-grid" data-app="p3" data-desk-widget="p3apps">
<div class="app" data-app="period" data-desk-widget="app-period">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2C12 3.2 6 9.2 6 14.2a6 6 0 0 0 12 0c0-5-6-11-6-11z"/><path d="M12 16.4c0 0-2.3-1.4-2.3-2.9a1.25 1.25 0 0 1 2.3-.9 1.25 1.25 0 0 1 2.3.9c0 1.5-2.3 2.9-2.3 2.9z"/></svg></div>
<div class="app-name">经期记录</div>
</div>
<!-- v18（用户直派：群聊/主页/日历/纪念 全部移到第三页；聊天统计与提问记录合并成一个「统计」入口） -->
<div class="app" data-app="stats" data-desk-widget="app-stats">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="8"/><line x1="18" y1="20" x2="18" y2="11"/></svg></div>
<div class="app-name">统计</div>
</div>
<div class="app" data-app="group-chat" data-desk-widget="app-group-chat" hidden>
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/><circle cx="9" cy="11" r="1.2" fill="#111111"/><circle cx="13" cy="11" r="1.2" fill="#111111"/><circle cx="17" cy="11" r="1.2" fill="#111111"/></svg></div>
<div class="app-name">群聊</div>
</div>
<div class="app" data-app="home" data-desk-widget="app-home">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 11.5L12 4l8.5 7.5"/><path d="M5.5 10v10h13V10"/><path d="M9.5 20v-5.5h5V20"/></svg></div>
<div class="app-name">主页</div>
</div>
<div class="app" data-app="calendar" data-desk-widget="app-calendar">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v3.5M16 3v3.5"/><path d="M8 14h3M13 14h3M8 17.5h3"/></svg></div>
<div class="app-name">日历</div>
</div>
<div class="app" data-app="memory" data-desk-widget="app-memory">
<div class="app-ico"><svg viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.5S4.5 15.2 4.5 9.9A4.9 4.9 0 0112 7.1a4.9 4.9 0 017.5 2.8c0 5.3-7.5 10.6-7.5 10.6z"/></svg></div>
<div class="app-name">纪念</div>
</div>
<!-- 本页动态注入 喝水/存钱罐/番茄钟（p2-features.js，喝水排在本页静态图标之后） -->
</div>
      </div><!-- /page-slide 第三页 -->
      </div><!-- /desktop-pages -->

      <!-- 桌面小组件隐藏池：被移除/未添加的组件暂存于此（display:none）。
           新增组件默认放池里，用户从装修模式组件库添加到目标页。 -->
      <div id="desk-widget-pool" style="display:none">
        <!-- 时钟组件 -->
        <div class="desk-clock glass" data-desk-widget="desk-clock" data-card-bg="desk-clock">
          <div class="dc-time" id="dc-time">00:00</div>
          <div class="dc-date" id="dc-date">— · — 月 — 日</div>
        </div>
        <!-- 月历组件 -->
        <div class="desk-cal glass" data-desk-widget="desk-calendar" data-card-bg="desk-calendar">
          <div class="dcal-head"><span class="dcal-title" id="dcal-title">—</span></div>
          <div class="dcal-grid" id="dcal-grid"></div>
        </div>
        <!-- 计时器组件 -->
        <div class="desk-timer glass" data-desk-widget="desk-timer" data-card-bg="desk-timer">
          <div class="dt-disp" id="dt-disp">00:00.0</div>
          <div class="dt-mode-label" id="dt-mode-label">正计时</div>
          <div class="dt-controls">
            <button class="dt-btn" id="dt-start">开始</button>
            <button class="dt-btn" id="dt-reset">重置</button>
            <button class="dt-btn" id="dt-toggle-mode">倒计时</button>
          </div>
        </div>
        <!-- 纪念日倒计时组件 -->
        <div class="desk-anniv glass" data-desk-widget="desk-anniv" data-card-bg="desk-anniv">
          <div class="da-label">距下一个纪念日</div>
          <div class="da-days" id="da-days">—</div>
          <div class="da-name" id="da-name">未设置</div>
        </div>
        <!-- v21：经期倒计时大卡已按用户要求移回第一页「今日情话」下方，组件池不再保留副本 -->

      </div>

      <!-- 分页指示器 -->
      <div class="dots" id="desktop-dots">
        <span class="dot active"></span>
        <span class="dot"></span>
      </div>
    </div>

