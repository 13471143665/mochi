} else if (chatIsDataImgSrc(_p)) { _tt.push(escTxtBr('[图片]')); }
else if (chatIsDataAudioSrc(_p)) { _tt.push(escTxtBr('[语音]')); }
else if (chatIsInlineDataSrc(_p)) { _tt.push(escTxtBr('[附件]')); } // 内核给的非图非音载荷（octet-stream 等）
