const setModalText = function (txt) {
try {
const ta = document.getElementById('modal-textarea');
if (ta && !ta.hidden) { ta.value = txt; return; }
} catch (e) {}
try { if (ctl && ctl.text) ctl.text(txt); } catch (e2) {}
};
