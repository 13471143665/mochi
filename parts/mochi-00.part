}
const rec = (idx >= 0 && msgs[idx]) ? msgs[idx] : null;
if (!rec || rec.retracted || rec.parts || rec.type === 'sticker' || rec.type === 'image' || rec.type === 'voice') { retractMsg(target, side); return; }
