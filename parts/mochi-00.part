      <input type="text" id="tc-search" class="tc-input" placeholder="搜索问题…" style="width:100%">
    </div>
    <div id="tc-sys-panel">
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0">系统预设题库（可逐句开关，或整组停用一类，不可删除）</div>
        <div id="tc-sys-cats" style="padding:8px 14px 14px"></div>
      </div>
    </div>
    <div id="tc-mine-panel" hidden>
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0;display:flex;align-items:center;justify-content:space-between"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>添加问题</span><button class="cc-tool" id="tc-new-grp" style="padding:4px 8px;font-size:11px">＋ 分组</button></div>
        <div class="tc-addform">
          <select id="tc-new-cat" class="tc-input">
            <option value="daily">日常</option>
            <option value="like">喜好</option>
            <option value="fun">趣味</option>
            <option value="rel">关系</option>
            <option value="hypo">假设</option>
            <option value="star">摸鱼</option>
            <option value="world">两个世界</option>
          </select>
          <input id="tc-new-text" class="tc-input" type="text" placeholder="问题内容…">
          <input id="tc-new-opts" class="tc-input" type="text" placeholder="选项用 | 分隔，可写「选项~回应」，多条回应用 ; 分隔，如：睡觉~嗯，听你的。;好，那你睡。">
          <button class="ta-add-btn" style="width:100%" id="tc-new-add">添加</button>
        </div>
      </div>
      <div class="set-group glass">
        <div class="cal-card-title" style="padding:14px 14px 0">我添加的问题 <span style="font-size:11px;color:var(--muted);font-weight:400">（可停用/删除）</span></div>
        <div id="tc-mine-cats" style="padding:8px 14px 14px"></div>
      </div>
    </div>
    <div class="set-group glass" style="display:flex;gap:8px;padding:10px">
      <button class="cc-tool" id="tc-favs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;vertical-align:-2px;margin-right:4px"><path d="M12 2l2.4 5 5.6.8-4 4 .9 5.6-4.9-2.6-4.9 2.6.9-5.6-4-4 5.6-.8z"/></svg>收藏（0）</button>
    </div>
  </div>
</div>

