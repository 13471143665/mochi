rmBtn.addEventListener('click', () => { clearPhoneBg(); store.remove('phone-bg-pos-x'); store.remove('phone-bg-pos-y'); store.remove('phone-bg-size'); toast('已清除，图库里的图还在'); openPhoneBgPanel(); });
