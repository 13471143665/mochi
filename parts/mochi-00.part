L.push('键盘期快照环=' + (function () { try { return JSON.stringify((window.__mochiKbSnaps || []).map(function (q) { return [q.ev, q.kb, q.vvH, q.ph, q.tsk != null ? q.tsk : -1]; })); } catch (eKR) { return '[]'; } })()); // #1481：双稳态内核（GT7 Edge）毛刺序列取证（#1506：末位 ts 距最后按键 ms）
