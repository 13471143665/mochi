typingEl.hidden = false; // FIX 2026-09-15 #514 进页同款：只切可见性、不写 scrollTop（上面三连已在行隐藏态贴到底）
document.body.classList.add('typing-on'); // v36
}
schedulePanelPrewarm(2500);
}); // #1017 第二段（重活）结束
}
